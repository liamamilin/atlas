  "first_iteration": {
    "requirements": [
      {
        "id": "MT-R1",
        "text": "项目工作项是交付范围的主记录；个人日程只引用工作项并记录时间承诺；客户审批请求是客户决定的主记录。三者通过稳定 ID、来源类型和状态映射关联。",
        "acceptance": [
          "能列出项目、排程、交付物、客户决定各自的主记录和引用关系",
          "任务进入日程、交付物进入审批和审批返回项目时均保留稳定关联 ID"
        ]
      },
      {
        "id": "MT-R2",
        "text": "交接必须显式记录状态、责任人、时间戳和失败恢复动作；同步失败或客户退回时不能静默覆盖项目状态。",
        "acceptance": [
          "至少覆盖排程冲突、审批退回、审批超时和重复回调四种异常",
          "每种异常都有重试、人工接管或回滚路径"
        ]
      },
      {
        "id": "MT-R3",
        "text": "首轮只交付跨类型数据契约、状态映射和可导出的开发文档，不实现自动双向同步、完整客户认证、计费或资源级自动排程。",
        "acceptance": [
          "范围表明确当前、后续和排除项",
          "导出包可由新会话独立理解并继续开发"
        ]
      }
    ],
    "excluded_scope": [
      "自动双向同步和最终一致性平台",
      "完整客户账号、计费和多租户权限系统",
      "按资源和技能自动排程",
      "真实邮件、日历或审批供应商接入",
      "替换 Atlas 或自研通用 agent harness"
    ]
  },
