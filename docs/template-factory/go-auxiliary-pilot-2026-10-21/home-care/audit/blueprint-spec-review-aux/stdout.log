n228: \tDueDate        *time.Time          `                                                                                  json:\"due_date\"         extract:\"-\"`\n229: \tManualURL      string              `                                                                                  json:\"manual_url\"       extract:\"-\"`\n230: \tManualText     string              `                                                                                  json:\"manual_text\"      extract:\"-\"`\n231: \tNotes          string              `                                                                                  json:\"notes\"`\n232: \tCostCents      *int64              `                                                                                  json:\"cost_cents\"`\n233: \tDocuments      []Document          `gorm:\"polymorphic:Entity;polymorphicType:EntityKind;polymorphicValue:maintenance\" json:\"-\"`\n234: \tCreatedAt      time.Time           `                                                                                  json:\"created_at\"`\n235: \tUpdatedAt      time.Time           `                                                                                  json:\"updated_at\"`\n236: \tDeletedAt      gorm.DeletedAt      `gorm:\"index\"                                                                      json:\"-\"`\n237: }\n238: \n239: type Incident struct {\n240: \tID             string         `gorm:\"primaryKey;size:26\"                                                      json:\"id\"`\n241: \tTitle          string         `                                                                               json:\"title\"`\n242: \tDescription    string         `                                                                               json:\"description\"`\n243: \tStatus         string         `                                                                               json:\"status\"          default:\"open\"`\n244: \tPreviousStatus string         `                                                                               json:\"previous_status\"                extract:\"-\"`\n245: \tSeverity       string         `                                                                               json:\"severity\"        default:\"soon\"`\n246: \tDateNoticed    time.Time      `                                                                               json:\"date_noticed\"    default:\"now\"`\n247: \tDateResolved   *time.Time     `                                                                               json:\"date_resolved\"                  extract:\"-\"`\n248: \tLocation       string         `                                                                               json:\"location\"`\n249: \tCostCents      *int64         `                                                                               json:\"cost_cents\"`\n250: \tApplianceID    *string        `gorm:\"index\"                                                                   json:\"appliance_id\"`\n251: \tAppliance      Appliance      `gorm:\"constraint:OnDelete:SET NULL;\"                                           json:\"-\"`\n252: \tVendorID       *string        `gorm:\"index\"                                                                   json:\"vendor_id\"`\n253: \tVendor         Vendor         `gorm:\"constraint:OnDelete:SET NULL;\"                                           json:\"-\"`\n254: \tNotes          string         `                                                                               json:\"notes\"`\n255: \tDocuments      []Document     `gorm:\"polymorphic:Entity;polymorphicType:EntityKind;polymorphicValue:incident\" json:\"-\"`\n256: \tCreatedAt      time.Time      `                                                                               json:\"created_at\"`\n257: \tUpdatedAt      time.Time      `                                                                               json:\"updated_at\"`\n258: \tDeletedAt      gorm.DeletedAt `gorm:\"index\"                                                                   json:\"-\"`\n259: }\n260: \n261: type ServiceLogEntry struct {\n262: \tID                string          `gorm:\"primaryKey;size:26\"                                                         json:\"id\"`\n263: \tMaintenanceItemID string          `gorm:\"index\"                                                                      json:\"maintenance_item_id\"`\n264: \tMaintenanceItem   MaintenanceItem `gorm:\"constraint:OnDelete:CASCADE;\"                                               json:\"-\"`\n265: \tServicedAt        time.Time       `                                                                                  json:\"serviced_at\"`\n266: \tVendorID          *string         `gorm:\"index\"                                                                      json:\"vendor_id\"`\n267: \tVendor            Vendor          `gorm:\"constraint:OnDelete:SET NULL;\"                                              json:\"-\"`\n268: \tCostCents         *int64          `                                                                                  json:\"cost_cents\"`\n269: \tNotes             string          `                                                                                  json:\"notes\"`\n270: \tDocuments         []Document      `gorm:\"polymorphic:Entity;polymorphicType:EntityKind;polymorphicValue:service_log\" json:\"-\"`\n271: \tCreatedAt         time.Time       `                                                                                  json:\"created_at\"`\n272: \tUpdatedAt         time.Time       `                                                                                  json:\"updated_at\"`\n273: \tDeletedAt         gorm.DeletedAt  `gorm:\"index\"                                                                      json:\"-\"`\n274: }\n275: \n276: type Document struct {\n277: \tID              string         `gorm:\"primaryKey;size:26\"    json:\"id\"`\n278: \tTitle           string         `                             json:\"title\"`\n279: \tFileName        string         `gorm:\"column:file_name\"      json:\"file_name\"`\n280: \tEntityKind      string         `gorm:\"index:idx_doc_entity\"  json:\"entity_kind\"`\n281: \tEntityID        string         `gorm:\"index:idx_doc_entity\"  json:\"entity_id\"`\n282: \tMIMEType        string         `                             json:\"mime_type\"        extract:\"-\"`\n283: \tSizeBytes       int64          `                             json:\"size_bytes\"       extract:\"-\"`\n284: \tChecksumSHA256  string         `gorm:\"column:sha256\"         json:\"sha256\"           extract:\"-\"`\n285: \tData            []byte         `                             json:\"-\"`\n286: \tExtractedText   string         `                             json:\"extracted_text\"   extract:\"-\"`\n287: \tExtractData     []byte         `gorm:\"column:ocr_data\"       json:\"-\"`\n288: \tExtractionModel string         `                             json:\"extraction_model\" extract:\"-\"`\n289: \tExtractionOps   []byte         `gorm:\"column:extraction_ops\" json:\"-\"`\n290: \tNotes           string         `                             json:\"notes\"`\n291: \tCreatedAt       time.Time      `                             json:\"created_at\"`\n292: \tUpdatedAt       time.Time      `                             json:\"updated_at\"`\n293: \tDeletedAt       gorm.DeletedAt `gorm:\"index\"                 json:\"-\"`\n294: }\n295: \n296: type DeletionRecord struct {\n297: \tID         string     `gorm:\"primaryKey;size:26\"`\n298: \tEntity     string     `gorm:\"index:idx_entity_restored,priority:1\"`\n299: \tTargetID   string     `gorm:\"index\"`\n300: \tDeletedAt  time.Time  `gorm:\"index\"`\n301: \tRestoredAt *time.Time `gorm:\"index:idx_entity_restored,priority:2\"`\n302: }\n303: \n304: // Setting is a simple key-value store for app preferences that persist\n305: // across sessions (e.g. last-used LLM model). Stored in SQLite so a\n306: // single \"micasa backup backup.db\" captures everything.\n307: type Setting struct {\n308: \tKey       string `gorm:\"primaryKey\"`\n309: \tValue     string\n310: \tUpdatedAt time.Time\n311: }\n312: \n313: // ChatInput stores a single chat prompt for cross-session history.\n314: // Ordered by creation time, newest last. Intentionally uses uint PK\n315: // (not ULID) because chat history is local-only and not synced.\n316: type ChatInput struct {\n317: \tID        uint   `gorm:\"primaryKey\"`\n318: \tInput     string `gorm:\"not null\"`\n319: \tCreatedAt time.Time\n320: }\n321: \n322: // deletionEntityToTable maps DeletionEntity constants to table names.\n323: // Used by the oplog to write \"restore\" entries from restoreSoftDeleted.\n324: var deletionEntityToTable = map[string]string{\n325: \tDeletionEntityProject:     TableProjects,\n326: \tDeletionEntityQuote:       TableQuotes,\n327: \tDeletionEntityMaintenance: TableMaintenanceItems,\n328: \tDeletionEntityAppliance:   TableAppliances,\n329: \tDeletionEntityServiceLog:  TableServiceLogEntries,\n330: \tDeletionEntityVendor:      TableVendors,\n331: \tDeletionEntityDocument:    TableDocuments,\n332: \tDeletionEntityIncident:    TableIncidents,\n333: }\n334: \n335: // Oplog operation types.\n336: const (\n337: \tOpInsert  = \"insert\"\n338: \tOpUpdate  = \"update\"\n339: \tOpDelete  = \"delete\"\n340: \tOpRestore = \"restore\"\n341: )\n342: \n343: // SyncOplogEntry records a single mutation to a syncable entity.\n344: // Local mutations have applied_at set immediately; synced_at is set after\n345: // successful push to the relay. Remote ops have both set on receipt.\n346: type SyncOplogEntry struct {\n347: \tID        string `gorm:\"primaryKey;size:26\"`\n348: \tTableName string `gorm:\"not null;index:idx_oplog_table_row\"`\n349: \tRowID     string `gorm:\"not null;index:idx_oplog_table_row\"`\n350: \tOpType    string `gorm:\"not null\"`\n351: \tPayload   string `gorm:\"type:text;not null\"`\n352: \tDeviceID  string `gorm:\"not null\"`\n353: \tCreatedAt time.Time\n354: \tAppliedAt *time.Time\n355: \tSyncedAt  *time.Time `gorm:\"index\"`\n356: }\n357: \n358: // SyncDevice stores this device's identity. Only one row exists locally.\n359: type SyncDevice struct {\n360: \tID          string `gorm:\"primaryKey;size:26\"`\n361: \tName        string `gorm:\"not null\"`\n362: \tHouseholdID string\n363: \tRelayURL    string\n364: \tLastSeq     int64 `gorm:\"default:0\"`\n365: \tCreatedAt   time.Time\n366: }\n367: \n368: func (x *SyncOplogEntry) BeforeCreate(_ *gorm.DB) error {\n369: \tif x.ID == \"\" {\n370: \t\tx.ID = uid.New()\n371: \t}\n372: \treturn nil\n373: }\n374: \n375: func (x *SyncDevice) BeforeCreate(_ *gorm.DB) error {\n376: \tif x.ID == \"\" {\n377: \t\tx.ID = uid.New()\n378: \t}\n379: \treturn nil\n380: }\n381: \n382: func (x *HouseProfile) BeforeCreate(_ *gorm.DB) error {\n383: \tif x.ID == \"\" {\n384: \t\tx.ID = uid.New()\n385: \t}\n386: \treturn nil\n387: }\n388: \n389: func (x *ProjectType) BeforeCreate(_ *gorm.DB) error {\n390: \tif x.ID == \"\" {\n391: \t\tx.ID = uid.New()\n392: \t}\n393: \treturn nil\n394: }\n395: \n396: func (x *Vendor) BeforeCreate(_ *gorm.DB) error {\n397: \tif x.ID == \"\" {\n398: \t\tx.ID = uid.New()\n399: \t}\n400: \treturn nil\n401: }\n402: \n403: func (x *Project) BeforeCreate(_ *gorm.DB) error {\n404: \tif x.ID == \"\" {\n405: \t\tx.ID = uid.New()\n406: \t}\n407: \treturn nil\n408: }\n409: \n410: func (x *Quote) BeforeCreate(_ *gorm.DB) error {\n411: \tif x.ID == \"\" {\n412: \t\tx.ID = uid.New()\n413: \t}\n414: \treturn nil\n415: }\n416: \n417: func (x *MaintenanceCategory) BeforeCreate(_ *gorm.DB) error {\n418: \tif x.ID == \"\" {\n419: \t\tx.ID = uid.New()\n420: \t}\n421: \treturn nil\n422: }\n423: \n424: func (x *Appliance) BeforeCreate(_ *gorm.DB) error {\n425: \tif x.ID == \"\" {\n426: \t\tx.ID = uid.New()\n427: \t}\n428: \treturn nil\n429: }\n430: \n431: func (x *MaintenanceItem) BeforeCreate(_ *gorm.DB) error {\n432: \tif x.ID == \"\" {\n433: \t\tx.ID = uid.New()\n434: \t}\n435: \treturn nil\n436: }\n437: \n438: func (x *Incident) BeforeCreate(_ *gorm.DB) error {\n439: \tif x.ID == \"\" {\n440: \t\tx.ID = uid.New()\n441: \t}\n442: \treturn nil\n443: }\n444: \n445: func (x *ServiceLogEntry) BeforeCreate(_ *gorm.DB) error {\n446: \tif x.ID == \"\" {\n447: \t\tx.ID = uid.New()\n448: \t}\n449: \treturn nil\n450: }\n451: \n452: func (x *Document) BeforeCreate(_ *gorm.DB) error {\n453: \tif x.ID == \"\" {\n454: \t\tx.ID = uid.New()\n455: \t}\n456: \treturn nil\n457: }\n458: \n459: func (x *DeletionRecord) BeforeCreate(_ *gorm.DB) error {\n460: \tif x.ID == \"\" {\n461: \t\tx.ID = uid.New()\n462: \t}\n463: \treturn nil\n464: }\n465: \n466: // --- Oplog hooks: AfterCreate only ---\n467: // AfterCreate hooks work reliably because tx.Create(&item) always passes a\n468: // populated model. Updates and deletes use explicit oplog writes in Store\n469: // methods because GORM's Model().Updates() and Where().Delete() pass empty\n470: // models to hooks, preventing correct payload capture.\n471: \n472: func (x *HouseProfile) AfterCreate(tx *gorm.DB) error {\n473: \tif isSyncApplying(tx) {\n474: \t\treturn nil\n475: \t}\n476: \treturn writeOplogEntry(tx, TableHouseProfiles, x.ID, OpInsert, x)\n477: }\n478: \n479: func (x *ProjectType) AfterCreate(tx *gorm.DB) error {\n480: \tif isSyncApplying(tx) {\n481: \t\treturn nil\n482: \t}\n483: \treturn writeOplogEntry(tx, TableProjectTypes, x.ID, OpInsert, x)\n484: }\n485: \n486: func (x *Vendor) AfterCreate(tx *gorm.DB) error {\n487: \tif isSyncApplying(tx) {\n488: \t\treturn nil\n489: \t}\n490: \treturn writeOplogEntry(tx, TableVendors, x.ID, OpInsert, x)\n491: }\n492: \n493: func (x *Project) AfterCreate(tx *gorm.DB) error {\n494: \tif isSyncApplying(tx) {\n495: \t\treturn nil\n496: \t}\n497: \treturn writeOplogEntry(tx, TableProjects, x.ID, OpInsert, x)\n498: }\n499: \n500: func (x *Quote) AfterCreate(tx *gorm.DB) error {\n501: \tif isSyncApplying(tx) {\n502: \t\treturn nil\n503: \t}\n504: \treturn writeOplogEntry(tx, TableQuotes, x.ID, OpInsert, x)\n505: }\n506: \n507: func (x *MaintenanceCategory) AfterCreate(tx *gorm.DB) error {\n508: \tif isSyncApplying(tx) {\n509: \t\treturn nil\n510: \t}\n511: \treturn writeOplogEntry(tx, TableMaintenanceCategories, x.ID, OpInsert, x)\n512: }\n513: \n514: func (x *Appliance) AfterCreate(tx *gorm.DB) error {\n515: \tif isSyncApplying(tx) {\n516: \t\treturn nil\n517: \t}\n518: \treturn writeOplogEntry(tx, TableAppliances, x.ID, OpInsert, x)\n519: }\n520: \n521: func (x *MaintenanceItem) AfterCreate(tx *gorm.DB) error {\n522: \tif isSyncApplying(tx) {\n523: \t\treturn nil\n524: \t}\n525: \treturn writeOplogEntry(tx, TableMaintenanceItems, x.ID, OpInsert, x)\n526: }\n527: \n528: func (x *Incident) AfterCreate(tx *gorm.DB) error {\n529: \tif isSyncApplying(tx) {\n530: \t\treturn nil\n531: \t}\n532: \treturn writeOplogEntry(tx, TableIncidents, x.ID, OpInsert, x)\n533: }\n534: \n535: func (x *ServiceLogEntry) AfterCreate(tx *gorm.DB) error {\n536: \tif isSyncApplying(tx) {\n537: \t\treturn nil\n538: \t}\n539: \treturn writeOplogEntry(tx, TableServiceLogEntries, x.ID, OpInsert, x)\n540: }\n541: \n542: func (x *Document) AfterCreate(tx *gorm.DB) error {\n543: \tif isSyncApplying(tx) {\n544: \t\treturn nil\n545: \t}\n546: \treturn writeOplogEntry(tx, TableDocuments, x.ID, OpInsert, newDocumentOplogPayload(*x))\n547: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\": \"/Users/milin/2026/软件开发/application-atlas/docs/template-factory/go-auxiliary-pilot-2026-10-21/home-care/calls/blueprint-spec-review-aux/source/upstream/internal/data/models.go\"}"},"time":{"start":1792571600156,"end":1792571600295}}}}
