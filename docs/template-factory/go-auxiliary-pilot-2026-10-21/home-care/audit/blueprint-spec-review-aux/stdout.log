/ GORM Select(\"*\") updates all non-omitted columns\n41: \t\treturn err\n42: \t}\n43: \tif !isSyncApplying(s.db) {\n44: \t\treturn writeOplogEntry(s.db, TableHouseProfiles, profile.ID, OpUpdate, profile)\n45: \t}\n46: \treturn nil\n47: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/milin/2026/软件开发/application-atlas/docs/template-factory/go-auxiliary-pilot-2026-10-21/home-care/calls/blueprint-spec-review-aux/source/upstream/internal/data/store_house.go, lines 1-47\n1: // Copyright 2026 Phillip Cloud\n2: // Licensed under the Apache License, Version 2.0\n3: \n4: package data\n5: \n6: import (\n7: \t\"errors\"\n8: \t\"fmt\"\n9: \n10: \t\"gorm.io/gorm\"\n11: )\n12: \n13: func (s *Store) HouseProfile() (HouseProfile, error) {\n14: \tvar profile HouseProfile\n15: \terr := s.db.First(&profile).Error\n16: \tif errors.Is(err, gorm.ErrRecordNotFound) {\n17: \t\treturn HouseProfile{}, gorm.ErrRecordNotFound\n18: \t}\n19: \treturn profile, err\n20: }\n21: \n22: func (s *Store) CreateHouseProfile(profile HouseProfile) error {\n23: \tvar count int64\n24: \tif err := s.db.Model(&HouseProfile{}).Count(&count).Error; err != nil {\n25: \t\treturn fmt.Errorf(\"count house profiles: %w\", err)\n26: \t}\n27: \tif count > 0 {\n28: \t\treturn errors.New(\"house profile already exists\")\n29: \t}\n30: \treturn s.db.Create(&profile).Error\n31: }\n32: \n33: func (s *Store) UpdateHouseProfile(profile HouseProfile) error {\n34: \tvar existing HouseProfile\n35: \tif err := s.db.First(&existing).Error; err != nil {\n36: \t\treturn err\n37: \t}\n38: \tprofile.ID = existing.ID\n39: \tprofile.CreatedAt = existing.CreatedAt\n40: \tif err := s.db.Model(&existing).Select(\"*\").Updates(profile).Error; err != nil { //nolint:unqueryvet // GORM Select(\"*\") updates all non-omitted columns\n41: \t\treturn err\n42: \t}\n43: \tif !isSyncApplying(s.db) {\n44: \t\treturn writeOplogEntry(s.db, TableHouseProfiles, profile.ID, OpUpdate, profile)\