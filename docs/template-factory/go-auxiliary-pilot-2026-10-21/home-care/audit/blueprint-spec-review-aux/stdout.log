x, TableProjectTypes, x.ID, OpInsert, x)\n484: }\n485: \n486: func (x *Vendor) AfterCreate(tx *gorm.DB) error {\n487: \tif isSyncApplying(tx) {\n488: \t\treturn nil\n489: \t}\n490: \treturn writeOplogEntry(tx, TableVendors, x.ID, OpInsert, x)\n491: }\n492: \n493: func (x *Project) AfterCreate(tx *gorm.DB) error {\n494: \tif isSyncApplying(tx) {\n495: \t\treturn nil\n496: \t}\n497: \treturn writeOplogEntry(tx, TableProjects, x.ID, OpInsert, x)\n498: }\n499: \n500: func (x *Quote) AfterCreate(tx *gorm.DB) error {\n501: \tif isSyncApplying(tx) {\n502: \t\treturn nil\n503: \t}\n504: \treturn writeOplogEntry(tx, TableQuotes, x.ID, OpInsert, x)\n505: }\n506: \n507: func (x *MaintenanceCategory) AfterCreate(tx *gorm.DB) error {\n508: \tif isSyncApplying(tx) {\n509: \t\treturn nil\n510: \t}\n511: \treturn writeOplogEntry(tx, TableMaintenanceCategories, x.ID, OpInsert, x)\n512: }\n513: \n514: func (x *Appliance) AfterCreate(tx *gorm.DB) error {\n515: \tif isSyncApplying(tx) {\n516: \t\treturn nil\n517: \t}\n518: \treturn writeOplogEntry(tx, TableAppliances, x.ID, OpInsert, x)\n519: }\n520: \n521: func (x *MaintenanceItem) AfterCreate(tx *gorm.DB) error {\n522: \tif isSyncApplying(tx) {\n523: \t\treturn nil\n524: \t}\n525: \treturn writeOplogEntry(tx, TableMaintenanceItems, x.ID, OpInsert, x)\n526: }\n527: \n528: func (x *Incident) AfterCreate(tx *gorm.DB) error {\n529: \tif isSyncApplying(tx) {\n530: \t\treturn nil\n531: \t}\n532: \treturn writeOplogEntry(tx, TableIncidents, x.ID, OpInsert, x)\n533: }\n534: \n535: func (x *ServiceLogEntry) AfterCreate(tx *gorm.DB) error {\n536: \tif isSyncApplying(tx) {\n537: \t\treturn nil\n538: \t}\n539: \treturn writeOplogEntry(tx, TableServiceLogEntries, x.ID, OpInsert, x)\n540: }\n541: \n542: func (x *Document) AfterCreate(tx *gorm.DB) error {\n543: \tif isSyncApplying(tx) {\n544: \t\treturn nil\n545: \t}\n546: \treturn writeOplogEntry(tx, TableDocuments, x.ID, OpInsert, newDocumentOplogPayload(*x))\n547: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/milin/2026/软件开发/application-atlas/docs/template-factory/go-auxiliary-pilot-2026-10-21/home-care/calls/blueprint-spec-review-aux/source/upstream/internal/data/models.go, lines 1-547\n1: // Copyright 2026 Phillip Cloud\n2: // Licensed under the Apache License, Version 2.0\n3: \n4: package data\n5: \n6: import (\n7: \t\"fmt\"\n8: \t\"sync\"\n9: \t\"time\"\n10: \n11: \t\"github.com/micasa-dev/micasa/internal/uid\"\n12: \n13: \t\"gorm.io/gorm\"\n14: \t\"gorm.io/gorm/schema\"\n15: )\n16: \n17: const (\n18: \tProjectStatusIdeating   = \"ideating\"\n19: \tProjectStatusPlanned    = \"planned\"\n20: \tProjectStatusQuoted     = \"quoted\"\n21: \tProjectStatusInProgress = \"underway\"\n22: \tProjectStatusDelayed    = \"delayed\"\n23: \tProjectStatusCompleted  = \"completed\"\n24: \tProjectStatusAbandoned  = \"abandoned\"\n25: )\n26: \n27: const (\n28: \tDeletionEntityProject     = \"project\"\n29: \tDeletionEntityQuote       = \"quote\"\n30: \tDeletionEntityMaintenance = \"maintenance\"\n31: \tDeletionEntityAppliance   = \"appliance\"\n32: \tDeletionEntityServiceLog  = \"service_log\"\n33: \tDeletionEntityVendor      = \"vendor\"\n34: \tDeletionEntityDocument    = \"document\"\n35: \tDeletionEntityIncident    = \"incident\"\n36: )\n37: \n38: const (\n39: \tIncidentStatusOpen       = \"open\"\n40: \tIncidentStatusInProgress = \"in_progress\"\n41: \tIncidentStatusResolved   = \"resolved\"\n42: )\n43: \n44: const (\n45: \tIncidentSeverityUrgent   = \"urgent\"\n46: \tIncidentSeveritySoon     = \"soon\"\n47: \tIncidentSeverityWhenever = \"whenever\"\n48: )\n49: \n50: const (\n51: \tSeasonSpring = \"spring\"\n52: \tSeasonSummer = \"summer\"\n53: \tSeasonFall   = \"fall\"\n54: \tSeasonWinter = \"winter\"\n55: )\n56: \n57: // Document entity kind values for polymorphic linking.\n58: const (\n59: \tDocumentEntityNone        = \"\"\n60: \tDocumentEntityProject     = \"project\"\n61: \tDocumentEntityQuote       = \"quote\"\n62: \tDocumentEntityMaintenance = \"maintenance\"\n63: \tDocumentEntityAppliance   = \"appliance\"\n64: \tDocumentEntityServiceLog  = \"service_log\"\n65: \tDocumentEntityVendor      = \"vendor\"\n66: \tDocumentEntityIncident    = \"incident\"\n67: )\n68: \n69: // EntityKindToTable maps document entity_kind values (polymorphicValue)\n70: // to their corresponding table names. Derived from GORM polymorphic\n71: // tags via schema introspection at init time.\n72: var EntityKindToTable = BuildEntityKindToTable(Models())\n73: \n74: // BuildEntityKindToTable derives the entity_kind-to-table mapping from\n75: // GORM polymorphic tags on the given models. Each model with a polymorphic\n76: // HasMany to the documents table contributes one entry:\n77: // polymorphicValue -> owner table name.\n78: func BuildEntityKindToTable(models []any) map[string]string {\n79: \tnamer := schema.NamingStrategy{}\n80: \tcacheStore := &sync.Map{}\n81: \n82: \tresult := make(map[string]string)\n83: \n84: \tfor _, model := range models {\n85: \t\ts, err := schema.Parse(model, cacheStore, namer)\n86: \t\tif err != nil {\n87: \t\t\tpanic(fmt.Sprintf(\"BuildEntityKindToTable: parse %T: %v\", model, err))\n88: \t\t}\n89: \n90: \t\tfor _, rel := range s.Relationships.HasMany {\n91: \t\t\tif rel.Polymorphic == nil {\n92: \t\t\t\tcontinue\n93: \t\t\t}\n94: \t\t\tif rel.FieldSchema.Table != TableDocuments {\n95: \t\t\t\tcontinue\n96: \t\t\t}\n97: \t\t\tresult[rel.Polymorphic.Value] = s.Table\n98: \t\t}\n99: \t}\n100: \n101: \treturn result\n102: }\n103: \n104: type HouseProfile struct {\n105: \tID               string     `gorm:\"primaryKey;size:26\" json:\"id\"`\n106: \tNickname         string     `                          json:\"nickname\"`\n107: \tAddressLine1     string     `                          json:\"address_line1\"`\n108: \tAddressLine2     string     `                          json:\"address_line2\"`\n109: \tCity             string     `                          json:\"city\"`\n110: \tState            string     `                          json:\"state\"`\n111: \tPostalCode       string     `                          json:\"postal_code\"`\n112: \tYearBuilt        int        `                          json:\"year_built\"`\n113: \tSquareFeet       int        `                          json:\"square_feet\"`\n114: \tLotSquareFeet    int        `                          json:\"lot_square_feet\"`\n115: \tBedrooms         int        `                          json:\"bedrooms\"`\n116: \tBathrooms        float64    `                          json:\"bathrooms\"`\n117: \tFoundationType   string     `                          json:\"foundation_type\"`\n118: \tWiringType       string     `                          json:\"wiring_type\"`\n119: \tRoofType         string     `                          json:\"roof_type\"`\n120: \tExteriorType     string     `                          json:\"exterior_type\"`\n121: \tHeatingType      string     `                          json:\"heating_type\"`\n122: \tCoolingType      string     `                          json:\"cooling_type\"`\n123: \tWaterSource      string     `                          json:\"water_source\"`\n124: \tSewerType        string     `                          json:\"sewer_type\"`\n125: \tParkingType      string     `                          json:\"parking_type\"`\n126: \tBasementType     string     `                          json:\"basement_type\"`\n127: \tInsuranceCarrier string     `                          json:\"insurance_carrier\"`\n128: \tInsurancePolicy  string     `                          json:\"insurance_policy\"`\n129: \tInsuranceRenewal *time.Time `                          json:\"insurance_renewal\"`\n130: \tPropertyTaxCents *int64     `                          json:\"property_tax_cents\"`\n131: \tHOAName          string     `                          json:\"hoa_name\"`\n132: \tHOAFeeCents      *int64     `                          json:\"hoa_fee_cents\"`\n133: \tCreated