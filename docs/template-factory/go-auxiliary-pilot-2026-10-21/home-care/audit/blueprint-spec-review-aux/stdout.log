{"type":"tool_use","timestamp":1792571604187,"sessionID":"ses_ea2691a44ffemHBxOiocBq67ci","part":{"partID":"prt_15d97fb9a00164DzEOCs5zEp4y","sessionID":"ses_ea2691a44ffemHBxOiocBq67ci","messageID":"msg_15d97ee04001rvxC5Kge9Q8RVw","type":"tool","id":"call_00_xkbicrm8dsrtov1o61a7ptgq","tool":"read","state":{"status":"completed","input":{"path":"/Users/milin/2026/软件开发/application-atlas/docs/template-factory/go-auxiliary-pilot-2026-10-21/home-care/calls/blueprint-spec-review-aux/source/upstream/internal/data/store_maintenance.go"},"output":"Read file /Users/milin/2026/软件开发/application-atlas/docs/template-factory/go-auxiliary-pilot-2026-10-21/home-care/calls/blueprint-spec-review-aux/source/upstream/internal/data/store_maintenance.go, lines 1-139\n1: // Copyright 2026 Phillip Cloud\n2: // Licensed under the Apache License, Version 2.0\n3: \n4: package data\n5: \n6: import \"gorm.io/gorm\"\n7: \n8: func (s *Store) MaintenanceCategories() ([]MaintenanceCategory, error) {\n9: \tvar categories []MaintenanceCategory\n10: \tif err := s.db.Order(ColName + \" ASC, \" + ColID + \" DESC\").Find(&categories).Error; err != nil {\n11: \t\treturn nil, err\n12: \t}\n13: \treturn categories, nil\n14: }\n15: \n16: func (s *Store) ListMaintenance(includeDeleted bool) ([]MaintenanceItem, error) {\n17: \treturn listQuery[MaintenanceItem](s, includeDeleted, func(db *gorm.DB) *gorm.DB {\n18: \t\treturn db.Preload(\"Category\").\n19: \t\t\tPreload(\"Appliance\", unscopedPreload).\n20: \t\t\tOrder(ColUpdatedAt + \" desc, \" + ColID + \" desc\")\n21: \t})\n22: }\n23: \n24: func (s *Store) ListMaintenanceByAppliance(\n25: \tapplianceID string,\n26: \tincludeDeleted bool,\n27: ) ([]MaintenanceItem, error) {\n28: \treturn listQuery[MaintenanceItem](s, includeDeleted, func(db *gorm.DB) *gorm.DB {\n29: \t\treturn db.Preload(\"Category\").\n30: \t\t\tWhere(ColApplianceID+\" = ?\", applianceID).\n31: \t\t\tOrder(ColUpdatedAt + \" desc, \" + ColID + \" desc\")\n32: \t})\n33: }\n34: \n35: func (s *Store) GetMaintenance(id string) (MaintenanceItem, error) {\n36: \treturn getByID[MaintenanceItem](s, id, func(db *gorm.DB) *gorm.DB {\n37: \t\treturn db.Preload(\"Category\").Preload(\"Appliance\", unscopedPreload)\n38: \t})\n39: }\n40: \n41: func (s *Store) CreateMaintenance(item *MaintenanceItem) error {\n42: \treturn s.db.Create(item).Error\n43: }\n44: \n45: // FindOrCreateMaintenance looks up a maintenance item by name and category.\n46: // If found, returns it. If not found, creates a new one. Soft-deleted items\n47: // with the same name+category are restored.\n48: func (s *Store) FindOrCreateMaintenance(item MaintenanceItem) (MaintenanceItem, error) {\n49: \treturn findOrCreate(s.db, item, item.Name, \"maintenance item name\",\n50: \t\tfunc(db *gorm.DB) *gorm.DB {\n51: \t\t\treturn db.Where(ColName+\" = ? AND \"+ColCategoryID+\" = ?\", item.Name, item.CategoryID)\n52: \t\t},\n53: \t\tDeletionEntityMaintenance,\n54: \t\tfunc(m MaintenanceItem) string { return m.ID },\n55: \t\tfunc(m MaintenanceItem) bool { return m.DeletedAt.Valid },\n56: \t)\n57: }\n58: \n59: func (s *Store) UpdateMaintenance(item MaintenanceItem) error {\n60: \treturn s.updateByID(TableMaintenanceItems, &MaintenanceItem{}, item.ID, item)\n61: }\n62: \n63: func (s *Store) DeleteMaintenance(id string) error {\n64: \tif err := s.checkDependencies(id, []dependencyCheck{\n65: \t\t{&ServiceLogEntry{}, ColMaintenanceItemID, \"maintenance item has %d service log(s) -- delete them first\"},\n66: \t}); err != nil {\n67: \t\treturn err\n68: \t}\n69: \treturn s.softDelete(&MaintenanceItem{}, DeletionEntityMaintenance, id)\n70: }\n71: \n72: // HardDeleteMaintenance permanently removes a maintenance item and its child\n73: // service log entries. Before deleting, it writes oplog entries for each child\n74: // and detaches any documents linked to the maintenance item or its service\n75: // logs (documents have intrinsic value and survive parent deletion).\n76: func (s *Store) HardDeleteMaintenance(id string) error {\n77: \treturn s.db.Transaction(func(tx *gorm.DB) error {\n78: \t\t// Find all child service log entries (including soft-deleted).\n79: \t\tvar logs []ServiceLogEntry\n80: \t\tif err := tx.Unscoped().\n81: \t\t\tWhere(ColMaintenanceItemID+\" = ?\", id).\n82: \t\t\tFind(&logs).Error; err != nil {\n83: \t\t\treturn err\n84: \t\t}\n85: \n86: \t\t// Detach documents and clean up DeletionRecords for the\n87: \t\t// maintenance item itself.\n88: \t\tif err := detachDocumentsAndCleanup(tx,\n89: \t\t\tDocumentEntityMaintenance, DeletionEntityMaintenance, id); err != nil {\n90: \t\t\treturn err\n91: \t\t}\n92: \n93: \t\t// Detach documents and clean up DeletionRecords for each child\n94: \t\t// service log, then write oplog delete entries.\n95: \t\tfor _, log := range logs {\n96: \t\t\tif err := detachDocumentsAndCleanup(tx,\n97: \t\t\t\tDocumentEntityServiceLog, DeletionEntityServiceLog, log.ID); err != nil {\n98: \t\t\t\treturn err\n99: \t\t\t}\n100: \t\t\tif !isSyncApplying(tx) {\n101: \t\t\t\tif err := writeOplogEntryRaw(tx, TableServiceLogEntries, log.ID, OpDelete); err != nil {\n102: \t\t\t\t\treturn err\n103: \t\t\t\t}\n104: \t\t\t}\n105: \t\t}\n106: \n107: \t\t// Write oplog delete entry for the maintenance item itself.\n108: \t\tif !isSyncApplying(tx) {\n109: \t\t\tif err := writeOplogEntryRaw(tx, TableMaintenanceItems, id, OpDelete); err != nil {\n110: \t\t\t\treturn err\n111: \t\t\t}\n112: \t\t}\n113: \n114: \t\t// Permanently remove the maintenance item (CASCADE deletes children).\n115: \t\tresult := tx.Unscoped().Where(\"id = ?\", id).Delete(&MaintenanceItem{})\n116: \t\tif result.Error != nil {\n117: \t\t\treturn result.Error\n118: \t\t}\n119: \t\tif result.RowsAffected == 0 {\n120: \t\t\treturn gorm.ErrRecordNotFound\n121: \t\t}\n122: \t\treturn nil\n123: \t})\n124: }\n125: \n126: func (s *Store) RestoreMaintenance(id string) error {\n127: \tvar item MaintenanceItem\n128: \tif err := s.db.Unscoped().First(&item, \"id = ?\", id).Error; err != nil {\n129: \t\treturn err\n130: \t}\n131: \treturn s.restoreWithParentChecks(\n132: \t\t&MaintenanceItem{},\n133: \t\tDeletionEntityMaintenance,\n134: \t\tid,\n135: \t\t[]parentCheck{\n136: \t\t\t{&Appliance{}, item.ApplianceID, \"appliance\"},\n137: \t\t},\n138: \t)\n139: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/milin/2026/软件开发/application-atlas/docs/template-factory/go-auxiliary-pilot-2026-10-21/home-care/calls/blueprint-spec-review-aux/source/upstream/internal/data/store_maintenance.go, lines 1-139\n1: // Copyright 2026 Phillip Cloud\n2: // Licensed under the Apache License, Version 2.0\n3: \n4: package data\n5: \n6: import \"gorm.io/gorm\"\n7: \n8: func (s *Store) MaintenanceCategories() ([]MaintenanceCategory, error) {\n9: \tvar categories []MaintenanceCategory\n10: \tif err := s.db.Order(ColName + \" ASC, \" + ColID + \" DESC\").Find(&categories).Error; err != nil {\n11: \t\treturn nil, err\n12: \t}\n13: \treturn categories, nil\n14: }\n15: \n16: func (s *Store) ListMaintenance(includeDeleted bool) ([]MaintenanceItem, error) {\n17: \treturn listQuery[MaintenanceItem](s, includeDeleted, func(db *gorm.DB) *gorm.DB {\n18: \t\treturn db.Preload(\"Category\").\n19: \t\t\tPreload(\"Appliance\", unscopedPreload).\n20: \t\t\tOrder(ColUpdatedAt + \" desc, \" + ColID + \" desc\")\n21: \t})\n22: }\n23: \n24: func (s *Store) ListMaintenanceByAppliance(\n25: \tapplianceID string,\n26: \tincludeDeleted bool,\n27: ) ([]MaintenanceItem, error) {\n28: \treturn listQuery[MaintenanceItem](s, includeDeleted, func(db *gorm.DB) *gorm.DB {\n29: \t\treturn db.Preload(\"Category\").\n30: \t\t\tWhere(ColApplianceID+\" = ?\", applianceID).\n31: \t\t\tOrder(ColUpdatedAt + \" desc, \" + ColID + \" desc\")\n32: \t})\n33: }\n34: \n35: func (s *Store) GetMaintenance(id string) (MaintenanceItem, error) {\n36: \treturn getByID[MaintenanceItem](s, id, func(db *gorm.DB) *gorm.DB {\n37: \t\treturn db.Preload(\"Category\").Preload(\"Appliance\", unscopedPreload)\n38: \t})\n39: }\n40: \n41: func (s *Store) CreateMaintenance(item *MaintenanceItem) error {\n42: \treturn s.db.Create(item).Error\n43: }\n44: \n45: // FindOrCreateMaintenance looks up a maintenance item by name and category.\n46: // If found, returns it. If not found, creates a new one. Soft-deleted items\n47: // with the same name+category are restored.\n48: func (s *Store) FindOrCreateMaintenance(item MaintenanceItem) (MaintenanceItem, error) {\n49: \treturn findOrCreate(s.db, item, item.Name, \"maintenance item name\",\n50: \t\tfunc(db *gorm.DB) *gorm.DB {\n51: \t\t\treturn db.Where(ColName+\" = ? AND \"+ColCategoryID+\" = ?\", item.Name, item.CategoryID)\n52: \t\t},\n53: \t\tDeletionEntityMaintenance,\n54: \t\tfunc(m MaintenanceItem) string { return m.ID },\n55: \t\tfunc(m MaintenanceItem) bool { return m.DeletedAt.Valid },\n56: \t)\n57: }\n58: \n59: func (s *Store) UpdateMaintenance(item MaintenanceItem) error {\n60: \treturn s.updateByID(TableMaintenanceItems, &MaintenanceItem{}, item.ID, item)\n61: }\n62: \n63: func (s *Store) DeleteMaintenance(id string) error {\n64: \tif err := s.checkDependencies(id, []dependencyCheck{\n65: \t\t{&ServiceLogEntry{}, ColMaintenanceItemID, \"maintenance item has %d service log(s) -- delete them first\"},\n66: \t}); err != nil {\n67: \t\treturn err\n68: \t}\n69: \treturn s.softDelete(&MaintenanceItem{}, DeletionEntityMaintenance, id)\n70: }\n71: \n72: // HardDeleteMaintenance permanently removes a maintenance item and its child\n73: // service log entries. Before deleting, it writes oplog entries for each child\n74: // and detaches any documents linked to the maintenance item or its service\n75: // logs (documents have intrinsic value and survive parent deletion).\n76: func (s *Store) HardDeleteMaintenance(id string) error {\n77: \treturn s.db.Transaction(func(tx *gorm.DB) error {\n78: \t\t// Find all child service log entries (including soft-deleted).\n79: \t\tvar logs []ServiceLogEntry\n80: \t\tif err := tx.Unscoped().\n81: \t\t\tWhere(ColMaintenanceItemID+\" = ?\", id).\n82: \t\t\tFind(&logs).Error; err != nil {\n83: \t\t\treturn err\n84: \t\t}\n85: \n86: \t\t// Detach documents and clean up DeletionRecords for the\n87: \t\t// maintenance item itself.\n88: \t\tif err := detachDocumentsAndCleanup(tx,\n89: \t\t\tDocumentEntityMaintenance, DeletionEntityMaintenance, id); err != nil {\n90: \t\t\treturn err\n91: \t\t}\n92: \n93: \t\t// Detach documents and clean up DeletionRecords for each child\n94: \t\t// service log, then write oplog delete entries.\n95: \t\tfor _, log := range logs {\n96: \t\t\tif err := detachDocumentsAndCleanup(tx,\n97: \t\t\t\tDocumentEntityServiceLog, DeletionEntityServiceLog, log.ID); err != nil {\n98: \t\t\t\treturn err\n99: \t\t\t}\n100: \t\t\tif !isSyncApplying(tx) {\n101: \t\t\t\tif err := writeOplogEntryRaw(tx, TableServiceLogEntries, log.ID, OpDelete); err != nil {\n102: \t\t\t\t\treturn err\n103: \t\t\t\t}\n104: \t\t\t}\n105: \t\t}\n106: \n107: \t\t// Write oplog delete entry for the maintenance item itself.\n108: \t\tif !isSyncApplying(tx) {\n109: \t\t\tif err := writeOplogEntryRaw(tx, TableMaintenanceItems, id, OpDelete); err != nil {\n110: \t\t\t\treturn err\n111: \t\t\t}\n112: \t\t}\n113: \n114: \t\t// Permanently remove the maintenance item (CASCADE deletes children).\n115: \t\tresult := tx.Unscoped().Where(\"id = ?\", id).Delete(&MaintenanceItem{})\n116: \t\tif result.Error != nil {\n117: \t\t\treturn result.Error\n118: \t\t}\n119: \t\tif result.RowsAffected == 0 {\n120: \t\t\treturn gorm.ErrRecordNotFound\n121: \t\t}\n122: \t\treturn nil\n123: \t})\n124: }\n125: \n126: func (s *Store) RestoreMaintenance(id string) error {\n127: \tvar item MaintenanceItem\n128: \tif err := s.db.Unscoped().First(&item, \"id = ?\", id).Error; err != nil {\n129: \t\treturn err\n130: \t}\n131: \treturn s.restoreWithParentChecks(\n132: \t\t&MaintenanceItem{},\n133: \t\tDeletionEntityMaintenance,\n134: \t\tid,\n135: \t\t[]parentCheck{\n136: \t\t\t{&Appliance{}, item.ApplianceID, \"appliance\"},\n137: \t\t},\n138: \t)\n139: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\": \"/Users/milin/2026/软件开发/application-atlas/docs/template-factory/go-auxiliary-pilot-2026-10-21/home-care/calls/blueprint-spec-review-aux/source/upstream/internal/data/store_maintenance.go\"}"},"time":{"start":1792571603866,"end":1792571604187}}}}
{"type":"tool_use","timestamp":1792571604188,"sessionID":"ses_ea2691a44ffemHBxOiocBq67ci","part":{"partID":"prt_15d97fccd001JtPtyNrxtC2wcP","sessionID":"ses_ea2691a44ffemHBxOiocBq67ci","messageID":"msg_15d97ee04001rvxC5Kge9Q8RVw","type":"tool","id":"call_02_lpjawkqkmulvglyl7dzt0n7g","tool":"read","state":{"status":"completed","input":{"path":"/Users/milin/2026/软件开发/application-atlas/docs/template-factory/go-auxiliary-pilot-2026-10-21/home-care/calls/blueprint-spec-review-aux/source/upstream/internal/data/validation.go"},"output":"Read file /Users/milin/2026/软件开发/application-atlas/docs/template-factory/go-auxiliary-pilot-2026-10-21/home-care/calls/blueprint-spec-review-aux/source/upstream/internal/data/validation.go, lines 1-192\n1: // Copyright 2026 Phillip Cloud\n2: // Licensed under the Apache License, Version 2.0\n3: \n4: package data\n5: \n6: import (\n7: \t\"errors\"\n8: \t\"math\"\n9: \t\"regexp\"\n10: \t\"strconv\"\n11: \t\"strings\"\n12: \t\"time\"\n13: \n14: \t\"github.com/tj/go-naturaldate\"\n15: )\n16: \n17: const DateLayout = \"2006-01-02\"\n18: \n19: var (\n20: \tErrInvalidDate        = errors.New(\"invalid date value\")\n21: \tErrInvalidInt         = errors.New(\"invalid integer value\")\n22: \tErrInvalidFloat       = errors.New(\"invalid decimal value\")\n23: \tErrInvalidInterval    = errors.New(\"invalid interval value\")\n24: \tErrIntervalAndDueDate = errors.New(\"set interval or due date, not both\")\n25: )\n26: \n27: func ParseRequiredDate(input string) (time.Time, error) {\n28: \treturn ParseRequiredDateAt(input, time.Now())\n29: }\n30: \n31: func ParseRequiredDateAt(input string, ref time.Time) (time.Time, error) {\n32: \ttrimmed := strings.TrimSpace(input)\n33: \tif trimmed == \"\" {\n34: \t\treturn time.Time{}, ErrInvalidDate\n35: \t}\n36: \tparsed, err := parseDate(trimmed, ref)\n37: \tif err != nil {\n38: \t\treturn time.Time{}, ErrInvalidDate\n39: \t}\n40: \treturn parsed, nil\n41: }\n42: \n43: func ParseOptionalDate(input string) (*time.Time, error) {\n44: \treturn ParseOptionalDateAt(input, time.Now())\n45: }\n46: \n47: func ParseOptionalDateAt(input string, ref time.Time) (*time.Time, error) {\n48: \ttrimmed := strings.TrimSpace(input)\n49: \tif trimmed == \"\" {\n50: \t\treturn nil, nil //nolint:nilnil // empty optional input is not an error\n51: \t}\n52: \tparsed, err := parseDate(trimmed, ref)\n53: \tif err != nil {\n54: \t\treturn nil, ErrInvalidDate\n55: \t}\n56: \treturn &parsed, nil\n57: }\n58: \n59: // parseDate tries strict YYYY-MM-DD first, then falls back to natural language\n60: // parsing relative to ref. The result is always truncated to date-only (midnight UTC).\n61: func parseDate(input string, ref time.Time) (time.Time, error) {\n62: \tif t, err := time.Parse(DateLayout, input); err == nil {\n63: \t\treturn t, nil\n64: \t}\n65: \tt, err := naturaldate.Parse(input, ref, naturaldate.WithDirection(naturaldate.Past))\n66: \tif err != nil {\n67: \t\treturn time.Time{}, ErrInvalidDate\n68: \t}\n69: \t// naturaldate silently returns the reference time for unrecognized input.\n70: \t// Reject results that exactly match the reference (the only false\n71: \t// positive is \"now\", but \"today\" already works for that intent).\n72: \tif t.Equal(ref) {\n73: \t\treturn time.Time{}, ErrInvalidDate\n74: \t}\n75: \ty, m, d := t.Date()\n76: \treturn time.Date(y, m, d, 0, 0, 0, 0, time.UTC), nil\n77: }\n78: \n79: func FormatDate(value *time.Time) string {\n80: \tif value == nil {\n81: \t\treturn \"\"\n82: \t}\n83: \treturn value.Format(DateLayout)\n84: }\n85: \n86: func ParseOptionalInt(input string) (int, error) {\n87: \ttrimmed := strings.TrimSpace(input)\n88: \tif trimmed == \"\" {\n89: \t\treturn 0, nil\n90: \t}\n91: \tvalue, err := strconv.Atoi(trimmed)\n92: \tif err != nil || value < 0 {\n93: \t\treturn 0, ErrInvalidInt\n94: \t}\n95: \treturn value, nil\n96: }\n97: \n98: // intervalRe matches duration strings like \"1y\", \"6m\", \"2y 6m\", \"1y6m\".\n99: var intervalRe = regexp.MustCompile(\n100: \t`(?i)^\\s*(?:(\\d+)\\s*y)?\\s*(?:(\\d+)\\s*m)?\\s*$`,\n101: )\n102: \n103: // ParseIntervalMonths parses a human-friendly interval into months.\n104: // Accepts bare integers (\"12\"), month suffix (\"6m\"), year suffix (\"1y\"),\n105: // or combined (\"2y 6m\", \"1y6m\"). Case-insensitive, whitespace-flexible.\n106: // Returns (0, nil) for empty/blank input (non-recurring).\n107: func ParseIntervalMonths(input string) (int, error) {\n108: \ttrimmed := strings.TrimSpace(input)\n109: \tif trimmed == \"\" {\n110: \t\treturn 0, nil\n111: \t}\n112: \t// Try bare integer first.\n113: \tif value, err := strconv.Atoi(trimmed); err == nil {\n114: \t\tif value < 0 {\n115: \t\t\treturn 0, ErrInvalidInterval\n116: \t\t}\n117: \t\treturn value, nil\n118: \t}\n119: \tmatches := intervalRe.FindStringSubmatch(trimmed)\n120: \tif matches == nil {\n121: \t\treturn 0, ErrInvalidInterval\n122: \t}\n123: \tyearStr, monthStr := matches[1], matches[2]\n124: \t// Regex matched but both groups empty means the pattern matched\n125: \t// zero-length content -- reject.\n126: \tif yearStr == \"\" && monthStr == \"\" {\n127: \t\treturn 0, ErrInvalidInterval\n128: \t}\n129: \tvar total int\n130: \tif yearStr != \"\" {\n131: \t\ty, err := strconv.Atoi(yearStr)\n132: \t\tif err != nil {\n133: \t\t\treturn 0, ErrInvalidInterval\n134: \t\t}\n135: \t\tif y > math.MaxInt/12 {\n136: \t\t\treturn 0, ErrInvalidInterval\n137: \t\t}\n138: \t\ttotal += y * 12\n139: \t}\n140: \tif monthStr != \"\" {\n141: \t\tm, err := strconv.Atoi(monthStr)\n142: \t\tif err != nil {\n143: \t\t\treturn 0, ErrInvalidInterval\n144: \t\t}\n145: \t\tif total > math.MaxInt-m {\n146: \t\t\treturn 0, ErrInvalidInterval\n147: \t\t}\n148: \t\ttotal += m\n149: \t}\n150: \tif total < 0 {\n151: \t\treturn 0, ErrInvalidInterval\n152: \t}\n153: \treturn total, nil\n154: }\n155: \n156: func ParseOptionalFloat(input string) (float64, error) {\n157: \ttrimmed := strings.TrimSpace(input)\n158: \tif trimmed == \"\" {\n159: \t\treturn 0, nil\n160: \t}\n161: \tvalue, err := strconv.ParseFloat(trimmed, 64)\n162: \tif err != nil || value < 0 {\n163: \t\treturn 0, ErrInvalidFloat\n164: \t}\n165: \treturn value, nil\n166: }\n167: \n168: func ComputeNextDue(last *time.Time, intervalMonths int, dueDate *time.Time) *time.Time {\n169: \tif dueDate != nil {\n170: \t\treturn dueDate\n171: \t}\n172: \tif last == nil || intervalMonths <= 0 {\n173: \t\treturn nil\n174: \t}\n175: \tnext := AddMonths(*last, intervalMonths)\n176: \treturn &next\n177: }\n178: \n179: // AddMonths adds the given number of months to t, clamping the day to the\n180: // last day of the target month. This avoids the time.AddDate gotcha where\n181: // Jan 31 + 1 month = March 3 instead of Feb 28.\n182: func AddMonths(t time.Time, months int) time.Time {\n183: \ty, m, d := t.Date()\n184: \ttargetMonth := m + time.Month(months)\n185: \t// Day 0 of the NEXT month gives the last day of the target month.\n186: \tlastDay := time.Date(y, targetMonth+1, 0, 0, 0, 0, 0, t.Location()).Day()\n187: \tif d > lastDay {\n188: \t\td = lastDay\n189: \t}\n190: \treturn time.Date(y, targetMonth, d,\n191: \t\tt.Hour(), t.Minute(), t.Second(), t.Nanosecond(), t.Location())\n192: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/milin/2026/软件开发/application-atlas/docs/template-factory/go-auxiliary-pilot-2026-10-21/home-care/calls/blueprint-spec-review-aux/source/upstream/internal/data/validation.go, lines 1-192\n1: // Copyright 2026 Phillip Cloud\n2: // Licensed under the Apache License, Version 2.0\n3: \n4: package data\n5: \n6: import (\n7: \t\"errors\"\n8: \t\"math\"\n9: \t\"regexp\"\n10: \t\"strconv\"\n11: \t\"strings\"\n12: \t\"time\"\n13: \n14: \t\"github.com/tj/go-naturaldate\"\n15: )\n16: \n17: const DateLayout = \"2006-01-02\"\n18: \n19: var (\n20: \tErrInvalidDate        = errors.New(\"invalid date value\")\n21: \tErrInvalidInt         = errors.New(\"invalid integer value\")\n22: \tErrInvalidFloat       = errors.New(\"invalid decimal value\")\n23: \tErrInvalidInterval    = errors.New(\"invalid interval value\")\n24: \tErrIntervalAndDueDate = errors.New(\"set interval or due date, not both\")\n25: )\n26: \n27: func ParseRequiredDate(input string) (time.Time, error) {\n28: \treturn ParseRequiredDateAt(input, time.Now())\n29: }\n30: \n31: func ParseRequiredDateAt(input string, ref time.Time) (time.Time, error) {\n32: \ttrimmed := strings.TrimSpace(input)\n33: \tif trimmed == \"\" {\n34: \t\treturn time.Time{}, ErrInvalidDate\n35: \t}\n36: \tparsed, err := parseDate(trimmed, ref)\n37: \tif err != nil {\n38: \t\treturn time.Time{}, ErrInvalidDate\n39: \t}\n40: \treturn parsed, nil\n41: }\n42: \n43: func ParseOptionalDate(input string) (*time.Time, error) {\n44: \treturn ParseOptionalDateAt(input, time.Now())\n45: }\n46: \n47: func ParseOptionalDateAt(input string, ref time.Time) (*time.Time, error) {\n48: \ttrimmed := strings.TrimSpace(input)\n49: \tif trimmed == \"\" {\n50: \t\treturn nil, nil //nolint:nilnil // empty optional input is not an error\n51: \t}\n52: \tparsed, err := parseDate(trimmed, ref)\n53: \tif err != nil {\n54: \t\treturn nil, ErrInvalidDate\n55: \t}\n56: \treturn &parsed, nil\n57: }\n58: \n59: // parseDate tries strict YYYY-MM-DD first, then falls back to natural language\n60: // parsing relative to ref. The result is always truncated to date-only (midnight UTC).\n61: func parseDate(input string, ref time.Time) (time.Time, error) {\n62: \tif t, err := time.Parse(DateLayout, input); err == nil {\n63: \t\treturn t, nil\n64: \t}\n65: \tt, err := naturaldate.Parse(input, ref, naturaldate.WithDirection(naturaldate.Past))\n66: \tif err != nil {\n67: \t\treturn time.Time{}, ErrInvalidDate\n68: \t}\n69: \t// naturaldate silently returns the reference time for unrecognized input.\n70: \t// Reject results that exactly match the reference (the only false\n71: \t// positive is \"now\", but \"today\" already works for that intent).\n72: \tif t.Equal(ref) {\n73: \t\treturn time.Time{}, ErrInvalidDate\n74: \t}\n75: \ty, m, d := t.Date()\n76: \treturn time.Date(y, m, d, 0, 0, 0, 0, time.UTC), nil\n77: }\n78: \n79: func FormatDate(value *time.Time) string {\n80: \tif value == nil {\n81: \t\treturn \"\"\n82: \t}\n83: \treturn value.Format(DateLayout)\n84: }\n85: \n86: func ParseOptionalInt(input string) (int, error) {\n87: \ttrimmed := strings.TrimSpace(input)\n88: \tif trimmed == \"\" {\n89: \t\treturn 0, nil\n90: \t}\n91: \tvalue, err := strconv.Atoi(trimmed)\n92: \tif err != nil || value < 0 {\n93: \t\treturn 0, ErrInvalidInt\n94: \t}\n95: \treturn value, nil\n96: }\n97: \n98: // intervalRe matches duration strings like \"1y\", \"6m\", \"2y 6m\", \"1y6m\".\n99: var intervalRe = regexp.MustCompile(\n100: \t`(?i)^\\s*(?:(\\d+)\\s*y)?\\s*(?:(\\d+)\\s*m)?\\s*$`,\n101: )\n102: \n103: // ParseIntervalMonths parses a human-friendly interval into months.\n104: // Accepts bare integers (\"12\"), month suffix (\"6m\"), year suffix (\"1y\"),\n105: // or combined (\"2y 6m\", \"1y6m\"). Case-insensitive, whitespace-flexible.\n106: // Returns (0, nil) for empty/blank input (non-recurring).\n107: func ParseIntervalMonths(input string) (int, error) {\n108: \ttrimmed := strings.TrimSpace(input)\n109: \tif trimmed == \"\" {\n110: \t\treturn 0, nil\n111: \t}\n112: \t// Try bare integer first.\n113: \tif value, err := strconv.Atoi(trimmed); err == nil {\n114: \t\tif value < 0 {\n115: \t\t\treturn 0, ErrInvalidInterval\n116: \t\t}\n117: \t\treturn value, nil\n118: \t}\n119: \tmatches := intervalRe.FindStringSubmatch(trimmed)\n120: \tif matches == nil {\n121: \t\treturn 0, ErrInvalidInterval\n122: \t}\n123: \tyearStr, monthStr := matches[1], matches[2]\n124: \t// Regex matched but both groups empty means the pattern matched\n125: \t// zero-length content -- reject.\n126: \tif yearStr == \"\" && monthStr == \"\" {\n127: \t\treturn 0, ErrInvalidInterval\n128: \t}\n129: \tvar total int\n130: \tif yearStr != \"\" {\n131: \t\ty, err := strconv.Atoi(yearStr)\n132: \t\tif err != nil {\n133: \t\t\treturn 0, ErrInvalidInterval\n134: \t\t}\n135: \t\tif y > math.MaxInt/12 {\n136: \t\t\treturn 0, ErrInvalidInterval\n137: \t\t}\n138: \t\ttotal += y * 12\n139: \t}\n140: \tif monthStr != \"\" {\n141: \t\tm, err := strconv.Atoi(monthStr)\n142: \t\tif err != nil {\n143: \t\t\treturn 0, ErrInvalidInterval\n144: \t\t}\n145: \t\tif total > math.MaxInt-m {\n146: \t\t\treturn 0, ErrInvalidInterval\n147: \t\t}\n148: \t\ttotal += m\n149: \t}\n150: \tif total < 0 {\n151: \t\treturn 0, ErrInvalidInterval\n152: \t}\n153: \treturn total, nil\n154: }\n155: \n156: func ParseOptionalFloat(input string) (float64, error) {\n157: \ttrimmed := strings.TrimSpace(input)\n158: \tif trimmed == \"\" {\n159: \t\treturn 0, nil\n160: \t}\n161: \tvalue, err := strconv.ParseFloat(trimmed, 64)\n162: \tif err != nil || value < 0 {\n163: \t\treturn 0, ErrInvalidFloat\n164: \t}\n165: \treturn value, nil\n166: }\n167: \n168: func ComputeNextDue(last *time.Time, intervalMonths int, dueDate *time.Time) *time.Time {\n169: \tif dueDate != nil {\n170: \t\treturn dueDate\n171: \t}\n172: \tif last == nil || intervalMonths <= 0 {\n173: \t\treturn nil\n174: \t}\n175: \tnext := AddMonths(*last, intervalMonths)\n176: \treturn &next\n177: }\n178: \n179: // AddMonths adds the given number of months to t, clamping the day to the\n180: // last day of the target month. This avoids the time.AddDate gotcha where\n181: // Jan 31 + 1 month = March 3 instead of Feb 28.\n182: func AddMonths(t time.Time, months int) time.Time {\n183: \ty, m, d := t.Date()\n184: \ttargetMonth := m + time.Month(months)\n185: \t// Day 0 of the NEXT month gives the last day of the target month.\n186: \tlastDay := time.Date(y, targetMonth+1, 0, 0, 0, 0, 0, t.Location()).Day()\n187: \tif d > lastDay {\n188: \t\td = lastDay\n189: \t}\n190: \treturn time.Date(y, targetMonth, d,\n191: \t\tt.Hour(), t.Minute(), t.Second(), t.Nanosecond(), t.Location())\n192: }"}],"providerCall":{"executed":fal