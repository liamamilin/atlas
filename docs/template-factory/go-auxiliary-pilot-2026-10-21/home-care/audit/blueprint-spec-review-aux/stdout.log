:\"id\"`\n241: \tTitle          string         `                                                                               json:\"title\"`\n242: \tDescription    string         `                                                                               json:\"description\"`\n243: \tStatus         string         `                                                                               json:\"status\"          default:\"open\"`\n244: \tPreviousStatus string         `                                                                               json:\"previous_status\"                extract:\"-\"`\n245: \tSeverity       string         `                                                                               json:\"severity\"        default:\"soon\"`\n246: \tDateNoticed    time.Time      `                                                                               json:\"date_noticed\"    default:\"now\"`\n247: \tDateResolved   *time.Time     `                                                                               json:\"date_resolved\"                  extract:\"-\"`\n248: \tLocation       string         `                                                                               json:\"location\"`\n249: \tCostCents      *int64         `                                                                               json:\"cost_cents\"`\n250: \tApplianceID    *string        `gorm:\"index\"                                                                   json:\"appliance_id\"`\n251: \tAppliance      Appliance      `gorm:\"constraint:OnDelete:SET NULL;\"                                           json:\"-\"`\n252: \tVendorID       *string        `gorm:\"index\"                                                                   json:\"vendor_id\"`\n253: \tVendor         Vendor         `gorm:\"constraint:OnDelete:SET NULL;\"                                           json:\"-\"`\n254: \tNotes          string         `                           