01', 0, equipment['id'])\n215:     check([task['id'] for task in filtered] == [far['id']], 'equipment filter must isolate the equipment plan')\n216:     filtered_plans = list_plans(base_url, home['id'], equipment['id'])\n217:     check([plan['id'] for plan in filtered_plans] == [far['id']], 'plan equipment filter must isolate the equipment plan')\n218:     detail = get_plan(base_url, far['id'])\n219:     check(detail['due_on'] == '2026-03-01' and detail['completion_count'] == 0, 'plan detail must expose due date and count')\n220:     for as_of, horizon in (('2026-02-30', 0), ('2026-02-29', 0), ('2026-03-01', -1), ('2026-03-01', 366)):\n221:         expect_error(base_url, 'GET', due_path(home['id'], as_of, horizon), None, 422, 'VALIDATION_ERROR')\n222:     expect_error(base_url, 'GET', '/api/tasks/due?as_of=2026-03-01', None, 422, 'VALIDATION_ERROR')\n223:     expect_error(base_url, 'GET', due_path('missing-home', '2026-03-01'), None, 404, 'HOME_NOT_FOUND')\n224:     check(len(list_plans(base_url, home['id'])) == baseline + 2, 'due query errors must not write plans')\n225: \n226: \n227: def case_a03(base_url):\n228:     home = ensure_home(base_url)\n229:     equipment = create_equipment(base_url, home['id'], 'A03')\n230:     plan = create_plan(base_url, home['id'], 'A03', 30, equipment_id=equipment['id'], first_due_on='2024-01-01')\n231:     before_plan = get_plan(base_url, plan['id'])\n232:     before_logs = list_completions(base_url, plan['id'])\n233:     future = (dt.date.today() + dt.timedelta(days=2)).isoformat()\n234:     expect_error(base_url, 'POST', '/api/plans/' + plan['id'] + '/completions', {'completed_on': future, 'note': 'future'}, 422, 'VALIDATION_ERROR')\n235:     expect_error(base_url, 'POST', '/api/plans/' + plan['id'] + '/completions', {'completed_on': '2026-02-30', 'note': 'bad'}, 422, 'VALIDATION_ERROR')\n236:     expect_error(base_url, 'POST', '/api/plans/' + plan['id'] + '/completions', {'completed_on': '2025-01-01', 'note': 'x' * 501}, 422, 'VALIDATION_ERROR')\n237:     expect_error(base_url, 'POST', '/api/plans/pl_missing/completions', {'completed_on': '2025-01-01', 'note': ''}, 404, 'PLAN_NOT_FOUND')\n238:     check(get_plan(base_url, plan['id']) == before_plan, 'invalid completions must not change plan')\n239:     check(list_completions(base_url, plan['id']) == before_logs, 'invalid completions must not append history')\n240:     first = create_completion(base_url, plan['id'], '2024-02-29', '  Leap-day check  ')\n241:     check(first['completion']['note'] == 'Leap-day check', 'note must be trimmed')\n242:     check(first['plan']['last_completed_on'] == '2024-02-29', 'leap completion must set last date')\n243:     check(first['plan']['due_on'] == '2024-03-30', 'leap completion must advance thirty days')\n244:     check(first['plan']['completion_count'] == len(before_logs) + 1, 'completion count must increment')\n245:     back = create_completion(base_url, plan['id'], '2024-01-15', 'Backdated')\n246:     check(back['plan']['last_completed_on'] == '2024-02-29', 'backdated completion must not regress last date')\n247:     check(back['plan']['due_on'] == '2024-03-30', 'backdated completion must not regress due date')\n248:     year = create_completion(base_url, plan['id'], '2024-12-31', 'Year end')\n249:     check(year['plan']['due_on'] == '2025-01-30', 'year-end plus thirty days failed')\n250:     month_plan = create_plan(base_url, home['id'], 'A03M', 31, first_due_on='2024-01-01')\n251:     month = create_completion(base_url, month_plan['id'], '2026-01-31', 'Month end')\n252:     check(month['plan']['due_on'] == '2026-03-03', 'month-end plus thirty-one days failed')\n253:     leap_plan = create_plan(base_url, home['id'], 'A03L', 1, first_due_on='2024-02-28')\n254:     leap_one = create_completion(base_url, leap_plan['id'], '2024-02-28', 'Leap start')\n255:     check(leap_one['plan']['due_on'] == '2024-02-29', 'leap day plus one day failed')\n256:     leap_two = create_completion(base_url, leap_plan['id'], '2024-02-29', 'Leap day')\n257:     check(leap_two['plan']['due_on'] == '2024-03-01', 'post-leap day plus one day failed')\n258:     note_plan = create_plan(base_url, home['id'], 'A03N', 10, first_due_on='2025-01-01')\n259:     note_result = create_completion(base_url, note_plan['id'], '2025-01-01', 'x' * 500)\n260:     check(len(note_result['completion']['note']) == 500, 'five hundred code point note must be accepted')\n261:     logs = list_completions(base_url, plan['id'])\n262:     dates = [entry['completed_on'] for entry in logs]\n263:     check(dates == ['2024-12-31', '2024-02-29', '2024-01-15'], 'plan history order failed')\n264: \n265: \n266: def case_a04(base_url):\n267:     home = ensure_home(base_url)\n268:     eq_a = create_equipment(base_url, home['id'], 'A04A', 'heating')\n269:     eq_b = create_equipment(base_url, home['id'], 'A04B', 'plumbing')\n270:     plan_a = create_plan(base_url, home['id'], 'A04A', 10, equipment_id=eq_a['id'], first_due_on='2025-01-01')\n271:     plan_b = create_plan(base_url, home['id'], 'A04B', 20, equipment_id=eq_b['id'], first_due_on='2025-01-01')\n272:     create_plan(base_url, home['id'], 'A04C', 30, first_due_on='2025-01-01')\n273:     c_a1 = create_completion(base_url, plan_a['id'], '2025-01-10', '  A one  ')['completion']\n274:     c_a2 = create_completion(base_url, plan_a['id'], '2025-02-10', 'A two')['completion']\n275:     c_b1 = create_completion(base_url, plan_b['id'], '2025-02-15', 'B one')['completion']\n276:     check(c_a1['note'] == 'A one', 'history note must be trimmed')\n277:     entries = history_entries(base_url, home['id'], limit=500)\n278:     for left, right in zip(entries, entries[1:]):\n279:         check(left['completed_on'] >= right['completed_on'], 'history must sort by completed_on descending')\n280:     positions = {entry['id']: index for index, entry in enumerate(entries)}\n281:     check(positions[c_b1['id']] < positions[c_a2['id']] < positions[c_a1['id']], 'history ordering across plans failed')\n282:     for completion in (c_a1, c_a2, c_b1):\n283:         entry = entries[positions[completion['id']]]\n284:         for field in ('plan_id', 'plan_name', 'home_id', 'home_name', 'equipment_id', 'equipment_name', 'completed_on', 'note', 'created_at'):\n285:             check(field in entry, 'history entry missing field ' + field)\n286:     filtered_a = history_entries(base_url, home['id'], eq_a['id'], 500)\n287:     ids_a = {entry['id'] for entry in filtered_a}\n288:     check(c_a1['id'] in ids_a and c_a2['id'] in ids_a and c_b1['id'] not in ids_a, 'equipment A history filter failed')\n289:     check(all(entry['equipment_id'] == eq_a['id'] for entry in filtered_a), 'equipment A filter leaked another equipment')\n290:     filtered_b = history_entries(base_url, home['id'], eq_b['id'], 500)\n291:     ids_b = {entry['id'] for entry in filtered_b}\n292:     check(c_b1['id'] in ids_b and c_a1['id'] not in ids_b, 'equipment B history filter failed')\n293:     plan_logs = list_completions(base_url, plan_a['id'])\n294:     check([entry['completed_on'] for entry in plan_logs] == ['2025-02-10', '2025-01-10'], 'plan completion history order failed')\n295:     limited = history_entries(base_url, home['id'], limit=1)\n296:     check(len(limited) == 1, 'history limit one failed')\n297:     before_count = len(list_plans(base_url, home['id']))\n298:     expect_error(base_url, 'GET', '/api/history', None, 422, 'VALIDATION_ERROR')\n299:     expect_error(base_url, 'GET', history_path('missing-home'), None, 404, 'HOME_NOT_FOUND')\n300:     expect_error(base_url, 'GET', history_path(home['id'], 'eq_missing'), None, 404, 'EQUIPMENT_NOT_FOUND')\n301:     expect_error(base_url, 'GET', history_path(home['id'], limit=0), None, 422, 'VALIDATION_ERROR')\n302:     expect_error(base_url, 'GET', history_path(home['id'], limit=501), None, 422, 'VALIDATION_ERROR')\n303:     check(len(list_plans(base_url, home['id'])) == before_count, 'history errors must not write plans')\n304: \n305: \n306: def case_a05(base_url):\n307:     status, parsed, raw, ctype = request(base_url, 'GET', '/')\n308:     check(status == 200, f'GET /: expected 200, got {status}')\n309:     check('text/html' in ctype.lower(), f'GET /: expected HTML, got {ctype!r}')\n310:     text = raw.decode('utf-8').lower()\n311:     for token in ('<html lang=', '<label', '<form', '<button', 'aria-live', 'home', 'equipment', 'due', 'history', 'complete'):\n312:         check(token in text, 'UI missing token ' + token)\n313:     check('<script src=' not in text, 'UI must not load external scripts')\n314:     health = api(base_url, 'GET', '/health')\n315:     check(health.get('status') == 'ok', 'health status must be ok')\n316:     expect_error(base_url, 'GET', '/api/unknown', None, 404, 'NOT_FOUND')\n317:     expect_error(base_url, 'DELETE', '/api/home', None, 405, 'METHOD_NOT_ALLOWED')\n318: \n319: \n320: CASES = {'A01': case_a01, 'A02': case_a02, 'A03': case_a03, 'A04': case_a04, 'A05': case_a05}\n321: \n322: \n323: def main():\n324:     parser = argparse.ArgumentParser(description='Home Care Ledger acceptance probe')\n325:     parser.add_argument('--base-url', default='http://127.0.0.1:8765')\n326:     parser.add_argument('--case', required=True, choices=sorted(CASES))\n327:     args = parser.parse_args()\n328:     try:\n329:         CASES[args.case](args.base_url)\n330:     except ProbeFailure as exc:\n331:         print('FAIL ' + args.case + ': ' + str(exc))\n332:         return 1\n333:     except Exception as exc:\n334:         print('ERROR ' + args.case + ': ' + type(exc).__name__ + ': ' + str(exc))\n335:         return 1\n336:     print('PASS ' + args.case)\n337:     return 0\n338: \n339: \n340: if __name__ == '__main__':\n341:     sys.exit(main())","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/milin/2026/软件开发/application-atlas/docs/template-factory/go-home-care-revision-2026-10-21/home-care-r1/calls/blueprint-generate-aux-revi