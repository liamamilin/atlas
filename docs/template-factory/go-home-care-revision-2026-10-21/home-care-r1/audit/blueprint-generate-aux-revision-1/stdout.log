n268:     eq_a = create_equipment(base_url, home['id'], 'A04A', 'heating')\n269:     eq_b = create_equipment(base_url, home['id'], 'A04B', 'plumbing')\n270:     plan_a = create_plan(base_url, home['id'], 'A04A', 10, equipment_id=eq_a['id'], first_due_on='2025-01-01')\n271:     plan_b = create_plan(base_url, home['id'], 'A04B', 20, equipment_id=eq_b['id'], first_due_on='2025-01-01')\n272:     create_plan(base_url, home['id'], 'A04C', 30, first_due_on='2025-01-01')\n273:     c_a1 = create_completion(base_url, plan_a['id'], '2025-01-10', '  A one  ')['completion']\n274:     c_a2 = create_completion(base_url, plan_a['id'], '2025-02-10', 'A two')['completion']\n275:     c_b1 = create_completion(base_url, plan_b['id'], '2025-02-15', 'B one')['completion']\n276:     check(c_a1['note'] == 'A one', 'history note must be trimmed')\n277:     entries = history_entries(base_url, home['id'], limit=500)\n278:     for left, right in zip(entries, entries[1:]):\n279:         check(left['completed_on'] >= right['completed_on'], 'history must sort by completed_on descending')\n280:     positions = {entry['id']: index for index, entry in enumerate(entries)}\n281:     check(positions[c_b1['id']] < positions[c_a2['id']] < positions[c_a1['id']], 'history ordering across plans failed')\n282:     for completion in (c_a1, c_a2, c_b1):\n283:         entry = entries[positions[completion['id']]]\n284:         for field in ('plan_id', 'plan_name', 'home_id', 'home_name', 'equipment_id', 'equipment_name', 'completed_on', 'note', 'created_at'):\n285:             check(field in entry, 'history entry missing field ' + field)\n286:     filtered_a = history_entries(base_url, home['id'], eq_a['id'], 500)\n287:     ids_a = {entry['id'] for entry in filtered_a}\n288:     check(c_a1['id'] in ids_a and c_a2['id'] in ids_a and c_b1['id'] not in ids_a, 'equipment A history filter failed')\n289:     check(all(entry['equipment_id'] == eq_a['id'] for entry in filtered_a), 'equipment A filter leaked another equipment')\n290:     filtered_b = history_entries(base_url, home['id'], eq_b['id'], 500)\n291:     ids_b = {entry['id'] for entry in filtered_b}\n292:     check(c_b1['id'] in ids_b and c_a1['id'] not in ids_b, 'equipment B history filter failed')\n293:     plan_logs = list_completions(base_url, plan_a['id'])\n294:     check([entry['completed_on'] for entry in plan_logs] == ['2025-02-10', '2025-01-10'], 'plan completion history order failed')\n295:     limited = history_entries(base_url, home['id'], limit=1)\n296:     check(len(limited) == 1, 'history limit one failed')\n297:     before_count = len(list_plans(base_url, home['id']))\n298:     expect_error(base_url, 'GET', '/api/history', None, 422, 'VALIDATION_ERROR')\n299:     expect_error(base_url, 'GET', history_path('missing-home'), None, 404, 'HOME_NOT_FOUND')\n300:     expect_error(base_url, 'GET', history_path(home['id'], 'eq_missing'), None, 404, 'EQUIPMENT_NOT_FOUND')\n301:     expect_error(base_url, 'GET', history_path(home['id'], limit=0), None, 422, 'VALIDATION_ERROR')\n302:     expect_error(base_url, 'GET', history_path(home['id'], limit=501), None, 422, 'VALIDATION_ERROR')\n303:     check(len(list_plans(base_url, home['id'])) == before_count, 'history errors must not write plans')\n304: \n305: \n306: def case_a05(base_url):\n307:     status, parsed, raw, ctype = request(base_url, 'GET', '/')\n308:     check(status == 200, f'GET /: expected 200, got {status}')\n309:     check('text/html' in ctype.lower(), f'GET /: expected HTML, got {ctype!r}')\n310:     text = raw.decode('utf-8').lower()\n311:     for token in ('<html lang=', '<label', '<form', '<button', 'aria-live', 'home', 'equipment', 'due', 'history', 'complete'):\n312:         check(token in text, 'UI missing token ' + token)\n313:     check('<script src=' not in text, 'UI must not load external scripts')\n314:     health = api(base_url, 'GET', '/health')\n315:     check(health.get('status') == 'ok', 'health status must be ok')\n316:     expect_error(base_url, 'GET', '/api/unknown', None, 404, 'NOT_FOUND')\n317:     expect_error(base_url, 'DELETE', '/api/home', None, 405, 'METHOD_NOT_ALLOWED')\n318: \n319: \n320: CASES = {'A01': case_a01, 'A02': case_a02, 'A03': case_a03, 'A04': case_a04, 'A05': case_a05}\n321: \n322: \n323: def main():\n324:     parser = argparse.ArgumentParser(description='Home Care Ledger acceptance probe')\n325:     parser.add_argument('--base-url', default='http://127.0.0.1:8765')\n326:     parser.add_argument('--case', required=True, choices=sorted(CASES))\n327:     args = parser.parse_args()\n328:     try:\n329:         CASES[args.case](args.base_url)\n330:     except ProbeFailure as exc:\n331:         print('FAIL ' + args.case + ': ' + str(exc))\n332:         return 1\n333:     except Exception as exc:\n334:         print('ERROR ' + args.case + ': ' + type(exc).__name__ + ': ' + str(exc))\n335:         return 1\n336:     print('PASS ' + args.case)\n337:     return 0\n338: \n339: \n340: if __name__ == '__main__':\n341:     sys.exit(main())"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\": \"/Users/milin/2026/软件开发/application-atlas/docs/template-factory/go-home-care-revision-2026-10-21/home-care-r1/calls/blueprint-generate-aux-revision-1/source/candidate/acceptance/probe.py\", \"offset\": 200, \"limit\": 200}"},"time":{"start":1792577889141,"end":1792577889424}}}}
{"type":"step_finish","timestamp":1792577889507,"sessionID":"ses_ea208589fffeY8gRHkM8pRFG1I","part":{"id":"prt_15df7e4e3001nNEsntJ6SwN2fw","sessionID":"ses_ea208589fffeY8gRHkM8pRFG1I","messageID":"msg_15df7d9f6001BN95WF7oQyyhQp","type":"step-finish","reason":"tool-calls","snapshot":"d97211d0b99078315740c0236ecf9e6af54a5785","cost":0.0031849499999999998,"tokens":{"input":20733,"output":125,"reasoning":0,"cache":{"read":0,"write":0}}}}
{"type":"step_start","timestamp":1792577891482,"sessionID":"ses_ea208589fffeY8gRHkM8pRFG1I","part":{"id":"prt_15df7ec9a001cK7YUC4yxXtg7r","sessionID":"ses_ea208589fffeY8gRHkM8pRFG1I","messageID":"msg_15df7e4e8001G2cMTuur11xWRQ","type":"step-start","snapshot":"cf8af1943ff1aa3e79f6ee48e1e0deeaf6fed07d"}}
{"type":"text","timestamp":1792578027057,"sessionID":"ses_ea208589fffeY8gRHkM8pRFG1I","part":{"id":"prt_15df97707001irPQC4V8F3Arm7","sessionID":"ses_ea208589fffeY8gRHkM8pRFG1I","messageID":"msg_15df7e4e8001G2cMTuur11xWRQ","type":"text","text":"{\"authored_updates\":{\"objective\":\"Create the home and its equipment, define every-N-day care plans anchored to them, see the exact sets of tasks that are overdue, due, or upcoming as of a date, record a completion with a note, advance the next due date to max(old due_on, latest completion + interval_days) so it never regresses, and retrieve care history by home or equipment.\",\"workflow\":[\"Start the local server against a disposable data directory; initialize the SQLite schema on first start.\",\"Create the single home with POST /api/home, then add equipment records with POST /api/equipment anchored by home_id.\",\"Create care plans with POST /api/plans using interval_days and an optional equipment anchor.\",\"Query GET /api/tasks/due with an explicit as_of and horizon_days to see the exact overdue, due, and upcoming task sets.\",\"Record a completion and note with POST /api/plans/{id}/completions; one transaction appends the actual completion and note, stores the true latest completion date, and sets due_on to max(old due_on, latest + interval_days).\",\"Read GET /api/plans/{id}/completions or GET /api/history filtered by home_id and equipment_id.\",\"Use GET / for the basic accessible single-page UI; all actions remain available through the documented JSON API.\"],\"acceptance\":[\"A fresh database has no home; POST /api/home creates exactly one record with id home, and a second POST returns 409 HOME_EXISTS without mutating the stored home.\",\"POST /api/equipment under the existing home returns 201 and round-trips through list and detail; blank names, invalid categories with otherwise valid fields, and unknown homes return 422 or 404 and add no equipment row.\",\"POST /api/plans enforces interval_days 1..3650 and mutual exclusion of last_completed_on and first_due_on; GET /api/tasks/due returns exact overdue, due, and upcoming ID sets and counts at as_of and horizon_days boundaries, so duplicate, extra, or missing tasks fail, while invalid requests write nothing.\",\"A completion with note inserts one history row and atomically sets last_completed_on to max(existing last_completed_on if present, completed_on) and due_on to max(old due_on, latest + interval_days); leap-day, month-end, year-end, initial-backfill, no-anchor, future-date, oversize-note, and unknown-plan failures leave both plan and completions unchanged.\",\"GET /api/history filters by home and equipment and returns documented fields in descending completion order; invalid filters write nothing; GET / is dependency-free accessible HTML with html lang=en, every input labelled by for/id, fieldset/legend groups, a due-table caption with th scope=col, and a role=status aria-live=polite feedback shell; unknown routes or methods return documented JSON errors.\"],\"goals\":[\"In a dedicated data directory, create the single home, add an equipment record under it, and prove duplicate-home and invalid-name, invalid-category, and unknown-home requests return 409, 422, or 404 without changing stored records.\",\"Create plans with interval_days in 1..3650 and verify GET /api/tasks/due returns exact overdue, due, and upcoming ID sets and counts at the as_of and horizon_days boundaries, using fresh equipment scopes, while invalid plans write nothing.\",\"Record a completion and note in one atomic call and verify last_completed_on is the true latest date and due_on is max(old due_on, latest + interval_days) across leap-day, month-end, year-end, initial-backfill, and no-anchor creation-day examples, with invalid completions leaving no trace.\",\"Retrieve completions filtered by home and equipment in documented descending order with plan and equipment names and notes, and reject invalid filters without writes.\",\"Load GET / and assert a dependency-free HTML shell exposes home, equipment, plan, due, completion, and history workflows with structural accessibility relationships (label for/id, fieldset/legend, due caption and th scope=col, role=status, aria-live=polite, lang=en), while unknown routes and methods return documented JSON errors.\"],\"arch\":\"# Home Care Ledger: target architecture\\n\\n## Scope and decisions to confirm\\n- Local single-user target: one homeowner, one home, loopback only.\\n- Python 3.11+ standard library only; SQLite; no third-party packages.\\n- This is a cognition template, not an application and not the upstream micasa codebase.\\n- Deliberately excluded: accounts and authentication, notifications, email, vendors, costs, quotes, projects, documents, manuals, photos, payments, LLM, multi-property, imports and exports, and deletion endpoints.\\n- Decision: exactly one home with fixed id `home`, because the pinned scenario is the user's own home and upstream exposes a single house profile.\\n- Decision: recurrence is every N calendar days, 1..3650, because the scenario says every N days. Upstream uses interval months; this target is not API-compatible with it.\\n- Decision: a plan created without an anchor is due on the server local creation date.\\n- Decision: next due after any completion is `max(old due_on, max(existing last_completed_on, completed_on) + interval_days)`; a backdated completion can never move `due_on` earlier, including a plan seeded only with `first_due_on` or no anchor.\\n- Decision: no natural-language dates and no timezone-bearing timestamps in domain dates.\\n\\n## Runtime, data directory, start\\n- Source file `app.py`; database `$HOMECARE_DATA_DIR/homecare.sqlite3`.\\n- `HOMECARE_DATA_DIR` defaults to `./data`; the directory is created if absent.\\n- Start: `python3 app.py --data-dir ./data --host 127.0.0.1 --port 8765`.\\n- Equivalent environment variables: `HOMECARE_DATA_DIR`, `HOMECARE_HOST`, `HOMECARE_PORT`.\\n- Bind loopback by default. There is no authentication; do not expose the port.\\n- On first start create schema and indexes. Schema version 1 is created once; no migration beyond that.\\n- SQLite connection setup: `PRAGMA foreign_keys=ON`, `journal_mode=WAL`, `busy_timeout=5000`.\\n- Server: `ThreadingHTTPServer` is acceptable, but every write uses one explicit SQLite transaction.\\n- JSON is UTF-8. Maximum request body 1,048,576 bytes. POST and PATCH must send `application/json`; otherwise 415.\\n- Only GET, POST, and PATCH on documented routes. Other methods return 405 `METHOD_NOT_ALLOWED`.\\n- Health: `GET /health` returns `{status: ok, database: ready}`.\\n\\n## Entities and exact persisted fields\\n`homes`\\n- `id` TEXT primary key, always the literal `home`.\\n- `name` TEXT NOT NULL, trimmed, 1..80 Unicode code points.\\n- `address` TEXT NOT NULL default empty string, trimmed, 0..200.\\n- `created_at`, `updated_at` TEXT UTC ISO-8601 with `Z`, for example `2026-10-21T08:30:00Z`.\\n\\n`equipment`\\n- `id` TEXT primary key, `eq_` plus 32 lowercase hex characters.\\n- `home_id` TEXT NOT NULL REFERENCES `homes(id)` ON DELETE RESTRICT.\\n- `name` TEXT NOT NULL, trimmed, 1..80.\\n- `category` TEXT NOT NULL, one of `heating`, `cooling`, `plumbing`, `electrical`, `roof`, `exterior`, `appliance`, `safety`, `other`.\\n- `location` TEXT NOT NULL default empty, 0..80.\\n- `make` TEXT NOT NULL default empty, 0..80.\\n- `model` TEXT NOT NULL default empty, 0..80.\\n- `installed_on` TEXT NULL, strict calendar date 1900-01-01..2100-12-31.\\n- `created_at`, `updated_at` UTC ISO-8601.\\n\\n`plans`\\n- `id` TEXT primary key, `pl_` plus 32 hex.\\n- `home_id` TEXT NOT NULL REFERENCES homes.\\n- `equipment_id` TEXT NULL REFERENCES equipment; when present it must belong to the same `home_id`.\\n- `name` TEXT NOT NULL, trimmed, 1..80.\\n- `interval_days` INTEGER NOT NULL, 1..3650 inclusive.\\n- `last_completed_on` TEXT NULL, strict date; latest known care date.\\n- `due_on` TEXT NOT NULL, strict date.\\n- `notes` TEXT NOT NULL default empty, 0..500.\\n- `created_at`, `updated_at` UTC ISO-8601.\\n- Index: `(home_id, equipment_id, due_on)`.\\n\\n`completions`\\n- `id` TEXT primary key, `cm_` plus 32 hex.\\n- `plan_id` TEXT NOT NULL REFERENCES plans ON DELETE RESTRICT.\\n- `completed_on` TEXT NOT NULL, strict date.\\n- `note` TEXT NOT NULL default empty, trimmed, 0..500.\\n- `created_at` UTC ISO-8601.\\n- Index: `(plan_id, completed_on DESC, created_at DESC)`.\\n- There is no PATCH or DELETE for completions: the record is append-only.\\n\\n## Date, validation and recurrence rules\\n- Domain dates are `YYYY-MM-DD` only. Reject timestamps, natural language, invalid ordinal dates, and years outside 1900..2100 with 422 `VALIDATION_ERROR`.\\n- `server_today` is `datetime.date.today()` in the host local timezone. Domain dates are not converted between zones.\\n- Creation response timestamps are UTC; domain decisions use `server_today` or an explicit `as_of`.\\n- Plan anchor when created:\\n  - `first_due_on` supplied: `due_on = first_due_on`.\\n  - else `last_completed_on` supplied: `due_on = last_completed_on + interval_days`.\\n  - else: `due_on = server_today`.\\n- `last_completed_on` and `first_due_on` are mutually exclusive; supplying both is 422.\\n- `last_completed_on` may not be after `server_today`; `first_due_on` may not be before 1900-01-01 or after 2100-12-31.\\n- Completion accepts `completed_on <= server_today`.\\n- Next due after a completion is always `max(old due_on, max(previous last_completed_on, completed_on) + interval_days)`, using proleptic Gregorian ordinal addition. `last_completed_on` is set to the true latest of its previous value and `completed_on`. This makes backdated entries safe, including a plan seeded only with `first_due_on` or no anchor, and never regresses the schedule.\\n- If a plan was seeded with `last_completed_on`, that seed is not a completion record; only completion rows appear in history.\\n- Due status at `as_of`: `overdue` when `due_on < as_of`; `due` when equal; `upcoming` when greater.\\n- Due query includes tasks with `due_on <= as_of + horizon_days`. Default `horizon_days=0`, so default shows overdue and due only. Horizon range 0..365.\\n- Sort order: due tasks by `due_on ASC, created_at ASC, id ASC`; plans by `created_at ASC, id ASC`; completions and history by `completed_on DESC, created_at DESC, id DESC`.\\n- Date edge examples: 2024-02-28 + 1 = 2024-02-29; 2024-02-29 + 1 = 2024-03-01; 2024-12-31 + 30 = 2025-01-30; 2026-01-31 + 31 = 2026-03-03.\\n- Initial backfill examples: `due_on=2026-03-01` with interval 30 and `completed_on=2025-01-01` keeps `last_completed_on=2025-01-01` and `due_on=2026-03-01`; a plan with no anchor is due on its creation day and a backdated completion keeps that due date.\\n- Integer fields reject booleans, floats, and numeric strings; JSON boolean true is not an integer. Query integers use decimal digits only.\\n\\n## HTTP API\\nBase URL in examples: `http://127.0.0.1:8765`.\\n\\nCommon response rules:\\n- All API responses are JSON objects with `Content-Type: application/json; charset=utf-8`.\\n- Error shape: `error` object with `code` string, `message` string, and `field` string or null.\\n- Codes and statuses:\\n  - `INVALID_JSON` 400\\n  - `UNSUPPORTED_MEDIA_TYPE` 415\\n  - `METHOD_NOT_ALLOWED` 405\\n  - `NOT_FOUND` 404 for an unknown route\\n  - `HOME_NOT_FOUND` 404\\n  - `EQUIPMENT_NOT_FOUND` 404\\n  - `PLAN_NOT_FOUND` 404\\n  - `HOME_EXISTS` 409\\n  - `VALIDATION_ERROR` 422\\n  - `INTERNAL_ERROR` 500 with no leaked internals\\n- Unknown request fields are rejected with 422 `VALIDATION_ERROR` and `field` naming the first unknown field.\\n- Canonical plan object: `id`, `home_id`, `equipment_id`, `name`, `interval_days`, `last_completed_on`, `due_on`, `notes`, `created_at`, `updated_at`, `completion_count`, and `status`. `status` is computed against `server_today`.\\n- Canonical completion object: `id`, `plan_id`, `completed_on`, `note`, and `created_at`.\\n\\n### Home\\n`POST /api/home`\\nBody: `name` required, `address` optional. Returns 201 `{home: HOME}`. If a home already exists returns 409 `HOME_EXISTS` and writes nothing.\\n`GET /api/home` returns 200 `{home: HOME}` or 404 `HOME_NOT_FOUND`.\\n`PATCH /api/home` Body: at least one of `name`, `address`; validates bounds. Returns 200 `{home: HOME}`. Empty patch 422. There is no DELETE.\\n\\n### Equipment\\n`POST /api/equipment`\\nBody: `home_id` required, `name` required, `category` required, optional `location`, `make`, `model`, and `installed_on`.\\nReturns 201 `{equipment: EQUIPMENT}`. Unknown home 404 `HOME_NOT_FOUND`.\\n`GET /api/equipment?home_id=home` returns 200 `{equipment: [EQUIPMENT...]}` sorted by `created_at ASC, id ASC`. Missing `home_id` 422; unknown home 404.\\n`GET /api/equipment/{id}` returns 200 `{equipment: EQUIPMENT}` or 404 `EQUIPMENT_NOT_FOUND`.\\nNo delete.\\n\\n### Plans\\n`POST /api/plans`\\nBody: `home_id` required; `name` required; `interval_days` required; optional `equipment_id`, `last_completed_on`, `first_due_on`, and `notes`.\\nReturns 201 `{plan: PLAN}`. Unknown home 404. Unknown equipment 404 `EQUIPMENT_NOT_FOUND`; equipment belonging to another home 422 `VALIDATION_ERROR` with field `equipment_id` (defensive, unreachable while only one home exists).\\n`GET /api/plans?home_id=home&equipment_id=eq_...` returns 200 `{plans: [PLAN...]}`. `equipment_id` is an optional filter. Missing home 422; unknown home 404; unknown equipment 404.\\n`GET /api/plans/{id}` returns 200 `{plan: PLAN}` or 404 `PLAN_NOT_FOUND`.\\nNo interval or schedule edit endpoint in this version; create a new plan instead. This is a deliberate scope cut.\\n\\n### Due work\\n`GET /api/tasks/due?home_id=home&as_of=YYYY-MM-DD&horizon_days=0&equipment_id=eq_...`\\n- `home_id` required; `as_of` optional, default `server_today`; `horizon_days` optional integer 0..365; `equipment_id` optional.\\n- Returns 200 `{as_of, horizon_days, tasks: [TASK...]}`.\\n- TASK fields: `id` (plan id), `home_id`, `home_name`, `equipment_id`, `equipment_name` or null, `name`, `interval_days`, `last_completed_on`, `due_on`, `status`, `days_until_due`, and `notes`.\\n- `days_until_due = due_on - as_of` in days; negative means overdue.\\n- Invalid `as_of`, out-of-range horizon, missing home, or unknown home or equipment: 422 or 404 as applicable. No writes.\\n\\n### Completions and history\\n`POST /api/plans/{id}/completions`\\nBody: `completed_on` required, `note` optional default empty.\\nReturns 201 `{completion: COMPLETION, plan: PLAN}`. Unknown plan 404 `PLAN_NOT_FOUND`. Future date, bad date, or note over 500: 422. The insert and plan update happen in one transaction; on any failure neither changes.\\n`GET /api/plans/{id}/completions` returns 200 `{completions: [COMPLETION...]}` or 404 `PLAN_NOT_FOUND`.\\n`GET /api/history?home_id=home&equipment_id=eq_...&limit=100`\\n- `home_id` required; `equipment_id` optional; `limit` 1..500 default 100.\\n- Returns 200 `{history: [HISTORY...]}` sorted as defined above.\\n- HISTORY fields: `id`, `plan_id`, `plan_name`, `home_id`, `home_name`, `equipment_id`, `equipment_name` or null, `completed_on`, `note`, and `created_at`.\\n- Missing home 422; unknown home or equipment 404. No writes.\\n\\n## Atomic failure semantics\\n- Validate method, content type, JSON, field presence, types, bounds, enums, dates, and referential checks before opening a write transaction.\\n- For `POST /api/home`, insert with fixed id `home`; a concurrent duplicate loses with 409 and leaves exactly one row.\\n- For `POST /api/equipment` and `POST /api/plans`, one INSERT each; foreign-key failure maps to 404 or 422, not 500.\\n- For completion, `BEGIN IMMEDIATE`; select plan; compute `latest = max(previous last_completed_on, completed_on)` (or `completed_on` when absent); INSERT completion with the actual `completed_on` and note; UPDATE plan `last_completed_on=latest`, `due_on=max(old due_on, latest + interval_days)`, and `updated_at`; COMMIT. Any error triggers ROLLBACK, leaving zero new completions and an unchanged plan.\\n- Reads never create rows. A failed request must produce no completion, no plan, no equipment, and no home mutation.\\n- SQLite constraint errors are mapped to a deterministic 422 or 409; unexpected errors return 500 `INTERNAL_ERROR` without partial commits.\\n\\n## Basic accessible UI\\n`GET /` returns one HTML document with `lang=en`, UTF-8, no external assets, and a small inline script that calls the JSON API.\\n- Sections, in order: Home; Equipment; Care plans; Due work; Completion history.\\n- Every `input` has an `id` and a visible `label for` that references it; groups use `fieldset` and `legend`.\\n- Buttons are native `button` elements with descriptive text: Create home, Add equipment, Add plan, Record completion, Refresh.\\n- Due table has a `caption`, every `th` uses `scope=col`, and text status plus a non-color-only overdue label.\\n- Success and validation messages render in a container with `role=status` and `aria-live=polite`; errors also include the field name.\\n- Forms are keyboard operable, visible focus is retained, default browser font sizing is not disabled, and no timeout or auto-submit is used.\\n- Completing a task opens a small form for `completed_on` and `note`; the API response updates the due list and history without a full page reload.\\n- History has home and equipment filters populated from the API.\\n- The UI is a convenience surface; all behavior is available through the documented API.\\n- These structural checks are a smoke test, not a certification of full accessibility conformance.\\n\\n## Probe contract\\n`probe.py` is a standard-library HTTP client supplied in `acceptance_files`. It accepts `--base-url` and exactly one `--case A01..A05`, creates only disposable records with a unique suffix, never deletes, and asserts exact statuses, shapes, dates, ordering, exact due ID sets and counts, zero-write outcomes, and HTML structure through `html.parser.HTMLParser`. It does not start the server and makes no claim about an upstream run.\",\"gaps\":[\"Upstream status: not_run. The repository was read as evidence only; no build, test, server, TUI, or database was executed, so no upstream behavior is runtime-verified.\",\"Runtime verification is not_run for the target too. The probe and architecture are authored artifacts; no server was started and no acceptance case was executed in this task.\",\"Single-home and single-user by design; no multi-property, accounts, authentication, sharing, or remote access.\",\"No notifications, email, SMS, push, calendar sync, or background scheduler; due work is pull-based through the API and UI.\",\"No costs, vendors, receipts, photos, manuals, warranties, projects, quotes, incidents, documents, or LLM features; those upstream surfaces are intentionally out of scope.\",\"Every-N-days recurrence differs from upstream interval months; no compatibility with upstream databases, APIs, or schema is claimed.\",\"No delete, undo, archive, or restore endpoints; completion history is append-only and test records remain until the disposable data directory is discarded.\",\"Validation is strict and date-only; natural-language dates and timezone conversion are unsupported. Server local date can differ by one day from a client in another timezone.\",\"The UI is a minimal single-page client, not a polished product; no internationalization, offline cache, or mobile-native behavior. Accessibility assertions are structural and do not certify full conformance.\",\"Schema v1 has no migration path. Changing entities later needs an explicit migration or a new disposable database.\",\"Concurrency is sized for one user; SQLite WAL and busy_timeout reduce but do not eliminate lock contention.\",\"User decision points: confirm one-home scope, creation-day due for plans without an anchor, `max(old due_on, latest completion + interval_days)` rollover that never regresses, strict date-only input, and the absence of delete and defect-tracking features.\",\"Restart durability may be described as an operator stop and start step in README; it was not run and is not claimed as verified.\"]},\"acceptance_files\":{\"probe.py\":\"#!/usr/bin/env python3\\n'''Acceptance probe for the Home Care Ledger target.\\n\\nUsage:\\n  python3 probe.py --base-url http://127.0.0.1:8765 --case A01\\n'''\\n\\nimport argparse\\nimport datetime as dt\\nimport json\\nimport os\\nimport sys\\nimport urllib.error\\nimport urllib.parse\\nimport urllib.request\\nfrom html.parser import HTMLParser\\n\\nTIMEOUT = 10\\nSUFFIX = dt.datetime.now(dt.timezone.utc).strftime('%Y%m%d%H%M%S%f') + '-' + str(os.getpid())\\n\\n\\nclass ProbeFailure(AssertionError):\\n    pass\\n\\n\\ndef check(condition, message):\\n    if not condition:\\n        raise ProbeFailure(message)\\n\\n\\ndef request(base_url, method, path, body=None):\\n    url = base_url.rstrip('/') + path\\n    headers = {'Accept': 'application/json'}\\n    data = None\\n    if body is not None:\\n        data = json.dumps(body, separators=(',', ':')).encode('utf-8')\\n        headers['Content-Type'] = 'application/json'\\n    req = urllib.request.Request(url, data=data, headers=headers, method=method)\\n    try:\\n        with urllib.request.urlopen(req, timeout=TIMEOUT) as response:\\n            raw = response.read()\\n            status = response.status\\n            ctype = response.headers.get('Content-Type', '')\\n    except urllib.error.HTTPError as exc:\\n        raw = exc.read()\\n        status = exc.code\\n        ctype = exc.headers.get('Content-Type', '')\\n    parsed = None\\n    if raw:\\n        try:\\n            parsed = json.loads(raw.decode('utf-8'))\\n        except (UnicodeDecodeError, json.JSONDecodeError):\\n            parsed = None\\n    return status, parsed, raw, ctype\\n\\n\\ndef api(base_url, method, path, body=None, expected=200):\\n    status, parsed, raw, ctype = request(base_url, method, path, body)\\n    check(status == expected, f'{method} {path}: expected HTTP {expected}, got {status}; body={raw[:300]!r}')\\n    check('application/json' in ctype.lower(), f'{method} {path}: expected JSON, got {ctype!r}')\\n    check(isinstance(parsed, dict), f'{method} {path}: expected a JSON object')\\n    return parsed\\n\\n\\ndef expect_error(base_url, method, path, body, expected_status, expected_code):\\n    status, parsed, raw, ctype = request(base_url, method, path, body)\\n    check(status == expected_status, f'{method} {path}: expected HTTP {expected_status}, got {status}; body={raw[:300]!r}')\\n    check('application/json' in ctype.lower(), f'{method} {path}: expected JSON error, got {ctype!r}')\\n    check(isinstance(parsed, dict), f'{method} {path}: expected a JSON error object')\\n    error = parsed.get('error', {})\\n    check(error.get('code') == expected_code, f'{method} {path}: expected {expected_code}, got {error!r}')\\n    check(isinstance(error.get('message'), str) and error['message'], f'{method} {path}: error message required')\\n    return error\\n\\n\\ndef ensure_home(base_url):\\n    status, parsed, raw, ctype = request(base_url, 'GET', '/api/home')\\n    if status == 404:\\n        check(isinstance(parsed, dict) and parsed.get('error', {}).get('code') == 'HOME_NOT_FOUND', 'fresh GET /api/home must be HOME_NOT_FOUND')\\n        return api(base_url, 'POST', '/api/home', {'name': 'Probe home ' + SUFFIX, 'address': '1 Probe Lane'}, 201)['home']\\n    check(status == 200, f'GET /api/home: expected 200 or 404, got {status}')\\n    check(isinstance(parsed, dict), 'GET /api/home: expected a JSON object')\\n    return parsed['home']\\n\\n\\ndef create_equipment(base_url, home_id, tag, category='heating'):\\n    payload = {'home_id': home_id, 'name': 'Probe equipment ' + tag + ' ' + SUFFIX, 'category': category, 'location': 'Test area', 'installed_on': '2020-02-29'}\\n    return api(base_url, 'POST', '/api/equipment', payload, 201)['equipment']\\n\\n\\ndef list_equipment(base_url, home_id):\\n    query = urllib.parse.urlencode({'home_id': home_id})\\n    return api(base_url, 'GET', '/api/equipment?' + query)['equipment']\\n\\n\\ndef create_plan(base_url, home_id, tag, interval_days, equipment_id=None, first_due_on=None, last_completed_on=None):\\n    payload = {'home_id': home_id, 'name': 'Probe plan ' + tag + ' ' + SUFFIX, 'interval_days': interval_days}\\n    if equipment_id is not None:\\n        payload['equipment_id'] = equipment_id\\n    if first_due_on is not None:\\n        payload['first_due_on'] = first_due_on\\n    if last_completed_on is not None:\\n        payload['last_completed_on'] = last_completed_on\\n    return api(base_url, 'POST', '/api/plans', payload, 201)['plan']\\n\\n\\ndef list_plans(base_url, home_id, equipment_id=None):\\n    params = {'home_id': home_id}\\n    if equipment_id is not None:\\n        params['equipment_id'] = equipment_id\\n    return api(base_url, 'GET', '/api/plans?' + urllib.parse.urlencode(params))['plans']\\n\\n\\ndef get_plan(base_url, plan_id):\\n    return api(base_url, 'GET', '/api/plans/' + plan_id)['plan']\\n\\n\\ndef due_path(home_id, as_of, horizon_days=0, equipment_id=None):\\n    params = {'home_id': home_id, 'as_of': as_of, 'horizon_days': str(horizon_days)}\\n    if equipment_id is not None:\\n        params['equipment_id'] = equipment_id\\n    return '/api/tasks/due?' + urllib.parse.urlencode(params)\\n\\n\\ndef due_tasks(base_url, home_id, as_of, horizon_days=0, equipment_id=None):\\n    return api(base_url, 'GET', due_path(home_id, as_of, horizon_days, equipment_id))['tasks']\\n\\n\\ndef check_task_ids(tasks, expected_ids, context):\\n    ids = [task['id'] for task in tasks]\\n    check(len(ids) == len(expected_ids), f'{context}: expected {len(expected_ids)} tasks, got {len(ids)}: {ids}')\\n    check(len(set(ids)) == len(ids), f'{context}: duplicate task ids in {ids}')\\n    check(set(ids) == set(expected_ids), f'{context}: expected ids {sorted(expected_ids)}, got {sorted(ids)}')\\n\\n\\ndef create_completion(base_url, plan_id, completed_on, note=''):\\n    payload = {'completed_on': completed_on, 'note': note}\\n    return api(base_url, 'POST', '/api/plans/' + plan_id + '/completions', payload, 201)\\n\\n\\ndef list_completions(base_url, plan_id):\\n    return api(base_url, 'GET', '/api/plans/' + plan_id + '/completions')['completions']\\n\\n\\ndef history_path(home_id, equipment_id=None, limit=None):\\n    params = {'home_id': home_id}\\n    if equipment_id is not None:\\n        params['equipment_id'] = equipment_id\\n    if limit is not None:\\n        params['limit'] = str(limit)\\n    return '/api/history?' + urllib.parse.urlencode(params)\\n\\n\\ndef history_entries(base_url, home_id, equipment_id=None, limit=None):\\n    return api(base_url, 'GET', history_path(home_id, equipment_id, limit))['history']\\n\\n\\ndef case_a01(base_url):\\n    health = api(base_url, 'GET', '/health')\\n    check(health.get('status') == 'ok', 'health status must be ok')\\n    home = ensure_home(base_url)\\n    check(home.get('id') == 'home', 'single home id must be home')\\n    for field in ('name', 'address', 'created_at', 'updated_at'):\\n        check(field in home, 'home missing field ' + field)\\n    before = api(base_url, 'GET', '/api/home')['home']\\n    expect_error(base_url, 'POST', '/api/home', {'name': 'Second home', 'address': ''}, 409, 'HOME_EXISTS')\\n    after = api(base_url, 'GET', '/api/home')['home']\\n    check(after == before, 'duplicate home must not mutate stored home')\\n    patched = api(base_url, 'PATCH', '/api/home', {'name': before['name'], 'address': before['address']})['home']\\n    check(patched['id'] == 'home' and patched['name'] == before['name'] and patched['address'] == before['address'], 'home patch round trip failed')\\n    expect_error(base_url, 'PATCH', '/api/home', {}, 422, 'VALIDATION_ERROR')\\n    check(api(base_url, 'GET', '/api/home')['home'] == patched, 'empty patch must not mutate the patched home object')\\n    equipment = create_equipment(base_url, home['id'], 'A01')\\n    check(equipment['home_id'] == home['id'], 'equipment must be anchored to home')\\n    check(equipment['installed_on'] == '2020-02-29', 'equipment date round trip failed')\\n    detail = api(base_url, 'GET', '/api/equipment/' + equipment['id'])['equipment']\\n    check(detail == equipment, 'equipment detail must match creation')\\n    before_equipment = list_equipment(base_url, home['id'])\\n    check(any(item['id'] == equipment['id'] for item in before_equipment), 'created equipment must be listed')\\n    expect_error(base_url, 'POST', '/api/equipment', {'home_id': home['id'], 'name': '   ', 'category': 'heating'}, 422, 'VALIDATION_ERROR')\\n    check(list_equipment(base_url, home['id']) == before_equipment, 'blank equipment name must write nothing')\\n    expect_error(base_url, 'POST', '/api/equipment', {'home_id': home['id'], 'name': 'Probe bad category ' + SUFFIX, 'category': 'not-a-category'}, 422, 'VALIDATION_ERROR')\\n    check(list_equipment(base_url, home['id']) == before_equipment, 'invalid equipment category must write nothing')\\n    expect_error(base_url, 'POST', '/api/equipment', {'home_id': 'missing-home', 'name': 'Ghost', 'category': 'other'}, 404, 'HOME_NOT_FOUND')\\n    check(list_equipment(base_url, home['id']) == before_equipment, 'unknown home must write nothing')\\n    expect_error(base_url, 'GET', '/api/equipment', None, 422, 'VALIDATION_ERROR')\\n    expect_error(base_url, 'GET', '/api/equipment?home_id=missing-home', None, 404, 'HOME_NOT_FOUND')\\n    expect_error(base_url, 'GET', '/api/equipment/eq_missing', None, 404, 'EQUIPMENT_NOT_FOUND')\\n\\n\\ndef case_a02(base_url):\\n    home = ensure_home(base_url)\\n    equipment = create_equipment(base_url, home['id'], 'A02')\\n    other_equipment = create_equipment(base_url, home['id'], 'A02X')\\n    baseline = len(list_plans(base_url, home['id']))\\n    far = create_plan(base_url, home['id'], 'A02F', 90, equipment_id=equipment['id'], first_due_on='2026-03-01')\\n    old = create_plan(base_url, home['id'], 'A02O', 30, equipment_id=equipment['id'], first_due_on='2026-01-01')\\n    decoy = create_plan(base_url, home['id'], 'A02X', 10, equipment_id=other_equipment['id'], first_due_on='2026-02-01')\\n    check(far['due_on'] == '2026-03-01', 'first_due_on must be preserved')\\n    check(far['equipment_id'] == equipment['id'], 'plan equipment anchor lost')\\n    check(old['due_on'] == '2026-01-01', 'second plan due date wrong')\\n    check(decoy['equipment_id'] == other_equipment['id'], 'decoy plan equipment anchor lost')\\n    for interval in (0, 3651, -1):\\n        expect_error(base_url, 'POST', '/api/plans', {'home_id': home['id'], 'name': 'Bad interval ' + SUFFIX, 'interval_days': interval}, 422, 'VALIDATION_ERROR')\\n    for interval in (1.5, True, '30'):\\n        expect_error(base_url, 'POST', '/api/plans', {'home_id': home['id'], 'name': 'Bad type ' + SUFFIX, 'interval_days': interval}, 422, 'VALIDATION_ERROR')\\n    expect_error(base_url, 'POST', '/api/plans', {'home_id': home['id'], 'name': 'Two anchors ' + SUFFIX, 'interval_days': 10, 'last_completed_on': '2025-01-01', 'first_due_on': '2025-02-01'}, 422, 'VALIDATION_ERROR')\\n    expect_error(base_url, 'POST', '/api/plans', {'home_id': home['id'], 'name': 'Bad date ' + SUFFIX, 'interval_days': 10, 'first_due_on': '2026-02-30'}, 422, 'VALIDATION_ERROR')\\n    check(len(list_plans(base_url, home['id'])) == baseline + 3, 'invalid plans must not be stored')\\n    tasks = due_tasks(base_url, home['id'], '2026-02-28', 0, equipment['id'])\\n    check_task_ids(tasks, [old['id']], 'horizon zero before far due')\\n    by_id = {task['id']: task for task in tasks}\\n    check(by_id[old['id']]['status'] == 'overdue', 'old plan must be overdue on 2026-02-28')\\n    check(far['id'] not in by_id, 'future plan must be excluded at horizon zero')\\n    tasks = due_tasks(base_url, home['id'], '2026-03-01', 0, equipment['id'])\\n    check_task_ids(tasks, [old['id'], far['id']], 'as_of on far due date')\\n    by_id = {task['id']: task for task in tasks}\\n    check(by_id[old['id']]['status'] == 'overdue', 'old plan still overdue on 2026-03-01')\\n    check(by_id[far['id']]['status'] == 'due' and by_id[far['id']]['days_until_due'] == 0, 'far plan must be due on its due date')\\n    tasks = due_tasks(base_url, home['id'], '2026-02-28', 1, equipment['id'])\\n    check_task_ids(tasks, [old['id'], far['id']], 'horizon one before far due')\\n    by_id = {task['id']: task for task in tasks}\\n    check(by_id[far['id']]['status'] == 'upcoming' and by_id[far['id']]['days_until_due'] == 1, 'horizon one must expose tomorrow as upcoming')\\n    check(by_id[old['id']]['status'] == 'overdue', 'horizon one must keep old plan overdue')\\n    tasks = due_tasks(base_url, home['id'], '2026-03-02', 0, equipment['id'])\\n    check_task_ids(tasks, [old['id'], far['id']], 'day after far due')\\n    by_id = {task['id']: task for task in tasks}\\n    check(by_id[far['id']]['status'] == 'overdue' and by_id[far['id']]['days_until_due'] == -1, 'next day must be overdue')\\n    ordered = due_tasks(base_url, home['id'], '2026-03-01', 0, equipment['id'])\\n    check_task_ids(ordered, [old['id'], far['id']], 'ordered due query')\\n    check([task['id'] for task in ordered] == [old['id'], far['id']], 'due tasks must sort by due_on')\\n    dates = [task['due_on'] for task in ordered]\\n    check(dates == sorted(dates), 'due tasks must sort by due_on')\\n    filtered = due_tasks(base_url, home['id'], '2026-03-01', 0, other_equipment['id'])\\n    check_task_ids(filtered, [decoy['id']], 'other equipment due filter')\\n    check(filtered[0]['status'] == 'overdue', 'decoy plan must stay overdue in its own scope')\\n    filtered_plans = list_plans(base_url, home['id'], equipment['id'])\\n    check(len(filtered_plans) == 2, 'plan equipment filter must return exactly two plans')\\n    check({plan['id'] for plan in filtered_plans} == {old['id'], far['id']}, 'plan equipment filter must isolate the fresh scope')\\n    other_plans = list_plans(base_url, home['id'], other_equipment['id'])\\n    check([plan['id'] for plan in other_plans] == [decoy['id']], 'plan equipment filter must isolate the decoy scope')\\n    detail = get_plan(base_url, far['id'])\\n    check(detail['due_on'] == '2026-03-01' and detail['completion_count'] == 0, 'plan detail must expose due date and count')\\n    for as_of, horizon in (('2026-02-30', 0), ('2026-02-29', 0), ('2026-03-01', -1), ('2026-03-01', 366)):\\n        expect_error(base_url, 'GET', due_path(home['id'], as_of, horizon, equipment['id']), None, 422, 'VALIDATION_ERROR')\\n    expect_error(base_url, 'GET', '/api/tasks/due?as_of=2026-03-01', None, 422, 'VALIDATION_ERROR')\\n    expect_error(base_url, 'GET', due_path('missing-home', '2026-03-01', 0, equipment['id']), None, 404, 'HOME_NOT_FOUND')\\n    check(len(list_plans(base_url, home['id'])) == baseline + 3, 'due query errors must not write plans')\\n\\n\\ndef case_a03(base_url):\\n    home = ensure_home(base_url)\\n    equipment = create_equipment(base_url, home['id'], 'A03')\\n    plan = create_plan(base_url, home['id'], 'A03', 30, equipment_id=equipment['id'], first_due_on='2024-01-01')\\n    before_plan = get_plan(base_url, plan['id'])\\n    before_logs = list_completions(base_url, plan['id'])\\n    future = (dt.date.today() + dt.timedelta(days=2)).isoformat()\\n    expect_error(base_url, 'POST', '/api/plans/' + plan['id'] + '/completions', {'completed_on': future, 'note': 'future'}, 422, 'VALIDATION_ERROR')\\n    expect_error(base_url, 'POST', '/api/plans/' + plan['id'] + '/completions', {'completed_on': '2026-02-30', 'note': 'bad'}, 422, 'VALIDATION_ERROR')\\n    expect_error(base_url, 'POST', '/api/plans/' + plan['id'] + '/completions', {'completed_on': '2025-01-01', 'note': 'x' * 501}, 422, 'VALIDATION_ERROR')\\n    expect_error(base_url, 'POST', '/api/plans/pl_missing/completions', {'completed_on': '2025-01-01', 'note': ''}, 404, 'PLAN_NOT_FOUND')\\n    check(get_plan(base_url, plan['id']) == before_plan, 'invalid completions must not change plan')\\n    check(list_completions(base_url, plan['id']) == before_logs, 'invalid completions must not append history')\\n    first = create_completion(base_url, plan['id'], '2024-02-29', '  Leap-day check  ')\\n    check(first['completion']['note'] == 'Leap-day check', 'note must be trimmed')\\n    check(first['plan']['last_completed_on'] == '2024-02-29', 'leap completion must set last date')\\n    check(first['plan']['due_on'] == '2024-03-30', 'leap completion must advance thirty days')\\n    check(first['plan']['completion_count'] == len(before_logs) + 1, 'completion count must increment')\\n    back = create_completion(base_url, plan['id'], '2024-01-15', 'Backdated')\\n    check(back['plan']['last_completed_on'] == '2024-02-29', 'backdated completion must not regress last date')\\n    check(back['plan']['due_on'] == '2024-03-30', 'backdated completion must not regress due date')\\n    year = create_completion(base_url, plan['id'], '2024-12-31', 'Year end')\\n    check(year['plan']['due_on'] == '2025-01-30', 'year-end plus thirty days failed')\\n    month_plan = create_plan(base_url, home['id'], 'A03M', 31, first_due_on='2024-01-01')\\n    month = create_completion(base_url, month_plan['id'], '2026-01-31', 'Month end')\\n    check(month['plan']['due_on'] == '2026-03-03', 'month-end plus thirty-one days failed')\\n    leap_plan = create_plan(base_url, home['id'], 'A03L', 1, first_due_on='2024-02-28')\\n    leap_one = create_completion(base_url, leap_plan['id'], '2024-02-28', 'Leap start')\\n    check(leap_one['plan']['due_on'] == '2024-02-29', 'leap day plus one day failed')\\n    leap_two = create_completion(base_url, leap_plan['id'], '2024-02-29', 'Leap day')\\n    check(leap_two['plan']['due_on'] == '2024-03-01', 'post-leap day plus one day failed')\\n    note_plan = create_plan(base_url, home['id'], 'A03N', 10, first_due_on='2025-01-01')\\n    note_result = create_completion(base_url, note_plan['id'], '2025-01-01', 'x' * 500)\\n    check(len(note_result['completion']['note']) == 500, 'five hundred code point note must be accepted')\\n    backfill = create_plan(base_url, home['id'], 'A03B', 30, first_due_on='2026-03-01')\\n    check(backfill['due_on'] == '2026-03-01', 'initial backfill plan due date wrong')\\n    backfilled = create_completion(base_url, backfill['id'], '2025-01-01', 'Initial backfill')\\n    check(backfilled['plan']['last_completed_on'] == '2025-01-01', 'initial backfill must store the actual completion as latest')\\n    check(backfilled['plan']['due_on'] == '2026-03-01', 'initial backfill must keep the existing due date')\\n    backfill_logs = list_completions(base_url, backfill['id'])\\n    check([entry['completed_on'] for entry in backfill_logs] == ['2025-01-01'], 'initial backfill must append the actual completion date')\\n    check(backfill_logs[0]['note'] == 'Initial backfill', 'initial backfill must append the note')\\n    today = dt.date.today().isoformat()\\n    anchorless = create_plan(base_url, home['id'], 'A03D', 30)\\n    check(anchorless['due_on'] == today, 'no-anchor plan must be due on creation day')\\n    anchorless_back = create_completion(base_url, anchorless['id'], '2025-01-01', 'No anchor backfill')\\n    check(anchorless_back['plan']['last_completed_on'] == '2025-01-01', 'no-anchor plan must store the actual completion as latest')\\n    check(anchorless_back['plan']['due_on'] == today, 'no-anchor backfill must keep the creation-day due date')\\n    anchorless_today = create_completion(base_url, anchorless['id'], today, 'No anchor today')\\n    check(anchorless_today['plan']['last_completed_on'] == today, 'latest completion must win over an older completion')\\n    check(anchorless_today['plan']['due_on'] == (dt.date.today() + dt.timedelta(days=30)).isoformat(), 'no-anchor completion must advance from the latest date')\\n    logs = list_completions(base_url, plan['id'])\\n    dates = [entry['completed_on'] for entry in logs]\\n    check(dates == ['2024-12-31', '2024-02-29', '2024-01-15'], 'plan history order failed')\\n\\n\\ndef case_a04(base_url):\\n    home = ensure_home(base_url)\\n    eq_a = create_equipment(base_url, home['id'], 'A04A', 'heating')\\n    eq_b = create_equipment(base_url, home['id'], 'A04B', 'plumbing')\\n    plan_a = create_plan(base_url, home['id'], 'A04A', 10, equipment_id=eq_a['id'], first_due_on='2025-01-01')\\n    plan_b = create_plan(base_url, home['id'], 'A04B', 20, equipment_id=eq_b['id'], first_due_on='2025-01-01')\\n    create_plan(base_url, home['id'], 'A04C', 30, first_due_on='2025-01-01')\\n    c_a1 = create_completion(base_url, plan_a['id'], '2025-01-10', '  A one  ')['completion']\\n    c_a2 = create_completion(base_url, plan_a['id'], '2025-02-10', 'A two')['completion']\\n    c_b1 = create_completion(base_url, plan_b['id'], '2025-02-15', 'B one')['completion']\\n    check(c_a1['note'] == 'A one', 'history note must be trimmed')\\n    entries = history_entries(base_url, home['id'], limit=500)\\n    for left, right in zip(entries, entries[1:]):\\n        check(left['completed_on'] >= right['completed_on'], 'history must sort by completed_on descending')\\n    positions = {entry['id']: index for index, entry in enumerate(entries)}\\n    check(positions[c_b1['id']] < positions[c_a2['id']] < positions[c_a1['id']], 'history ordering across plans failed')\\n    for completion in (c_a1, c_a2, c_b1):\\n        entry = entries[positions[completion['id']]]\\n        for field in ('plan_id', 'plan_name', 'home_id', 'home_name', 'equipment_id', 'equipment_name', 'completed_on', 'note', 'created_at'):\\n            check(field in entry, 'history entry missing field ' + field)\\n    filtered_a = history_entries(base_url, home['id'], eq_a['id'], 500)\\n    ids_a = {entry['id'] for entry in filtered_a}\\n    check(c_a1['id'] in ids_a and c_a2['id'] in ids_a and c_b1['id'] not in ids_a, 'equipment A history filter failed')\\n    check(all(entry['equipment_id'] == eq_a['id'] for entry in filtered_a), 'equipment A filter leaked another equipment')\\n    filtered_b = history_entries(base_url, home['id'], eq_b['id'], 500)\\n    ids_b = {entry['id'] for entry in filtered_b}\\n    check(c_b1['id'] in ids_b and c_a1['id'] not in ids_b, 'equipment B history filter failed')\\n    plan_logs = list_completions(base_url, plan_a['id'])\\n    check([entry['completed_on'] for entry in plan_logs] == ['2025-02-10', '2025-01-10'], 'plan completion history order failed')\\n    limited = history_entries(base_url, home['id'], limit=1)\\n    check(len(limited) == 1, 'history limit one failed')\\n    before_count = len(list_plans(base_url, home['id']))\\n    expect_error(base_url, 'GET', '/api/history', None, 422, 'VALIDATION_ERROR')\\n    expect_error(base_url, 'GET', history_path('missing-home'), None, 404, 'HOME_NOT_FOUND')\\n    expect_error(base_url, 'GET', history_path(home['id'], 'eq_missing'), None, 404, 'EQUIPMENT_NOT_FOUND')\\n    expect_error(base_url, 'GET', history_path(home['id'], limit=0), None, 422, 'VALIDATION_ERROR')\\n    expect_error(base_url, 'GET', history_path(home['id'], limit=501), None, 422, 'VALIDATION_ERROR')\\n    check(len(list_plans(base_url, home['id'])) == before_count, 'history errors must not write plans')\\n\\n\\nclass UIParser(HTMLParser):\\n    def __init__(self):\\n        super().__init__(convert_charrefs=True)\\n        self.html_lang = None\\n        self.input_ids = []\\n        self.label_targets = set()\\n        self.fieldsets = []\\n        self.closed_fieldsets = []\\n        self.tables = []\\n        self.closed_tables = []\\n        self.status_regions = []\\n\\n    def handle_starttag(self, tag, attrs):\\n        attrs = dict(attrs)\\n        if tag == 'html' and self.html_lang is None:\\n            self.html_lang = attrs.get('lang')\\n        if tag == 'label' and attrs.get('for'):\\n            self.label_targets.add(attrs['for'])\\n        if tag == 'input':\\n            self.input_ids.append(attrs.get('id'))\\n        if tag == 'fieldset':\\n            self.fieldsets.append({'has_legend': False})\\n        if tag == 'legend' and self.fieldsets:\\n            self.fieldsets[-1]['has_legend'] = True\\n        if tag == 'table':\\n            self.tables.append({'caption': '', 'in_caption': False, 'th_scopes': []})\\n        if tag == 'caption' and self.tables:\\n            self.tables[-1]['in_caption'] = True\\n        if tag == 'th' and self.tables:\\n            self.tables[-1]['th_scopes'].append(attrs.get('scope'))\\n        if (attrs.get('role') or '').lower() == 'status':\\n            self.status_regions.append({'aria_live': attrs.get('aria-live')})\\n\\n    def handle_endtag(self, tag):\\n        if tag == 'fieldset' and self.fieldsets:\\n            self.closed_fieldsets.append(self.fieldsets.pop())\\n        if tag == 'caption' and self.tables:\\n            self.tables[-1]['in_caption'] = False\\n        if tag == 'table' and self.tables:\\n            self.closed_tables.append(self.tables.pop())\\n\\n    def handle_data(self, data):\\n        if self.tables and self.tables[-1]['in_caption']:\\n            self.tables[-1]['caption'] += data\\n\\n\\ndef case_a05(base_url):\\n    status, parsed, raw, ctype = request(base_url, 'GET', '/')\\n    check(status == 200, f'GET /: expected 200, got {status}')\\n    check('text/html' in ctype.lower(), f'GET /: expected HTML, got {ctype!r}')\\n    document = raw.decode('utf-8')\\n    text = document.lower()\\n    for token in ('<html lang=', '<label', '<form', '<button', 'aria-live', 'home', 'equipment', 'due', 'history', 'complete'):\\n        check(token in text, 'UI missing token ' + token)\\n    check('<script src=' not in text, 'UI must not load external scripts')\\n    parser = UIParser()\\n    parser.feed(document)\\n    parser.close()\\n    check((parser.html_lang or '').lower() == 'en', 'html lang must be en')\\n    check(parser.input_ids, 'UI must contain form inputs')\\n    for input_id in parser.input_ids:\\n        check(input_id, 'every input must have an id')\\n        check(input_id in parser.label_targets, 'input ' + input_id + ' must have a matching label for')\\n    check(parser.closed_fieldsets, 'UI must group fields with fieldset')\\n    check(all(item['has_legend'] for item in parser.closed_fieldsets), 'every fieldset must contain a legend')\\n    due_tables = [table for table in parser.closed_tables if 'due' in table['caption'].lower()]\\n    check(due_tables, 'UI must have a due table with a caption')\\n    for table in due_tables:\\n        check(table['th_scopes'], 'due table must use th cells')\\n        check(all((scope or '').lower() == 'col' for scope in table['th_scopes']), 'every due table th must use scope=col')\\n    check(parser.status_regions, 'UI must include a state feedback region')\\n    check(any((region['aria_live'] or '').lower() == 'polite' for region in parser.status_regions), 'state feedback region must use aria-live=polite')\\n    health = api(base_url, 'GET', '/health')\\n    check(health.get('status') == 'ok', 'health status must be ok')\\n    expect_error(base_url, 'GET', '/api/unknown', None, 404, 'NOT_FOUND')\\n    expect_error(base_url, 'DELETE', '/api/home', None, 405, 'METHOD_NOT_ALLOWED')\\n\\n\\nCASES = {'A01': case_a01, 'A02': case_a02, 'A03': case_a03, 'A04': case_a04, 'A05': case_a05}\\n\\n\\ndef main():\\n    parser = argparse.ArgumentParser(description='Home Care Ledger acceptance probe')\\n    parser.add_argument('--base-url', default='http://127.0.0.1:8765')\\n    parser.add_argument('--case', required=True, choices=sorted(CASES))\\n    args = parser.parse_args()\\n    try:\\n        CASES[args.case](args.base_url)\\n    except ProbeFailure as exc:\\n        print('FAIL ' + args.case + ': ' + str(exc))\\n        return 1\\n    except Exception as exc:\\n        print('ERROR ' + args.case + ': ' + type(exc).__name__ + ': ' + str(exc))\\n        return 1\\n    print('PASS ' + args.case)\\n    return 0\\n\\n\\nif __name__ == '__main__':\\n    sys.exit(main())\\n\",\"README.md\":\"# Home Care Ledger acceptance probe\\n\\nThis probe is a standard-library HTTP client for the target described in the blueprint. It creates records with a unique suffix, never deletes, and is intended for a disposable data directory.\\n\\n## Prerequisites\\n- Python 3.11 or newer.\\n- The target server running locally.\\n- A fresh disposable data directory. Do not point it at real household data.\\n\\n## Start the target\\n```sh\\nHOMECARE_DATA_DIR=./probe-data python3 app.py --data-dir ./probe-data --host 127.0.0.1 --port 8765\\n```\\nThe server stores `homecare.sqlite3` in the data directory and binds loopback only. There is no authentication.\\n\\n## Run one case\\n```sh\\npython3 probe.py --base-url http://127.0.0.1:8765 --case A01\\n```\\nCases:\\n- A01 home and equipment anchor; duplicate, empty-patch, blank-name, invalid-category, and unknown-home zero-write checks. The empty-patch baseline is the successful PATCH response, including `updated_at`.\\n- A02 plan bounds; exact overdue, due, and upcoming ID sets and counts at `as_of` and `horizon_days` boundaries using fresh equipment scopes.\\n- A03 completion, note, leap and month and year date edges, initial backfills, no-anchor creation-day due, and rollback checks.\\n- A04 home and equipment history ordering and filters.\\n- A05 structural HTML shell checks with `html.parser.HTMLParser`, unknown route, and method errors. These are structural assertions, not full accessibility certification.\\n\\nRun cases one at a time or all five sequentially against the same disposable database. Each case creates unique records.\\n\\n## Date contract\\nA completion stores `last_completed_on = max(existing last_completed_on if present, completed_on)` and sets `due_on = max(old due_on, latest + interval_days)`. The completion row and plan update are one transaction. Initial backfills and plans without an anchor keep the old due date when the computed date would be earlier.\\n\\n## Expected result\\nThe script prints `PASS A0N` and exits 0 when every assertion passes. It prints `FAIL A0N: ...` or `ERROR A0N: ...` and exits 1 otherwise. A failure is evidence of a contract mismatch, not a reason to weaken the documented contract.\\n\\n## Restart\\nOperator stop and start can be tested manually by stopping the server, starting it again with the same `--data-dir`, and re-reading the records. This is an operator step and was not automated here.\\n\\n## Runtime status\\nnot_run. The target and probe were authored, not executed. No upstream build or run was performed. No certification is claimed.\\n\"}}","time":{"start":1792577992455,"end":1792578027057}}}
