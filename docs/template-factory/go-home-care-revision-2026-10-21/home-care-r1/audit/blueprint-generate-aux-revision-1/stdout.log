ndidate/VIEW_INFERENCE.md\": \"2feb54dcd47aacec495ff6db2dba92d143dd4b223c6e11b0408a31290f0d179d\",\n85:   \"candidate/VIEW_LICENSE.md\": \"2af71558e438db0b73a20beab92dc278a94e1bbe974c00c1a33e3ab62d53a608\",\n86:   \"candidate/VIEW_LICENSE_PATH.md\": \"c693279643b8cd5d248172d9c22cb7cf4ed163a3c98c8a3f69c2717edd3eacb7\",\n87:   \"candidate/VIEW_NAME.md\": \"03e5d2520c4667ace0d8a7b280f04f28d49c2ade96e45679d79ddd18f49c6e24\",\n88:   \"candidate/VIEW_OBJECTIVE.md\": \"3b2a5aec55edb29c2441c1fbc7df3bfaae605163d0a2e62c2eb38eee00b7fb62\",\n89:   \"candidate/VIEW_REPO_NAME.md\": \"cfeddd00aba8b89a343df14268e71fecd2950ea61996b72cc79a868db1014d7b\",\n90:   \"candidate/acceptance/README.md\": \"cb4e9fe0581b531ac8cd5f3fddec3edb609b8f9075d3cb5efe67123bc344566b\",\n91:   \"candidate/acceptance/probe.py\": \"ea7863a5a765368b93675f2a2d69c3337fd5da25a9a30dd76e2398775e0d180a\",\n92:   \"upstream/LICENSE\": \"837f9e6758e4d3313dc19beaa4638522f22c781c9a27d32ff56b473e7094eccc\",\n93:   \"upstream/README.md\": \"40b5d4f8df78510ec9b05454df1d307ca5eb44ee055328229faa07d0f6e1c348\",\n94:   \"upstream/internal/data/dashboard.go\": \"d03ed7b8243f97c6f906a52ba7aad63645a468586092c4584f20437972ffd656\",\n95:   \"upstream/internal/data/models.go\": \"5cd2a997f2efa9fd7d2916446d8173571fba7ee40dfb9703083d266bb6cab000\",\n96:   \"upstream/internal/data/store_house.go\": \"e79c86687cc434803229f62571c4b5737eac983a8d1e7d6ef1e32bf15c0bf205\",\n97:   \"upstream/internal/data/store_maintenance.go\": \"d150cb4ee2bc410a9844768b63a4447c81a8122555c9bcc465b1c54c3a9d2b37\",\n98:   \"upstream/internal/data/store_servicelog.go\": \"0cc864c8ff483237fbd128d417f6d2bf2a9ff66fdcbf2719c97cb239c6a65f4a\",\n99:   \"upstream/internal/data/validation.go\": \"6bb00aeae3903900ef4182e87fb10bbb640980bcde6739e5e252d29b45d8fef4\"\n100:  },\n101:  \"scenario\": {\n102:   \"acceptance\": [\n103:    \"A fresh database has no home; POST /api/home creates exactly one record with id home, and a second POST returns 409 HOME_EXISTS without mutating the stored home.\",\n104:    \"POST /api/equipment under the existing home returns 201 and round-trips through list and detail; blank names, invalid categories, and unknown homes return 422 or 404 and add no equipment row.\",\n105:    \"POST /api/plans enforces interval_days 1..3650 and mutual exclusion of last_completed_on and first_due_on; GET /api/tasks/due returns exact overdue, due, and upcoming sets at as_of and horizon_days boundaries, while invalid requests write nothing.\",\n106:    \"A completion with note inserts one history row and atomically sets due_on to max(previous last_completed_on, completed_on) plus interval_days; leap-day, month-end, year-end, future-date, oversize-note, and unknown-plan failures leave both plan and completions unchanged.\",\n107:    \"GET /api/history filters by home and equipment and returns documented fields in descending completion order; invalid filters write nothing; GET / is dependency-free accessible HTML and unknown routes or methods return documented JSON errors.\"\n108:   ],\n109:   \"audience\": \"A single homeowner keeping care records for their own home on a local machine, with no accounts, notifications, or multi-property operation.\",\n110:   \"id\": \"scn_802f9221599a491781b3dafa4f27a033\",\n111:   \"leaf\": \"home-maintenance-application\",\n112:   \"leaf_name\": \"家庭维护应用\",\n113:   \"name\": \"Home Care Ledger\",\n114:   \"objective\": \"Create the home and its equipment, define every-N-day care plans anchored to them, see exactly which tasks are due or overdue as of a date, record a completion with a note, advance the next due date from the actual completion date, and retrieve care history by home or equipment.\",\n115:   \"revision\": 1,\n116:   \"status\": \"draft\",\n117:   \"updated_at\": \"2026-10-21T08:38:10.458340+00:00\",\n118:   \"workflow\": [\n119:    \"Start the local server against a disposable data directory; initialize the SQLite schema on first start.\",\n120:    \"Create the single home with POST /api/home, then add equipment records with POST /api/equipment anchored by home_id.\",\n121:    \"Create care plans with POST /api/plans using interval_days and an optional equipment anchor.\",\n122:    \"Query GET /api/tasks/due with an explicit as_of and horizon_days to see overdue, due, and upcoming work.\",\n123:    \"Record a completion and note with POST /api/plans/{id}/completions; the same transaction updates the plan next due date.\",\n124:    \"Read GET /api/plans/{id}/completions or GET /api/history filtered by home_id and equipment_id.\",\n125:    \"Use GET / for the basic accessible single-page UI; all actions remain available through the documented JSON API.\"\n126:   ]\n127:  }\n128: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\": \"/Users/milin/2026/软件开发/application-atlas/docs/template-factory/go-home-care-revision-2026-10-21/home-care-r1/calls/blueprint-generate-aux-revision-1/input.json\"}"},"time":{"start":1792577879775,"end":1792577879959}}}}
