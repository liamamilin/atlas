bservation\",\n1672:             \"source_path\": \"src/App.tsrx\",\n1673:             \"version\": \"539881bc67099d491e8ab6f85de0f443fa7de623\"\n1674:           },\n1675:           {\n1676:             \"evidence_id\": \"ev_ba200adf6e2c_86ed2327f33a3ca8\",\n1677:             \"id\": \"S13\",\n1678:             \"kind\": \"code_observation\",\n1679:             \"source_path\": \"src/App.tsrx\",\n1680:             \"version\": \"539881bc67099d491e8ab6f85de0f443fa7de623\"\n1681:           }\n1682:         ]\n1683:       },\n1684:       {\n1685:         \"feature_id\": \"F09\",\n1686:         \"source_ids\": [\n1687:           \"S07\"\n1688:         ],\n1689:         \"sources\": [\n1690:           {\n1691:             \"evidence_id\": \"ev_ba200adf6e2c_4c56ef30a1785be1\",\n1692:             \"id\": \"S07\",\n1693:             \"kind\": \"code_observation\",\n1694:             \"source_path\": \"src/App.tsrx\",\n1695:             \"version\": \"539881bc67099d491e8ab6f85de0f443fa7de623\"\n1696:           }\n1697:         ]\n1698:       },\n1699:       {\n1700:         \"feature_id\": \"F10\",\n1701:         \"source_ids\": [\n1702:           \"S04\",\n1703:           \"S02\"\n1704:         ],\n1705:         \"sources\": [\n1706:           {\n1707:             \"evidence_id\": \"ev_ba200adf6e2c_1596da4a90687ca5\",\n1708:             \"id\": \"S04\",\n1709:             \"kind\": \"code_observation\",\n1710:             \"source_path\": \"src/App.tsrx\",\n1711:             \"version\": \"539881bc67099d491e8ab6f85de0f443fa7de623\"\n1712:           },\n1713:           {\n1714:             \"evidence_id\": \"ev_ba200adf6e2c_05babdea64ba9858\",\n1715:             \"id\": \"S02\",\n1716:             \"kind\": \"code_observation\",\n1717:             \"source_path\": \"src/App.tsrx\",\n1718:             \"version\": \"539881bc67099d491e8ab6f85de0f443fa7de623\"\n1719:           }\n1720:         ]\n1721:       },\n1722:       {\n1723:         \"feature_id\": \"F11\",\n1724:         \"source_ids\": [],\n1725:         \"sources\": []\n1726:       },\n1727:       {\n1728:         \"feature_id\": \"F12\",\n1729:         \"source_ids\": [\n1730:           \"S14\",\n1731:           \"S21\"\n1732:         ],\n1733:         \"sources\": [\n1734:           {\n1735:             \"evidence_id\": \"ev_ba200adf6e2c_8e11efc61a4650ba\",\n1736:             \"id\": \"S14\",\n1737:             \"kind\": \"code_observation\",\n1738:             \"source_path\": \"src/App.tsrx\",\n1739:             \"version\": \"539881bc67099d491e8ab6f85de0f443fa7de623\"\n1740:           },\n1741:           {\n1742:             \"evidence_id\": \"ev_ba200adf6e2c_ec303a2fd1afa287\",\n1743:             \"id\": \"S21\",\n1744:             \"kind\": \"code_observation\",\n1745:             \"source_path\": \"src/App.tsrx\",\n1746:             \"version\": \"539881bc67099d491e8ab6f85de0f443fa7de623\"\n1747:           }\n1748:         ]\n1749:       },\n1750:       {\n1751:         \"feature_id\": \"F13\",\n1752:         \"source_ids\": [],\n1753:         \"sources\": []\n1754:       },\n1755:       {\n1756:         \"feature_id\": \"F14\",\n1757:         \"source_ids\": [],\n1758:         \"sources\": []\n1759:       },\n1760:       {\n1761:         \"feature_id\": \"F15\",\n1762:         \"source_ids\": [],\n1763:         \"sources\": []\n1764:       },\n1765:       {\n1766:         \"feature_id\": \"F16\",\n1767:         \"source_ids\": [],\n1768:         \"sources\": []\n1769:       },\n1770:       {\n1771:         \"feature_id\": \"F17\",\n1772:         \"source_ids\": [],\n1773:         \"sources\": []\n1774:       },\n1775:       {\n1776:         \"feature_id\": \"F18\",\n1777:         \"source_ids\": [],\n1778:         \"sources\": []\n1779:       },\n1780:       {\n1781:         \"feature_id\": \"F19\",\n1782:         \"source_ids\": [],\n1783:         \"sources\": []\n1784:       },\n1785:       {\n1786:         \"feature_id\": \"F20\",\n1787:         \"source_ids\": [\n1788:           \"S19\",\n1789:           \"S16\",\n1790:           \"S03\"\n1791:         ],\n1792:         \"sources\": [\n1793:           {\n1794:             \"evidence_id\": \"ev_ba200adf6e2c_b1ca64cf2ad02998\",\n1795:             \"id\": \"S19\",\n1796:             \"kind\": \"code_observation\",\n1797:             \"source_path\": \"src/App.tsrx\",\n1798:             \"version\": \"539881bc67099d491e8ab6f85de0f443fa7de623\"\n1799:           },\n1800:           {\n1801:             \"evidence_id\": \"ev_ba200adf6e2c_9ab6b0e51811a16d\",\n1802:             \"id\": \"S16\",\n1803:             \"kind\": \"code_observation\",\n1804:             \"source_path\": \"src/App.tsrx\",\n1805:             \"version\": \"539881bc67099d491e8ab6f85de0f443fa7de623\"\n1806:           },\n1807:           {\n1808:             \"evidence_id\": \"ev_ba200adf6e2c_06c81a165e03c96a\",\n1809:             \"id\": \"S03\",\n1810:             \"kind\": \"code_observation\",\n1811:             \"source_path\": \"src/App.tsrx\",\n1812:             \"version\": \"539881bc67099d491e8ab6f85de0f443fa7de623\"\n1813:           }\n1814:         ]\n1815:       },\n1816:       {\n1817:         \"feature_id\": \"F21\",\n1818:         \"source_ids\": [],\n1819:         \"sources\": []\n1820:       },\n1821:       {\n1822:         \"feature_id\": \"F22\",\n1823:         \"source_ids\": [],\n1824:         \"sources\": []\n1825:       },\n1826:       {\n1827:         \"feature_id\": \"F23\",\n1828:         \"source_ids\": [\n1829:           \"S12\"\n1830:         ],\n1831:         \"sources\": [\n1832:           {\n1833:             \"evidence_id\": \"ev_ba200adf6e2c_7150b0ac7a5678db\",\n1834:             \"id\": \"S12\",\n1835:             \"kind\": \"code_observation\",\n1836:             \"source_path\": \"src/App.tsrx\",\n1837:             \"version\": \"539881bc67099d491e8ab6f85de0f443fa7de623\"\n1838:           }\n1839:         ]\n1840:       },\n1841:       {\n1842:         \"feature_id\": \"F24\",\n1843:         \"source_ids\": [\n1844:           \"S15\"\n1845:         ],\n1846:         \"sources\": [\n1847:           {\n1848:             \"evidence_id\": \"ev_ba200adf6e2c_93ff254508846f11\",\n1849:             \"id\": \"S15\",\n1850:             \"kind\": \"code_observation\",\n1851:             \"source_path\": \"src/App.tsrx\",\n1852:             \"version\": \"539881bc67099d491e8ab6f85de0f443fa7de623\"\n1853:           }\n1854:         ]\n1855:       }\n1856:     ],\n1857:     \"schema\": \"atlas.source-citation-matrix.v1\"\n1858:   },\n1859:   \"source_manifest_digest\": \"2353618bca8208641f5333320abc536d4e495c2b78c1f26c16e9d1f2ad6c4e03\"\n1860: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/milin/2026/软件开发/application-atlas/application-atlas-production-pack/atlas/template-factory/jobs/job_dcb163d70a8e400fb07bc606570e2313/attempt-1/blueprint-spec-review-0-ad1379367f3e742a-product_completeness/source/DRAFT.md, lines 1244-1860\n1244:         \"S06\",\n1245:         \"S13\"\n1246:       ]\n1247:     },\n1248:     {\n1249:       \"acceptance\": [\n1250:         \"A09\"\n1251:       ],\n1252:       \"applicability\": \"current required\",\n1253:       \"id\": \"F09\",\n1254:       \"name\": \"删除与撤销恢复\",\n1255:       \"phase\": \"P0\",\n1256:       \"reason\": \"场景要求可恢复的失败；S07 记录仅归档条目可删除及 Undo\n1257: 调用保存恢复，但未给出精确恢复时长。目标删除/恢复合同保持不变：去掉“仅归档可删”前置限制，以可恢复回收状态提供兜底，不从源观察推导固定秒数。\",\n1258:       \"sources\": [\n1259:         \"S07\"\n1260:       ]\n1261:     },\n1262:     {\n1263:       \"acceptance\": [\n1264:         \"A02\",\n1265:         \"A10\",\n1266:         \"A12\"\n1267:       ],\n1268:       \"applicability\": \"current required\",\n1269:       \"id\": \"F10\",\n1270:       \"name\": \"输入校验与错误合同\",\n1271:       \"phase\": \"P0\",\n1272:       \"reason\": \"S04 记录上游 Valibot 表单对 URL、标题、描述和标签的约束，S02 记录新记录保存派生 hostname。目标按既定合同使用绝对 HTTP(S) URL 解析、允许单标签\n1273: hostname、保留原始 URL 文本，并为保存与移动提供明确错误和无写入失败；这些是 adjusted 设计，不把上游点域名正则或标签必填作为目标规则。\",\n1274:       \"sources\": [\n1275:         \"S04\",\n1276:         \"S02\"\n1277:       ]\n1278:     },\n1279:     {\n1280:       \"acceptance\": [\n1281:         \"A11\"\n1282:       ],\n1283:       \"applicability\": \"current required\",\n1284:       \"id\": \"F11\",\n1285:       \"name\": \"本地应用外壳与首启（空库）\",\n1286:       \"phase\": \"P0\",\n1287:       \"reason\": \"本模板面向单用户本地工具；Python 服务端渲染的 HTML\n1288: 页面与表单（POST/redirect/GET）、首启空库视图及保存—浏览—检索—打开闭环是目标交付设计，不宣称源包已经提供这些服务端行为，也不以未纳入当前来源索引的挂载入口作依据。\",\n1289:       \"sources\": []\n1290:     },\n1291:     {\n1292:       \"acceptance\": [\n1293:         \"A13\"\n1294:       ],\n1295:       \"applicability\": \"later\",\n1296:       \"id\": \"F12\",\n1297:       \"name\": \"元数据与图标增强（离线降级）\",\n1298:       \"phase\": \"P1\",\n1299:       \"reason\": \"S14 记录 Google favicon 经 images.weserv.nl 获取及失败日志，S21 记录 api.microlink.io 元数据和 images.weserv.nl logo\n1300: 请求及失败处理。目标保留既定 P1 可选增强与离线降级定位，不使这些外部端点成为 P0 可用性依赖；本地 hostname 展示与增强降级属于目标设计，不把端点可用性写成已验证事实。\",\n1301:       \"sources\": [\n1302:         \"S14\",\n1303:         \"S21\"\n1304:       ]\n1305:     },\n1306:     {\n1307:       \"acceptance\": [\n1308:         \"A14\"\n1309:       ],\n1310:       \"applicability\": \"later\",\n1311:       \"id\": \"F13\",\n1312:       \"name\": \"导入/导出（浏览器书签 HTML）\",\n1313:       \"phase\": \"P1\",\n1314:       \"reason\": \"浏览器书签 HTML 导入/导出是本模板后期互操作设计选择，保留 F13/P1/A14；它是目标路线图，不构成对上游导入/导出能力存在或缺失的断言。\",\n1315:       \"sources\": []\n1316:     },\n1317:     {\n1318:       \"acceptance\": [\n1319:         \"A15\"\n1320:       ],\n1321:       \"applicability\": \"later\",\n1322:       \"id\": \"F14\",\n1323:       \"name\": \"重复链接检测\",\n1324:       \"phase\": \"P1\",\n1325:       \"reason\": \"重复链接检测是本模板后期设计选择，保留 F14/P1/A15、原 D06 以及保存/导入路径的既定目标；P0\n1326: 核心用例不依赖该能力。不以列表筛选或记录类型观察证明上游完全没有去重，也不宣称已经验证其能力缺失。\",\n1327:       \"sources\": []\n1328:     },\n1329:     {\n1330:       \"acceptance\": [],\n1331:       \"applicability\": \"not applicable\",\n1332:       \"id\": \"F15\",\n1333:       \"name\": \"浏览器扩展/分享目标抓取\",\n1334:       \"phase\": null,\n1335:       \"reason\": \"场景交付为本地 Web 工具，扩展与移动分享目标不在本期范围，手工录入与打开回跳已覆盖核心旅程。\",\n1336:       \"sources\": []\n1337:     },\n1338:     {\n1339:       \"acceptance\": [],\n1340:       \"applicability\": \"not applicable\",\n1341:       \"id\": \"F16\",\n1342:       \"name\": \"多设备与云同步\",\n1343:       \"phase\": null,\n1344:       \"reason\": \"本期是单机单实例的本地库，数据在单一 SQLite 文件；跨设备同步属后期形态，不阻塞核心旅程。\",\n1345:       \"sources\": []\n1346:     },\n1347:     {\n1348:       \"acceptance\": [],\n1349:       \"applicability\": \"decision needed\",\n1350:       \"id\": \"F17\",\n1351:       \"name\": \"网页留存副本/快照\",\n1352:       \"phase\": null,\n1353:       \"reason\": \"本模板 P0 只保存 URL 引用而不保存网页副本；网页留存仍为 decision needed，须用户明确需求后再决定外部抓取与存储方案。此处说明目标范围，不据当前不可用类型来源断言上游完整能力边界。\",\n1354:       \"sources\": []\n1355:     },\n1356:     {\n1357:       \"acceptance\": [],\n1358:       \"applicability\": \"decision needed\",\n1359:       \"id\": \"F18\",\n1360:       \"name\": \"失效链接检测与修复\",\n1361:       \"phase\": null,\n1362:       \"reason\": \"链接腐坏是本类型的结构性风险，但检测需要主动外呼，外部网络在验收中禁用；先保证引用与打开回跳，是否检测待用户决定。\",\n1363:       \"sources\": []\n1364:     },\n1365:     {\n1366:       \"acceptance\": [],\n1367:       \"applicability\": \"decision needed\",\n1368:       \"id\": \"F19\",\n1369:       \"name\": \"嵌套归类与多标签并存\",\n1370:       \"phase\": null,\n1371:       \"reason\": \"场景明说“选择一个简单归类”，扁平单选加收件区已足够；嵌套/标签是成熟能力，待归类数量或交叉主题增长时再评估。\",\n1372:       \"sources\": []\n1373:     },\n1374:     {\n1375:       \"acceptance\": [],\n1376:       \"applicability\": \"not applicable\",\n1377:       \"id\": \"F20\",\n1378:       \"name\": \"置顶/归档与多排序模式\",\n1379:       \"phase\": null,\n1380:       \"reason\": \"上游置顶与归档、三种排序属书签阅读器语境（S19、S16、S03），会给编辑与删除增加前置条件，与快速保存、快速清理相冲突，故不采用。\",\n1381:       \"sources\": [\n1382:         \"S19\",\n1383:         \"S16\",\n1384:         \"S03\"\n1385:       ]\n1386:     },\n1387:     {\n1388:       \"acceptance\": [],\n1389:       \"applicability\": \"not applicable\",\n1390:       \"id\": \"F21\",\n1391:       \"name\": \"公开分享与协作库\",\n1392:       \"phase\": null,\n1393:       \"reason\": \"场景是私有个人收藏箱，分享不在核心旅程内；公开或协作需要多用户身份与权限，属不同类型定位。\",\n1394:       \"sources\": []\n1395:     },\n1396:     {\n1397:       \"acceptance\": [],\n1398:       \"applicability\": \"not applicable\",\n1399:       \"id\": \"F22\",\n1400:       \"name\": \"阅读稍后与未读标记\",\n1401:       \"phase\": null,\n1402:       \"reason\": \"场景重心是留存引用并可回跳，而非消费队列；未读标记会使产品向 Read-it-later 漂移。\",\n1403:       \"sources\": []\n1404:     },\n1405:     {\n1406:       \"acceptance\": [],\n1407:       \"applicability\": \"not applicable\",\n1408:       \"id\": \"F23\",\n1409:       \"name\": \"复制 URL 动作\",\n1410:       \"phase\": null,\n1411:       \"reason\": \"上游提供 Copy URL（S12），但本场景终点是打开原页而非分发链接，去掉可减少每条记录的操作噪音。\",\n1412:       \"sources\": [\n1413:         \"S12\"\n1414:       ]\n1415:     },\n1416:     {\n1417:       \"acceptance\": [],\n1418:       \"applicability\": \"not applicable\",\n1419:       \"id\": \"F24\",\n1420:       \"name\": \"访问计数与最近访问时间\",\n1421:       \"phase\": null,\n1422:       \"reason\": \"S15 直接记录 Visit 更新 visitCount 与 visitedAt 后打开原 URL；场景只需打开动作，目标不保留这两个访问统计字段，不再额外引用未纳入当前场景来源索引的类型定义。\",\n1423:       \"sources\": [\n1424:         \"S15\"\n1425:       ]\n1426:     }\n1427:   ],\n1428:   \"limits\": [\n1429:     \"不实现云同步、多用户共享或托管部署（D11、F16、F21）。\",\n1430:     \"不保存网页快照、不做正文全文检索、不做失效链接检测（F17、F18、D13）。\",\n1431:     \"不引入置顶/归档、多排序模式、复制 URL 与访问计数（F20、F23、F24）。\",\n1432:     \"归类为扁平单选，不支持嵌套层级或多标签并存（F19、D01）。\",\n1433:     \"第三方元数据与图标抓取未验证可达性，仅作可选增强且失败静默降级（F12、D05）。\",\n1434:     \"验收不携带认证凭据；若目标要求认证，验收必须显式报告基础设施未就绪而非跳过或通过（D09）。\",\n1435:     \"不设置未经验证的性能或成本目标。\"\n1436:   ],\n1437:   \"phases\": [\n1438:     {\n1439:       \"acceptance\": [\n1440:         \"A01\",\n1441:         \"A02\",\n1442:         \"A03\",\n1443:         \"A04\",\n1444:         \"A05\",\n1445:         \"A06\",\n1446:         \"A07\",\n1447:         \"A08\",\n1448:         \"A09\",\n1449:         \"A10\",\n1450:         \"A11\",\n1451:         \"A12\"\n1452:       ],\n1453:       \"features\": [\n1454:         \"F01\",\n1455:         \"F02\",\n1456:         \"F03\",\n1457:         \"F04\",\n1458:         \"F05\",\n1459:         \"F06\",\n1460:         \"F07\",\n1461:         \"F08\",\n1462:         \"F09\",\n1463:         \"F10\",\n1464:         \"F11\"\n1465:       ],\n1466:       \"goal\": \"用户可保存链接（可选归类或落入未整理）、按归类或关键字找回、打开原页、清理并撤销，且全部数据跨会话与重启保留，非法输入得到可恢复的明确错误。\",\n1467:       \"id\": \"P0\",\n1468:       \"status\": \"not implemented\",\n1469:       \"title\": \"个人收藏箱核心旅程\"\n1470:     },\n1471:     {\n1472:       \"acceptance\": [\n1473:         \"A13\",\n1474:         \"A14\",\n1475:         \"A15\"\n1476:       ],\n1477:       \"features\": [\n1478:         \"F12\",\n1479:         \"F13\",\n1480:         \"F14\"\n1481:       ],\n1482:       \"goal\": \"在离线可用的前提下增强记录可辨识度（本地派生图标、外部抓取仅作增强），并支持浏览器书签格式的导入导出与重复链接检测，用于长期库维护。\",\n1483:       \"id\": \"P1\",\n1484:       \"status\": \"not implemented\",\n1485:       \"title\": \"成熟增强：元数据、互操作与库清理\"\n1486:     }\n1487:   ],\n1488:   \"roles\": [\n1489:     {\n1490:       \"id\": \"R01\",\n1491:       \"name\": \"收藏者（个人用户）\",\n1492:       \"responsibility\": \"在浏览时主动保存外部网页链接，选择或新建简单归类、把未整理的链接移动到合适归类、按归类或关键字找回、打开记录回到原页，并清理误存条目。\"\n1493:     },\n1494:     {\n1495:       \"id\": \"R02\",\n1496:       \"name\": \"本地收藏应用（服务端与页面外壳）\",\n1497:       \"responsibility\": \"校验录入、派生域名、持久化收藏与归类、提供保存/浏览/检索/打开/恢复接口，并在离线条件下保持可用。\"\n1498:     },\n1499:     {\n1500:       \"id\": \"R03\",\n1501:       \"name\": \"独立验收执行者\",\n1502:       \"responsibility\": \"以 URL 与 CLI 参数驱动真实目标，执行正负向行为断言、重启持久化验证与错误恢复验证，不修改应用、不自报运行结果。\"\n1503:     }\n1504:   ],\n1505:   \"source_citation_matrix\": {\n1506:     \"facts_view_digest\": \"241bf3d99ff497c30be8349cbc70529e08df6146736cb749b55268271889aa4b\",\n1507:     \