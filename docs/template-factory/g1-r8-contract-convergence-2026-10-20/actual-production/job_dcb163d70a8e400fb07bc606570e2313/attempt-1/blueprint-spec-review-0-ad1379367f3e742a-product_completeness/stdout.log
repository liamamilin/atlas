\"539881bc67099d491e8ab6f85de0f443fa7de623\"\n1838:           }\n1839:         ]\n1840:       },\n1841:       {\n1842:         \"feature_id\": \"F24\",\n1843:         \"source_ids\": [\n1844:           \"S15\"\n1845:         ],\n1846:         \"sources\": [\n1847:           {\n1848:             \"evidence_id\": \"ev_ba200adf6e2c_93ff254508846f11\",\n1849:             \"id\": \"S15\",\n1850:             \"kind\": \"code_observation\",\n1851:             \"source_path\": \"src/App.tsrx\",\n1852:             \"version\": \"539881bc67099d491e8ab6f85de0f443fa7de623\"\n1853:           }\n1854:         ]\n1855:       }\n1856:     ],\n1857:     \"schema\": \"atlas.source-citation-matrix.v1\"\n1858:   },\n1859:   \"source_manifest_digest\": \"2353618bca8208641f5333320abc536d4e495c2b78c1f26c16e9d1f2ad6c4e03\"\n1860: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\": \"/Users/milin/2026/软件开发/application-atlas/application-atlas-production-pack/atlas/template-factory/jobs/job_dcb163d70a8e400fb07bc606570e2313/attempt-1/blueprint-spec-review-0-ad1379367f3e742a-product_completeness/source/DRAFT.md\", \"offset\": 1244, \"limit\": 700}"},"time":{"start":1792506674375,"end":1792506674694}}}}
