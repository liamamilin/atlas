4ec7bea0c00d6a2a8dc4/attempt-1/blueprint-spec-review-0-bbc43771a1bbbe99-decisions_defaults/input.json, lines 1-27\n1: {\n2:  \"language\": \"zh\",\n3:  \"guidance_file\": null,\n4:  \"revision_file\": \"source/REVISION.md\",\n5:  \"proposal_digest\": \"6f806d9416cd1c5a724e980dece7330dac651c8a838d469db409d940a493f158\",\n6:  \"review_rules_version\": \"atlas.current-required-contract.v1\",\n7:  \"projection_digest\": \"15dcdf3526f590b2c32b0790ccb2dc2ff8b885ae06796f9977bdf7dd4a511341\",\n8:  \"review_dimensions\": [\n9:   \"decisions_defaults\"\n10:  ],\n11:  \"focus\": \"Are applicable decisions explicit, reversible defaults distinguished from human decisions, with meaningful ask triggers?\",\n12:  \"projection_fields\": [\n13:   \"roles\",\n14:   \"features\",\n15:   \"decisions\",\n16:   \"limits\"\n17:  ],\n18:  \"file_plan_included\": false,\n19:  \"source_inventory\": [\n20:   \"ARCHITECTURE.md\",\n21:   \"DRAFT.md\",\n22:   \"RESEARCH.md\",\n23:   \"REVISION.md\",\n24:   \"SOURCE_CITATION_MATRIX.json\",\n25:   \"SOURCE_MANIFEST.json\"\n26:  ]\n27: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\": \"/Users/milin/2026/软件开发/application-atlas/application-atlas-production-pack/atlas/template-factory/jobs/job_f3e32b56036b4ec7bea0c00d6a2a8dc4/attempt-1/blueprint-spec-review-0-bbc43771a1bbbe99-decisions_defaults/input.json\"}"},"time":{"start":1792467529082,"end":1792467529337}}}}
