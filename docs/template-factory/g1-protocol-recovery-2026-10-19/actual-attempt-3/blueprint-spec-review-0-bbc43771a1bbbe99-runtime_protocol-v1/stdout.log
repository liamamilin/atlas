{"type":"tool_use","timestamp":1792432520129,"sessionID":"ses_eaab26edeffe6i68cx2YgCxL3M","part":{"partID":"prt_1554dba12001EpFi4m4niO6G2p","sessionID":"ses_eaab26edeffe6i68cx2YgCxL3M","messageID":"msg_1554dab83001rrpD38MryxawYe","type":"tool","id":"call_00_afbq6671tpk8n696vcb9qneo","tool":"read","state":{"status":"completed","input":{"path":"/Users/milin/2026/软件开发/application-atlas/application-atlas-production-pack/atlas/template-factory/jobs/job_7742b1c124be4c9ab3a0096da5cdd772/attempt-3/blueprint-spec-review-0-bbc43771a1bbbe99-runtime_protocol-v1/source/DRAFT.md","offset":1084,"limit":1200},"output":"Read file /Users/milin/2026/软件开发/application-atlas/application-atlas-production-pack/atlas/template-factory/jobs/job_7742b1c124be4c9ab3a0096da5cdd772/attempt-3/blueprint-spec-review-0-bbc43771a1bbbe99-runtime_protocol-v1/source/DRAFT.md, lines 1084-1690\n1084:       \"default\": \"落入默认“未整理”，保存始终成功。场景流程第3步要求未经整理的链接可先进入默认归类，快速保存不应打断浏览。\",\n1085:       \"id\": \"D02\",\n1086:       \"impact\": \"决定保存接口是否允许缺省 category，以及首启预置数据内容。\",\n1087:       \"question\": \"保存时不选归类，应阻止保存还是落入默认“未整理”？\",\n1088:       \"status\": \"decided\",\n1089:       \"when_to_ask\": \"当目标用户群要求强制归类（例如团队共享库）时再改为必选。\"\n1090:     },\n1091:     {\n1092:       \"default\": \"自动创建（名称大小写不敏感去重），重名则复用现有归类；保持保存流程不中断。\",\n1093:       \"id\": \"D03\",\n1094:       \"impact\": \"决定 categories 的唯一约束、写入事务边界与 409/400 的语义；HTML 归类表单与 JSON API 共用服务层，重名、非法名与默认归类保护都不得产生部分写入。\",\n1095:       \"question\": \"在保存或移动界面输入一个尚不存在的归类名，应自动创建还是报错？\",\n1096:       \"status\": \"decided\",\n1097:       \"when_to_ask\": \"当出现拼写错误导致归类碎片化的证据时，改为只允许从既有归类中选择。\"\n1098:     },\n1099:     {\n1100:       \"default\": \"软删除：记录标记 trashed_at，默认视图排除，提供撤销恢复；场景要求可恢复的失败。\",\n1101:       \"id\": \"D04\",\n1102:       \"impact\": \"决定数据模型的 trashed_at 列、默认列表过滤条件、/restore 恢复路径，以及删除归类时活动与软删记录同迁默认归类；不引入 purge 或永久删除接口。\",\n1103:       \"question\": \"删除是立即物理删除，还是软删除到可恢复区并支持短时撤销？\",\n1104:       \"status\": \"decided\",\n1105:       \"when_to_ask\": \"当用户要求彻底清除隐私数据或回收站增长需要释放空间时，再提供永久删除与清空。\"\n1106:     },\n1107:     {\n1108:       \"default\": \"本地优先：图标由域名派生本地路由，第三方元数据抓取为可选增强且失败静默降级，保证离线可保存。\",\n1109:       \"id\": \"D05\",\n1110:       \"impact\": \"决定保存流程的时延与可用性依赖，以及收藏响应中的 favicon/title 字段形态。\",\n1111:       \"question\": \"标题、描述与图标是否依赖第三方抓取服务？\",\n1112:       \"status\": \"decided\",\n1113:       \"when_to_ask\": \"当部署环境确认可访问外部服务且用户需要富预览时再启用增强。\"\n1114:     },\n1115:     {\n1116:       \"default\": \"自 P1/F14 起默认检测并返回 409 duplicate_url（附已有 id 供跳转查看），保存方显式 allow_duplicate 时可强制新增；P0\n1117: 核心用例不依赖去重，软删除记录不参与判定；场景与成熟产品都倾向一址一记录。\",\n1118:       \"id\": \"D06\",\n1119:       \"impact\": \"决定服务层去重查询、allow_duplicate 语义与导入时的合并或跳过策略（不使用 url 唯一索引）。\",\n1120:       \"question\": \"同一 URL 再次保存时，阻止还是允许？\",\n1121:       \"status\": \"decided\",\n1122:       \"when_to_ask\": \"当用户明确需要对同一地址保留多个不同上下文的记录时再放宽。\"\n1123:     },\n1124:     {\n1125:       \"default\": \"标题加域名(hostname)加描述，大小写不敏感，可与归类过滤叠加；不检索正文（无抓取）。\",\n1126:       \"id\": \"D07\",\n1127:       \"impact\": \"决定查询实现与检索参数语义：category 与 q 可叠加，HTML 归类检索表单必须同时保留两者；计数与列表只统计未软删记录，移动、删除、恢复后保持一致。\",\n1128:       \"question\": \"关键字应匹配哪些字段？\",\n1129:       \"status\": \"decided\",\n1130:       \"when_to_ask\": \"当需要按网页正文全文检索时再引入抓取与索引（属后期能力）。\"\n1131:     },\n1132:     {\n1133:       \"default\": \"python-web 加 Python 3.12 标准库 http.server 加单文件 SQLite；满足离线、单用户与可独立验收，无需外部依赖。\",\n1134:       \"id\": \"D08\",\n1135:       \"impact\": \"决定交付 profile 为 python-web（Python 3.12 标准库 + SQLite + 服务端渲染 HTML），验收通过独立 HTTP 实例与真实表单提交进行。\",\n1136:       \"question\": \"采用何种运行时与持久化方式？\",\n1137:       \"status\": \"decided\",\n1138:       \"when_to_ask\": \"当需要多用户、并发写入或托管部署时再引入 Web 框架与服务端数据库。\"\n1139:     },\n1140:     {\n1141:       \"default\": \"默认无认证；交付进程在独立验收网络中监听测试者可路由的接口（`--host 0.0.0.0`），日常本机使用可绑定 127.0.0.1；不引入凭据文件，符合个人本地库的定位。\",\n1142:       \"id\": \"D09\",\n1143:       \"impact\": \"决定部署方式与验收的认证契约（验收默认不携带凭据）。\",\n1144:       \"question\": \"是否需要登录或口令？\",\n1145:       \"status\": \"decided\",\n1146:       \"when_to_ask\": \"当应用需要暴露到局域网或公网时，必须加入认证，否则只允许本机绑定。\"\n1147:     },\n1148:     {\n1149:       \"default\": \"Netscape 浏览器书签 HTML（本类型的交换约定），归类映射为文件夹或标签字段。\",\n1150:       \"id\": \"D10\",\n1151:       \"impact\": \"决定 P1 导入/导出的解析与生成实现。\",\n1152:       \"question\": \"导入/导出采用什么格式？\",\n1153:       \"status\": \"decided\",\n1154:       \"when_to_ask\": \"当需要与某个具体产品双向同步时再适配其专有格式。\"\n1155:     },\n1156:     {\n1157:       \"default\": \"P0 不做：本地单实例，数据在单一 SQLite 文件；跨设备属后期能力。\",\n1158:       \"id\": \"D11\",\n1159:       \"impact\": \"影响运行形态与数据归属，不阻塞 P0 核心旅程。\",\n1160:       \"question\": \"是否提供云同步或多用户共享？\",\n1161:       \"status\": \"deferred\",\n1162:       \"when_to_ask\": \"当用户明确需要在多设备访问同一库时再设计同步或托管。\"\n1163:     },\n1164:     {\n1165:       \"default\": \"P0 使用扁平单选归类加“未整理”收件区；嵌套与标签属成熟能力，按需在后期启用。\",\n1166:       \"id\": \"D12\",\n1167:       \"impact\": \"影响侧栏结构与检索实现，可后续迁移而不破坏现有数据。\",\n1168:       \"question\": \"归类是否需要嵌套层级，或与标签并存？\",\n1169:       \"status\": \"deferred\",\n1170:       \"when_to_ask\": \"当扁平归类数量增长到难以浏览，或需要交叉主题时。\"\n1171:     },\n1172:     {\n1173:       \"default\": \"本期不做：抓取与归档在离线验收下不可验证；先保证引用记录与打开回跳。\",\n1174:       \"id\": \"D13\",\n1175:       \"impact\": \"涉及外部抓取与存储扩展，属后期可选能力，不纳入 P0/P1 验收。\",\n1176:       \"question\": \"是否需要保存网页副本并检测失效链接？\",\n1177:       \"status\": \"open\",\n1178:       \"when_to_ask\": \"当用户明确要求内容留存，或需要清理死链时再评估。\"\n1179:     }\n1180:   ],\n1181:   \"features\": [\n1182:     {\n1183:       \"acceptance\": [\n1184:         \"A01\",\n1185:         \"A02\",\n1186:         \"A03\"\n1187:       ],\n1188:       \"applicability\": \"current required\",\n1189:       \"id\": \"F01\",\n1190:       \"name\": \"保存收藏（URL 必填，标题/描述可选）\",\n1191:       \"phase\": \"P0\",\n1192:       \"reason\": \"场景流程第1-2步要求看到想记住的页面即主动保存；上游记录了新记录默认字段与保存落盘（S02、S06），并把 URL 校验与编辑回填收敛在表单（S04）。\",\n1193:       \"sources\": [\n1194:         \"S02\",\n1195:         \"S04\",\n1196:         \"S06\",\n1197:         \"S17\"\n1198:       ]\n1199:     },\n1200:     {\n1201:       \"acceptance\": [\n1202:         \"A03\"\n1203:       ],\n1204:       \"applicability\": \"current required\",\n1205:       \"id\": \"F02\",\n1206:       \"name\": \"默认“未整理”与预置归类集合\",\n1207:       \"phase\": \"P0\",\n1208:       \"reason\": \"场景流程第3步要求未整理的链接先进入默认归类；上游只有 Home/Archived 视图、无默认桶（S16），故按场景新增默认收件区，并借鉴其标签聚合思路（S20）。\",\n1209:       \"sources\": [\n1210:         \"S16\",\n1211:         \"S20\"\n1212:       ]\n1213:     },\n1214:     {\n1215:       \"acceptance\": [\n1216:         \"A04\"\n1217:       ],\n1218:       \"applicability\": \"current required\",\n1219:       \"id\": \"F03\",\n1220:       \"name\": \"归类管理（新建/重命名/删除）\",\n1221:       \"phase\": \"P0\",\n1222:       \"reason\": \"场景验收第3条要求可新建归类；上游明确没有 collections/folders（S16），因此归类实体与增删改必须新设计并落库。\",\n1223:       \"sources\": [\n1224:         \"S16\",\n1225:         \"S20\"\n1226:       ]\n1227:     },\n1228:     {\n1229:       \"acceptance\": [\n1230:         \"A05\",\n1231:         \"A12\"\n1232:       ],\n1233:       \"applicability\": \"current required\",\n1234:       \"id\": \"F04\",\n1235:       \"name\": \"记录在归类间移动\",\n1236:       \"phase\": \"P0\",\n1237:       \"reason\": \"场景验收第3条要求记录可在归类之间移动且重开后仍有效；上游检索按标签交集筛选（S16），这里把多值交集改造为单一归属迁移。\",\n1238:       \"sources\": [\n1239:         \"S16\"\n1240:       ]\n1241:     },\n1242:     {\n1243:       \"acceptance\": [\n1244:         \"A06\"\n1245:       ],\n1246:       \"applicability\": \"current required\",\n1247:       \"id\": \"F05\",\n1248:       \"name\": \"归类浏览与条目计数\",\n1249:       \"phase\": \"P0\",\n1250:       \"reason\": \"场景验收第4条要求通过归类浏览找回；上游侧栏按标签聚合计数（S20、S16），改为按归类聚合与筛选。\",\n1251:       \"sources\": [\n1252:         \"S16\",\n1253:         \"S20\"\n1254:       ]\n1255:     },\n1256:     {\n1257:       \"acceptance\": [\n1258:         \"A07\"\n1259:       ],\n1260:       \"applicability\": \"current required\",\n1261:       \"id\": \"F06\",\n1262:       \"name\": \"关键字检索（标题/域名/描述）\",\n1263:       \"phase\": \"P0\",\n1264:       \"reason\": \"场景验收第4条要求关键字检索；上游仅匹配标题小写（S16），需扩展到域名与描述以覆盖只记得来源的场景。\",\n1265:       \"sources\": [\n1266:         \"S16\"\n1267:       ]\n1268:     },\n1269:     {\n1270:       \"acceptance\": [\n1271:         \"A08\"\n1272:       ],\n1273:       \"applicability\": \"current required\",\n1274:       \"id\": \"F07\",\n1275:       \"name\": \"打开原始网页（URL 锚定与回跳）\",\n1276:       \"phase\": \"P0\",\n1277:       \"reason\": \"场景验收第2条与流程第5步要求打开记录即回到原页；上游 Visit 以 window.open(noopener,noreferrer) 打开并由 URL\n1278: 派生域名（S15、S08），保留打开与派生、去掉访问计数。\",\n1279:       \"sources\": [\n1280:         \"S15\",\n1281:         \"S08\"\n1282:       ]\n1283:     },\n1284:     {\n1285:       \"acceptance\": [\n1286:         \"A01\",\n1287:         \"A05\",\n1288:         \"A09\"\n1289:       ],\n1290:       \"applicability\": \"current required\",\n1291:       \"id\": \"F08\",\n1292:       \"name\": \"多会话持久化（跨重启保留）\",\n1293:       \"phase\": \"P0\",\n1294:       \"reason\": \"场景验收第1条要求多次会话之间持久保留；源包以 Dexie/IndexedDB 落盘并在启动时全量载入（S09、S13、S06），README 定位 local-\n1295: first（S11）。目标保留本地单用户与跨会话/跨重启持久化的行为，但把存储实现调整为 Python 服务端 SQLite：不宣称浏览器 profile 持久化、多设备同步或客户端内存映射是目标设计；每个请求从数据库查询。\",\n1296:       \"sources\": [\n1297:         \"S09\",\n1298:         \"S13\",\n1299:         \"S06\",\n1300:         \"S11\"\n1301:       ]\n1302:     },\n1303:     {\n1304:       \"acceptance\": [\n1305:         \"A09\"\n1306:       ],\n1307:       \"applicability\": \"current required\",\n1308:       \"id\": \"F09\",\n1309:       \"name\": \"删除与撤销恢复\",\n1310:       \"phase\": \"P0\",\n1311:       \"reason\": \"场景要求可恢复的失败；上游删除配 5 秒 Undo 恢复（S07），去掉“仅归档可删”前置限制，保留删除加恢复的兜底。\",\n1312:       \"sources\": [\n1313:         \"S07\"\n1314:       ]\n1315:     },\n1316:     {\n1317:       \"acceptance\": [\n1318:         \"A02\",\n1319:         \"A10\",\n1320:         \"A12\"\n1321:       ],\n1322:       \"applicability\": \"current required\",\n1323:       \"id\": \"F10\",\n1324:       \"name\": \"输入校验与错误合同\",\n1325:       \"phase\": \"P0\",\n1326:       \"reason\": \"上游以 Valibot 约束 http/https、标题长度与标签数量（S04），并由 getHostname 派生域名（S08）；场景把标签必填改为可选归类，需要显式错误的保存与移动契约。\",\n1327:       \"sources\": [\n1328:         \"S04\",\n1329:         \"S08\"\n1330:       ]\n1331:     },\n1332:     {\n1333:       \"acceptance\": [\n1334:         \"A11\"\n1335:       ],\n1336:       \"applicability\": \"current required\",\n1337:       \"id\": \"F11\",\n1338:       \"name\": \"本地应用外壳与首启（空库）\",\n1339:       \"phase\": \"P0\",\n1340:       \"reason\": \"场景是单用户本地工具；源包 index.html 提供 #root 并由客户端入口挂载 SPA（S10、S18）。目标外壳调整为 Python 服务端渲染的 HTML\n1341: 页面与表单（POST/redirect/GET），保留保存—浏览—检索—打开的用户闭环与空库就绪视图，不采用 SPA 挂载或客户端对话框状态。\",\n1342:       \"sources\": [\n1343:         \"S10\",\n1344:         \"S18\"\n1345:       ]\n1346:     },\n1347:     {\n1348:       \"acceptance\": [\n1349:         \"A13\"\n1350:       ],\n1351:       \"applicability\": \"later\",\n1352:       \"id\": \"F12\",\n1353:       \"name\": \"元数据与图标增强（离线降级）\",\n1354:       \"phase\": \"P1\",\n1355:       \"reason\": \"场景希望一眼辨认商品页/教程/灵感图，但上游依赖 api.microlink.io、images.weserv.nl 与 Google favicon 三个未验证端点且失败仅\n1356: console.error（S14、S21、S08）；因此把可用性依赖降为本地域名派生，外部抓取降级为可选增强。\",\n1357:       \"sources\": [\n1358:         \"S14\",\n1359:         \"S21\",\n1360:         \"S08\"\n1361:       ]\n1362:     },\n1363:     {\n1364:       \"acceptance\": [\n1365:         \"A14\"\n1366:       ],\n1367:       \"applicability\": \"later\",\n1368:       \"id\": \"F13\",\n1369:       \"name\": \"导入/导出（浏览器书签 HTML）\",\n1370:       \"phase\": \"P1\",\n1371:       \"reason\": \"互操作是成熟产品的标准配置，但上游 manifest 没有导入/导出（S22 无测试脚本、无导入导出能力），属场景后期新增。\",\n1372:       \"sources\": []\n1373:     },\n1374:     {\n1375:       \"acceptance\": [\n1376:         \"A15\"\n1377:       ],\n1378:       \"applicability\": \"later\",\n1379:       \"id\": \"F14\",\n1380:       \"name\": \"重复链接检测\",\n1381:       \"phase\": \"P1\",\n1382:       \"reason\": \"成熟产品趋向一址一记录，上游未实现去重（S16、S17 无重复处理）；P1 在保存与导入路径新增服务层重复检测（D06），P0 核心用例不依赖该能力。\",\n1383:       \"sources\": []\n1384:     },\n1385:     {\n1386:       \"acceptance\": [],\n1387:       \"applicability\": \"not applicable\",\n1388:       \"id\": \"F15\",\n1389:       \"name\": \"浏览器扩展/分享目标抓取\",\n1390:       \"phase\": null,\n1391:       \"reason\": \"场景交付为本地 Web 工具，扩展与移动分享目标不在本期范围，手工录入与打开回跳已覆盖核心旅程。\",\n1392:       \"sources\": []\n1393:     },\n1394:     {\n1395:       \"acceptance\": [],\n1396:       \"applicability\": \"not applicable\",\n1397:       \"id\": \"F16\",\n1398:       \"name\": \"多设备与云同步\",\n1399:       \"phase\": null,\n1400:       \"reason\": \"本期是单机单实例的本地库，数据在单一 SQLite 文件；跨设备同步属后期形态，不阻塞核心旅程。\",\n1401:       \"sources\": []\n1402:     },\n1403:     {\n1404:       \"acceptance\": [],\n1405:       \"applicability\": \"decision needed\",\n1406:       \"id\": \"F17\",\n1407:       \"name\": \"网页留存副本/快照\",\n1408:       \"phase\": null,\n1409:       \"reason\": \"记录只保证引用而非内容（场景与原类型定义如此）；是否保存副本依赖外部抓取与存储，离线验收不可验证，需用户明确要求后再定。\",\n1410:       \"sources\": []\n1411:     },\n1412:     {\n1413:       \"acceptance\": [],\n1414:       \"applicability\": \"decision needed\",\n1415:       \"id\": \"F18\",\n1416:       \"name\": \"失效链接检测与修复\",\n1417:       \"phase\": null,\n1418:       \"reason\": \"链接腐坏是本类型的结构性风险，但检测需要主动外呼，外部网络在验收中禁用；先保证引用与打开回跳，是否检测待用户决定。\",\n1419:       \"sources\": []\n1420:     },\n1421:     {\n1422:       \"acceptance\": [],\n1423:       \"applicability\": \"decision needed\",\n1424:       \"id\": \"F19\",\n1425:       \"name\": \"嵌套归类与多标签并存\",\n1426:       \"phase\": null,\n1427:       \"reason\": \"场景明说“选择一个简单归类”，扁平单选加收件区已足够；嵌套/标签是成熟能力，待归类数量或交叉主题增长时再评估。\",\n1428:       \"sources\": []\n1429:     },\n1430:     {\n1431:       \"acceptance\": [],\n1432:       \"applicability\": \"not applicable\",\n1433:       \"id\": \"F20\",\n1434:       \"name\": \"置顶/归档与多排序模式\",\n1435:       \"phase\": null,\n1436:       \"reason\": \"上游置顶与归档、三种排序属书签阅读器语境（S19、S16、S03），会给编辑与删除增加前置条件，与快速保存、快速清理相冲突，故不采用。\",\n1437:       \"sources\": [\n1438:         \"S19\",\n1439:         \"S16\",\n1440:         \"S03\"\n1441:       ]\n1442:     },\n1443:     {\n1444:       \"acceptance\": [],\n1445:       \"applicability\": \"not applicable\",\n1446:       \"id\": \"F21\",\n1447:       \"name\": \"公开分享与协作库\",\n1448:       \"phase\": null,\n1449:       \"reason\": \"场景是私有个人收藏箱，分享不在核心旅程内；公开或协作需要多用户身份与权限，属不同类型定位。\",\n1450:       \"sources\": []\n1451:     },\n1452:     {\n1453:       \"acceptance\": [],\n1454:       \"applicability\": \"not applicable\",\n1455:       \"id\": \"F22\",\n1456:       \"name\": \"阅读稍后与未读标记\",\n1457:       \"phase\": null,\n1458:       \"reason\": \"场景重心是留存引用并可回跳，而非消费队列；未读标记会使产品向 Read-it-later 漂移。\",\n1459:       \"sources\": []\n1460:     },\n1461:     {\n1462:       \"acceptance\": [],\n1463:       \"applicability\": \"not applicable\",\n1464:       \"id\": \"F23\",\n1465:       \"name\": \"复制 URL 动作\",\n1466:       \"phase\": null,\n1467:       \"reason\": \"上游提供 Copy URL（S12），但本场景终点是打开原页而非分发链接，去掉可减少每条记录的操作噪音。\",\n1468:       \"sources\": [\n1469:         \"S12\"\n1470:       ]\n1471:     },\n1472:     {\n1473:       \"acceptance\": [],\n1474:       \"applicability\": \"not applicable\",\n1475:       \"id\": \"F24\",\n1476:       \"name\": \"访问计数与最近访问时间\",\n1477:       \"phase\": null,\n1478:       \"reason\": \"上游 Visit 会累加 visitCount 与 visitedAt（S15、S17）；场景只需打开动作，不需访问统计，故不保留这两个字段。\",\n1479:       \"sources\": [\n1480:         \"S15\",\n1481:         \"S17\"\n1482:       ]\n1483:     }\n1484:   ],\n1485:   \"file_plan\": [\n1486:     {\n1487:       \"path\": \"acceptance/common.py\",\n1488:       \"purpose\": \"复用的共享验收工具，保持固定字节不变。导入约定：各阶段程序通过 os.path.dirname(os.path.abspath(__file__)) 自举 sys.path 后 import\n1489: common，不依赖工作目录。导出：常量 DEFAULT_CATEGORY、PRESET_CATEGORIES、RESULT_SCHEMA；HttpClient(base_url) 及\n1490: get/post_form/post_json/patch_json/request，限定精确 origin、拒绝认证头与跨源重定向，返回 HttpResponse（status、headers、body、text、json()、locat\n1491: ion）；Recorder（check、expect_status、expect_json_field、finish）；parse_case_args（--case/--base-url/--app-root/--data-\n1492: dir，含必需项校验）；launch_app(app_root,data_dir,port,instance_dir=...,fresh=...)、stop_app、wait_health、free_port；异常\n1493: AcceptanceError/AppStartError/ExternalNavigationBlocked/HttpRequestError；emit_result。执行契约：真实 HTTP 与真实进程重启适配器；app_root\n1494: 只读，data_dir 为测试草稿根，每实例数据库位于 data_dir/instances/<uuid>；不导入应用代码、不读取应用自测判定。\",\n1495:       \"reuse\": true\n1496:     },\n1497:     {\n1498:       \"path\": \"acceptance/p0_library.py\",\n1499:       \"purpose\": \"P0 第一组：A01、A02、A03、A11。导入 common 与标准库 urllib、html.parser、uuid、re；文件内自带轻量 HTML 读取器，收集\n1500: form/input/select/textarea、data-testid、文本与链接，不新增共享文件。A01：对 --base-url 用真实保存表单提交 URL/标题/描述并跟随 303，读回 HTML 行与 JSON；再用\n1501: --app-root/--data-dir 启动隔离实例，经真实表单保存，停止后同一实例子目录重启，断言 id、原始 URL、标题与描述稳定。A02：用保存表单提交单标签主机 URL（如\n1502: http://atlas-a02-xxxx）作为显式正向边界，断言 303、原始字符串持久化且行内 href 精确；用同一表单和 JSON 分别提交缺协议、javascript:、ftp://、http:// 空主机、含空格/非法\n1503: hostname 的值，断言 400 invalid_url、form-error 可读、相对计数不新增且被拒 URL 不出现在列表。A03：HTML 与 API 检查四个预置归类；真实表单省略 category\n1504: 保存落入未整理；表单输入新归类名保存后自动创建并可筛选。A11：/api/health 200 JSON；GET / 200 text/html，含 action=/bookmarks/new 表单、name=url、category-\n1505: manager 链接、列表容器；用不存在的归类过滤得到明确空状态。导出 _HANDLERS 与 main(argv)；只接受本组 case，未知 case 输出 dispatch=false 并非零退出；stdout 单个结果\n1506: JSON。\",\n1507:       \"reuse\": false\n1508:     },\n1509:     {\n1510:       \"error_branch_ids\": [\n1511:         \"html.category_create.name.omitted\",\n1512:         \"html.category_create.name.empty\",\n1513:         \"html.category_create.name.whitespace\",\n1514:         \"html.category_create.name.overlong_121\",\n1515:         \"html.category_rename.name.omitted\",\n1516:         \"html.category_rename.name.empty\",\n1517:         \"html.category_rename.name.whitespace\",\n1518:         \"html.category_rename.name.overlong_121\",\n1519:         \"html.bookmark_save.category.empty\",\n1520:         \"html.bookmark_save.category.whitespace\",\n1521:         \"html.bookmark_save.category.overlong_121\",\n1522:         \"html.bookmark_move.category_id.omitted\",\n1523:         \"html.bookmark_move.category_id.empty\",\n1524:         \"html.bookmark_move.category_id.unknown_id\",\n1525:         \"json.category_create.name.omitted\",\n1526:         \"json.category_create.name.empty\",\n1527:         \"json.category_create.name.whitespace\",\n1528:         \"json.category_create.name.overlong_121\",\n1529:         \"json.category_create.name.null\",\n1530:         \"json.category_rename.name.omitted\",\n1531:         \"json.category_rename.name.empty\",\n1532:         \"json.category_rename.name.whitespace\",\n1533:         \"json.category_rename.name.overlong_121\",\n1534:         \"json.category_rename.name.null\",\n1535:         \"json.bookmark_save.category.empty\",\n1536:         \"json.bookmark_save.category.whitespace\",\n1537:         \"json.bookmark_save.category.overlong_121\",\n1538:         \"json.bookmark_move.category.empty\",\n1539:         \"json.bookmark_move.category.whitespace\",\n1540:         \"json.bookmark_move.category.overlong_121\",\n1541:         \"json.bookmark_move.category.omitted\",\n1542:         \"json.bookmark_move.category.null\"\n1543:       ],\n1544:       \"path\": \"acceptance/p0_organize.py\",\n1545:       \"purpose\": \"P0 第二组：A04、A05、A06、A12。导入 common；文件内自带 HTML 表单解析器与 JSON 读取助手。A04：从首页点击 a[data-testid=category-manager]\n1546: 进入 /categories；用 category-create-form 的真实 name 输入新建，303 后可见且计数正确；用重名及大小写变体提交 create/rename 表单，断言 409\n1547: duplicate_category、form-error、输入保留且集合不变；用 category-rename-form 提交 category_id+name 重命名，记录跟随；用 category-delete-form\n1548: 删除归类，断言活动与软删记录都迁回未整理、软删记录在 /?trash=1 可恢复；用表单对默认归类做 rename/delete，断言 400 protected_category 且不变；同时保留 JSON API 的同等断言。用\n1549: category-create-form 与 category-rename-form 分别提交省略 name、空字符串、纯空白、121 字符名，均断言 400 invalid_name、form-\n1550: error、提交值保留、分类与记录集合及归属不变；JSON POST/PATCH name 各自验证同组及显式 null，错误码 invalid_name 且零写入；A05：用 record-move-form 的真实 record_id\n1551: 与 select category_id 移动，303 后旧归类消失、新归类可见、JSON 读回归类正确；再用 --app-root/--data-dir\n1552: 启动隔离实例，经真实表单移动，停止后同目录重启读回归属。A06：两个归类各两条记录，读取 HTML [data-testid=category-count][data-category-id] 与记录行，并与 /api/categories\n1553: 的 count 和 /api/bookmarks 列表比对；通过真实移动、删除、恢复表单改变状态，逐步断言 count 只计活动记录且与列表一致。A12：只处理书签保存/移动，不使用分类创建或重命名表单。HTML 保存\n1554: category（名称）显式空/纯空白/121 字符 invalid_category，省略则默认未整理；HTML 移动 category_id（ID）省略/空/未知 invalid_category；JSON 保存\n1555: category（名称）省略/null 默认未整理，显式空/纯空白/121 字符 invalid_category；JSON move category（名称）省略/null/空/纯空白/121 字符\n1556: invalid_category。有效新名称可自动创建；HTML 未知 ID 不得变为新名称；JSON 不新增 category_id 字段。每个负向 HTML 为 400/form-error/输入保留，JSON 为\n1557: 400/error.code=invalid_category，分类集合/记录集合/锚点归属均不变；修正有效值可恢复。导出 _HANDLERS 与 main(argv)；A05 需要 --app-root/--data-dir，其余仅\n1558: --base-url；未知 case 显式失败。\",\n1559:       \"reuse\": false\n1560:     },\n1561:     {\n1562:       \"path\": \"acceptance/p0_find_open.py\",\n1563:       \"purpose\": \"P0 第三组：A07、A08。导入 common；文件内自带 HTML 解析器。A07：创建两个归类及记录；用真实 category-search-form 提交 category 与 q，断言\n1564: 200、表单的 category 与 q 值均保留、页面显示所选归类/查询/匹配行；用同一关键字分别在两个归类提交，断言各自只命中本归类记录；在某归类提交无匹配 q，断言显示明确空结果且无记录行；同时保留 JSON\n1565: 断言：标题、hostname、描述的子串大小写不敏感命中，category+q 叠加，无匹配返回 200 空数组。A08：经真实保存表单创建带 query 的原始 URL，解析 tr[data-record-id] 内 a[data-\n1566: testid=record-open-link]，断言 href 精确等于保存值、target=_blank、rel 含 noopener，并以 urljoin 验证它是实际导航目标；再 GET /go/{id} 不跟随重定向，断言 302\n1567: Location 精确等于原始 URL；未知 id 404 not_found；读回记录 URL 未被改写。导出 _HANDLERS 与 main(argv)；仅 --base-url；未实现 case 显式失败。\",\n1568:       \"reuse\": false\n1569:     },\n1570:     {\n1571:       \"path\": \"acceptance/p0_recovery.py\",\n1572:       \"purpose\": \"P0 第四组：A09、A10。导入 common；文件内自带 HTML 表单解析器。A09：经真实保存表单创建记录，用 record-delete-form 软删除并跟随\n1573: 303，断言默认列表/计数排除、/api/bookmarks?include_trashed=1 仍存在、/?trash=1 显示 record-restore-form；用该表单恢复，断言\n1574: URL/标题/描述/归类回归且重新可见；再创建归类与记录、软删除记录后用 category-delete-form 删除归类，断言软删记录迁到未整理且仍可在回收站恢复，恢复后无孤儿；最后用 --app-root/--data-dir\n1575: 启动隔离实例，真实删除后停止、同目录重启，断言删除状态与回收站内容保持，并可恢复。A10：JSON 路径保留未知 id 的 GET/PATCH/DELETE/move 均 404 not_found，三类畸形 JSON 均 400\n1576: bad_request，无 5xx、记录集合与锚点字段不变；HTML 路径用保存表单提交非法 URL，断言 400、form-error、url/title 输入保留、无新增记录，再用同一表单提交修正 URL 断言 303\n1577: 且只新增一条；用归类表单提交非法 name，断言 form-error 且无写入。导出 _HANDLERS 与 main(argv)；A09 需要 --app-root/--data-dir，A10 仅 --base-url；未实现\n1578: case 显式失败。\",\n1579:       \"reuse\": false\n1580:     },\n1581:     {\n1582:       \"path\": \"acceptance/p1_maturity.py\",\n1583:       \"purpose\": \"P1 组 A13、A14、A15 的既有程序，保持固定字节不变：A13 离线保存、hostname 派生与本地降级；A14 Netscape 导出及导入计数/检索；A15 P1 重复 URL 的 409\n1584: 与 allow_duplicate。继续导入 common，导出 _HANDLERS 与 main(argv)，不依赖 P0 新表单断言，也不改变 P1/A15 范围。\",\n1585:       \"reuse\": true\n1586:     },\n1587:     {\n1588:       \"path\": \"acceptance/requirements.txt\",\n1589:       \"purpose\": \"依赖声明，保持固定字节不变：Python 3.12，仅标准库（http.server、sqlite3、urllib、json、html.parser），无第三方包；安装步骤为空，不执行\n1590: pip，不访问包索引；不含凭据、令牌或私有 URL。\",\n1591:       \"reuse\": true\n1592:     },\n1593:     {\n1594:       \"path\": \"acceptance/README.md\",\n1595:       \"purpose\": \"完整运行说明，保持固定字节以外的新版内容：记录 profile=python-web 与 Python 3.12 标准库要求；说明 --base-url 精确 origin、--app-root\n1596: 只读、--data-dir 草稿根及每实例 instances/<uuid> 隔离；列明 A01–A15 的程序、必要 flags 与 runner 一一对应关系；说明 HTML 表单验收契约（data-testid\n1597: 清单、name/category_id/record_id/category/q 字段、303 导航、400/409 form-error 与保留输入）、A02 单标签主机正向策略、归类删除迁移活动+软删记录、count\n1598: 只计活动记录、category+q 搜索保留、/go 不跟随重定向、P0 不抓取外链；说明认证不支持时显式失败、不记录凭据、外部网络限制；给出 stdout 结果 schema、退出码、64000 字符限制；给出根\n1599: delivery.json 示例（schema atlas.application-delivery.v1、root '.'、python-web、install/build 空、start 字面 argv、port\n1600: 8000、/state/app-data）；明确本套件未执行、不得声称通过。\",\n1601:       \"reuse\": false\n1602:     },\n1603:     {\n1604:       \"path\": \"acceptance/runner.json\",\n1605:       \"purpose\": \"独立执行绑定，保持固定字节不变且位于最后：schema=atlas.acceptance-runner.v1，result_schema=atlas.acceptance-\n1606: result.v1；A01、A05、A09 绑定 --case/--base-url/--app-root/--data-dir；A14 绑定 --case/--base-url/--data-dir；其余\n1607: A02–A04、A06–A08、A10–A13、A15 绑定 --case/--base-url。每个规范验收 ID 恰好出现一次，args 仅使用 Atlas 允许的字面量与占位符，与各程序 parse_case_args 的真实\n1608: flags 一致。\",\n1609:       \"reuse\": true\n1610:     }\n1611:   ],\n1612:   \"limits\": [\n1613:     \"不实现云同步、多用户共享或托管部署（D11、F16、F21）。\",\n1614:     \"不保存网页快照、不做正文全文检索、不做失效链接检测（F17、F18、D13）。\",\n1615:     \"不引入置顶/归档、多排序模式、复制 URL 与访问计数（F20、F23、F24）。\",\n1616:     \"归类为扁平单选，不支持嵌套层级或多标签并存（F19、D01）。\",\n1617:     \"第三方元数据与图标抓取未验证可达性，仅作可选增强且失败静默降级（F12、D05）。\",\n1618:     \"验收不携带认证凭据；若目标要求认证，验收必须显式报告基础设施未就绪而非跳过或通过（D09）。\",\n1619:     \"不设置未经验证的性能或成本目标。\"\n1620:   ],\n1621:   \"phases\": [\n1622:     {\n1623:       \"acceptance\": [\n1624:         \"A01\",\n1625:         \"A02\",\n1626:         \"A03\",\n1627:         \"A04\",\n1628:         \"A05\",\n1629:         \"A06\",\n1630:         \"A07\",\n1631:         \"A08\",\n1632:         \"A09\",\n1633:         \"A10\",\n1634:         \"A11\",\n1635:         \"A12\"\n1636:       ],\n1637:       \"features\": [\n1638:         \"F01\",\n1639:         \"F02\",\n1640:         \"F03\",\n1641:         \"F04\",\n1642:         \"F05\",\n1643:         \"F06\",\n1644:         \"F07\",\n1645:         \"F08\",\n1646:         \"F09\",\n1647:         \"F10\",\n1648:         \"F11\"\n1649:       ],\n1650:       \"goal\": \"用户可保存链接（可选归类或落入未整理）、按归类或关键字找回、打开原页、清理并撤销，且全部数据跨会话与重启保留，非法输入得到可恢复的明确错误。\",\n1651:       \"id\": \"P0\",\n1652:       \"status\": \"not implemented\",\n1653:       \"title\": \"个人收藏箱核心旅程\"\n1654:     },\n1655:     {\n1656:       \"acceptance\": [\n1657:         \"A13\",\n1658:         \"A14\",\n1659:         \"A15\"\n1660:       ],\n1661:       \"features\": [\n1662:         \"F12\",\n1663:         \"F13\",\n1664:         \"F14\"\n1665:       ],\n1666:       \"goal\": \"在离线可用的前提下增强记录可辨识度（本地派生图标、外部抓取仅作增强），并支持浏览器书签格式的导入导出与重复链接检测，用于长期库维护。\",\n1667:       \"id\": \"P1\",\n1668:       \"status\": \"not implemented\",\n1669:       \"title\": \"成熟增强：元数据、互操作与库清理\"\n1670:     }\n1671:   ],\n1672:   \"roles\": [\n1673:     {\n1674:       \"id\": \"R01\",\n1675:       \"name\": \"收藏者（个人用户）\",\n1676:       \"responsibility\": \"在浏览时主动保存外部网页链接，选择或新建简单归类、把未整理的链接移动到合适归类、按归类或关键字找回、打开记录回到原页，并清理误存条目。\"\n1677:     },\n1678:     {\n1679:       \"id\": \"R02\",\n1680:       \"name\": \"本地收藏应用（服务端与页面外壳）\",\n1681:       \"responsibility\": \"校验录入、派生域名、持久化收藏与归类、提供保存/浏览/检索/打开/恢复接口，并在离线条件下保持可用。\"\n1682:     },\n1683:     {\n1684:       \"id\": \"R03\",\n1685:       \"name\": \"独立验收执行者\",\n1686:       \"responsibility\": \"以 URL 与 CLI 参数驱动真实目标，执行正负向行为断言、重启持久化验证与错误恢复验证，不修改应用、不自报运行结果。\"\n1687:     }\n1688:   ],\n1689:   \"title\": \"生活待购与灵感收藏夹\"\n1690: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/milin/2026/软件开发/application-atlas/application-atlas-production-pack/atlas/template-factory/jobs/job_7742b1c124be4c9ab3a0096da5cdd772/attempt-3/blueprint-spec-review-0-bbc43771a1bbbe99-runtime_protocol-v1/source/DRAFT.md, lines 1084-1690\n1084:       \"default\": \"落入默认“未整理”，保存始终成功。场景流程第3步要求未经整理的链接可先进入默认归类，快速保存不应打断浏览。\",\n1085:       \"id\": \"D02\",\n1086:       \"impact\": \"决定保存接口是否允许缺省 category，以及首启预置数据内容。\",\n1087:       \"question\": \"保存时不选归类，应阻止保存还是落入默认“未整理”？\",\n1088:       \"status\": \"decided\",\n1089:       \"when_to_ask\": \"当目标用户群要求强制归类（例如团队共享库）时再改为必选。\"\n1090:     },\n1091:     {\n1092:       \"default\": \"自动创建（名称大小写不敏感去重），重名则复用现有归类；保持保存流程不中断。\",\n1093:       \"id\": \"D03\",\n1094:       \"impact\": \"决定 categories 的唯一约束、写入事务边界与 409/400 的语义；HTML 归类表单与 JSON API 共用服务层，重名、非法名与默认归类保护都不得产生部分写入。\",\n1095:       \"question\": \"在保存或移动界面输入一个尚不存在的归类名，应自动创建还是报错？\",\n1096:       \"status\": \"decided\",\n1097:       \"when_to_ask\": \"当出现拼写错误导致归类碎片化的证据时，改为只允许从既有归类中选择。\"\n1098:     },\n1099:     {\n1100:       \"default\": \"软删除：记录标记 trashed_at，默认视图排除，提供撤销恢复；场景要求可恢复的失败。\",\n1101:       \"id\": \"D04\",\n1102:       \"impact\": \"决定数据模型的 trashed_at 列、默认列表过滤条件、/restore 恢复路径，以及删除归类时活动与软删记录同迁默认归类；不引入 purge 或永久删除接口。\",\n1103:       \"question\": \"删除是立即物理删除，还是软删除到可恢复区并支持短时撤销？\",\n1104:       \"status\": \"decided\",\n1105:       \"when_to_ask\": \"当用户要求彻底清除隐私数据或回收站增长需要释放空间时，再提供永久删除与清空。\"\n1106:     },\n1107:     {\n1108:       \"default\": \"本地优先：图标由域名派生本地路由，第三方元数据抓取为可选增强且失败静默降级，保证离线可保存。\",\n1109:       \"id\": \"D05\",\n1110:       \"impact\": \"决定保存流程的时延与可用性依赖，以及收藏响应中的 favicon/title 字段形态。\",\n1111:       \"question\": \"标题、描述与图标是否依赖第三方抓取服务？\",\n1112:       \"status\": \"decided\",\n1113:       \"when_to_ask\": \"当部署环境确认可访问外部服务且用户需要富预览时再启用增强。\"\n1114:     },\n1115:     {\n1116:       \"default\": \"自 P1/F14 起默认检测并返回 409 duplicate_url（附已有 id 供跳转查看），保存方显式 allow_duplicate 时可强制新增；P0\n1117: 核心用例不依赖去重，软删除记录不参与判定；场景与成熟产品都倾向一址一记录。\",\n1118:       \"id\": \"D06\",\n1119:       \"impact\": \"决定服务层去重查询、allow_duplicate 语义与导入时的合并或跳过策略（不使用 url 唯一索引）。\",\n1120:       \"question\": \"同一 URL 再次保存时，阻止还是允许？\",\n1121:       \"status\": \"decided\",\n1122:       \"when_to_ask\": \"当用户明确需要对同一地址保留多个不同上下文的记录时再放宽。\"\n1123:     },\n1124:     {\n1125:       \"default\": \"标题加域名(hostname)加描述，大小写不敏感，可与归类过滤叠加；不检索正文（无抓取）。\",\n1126:       \"id\": \"D07\",\n1127:       \"impact\": \"决定查询实现与检索参数语义：category 与 q 可叠加，HTML 归类检索表单必须同时保留两者；计数与列表只统计未软删记录，移动、删除、恢复后保持一致。\",\n1128:       \"question\": \"关键字应匹配哪些字段？\",\n1129:       \"status\": \"decided\",\n1130:       \"when_to_ask\": \"当需要按网页正文全文检索时再引入抓取与索引（属后期能力）。\"\n1131:     },\n1132:     {\n1133:       \"default\": \"python-web 加 Python 3.12 标准库 http.server 加单文件 SQLite；满足离线、单用户与可独立验收，无需外部依赖。\",\n1134:       \"id\": \"D08\",\n1135:       \"impact\": \"决定交付 profile 为 python-web（Python 3.12 标准库 + SQLite + 服务端渲染 HTML），验收通过独立 HTTP 实例与真实表单提交进行。\",\n1136:       \"question\": \"采用何种运行时与持久化方式？\",\n1137:       \"status\": \"decided\",\n1138:       \"when_to_ask\": \"当需要多用户、并发写入或托管部署时再引入 Web 框架与服务端数据库。\"\n1139:     },\n1140:     {\n1141:       \"default\": \"默认无认证；交付进程在独立验收网络中监听测试者可路由的接口（`--host 0.0.0.0`），日常本机使用可绑定 127.0.0.1；不引入凭据文件，符合个人本地库的定位。\",\n1142:       \"id\": \"D09\",\n1143:       \"impact\": \"决定部署方式与验收的认证契约（验收默认不携带凭据）。\",\n1144:       \"question\": \"是否需要登录或口令？\",\n1145:       \"status\": \"decided\",\n1146:       \"when_to_ask\": \"当应用需要暴露到局域网或公网时，必须加入认证，否则只允许本机绑定。\"\n1147:     },\n1148:     {\n1149:       \"default\": \"Netscape 浏览器书签 HTML（本类型的交换约定），归类映射为文件夹或标签字段。\",\n1150:       \"id\": \"D10\",\n1151:       \"impact\": \"决定 P1 导入/导出的解析与生成实现。\",\n1152:       \"question\": \"导入/导出采用什么格式？\",\n1153:       \"status\": \"decided\",\n1154:       \"when_to_ask\": \"当需要与某个具体产品双向同步时再适配其专有格式。\"\n1155:     },\n1156:     {\n1157:       \"default\": \"P0 不做：本地单实例，数据在单一 SQLite 文件；跨设备属后期能力。\",\n1158:       \"id\": \"D11\",\n1159:       \"impact\": \"影响运行形态与数据归属，不阻塞 P0 核心旅程。\",\n1160:       \"question\": \"是否提供云同步或多用户共享？\",\n1161:       \"status\": \"deferred\",\n1162:       \"when_to_ask\": \"当用户明确需要在多设备访问同一库时再设计同步或托管。\"\n1163:     },\n1164:     {\n1165:       \"default\": \"P0 使用扁平单选归类加“未整理”收件区；嵌套与标签属成熟能力，按需在后期启用。\",\n1166:       \"id\": \"D12\",\n1167:       \"impact\": \"影响侧栏结构与检索实现，可后续迁移而不破坏现有数据。\",\n1168:       \"question\": \"归类是否需要嵌套层级，或与标签并存？\",\n1169:       \"status\": \"deferred\",\n1170:       \"when_to_ask\": \"当扁平归类数量增长到难以浏览，或需要交叉主题时。\"\n1171:     },\n1172:     {\n1173:       \"default\": \"本期不做：抓取与归档在离线验收下不可验证；先保证引用记录与打开回跳。\",\n1174:       \"id\": \"D13\",\n1175:       \"impact\": \"涉及外部抓取与存储扩展，属后期可选能力，不纳入 P0/P1 验收。\",\n1176:       \"question\": \"是否需要保存网页副本并检测失效链接？\",\n1177:       \"status\": \"open\",\n1178:       \"when_to_ask\": \"当用户明确要求内容留存，或需要清理死链时再评估。\"\n1179:     }\n1180:   ],\n1181:   \"features\": [\n1182:     {\n1183:       \"acceptance\": [\n1184:         \"A01\",\n1185:         \"A02\",\n1186:         \"A03\"\n1187:       ],\n1188:       \"applicability\": \"current required\",\n1189:       \"id\": \"F01\",\n1190:       \"name\": \"保存收藏（URL 必填，标题/描述可选）\",\n1191:       \"phase\": \"P0\",\n1192:       \"reason\": \"场景流程第1-2步要求看到想记住的页面即主动保存；上游记录了新记录默认字段与保存落盘（S02、S06），并把 URL 校验与编辑回填收敛在表单（S04）。\",\n1193:       \"sources\": [\n1194:         \"S02\",\n1195:         \"S04\",\n1196:         \"S06\",\n1197:         \"S17\"\n1198:       ]\n1199:     },\n1200:     {\n1201:       \"acceptance\": [\n1202:         \"A03\"\n1203:       ],\n1204:       \"applicability\": \"current required\",\n1205:       \"id\": \"F02\",\n1206:       \"name\": \"默认“未整理”与预置归类集合\",\n1207:       \"phase\": \"P0\",\n1208:       \"reason\": \"场景流程第3步要求未整理的链接先进入默认归类；上游只有 Home/Archived 视图、无默认桶（S16），故按场景新增默认收件区，并借鉴其标签聚合思路（S20）。\",\n1209:       \"sources\": [\n1210:         \"S16\",\n1211:         \"S20\"\n1212:       ]\n1213:     },\n1214:     {\n1215:       \"acceptance\": [\n1216:         \"A04\"\n1217:       ],\n1218:       \"applicability\": \"current required\",\n1219:       \"id\": \"F03\",\n1220:       \"name\": \"归类管理（新建/重命名/删除）\",\n1221:       \"phase\": \"P0\",\n1222:       \"reason\": \"场景验收第3条要求可新建归类；上游明确没有 collections/folders（S16），因此归类实体与增删改必须新设计并落库。\",\n1223:       \"sources\": [\n1224:         \"S16\",\n1225:         \"S20\"\n1226:       ]\n1227:     },\n1228:     {\n1229:       \"acceptance\": [\n1230:         \"A05\",\n1231:         \"A12\"\n1232:       ],\n1233:       \"applicability\": \"current required\",\n1234:       \"id\": \"F04\",\n1235:       \"name\": \"记录在归类间移动\",\n1236:       \"phase\": \"P0\",\n1237:       \"reason\": \"场景验收第3条要求记录可在归类之间移动且重开后仍有效；上游检索按标签交集筛选（S16），这里把多值交集改造为单一归属迁移。\",\n1238:       \"sources\": [\n1239:         \"S16\"\n1240:       ]\n1241:     },\n1242:     {\n1243:       \"acceptance\": [\n1244:         \"A06\"\n1245:       ],\n1246:       \"applicability\": \"current required\",\n1247:       \"id\": \"F05\",\n1248:       \"name\": \"归类浏览与条目计数\",\n1249:       \"phase\": \"P0\",\n1250:       \"reason\": \"场景验收第4条要求通过归类浏览找回；上游侧栏按标签聚合计数（S20、S16），改为按归类聚合与筛选。\",\n1251:       \"sources\": [\n1252:         \"S16\",\n1253:         \"S20\"\n1254:       ]\n1255:     },\n1256:     {\n1257:       \"acceptance\": [\n1258:         \"A07\"\n1259:       ],\n1260:       \"applicability\": \"current required\",\n1261:       \"id\": \"F06\",\n1262:       \"name\": \"关键字检索（标题/域名/描述）\",\n1263:       \"phase\": \"P0\",\n1264:       \"reason\": \"场景验收第4条要求关键字检索；上游仅匹配标题小写（S16），需扩展到域名与描述以覆盖只记得来源的场景。\",\n1265:       \"sources\": [\n1266:         \"S16\"\n1267:       ]\n1268:     },\n1269:     {\n1270:       \"acceptance\": [\n1271:         \"A08\"\n1272:       ],\n1273:       \"applicability\": \"current required\",\n1274:       \"id\": \"F07\",\n1275:       \"name\": \"打开原始网页（URL 锚定与回跳）\",\n1276:       \"phase\": \"P0\",\n1277:       \"reason\": \"场景验收第2条与流程第5步要求打开记录即回到原页；上游 Visit 以 window.open(noopener,noreferrer) 打开并由 URL\n1278: 派生域名（S15、S08），保留打开与派生、去掉访问计数。\",\n1279:       \"sources\": [\n1280:         \"S15\",\n1281:         \"S08\"\n1282:       ]\n1283:     },\n1284:     {\n1285:       \"acceptance\": [\n1286:         \"A01\",\n1287:         \"A05\",\n1288:         \"A09\"\n1289:       ],\n1290:       \"applicability\": \"current required\",\n1291:       \"id\": \"F08\",\n1292:       \"name\": \"多会话持久化（跨重启保留）\",\n1293:       \"phase\": \"P0\",\n1294:       \"reason\": \"场景验收第1条要求多次会话之间持久保留；源包以 Dexie/IndexedDB 落盘并在启动时全量载入（S09、S13、S06），README 定位 local-\n1295: first（S11）。目标保留本地单用户与跨会话/跨重启持久化的行为，但把存储实现调整为 Python 服务端 SQLite：不宣称浏览器 profile 持久化、多设备同步或客户端内存映射是目标设计；每个请求从数据库查询。\",\n1296:       \"sources\": [\n1297:         \"S09\",\n1298:         \"S13\",\n1299:         \"S06\",\n1300:         \"S11\"\n1301:       ]\n1302:     },\n1303:     {\n1304:       \"acceptance\": [\n1305:         \"A09\"\n1306:       ],\n1307:       \"applicability\": \"current required\",\n1308:       \"id\": \"F09\",\n1309:       \"name\": \"删除与撤销恢复\",\n1310:       \"phase\": \"P0\",\n1311:       \"reason\": \"场景要求可恢复的失败；上游删除配 5 秒 Undo 恢复（S07），去掉“仅归档可删”前置限制，保留删除加恢复的兜底。\",\n1312:       \"sources\": [\n1313:         \"S07\"\n1314:       ]\n1315:     },\n1316:     {\n1317:       \"acceptance\": [\n1318:         \"A02\",\n1319:         \"A10\",\n1320:         \"A12\"\n1321:       ],\n1322:       \"applicability\": \"current required\",\n1323:       \"id\": \"F10\",\n1324:       \"name\": \"输入校验与错误合同\",\n1325:       \"phase\": \"P0\",\n1326:       \"reason\": \"上游以 Valibot 约束 http/https、标题长度与标签数量（S04），并由 getHostname 派生域名（S08）；场景把标签必填改为可选归类，需要显式错误的保存与移动契约。\",\n1327:       \"sources\": [\n1328:         \"S04\",\n1329:         \"S08\"\n1330:       ]\n1331:     },\n1332:     {\n1333:       \"acceptance\": [\n1334:         \"A11\"\n1335:       ],\n1336:       \"applicability\": \"current required\",\n1337:       \"id\": \"F11\",\n1338:       \"name\": \"本地应用外壳与首启（空库）\",\n1339:       \"phase\": \"P0\",\n1340:       \"reason\": \"场景是单用户本地工具；源包 index.html 提供 #root 并由客户端入口挂载 SPA（S10、S18）。目标外壳调整为 Python 服务端渲染的 HTML\n1341: 页面与表单（POST/redirect/GET），保留保存—浏览—检索—打开的用户闭环与空库就绪视图，不采用 SPA 挂载或客户端对话框状态。\",\n1342:       \"sources\": [\n1343:         \"S10\",\n1344:         \"S18\"\n1345:       ]\n1346:     },\n1347:     {\n1348:       \"acceptance\": [\n1349:         \"A13\"\n1350:       ],\n1351:       \"applicability\": \"later\",\n1352:       \"id\": \"F12\",\n1353:       \"name\": \"元数据与图标增强（离线降级）\",\n1354:       \"phase\": \"P1\",\n1355:       \"reason\": \"场景希望一眼辨认商品页/教程/灵感图，但上游依赖 api.microlink.io、images.weserv.nl 与 Google favicon 三个未验证端点且失败仅\n1356: console.error（S14、S21、S08）；因此把可用性依赖降为本地域名派生，外部抓取降级为可选增强。\",\n1357:       \"sources\": [\n1358:         \"S14\",\n1359:         \"S21\",\n1360:         \"S08\"\n1361:       ]\n1362:     },\n1363:     {\n1364:       \"acceptance\": [\n1365:         \"A14\"\n1366:       ],\n1367:       \"applicability\": \"later\",\n1368:       \"id\": \"F13\",\n1369:       \"name\": \"导入/导出（浏览器书签 HTML）\",\n1370:       \"phase\": \"P1\",\n1371:       \"reason\": \"互操作是成熟产品的标准配置，但上游 manifest 没有导入/导出（S22 无测试脚本、无导入导出能力），属场景后期新增。\",\n1372:       \"sources\": []\n1373:     },\n1374:     {\n1375:       \"acceptance\": [\n1376:         \"A15\"\n1377:       ],\n1378:       \"applicability\": \"later\",\n1379:       \"id\": \"F14\",\n1380:       \"name\": \"重复链接检测\",\n1381:       \"phase\": \"P1\",\n1382:       \"reason\": \"成熟产品趋向一址一记录，上游未实现去重（S16、S17 无重复处理）；P1 在保存与导入路径新增服务层重复检测（D06），P0 核心用例不依赖该能力。\",\n1383:       \"sources\": []\n1384:     },\n1385:     {\n1386:       \"acceptance\": [],\n1387:       \"applicability\": \"not applicable\",\n1388:       \"id\": \"F15\",\n1389:       \"name\": \"浏览器扩展/分享目标抓取\",\n1390:       \"phase\": null,\n1391:       \"reason\": \"场景交付为本地 Web 工具，扩展与移动分享目标不在本期范围，手工录入与打开回跳已覆盖核心旅程。\",\n1392:       \"sources\": []\n1393:     },\n1394:     {\n1395:       \"acceptance\": [],\n1396:       \"applicability\": \"not applicable\",\n1397:       \"id\": \"F16\",\n1398:       \"name\": \"多设备与云同步\",\n1399:       \"phase\": null,\n1400:       \"reason\": \"本期是单机单实例的本地库，数据在单一 SQLite 文件；跨设备同步属后期形态，不阻塞核心旅程。\",\n1401:       \"sources\": []\n1402:     },\n1403:     {\n1404:       \"acceptance\": [],\n1405:       \"applicability\": \"decision needed\",\n1406:       \"id\": \"F17\",\n1407:       \"name\": \"网页留存副本/快照\",\n1408:       \"phase\": null,\n1409:       \"reason\": \"记录只保证引用而非内容（场景与原类型定义如此）；是否保存副本依赖外部抓取与存储，离线验收不可验证，需用户明确要求后再定。\",\n1410:       \"sources\": []\n1411:     },\n1412:     {\n1413:       \"acceptance\": [],\n1414:       \"applicability\": \"decision needed\",\n1415:       \"id\": \"F18\",\n1416:       \"name\": \"失效链接检测与修复\",\n1417:       \"phase\": null,\n1418:       \"reason\": \"链接腐坏是本类型的结构性风险，但检测需要主动外呼，外部网络在验收中禁用；先保证引用与打开回跳，是否检测待用户决定。\",\n1419:       \"sources\": []\n1420:     },\n1421:     {\n1422:       \"acceptance\": [],\n1423:       \"applicability\": \"decision needed\",\n1424:       \"id\": \"F19\",\n1425:       \"name\": \"嵌套归类与多标签并存\",\n1426:       \"phase\": null,\n1427:       \"reason\": \"场景明说“选择一个简单归类”，扁平单选加收件区已足够；嵌套/标签是成熟能力，待归类数量或交叉主题增长时再评估。\",\n1428:       \"sources\": []\n1429:     },\n1430:     {\n1431:       \"acceptance\": [],\n1432:       \"applicability\": \"not applicable\",\n1433:       \"id\": \"F20\",\n1434:       \"name\": \"置顶/归档与多排序模式\",\n1435:       \"phase\": null,\n1436:       \"reason\": \"上游置顶与归档、三种排序属书签阅读器语境（S19、S16、S03），会给编辑与删除增加前置条件，与快速保存、快速清理相冲突，故不采用。\",\n1437:       \"sources\": [\n1438:         \"S19\",\n1439:         \"S16\",\n1440:         \"S03\"\n1441:       ]\n1442:     },\n1443:     {\n1444:       \"acceptance\": [],\n1445:       \"applicability\": \"not applicable\",\n1446:       \"id\": \"F21\",\n1447:       \"name\": \"公开分享与协作库\",\n1448:       \"phase\": null,\n1449:       \"reason\": \"场景是私有个人收藏箱，分享不在核心旅程内；公开或协作需要多用户身份与权限，属不同类型定位。\",\n1450:       \"sources\": []\n1451:     },\n1452:     {\n1453:       \"acceptance\": [],\n1454:       \"applicability\": \"not applicable\",\n1455:       \"id\": \"F22\",\n1456:       \"name\": \"阅读稍后与未读标记\",\n1457:       \"phase\": null,\n1458:       \"reason\": \"场景重心是留存引用并可回跳，而非消费队列；未读标记会使产品向 Read-it-later 漂移。\",\n1459:       \"sources\": []\n1460:     },\n1461:     {\n1462:       \"acceptance\": [],\n1463:       \"applicability\": \"not applicable\",\n1464:       \"id\": \"F23\",\n1465:       \"name\": \"复制 URL 动作\",\n1466:       \"phase\": null,\n1467:       \"reason\": \"上游提供 Copy URL（S12），但本场景终点是打开原页而非分发链接，去掉可减少每条记录的操作噪音。\",\n1468:       \"sources\": [\n1469:         \"S12\"\n1470:       ]\n1471:     },\n1472:     {\n1473:       \"acceptance\": [],\n1474:       \"applicability\": \"not applicable\",\n1475:       \"id\": \"F24\",\n1476:       \"name\": \"访问计数与最近访问时间\",\n1477:       \"phase\": null,\n1478:       \"reason\": \"上游 Visit 会累加 visitCount 与 visitedAt（S15、S17）；场景只需打开动作，不需访问统计，故不保留这两个字段。\",\n1479:       \"sources\": [\n1480:         \"S15\",\n1481:         \"S17\"\n1482:       ]\n1483:     }\n1484:   ],\n1485:   \"file_plan\": [\n1486:     {\n1487:       \"path\": \"acceptance/common.py\",\n1488:       \"purpose\": \"复用的共享验收工具，保持固定字节不变。导入约定：各阶段程序通过 os.path.dirname(os.path.abspath(__file__)) 自举 sys.path 后 import\n1489: common，不依赖工作目录。导出：常量 DEFAULT_CATEGORY、PRESET_CATEGORIES、RESULT_SCHEMA；HttpClient(base_url) 及\n1490: get/post_form/post_json/patch_json/request，限定精确 origin、拒绝认证头与跨源重定向，返回 HttpResponse（status、headers、body、text、json()、locat\n1491: ion）；Recorder（check、expect_status、expect_json_field、finish）；parse_case_args（--case/--base-url/--app-root/--data-\n1492: dir，含必需项校验）；launch_app(app_root,data_dir,port,instance_dir=...,fresh=...)、stop_app、wait_health、free_port；异常\n1493: AcceptanceError/AppStartError/ExternalNavigationBlocked/HttpRequestError；emit_result。执行契约：真实 HTTP 与真实进程重启适配器；app_root\n1494: 只读，data_dir 为测试草稿根，每实例数据库位于 data_dir/instances/<uuid>；不导入应用代码、不读取应用自测判定。\",\n1495:       \"reuse\": true\n1496:     },\n1497:     {\n1498:       \"path\": \"acceptance/p0_library.py\",\n1499:       \"purpose\": \"P0 第一组：A01、A02、A03、A11。导入 common 与标准库 urllib、html.parser、uuid、re；文件内自带轻量 HTML 读取器，收集\n1500: form/input/select/textarea、data-testid、文本与链接，不新增共享文件。A01：对 --base-url 用真实保存表单提交 URL/标题/描述并跟随 303，读回 HTML 行与 JSON；再用\n1501: --app-root/--data-dir 启动隔离实例，经真实表单保存，停止后同一实例子目录重启，断言 id、原始 URL、标题与描述稳定。A02：用保存表单提交单标签主机 URL（如\n1502: http://atlas-a02-xxxx）作为显式正向边界，断言 303、原始字符串持久化且行内 href 精确；用同一表单和 JSON 分别提交缺协议、javascript:、ftp://、http:// 空主机、含空格/非法\n1503: hostname 的值，断言 400 invalid_url、form-error 可读、相对计数不新增且被拒 URL 不出现在列表。A03：HTML 与 API 检查四个预置归类；真实表单省略 category\n1504: 保存落入未整理；表单输入新归类名保存后自动创建并可筛选。A11：/api/health 200 JSON；GET / 200 text/html，含 action=/bookmarks/new 表单、name=url、category-\n1505: manager 链接、列表容器；用不存在的归类过滤得到明确空状态。导出 _HANDLERS 与 main(argv)；只接受本组 case，未知 case 输出 dispatch=false 并非零退出；stdout 单个结果\n1506: JSON。\",\n1507:       \"reuse\": false\n1508:     },\n1509:     {\n1510:       \"error_branch_ids\": [\n1511:         \"html.category_create.name.omitted\",\n1512:         \"html.category_create.name.empty\",\n1513:         \"html.category_create.name.whitespace\",\n1514:         \"html.category_create.name.overlong_121\",\n1515:         \"html.category_rename.name.omitted\",\n1516:         \"html.category_rename.name.empty\",\n1517:         \"html.category_rename.name.whitespace\",\n1518:         \"html.category_rename.name.overlong_121\",\n1519:         \"html.bookmark_save.category.empty\",\n1520:         \"html.bookmark_save.category.whitespace\",\n1521:         \"html.bookmark_save.category.overlong_121\",\n1522:         \"html.bookmark_move.category_id.omitted\",\n1523:         \"html.bookmark_move.category_id.empty\",\n1524:         \"html.bookmark_move.category_id.unknown_id\",\n1525:         \"json.category_create.name.omitted\",\n1526:         \"json.category_create.name.empty\",\n1527:         \"json.category_create.name.whitespace\",\n1528:         \"json.category_create.name.overlong_121\",\n1529:         \"json.category_create.name.null\",\n1530:         \"json.category_rename.name.omitted\",\n1531:         \"json.category_rename.name.empty\",\n1532:         \"json.category_rename.name.whitespace\",\n1533:         \"json.category_rename.name.overlong_121\",\n1534:         \"json.category_rename.name.null\",\n1535:         \"json.bookmark_save.category.empty\",\n1536:         \"json.bookmark_save.category.whitespace\",\n1537:         \"json.bookmark_save.category.overlong_121\",\n1538:         \"json.bookmark_move.category.empty\",\n1539:         \"json.bookmark_move.category.whitespace\",\n1540:         \"json.bookmark_move.category.overlong_121\",\n1541:         \"json.bookmark_move.category.omitted\",\n1542:         \"json.bookmark_move.category.null\"\n1543:       ],\n1544:       \"path\": \"acceptance/p0_organize.py\",\n1545:       \"purpose\": \"P0 第二组：A04、A05、A06、A12。导入 common；文件内自带 HTML 表单解析器与 JSON 读取助手。A04：从首页点击 a[data-testid=category-manager]\n1546: 进入 /categories；用 category-create-form 的真实 name 输入新建，303 后可见且计数正确；用重名及大小写变体提交 create/rename 表单，断言 409\n1547: duplicate_category、form-error、输入保留且集合不变；用 category-rename-form 提交 category_id+name 重命名，记录跟随；用 category-delete-form\n1548: 删除归类，断言活动与软删记录都迁回未整理、软删记录在 /?trash=1 可恢复；用表单对默认归类做 rename/delete，断言 400 protected_category 且不变；同时保留 JSON API 的同等断言。用\n1549: category-create-form 与 category-rename-form 分别提交省略 name、空字符串、纯空白、121 字符名，均断言 400 invalid_name、form-\n1550: error、提交值保留、分类与记录集合及归属不变；JSON POST/PATCH name 各自验证同组及显式 null，错误码 invalid_name 且零写入；A05：用 record-move-form 的真实 record_id\n1551: 与 select category_id 移动，303 后旧归类消失、新归类可见、JSON 读回归类正确；再用 --app-root/--data-dir\n1552: 启动隔离实例，经真实表单移动，停止后同目录重启读回归属。A06：两个归类各两条记录，读取 HTML [data-testid=category-count][data-category-id] 与记录行，并与 /api/categories\n1553: 的 count 和 /api/bookmarks 列表比对；通过真实移动、删除、恢复表单改变状态，逐步断言 count 只计活动记录且与列表一致。A12：只处理书签保存/移动，不使用分类创建或重命名表单。HTML 保存\n1554: category（名称）显式空/纯空白/121 字符 invalid_category，省略则默认未整理；HTML 移动 category_id（ID）省略/空/未知 invalid_category；JSON 保存\n1555: category（名称）省略/null 默认未整理，显式空/纯空白/121 字符 invalid_category；JSON move category（名称）省略/null/空/纯空白/121 字符\n1556: invalid_category。有效新名称可自动创建；HTML 未知 ID 不得变为新名称；JSON 不新增 category_id 字段。每个负向 HTML 为 400/form-error/输入保留，JSON 为\n1557: 400/error.code=invalid_category，分类集合/记录集合/锚点归属均不变；修正有效值可恢复。导出 _HANDLERS 与 main(argv)；A05 需要 --app-root/--data-dir，其余仅\n1558: --base-url；未知 case 显式失败。\",\n1559:       \"reuse\": false\n1560:     },\n1561:     {\n1562:       \"path\": \"acceptance/p0_find_open.py\",\n1563:       \"purpose\": \"P0 第三组：A07、A08。导入 common；文件内自带 HTML 解析器。A07：创建两个归类及记录；用真实 category-search-form 提交 category 与 q，断言\n1564: 200、表单的 category 与 q 值均保留、页面显示所选归类/查询/匹配行；用同一关键字分别在两个归类提交，断言各自只命中本归类记录；在某归类提交无匹配 q，断言显示明确空结果且无记录行；同时保留 JSON\n1565: 断言：标题、hostname、描述的子串大小写不敏感命中，category+q 叠加，无匹配返回 200 空数组。A08：经真实保存表单创建带 query 的原始 URL，解析 tr[data-record-id] 内 a[data-\n1566: testid=record-open-link]，断言 href 精确等于保存值、target=_blank、rel 含 noopener，并以 urljoin 验证它是实际导航目标；再 GET /go/{id} 不跟随重定向，断言 302\n1567: Location 精确等于原始 URL；未知 id 404 not_found；读回记录 URL 未被改写。导出 _HANDLERS 与 main(argv)；仅 --base-url；未实现 case 显式失败。\",\n1568:       \"reuse\": false\n1569:     },\n1570:     {\n1571:       \"path\": \"acceptance/p0_recovery.py\",\n1572:       \"purpose\": \"P0 第四组：A09、A10。导入 common；文件内自带 HTML 表单解析器。A09：经真实保存表单创建记录，用 record-delete-form 软删除并跟随\n1573: 303，断言默认列表/计数排除、/api/bookmarks?include_trashed=1 仍存在、/?trash=1 显示 record-restore-form；用该表单恢复，断言\n1574: URL/标题/描述/归类回归且重新可见；再创建归类与记录、软删除记录后用 category-delete-form 删除归类，断言软删记录迁到未整理且仍可在回收站恢复，恢复后无孤儿；最后用 --app-root/--data-dir\n1575: 启动隔离实例，真实删除后停止、同目录重启，断言删除状态与回收站内容保持，并可恢复。A10：JSON 路径保留未知 id 的 GET/PATCH/DELETE/move 均 404 not_found，三类畸形 JSON 均 400\n1576: bad_request，无 5xx、记录集合与锚点字段不变；HTML 路径用保存表单提交非法 URL，断言 400、form-error、url/title 输入保留、无新增记录，再用同一表单提交修正 URL 断言 303\n1577: 且只新增一条；用归类表单提交非法 name，断言 form-error 且无写入。导出 _HANDLERS 与 main(argv)；A09 需要 --app-root/--data-dir，A10 仅 --base-url；未实现\n1578: case 显式失败。\",\n1579:       \"reuse\": false\n1580:     },\n1581:     {\n1582:       \"path\": \"acceptance/p1_maturity.py\",\n1583:       \"purpose\": \"P1 组 A13、A14、A15 的既有程序，保持固定字节不变：A13 离线保存、hostname 派生与本地降级；A14 Netscape 导出及导入计数/检索；A15 P1 重复 URL 的 409\n1584: 与 allow_duplicate。继续导入 common，导出 _HANDLERS 与 main(argv)，不依赖 P0 新表单断言，也不改变 P1/A15 范围。\",\n1585:       \"reuse\": true\n1586:     },\n1587:     {\n1588:       \"path\": \"acceptance/requirements.txt\",\n1589:       \"purpose\": \"依赖声明，保持固定字节不变：Python 3.12，仅标准库（http.server、sqlite3、urllib、json、html.parser），无第三方包；安装步骤为空，不执行\n1590: pip，不访问包索引；不含凭据、令牌或私有 URL。\",\n1591:       \"reuse\": true\n1592:     },\n1593:     {\n1594:       \"path\": \"acceptance/README.md\",\n1595:       \"purpose\": \"完整运行说明，保持固定字节以外的新版内容：记录 profile=python-web 与 Python 3.12 标准库要求；说明 --base-url 精确 origin、--app-root\n1596: 只读、--data-dir 草稿根及每实例 instances/<uuid> 隔离；列明 A01–A15 的程序、必要 flags 与 runner 一一对应关系；说明 HTML 表单验收契约（data-testid\n1597: 清单、name/category_id/record_id/category/q 字段、303 导航、400/409 form-error 与保留输入）、A02 单标签主机正向策略、归类删除迁移活动+软删记录、count\n1598: 只计活动记录、category+q 搜索保留、/go 不跟随重定向、P0 不抓取外链；说明认证不支持时显式失败、不记录凭据、外部网络限制；给出 stdout 结果 schema、退出码、64000 字符限制；给出根\n1599: delivery.json 示例（schema atlas.application-delivery.v1、root '.'、python-web、install/build 空、start 字面 argv、port\n1600: 8000、/state/app-data）；明确本套件未执行、不得声称通过。\",\n1601:       \"reuse\": false\n1602:     },\n1603:     {\n1604:       \"path\": \"acceptance/runner.json\",\n1605:       \"purpose\": \"独立执行绑定，保持固定字节不变且位于最后：schema=atlas.acceptance-runner.v1，result_schema=atlas.acceptance-\n1606: result.v1；A01、A05、A09 绑定 --case/--base-url/--app-root/--data-dir；A14 绑定 --case/--base-url/--data-dir；其余\n1607: A02–A04、A06–A08、A10–A13、A15 绑定 --case/--base-url。每个规范验收 ID 恰好出现一次，args 仅使用 Atlas 允许的字面量与占位符，与各程序 parse_case_args 的真实\n1608: flags 一致。\",\n1609:       \"reuse\": true\n1610:     }\n1611:   ],\n1612:   \"limits\": [\n1613:     \"不实现云同步、多用户共享或托管部署（D11、F16、F21）。\",\n1614:     \"不保存网页快照、不做正文全文检索、不做失效链接检测（F17、F18、D13）。\",\n1615:     \"不引入置顶/归档、多排序模式、复制 URL 与访问计数（F20、F23、F24）。\",\n1616:     \"归类为扁平单选，不支持嵌套层级或多标签并存（F19、D01）。\",\n1617:     \"第三方元数据与图标抓取未验证可达性，仅作可选增强且失败静默降级（F12、D05）。\",\n1618:     \"验收不携带认证凭据；若目标要求认证，验收必须显式报告基础设施未就绪而非跳过或通过（D09）。\",\n1619:     \"不设置未经验证的性能或成本目标。\"\n1620:   ],\n1621:   \"phases\": [\n1622:     {\n1623:       \"acceptance\": [\n1624:         \"A01\",\n1625:         \"A02\",\n1626:         \"A03\",\n1627:         \"A04\",\n1628:         \"A05\",\n1629:         \"A06\",\n1630:         \"A07\",\n1631:         \"A08\",\n1632:         \"A09\",\n1633:         \"A10\",\n1634:         \"A11\",\n1635:         \"A12\"\n1636:       ],\n1637:       \"features\": [\n1638:         \"F01\",\n1639:         \"F02\",\n1640:         \"F03\",\n1641:         \"F04\",\n1642:         \"F05\",\n1643:         \"F06\",\n1644:         \"F07\",\n1645:         \"F08\",\n1646:         \"F09\",\n1647:         \"F10\",\n1648:         \"F11\"\n1649:       ],\n1650:       \"goal\": \"用户可保存链接（可选归类或落入未整理）、按归类或关键字找回、打开原页、清理并撤销，且全部数据跨会话与重启保留，非法输入得到可恢复的明确错误。\",\n1651:       \"id\": \"P0\",\n1652:       \"status\": \"not implemented\",\n1653:       \"title\": \"个人收藏箱核心旅程\"\n1654:     },\n1655:     {\n1656:       \"acceptance\": [\n1657:         \"A13\",\n1658:         \"A14\",\n1659:         \"A15\"\n1660:       ],\n1661:       \"features\": [\n1662:         \"F12\",\n1663:         \"F13\",\n1664:         \"F14\"\n1665:       ],\n1666:       \"goal\": \"在离线可用的前提下增强记录可辨识度（本地派生图标、外部抓取仅作增强），并支持浏览器书签格式的导入导出与重复链接检测，用于长期库维护。\",\n1667:       \"id\": \"P1\",\n1668:       \"status\": \"not implemented\",\n1669:       \"title\": \"成熟增强：元数据、互操作与库清理\"\n1670:     }\n1671:   ],\n1672:   \"roles\": [\n1673:     {\n1674:       \"id\": \"R01\",\n1675:       \"name\": \"收藏者（个人用户）\",\n1676:       \"responsibility\": \"在浏览时主动保存外部网页链接，选择或新建简单归类、把未整理的链接移动到合适归类、按归类或关键字找回、打开记录回到原页，并清理误存条目。\"\n1677:     },\n1678:     {\n1679:       \"id\": \"R02\",\n1680:       \"name\": \"本地收藏应用（服务端与页面外壳）\",\n1681:       \"responsibility\": \"校验录入、派生域名、持久化收藏与归类、提供保存/浏览/检索/打开/恢复接口，并在离线条件下保持可用。\"\n1682:     },\n1683:     {\n1684:       \"id\": \"R03\",\n1685:       \"name\": \"独立验收执行者\",\n1686:       \"responsibility\": \"以 URL 与 CLI 参数驱动真实目标，执行正负向行为断言、重启持久化验证与错误恢复验证，不修改应用、不自报运行结果。\"\n1687:     }\n1688:   ],\n1689:   \"title\": \"生活待购与灵感收藏夹\"\n1690: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\": \"/Users/milin/2026/软件开发/application-atlas/application-atlas-production-pack/atlas/template-factory/jobs/job_7742b1c124be4c9ab3a0096da5cdd772/attempt-3/blueprint-spec-review-0-bbc43771a1bbbe99-runtime_protocol-v1/source/DRAFT.md\", \"offset\": 1084, \"limit\": 1200}"},"time":{"start":1792432519698,"end":1792432520129}}}}
