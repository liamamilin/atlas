"transport\": \"json\",\n857:           \"value_kind\": \"null\",\n858:           \"write_effect\": \"none\"\n859:         }\n860:       ],\n861:       \"schema\": \"atlas.bookmark-error-contract.v1\"\n862:     },\n863:     \"features\": [\n864:       {\n865:         \"acceptance_ids\": [\n866:           \"A01\",\n867:           \"A02\",\n868:           \"A03\"\n869:         ],\n870:         \"action\": \"填写原始 URL，可选标题/描述，选择已有归类、留为默认「未整理」或输入新归类名并提交。\",\n871:         \"design_basis\": \"场景 workflow 1–2 与验收 1/2：用户主动保存外部网页链接，记录以 URL 锚定并持久保留。\",\n872:         \"entry\": \"首页 GET / 的保存表单 form[action=/bookmarks/new]，字段 url、title、description、category。\",\n873:         \"failure\": \"非法 URL 返回 400 invalid_url，非法归类返回 400 invalid_category；HTML 同页显示 [data-testid=form-error]，不写入。\",\n874:         \"feature_id\": \"F01\",\n875:         \"navigation\": \"成功后 303 到 /?category=<归类> 或 /，浏览器显示新记录行。\",\n876:         \"recovery\": \"失败页保留已填 url/title/description/category，用户修正后重新提交；也可返回列表。\",\n877:         \"success_state\": \"303 返回首页，新记录出现在所选归类，GET /api/bookmarks/{id} 返回同一原始 URL；SQLite 行已持久化。\"\n878:       },\n879:       {\n880:         \"acceptance_ids\": [\n881:           \"A03\"\n882:         ],\n883:         \"action\": \"不另选归类直接保存；首启查看预置归类。\",\n884:         \"design_basis\": \"场景 workflow 3：未经整理的链接先进入默认归类，之后再移动；成熟产品普遍提供未被整理收件区。\",\n885:         \"entry\": \"首页保存表单的 category 字段（默认「未整理」）与侧栏/归类页的预置归类列表。\",\n886:         \"failure\": \"默认归类缺失或写入失败时返回明确错误页或 JSON 错误，不伪装成功。\",\n887:         \"feature_id\": \"F02\",\n888:         \"navigation\": \"303 到首页或未整理归类视图。\",\n889:         \"recovery\": \"重试保存；应用启动时在事务中补齐预置归类。\",\n890:         \"success_state\": \"记录的 category_id 为默认「未整理」，可在 /?category=未整理 看到；“未整理”“待购”“家居改造”“以后看看”均可见。\"\n891:       },\n892:       {\n893:         \"acceptance_ids\": [\n894:           \"A04\"\n895:         ],\n896:         \"action\": \"在真实表单提交 name 新建/重命名，提交 category_id 删除；删除默认归类被拒绝。\",\n897:         \"design_basis\": \"场景验收 3 与 workflow 2：用户可新建归类并把记录放入合适位置；源包没有 collections，属目标新设计。\",\n898:         \"entry\": \"首页 a[data-testid=category-manager] 进入 /categories；该页含 category-create-form、category-rename-\n899: form、category-delete-form。\",\n900:         \"error_branch_ids\": [\n901:           \"html.category_create.name.omitted\",\n902:           \"html.category_create.name.empty\",\n903:           \"html.category_create.name.whitespace\",\n904:           \"html.category_create.name.overlong_121\",\n905:           \"html.category_rename.name.omitted\",\n906:           \"html.category_rename.name.empty\",\n907:           \"html.category_rename.name.whitespace\",\n908:           \"html.category_rename.name.overlong_121\",\n909:           \"json.category_create.name.omitted\",\n910:           \"json.category_create.name.empty\",\n911:           \"json.category_create.name.whitespace\",\n912:           \"json.category_create.name.overlong_121\",\n913:           \"json.category_create.name.null\",\n914:           \"json.category_rename.name.omitted\",\n915:           \"json.category_rename.name.empty\",\n916:           \"json.category_rename.name.whitespace\",\n917:           \"json.category_rename.name.overlong_121\",\n918:           \"json.category_rename.name.null\"\n919:         ],\n920:         \"failure\": \"重名 409 duplicate_category、空名/超长 400 invalid_name、默认归类 400 protected_category；页面显示 form-error\n921: 且数据不变。\",\n922:         \"feature_id\": \"F03\",\n923:         \"navigation\": \"创建/重命名/删除成功后 303 到 /categories。\",\n924:         \"recovery\": \"保留已填 name/category_id 并允许改正或选择其他归类；可返回 /categories 重试。\",\n925:         \"success_state\": \"303 到 /categories；新建/重命名可见且计数正确；删除归类后其活动与软删除记录都迁回「未整理」，软删记录仍可恢复。\"\n926:       },\n927:       {\n928:         \"acceptance_ids\": [\n929:           \"A05\",\n930:           \"A12\"\n931:         ],\n932:         \"action\": \"选择目标归类（API 归类 ID）并提交；HTML 适配器把 ID 翻译为归类名后调用现有 move 服务。\",\n933:         \"design_basis\": \"场景验收 3 与 workflow 3：记录可在归类之间移动，重新打开后仍保持新归属。\",\n934:         \"entry\": \"每条 tr[data-testid=record-row] 内的 form[data-testid=record-move-form]，含 input record_id 与 select\n935: name=category_id。\",\n936:         \"error_branch_ids\": [\n937:           \"html.bookmark_save.category.empty\",\n938:           \"html.bookmark_save.category.whitespace\",\n939:           \"html.bookmark_save.category.overlong_121\",\n940:           \"html.bookmark_move.category_id.omitted\",\n941:           \"html.bookmark_move.category_id.empty\",\n942:           \"html.bookmark_move.category_id.unknown_id\",\n943:           \"json.bookmark_save.category.empty\",\n944:           \"json.bookmark_save.category.whitespace\",\n945:           \"json.bookmark_save.category.overlong_121\",\n946:           \"json.bookmark_move.category.empty\",\n947:           \"json.bookmark_move.category.whitespace\",\n948:           \"json.bookmark_move.category.overlong_121\",\n949:           \"json.bookmark_move.category.omitted\",\n950:           \"json.bookmark_move.category.null\"\n951:         ],\n952:         \"failure\": \"空/超长/非法归类 400 invalid_category，未知 record_id 404 not_found；不移动、不写入。\",\n953:         \"feature_id\": \"F04\",\n954:         \"navigation\": \"成功后 303 到 /?category=<目标归类> 或来源视图。\",\n955:         \"recovery\": \"保留选择并显示 form-error；用户改选有效归类或返回列表重试。\",\n956:         \"success_state\": \"303 回列表；记录离开原归类并出现在目标归类，JSON 的 category 与持久化结果一致。\"\n957:       },\n958:       {\n959:         \"acceptance_ids\": [\n960:           \"A06\"\n961:         ],\n962:         \"action\": \"点击归类链接或从搜索表单选择归类并查看列表。\",\n963:         \"design_basis\": \"场景验收 4：用户通过归类浏览找回记录；来源标签计数被调整为按归类聚合。\",\n964:         \"entry\": \"首页侧栏 [data-testid=category-count][data-category-id] 与归类链接；/categories 同显计数；GET /?category=<name>。\",\n965:         \"failure\": \"未知归类返回空结果而非 5xx；计数查询失败显示错误页。\",\n966:         \"feature_id\": \"F05\",\n967:         \"navigation\": \"GET /?category=... 或 GET /categories；无记录时显示明确空状态。\",\n968:         \"recovery\": \"选择其他归类或清空筛选。\",\n969:         \"success_state\": \"页面只列该归类活动记录；HTML count 与 JSON count 都等于活动（未软删）记录数；移动、删除、恢复后仍一致。\"\n970:       },\n971:       {\n972:         \"acceptance_ids\": [\n973:           \"A07\"\n974:         ],\n975:         \"action\": \"选择归类、输入关键字并提交。\",\n976:         \"design_basis\": \"场景验收 4：用户凭记得的关键字找回已存链接；来源仅搜标题，目标扩展到可识别来源的字段。\",\n977:         \"entry\": \"首页 form[data-testid=category-search-form]，字段 category（归类名）与 q；action 为 GET /。\",\n978:         \"failure\": \"无匹配不是错误（200 + 空结果）；非法请求返回可读错误且不写入。\",\n979:         \"feature_id\": \"F06\",\n980:         \"navigation\": \"GET /?category=...&q=...，同一页面更新结果。\",\n981:         \"recovery\": \"修改 q 或切换归类重新提交；清空 q 恢复归类浏览。\",\n982:         \"success_state\": \"URL 与表单保留 category 与 q；页面显示所选归类、保留查询和匹配行；同一关键字在两个归类分别命中各自记录；无匹配显示明确空结果；JSON 返回匹配集。\"\n983:       },\n984:       {\n985:         \"acceptance_ids\": [\n986:           \"A08\"\n987:         ],\n988:         \"action\": \"用户点击打开链接。\",\n989:         \"design_basis\": \"场景验收 2 与 workflow 5：打开记录即回到保存时的外部网页，库只保证引用而非内容。\",\n990:         \"entry\": \"记录行 a[data-testid=record-open-link] 与 GET /go/{id}。\",\n991:         \"failure\": \"未知 id 404 not_found；目标不可达不影响库中记录可读。\",\n992:         \"feature_id\": \"F07\",\n993:         \"navigation\": \"浏览器导航到原始 URL（新标签）；服务端只发 302。\",\n994:         \"recovery\": \"返回收藏列表选择其他记录；如 URL 有误，可由现有 PATCH API 更新并重算 hostname。\",\n995:         \"success_state\": \"链接 href 恰为保存时原始 URL，target=_blank、rel 含 noopener；GET /go/{id} 302 Location 为同一字符串；P0 不请求目标页。\"\n996:       },\n997:       {\n998:         \"acceptance_ids\": [\n999:           \"A01\",\n1000:           \"A05\",\n1001:           \"A09\"\n1002:         ],\n1003:         \"action\": \"执行真实写操作，停止应用进程，再以同一实例目录重启并读取。\",\n1004:         \"design_basis\": \"场景验收 1：主动保存的链接在多次会话之间持久保留；目标以 SQLite 实现本地单用户持久化。\",\n1005:         \"entry\": \"保存、移动、删除/恢复等写操作后重新请求页面；重启适配器从同一 app_root 与实例数据目录启动。\",\n1006:         \"failure\": \"数据库不可写或损坏时返回明确 5xx 错误页而非成功假象；事务回滚保持旧状态。\",\n1007:         \"feature_id\": \"F08\",\n1008:         \"navigation\": \"无自动导航；下次 GET / 读取持久状态。\",\n1009:         \"recovery\": \"恢复可写数据目录后重试；重启应用重新初始化 schema。\",\n1010:         \"success_state\": \"重启后 id、原始 URL、标题、描述、归类与 trashed 状态与写入后一致；HTML 与 JSON 都来自 SQLite。\"\n1011:       },\n1012:       {\n1013:         \"acceptance_ids\": [\n1014:           \"A09\"\n1015:         ],\n1016:         \"action\": \"提交 record_id 软删除；在回收站提交 record_id 恢复。\",\n1017:         \"design_basis\": \"场景要求可恢复的失败；来源仅有归档记录的瞬时 Undo，目标改为显式软删除与恢复。\",\n1018:         \"entry\": \"记录行 form[data-testid=record-delete-form]；GET /?trash=1 的软删记录行 form[data-testid=record-restore-form]。\",\n1019:         \"failure\": \"未知 record_id 404 not_found；失败不改变 trashed_at，不产生 5xx。\",\n1020:         \"feature_id\": \"F09\",\n1021:         \"navigation\": \"删除成功 303 到 /?trash=1；恢复成功 303 到恢复后归类。\",\n1022:         \"recovery\": \"回收站提供可提交的恢复表单；失败可重试或返回列表。\",\n1023:         \"success_state\": \"默认视图与计数排除软删记录，回收站仍显示；恢复后原始字段与归类回归并重新可见；归类删除后软删记录仍在「未整理」可恢复。\"\n1024:       },\n1025:       {\n1026:         \"acceptance_ids\": [\n1027:           \"A02\",\n1028:           \"A10\",\n1029:           \"A12\"\n1030:         ],\n1031:         \"action\": \"提交非法 URL、空/超长/非法归类、畸形 JSON 或未知 ID。\",\n1032:         \"design_basis\": \"场景要求非法输入可恢复；源表单校验被调整为服务端 HTML 表单与 JSON API 共用的显式错误合同。\",\n1033:         \"entry\": \"所有 HTML 表单（保存、归类、移动、删除、恢复、搜索）与 JSON API 端点。\",\n1034:         \"error_branch_ids\": [\n1035:           \"html.bookmark_save.category.empty\",\n1036:           \"html.bookmark_save.category.whitespace\",\n1037:           \"html.bookmark_save.category.overlong_121\",\n1038:           \"html.bookmark_move.category_id.omitted\",\n1039:           \"html.bookmark_move.category_id.empty\",\n1040:           \"html.bookmark_move.category_id.unknown_id\",\n1041:           \"json.bookmark_save.category.empty\",\n1042:           \"json.bookmark_save.category.whitespace\",\n1043:           \"json.bookmark_save.category.overlong_121\",\n1044:           \"json.bookmark_move.category.empty\",\n1045:           \"json.bookmark_move.category.whitespace\",\n1046:           \"json.bookmark_move.category.overlong_121\",\n1047:           \"json.bookmark_move.category.omitted\",\n1048:           \"json.bookmark_move.category.null\"\n1049:         ],\n1050:         \"failure\": \"出现 5xx、静默写入或不可恢复的错误页即视为失败。\",\n1051:         \"feature_id\": \"F10\",\n1052:         \"navigation\": \"HTML 错误留在当前表单页并保留输入；JSON 无导航。\",\n1053:         \"recovery\": \"修正字段后重新提交；失败页保留可运行的表单或返回链接。\",\n1054:         \"success_state\": \"错误路径本身成功执行：JSON 返回 400/404/409 与结构化错误码，HTML 返回 400/409 与 form-error；畸形 JSON 为 bad_request；均无\n1055: 5xx、无写入。\"\n1056:       },\n1057:       {\n1058:         \"acceptance_ids\": [\n1059:           \"A11\"\n1060:         ],\n1061:         \"action\": \"首启或空库时打开首页。\",\n1062:         \"design_basis\": \"场景是单用户本地工具，需要可打开的应用入口；目标采用 Python 服务端渲染外壳而非来源 SPA。\",\n1063:         \"entry\": \"GET / 与 GET /api/health。\",\n1064:         \"failure\": \"健康检查非 200/非 JSON、首页 5xx 或缺少表单时显式失败。\",\n1065:         \"feature_id\": \"F11\",\n1066:         \"navigation\": \"无自动导航（首页即入口）；可进入 /categories 或归类筛选。\",\n1067:         \"recovery\": \"启动或重启应用；修复后刷新首页。\",\n1068:         \"success_state\": \"200 text/html；含保存表单 name=url、归类管理链接、记录列表/空状态容器；预置归类与空库不报错；health 200 JSON。\"\n1069:       }\n1070:     ],\n1071:     \"review_rules_version\": \"atlas.current-required-contract.v1\",\n1072:     \"schema\": \"atlas.contract-coverage.v1\"\n1073:   },\n1074:   \"decisions\": [\n1075:     {\n1076:       \"default\": \"单选归类（bookmark.category_id 标量外键）。场景流程明确“选择一个简单归类”，单归属让移动、计数与浏览语义无歧义；未来若需多值可迁移到关联表而不丢数据。\",\n1077:       \"id\": \"D01\",\n1078:       \"impact\": \"决定数据模型（标量外键 vs 关联表）以及浏览、计数与检索的实现路径。\",\n1079:       \"question\": \"记录应归属于单一“归类”，还是允许像标签一样同时属于多个？\",\n1080:       \"status\": \"decided\",\n1081:       \"when_to_ask\": \"当真实用户反馈同一条记录必须同时属于多个主题，或需要跨主题交叉检索时再评估多标签。\"\n1082:     },\n1083:     {\n[Output truncated. Continue reading with offset: 1084]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file /Users/milin/2026/软件开发/application-atlas/application-atlas-production-pack/atlas/template-factory/jobs/job_7742b1c124be4c9ab3a0096da5cdd772/attempt-3/blueprint-spec-review-0-bbc43771a1bbbe99-runtime_protocol-v1/source/DRAFT.md, lines 1-1083\n1: {\n2:   \"acceptance\": [\n3:     {\n4:       \"features\": [\n5:         \"F01\",\n6:         \"F08\"\n7:       ],\n8:       \"goal\": \"保存一条链接后，同进程与重启后的新进程都能读到该记录，且 id 与内容稳定。\",\n9:       \"id\": \"A01\",\n10:       \"implementation\": \"acceptance/p0_library.py\",\n11:       \"phase\": \"P0\",\n12:       \"status\": \"not_run\",\n13:       \"type\": \"positive\"\n14:     },\n15:     {\n16:       \"features\": [\n17:         \"F01\",\n18:         \"F10\"\n19:       ],\n20:       \"goal\": \"保存表单与 JSON 均接受绝对可解析的 http/https URL（含单标签主机，如 http://localhost）并保留原始字符串；缺协议、非 http/https、空/非法 hostname\n21: 被拒绝为 400 invalid_url，且库中不新增记录。\",\n22:       \"id\": \"A02\",\n23:       \"implementation\": \"acceptance/p0_library.py\",\n24:       \"phase\": \"P0\",\n25:       \"status\": \"not_run\",\n26:       \"type\": \"negative\"\n27:     },\n28:     {\n29:       \"features\": [\n30:         \"F01\",\n31:         \"F02\"\n32:       ],\n33:       \"goal\": \"不选归类保存时记录落入“未整理”，保存时给出的新归类名被自动创建，首启可见预置归类。\",\n34:       \"id\": \"A03\",\n35:       \"implementation\": \"acceptance/p0_library.py\",\n36:       \"phase\": \"P0\",\n37:       \"status\": \"not_run\",\n38:       \"type\": \"positive\"\n39:     },\n40:     {\n41:       \"features\": [\n42:         \"F03\"\n43:       ],\n44:       \"goal\": \"通过真实归类页表单完成新建、重命名、删除：重名、非法名与默认归类保护给出可读 form-error 且不改数据；删除归类后活动与软删除记录都迁回“未整理”，软删记录仍可恢复。 新建与重命名各自通过 HTML 和\n45: JSON 验证 name 省略、空字符串、纯空白和 121 字符（JSON 另测 null）均为 400 invalid_name；保留全部重名、保护、迁移与恢复断言。\",\n46:       \"id\": \"A04\",\n47:       \"implementation\": \"acceptance/p0_organize.py\",\n48:       \"phase\": \"P0\",\n49:       \"status\": \"not_run\",\n50:       \"type\": \"positive\"\n51:     },\n52:     {\n53:       \"features\": [\n54:         \"F04\",\n55:         \"F08\"\n56:       ],\n57:       \"goal\": \"在给定的 base_url 目标把记录从“未整理”移动到另一归类，并用独立实例证明该归属跨重启仍然有效。\",\n58:       \"id\": \"A05\",\n59:       \"implementation\": \"acceptance/p0_organize.py\",\n60:       \"phase\": \"P0\",\n61:       \"status\": \"not_run\",\n62:       \"type\": \"positive\"\n63:     },\n64:     {\n65:       \"features\": [\n66:         \"F05\"\n67:       ],\n68:       \"goal\": \"通过真实归类页/记录表单浏览与计数：侧栏与接口的 count 只计活动记录，并在移动、软删除、恢复后与实际列表和 JSON 保持一致。\",\n69:       \"id\": \"A06\",\n70:       \"implementation\": \"acceptance/p0_organize.py\",\n71:       \"phase\": \"P0\",\n72:       \"status\": \"not_run\",\n73:       \"type\": \"positive\"\n74:     },\n75:     {\n76:       \"features\": [\n77:         \"F06\"\n78:       ],\n79:       \"goal\": \"从真实归类页提交 category 与 q：页面保留所选归类与查询并显示匹配/明确空结果；同一关键字在两个归类分别命中各自记录，且 JSON 检索仍覆盖标题、域名与描述、大小写不敏感。\",\n80:       \"id\": \"A07\",\n81:       \"implementation\": \"acceptance/p0_find_open.py\",\n82:       \"phase\": \"P0\",\n83:       \"status\": \"not_run\",\n84:       \"type\": \"positive\"\n85:     },\n86:     {\n87:       \"features\": [\n88:         \"F07\"\n89:       ],\n90:       \"goal\": \"打开记录跳转到保存时的原始 URL（302 Location 等于保存值），未知 id 返回 404。\",\n91:       \"id\": \"A08\",\n92:       \"implementation\": \"acceptance/p0_find_open.py\",\n93:       \"phase\": \"P0\",\n94:       \"status\": \"not_run\",\n95:       \"type\": \"positive\"\n96:     },\n97:     {\n98:       \"features\": [\n99:         \"F08\",\n100:         \"F09\"\n101:       ],\n102:       \"goal\": \"通过真实记录表单软删除并恢复：默认视图排除、回收站可见、恢复后字段与归类回归；删除归类时软删记录迁回“未整理”仍可恢复，且删除状态跨重启保持。\",\n103:       \"id\": \"A09\",\n104:       \"implementation\": \"acceptance/p0_recovery.py\",\n105:       \"phase\": \"P0\",\n106:       \"status\": \"not_run\",\n107:       \"type\": \"positive\"\n108:     },\n109:     {\n110:       \"features\": [\n111:         \"F10\"\n112:       ],\n113:       \"goal\": \"未知 id 与畸形 JSON 返回结构化错误（bad_request/not_found）且不产生 5xx、不改变数据；真实表单的非法 URL 显示可读 form-error、保留输入，并在修正后成功保存。\",\n114:       \"id\": \"A10\",\n115:       \"implementation\": \"acceptance/p0_recovery.py\",\n116:       \"phase\": \"P0\",\n117:       \"status\": \"not_run\",\n118:       \"type\": \"negative\"\n119:     },\n120:     {\n121:       \"features\": [\n122:         \"F11\"\n123:       ],\n124:       \"goal\": \"健康检查返回就绪，首页外壳在空库下渲染录入表单与列表容器，入口不报错。\",\n125:       \"id\": \"A11\",\n126:       \"implementation\": \"acceptance/p0_library.py\",\n127:       \"phase\": \"P0\",\n128:       \"status\": \"not_run\",\n129:       \"type\": \"positive\"\n130:     },\n131:     {\n132:       \"features\": [\n133:         \"F04\",\n134:         \"F10\"\n135:       ],\n136:       \"goal\": \"仅验证书签保存与移动的非法归类：HTML 保存使用归类名 category，HTML 移动使用归类 ID category_id；JSON 保存/移动使用归类名 category。非法归类 400\n137: invalid_category，HTML 显示可读 form-error 并保留提交值，JSON 返回结构化错误；归类集合、记录集合与被移动记录归属均不变。保存省略 category（JSON 另含\n138: null）进入未整理，不作为非法值；移动省略值/JSON null、显式空值/纯空白/超长归类名，以及 HTML 移动空/未知 category_id 为非法。有效新归类名保存或 JSON 移动时自动创建，不把未知 ID\n139: 当作名称。分类创建/重命名 name 的 invalid_name 分支仅属 A04。\",\n140:       \"id\": \"A12\",\n141:       \"implementation\": \"acceptance/p0_organize.py\",\n142:       \"phase\": \"P0\",\n143:       \"status\": \"not_run\",\n144:       \"type\": \"negative\"\n145:     },\n146:     {\n147:       \"features\": [\n148:         \"F12\"\n149:       ],\n150:       \"goal\": \"外部网络不可用时保存仍然成功，图标与标题降级为本地派生结果，缺失增强不阻塞或报错。\",\n151:       \"id\": \"A13\",\n152:       \"implementation\": \"acceptance/p1_maturity.py\",\n153:       \"phase\": \"P1\",\n154:       \"status\": \"not_run\",\n155:       \"type\": \"positive\"\n156:     },\n157:     {\n158:       \"features\": [\n159:         \"F13\"\n160:       ],\n161:       \"goal\": \"导出为浏览器书签 HTML 可包含已存记录，且导入该 HTML 后相应记录可再次检索到。\",\n162:       \"id\": \"A14\",\n163:       \"implementation\": \"acceptance/p1_maturity.py\",\n164:       \"phase\": \"P1\",\n165:       \"status\": \"not_run\",\n166:       \"type\": \"positive\"\n167:     },\n168:     {\n169:       \"features\": [\n170:         \"F14\"\n171:       ],\n172:       \"goal\": \"重复 URL 默认被拒绝（409 duplicate_url）且库不变；显式允许重复时可新增第二条。\",\n173:       \"id\": \"A15\",\n174:       \"implementation\": \"acceptance/p1_maturity.py\",\n175:       \"phase\": \"P1\",\n176:       \"status\": \"not_run\",\n177:       \"type\": \"negative\"\n178:     }\n179:   ],\n180:   \"architecture_markdown\": \"# 架构与契约\\n\\n## 默认技术栈与理由\\n\\n- 交付 profile：python-web。Python 3.12\n181: 标准库（http.server、sqlite3、urllib、json、html.parser），零第三方依赖；服务端渲染 HTML 表单，JSON API 与 HTML 适配器共用同一服务层。\\n- 备选 Flask/FastAPI\n182: 需安装依赖；Node + IndexedDB/SPA 需 npm/浏览器工具且把数据放在浏览器 profile。二者与离线、可独立验收、单用户本地库的约束冲突，故不采用。\\n- 数据文件位于应用 `--data-\n183: dir/bookmarks.sqlite3`；验收的每实例隔离目录由测试适配器创建，测试者 `--data-dir` 根目录不是应用数据库。\\n- 单用户、本地优先；无认证、无云同步。日常绑定 127.0.0.1；仅隔离验收网络使用\n184: 0.0.0.0。\\n\\n## 数据模型（SQLite）\\n\\n- `schema_meta(version INTEGER)`：迁移版本单行。启动时在一个事务内创建/升级 schema，v1\n185: 建表并写入预置归类；版本演进只通过事务化迁移，不回退、不依赖客户端存储。\\n- `categories(id TEXT PRIMARY KEY, name TEXT NOT NULL UNIQUE COLLATE NOCASE,\n186: is_default INTEGER NOT NULL DEFAULT 0, position INTEGER NOT NULL, created_at INTEGER NOT\n187: NULL)`：首启预置「未整理」(is_default=1)、「待购」、「家居改造」、「以后看看」。\\n- `bookmarks(id TEXT PRIMARY KEY, url TEXT NOT NULL, hostname TEXT\n188: NOT NULL, title TEXT NULL, description TEXT NULL, category_id TEXT NOT NULL REFERENCES categories(id), favicon_url TEXT\n189: NULL, created_at INTEGER NOT NULL, updated_at INTEGER NOT NULL, trashed_at INTEGER NULL)`。\\n-\n190: 索引：category_id、created_at、hostname；url 不设唯一索引。P1/F14 的重复检测由服务层查询活动记录完成；P0 不启用重复拒绝。\\n- trashed_at 为 NULL 表示活动记录；非 NULL\n191: 为软删除。默认列表与计数只统计 trashed_at IS NULL；恢复清空 trashed_at。删除归类在单一事务内把该归类下的活动记录与软删除记录都改到默认归类，因此恢复不会产生无归类记录。\\n- 排序固定为 created_at\n192: DESC、id ASC；category 与 q 只作请求参数，不落库。\\n\\n## URL 策略\\n\\n- 记录 URL 必须是绝对、可解析的 HTTP(S) URL，且 hostname 有效且非空。单标签主机（如\n193: http://localhost）与 IP 字面量均有效；不做 DNS 查询、可达性检查或目标页抓取。\\n- 保存与打开都保留用户提交的原始字符串（不补斜杠、不改大小写、不重写路径）；hostname 由解析结果派生。若 PATCH 更新\n194: URL，必须用新 URL 重新派生 hostname。\\n- 拒绝：缺少 scheme、非 http/https、缺少/非法 hostname、无法解析的字符串；返回 400 invalid_url 且不写入。\\n- 上游 S04\n195: 的点域名正则与 S08 getHostname 是源观察，映射为 adjusted：点不是通用 URL 有效性要求；target 采用上述解析策略。\\n- 保存、打开、抓取三者分离：P0 保存与列表均不请求目标页；打开只产生浏览器导航或\n196: /go 302。\\n\\n## API、错误与状态合同\\n\\n- `GET /api/health` → 200 JSON，含就绪与 schema 版本。\\n- `GET /api/categories` → 200 数组，每项\n197: id、name、count、is_default；count 只计活动记录。\\n- `POST /api/categories` name → 201；重名 409 duplicate_category；空名或超过 120 字符 400\n198: invalid_name。\\n- `PATCH /api/categories/{id}` name → 200；同上校验；默认归类 400 protected_category。`DELETE /api/categories/{id}`\n199: → 200；默认归类 400 protected_category；否则事务内把活动与软删记录迁到默认归类。\\n- `GET\n200: /api/bookmarks?category=<name|id>&q=<str>&include_trashed=0|1` → 200 数组；默认排序 created_at DESC、id ASC；q\n201: 对标题、hostname、描述做大小写不敏感子串匹配并与 category 叠加；未知归类返回空数组。\\n- `POST /api/bookmarks` url 必填，title、description、category\n202: 可选，allow_duplicate 为 P1；201；category 省略/null 时归入默认「未整理」；显式空字符串或超过 120 字符 400 invalid_category；新名称按 NOCASE 自动创建并复用；非法 URL\n203: 400 invalid_url；P1 重复 409 duplicate_url 且附 existing_id。\\n- `GET /api/bookmarks/{id}` 200 或 404 not_found；`PATCH`\n204: 更新字段；URL 变化时重算 hostname；非法 URL 400 invalid_url，非法归类 400 invalid_category；P1 重复 409 duplicate_url。`POST\n205: /api/bookmarks/{id}/move` body category 必填；省略/空/超长 400 invalid_category；新名称自动创建。`DELETE /api/bookmarks/{id}` 软删除\n206: 200；`POST /api/bookmarks/{id}/restore` 恢复；P1 同 URL 活动冲突 409 duplicate_url 且不改数据。\\n- `GET /go/{id}` 302，Location 为保存时原始\n207: URL；未知 id 404 not_found。HTML 打开链接使用原始 URL，target=_blank、rel=noopener。\\n- P1：`GET /api/export` Netscape HTML；`POST\n208: /api/import` 同格式，返回 imported/skipped。\\n- 错误合同：JSON 失败返回 `{error:{code,message,field}}`；通用 bad_request（畸形/不可解析 JSON，400）、\n209: invalid_url、invalid_category、invalid_name、not_found、duplicate_category、protected_category、duplicate_url。校验错误不产生\n210: 5xx，不产生部分写入；畸形 JSON 一律 bad_request 且不写。\\n- 状态合同：GET 幂等；写操作事务化；校验失败保持提交前状态；分类与 q 为视图状态；删除与恢复改变 trashed_at 但不删除行。\\n\\n##\n211: UI/HTML 适配器合同（供真实表单验收与独立浏览器执行者）\\n\\n- `GET /`：保存表单 `form[action=/bookmarks/new]`（method=post，字段\n212: url/title/description/category；category 预填「未整理」）；`a[data-testid=category-manager]` 指向 /categories；`form[data-\n213: testid=category-search-form]` 为 GET /，含 select 或 input name=category（归类名）与 input name=q；记录行 `tr[data-testid=record-\n214: row][data-record-id]`；打开链接 `a[data-testid=record-open-link]` 的 href 必须等于保存时原始 URL，target=_blank，rel 含 noopener；每行含\n215: `form[data-testid=record-move-form]`（input record_id、select name=category_id，值为 API 归类 ID）、`form[data-testid=record-\n216: delete-form]`（input record_id）；回收站或 `GET /?trash=1` 的软删记录行含 `form[data-testid=record-restore-form]`（input record_id）。\\n-\n217: `GET /categories`：`form[data-testid=category-create-form]`（input name）、`form[data-testid=category-rename-form]`（input\n218: category_id、name）、`form[data-testid=category-delete-form]`（input category_id）；每个归类行/侧栏计数为 `[data-testid=category-\n219: count][data-category-id=...]`，只显示活动记录数；归类名/计数与 JSON 一致。\\n- 表单成功：save 303 到 /?category=...；move 303 到目标归类；delete 303 到\n220: /?trash=1；restore 303 到恢复后归类；category create/rename/delete 303 到 /categories。失败：400/409 渲染当前页，含 `[data-testid=form-\n221: error]` 可读消息，保留 url/title/description/category/name/category_id/record_id 中已提交的值，并保留可重新提交的表单；不得 5xx 或写入。\\n- 归类搜索：提交\n222: category 与 q，成功后 URL 与表单同时保留两者；页面显示所选归类、保留的查询和匹配行；同一关键字在两个归类分别得到各自结果；某归类无匹配时显示明确空结果，不是错误。\\n- 记录移动由 HTML 适配器把 category_id\n223: 翻译成归类名，再调用现有 move 服务；归类删除仍按 API 事务迁移活动与软删记录。默认归类不可重命名/删除。\\n- P0 不提供孤立的记录编辑界面；仅保留 PATCH /api/bookmarks/{id} 的现有 URL\n224: 更新合同（URL 变化重算 hostname）。打开链接的实际导航目标由 href 与 /go 302 双重验证，不抓取目标页。\\n\\n## 验收适配器合同\\n\\n- 全部程序使用 `--base-url` 指向真实 python-web\n225: 目标；A01/A05/A09 另需 `--app-root` 与 `--data-dir`，A14 需 `--data-dir`。\\n- `--app-root` 只读；`--data-dir` 是测试者草稿根。重启用例通过\n226: common.launch_app 在同一 `--data-dir/instances/<id>` 上启动 `app/serve.py`，真实写入、SIGTERM、同一目录重启并读回；健康检查不是重启证据。\\n- HTML 用例以标准库\n227: urllib 提交 application/x-www-form-urlencoded 表单并解析响应 HTML 的 data-testid、表单字段、链接与文本；不以 API 调用代替声明的 HTML 表单，不驱动\n228: JS/DOM。独立浏览器执行者可复用同一契约。\\n- 所有请求限定在 base_url 精确 origin；/go 不跟随重定向；不请求保存的外链、元数据或 favicon；不附加凭据；目标要求认证时显式报告基础设施未就绪。\\n-\n229: 结果：stdout 单个 atlas.acceptance-result.v1 JSON；断言失败或基础设施错误 exit nonzero；不声称已运行。\\n\\n## 非功能需求\\n\\n-\n230: 离线可用：保存/浏览/检索不依赖外部服务；不设置外部抓取为 P0 要求。\\n- 数据完整性：写事务化；归类删除与恢复保持引用完整；校验失败零写入。\\n- 确定性：排序、错误码、重定向稳定；GET 幂等。\\n- 可访问/可测试：语义化\n231: HTML、表单 label 或 aria、稳定 data-testid；服务端输出 UTF-8。\\n- 单用户本机：无认证；日常 127.0.0.1，0.0.0.0 仅隔离验收网络。\\n-\n232: 不设未经验证的时延/吞吐/成本目标；只要求请求可顺序处理。\\n\\n## 边界与限制\\n\\n- 不实现云同步、多设备、协作、分享、浏览器扩展/移动分享目标。\\n- 不保存网页副本、不抓取正文、不做失效链接检测（F17/F18）。\\n-\n233: 不引入置顶/归档/多排序/复制 URL/访问计数（F20/F23/F24）。\\n- 归类为扁平单选；嵌套/标签属后期（F19/D12）。\\n- P0 不做重复拒绝；F14/A15 保持 P1。\\n- 第三方元数据/图标仅 P1\n234: 可选增强，失败不影响保存；离线验收不验证其可达性。\\n\\n## A04/A12 分类输入澄清（本次受限修订）\\n\\n- A04 仅分类管理：HTML create/rename 表单的 name 与 JSON create/rename 的\n235: name 同为归类名称；省略、空字符串、纯空白、121 字符均 400 invalid_name，JSON 显式 null 同样 invalid_name。既有重名 duplicate_category、默认分类\n236: protected_category、删除迁移/恢复均保留。\\n- A12 仅书签保存和移动，不将分类管理 name 校验混为 invalid_category。HTML 保存使用名称 category；省略时未整理，显式空/纯空白/121\n237: 字符为 400 invalid_category。HTML 无 JSON null 这种原生值，不能把字面字符串 null 当 JSON null。\\n- JSON 保存使用名称 category；省略或显式 null\n238: 均默认未整理，显式空/纯空白/121 字符为 invalid_category。JSON move 的名称 category 必填；省略、null、空/纯空白/121 字符为\n239: invalid_category。有效新名称可自动创建并复用，未知名称不等于非法 ID。\\n- HTML move 使用 category_id（API 已有分类 ID），必须解析为已有名称再调用服务；省略、空或未知 ID 为\n240: invalid_category，不能把未知 ID 当新名称创建。JSON 保存/move 合同不新增 category_id 字段；GET category 未知值的空结果语义不改。\\n- 错误分支一律零写入：HTML 400、form-\n241: error 可读、保留已提交字段并提供可重试表单；JSON 400、error.code/message/field，无导航。成功流程、303 导航、阶段、能力与既有断言意图保留。\\n- 搜索仍仅对\n242: title、hostname、description 做大小写不敏感子串匹配，并叠加分类；不扩展为 URL 全文、分类名或标签检索。此处对齐目标设计，不更改案例来源观察。\\n\",\n243:   \"confirmed_scenario\": {\n244:     \"acceptance\": [\n245:       \"用户主动保存的链接在多次会话之间持久保留，形成不断增长的个人收藏\",\n246:       \"每条记录都以 URL 锚定到外部网页，打开记录即跳转到该页面\",\n247:       \"用户可以在归类之间移动记录或新建归类，操作结果在重新打开后仍然有效\",\n248:       \"通过归类浏览或关键字检索，用户能找到此前存入的特定链接\"\n249:     ],\n250:     \"audience\": \"习惯先把感兴趣的网页存起来、之后再回头处理的普通网络用户\",\n251:     \"id\": \"scn_7756e0007f6a463a97316f3f49c15248\",\n252:     \"leaf\": \"bookmark-manager\",\n253:     \"leaf_name\": \"书签管理器\",\n254:     \"name\": \"生活待购与灵感收藏夹\",\n255:     \"objective\": \"把偶然看到但当下不处理的外部网页链接留存，日后需要时能重新找到并回到原页面\",\n256:     \"revision\": 2,\n257:     \"status\": \"ready\",\n258:     \"updated_at\": \"2026-10-16T14:18:20.407897+00:00\",\n259:     \"workflow\": [\n260:       \"用户在浏览时看到想记住的商品页、教程或灵感图片，主动保存该链接\",\n261:       \"保存时选择一个简单归类，如“待购”“家居改造”或“以后看看”\",\n262:       \"未经整理的链接可先进入默认归类，之后再手动移动到更合适的位置\",\n263:       \"用户在需要实际处理时打开个人库，浏览或检索相关归类\",\n264:       \"用户从记录打开链接，回到原始网页继续购买、阅读或参考\"\n265:     ]\n266:   },\n267:   \"contract_coverage\": {\n268:     \"error_contract\": {\n269:       \"branches\": [\n270:         {\n271:           \"acceptance_ids\": [\n272:             \"A04\"\n273:           ],\n274:           \"code\": \"invalid_name\",\n275:           \"feature_ids\": [\n276:             \"F03\"\n277:           ],\n278:           \"field\": \"name\",\n279:           \"id\": \"html.category_create.name.omitted\",\n280:           \"implementation\": \"acceptance/p0_organize.py\",\n281:           \"operation\": \"category_create\",\n282:           \"response\": \"form-error and submitted values retained\",\n283:           \"status\": 400,\n284:           \"transport\": \"html\",\n285:           \"value_kind\": \"omitted\",\n286:           \"write_effect\": \"none\"\n287:         },\n288:         {\n289:           \"acceptance_ids\": [\n290:             \"A04\"\n291:           ],\n292:           \"code\": \"invalid_name\",\n293:           \"feature_ids\": [\n294:             \"F03\"\n295:           ],\n296:           \"field\": \"name\",\n297:           \"id\": \"html.category_create.name.empty\",\n298:           \"implementation\": \"acceptance/p0_organize.py\",\n299:           \"operation\": \"category_create\",\n300:           \"response\": \"form-error and submitted values retained\",\n301:           \"status\": 400,\n302:           \"transport\": \"html\",\n303:           \"value_kind\": \"empty\",\n304:           \"write_effect\": \"none\"\n305:         },\n306:         {\n307:           \"acceptance_ids\": [\n308:             \"A04\"\n309:           ],\n310:           \"code\": \"invalid_name\",\n311:           \"feature_ids\": [\n312:             \"F03\"\n313:           ],\n314:           \"field\": \"name\",\n315:           \"id\": \"html.category_create.name.whitespace\",\n316:           \"implementation\": \"acceptance/p0_organize.py\",\n317:           \"operation\": \"category_create\",\n318:           \"response\": \"form-error and submitted values retained\",\n319:           \"status\": 400,\n320:           \"transport\": \"html\",\n321:           \"value_kind\": \"whitespace\",\n322:           \"write_effect\": \"none\"\n323:         },\n324:         {\n325:           \"acceptance_ids\": [\n326:             \"A04\"\n327:           ],\n328:           \"code\": \"invalid_name\",\n329:           \"feature_ids\": [\n330:             \"F03\"\n331:           ],\n332:           \"field\": \"name\",\n333:           \"id\": \"html.category_create.name.overlong_121\",\n334:           \"implementation\": \"acceptance/p0_organize.py\",\n335:           \"operation\": \"category_create\",\n336:           \"response\": \"form-error and submitted values retained\",\n337:           \"status\": 400,\n338:           \"transport\": \"html\",\n339:           \"value_kind\": \"overlong_121\",\n340:           \"write_effect\": \"none\"\n341:         },\n342:         {\n343:           \"acceptance_ids\": [\n344:             \"A04\"\n345:           ],\n346:           \"code\": \"invalid_name\",\n347:           \"feature_ids\": [\n348:             \"F03\"\n349:           ],\n350:           \"field\": \"name\",\n351:           \"id\": \"html.category_rename.name.omitted\",\n352:           \"implementation\": \"acceptance/p0_organize.py\",\n353:           \"operation\": \"category_rename\",\n354:           \"response\": \"form-error and submitted values retained\",\n355:           \"status\": 400,\n356:           \"transport\": \"html\",\n357:           \"value_kind\": \"omitted\",\n358:           \"write_effect\": \"none\"\n359:         },\n360:         {\n361:           \"acceptance_ids\": [\n362:             \"A04\"\n363:           ],\n364:           \"code\": \"invalid_name\",\n365:           \"feature_ids\": [\n366:             \"F03\"\n367:           ],\n368:           \"field\": \"name\",\n369:           \"id\": \"html.category_rename.name.empty\",\n370:           \"implementation\": \"acceptance/p0_organize.py\",\n371:           \"operation\": \"category_rename\",\n372:           \"response\": \"form-error and submitted values retained\",\n373:           \"status\": 400,\n374:           \"transport\": \"html\",\n375:           \"value_kind\": \"empty\",\n376:           \"write_effect\": \"none\"\n377:         },\n378:         {\n379:           \"acceptance_ids\": [\n380:             \"A04\"\n381:           ],\n382:           \"code\": \"invalid_name\",\n383:           \"feature_ids\": [\n384:             \"F03\"\n385:           ],\n386:           \"field\": \"name\",\n387:           \"id\": \"html.category_rename.name.whitespace\",\n388:           \"implementation\": \"acceptance/p0_organize.py\",\n389:           \"operation\": \"category_rename\",\n390:           \"response\": \"form-error and submitted values retained\",\n391:           \"status\": 400,\n392:           \"transport\": \"html\",\n393:           \"value_kind\": \"whitespace\",\n394:           \"write_effect\": \"none\"\n395:         },\n396:         {\n397:           \"acceptance_ids\": [\n398:             \"A04\"\n399:           ],\n400:           \"code\": \"invalid_name\",\n401:           \"feature_ids\": [\n402:             \"F03\"\n403:           ],\n404:           \"field\": \"name\",\n405:           \"id\": \"html.category_rename.name.overlong_121\",\n406:           \"implementation\": \"acceptance/p0_organize.py\",\n407:           \"operation\": \"category_rename\",\n408:           \"response\": \"form-error and submitted values retained\",\n409:           \"status\": 400,\n410:           \"transport\": \"html\",\n411:           \"value_kind\": \"overlong_121\",\n412:           \"write_effect\": \"none\"\n413:         },\n414:         {\n415:           \"acceptance_ids\": [\n416:             \"A12\"\n417:           ],\n418:           \"code\": \"invalid_category\",\n419:           \"feature_ids\": [\n420:             \"F04\",\n421:             \"F10\"\n422:           ],\n423:           \"field\": \"category\",\n424:           \"id\": \"html.bookmark_save.category.empty\",\n425:           \"implementation\": \"acceptance/p0_organize.py\",\n426:           \"operation\": \"bookmark_save\",\n427:           \"response\": \"form-error and submitted values retained\",\n428:           \"status\": 400,\n429:           \"transport\": \"html\",\n430:           \"value_kind\": \"empty\",\n431:           \"write_effect\": \"none\"\n432:         },\n433:         {\n434:           \"acceptance_ids\": [\n435:             \"A12\"\n436:           ],\n437:           \"code\": \"invalid_category\",\n438:           \"feature_ids\": [\n439:             \"F04\",\n440:             \"F10\"\n441:           ],\n442:           \"field\": \"category\",\n443:           \"id\": \"html.bookmark_save.category.whitespace\",\n444:           \"implementation\": \"acceptance/p0_organize.py\",\n445:           \"operation\": \"bookmark_save\",\n446:           \"response\": \"form-error and submitted values retained\",\n447:           \"status\": 400,\n448:           \"transport\": \"html\",\n449:           \"value_kind\": \"whitespace\",\n450:           \"writ