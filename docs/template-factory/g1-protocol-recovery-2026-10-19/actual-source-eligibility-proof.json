    "facts": [
      {
        "case_id": "case:product-c42848f63251507bd9d911a5:faa52e6b1414",
        "case_revision": 1,
        "evidence_id": "ev_ba200adf6e2c_05babdea64ba9858",
        "kind": "code_observation",
        "statement": "New records are built with id `bm-${crypto.randomUUID()}`, hostname from getHostname(url), and defaults visitCount=0, visitedAt=null, isPinned=false, isArchived=false, createdAt=Date.now(); edits preserve the previous id, isPinned, isArchived, visitCount, createdAt, and visitedAt."
      },
      {
        "case_id": "case:product-c42848f63251507bd9d911a5:faa52e6b1414",
        "case_revision": 1,
        "evidence_id": "ev_ba200adf6e2c_06c81a165e03c96a",
        "kind": "code_observation",
        "statement": "Pin/Unpin and Edit actions are rendered only when the item is not archived, and Edit loads the item's url/title/description/tags/favicon into the dialog."
      },
      {
        "case_id": "case:product-c42848f63251507bd9d911a5:faa52e6b1414",
        "case_revision": 1,
        "evidence_id": "ev_ba200adf6e2c_1596da4a90687ca5",
        "kind": "code_observation",
        "statement": "The Valibot BookmarkFormSchema requires a non-empty URL matching /^https?:\\/\\/(?:[\\w-]+\\.)+[a-zA-Z]{2,}(?:\\/\\S*)?$/ and v.url, a non-empty title up to 100 chars, a non-empty description up to 280 chars, and 1-5 tags each up to 30 chars."
      },
      {
        "case_id": "case:product-c42848f63251507bd9d911a5:faa52e6b1414",
        "case_revision": 1,
        "evidence_id": "ev_ba200adf6e2c_3168bcd465b6a043",
        "kind": "inference",
        "statement": "The scenario's user-controlled 'category' (归类) is realized only as up to five free-text tags on each record; there are no creatable, renameable, or nestable collections, and no separate move operation beyond editing tags."
      },
      {
        "case_id": "case:product-c42848f63251507bd9d911a5:faa52e6b1414",
        "case_revision": 1,
        "evidence_id": "ev_ba200adf6e2c_35e41aab676021eb",
        "kind": "code_observation",
        "statement": "saveBookmark sets the record in the in-memory map then awaits db.bookmarks.put(bm); deleteBookmark removes from the map then awaits db.bookmarks.delete(id)."
      },
      {
        "case_id": "case:product-c42848f63251507bd9d911a5:faa52e6b1414",
        "case_revision": 1,
        "evidence_id": "ev_ba200adf6e2c_4c56ef30a1785be1",
        "kind": "code_observation",
        "statement": "A Delete action is rendered only for archived items; it calls deleteBookmark and shows an error-type toast with an Undo action that calls saveBookmark(item) to restore the record."
      },
      {
        "case_id": "case:product-c42848f63251507bd9d911a5:faa52e6b1414",
        "case_revision": 1,
        "evidence_id": "ev_ba200adf6e2c_6bbd7a588896fe31",
        "kind": "inference",
        "statement": "The scenario step of letting unclassified links land in a default category is not supported, because the form schema rejects saves with zero tags."
      },
      {
        "case_id": "case:product-c42848f63251507bd9d911a5:faa52e6b1414",
        "case_revision": 1,
        "evidence_id": "ev_ba200adf6e2c_7150b0ac7a5678db",
        "kind": "code_observation",
        "statement": "A Copy URL action writes item.url to the clipboard and shows a success toast."
      },
      {
        "case_id": "case:product-c42848f63251507bd9d911a5:faa52e6b1414",
        "case_revision": 1,
        "evidence_id": "ev_ba200adf6e2c_7d47d725a2e9b759",
        "kind": "inference",
        "statement": "Metadata and favicon enrichment is best-effort and dependent on third-party HTTP services; failures degrade silently to console errors while the bookmark still saves with whatever fields the user entered or omitted defaults for."
      },
      {
        "case_id": "case:product-c42848f63251507bd9d911a5:faa52e6b1414",
        "case_revision": 1,
        "evidence_id": "ev_ba200adf6e2c_86ed2327f33a3ca8",
        "kind": "code_observation",
        "statement": "An effect on component creation calls db.bookmarks.toArray() and inserts each returned bookmark into an in-memory RippleMap keyed by bookmark id."
      },
      {
        "case_id": "case:product-c42848f63251507bd9d911a5:faa52e6b1414",
        "case_revision": 1,
        "evidence_id": "ev_ba200adf6e2c_8e11efc61a4650ba",
        "kind": "code_observation",
        "statement": "On submit, if no favicon exists and a hostname is derivable, the code fetches a Google s2 favicon proxied through images.weserv.nl inside a try/catch that only logs failure."
      },
      {
        "case_id": "case:product-c42848f63251507bd9d911a5:faa52e6b1414",
        "case_revision": 1,
        "evidence_id": "ev_ba200adf6e2c_922f1dbc84912d99",
        "kind": "inference",
        "statement": "Persistence is local to one browser profile/device via IndexedDB with no sync layer, so the scenario's cross-session growth holds only on the same browser, and the leaf's multi-device context is unmet."
      },
      {
        "case_id": "case:product-c42848f63251507bd9d911a5:faa52e6b1414",
        "case_revision": 1,
        "evidence_id": "ev_ba200adf6e2c_93ef917a193a45ab",
        "kind": "inference",
        "statement": "Deletion is limited to archived records and recovery is only the transient Undo action on the toast; there is no trash view, and non-archived records cannot be deleted at all through the UI."
      },
      {
        "case_id": "case:product-c42848f63251507bd9d911a5:faa52e6b1414",
        "case_revision": 1,
        "evidence_id": "ev_ba200adf6e2c_93ff254508846f11",
        "kind": "code_observation",
        "statement": "The Visit action builds an updated bookmark with visitedAt=Date.now() and visitCount+1, calls saveBookmark(updated), then opens the URL with window.open(item.url, '_blank', 'noopener,noreferrer')."
      },
      {
        "case_id": "case:product-c42848f63251507bd9d911a5:faa52e6b1414",
        "case_revision": 1,
        "evidence_id": "ev_ba200adf6e2c_9ab6b0e51811a16d",
        "kind": "code_observation",
        "statement": "The displayed list filters by isArchived matching the active tab, requires every selected tag to be present in bookmark.tags, matches search only against bookmark.title.toLowerCase(), and sorts pinned-first then by the chosen sort mode with createdAt descending as fallback."
      },
      {
        "case_id": "case:product-c42848f63251507bd9d911a5:faa52e6b1414",
        "case_revision": 1,
        "evidence_id": "ev_ba200adf6e2c_b1ca64cf2ad02998",
        "kind": "code_observation",
        "statement": "The Archive/Unarchive action toggles isArchived and, when archiving, forces isPinned=false before saving."
      },
      {
        "case_id": "case:product-c42848f63251507bd9d911a5:faa52e6b1414",
        "case_revision": 1,
        "evidence_id": "ev_ba200adf6e2c_c4ad7e52e5713628",
        "kind": "code_observation",
        "statement": "Tag counts are derived by iterating all in-memory bookmarks and counting each tag occurrence, then sorted alphabetically for the sidebar."
      },
      {
        "case_id": "case:product-c42848f63251507bd9d911a5:faa52e6b1414",
        "case_revision": 1,
        "evidence_id": "ev_ba200adf6e2c_e62ae7e0a2c68ba1",
        "kind": "inference",
        "statement": "Retrieval by keyword covers only bookmark titles, not URLs, descriptions, or tag names, so the scenario's 'find by a remembered word' workflow is partially supported."
      },
      {
        "case_id": "case:product-c42848f63251507bd9d911a5:faa52e6b1414",
        "case_revision": 1,
        "evidence_id": "ev_ba200adf6e2c_e7dd8d32c05c39f9",
        "kind": "inference",
        "statement": "The app supports the scenario's save-now/find-later loop: a deliberate add dialog writes a URL-anchored record into durable IndexedDB, and the record can later be browsed, tag-filtered, title-searched, and opened back to the live URL."
      },
      {
        "case_id": "case:product-c42848f63251507bd9d911a5:faa52e6b1414",
        "case_revision": 1,
        "evidence_id": "ev_ba200adf6e2c_ec303a2fd1afa287",
        "kind": "code_observation",
        "statement": "fetchMeta calls https://api.microlink.io/?url=... and, on success with result.data, sets title/description and fetches the logo through https://images.weserv.nl/; errors are only console.error'd and the finally block resets loading."
      }
    ],
