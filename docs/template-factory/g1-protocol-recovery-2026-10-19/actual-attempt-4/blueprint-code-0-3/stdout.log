)\n1372:         delete_form = _find_record_form(home_doc, 'record-delete-form', trashed_c)\n1373:         if not recorder.check(\n1374:             'a04-trash-form',\n1375:             delete_form is not None,\n1376:             f'归类 {name_c!r} 的记录行含 record-delete-form',\n1377:         ):\n1378:             return\n1379:         response = client.post_form(\n1380:             _form_path(delete_form, '/'),\n1381:             _form_fields(delete_form),\n1382:             follow_redirects=False,\n1383:             accept='text/html',\n1384:         )\n1385:         page, location = _follow_303(\n1386:             client, recorder, response, 'a04-trash',\n1387:             expected_path='/', expected_query={'trash': '1'},\n1388:         )\n1389:         if page is None:\n1390:             return\n1391:         trash_doc = _parse_html(page.text)\n1392:         recorder.check(\n1393:             'a04-trash-restore-form-before-delete',\n1394:             _find_record_form(trash_doc, 'record-restore-form', trashed_c) is not None,\n1395:             f'删除归类前 /?trash=1 显示记录 {trashed_c!r} 的 restore 表单',\n1396:         )\n1397: \n1398:         cat_doc = _categories_page(client, recorder, 'a04-delete-c-forms')\n1399:         delete_cat_form = _form_for_category(cat_doc, 'category-delete-form', id_c)\n1400:         if not recorder.check(\n1401:             'a04-delete-c-form',\n1402:             delete_cat_form is not None,\n1403:             f'找到归类 {name_c!r} 的 delete 表单',\n1404:         ):\n1405:             return\n1406:         response = client.post_form(\n1407:             _form_path(delete_cat_form, '/categories'),\n1408:             _form_fields(delete_cat_form, {'category_id': id_c}),\n1409:             follow_redirects=False,\n1410:             accept='text/html',\n1411:         )\n1412:         page, location = _follow_303(\n1413:             client, recorder, response, 'a04-delete-c', expected_path='/categories'\n1414:         )\n1415:         if page is None:\n1416:             return\n1417:         categories = _fetch_categories(client, recorder, 'a04-delete-c-after')\n1418:         recorder.check(\n1419:             'a04-delete-c-gone',\n1420:             _find_category_by_id(categories, id_c) is None\n1421:             and _find_category_by_name(categories, name_c) is None,\n1422:             f'删除后归类 {name_c!r} 不再存在',\n1423:         )\n1424:         default_item = _default_category(categories)\n1425:         default_id = _record_id(default_item)\n1426:         if not recorder.check(\n1427:             'a04-default-id', bool(default_id), f'默认归类 id={default_id!r}'\n1428:         ):\n1429:             return\n1430: \n1431:         default_active = _fetch_bookmarks(\n1432:             client, recorder, 'a04-default-active',\n1433:             params={'category': common.DEFAULT_CATEGORY},\n1434:         )\n1435:         active_ids = _record_ids(default_active)\n1436:         recorder.check(\n1437:             'a04-delete-c-active-migrated',\n1438:             active_c in active_ids,\n1439:             f'删除归类后活动记录 {active_c!r} 出现在「{common.DEFAULT_CATEGORY}」',\n1440:         )\n1441:         recorder.check(\n1442:             'a04-delete-c-trashed-hidden',\n1443:             trashed_c not in active_ids,\n1444:             f'删除归类后软删记录 {trashed_c!r} 不出现在默认活动列表',\n1445:         )\n[Output truncated. Continue reading with offset: 1446]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file source/generated-0/acceptance/p0_organize.py, lines 1-1445\n1: #!/usr/bin/env python3\n2: '''P0 行为验收组：归类管理、记录移动、归类浏览与非法归类。\n3: \n4: 覆盖 A04、A05、A06、A12。仅使用 Python 3.12 标准库并复用\n5: acceptance/common.py：以 --case 派发，未知用例显式失败；每个用例对真实\n6: 目标执行正向与硬负向行为断言，向 stdout 输出单个\n7: atlas.acceptance-result.v1 JSON，失败时以非零码退出。\n8: '''\n9: \n10: from __future__ import annotations\n11: \n12: import os\n13: import re\n14: import sys\n15: import uuid\n16: from html.parser import HTMLParser\n17: from urllib.parse import parse_qsl, quote, urlsplit\n18: \n19: _THIS_DIR = os.path.dirname(os.path.abspath(__file__))\n20: if _THIS_DIR not in sys.path:\n21:     sys.path.insert(0, _THIS_DIR)\n22: \n23: import common\n24: \n25: _SUCCESS_STATUSES = (200, 204)\n26: _NUMBER_RE = re.compile('[0-9]+')\n27: _VOID_TAGS = frozenset({\n28:     'area', 'base', 'br', 'col', 'embed', 'hr', 'img', 'input',\n29:     'link', 'meta', 'param', 'source', 'track', 'wbr',\n30: })\n31: _OMIT = object()\n32: \n33: \n34: def _normalize_space(value):\n35:     return ' '.join(str(value or '').split())\n36: \n37: \n38: class _Field:\n39:     def __init__(self, attrs):\n40:         self.attrs = attrs\n41:         self.name = attrs.get('name')\n42:         self.value = attrs.get('value', '')\n43:         self.type = (attrs.get('type') or 'text').lower()\n44:         self.checked = 'checked' in attrs\n45: \n46: \n47: class _Option:\n48:     def __init__(self, attrs):\n49:         self.attrs = attrs\n50:         self.value = attrs.get('value')\n51:         self.text = ''\n52:         self.selected = 'selected' in attrs\n53: \n54:     def resolved_value(self):\n55:         if self.value is not None:\n56:             return self.value\n57:         return self.text.strip()\n58: \n59: \n60: class _Select:\n61:     def __init__(self, attrs):\n62:         self.attrs = attrs\n63:         self.name = attrs.get('name')\n64:         self.options = []\n65: \n66:     def selected_value(self):\n67:         for option in self.options:\n68:             if option.selected:\n69:                 return option.resolved_value()\n70:         if self.options:\n71:             return self.options[0].resolved_value()\n72:         return ''\n73: \n74: \n75: class _Textarea:\n76:     def __init__(self, attrs):\n77:         self.attrs = attrs\n78:         self.name = attrs.get('name')\n79:         self.text = ''\n80: \n81: \n82: class _Form:\n83:     def __init__(self, attrs):\n84:         self.attrs = attrs\n85:         self.action = (attrs.get('action') or '').strip()\n86:         self.method = (attrs.get('method') or 'get').strip().lower()\n87:         self.testid = attrs.get('data-testid') or ''\n88:         self.fields = []\n89:         self.selects = []\n90:         self.textareas = []\n91: \n92:     def has_name(self, name):\n93:         if any(field.name == name for field in self.fields):\n94:             return True\n95:         if any(select.name == name for select in self.selects):\n96:             return True\n97:         return any(textarea.name == name for textarea in self.textareas)\n98: \n99:     def value(self, name):\n100:         for field in reversed(self.fields):\n101:             if field.name == name:\n102:                 return field.value\n103:         for select in reversed(self.selects):\n104:             if select.name == name:\n105:                 return select.selected_value()\n106:         for textarea in reversed(self.textareas):\n107:             if textarea.name == name:\n108:                 return textarea.text\n109:         return None\n110: \n111: \n112: class _Anchor:\n113:     def __init__(self, attrs):\n114:         self.attrs = attrs\n115:         self.href = attrs.get('href') or ''\n116:         self.testid = attrs.get('data-testid') or ''\n117:         self.text = ''\n118: \n119: \n120: class _Row:\n121:     def __init__(self, attrs):\n122:         self.attrs = attrs\n123:         self.record_id = attrs.get('data-record-id') or ''\n124:         self.anchors = []\n125:         self.text = ''\n126: \n127: \n128: def _action_path(action):\n129:     text = (action or '').strip()\n130:     if not text:\n131:         return ''\n132:     try:\n133:         path = urlsplit(text).path\n134:     except ValueError:\n135:         return text\n136:     if not path:\n137:         return ''\n138:     if not path.startswith('/'):\n139:         path = '/' + path\n140:     return path.rstrip('/') or '/'\n141: \n142: \n143: def _path_of(href):\n144:     try:\n145:         path = urlsplit(href).path\n146:     except ValueError:\n147:         return ''\n148:     if not path:\n149:         return ''\n150:     if not path.startswith('/'):\n151:         path = '/' + path\n152:     return path.rstrip('/') or '/'\n153: \n154: \n155: def _form_path(form, default):\n156:     action = (form.action or '').strip()\n157:     return action if action else default\n158: \n159: \n160: class _Document:\n161:     def __init__(self):\n162:         self.forms = []\n163:         self.anchors = []\n164:         self.rows = []\n165:         self.testids = []\n166:         self.start_tags = []\n167:         self.text = ''\n168: \n169:     def save_form(self):\n170:         for form in self.forms:\n171:             if form.method == 'post' and _action_path(form.action) == '/bookmarks/new':\n172:                 return form\n173:         for form in self.forms:\n174:             if form.method == 'post' and form.has_name('url'):\n175:                 return form\n176:         return None\n177: \n178: \n179: class _HtmlReader(HTMLParser):\n180:     def __init__(self):\n181:         super().__init__(convert_charrefs=True)\n182:         self.doc = _Document()\n183:         self._form = None\n184:         self._select = None\n185:         self._option = None\n186:         self._textarea = None\n187:         self._anchor = None\n188:         self._row = None\n189:         self._testid_stack = []\n190: \n191:     def handle_starttag(self, tag, attrs):\n192:         tag = tag.lower()\n193:         attributes = {\n194:             str(key).lower(): ('' if value is None else value)\n195:             for key, value in attrs\n196:         }\n197:         self.doc.start_tags.append((tag, attributes))\n198:         testid = attributes.get('data-testid') or ''\n199:         if testid:\n200:             entry = {'tag': tag, 'attrs': attributes, 'text': ''}\n201:             self.doc.testids.append(entry)\n202:             if tag not in _VOID_TAGS:\n203:                 self._testid_stack.append((tag, entry))\n204:         if tag == 'form':\n205:             self._finish_form()\n206:             self._form = _Form(attributes)\n207:         elif tag == 'input':\n208:             if self._form is not None:\n209:                 self._form.fields.append(_Field(attributes))\n210:         elif tag == 'select':\n211:             self._finish_select()\n212:             if self._form is not None:\n213:                 self._select = _Select(attributes)\n214:         elif tag == 'option':\n215:             self._finish_option()\n216:             if self._select is not None:\n217:                 self._option = _Option(attributes)\n218:         elif tag == 'textarea':\n219:             self._finish_textarea()\n220:             if self._form is not None:\n221:                 self._textarea = _Textarea(attributes)\n222:         elif tag == 'a':\n223:             self._finish_anchor()\n224:             self._anchor = _Anchor(attributes)\n225:         elif tag == 'tr' and testid == 'record-row':\n226:             self._finish_row()\n227:             self._row = _Row(attributes)\n228: \n229:     def handle_data(self, data):\n230:         if not data:\n231:             return\n232:         self.doc.text += data\n233:         if self._row is not None:\n234:             self._row.text += data\n235:         if self._anchor is not None:\n236:             self._anchor.text += data\n237:         if self._option is not None:\n238:             self._option.text += data\n239:         if self._textarea is not None:\n240:             self._textarea.text += data\n241:         for _, entry in self._testid_stack:\n242:             entry['text'] += data\n243: \n244:     def handle_endtag(self, tag):\n245:         tag = tag.lower()\n246:         if tag == 'a':\n247:             self._finish_anchor()\n248:         elif tag == 'option':\n249:             self._finish_option()\n250:         elif tag == 'select':\n251:             self._finish_select()\n252:         elif tag == 'textarea':\n253:             self._finish_textarea()\n254:         elif tag == 'form':\n255:             self._finish_form()\n256:         elif tag == 'tr':\n257:             self._finish_row()\n258:         if tag in _VOID_TAGS:\n259:             return\n260:         if self._testid_stack and self._testid_stack[-1][0] == tag:\n261:             self._testid_stack.pop()\n262: \n263:     def _finish_option(self):\n264:         if self._option is None:\n265:             return\n266:         option = self._option\n267:         self._option = None\n268:         if self._select is not None:\n269:             self._select.options.append(option)\n270: \n271:     def _finish_select(self):\n272:         self._finish_option()\n273:         if self._select is None:\n274:             return\n275:         select = self._select\n276:         self._select = None\n277:         if self._form is not None:\n278:             self._form.selects.append(select)\n279: \n280:     def _finish_textarea(self):\n281:         if self._textarea is None:\n282:             return\n283:         textarea = self._textarea\n284:         self._textarea = None\n285:         if self._form is not None:\n286:             self._form.textareas.append(textarea)\n287: \n288:     def _finish_anchor(self):\n289:         if self._anchor is None:\n290:             return\n291:         anchor = self._anchor\n292:         self._anchor = None\n293:         self.doc.anchors.append(anchor)\n294:         if self._row is not None:\n295:             self._row.anchors.append(anchor)\n296: \n297:     def _finish_row(self):\n298:         if self._row is None:\n299:             return\n300:         row = self._row\n301:         self._row = None\n302:         self.doc.rows.append(row)\n303: \n304:     def _finish_form(self):\n305:         self._finish_select()\n306:         self._finish_textarea()\n307:         if self._form is None:\n308:             return\n309:         form = self._form\n310:         self._form = None\n311:         self.doc.forms.append(form)\n312: \n313:     def finalize(self):\n314:         self._finish_anchor()\n315:         self._finish_row()\n316:         self._finish_form()\n317: \n318: \n319: def _parse_html(text):\n320:     reader = _HtmlReader()\n321:     reader.feed(text or '')\n322:     reader.close()\n323:     reader.finalize()\n324:     return reader.doc\n325: \n326: \n327: def _form_fields(form, overrides=None, omit=()):\n328:     fields = {}\n329:     for field in form.fields:\n330:         name = field.name\n331:         if not name:\n332:             continue\n333:         if field.type in ('submit', 'button', 'reset', 'file', 'image'):\n334:             continue\n335:         if field.type in ('checkbox', 'radio') and not field.checked:\n336:             continue\n337:         fields[name] = field.value\n338:     for select in form.selects:\n339:         if select.name:\n340:             fields[select.name] = select.selected_value()\n341:     for textarea in form.textareas:\n342:         if textarea.name:\n343:             fields[textarea.name] = textarea.text\n344:     if overrides:\n345:         for key, value in overrides.items():\n346:             name = str(key)\n347:             if value is None:\n348:                 fields.pop(name, None)\n349:             else:\n350:                 fields[name] = str(value)\n351:     for name in omit:\n352:         fields.pop(name, None)\n353:     return fields\n354: \n355: \n356: def _first_form(doc, testid):\n357:     for form in doc.forms:\n358:         if form.testid == testid:\n359:             return form\n360:     return None\n361: \n362: \n363: def _form_for_category(doc, testid, category_id):\n364:     forms = [\n365:         form for form in doc.forms\n366:         if form.testid == testid and form.has_name('category_id')\n367:     ]\n368:     for form in forms:\n369:         if form.value('category_id') == category_id:\n370:             return form\n371:     if len(forms) == 1:\n372:         return forms[0]\n373:     return None\n374: \n375: \n376: def _find_record_form(doc, testid, record_id):\n377:     for form in doc.forms:\n378:         if form.testid == testid and form.value('record_id') == record_id:\n379:             return form\n380:     return None\n381: \n382: \n383: def _find_anchor(doc, testid):\n384:     for anchor in doc.anchors:\n385:         if anchor.testid == testid:\n386:             return anchor\n387:     return None\n388: \n389: \n390: def _form_error_text(doc):\n391:     parts = []\n392:     for entry in doc.testids:\n393:         testid = (entry['attrs'].get('data-testid') or '').lower()\n394:         if testid == 'form-error' or 'form-error' in testid:\n395:             text = _normalize_space(entry['text'])\n396:             if text:\n397:                 parts.append(text)\n398:     return ' '.join(parts)\n399: \n400: \n401: def _category_count_values(doc):\n402:     result = {}\n403:     for entry in doc.testids:\n404:         if entry['attrs'].get('data-testid') != 'category-count':\n405:             continue\n406:         category_id = entry['attrs'].get('data-category-id')\n407:         if not category_id:\n408:             continue\n409:         numbers = _NUMBER_RE.findall(entry['text'])\n410:         value = int(numbers[-1]) if numbers else None\n411:         result.setdefault(category_id, []).append(value)\n412:     return result\n413: \n414: \n415: def _row_ids(doc):\n416:     return {row.record_id for row in doc.rows if row.record_id}\n417: \n418: \n419: def _row_for_url(doc, url):\n420:     for row in doc.rows:\n421:         for anchor in row.anchors:\n422:             if anchor.testid == 'record-open-link' and anchor.href == url:\n423:                 return row\n424:     for row in doc.rows:\n425:         for anchor in row.anchors:\n426:             if anchor.href == url:\n427:                 return row\n428:     return None\n429: \n430: \n431: def _select_values(form, name):\n432:     for select in form.selects:\n433:         if select.name == name:\n434:             return [option.resolved_value() for option in select.options]\n435:     return []\n436: \n437: \n438: def _unique_url(tag):\n439:     token = f'{tag}-{uuid.uuid4().hex[:12]}'\n440:     return f'https://{token}.atlas-acceptance.example/{token}'\n441: \n442: \n443: def _unique_category(tag):\n444:     return f'atlas-{tag}-{uuid.uuid4().hex[:10]}'\n445: \n446: \n447: def _safe_json(response):\n448:     try:\n449:         return response.json()\n450:     except Exception:\n451:         return None\n452: \n453: \n454: def _extract_record(payload):\n455:     if isinstance(payload, dict):\n456:         for key in ('bookmark', 'record', 'data', 'item'):\n457:             value = payload.get(key)\n458:             if isinstance(value, dict):\n459:                 return value\n460:         return payload\n461:     return None\n462: \n463: \n464: def _extract_category(payload):\n465:     if isinstance(payload, dict):\n466:         value = payload.get('category')\n467:         if isinstance(value, dict):\n468:             return value\n469:         return payload\n470:     return None\n471: \n472: \n473: def _extract_list(payload, keys):\n474:     if isinstance(payload, list):\n475:         return payload\n476:     if isinstance(payload, dict):\n477:         for key in keys:\n478:             value = payload.get(key)\n479:             if isinstance(value, list):\n480:                 return value\n481:     return None\n482: \n483: \n484: def _record_id(record):\n485:     if isinstance(record, dict) and record.get('id') is not None:\n486:         return str(record['id'])\n487:     return None\n488: \n489: \n490: def _record_url(record):\n491:     if isinstance(record, dict) and record.get('url') is not None:\n492:         return str(record['url'])\n493:     return None\n494: \n495: \n496: def _record_title(record):\n497:     if isinstance(record, dict) and record.get('title') is not None:\n498:         return str(record['title'])\n499:     return None\n500: \n501: \n502: def _record_description(record):\n503:     if isinstance(record, dict):\n504:         for key in ('description', 'desc'):\n505:             if record.get(key) is not None:\n506:                 return str(record[key])\n507:     return None\n508: \n509: \n510: def _record_category_name(record, categories):\n511:     if not isinstance(record, dict):\n512:         return None\n513:     by_id = {}\n514:     names = set()\n515:     for item in categories or []:\n516:         if isinstance(item, dict) and item.get('id') is not None:\n517:             if item.get('name') is not None:\n518:                 by_id[str(item['id'])] = str(item['name'])\n519:                 names.add(str(item['name']))\n520:     for key in ('category', 'category_name', 'categoryName'):\n521:         value = record.get(key)\n522:         if isinstance(value, str):\n523:             if value in names:\n524:                 return value\n525:             if value in by_id:\n526:                 return by_id[value]\n527:             return value\n528:         if isinstance(value, dict) and value.get('name') is not None:\n529:             return str(value['name'])\n530:     for key in ('category_id', 'categoryId'):\n531:         value = record.get(key)\n532:         if value is not None and str(value) in by_id:\n533:             return by_id[str(value)]\n534:     return None\n535: \n536: \n537: def _category_names(categories):\n538:     return {\n539:         str(item['name']) for item in categories\n540:         if isinstance(item, dict) and item.get('name') is not None\n541:     }\n542: \n543: \n544: def _category_ids(categories):\n545:     return {\n546:         str(item['id']) for item in categories\n547:         if isinstance(item, dict) and item.get('id') is not None\n548:     }\n549: \n550: \n551: def _find_category_by_name(categories, name):\n552:     if name is None:\n553:         return None\n554:     target = str(name).casefold()\n555:     for item in categories:\n556:         if isinstance(item, dict) and item.get('name') is not None:\n557:             if str(item['name']).casefold() == target:\n558:                 return item\n559:     return None\n560: \n561: \n562: def _find_category_by_id(categories, category_id):\n563:     if category_id is None:\n564:         return None\n565:     target = str(category_id)\n566:     for item in categories:\n567:         if isinstance(item, dict) and item.get('id') is not None:\n568:             if str(item['id']) == target:\n569:                 return item\n570:     return None\n571: \n572: \n573: def _default_category(categories):\n574:     for item in categories:\n575:         if isinstance(item, dict) and item.get('is_default'):\n576:             return item\n577:     return _find_category_by_name(categories, common.DEFAULT_CATEGORY)\n578: \n579: \n580: def _error_code(response):\n581:     payload = _safe_json(response)\n582:     if isinstance(payload, dict):\n583:         error = payload.get('error')\n584:         if isinstance(error, dict) and error.get('code') is not None:\n585:             return str(error['code'])\n586:         for key in ('code', 'error_code'):\n587:             if payload.get(key) is not None:\n588:                 return str(payload[key])\n589:     return None\n590: \n591: \n592: def _bookmark_path(bookmark_id):\n593:     return '/api/bookmarks/' + quote(str(bookmark_id), safe='')\n594: \n595: \n596: def _move_path(bookmark_id):\n597:     return _bookmark_path(bookmark_id) + '/move'\n598: \n599: \n600: def _category_path(category_id):\n601:     return '/api/categories/' + quote(str(category_id), safe='')\n602: \n603: \n604: def _record_ids(records):\n605:     return {\n606:         record_id for record_id in (_record_id(record) for record in records)\n607:         if record_id\n608:     }\n609: \n610: \n611: def _fetch_bookmarks(client, recorder, aid, params=None):\n612:     response = client.get('/api/bookmarks', params=params)\n613:     recorder.expect_status(response, 200, aid=f'{aid}-status')\n614:     payload = _safe_json(response)\n615:     records = _extract_list(payload, ('bookmarks', 'items', 'data', 'records'))\n616:     recorder.check(\n617:         f'{aid}-shape',\n618:         isinstance(records, list),\n619:         f'GET /api/bookmarks 必须返回 JSON 数组，实际 {type(payload).__name__}',\n620:     )\n621:     return records if isinstance(records, list) else []\n622: \n623: \n624: def _fetch_categories(client, recorder, aid):\n625:     response = client.get('/api/categories')\n626:     recorder.expect_status(response, 200, aid=f'{aid}-status')\n627:     payload = _safe_json(response)\n628:     categories = _extract_list(payload, ('categories', 'items', 'data'))\n629:     recorder.check(\n630:         f'{aid}-shape',\n631:         isinstance(categories, list),\n632:         f'GET /api/categories 必须返回 JSON 数组，实际 {type(payload).__name__}',\n633:     )\n634:     return categories if isinstance(categories, list) else []\n635: \n636: \n637: def _create_category_json(client, recorder, aid, name):\n638:     response = client.post_json('/api/categories', {'name': name})\n639:     recorder.expect_status(response, 201, aid=f'{aid}-status')\n640:     category_id = _record_id(_extract_category(_safe_json(response)))\n641:     recorder.check(\n642:         f'{aid}-id',\n643:         bool(category_id),\n644:         f'POST /api/categories name={name!r} 返回 id={category_id!r}',\n645:     )\n646:     return category_id\n647: \n648: \n649: def _create_record_json(client, recorder, aid, category=None, title=None, description=None):\n650:     url = _unique_url(aid)\n651:     payload = {'url': url}\n652:     if category is not None:\n653:         payload['category'] = category\n654:     if title is not None:\n655:         payload['title'] = title\n656:     if description is not None:\n657:         payload['description'] = description\n658:     response = client.post_json('/api/bookmarks', payload)\n659:     recorder.expect_status(response, 201, aid=f'{aid}-status')\n660:     record_id = _record_id(_extract_record(_safe_json(response)))\n661:     recorder.check(\n662:         f'{aid}-id',\n663:         bool(record_id),\n664:         f'POST /api/bookmarks url={url!r} 返回 id={record_id!r}',\n665:     )\n666:     return record_id, url\n667: \n668: \n669: def _get_record_json(client, recorder, aid, record_id):\n670:     response = client.get(_bookmark_path(record_id))\n671:     recorder.expect_status(response, 200, aid=f'{aid}-status')\n672:     payload = _safe_json(response)\n673:     record = _extract_record(payload)\n674:     recorder.check(\n675:         f'{aid}-shape',\n676:         isinstance(record, dict),\n677:         f'GET /api/bookmarks/{record_id} 返回 JSON 对象，实际 {type(payload).__name__}',\n678:     )\n679:     return record if isinstance(record, dict) else None\n680: \n681: \n682: def _category_signature(categories):\n683:     items = []\n684:     for item in categories:\n685:         if not isinstance(item, dict):\n686:             continue\n687:         items.append((\n688:             str(item.get('id')),\n689:             str(item.get('name')),\n690:             bool(item.get('is_default')),\n691:             item.get('count'),\n692:         ))\n693:     return tuple(sorted(items, key=lambda entry: (entry[0], entry[1])))\n694: \n695: \n696: def _record_map(records, categories):\n697:     result = {}\n698:     for record in records:\n699:         record_id = _record_id(record)\n700:         if record_id:\n701:             result[record_id] = _record_category_name(record, categories)\n702:     return result\n703: \n704: \n705: def _snapshot(client, recorder, aid):\n706:     categories = _fetch_categories(client, recorder, f'{aid}-categories')\n707:     records = _fetch_bookmarks(\n708:         client, recorder, f'{aid}-records', params={'include_trashed': 1}\n709:     )\n710:     return (_category_signature(categories), _record_map(records, categories))\n711: \n712: \n713: def _check_unchanged(recorder, aid, before, after, label):\n714:     recorder.check(\n715:         f'{aid}-categories-unchanged',\n716:         before[0] == after[0],\n717:         f'{label} 后分类集合（含计数）不变：{len(before[0])} -> {len(after[0])}',\n718:     )\n719:     recorder.check(\n720:         f'{aid}-records-unchanged',\n721:         before[1] == after[1],\n722:         f'{label} 后记录集合与归类归属不变：{len(before[1])} -> {len(after[1])}',\n723:     )\n724: \n725: \n726: def _follow_303(client, recorder, response, aid, expected_path=None, expected_query=None):\n727:     recorder.expect_status(response, 303, aid=f'{aid}-status')\n728:     location = response.location\n729:     if not recorder.check(\n730:         f'{aid}-location',\n731:         bool(location),\n732:         f'303 响应必须带 Location，实际 {location!r}',\n733:     ):\n734:         return None, None\n735:     parts = urlsplit(location)\n736:     if expected_path is not None:\n737:         actual_path = parts.path.rstrip('/') or '/'\n738:         wanted_path = expected_path.rstrip('/') or '/'\n739:         recorder.check(\n740:             f'{aid}-path',\n741:             actual_path == wanted_path,\n742:             f'303 Location={location!r} 的路径={actual_path!r}（期望 {wanted_path!r}）',\n743:         )\n744:     if expected_query:\n745:         actual_query = dict(parse_qsl(parts.query, keep_blank_values=True))\n746:         for key, value in expected_query.items():\n747:             actual_value = actual_query.get(key)\n748:             recorder.check(\n749:                 f'{aid}-query-{key}',\n750:                 actual_value == value,\n751:                 f'303 Location={location!r} 的 {key}={actual_value!r}（期望 {value!r}）',\n752:             )\n753:     page = client.get(location, accept='text/html')\n754:     recorder.expect_status(page, 200, aid=f'{aid}-follow-status')\n755:     return page, location\n756: \n757: \n758: def _home_page(client, recorder, aid, params=None):\n759:     response = client.get('/', params=params, accept='text/html')\n760:     recorder.expect_status(response, 200, aid=f'{aid}-status')\n761:     recorder.check(\n762:         f'{aid}-content-type',\n763:         'text/html' in response.content_type.lower(),\n764:         f'GET / Content-Type={response.content_type!r}',\n765:     )\n766:     return _parse_html(response.text)\n767: \n768: \n769: def _categories_page(client, recorder, aid):\n770:     response = client.get('/categories', accept='text/html')\n771:     recorder.expect_status(response, 200, aid=f'{aid}-status')\n772:     recorder.check(\n773:         f'{aid}-content-type',\n774:         'text/html' in response.content_type.lower(),\n775:         f'GET /categories Content-Type={response.content_type!r}',\n776:     )\n777:     return _parse_html(response.text)\n778: \n779: \n780: def _expect_html_error(recorder, response, aid, label, expected_status):\n781:     recorder.check(\n782:         f'{aid}-no-5xx',\n783:         response.status < 500,\n784:         f'{label} -> HTTP {response.status}（校验类错误不得产生 5xx）',\n785:     )\n786:     recorder.expect_status(\n787:         response,\n788:         expected_status,\n789:         aid=f'{aid}-status',\n790:         detail=f'{label} -> HTTP {response.status}（期望 {expected_status}）',\n791:     )\n792:     doc = _parse_html(response.text)\n793:     error_text = _form_error_text(doc)\n794:     recorder.check(\n795:         f'{aid}-form-error',\n796:         bool(error_text),\n797:         f'{label} 显示可读 form-error，实际 {error_text!r}',\n798:     )\n799:     return doc\n800: \n801: \n802: def _run_html_move_negative(client, recorder, aid, move_form, move_action, anchor_id, label, value, default_category):\n803:     before = _snapshot(client, recorder, f'{aid}-before')\n804:     if value is _OMIT:\n805:         fields = _form_fields(move_form, omit=('category_id',))\n806:     else:\n807:         fields = _form_fields(move_form, {'category_id': value})\n808:     response = client.post_form(\n809:         move_action, fields, follow_redirects=False, accept='text/html'\n810:     )\n811:     error_doc = _expect_html_error(recorder, response, aid, f'HTML move {label}', 400)\n812:     error_form = _find_record_form(error_doc, 'record-move-form', anchor_id)\n813:     recorder.check(\n814:         f'{aid}-form',\n815:         error_form is not None,\n816:         f'HTML move {label} 错误页保留目标记录 move 表单',\n817:     )\n818:     if error_form is not None:\n819:         retained_record = error_form.value('record_id')\n820:         recorder.check(\n821:             f'{aid}-record-retained',\n822:             retained_record == anchor_id,\n823:             f'HTML move {label} 错误页 record_id={retained_record!r}（期望 {anchor_id!r}）',\n824:         )\n825:         if value is not _OMIT:\n826:             retained_category = error_form.value('category_id')\n827:             recorder.check(\n828:                 f'{aid}-category-retained',\n829:                 retained_category == value,\n830:                 f'HTML move {label} 错误页 category_id={retained_category!r}（期望 {value!r}）',\n831:             )\n832:     after = _snapshot(client, recorder, f'{aid}-after')\n833:     _check_unchanged(recorder, aid, before, after, f'HTML move {label}')\n834:     categories = _fetch_categories(client, recorder, f'{aid}-categories')\n835:     record = _get_record_json(client, recorder, f'{aid}-anchor', anchor_id)\n836:     if record is not None:\n837:         actual = _record_category_name(record, categories)\n838:         recorder.check(\n839:             f'{aid}-anchor-category',\n840:             actual == default_category,\n841:             f'HTML move {label} 后锚点 category={actual!r}（期望 {default_category!r}）',\n842:         )\n843:     return record\n844: \n845: \n846: def _case_a04(args, recorder):\n847:     client = common.HttpClient(args.base_url)\n848:     try:\n849:         health = client.get('/api/health')\n850:         recorder.expect_status(health, 200, aid='a04-health-status')\n851:         recorder.check(\n852:             'a04-health-json',\n853:             isinstance(_safe_json(health), dict),\n854:             '/api/health 返回 JSON 对象',\n855:         )\n856: \n857:         home = client.get('/', accept='text/html')\n858:         recorder.expect_status(home, 200, aid='a04-home-status')\n859:         home_doc = _parse_html(home.text)\n860:         manager = _find_anchor(home_doc, 'category-manager')\n861:         manager_href = manager.href if manager is not None else ''\n862:         recorder.check(\n863:             'a04-manager-link',\n864:             manager is not None,\n865:             '首页含 a[data-testid=category-manager]',\n866:         )\n867:         recorder.check(\n868:             'a04-manager-path',\n869:             _path_of(manager_href) == '/categories',\n870:             f'category-manager href={manager_href!r}（期望路径 /categories）',\n871:         )\n872:         if manager is None or _path_of(manager_href) != '/categories':\n873:             return\n874:         categories_path = manager_href\n875: \n876:         cat_page = client.get(categories_path, accept='text/html')\n877:         recorder.expect_status(cat_page, 200, aid='a04-categories-status')\n878:         recorder.check(\n879:             'a04-categories-content-type',\n880:             'text/html' in cat_page.content_type.lower(),\n881:             f'GET /categories Content-Type={cat_page.content_type!r}',\n882:         )\n883:         cat_doc = _parse_html(cat_page.text)\n884:         create_form = _first_form(cat_doc, 'category-create-form')\n885:         if not recorder.check(\n886:             'a04-create-form',\n887:             create_form is not None,\n888:             'GET /categories 含 category-create-form',\n889:         ):\n890:             return\n891:         if not recorder.check(\n892:             'a04-create-name-field',\n893:             create_form.has_name('name'),\n894:             'category-create-form 含 name 输入',\n895:         ):\n896:             return\n897:         create_action = _form_path(create_form, '/categories')\n898: \n899:         name_a = _unique_category('a04a')\n900:         variant = name_a.upper()\n901:         if variant == name_a:\n902:             variant = name_a + 'X'\n903: \n904:         response = client.post_form(\n905:             create_action,\n906:             _form_fields(create_form, {'name': name_a}),\n907:             follow_redirects=False,\n908:             accept='text/html',\n909:         )\n910:         page, location = _follow_303(\n911:             client, recorder, response, 'a04-create-a', expected_path='/categories'\n912:         )\n913:         if page is None:\n914:             return\n915:         page_doc = _parse_html(page.text)\n916:         categories = _fetch_categories(client, recorder, 'a04-create-a')\n917:         cat_a = _find_category_by_name(categories, name_a)\n918:         id_a = _record_id(cat_a)\n919:         recorder.check(\n920:             'a04-create-a-visible',\n921:             cat_a is not None and name_a in page_doc.text,\n922:             f'新建归类 {name_a!r} 在 /categories 可见',\n923:         )\n924:         if not recorder.check(\n925:             'a04-create-a-id', bool(id_a), f'新建归类 id={id_a!r}'\n926:         ):\n927:             return\n928:         values = _category_count_values(page_doc).get(id_a, [])\n929:         recorder.check(\n930:             'a04-create-a-count',\n931:             bool(values) and all(value == 0 for value in values),\n932:             f'新建归类 {name_a!r} HTML 计数={values!r}（期望 0）',\n933:         )\n934: \n935:         before = _snapshot(client, recorder, 'a04-dup-create-exact-before')\n936:         duplicate = client.post_form(\n937:             create_action,\n938:             _form_fields(create_form, {'name': name_a}),\n939:             follow_redirects=False,\n940:             accept='text/html',\n941:         )\n942:         error_doc = _expect_html_error(\n943:             recorder, duplicate, 'a04-dup-create-exact', '重复