{"type":"tool_use","timestamp":1792434502043,"sessionID":"ses_eaa94523effeoyw605cqbs3XcA","part":{"partID":"prt_1556bf90b001Ru0jpHKECmTgNn","sessionID":"ses_eaa94523effeoyw605cqbs3XcA","messageID":"msg_1556bee39001G12l1z4bX8yW1S","type":"tool","id":"call_00_U1OpPJojPUIh2wJ7RW6q3419","tool":"read","state":{"status":"completed","input":{"path":"source/generated-0/acceptance/p0_library.py","limit":500},"output":"Read file source/generated-0/acceptance/p0_library.py, lines 1-500\n1: #!/usr/bin/env python3\n2: '''P0 行为验收组：A01、A02、A03、A11。\n3: \n4: 覆盖真实保存表单与会话/重启持久化、URL 正向边界与非法输入、\n5: 默认归类与自动创建归类、启动健康与首页外壳。仅使用 Python 3.12\n6: 标准库并复用 acceptance/common.py：以 --case 派发，未知用例显式失败；\n7: 每个用例对真实目标执行正向与硬负向行为断言，向 stdout 输出单个\n8: atlas.acceptance-result.v1 JSON，失败时以非零码退出。\n9: '''\n10: \n11: from __future__ import annotations\n12: \n13: import os\n14: import re\n15: import sys\n16: import urllib.parse\n17: import uuid\n18: from html.parser import HTMLParser\n19: \n20: _THIS_DIR = os.path.dirname(os.path.abspath(__file__))\n21: if _THIS_DIR not in sys.path:\n22:     sys.path.insert(0, _THIS_DIR)\n23: \n24: import common\n25: \n26: _WHITESPACE_RE = re.compile(r'\\s+')\n27: _EMPTY_MARKERS = (\n28:     '暂无',\n29:     '没有记录',\n30:     '还没有',\n31:     '空状态',\n32:     '无匹配',\n33:     'no bookmarks',\n34:     'nothing here',\n35:     'empty',\n36: )\n37: _LIST_TAGS = frozenset({'ul', 'ol', 'table'})\n38: _LIST_ATTR_TAGS = frozenset({'div', 'main', 'section', 'article', 'aside'})\n39: \n40: \n41: class _Field:\n42:     def __init__(self, attrs):\n43:         self.attrs = attrs\n44:         self.name = attrs.get('name')\n45:         self.value = attrs.get('value', '')\n46:         self.type = (attrs.get('type') or 'text').lower()\n47:         self.checked = 'checked' in attrs\n48: \n49: \n50: class _Option:\n51:     def __init__(self, attrs):\n52:         self.attrs = attrs\n53:         self.value = attrs.get('value')\n54:         self.text = ''\n55:         self.selected = 'selected' in attrs\n56: \n57:     def resolved_value(self):\n58:         if self.value is not None:\n59:             return self.value\n60:         return self.text.strip()\n61: \n62: \n63: class _Select:\n64:     def __init__(self, attrs):\n65:         self.attrs = attrs\n66:         self.name = attrs.get('name')\n67:         self.options = []\n68: \n69:     def selected_value(self):\n70:         for option in self.options:\n71:             if option.selected:\n72:                 return option.resolved_value()\n73:         if self.options:\n74:             return self.options[0].resolved_value()\n75:         return ''\n76: \n77: \n78: class _Textarea:\n79:     def __init__(self, attrs):\n80:         self.attrs = attrs\n81:         self.name = attrs.get('name')\n82:         self.text = ''\n83: \n84: \n85: class _Form:\n86:     def __init__(self, attrs):\n87:         self.attrs = attrs\n88:         self.action = (attrs.get('action') or '').strip()\n89:         self.method = (attrs.get('method') or 'get').strip().lower()\n90:         self.testid = attrs.get('data-testid') or ''\n91:         self.fields = []\n92:         self.selects = []\n93:         self.textareas = []\n94: \n95:     def has_name(self, name):\n96:         if any(field.name == name for field in self.fields):\n97:             return True\n98:         if any(select.name == name for select in self.selects):\n99:             return True\n100:         return any(textarea.name == name for textarea in self.textareas)\n101: \n102:     def value(self, name):\n103:         for field in reversed(self.fields):\n104:             if field.name == name:\n105:                 return field.value\n106:         for select in reversed(self.selects):\n107:             if select.name == name:\n108:                 return select.selected_value()\n109:         for textarea in reversed(self.textareas):\n110:             if textarea.name == name:\n111:                 return textarea.text\n112:         return None\n113: \n114: \n115: class _Anchor:\n116:     def __init__(self, attrs):\n117:         self.attrs = attrs\n118:         self.href = attrs.get('href') or ''\n119:         self.testid = attrs.get('data-testid') or ''\n120:         self.text = ''\n121: \n122: \n123: class _Row:\n124:     def __init__(self, attrs):\n125:         self.attrs = attrs\n126:         self.record_id = attrs.get('data-record-id') or ''\n127:         self.anchors = []\n128:         self.text = ''\n129: \n130: \n131: def _action_path(action):\n132:     text = (action or '').strip()\n133:     if not text:\n134:         return ''\n135:     try:\n136:         path = urllib.parse.urlsplit(text).path\n137:     except ValueError:\n138:         return text\n139:     if not path:\n140:         return ''\n141:     if not path.startswith('/'):\n142:         path = '/' + path\n143:     return path.rstrip('/') or '/'\n144: \n145: \n146: class _Document:\n147:     def __init__(self):\n148:         self.forms = []\n149:         self.anchors = []\n150:         self.rows = []\n151:         self.testids = []\n152:         self.start_tags = []\n153:         self.text = ''\n154: \n155:     def save_form(self):\n156:         for form in self.forms:\n157:             if form.method == 'post' and _action_path(form.action) == '/bookmarks/new':\n158:                 return form\n159:         for form in self.forms:\n160:             if form.method == 'post' and form.has_name('url'):\n161:                 return form\n162:         return None\n163: \n164: \n165: class _HtmlReader(HTMLParser):\n166:     def __init__(self):\n167:         super().__init__(convert_charrefs=True)\n168:         self.doc = _Document()\n169:         self._form = None\n170:         self._select = None\n171:         self._option = None\n172:         self._textarea = None\n173:         self._anchor = None\n174:         self._row = None\n175:         self._testid_stack = []\n176: \n177:     def handle_starttag(self, tag, attrs):\n178:         tag = tag.lower()\n179:         attributes = {\n180:             str(key).lower(): ('' if value is None else value)\n181:             for key, value in attrs\n182:         }\n183:         self.doc.start_tags.append((tag, attributes))\n184:         testid = attributes.get('data-testid') or ''\n185:         if testid:\n186:             entry = {'tag': tag, 'attrs': attributes, 'text': ''}\n187:             self.doc.testids.append(entry)\n188:             self._testid_stack.append((tag, entry))\n189:         if tag == 'form':\n190:             self._finish_form()\n191:             self._form = _Form(attributes)\n192:         elif tag == 'input':\n193:             if self._form is not None:\n194:                 self._form.fields.append(_Field(attributes))\n195:         elif tag == 'select':\n196:             self._finish_select()\n197:             if self._form is not None:\n198:                 self._select = _Select(attributes)\n199:         elif tag == 'option':\n200:             self._finish_option()\n201:             if self._select is not None:\n202:                 self._option = _Option(attributes)\n203:         elif tag == 'textarea':\n204:             self._finish_textarea()\n205:             if self._form is not None:\n206:                 self._textarea = _Textarea(attributes)\n207:         elif tag == 'a':\n208:             self._finish_anchor()\n209:             self._anchor = _Anchor(attributes)\n210:         elif tag == 'tr' and testid == 'record-row':\n211:             self._finish_row()\n212:             self._row = _Row(attributes)\n213: \n214:     def handle_data(self, data):\n215:         if not data:\n216:             return\n217:         self.doc.text += data\n218:         if self._row is not None:\n219:             self._row.text += data\n220:         if self._anchor is not None:\n221:             self._anchor.text += data\n222:         if self._option is not None:\n223:             self._option.text += data\n224:         if self._textarea is not None:\n225:             self._textarea.text += data\n226:         for _, entry in self._testid_stack:\n227:             entry['text'] += data\n228: \n229:     def handle_endtag(self, tag):\n230:         tag = tag.lower()\n231:         if tag == 'a':\n232:             self._finish_anchor()\n233:         elif tag == 'option':\n234:             self._finish_option()\n235:         elif tag == 'select':\n236:             self._finish_select()\n237:         elif tag == 'textarea':\n238:             self._finish_textarea()\n239:         elif tag == 'form':\n240:             self._finish_form()\n241:         elif tag == 'tr':\n242:             self._finish_row()\n243:         if self._testid_stack and self._testid_stack[-1][0] == tag:\n244:             self._testid_stack.pop()\n245: \n246:     def _finish_option(self):\n247:         if self._option is None:\n248:             return\n249:         option = self._option\n250:         self._option = None\n251:         if self._select is not None:\n252:             self._select.options.append(option)\n253: \n254:     def _finish_select(self):\n255:         self._finish_option()\n256:         if self._select is None:\n257:             return\n258:         select = self._select\n259:         self._select = None\n260:         if self._form is not None:\n261:             self._form.selects.append(select)\n262: \n263:     def _finish_textarea(self):\n264:         if self._textarea is None:\n265:             return\n266:         textarea = self._textarea\n267:         self._textarea = None\n268:         if self._form is not None:\n269:             self._form.textareas.append(textarea)\n270: \n271:     def _finish_anchor(self):\n272:         if self._anchor is None:\n273:             return\n274:         anchor = self._anchor\n275:         self._anchor = None\n276:         self.doc.anchors.append(anchor)\n277:         if self._row is not None:\n278:             self._row.anchors.append(anchor)\n279: \n280:     def _finish_row(self):\n281:         if self._row is None:\n282:             return\n283:         row = self._row\n284:         self._row = None\n285:         self.doc.rows.append(row)\n286: \n287:     def _finish_form(self):\n288:         self._finish_select()\n289:         self._finish_textarea()\n290:         if self._form is None:\n291:             return\n292:         form = self._form\n293:         self._form = None\n294:         self.doc.forms.append(form)\n295: \n296:     def finalize(self):\n297:         self._finish_anchor()\n298:         self._finish_row()\n299:         self._finish_form()\n300: \n301: \n302: def _parse_html(text):\n303:     reader = _HtmlReader()\n304:     reader.feed(text or '')\n305:     reader.close()\n306:     reader.finalize()\n307:     return reader.doc\n308: \n309: \n310: def _unique_url(tag):\n311:     token = f'{tag}-{uuid.uuid4().hex[:12]}'\n312:     return f'https://{token}.atlas-acceptance.example/{token}'\n313: \n314: \n315: def _safe_json(response):\n316:     try:\n317:         return response.json()\n318:     except Exception:\n319:         return None\n320: \n321: \n322: def _extract_record(payload):\n323:     if isinstance(payload, dict):\n324:         for key in ('bookmark', 'record', 'data', 'item'):\n325:             value = payload.get(key)\n326:             if isinstance(value, dict):\n327:                 return value\n328:         return payload\n329:     return None\n330: \n331: \n332: def _extract_list(payload, keys):\n333:     if isinstance(payload, list):\n334:         return payload\n335:     if isinstance(payload, dict):\n336:         for key in keys:\n337:             value = payload.get(key)\n338:             if isinstance(value, list):\n339:                 return value\n340:     return None\n341: \n342: \n343: def _record_id(record):\n344:     if isinstance(record, dict) and record.get('id') is not None:\n345:         return str(record['id'])\n346:     return None\n347: \n348: \n349: def _record_url(record):\n350:     if isinstance(record, dict) and record.get('url') is not None:\n351:         return str(record['url'])\n352:     return None\n353: \n354: \n355: def _record_title(record):\n356:     if isinstance(record, dict) and record.get('title') is not None:\n357:         return str(record['title'])\n358:     return None\n359: \n360: \n361: def _record_description(record):\n362:     if isinstance(record, dict) and record.get('description') is not None:\n363:         return str(record['description'])\n364:     return None\n365: \n366: \n367: def _bookmark_path(bookmark_id):\n368:     return '/api/bookmarks/' + urllib.parse.quote(str(bookmark_id), safe='')\n369: \n370: \n371: def _error_code(response):\n372:     payload = _safe_json(response)\n373:     if isinstance(payload, dict):\n374:         error = payload.get('error')\n375:         if isinstance(error, dict) and error.get('code') is not None:\n376:             return str(error['code'])\n377:         for key in ('code', 'error_code'):\n378:             if payload.get(key) is not None:\n379:                 return str(payload[key])\n380:     return None\n381: \n382: \n383: def _fetch_bookmarks(client, recorder, aid, params=None):\n384:     response = client.get('/api/bookmarks', params=params)\n385:     recorder.expect_status(response, 200, aid=f'{aid}-list-status')\n386:     payload = _safe_json(response)\n387:     records = _extract_list(payload, ('bookmarks', 'items', 'data', 'records'))\n388:     recorder.check(\n389:         f'{aid}-list-shape',\n390:         isinstance(records, list),\n391:         f'GET /api/bookmarks 必须返回 JSON 数组，实际 {type(payload).__name__}',\n392:     )\n393:     return records if isinstance(records, list) else []\n394: \n395: \n396: def _fetch_categories(client, recorder, aid):\n397:     response = client.get('/api/categories')\n398:     recorder.expect_status(response, 200, aid=f'{aid}-categories-status')\n399:     payload = _safe_json(response)\n400:     categories = _extract_list(payload, ('categories', 'items', 'data'))\n401:     recorder.check(\n402:         f'{aid}-categories-shape',\n403:         isinstance(categories, list),\n404:         f'GET /api/categories 必须返回 JSON 数组，实际 {type(payload).__name__}',\n405:     )\n406:     return categories if isinstance(categories, list) else []\n407: \n408: \n409: def _category_names(categories):\n410:     names = set()\n411:     for item in categories:\n412:         if isinstance(item, dict) and item.get('name') is not None:\n413:             names.add(str(item['name']))\n414:     return names\n415: \n416: \n417: def _category_name(record, categories):\n418:     if not isinstance(record, dict):\n419:         return None\n420:     names = _category_names(categories)\n421:     by_id = {}\n422:     for item in categories:\n423:         if isinstance(item, dict) and item.get('id') is not None and item.get('name') is not None:\n424:             by_id[str(item['id'])] = str(item['name'])\n425:     for key in ('category', 'category_name', 'categoryName'):\n426:         value = record.get(key)\n427:         if isinstance(value, str):\n428:             if value in names:\n429:                 return value\n430:             if value in by_id:\n431:                 return by_id[value]\n432:             return value\n433:         if isinstance(value, dict) and value.get('name') is not None:\n434:             return str(value['name'])\n435:     for key in ('category_id', 'categoryId'):\n436:         value = record.get(key)\n437:         if value is not None and str(value) in by_id:\n438:             return by_id[str(value)]\n439:     return None\n440: \n441: \n442: def _record_ids(records):\n443:     return {_record_id(record) for record in records}\n444: \n445: \n446: def _action_of(form):\n447:     return form.action or '/'\n448: \n449: \n450: def _form_fields(form, overrides=None, omit=()):\n451:     fields = {}\n452:     for field in form.fields:\n453:         name = field.name\n454:         if not name:\n455:             continue\n456:         if field.type in ('subm