   \"transport\": \"json\",\n829:       \"value_kind\": \"omitted\",\n830:       \"write_effect\": \"none\"\n831:      },\n832:      {\n833:       \"acceptance_ids\": [\n834:        \"A12\"\n835:       ],\n836:       \"code\": \"invalid_category\",\n837:       \"feature_ids\": [\n838:        \"F04\",\n839:        \"F10\"\n840:       ],\n841:       \"field\": \"category\",\n842:       \"id\": \"json.bookmark_move.category.null\",\n843:       \"implementation\": \"acceptance/p0_organize.py\",\n844:       \"operation\": \"bookmark_move\",\n845:       \"response\": \"error.code/message/field\",\n846:       \"status\": 400,\n847:       \"transport\": \"json\",\n848:       \"value_kind\": \"null\",\n849:       \"write_effect\": \"none\"\n850:      }\n851:     ],\n852:     \"schema\": \"atlas.bookmark-error-contract.v1\"\n853:    },\n854:    \"features\": [\n855:     {\n856:      \"acceptance_ids\": [\n857:       \"A01\",\n858:       \"A02\",\n859:       \"A03\"\n860:      ],\n861:      \"action\": \"填写原始 URL，可选标题/描述，选择已有归类、留为默认「未整理」或输入新归类名并提交。\",\n862:      \"design_basis\": \"场景 workflow 1–2 与验收 1/2：用户主动保存外部网页链接，记录以 URL 锚定并持久保留。\",\n863:      \"entry\": \"首页 GET / 的保存表单 form[action=/bookmarks/new]，字段 url、title、description、category。\",\n864:      \"failure\": \"非法 URL 返回 400 invalid_url，非法归类返回 400 invalid_category；HTML 同页显示 [data-testid=form-error]，不写入。\",\n865:      \"feature_id\": \"F01\",\n866:      \"navigation\": \"成功后 303 到 /?category=<归类> 或 /，浏览器显示新记录行。\",\n867:      \"recovery\": \"失败页保留已填 url/title/description/category，用户修正后重新提交；也可返回列表。\",\n868:      \"success_state\": \"303 返回首页，新记录出现在所选归类，GET /api/bookmarks/{id} 返回同一原始 URL；SQLite 行已持久化。\"\n869:     },\n870:     {\n871:      \"acceptance_ids\": [\n872:       \"A03\"\n873:      ],\n874:      \"action\": \"不另选归类直接保存；首启查看预置归类。\",\n875:      \"design_basis\": \"场景 workflow 3：未经整理的链接先进入默认归类，之后再移动；成熟产品普遍提供未被整理收件区。\",\n876:      \"entry\": \"首页保存表单的 category 字段（默认「未整理」）与侧栏/归类页的预置归类列表。\",\n877:      \"failure\": \"默认归类缺失或写入失败时返回明确错误页或 JSON 错误，不伪装成功。\",\n878:      \"feature_id\": \"F02\",\n879:      \"navigation\": \"303 到首页或未整理归类视图。\",\n880:      \"recovery\": \"重试保存；应用启动时在事务中补齐预置归类。\",\n881:      \"success_state\": \"记录的 category_id 为默认「未整理」，可在 /?category=未整理 看到；“未整理”“待购”“家居改造”“以后看看”均可见。\"\n882:     },\n883:     {\n884:      \"acceptance_ids\": [\n885:       \"A04\"\n886:      ],\n887:      \"action\": \"在真实表单提交 name 新建/重命名，提交 category_id 删除；删除默认归类被拒绝。\",\n888:      \"design_basis\": \"场景验收 3 与 workflow 2：用户可新建归类并把记录放入合适位置；源包没有 collections，属目标新设计。\",\n889:      \"entry\": \"首页 a[data-testid=category-manager] 进入 /categories；该页含 category-create-form、category-rename-form、category-delete-form。\",\n890:      \"error_branch_ids\": [\n891:       \"html.category_create.name.omitted\",\n892:       \"html.category_create.name.empty\",\n893:       \"html.category_create.name.whitespace\",\n894:       \"html.category_create.name.overlong_121\",\n895:       \"html.category_rename.name.omitted\",\n896:       \"html.category_rename.name.empty\",\n897:       \"html.category_rename.name.whitespace\",\n898:       \"html.category_rename.name.overlong_121\",\n899:       \"json.category_create.name.omitted\",\n900:       \"json.category_create.name.empty\",\n901:       \"json.category_create.name.whitespace\",\n902:       \"json.category_create.name.overlong_121\",\n903:       \"json.category_create.name.null\",\n904:       \"json.category_rename.name.omitted\",\n905:       \"json.category_rename.name.empty\",\n906:       \"json.category_rename.name.whitespace\",\n907:       \"json.category_rename.name.overlong_121\",\n908:       \"json.category_rename.name.null\"\n909:      ],\n910:      \"failure\": \"重名 409 duplicate_category、空名/超长 400 invalid_name、默认归类 400 protected_category；页面显示 form-error 且数据不变。\",\n911:      \"feature_id\": \"F03\",\n912:      \"navigation\": \"创建/重命名/删除成功后 303 到 /categories。\",\n913:      \"recovery\": \"保留已填 name/category_id 并允许改正或选择其他归类；可返回 /categories 重试。\",\n914:      \"success_state\": \"303 到 /categories；新建/重命名可见且计数正确；删除归类后其活动与软删除记录都迁回「未整理」，软删记录仍可恢复。\"\n915:     },\n916:     {\n917:      \"acceptance_ids\": [\n918:       \"A05\",\n919:       \"A12\"\n920:      ],\n921:      \"action\": \"选择目标归类（API 归类 ID）并提交；HTML 适配器把 ID 翻译为归类名后调用现有 move 服务。\",\n922:      \"design_basis\": \"场景验收 3 与 workflow 3：记录可在归类之间移动，重新打开后仍保持新归属。\",\n923:      \"entry\": \"每条 tr[data-testid=record-row] 内的 form[data-testid=record-move-form]，含 input record_id 与 select name=category_id。\",\n924:      \"error_branch_ids\": [\n925:       \"html.bookmark_save.category.empty\",\n926:       \"html.bookmark_save.category.whitespace\",\n927:       \"html.bookmark_save.category.overlong_121\",\n928:       \"html.bookmark_move.category_id.omitted\",\n929:       \"html.bookmark_move.category_id.empty\",\n930:       \"html.bookmark_move.category_id.unknown_id\",\n931:       \"json.bookmark_save.category.empty\",\n932:       \"json.bookmark_save.category.whitespace\",\n933:       \"json.bookmark_save.category.overlong_121\",\n934:       \"json.bookmark_move.category.empty\",\n935:       \"json.bookmark_move.category.whitespace\",\n936:       \"json.bookmark_move.category.overlong_121\",\n937:       \"json.bookmark_move.category.omitted\",\n938:       \"json.bookmark_move.category.null\"\n939:      ],\n940:      \"failure\": \"空/超长/非法归类 400 invalid_category，未知 record_id 404 not_found；不移动、不写入。\",\n941:      \"feature_id\": \"F04\",\n942:      \"navigation\": \"成功后 303 到 /?category=<目标归类> 或来源视图。\",\n943:      \"recovery\": \"保留选择并显示 form-error；用户改选有效归类或返回列表重试。\",\n944:      \"success_state\": \"303 回列表；记录离开原归类并出现在目标归类，JSON 的 category 与持久化结果一致。\"\n945:     },\n946:     {\n947:      \"acceptance_ids\": [\n948:       \"A06\"\n949:      ],\n950:      \"action\": \"点击归类链接或从搜索表单选择归类并查看列表。\",\n951:      \"design_basis\": \"场景验收 4：用户通过归类浏览找回记录；来源标签计数被调整为按归类聚合。\",\n952:      \"entry\": \"首页侧栏 [data-testid=category-count][data-category-id] 与归类链接；/categories 同显计数；GET /?category=<name>。\",\n953:      \"failure\": \"未知归类返回空结果而非 5xx；计数查询失败显示错误页。\",\n954:      \"feature_id\": \"F05\",\n955:      \"navigation\": \"GET /?category=... 或 GET /categories；无记录时显示明确空状态。\",\n956:      \"recovery\": \"选择其他归类或清空筛选。\",\n957:      \"success_state\": \"页面只列该归类活动记录；HTML count 与 JSON count 都等于活动（未软删）记录数；移动、删除、恢复后仍一致。\"\n958:     },\n959:     {\n960:      \"acceptance_ids\": [\n961:       \"A07\"\n962:      ],\n963:      \"action\": \"选择归类、输入关键字并提交。\",\n964:      \"design_basis\": \"场景验收 4：用户凭记得的关键字找回已存链接；来源仅搜标题，目标扩展到可识别来源的字段。\",\n965:      \"entry\": \"首页 form[data-testid=category-search-form]，字段 category（归类名）与 q；action 为 GET /。\",\n966:      \"failure\": \"无匹配不是错误（200 + 空结果）；非法请求返回可读错误且不写入。\",\n967:      \"feature_id\": \"F06\",\n968:      \"navigation\": \"GET /?category=...&q=...，同一页面更新结果。\",\n969:      \"recovery\": \"修改 q 或切换归类重新提交；清空 q 恢复归类浏览。\",\n970:      \"success_state\": \"URL 与表单保留 category 与 q；页面显示所选归类、保留查询和匹配行；同一关键字在两个归类分别命中各自记录；无匹配显示明确空结果；JSON 返回匹配集。\"\n971:     },\n972:     {\n973:      \"acceptance_ids\": [\n974:       \"A08\"\n975:      ],\n976:      \"action\": \"用户点击打开链接。\",\n977:      \"design_basis\": \"场景验收 2 与 workflow 5：打开记录即回到保存时的外部网页，库只保证引用而非内容。\",\n978:      \"entry\": \"记录行 a[data-testid=record-open-link] 与 GET /go/{id}。\",\n979:      \"failure\": \"未知 id 404 not_found；目标不可达不影响库中记录可读。\",\n980:      \"feature_id\": \"F07\",\n981:      \"navigation\": \"浏览器导航到原始 URL（新标签）；服务端只发 302。\",\n982:      \"recovery\": \"返回收藏列表选择其他记录；如 URL 有误，可由现有 PATCH API 更新并重算 hostname。\",\n983:      \"success_state\": \"链接 href 恰为保存时原始 URL，target=_blank、rel 含 noopener；GET /go/{id} 302 Location 为同一字符串；P0 不请求目标页。\"\n984:     },\n985:     {\n986:      \"acceptance_ids\": [\n987:       \"A01\",\n988:       \"A05\",\n989:       \"A09\"\n990:      ],\n991:      \"action\": \"执行真实写操作，停止应用进程，再以同一实例目录重启并读取。\",\n992:      \"design_basis\": \"场景验收 1：主动保存的链接在多次会话之间持久保留；目标以 SQLite 实现本地单用户持久化。\",\n993:      \"entry\": \"保存、移动、删除/恢复等写操作后重新请求页面；重启适配器从同一 app_root 与实例数据目录启动。\",\n994:      \"failure\": \"数据库不可写或损坏时返回明确 5xx 错误页而非成功假象；事务回滚保持旧状态。\",\n995:      \"feature_id\": \"F08\",\n996:      \"navigation\": \"无自动导航；下次 GET / 读取持久状态。\",\n997:      \"recovery\": \"恢复可写数据目录后重试；重启应用重新初始化 schema。\",\n998:      \"success_state\": \"重启后 id、原始 URL、标题、描述、归类与 trashed 状态与写入后一致；HTML 与 JSON 都来自 SQLite。\"\n999:     },\n1000:     {\n1001:      \"acceptance_ids\": [\n1002:       \"A09\"\n1003:      ],\n1004:      \"action\": \"提交 record_id 软删除；在回收站提交 record_id 恢复。\",\n1005:      \"design_basis\": \"场景要求可恢复的失败；来源仅有归档记录的瞬时 Undo，目标改为显式软删除与恢复。\",\n1006:      \"entry\": \"记录行 form[data-testid=record-delete-form]；GET /?trash=1 的软删记录行 form[data-testid=record-restore-form]。\",\n1007:      \"failure\": \"未知 record_id 404 not_found；失败不改变 trashed_at，不产生 5xx。\",\n1008:      \"feature_id\": \"F09\",\n1009:      \"navigation\": \"删除成功 303 到 /?trash=1；恢复成功 303 到恢复后归类。\",\n1010:      \"recovery\": \"回收站提供可提交的恢复表单；失败可重试或返回列表。\",\n1011:      \"success_state\": \"默认视图与计数排除软删记录，回收站仍显示；恢复后原始字段与归类回归并重新可见；归类删除后软删记录仍在「未整理」可恢复。\"\n1012:     },\n1013:     {\n1014:      \"acceptance_ids\": [\n1015:       \"A02\",\n1016:       \"A10\",\n1017:       \"A12\"\n1018:      ],\n1019:      \"action\": \"提交非法 URL、空/超长/非法归类、畸形 JSON 或未知 ID。\",\n1020:      \"design_basis\": \"场景要求非法输入可恢复；源表单校验被调整为服务端 HTML 表单与 JSON API 共用的显式错误合同。\",\n1021:      \"entry\": \"所有 HTML 表单（保存、归类、移动、删除、恢复、搜索）与 JSON API 端点。\",\n1022:      \"error_branch_ids\": [\n1023:       \"html.bookmark_save.category.empty\",\n1024:       \"html.bookmark_save.category.whitespace\",\n1025:       \"html.bookmark_save.category.overlong_121\",\n1026:       \"html.bookmark_move.category_id.omitted\",\n1027:       \"html.bookmark_move.category_id.empty\",\n1028:       \"html.bookmark_move.category_id.unknown_id\",\n1029:       \"json.bookmark_save.category.empty\",\n1030:       \"json.bookmark_save.category.whitespace\",\n1031:       \"json.bookmark_save.category.overlong_121\",\n1032:       \"json.bookmark_move.category.empty\",\n1033:       \"json.bookmark_move.category.whitespace\",\n1034:       \"json.bookmark_move.category.overlong_121\",\n1035:       \"json.bookmark_move.category.omitted\",\n1036:       \"json.bookmark_move.category.null\"\n1037:      ],\n1038:      \"failure\": \"出现 5xx、静默写入或不可恢复的错误页即视为失败。\",\n1039:      \"feature_id\": \"F10\",\n1040:      \"navigation\": \"HTML 错误留在当前表单页并保留输入；JSON 无导航。\",\n1041:      \"recovery\": \"修正字段后重新提交；失败页保留可运行的表单或返回链接。\",\n1042:      \"success_state\": \"错误路径本身成功执行：JSON 返回 400/404/409 与结构化错误码，HTML 返回 400/409 与 form-error；畸形 JSON 为 bad_request；均无 5xx、无写入。\"\n1043:     },\n1044:     {\n1045:      \"acceptance_ids\": [\n1046:       \"A11\"\n1047:      ],\n1048:      \"action\": \"首启或空库时打开首页。\",\n1049:      \"design_basis\": \"场景是单用户本地工具，需要可打开的应用入口；目标采用 Python 服务端渲染外壳而非来源 SPA。\",\n1050:      \"entry\": \"GET / 与 GET /api/health。\",\n1051:      \"failure\": \"健康检查非 200/非 JSON、首页 5xx 或缺少表单时显式失败。\",\n1052:      \"feature_id\": \"F11\",\n1053:      \"navigation\": \"无自动导航（首页即入口）；可进入 /categories 或归类筛选。\",\n1054:      \"recovery\": \"启动或重启应用；修复后刷新首页。\",\n1055:      \"success_state\": \"200 text/html；含保存表单 name=url、归类管理链接、记录列表/空状态容器；预置归类与空库不报错；health 200 JSON。\"\n1056:     }\n1057:    ],\n1058:    \"review_rules_version\": \"atlas.current-required-contract.v1\",\n1059:    \"schema\": \"atlas.contract-coverage.v1\"\n1060:   },\n1061:   \"decisions\": [\n1062:    {\n1063:     \"default\": \"单选归类（bookmark.category_id 标量外键）。场景流程明确“选择一个简单归类”，单归属让移动、计数与浏览语义无歧义；未来若需多值可迁移到关联表而不丢数据。\",\n1064:     \"id\": \"D01\",\n1065:     \"impact\": \"决定数据模型（标量外键 vs 关联表）以及浏览、计数与检索的实现路径。\",\n1066:     \"question\": \"记录应归属于单一“归类”，还是允许像标签一样同时属于多个？\",\n1067:     \"status\": \"decided\",\n1068:     \"when_to_ask\": \"当真实用户反馈同一条记录必须同时属于多个主题，或需要跨主题交叉检索时再评估多标签。\"\n1069:    },\n1070:    {\n1071:     \"default\": \"落入默认“未整理”，保存始终成功。场景流程第3步要求未经整理的链接可先进入默认归类，快速保存不应打断浏览。\",\n1072:     \"id\": \"D02\",\n1073:     \"impact\": \"决定保存接口是否允许缺省 category，以及首启预置数据内容。\",\n1074:     \"question\": \"保存时不选归类，应阻止保存还是落入默认“未整理”？\",\n1075:     \"status\": \"decided\",\n1076:     \"when_to_ask\": \"当目标用户群要求强制归类（例如团队共享库）时再改为必选。\"\n1077:    },\n1078:    {\n1079:     \"default\": \"自动创建（名称大小写不敏感去重），重名则复用现有归类；保持保存流程不中断。\",\n1080:     \"id\": \"D03\",\n1081:     \"impact\": \"决定 categories 的唯一约束、写入事务边界与 409/400 的语义；HTML 归类表单与 JSON API 共用服务层，重名、非法名与默认归类保护都不得产生部分写入。\",\n1082:     \"question\": \"在保存或移动界面输入一个尚不存在的归类名，应自动创建还是报错？\",\n1083:     \"status\": \"decided\",\n1084:     \"when_to_ask\": \"当出现拼写错误导致归类碎片化的证据时，改为只允许从既有归类中选择。\"\n1085:    },\n1086:    {\n1087:     \"default\": \"软删除：记录标记 trashed_at，默认视图排除，提供撤销恢复；场景要求可恢复的失败。\",\n1088:     \"id\": \"D04\",\n1089:     \"impact\": \"决定数据模型的 trashed_at 列、默认列表过滤条件、/restore 恢复路径，以及删除归类时活动与软删记录同迁默认归类；不引入 purge 或永久删除接口。\",\n1090:     \"question\": \"删除是立即物理删除，还是软删除到可恢复区并支持短时撤销？\",\n1091:     \"status\": \"decided\",\n[Output truncated. Continue reading with offset: 1092]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file source/SPECIFICATION.json, lines 1-1091\n1: {\n2:  \"file_plan\": [\n3:   {\n4:    \"path\": \"acceptance/common.py\",\n5:    \"purpose\": \"复用的共享验收工具，保持固定字节不变。导入约定：各阶段程序通过 os.path.dirname(os.path.abspath(__file__)) 自举 sys.path 后 import common，不依赖工作目录。导出：常量 DEFAULT_CATEGORY、PRESET_CATEGORIES、RESULT_SCHEMA；HttpClient(base_url) 及 get/post_form/post_json/patch_json/request，限定精确 origin、拒绝认证头与跨源重定向，返回 HttpResponse（status、headers、body、text、json()、location）；Recorder（check、expect_status、expect_json_field、finish）；parse_case_args（--case/--base-url/--app-root/--data-dir，含必需项校验）；launch_app(app_root,data_dir,port,instance_dir=...,fresh=...)、stop_app、wait_health、free_port；异常 AcceptanceError/AppStartError/ExternalNavigationBlocked/HttpRequestError；emit_result。执行契约：真实 HTTP 与真实进程重启适配器；app_root 只读，data_dir 为测试草稿根，每实例数据库位于 data_dir/instances/<uuid>；不导入应用代码、不读取应用自测判定。\",\n6:    \"reuse\": true\n7:   },\n8:   {\n9:    \"path\": \"acceptance/p0_library.py\",\n10:    \"purpose\": \"P0 第一组：A01、A02、A03、A11。导入 common 与标准库 urllib、html.parser、uuid、re；文件内自带轻量 HTML 读取器，收集 form/input/select/textarea、data-testid、文本与链接，不新增共享文件。A01：对 --base-url 用真实保存表单提交 URL/标题/描述并跟随 303，读回 HTML 行与 JSON；再用 --app-root/--data-dir 启动隔离实例，经真实表单保存，停止后同一实例子目录重启，断言 id、原始 URL、标题与描述稳定。A02：用保存表单提交单标签主机 URL（如 http://atlas-a02-xxxx）作为显式正向边界，断言 303、原始字符串持久化且行内 href 精确；用同一表单和 JSON 分别提交缺协议、javascript:、ftp://、http:// 空主机、含空格/非法 hostname 的值，断言 400 invalid_url、form-error 可读、相对计数不新增且被拒 URL 不出现在列表。A03：HTML 与 API 检查四个预置归类；真实表单省略 category 保存落入未整理；表单输入新归类名保存后自动创建并可筛选。A11：/api/health 200 JSON；GET / 200 text/html，含 action=/bookmarks/new 表单、name=url、category-manager 链接、列表容器；用不存在的归类过滤得到明确空状态。导出 _HANDLERS 与 main(argv)；只接受本组 case，未知 case 输出 dispatch=false 并非零退出；stdout 单个结果 JSON。\",\n11:    \"reuse\": false\n12:   },\n13:   {\n14:    \"error_branch_ids\": [\n15:     \"html.category_create.name.omitted\",\n16:     \"html.category_create.name.empty\",\n17:     \"html.category_create.name.whitespace\",\n18:     \"html.category_create.name.overlong_121\",\n19:     \"html.category_rename.name.omitted\",\n20:     \"html.category_rename.name.empty\",\n21:     \"html.category_rename.name.whitespace\",\n22:     \"html.category_rename.name.overlong_121\",\n23:     \"html.bookmark_save.category.empty\",\n24:     \"html.bookmark_save.category.whitespace\",\n25:     \"html.bookmark_save.category.overlong_121\",\n26:     \"html.bookmark_move.category_id.omitted\",\n27:     \"html.bookmark_move.category_id.empty\",\n28:     \"html.bookmark_move.category_id.unknown_id\",\n29:     \"json.category_create.name.omitted\",\n30:     \"json.category_create.name.empty\",\n31:     \"json.category_create.name.whitespace\",\n32:     \"json.category_create.name.overlong_121\",\n33:     \"json.category_create.name.null\",\n34:     \"json.category_rename.name.omitted\",\n35:     \"json.category_rename.name.empty\",\n36:     \"json.category_rename.name.whitespace\",\n37:     \"json.category_rename.name.overlong_121\",\n38:     \"json.category_rename.name.null\",\n39:     \"json.bookmark_save.category.empty\",\n40:     \"json.bookmark_save.category.whitespace\",\n41:     \"json.bookmark_save.category.overlong_121\",\n42:     \"json.bookmark_move.category.empty\",\n43:     \"json.bookmark_move.category.whitespace\",\n44:     \"json.bookmark_move.category.overlong_121\",\n45:     \"json.bookmark_move.category.omitted\",\n46:     \"json.bookmark_move.category.null\"\n47:    ],\n48:    \"path\": \"acceptance/p0_organize.py\",\n49:    \"purpose\": \"P0 第二组：A04、A05、A06、A12。导入 common；文件内自带 HTML 表单解析器与 JSON 读取助手。A04：从首页点击 a[data-testid=category-manager] 进入 /categories；用 category-create-form 的真实 name 输入新建，303 后可见且计数正确；用重名及大小写变体提交 create/rename 表单，断言 409 duplicate_category、form-error、输入保留且集合不变；用 category-rename-form 提交 category_id+name 重命名，记录跟随；用 category-delete-form 删除归类，断言活动与软删记录都迁回未整理、软删记录在 /?trash=1 可恢复；用表单对默认归类做 rename/delete，断言 400 protected_category 且不变；同时保留 JSON API 的同等断言。用 category-create-form 与 category-rename-form 分别提交省略 name、空字符串、纯空白、121 字符名，均断言 400 invalid_name、form-error、提交值保留、分类与记录集合及归属不变；JSON POST/PATCH name 各自验证同组及显式 null，错误码 invalid_name 且零写入；A05：用 record-move-form 的真实 record_id 与 select category_id 移动，303 后旧归类消失、新归类可见、JSON 读回归类正确；再用 --app-root/--data-dir 启动隔离实例，经真实表单移动，停止后同目录重启读回归属。A06：两个归类各两条记录，读取 HTML [data-testid=category-count][data-category-id] 与记录行，并与 /api/categories 的 count 和 /api/bookmarks 列表比对；通过真实移动、删除、恢复表单改变状态，逐步断言 count 只计活动记录且与列表一致。A12：只处理书签保存/移动，不使用分类创建或重命名表单。HTML 保存 category（名称）显式空/纯空白/121 字符 invalid_category，省略则默认未整理；HTML 移动 category_id（ID）省略/空/未知 invalid_category；JSON 保存 category（名称）省略/null 默认未整理，显式空/纯空白/121 字符 invalid_category；JSON move category（名称）省略/null/空/纯空白/121 字符 invalid_category。有效新名称可自动创建；HTML 未知 ID 不得变为新名称；JSON 不新增 category_id 字段。每个负向 HTML 为 400/form-error/输入保留，JSON 为 400/error.code=invalid_category，分类集合/记录集合/锚点归属均不变；修正有效值可恢复。导出 _HANDLERS 与 main(argv)；A05 需要 --app-root/--data-dir，其余仅 --base-url；未知 case 显式失败。\",\n50:    \"reuse\": false\n51:   },\n52:   {\n53:    \"path\": \"acceptance/p0_find_open.py\",\n54:    \"purpose\": \"P0 第三组：A07、A08。导入 common；文件内自带 HTML 解析器。A07：创建两个归类及记录；用真实 category-search-form 提交 category 与 q，断言 200、表单的 category 与 q 值均保留、页面显示所选归类/查询/匹配行；用同一关键字分别在两个归类提交，断言各自只命中本归类记录；在某归类提交无匹配 q，断言显示明确空结果且无记录行；同时保留 JSON 断言：标题、hostname、描述的子串大小写不敏感命中，category+q 叠加，无匹配返回 200 空数组。A08：经真实保存表单创建带 query 的原始 URL，解析 tr[data-record-id] 内 a[data-testid=record-open-link]，断言 href 精确等于保存值、target=_blank、rel 含 noopener，并以 urljoin 验证它是实际导航目标；再 GET /go/{id} 不跟随重定向，断言 302 Location 精确等于原始 URL；未知 id 404 not_found；读回记录 URL 未被改写。导出 _HANDLERS 与 main(argv)；仅 --base-url；未实现 case 显式失败。\",\n55:    \"reuse\": false\n56:   },\n57:   {\n58:    \"path\": \"acceptance/p0_recovery.py\",\n59:    \"purpose\": \"P0 第四组：A09、A10。导入 common；文件内自带 HTML 表单解析器。A09：经真实保存表单创建记录，用 record-delete-form 软删除并跟随 303，断言默认列表/计数排除、/api/bookmarks?include_trashed=1 仍存在、/?trash=1 显示 record-restore-form；用该表单恢复，断言 URL/标题/描述/归类回归且重新可见；再创建归类与记录、软删除记录后用 category-delete-form 删除归类，断言软删记录迁到未整理且仍可在回收站恢复，恢复后无孤儿；最后用 --app-root/--data-dir 启动隔离实例，真实删除后停止、同目录重启，断言删除状态与回收站内容保持，并可恢复。A10：JSON 路径保留未知 id 的 GET/PATCH/DELETE/move 均 404 not_found，三类畸形 JSON 均 400 bad_request，无 5xx、记录集合与锚点字段不变；HTML 路径用保存表单提交非法 URL，断言 400、form-error、url/title 输入保留、无新增记录，再用同一表单提交修正 URL 断言 303 且只新增一条；用归类表单提交非法 name，断言 form-error 且无写入。导出 _HANDLERS 与 main(argv)；A09 需要 --app-root/--data-dir，A10 仅 --base-url；未实现 case 显式失败。\",\n60:    \"reuse\": false\n61:   },\n62:   {\n63:    \"path\": \"acceptance/p1_maturity.py\",\n64:    \"purpose\": \"P1 组 A13、A14、A15 的既有程序，保持固定字节不变：A13 离线保存、hostname 派生与本地降级；A14 Netscape 导出及导入计数/检索；A15 P1 重复 URL 的 409 与 allow_duplicate。继续导入 common，导出 _HANDLERS 与 main(argv)，不依赖 P0 新表单断言，也不改变 P1/A15 范围。\",\n65:    \"reuse\": true\n66:   },\n67:   {\n68:    \"path\": \"acceptance/requirements.txt\",\n69:    \"purpose\": \"依赖声明，保持固定字节不变：Python 3.12，仅标准库（http.server、sqlite3、urllib、json、html.parser），无第三方包；安装步骤为空，不执行 pip，不访问包索引；不含凭据、令牌或私有 URL。\",\n70:    \"reuse\": true\n71:   },\n72:   {\n73:    \"path\": \"acceptance/README.md\",\n74:    \"purpose\": \"完整运行说明，保持固定字节以外的新版内容：记录 profile=python-web 与 Python 3.12 标准库要求；说明 --base-url 精确 origin、--app-root 只读、--data-dir 草稿根及每实例 instances/<uuid> 隔离；列明 A01–A15 的程序、必要 flags 与 runner 一一对应关系；说明 HTML 表单验收契约（data-testid 清单、name/category_id/record_id/category/q 字段、303 导航、400/409 form-error 与保留输入）、A02 单标签主机正向策略、归类删除迁移活动+软删记录、count 只计活动记录、category+q 搜索保留、/go 不跟随重定向、P0 不抓取外链；说明认证不支持时显式失败、不记录凭据、外部网络限制；给出 stdout 结果 schema、退出码、64000 字符限制；给出根 delivery.json 示例（schema atlas.application-delivery.v1、root '.'、python-web、install/build 空、start 字面 argv、port 8000、/state/app-data）；明确本套件未执行、不得声称通过。\",\n75:    \"reuse\": false\n76:   },\n77:   {\n78:    \"path\": \"acceptance/runner.json\",\n79:    \"purpose\": \"独立执行绑定，保持固定字节不变且位于最后：schema=atlas.acceptance-runner.v1，result_schema=atlas.acceptance-result.v1；A01、A05、A09 绑定 --case/--base-url/--app-root/--data-dir；A14 绑定 --case/--base-url/--data-dir；其余 A02–A04、A06–A08、A10–A13、A15 绑定 --case/--base-url。每个规范验收 ID 恰好出现一次，args 仅使用 Atlas 允许的字面量与占位符，与各程序 parse_case_args 的真实 flags 一致。\",\n80:    \"reuse\": true\n81:   }\n82:  ],\n83:  \"spec\": {\n84:   \"acceptance\": [\n85:    {\n86:     \"features\": [\n87:      \"F01\",\n88:      \"F08\"\n89:     ],\n90:     \"goal\": \"保存一条链接后，同进程与重启后的新进程都能读到该记录，且 id 与内容稳定。\",\n91:     \"id\": \"A01\",\n92:     \"implementation\": \"acceptance/p0_library.py\",\n93:     \"phase\": \"P0\",\n94:     \"status\": \"not_run\",\n95:     \"type\": \"positive\"\n96:    },\n97:    {\n98:     \"features\": [\n99:      \"F01\",\n100:      \"F10\"\n101:     ],\n102:     \"goal\": \"保存表单与 JSON 均接受绝对可解析的 http/https URL（含单标签主机，如 http://localhost）并保留原始字符串；缺协议、非 http/https、空/非法 hostname 被拒绝为 400 invalid_url，且库中不新增记录。\",\n103:     \"id\": \"A02\",\n104:     \"implementation\": \"acceptance/p0_library.py\",\n105:     \"phase\": \"P0\",\n106:     \"status\": \"not_run\",\n107:     \"type\": \"negative\"\n108:    },\n109:    {\n110:     \"features\": [\n111:      \"F01\",\n112:      \"F02\"\n113:     ],\n114:     \"goal\": \"不选归类保存时记录落入“未整理”，保存时给出的新归类名被自动创建，首启可见预置归类。\",\n115:     \"id\": \"A03\",\n116:     \"implementation\": \"acceptance/p0_library.py\",\n117:     \"phase\": \"P0\",\n118:     \"status\": \"not_run\",\n119:     \"type\": \"positive\"\n120:    },\n121:    {\n122:     \"features\": [\n123:      \"F03\"\n124:     ],\n125:     \"goal\": \"通过真实归类页表单完成新建、重命名、删除：重名、非法名与默认归类保护给出可读 form-error 且不改数据；删除归类后活动与软删除记录都迁回“未整理”，软删记录仍可恢复。 新建与重命名各自通过 HTML 和 JSON 验证 name 省略、空字符串、纯空白和 121 字符（JSON 另测 null）均为 400 invalid_name；保留全部重名、保护、迁移与恢复断言。\",\n126:     \"id\": \"A04\",\n127:     \"implementation\": \"acceptance/p0_organize.py\",\n128:     \"phase\": \"P0\",\n129:     \"status\": \"not_run\",\n130:     \"type\": \"positive\"\n131:    },\n132:    {\n133:     \"features\": [\n134:      \"F04\",\n135:      \"F08\"\n136:     ],\n137:     \"goal\": \"在给定的 base_url 目标把记录从“未整理”移动到另一归类，并用独立实例证明该归属跨重启仍然有效。\",\n138:     \"id\": \"A05\",\n139:     \"implementation\": \"acceptance/p0_organize.py\",\n140:     \"phase\": \"P0\",\n141:     \"status\": \"not_run\",\n142:     \"type\": \"positive\"\n143:    },\n144:    {\n145:     \"features\": [\n146:      \"F05\"\n147:     ],\n148:     \"goal\": \"通过真实归类页/记录表单浏览与计数：侧栏与接口的 count 只计活动记录，并在移动、软删除、恢复后与实际列表和 JSON 保持一致。\",\n149:     \"id\": \"A06\",\n150:     \"implementation\": \"acceptance/p0_organize.py\",\n151:     \"phase\": \"P0\",\n152:     \"status\": \"not_run\",\n153:     \"type\": \"positive\"\n154:    },\n155:    {\n156:     \"features\": [\n157:      \"F06\"\n158:     ],\n159:     \"goal\": \"从真实归类页提交 category 与 q：页面保留所选归类与查询并显示匹配/明确空结果；同一关键字在两个归类分别命中各自记录，且 JSON 检索仍覆盖标题、域名与描述、大小写不敏感。\",\n160:     \"id\": \"A07\",\n161:     \"implementation\": \"acceptance/p0_find_open.py\",\n162:     \"phase\": \"P0\",\n163:     \"status\": \"not_run\",\n164:     \"type\": \"positive\"\n165:    },\n166:    {\n167:     \"features\": [\n168:      \"F07\"\n169:     ],\n170:     \"goal\": \"打开记录跳转到保存时的原始 URL（302 Location 等于保存值），未知 id 返回 404。\",\n171:     \"id\": \"A08\",\n172:     \"implementation\": \"acceptance/p0_find_open.py\",\n173:     \"phase\": \"P0\",\n174:     \"status\": \"not_run\",\n175:     \"type\": \"positive\"\n176:    },\n177:    {\n178:     \"features\": [\n179:      \"F08\",\n180:      \"F09\"\n181:     ],\n182:     \"goal\": \"通过真实记录表单软删除并恢复：默认视图排除、回收站可见、恢复后字段与归类回归；删除归类时软删记录迁回“未整理”仍可恢复，且删除状态跨重启保持。\",\n183:     \"id\": \"A09\",\n184:     \"implementation\": \"acceptance/p0_recovery.py\",\n185:     \"phase\": \"P0\",\n186:     \"status\": \"not_run\",\n187:     \"type\": \"positive\"\n188:    },\n189:    {\n190:     \"features\": [\n191:      \"F10\"\n192:     ],\n193:     \"goal\": \"未知 id 与畸形 JSON 返回结构化错误（bad_request/not_found）且不产生 5xx、不改变数据；真实表单的非法 URL 显示可读 form-error、保留输入，并在修正后成功保存。\",\n194:     \"id\": \"A10\",\n195:     \"implementation\": \"acceptance/p0_recovery.py\",\n196:     \"phase\": \"P0\",\n197:     \"status\": \"not_run\",\n198:     \"type\": \"negative\"\n199:    },\n200:    {\n201:     \"features\": [\n202:      \"F11\"\n203:     ],\n204:     \"goal\": \"健康检查返回就绪，首页外壳在空库下渲染录入表单与列表容器，入口不报错。\",\n205:     \"id\": \"A11\",\n206:     \"implementation\": \"acceptance/p0_library.py\",\n207:     \"phase\": \"P0\",\n208:     \"status\": \"not_run\",\n209:     \"type\": \"positive\"\n210:    },\n211:    {\n212:     \"features\": [\n213:      \"F04\",\n214:      \"F10\"\n215:     ],\n216:     \"goal\": \"仅验证书签保存与移动的非法归类：HTML 保存使用归类名 category，HTML 移动使用归类 ID category_id；JSON 保存/移动使用归类名 category。非法归类 400 invalid_category，HTML 显示可读 form-error 并保留提交值，JSON 返回结构化错误；归类集合、记录集合与被移动记录归属均不变。保存省略 category（JSON 另含 null）进入未整理，不作为非法值；移动省略值/JSON null、显式空值/纯空白/超长归类名，以及 HTML 移动空/未知 category_id 为非法。有效新归类名保存或 JSON 移动时自动创建，不把未知 ID 当作名称。分类创建/重命名 name 的 invalid_name 分支仅属 A04。\",\n217:     \"id\": \"A12\",\n218:     \"implementation\": \"acceptance/p0_organize.py\",\n219:     \"phase\": \"P0\",\n220:     \"status\": \"not_run\",\n221:     \"type\": \"negative\"\n222:    },\n223:    {\n224:     \"features\": [\n225:      \"F12\"\n226:     ],\n227:     \"goal\": \"外部网络不可用时保存仍然成功，图标与标题降级为本地派生结果，缺失增强不阻塞或报错。\",\n228:     \"id\": \"A13\",\n229:     \"implementation\": \"acceptance/p1_maturity.py\",\n230:     \"phase\": \"P1\",\n231:     \"status\": \"not_run\",\n232:     \"type\": \"positive\"\n233:    },\n234:    {\n235:     \"features\": [\n236:      \"F13\"\n237:     ],\n238:     \"goal\": \"导出为浏览器书签 HTML 可包含已存记录，且导入该 HTML 后相应记录可再次检索到。\",\n239:     \"id\": \"A14\",\n240:     \"implementation\": \"acceptance/p1_maturity.py\",\n241:     \"phase\": \"P1\",\n242:     \"status\": \"not_run\",\n243:     \"type\": \"positive\"\n244:    },\n245:    {\n246:     \"features\": [\n247:      \"F14\"\n248:     ],\n249:     \"goal\": \"重复 URL 默认被拒绝（409 duplicate_url）且库不变；显式允许重复时可新增第二条。\",\n250:     \"id\": \"A15\",\n251:     \"implementation\": \"acceptance/p1_maturity.py\",\n252:     \"phase\": \"P1\",\n253:     \"status\": \"not_run\",\n254:     \"type\": \"negative\"\n255:    }\n256:   ],\n257:   \"architecture_markdown\": \"# 架构与契约\\n\\n## 默认技术栈与理由\\n\\n- 交付 profile：python-web。Python 3.12 标准库（http.server、sqlite3、urllib、json、html.parser），零第三方依赖；服务端渲染 HTML 表单，JSON API 与 HTML 适配器共用同一服务层。\\n- 备选 Flask/FastAPI 需安装依赖；Node + IndexedDB/SPA 需 npm/浏览器工具且把数据放在浏览器 profile。二者与离线、可独立验收、单用户本地库的约束冲突，故不采用。\\n- 数据文件位于应用 `--data-dir/bookmarks.sqlite3`；验收的每实例隔离目录由测试适配器创建，测试者 `--data-dir` 根目录不是应用数据库。\\n- 单用户、本地优先；无认证、无云同步。日常绑定 127.0.0.1；仅隔离验收网络使用 0.0.0.0。\\n\\n## 数据模型（SQLite）\\n\\n- `schema_meta(version INTEGER)`：迁移版本单行。启动时在一个事务内创建/升级 schema，v1 建表并写入预置归类；版本演进只通过事务化迁移，不回退、不依赖客户端存储。\\n- `categories(id TEXT PRIMARY KEY, name TEXT NOT NULL UNIQUE COLLATE NOCASE, is_default INTEGER NOT NULL DEFAULT 0, position INTEGER NOT NULL, created_at INTEGER NOT NULL)`：首启预置「未整理」(is_default=1)、「待购」、「家居改造」、「以后看看」。\\n- `bookmarks(id TEXT PRIMARY KEY, url TEXT NOT NULL, hostname TEXT NOT NULL, title TEXT NULL, description TEXT NULL, category_id TEXT NOT NULL REFERENCES categories(id), favicon_url TEXT NULL, created_at INTEGER NOT NULL, updated_at INTEGER NOT NULL, trashed_at INTEGER NULL)`。\\n- 索引：category_id、created_at、hostname；url 不设唯一索引。P1/F14 的重复检测由服务层查询活动记录完成；P0 不启用重复拒绝。\\n- trashed_at 为 NULL 表示活动记录；非 NULL 为软删除。默认列表与计数只统计 trashed_at IS NULL；恢复清空 trashed_at。删除归类在单一事务内把该归类下的活动记录与软删除记录都改到默认归类，因此恢复不会产生无归类记录。\\n- 排序固定为 created_at DESC、id ASC；category 与 q 只作请求参数，不落库。\\n\\n## URL 策略\\n\\n- 记录 URL 必须是绝对、可解析的 HTTP(S) URL，且 hostname 有效且非空。单标签主机（如 http://localhost）与 IP 字面量均有效；不做 DNS 查询、可达性检查或目标页抓取。\\n- 保存与打开都保留用户提交的原始字符串（不补斜杠、不改大小写、不重写路径）；hostname 由解析结果派生。若 PATCH 更新 URL，必须用新 URL 重新派生 hostname。\\n- 拒绝：缺少 scheme、非 http/https、缺少/非法 hostname、无法解析的字符串；返回 400 invalid_url 且不写入。\\n- 上游 S04 的点域名正则与 S08 getHostname 是源观察，映射为 adjusted：点不是通用 URL 有效性要求；target 采用上述解析策略。\\n- 保存、打开、抓取三者分离：P0 保存与列表均不请求目标页；打开只产生浏览器导航或 /go 302。\\n\\n## API、错误与状态合同\\n\\n- `GET /api/health` → 200 JSON，含就绪与 schema 版本。\\n- `GET /api/categories` → 200 数组，每项 id、name、count、is_default；count 只计活动记录。\\n- `POST /api/categories` name → 201；重名 409 duplicate_category；空名或超过 120 字符 400 ... (line truncated to 2000 chars)\n258:   \"contract_coverage\": {\n259:    \"error_contract\": {\n260:     \"branches\": [\n261:      {\n262:       \"acceptance_ids\": [\n263:        \"A04\"\n264:       ],\n265:       \"code\": \"invalid_name\",\n266:       \"feature_ids\": [\n267:        \"F03\"\n268:       ],\n269:       \"field\": \"name\",\n270:       \"id\": \"html.category_create.name.omitted\",\n271:       \"implementation\": \"acceptance/p0_organize.py\",\n272:       \"operation\": \"category_create\",\n273:       \"response\": \"form-error and submitted values retained\",\n274:       \"status\": 400,\n275:       \"transport\": \"html\",\n276:       \"value_kind\": \"omitted\",\n277:       \"write_effect\": \"none\"\n278:      },\n279:      {\n280:       \"acceptance_ids\": [\n281:        \"A04\"\n282:       ],\n283:       \"code\": \"invalid_name\",\n284:       \"feature_ids\": [\n285:        \"F03\"\n286:       ],\n287:       \"field\": \"na