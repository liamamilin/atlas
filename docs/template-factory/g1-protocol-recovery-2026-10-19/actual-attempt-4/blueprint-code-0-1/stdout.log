{"type":"tool_use","timestamp":1792433718142,"sessionID":"ses_eaaa01f8affesgSTHulR12a46T","part":{"partID":"prt_15560025d001X9nernZ4VJFOBO","sessionID":"ses_eaaa01f8affesgSTHulR12a46T","messageID":"msg_1555ff826001xOi88W8iM4MXqZ","type":"tool","id":"call_00_3fdeblfdtgn98h30jgpb5wfn","tool":"read","state":{"status":"completed","input":{"path":"/Users/milin/2026/软件开发/application-atlas/application-atlas-production-pack/atlas/template-factory/jobs/job_7742b1c124be4c9ab3a0096da5cdd772/attempt-4/blueprint-code-0-1/source/previous/acceptance/p0_library.py"},"output":"Read file /Users/milin/2026/软件开发/application-atlas/application-atlas-production-pack/atlas/template-factory/jobs/job_7742b1c124be4c9ab3a0096da5cdd772/attempt-4/blueprint-code-0-1/source/previous/acceptance/p0_library.py, lines 1-366\n1: #!/usr/bin/env python3\n2: '''P0 行为验收组：保存、校验、默认收件箱、启动外壳。\n3: \n4: 覆盖 A01、A02、A03、A11。仅使用 Python 3.12 标准库并复用\n5: acceptance/common.py：以 --case 派发，未知用例显式失败；每个用例对真实\n6: 目标执行正向与硬负向行为断言，向 stdout 输出单个\n7: atlas.acceptance-result.v1 JSON，失败时以非零码退出。\n8: '''\n9: \n10: from __future__ import annotations\n11: \n12: import os\n13: import re\n14: import sys\n15: import uuid\n16: from urllib.parse import quote\n17: \n18: _THIS_DIR = os.path.dirname(os.path.abspath(__file__))\n19: if _THIS_DIR not in sys.path:\n20:     sys.path.insert(0, _THIS_DIR)\n21: \n22: import common\n23: \n24: _ENTRY_FORM_RE = re.compile(r'<form\\b[^>]*\\baction\\s*=\\s*[\\x22\\x27]?/bookmarks/new\\b', re.IGNORECASE)\n25: _URL_FIELD_RE = re.compile(r'<input\\b[^>]*\\bname\\s*=\\s*[\\x22\\x27]?url\\b', re.IGNORECASE)\n26: _LIST_CONTAINER_RE = re.compile(\n27:     r'<ul\\b|<ol\\b'\n28:     r'|<(?:div|main|section|article|aside)\\b[^>]*\\b(?:id|class)\\s*=\\s*[\\x22\\x27][^\\x22\\x27]*'\n29:     r'(?:bookmarks?|lists?|records?)\\b',\n30:     re.IGNORECASE,\n31: )\n32: \n33: \n34: def _unique_url(tag):\n35:     token = f'{tag}-{uuid.uuid4().hex[:12]}'\n36:     return f'https://{token}.atlas-acceptance.example/{token}'\n37: \n38: \n39: def _safe_json(response):\n40:     try:\n41:         return response.json()\n42:     except Exception:\n43:         return None\n44: \n45: \n46: def _extract_record(payload):\n47:     if isinstance(payload, dict):\n48:         for key in ('bookmark', 'record', 'data', 'item'):\n49:             value = payload.get(key)\n50:             if isinstance(value, dict):\n51:                 return value\n52:         return payload\n53:     return None\n54: \n55: \n56: def _record_id(record):\n57:     if isinstance(record, dict) and record.get('id') is not None:\n58:         return str(record['id'])\n59:     return None\n60: \n61: \n62: def _record_url(record):\n63:     if isinstance(record, dict) and record.get('url') is not None:\n64:         return str(record['url'])\n65:     return None\n66: \n67: \n68: def _bookmark_path(bookmark_id):\n69:     return '/api/bookmarks/' + quote(str(bookmark_id), safe='')\n70: \n71: \n72: def _error_code(response):\n73:     payload = _safe_json(response)\n74:     if isinstance(payload, dict):\n75:         error = payload.get('error')\n76:         if isinstance(error, dict) and error.get('code') is not None:\n77:             return str(error['code'])\n78:         for key in ('code', 'error_code'):\n79:             if payload.get(key) is not None:\n80:                 return str(payload[key])\n81:     return None\n82: \n83: \n84: def _extract_list(payload, keys):\n85:     if isinstance(payload, list):\n86:         return payload\n87:     if isinstance(payload, dict):\n88:         for key in keys:\n89:             value = payload.get(key)\n90:             if isinstance(value, list):\n91:                 return value\n92:     return None\n93: \n94: \n95: def _fetch_bookmarks(client, recorder, aid, params=None):\n96:     response = client.get('/api/bookmarks', params=params)\n97:     recorder.expect_status(response, 200, aid=f'{aid}-list-status')\n98:     payload = _safe_json(response)\n99:     records = _extract_list(payload, ('bookmarks', 'items', 'data', 'records'))\n100:     recorder.check(\n101:         f'{aid}-list-shape',\n102:         isinstance(records, list),\n103:         f'GET /api/bookmarks 必须返回 JSON 数组，实际 {type(payload).__name__}',\n104:     )\n105:     return records if isinstance(records, list) else []\n106: \n107: \n108: def _fetch_categories(client, recorder, aid):\n109:     response = client.get('/api/categories')\n110:     recorder.expect_status(response, 200, aid=f'{aid}-categories-status')\n111:     payload = _safe_json(response)\n112:     categories = _extract_list(payload, ('categories', 'items', 'data'))\n113:     recorder.check(\n114:         f'{aid}-categories-shape',\n115:         isinstance(categories, list),\n116:         f'GET /api/categories 必须返回 JSON 数组，实际 {type(payload).__name__}',\n117:     )\n118:     return categories if isinstance(categories, list) else []\n119: \n120: \n121: def _category_names(categories):\n122:     names = set()\n123:     for item in categories:\n124:         if isinstance(item, dict) and item.get('name') is not None:\n125:             names.add(str(item['name']))\n126:     return names\n127: \n128: \n129: def _record_ids(records):\n130:     return {_record_id(record) for record in records}\n131: \n132: \n133: def _case_a01(args, recorder):\n134:     client = common.HttpClient(args.base_url)\n135:     try:\n136:         health = client.get('/api/health')\n137:         recorder.expect_status(health, 200, aid='a01-health-status')\n138: \n139:         live_url = _unique_url('a01-live')\n140:         created = client.post_json('/api/bookmarks', {'url': live_url, 'title': 'A01 存活往返'})\n141:         recorder.expect_status(created, 201, aid='a01-base-save-status')\n142:         base_id = _record_id(_extract_record(_safe_json(created)))\n143:         recorder.check('a01-base-save-id', bool(base_id), f'保存返回 id={base_id!r}')\n144:         if base_id:\n145:             fetched = client.get(_bookmark_path(base_id))\n146:             recorder.expect_status(fetched, 200, aid='a01-base-readback-status')\n147:             stored = _extract_record(_safe_json(fetched))\n148:             recorder.check(\n149:                 'a01-base-readback-url',\n150:                 _record_url(stored) == live_url,\n151:                 f'读回 url={_record_url(stored)!r}（期望 {live_url!r}）',\n152:             )\n153:     finally:\n154:         client.close()\n155: \n156:     first = common.launch_app(args.app_root, args.data_dir, 0)\n157:     instance_dir = first.instance_dir\n158:     persisted_id = None\n159:     persisted_url = None\n160:     try:\n161:         instance = common.HttpClient(first.base_url)\n162:         try:\n163:             persisted_url = _unique_url('a01-restart')\n164:             response = instance.post_json(\n165:                 '/api/bookmarks', {'url': persisted_url, 'title': 'A01 重启持久化'}\n166:             )\n167:             recorder.expect_status(response, 201, aid='a01-instance-save-status')\n168:             persisted_id = _record_id(_extract_record(_safe_json(response)))\n169:             recorder.check(\n170:                 'a01-instance-save-id',\n171:                 bool(persisted_id),\n172:                 f'隔离实例保存返回 id={persisted_id!r}',\n173:             )\n174:         finally:\n175:             instance.close()\n176:     finally:\n177:         common.stop_app(first)\n178: \n179:     if not persisted_id:\n180:         recorder.check('a01-restart-readback', False, '隔离实例未返回可用 id，无法验证重启持久化')\n181:         return\n182: \n183:     second = common.launch_app(args.app_root, args.data_dir, 0, instance_dir=instance_dir)\n184:     try:\n185:         reopened = common.HttpClient(second.base_url)\n186:         try:\n187:             again = reopened.get(_bookmark_path(persisted_id))\n188:             recorder.expect_status(again, 200, aid='a01-restart-readback-status')\n189:             restored = _extract_record(_safe_json(again))\n190:             recorder.check(\n191:                 'a01-restart-id',\n192:                 _record_id(restored) == persisted_id,\n193:                 f'重启后 id={_record_id(restored)!r}（期望 {persisted_id!r}）',\n194:             )\n195:             recorder.check(\n196:                 'a01-restart-url',\n197:                 _record_url(restored) == persisted_url,\n198:                 f'重启后 url={_record_url(restored)!r}（期望 {persisted_url!r}）',\n199:             )\n200:         finally:\n201:             reopened.close()\n202:     finally:\n203:         common.stop_app(second)\n204: \n205: \n206: def _case_a02(args, recorder):\n207:     client = common.HttpClient(args.base_url)\n208:     try:\n209:         token = f'atlas-a02-{uuid.uuid4().hex[:12]}'\n210:         candidates = [\n211:             ('missing-scheme', f'example.com/{token}'),\n212:             ('javascript-scheme', f'javascript:void(\"{token}\")'),\n213:             ('ftp-scheme', f'ftp://{token}.example.com/manual'),\n214:             ('dotless-host', f'http://{token}'),\n215:         ]\n216:         before = _fetch_bookmarks(client, recorder, 'a02-before')\n217:         token_before = sum(1 for record in before if token in (_record_url(record) or ''))\n218:         for label, bad_url in candidates:\n219:             response = client.post_json('/api/bookmarks', {'url': bad_url})\n220:             recorder.expect_status(response, 400, aid=f'a02-{label}-status')\n221:             code = _error_code(response)\n222:             recorder.check(\n223:                 f'a02-{label}-code',\n224:                 code == 'invalid_url',\n225:                 f'POST url={bad_url!r} 错误码={code!r}（期望 invalid_url）',\n226:             )\n227:         after = _fetch_bookmarks(client, recorder, 'a02-after')\n228:         token_after = sum(1 for record in after if token in (_record_url(record) or ''))\n229:         recorder.check(\n230:             'a02-relative-count',\n231:             token_after == token_before,\n232:             f'含唯一标记 {token} 的记录数 {token_before} -> {token_after}（不得新增）',\n233:         )\n234:         listed = {_record_url(record) for record in after}\n235:         for label, bad_url in candidates:\n236:             recorder.check(\n237:                 f'a02-{label}-absent',\n238:                 bad_url not in listed,\n239:                 f'被拒绝的 url={bad_url!r} 未出现在列表中',\n240:             )\n241:     finally:\n242:         client.close()\n243: \n244: \n245: def _case_a03(args, recorder):\n246:     client = common.HttpClient(args.base_url)\n247:     try:\n248:         categories = _fetch_categories(client, recorder, 'a03')\n249:         preset_names = _category_names(categories)\n250:         for preset in common.PRESET_CATEGORIES:\n251:             recorder.check(\n252:                 f'a03-preset-{preset}',\n253:                 preset in preset_names,\n254:                 f'预置归类 {preset!r} 可见：{sorted(preset_names)}',\n255:             )\n256: \n257:         default_url = _unique_url('a03-default')\n258:         default_response = client.post_json('/api/bookmarks', {'url': default_url})\n259:         recorder.expect_status(default_response, 201, aid='a03-default-save-status')\n260:         default_id = _record_id(_extract_record(_safe_json(default_response)))\n261:         recorder.check('a03-default-save-id', bool(default_id), f'缺省归类保存返回 id={default_id!r}')\n262:         if default_id:\n263:             inbox = _fetch_bookmarks(\n264:                 client, recorder, 'a03-inbox', params={'category': common.DEFAULT_CATEGORY}\n265:             )\n266:             recorder.check(\n267:                 'a03-default-inbox',\n268:                 default_id in _record_ids(inbox),\n269:                 f'记录 {default_id!r} 出现在「{common.DEFAULT_CATEGORY}」归类中',\n270:             )\n271: \n272:         new_name = f'自动归类-{uuid.uuid4().hex[:8]}'\n273:         new_url = _unique_url('a03-newcat')\n274:         new_response = client.post_json('/api/bookmarks', {'url': new_url, 'category': new_name})\n275:         recorder.expect_status(new_response, 201, aid='a03-newcat-save-status')\n276:         new_id = _record_id(_extract_record(_safe_json(new_response)))\n277:         recorder.check('a03-newcat-save-id', bool(new_id), f'新归类保存返回 id={new_id!r}')\n278: \n279:         refreshed = _fetch_categories(client, recorder, 'a03-refreshed')\n280:         recorder.check(\n281:             'a03-newcat-created',\n282:             new_name in _category_names(refreshed),\n283:             f'保存 {new_name!r} 后归类被自动创建：{sorted(_category_names(refreshed))}',\n284:         )\n285:         if new_id:\n286:             filtered = _fetch_bookmarks(\n287:                 client, recorder, 'a03-newcat-filter', params={'category': new_name}\n288:             )\n289:             recorder.check(\n290:                 'a03-newcat-filter',\n291:                 new_id in _record_ids(filtered),\n292:                 f'记录 {new_id!r} 可按归类 {new_name!r} 检索到',\n293:             )\n294:     finally:\n295:         client.close()\n296: \n297: \n298: def _case_a11(args, recorder):\n299:     client = common.HttpClient(args.base_url)\n300:     try:\n301:         health = client.get('/api/health')\n302:         recorder.expect_status(health, 200, aid='a11-health-status')\n303:         payload = _safe_json(health)\n304:         recorder.check(\n305:             'a11-health-json',\n306:             isinstance(payload, dict),\n307:             f'/api/health 返回 JSON 对象，实际 {type(payload).__name__}',\n308:         )\n309: \n310:         page = client.get('/', accept='text/html')\n311:         recorder.expect_status(page, 200, aid='a11-home-status')\n312:         recorder.check(\n313:             'a11-home-content-type',\n314:             'text/html' in page.content_type.lower(),\n315:             f'首页 Content-Type={page.content_type!r}',\n316:         )\n317:         body = page.text\n318:         recorder.check(\n319:             'a11-entry-form',\n320:             bool(_ENTRY_FORM_RE.search(body)),\n321:             '首页含 action=/bookmarks/new 的录入表单',\n322:         )\n323:         recorder.check(\n324:             'a11-url-field',\n325:             bool(_URL_FIELD_RE.search(body)),\n326:             '录入表单含 name=url 输入字段',\n327:         )\n328:         recorder.check(\n329:             'a11-list-container',\n330:             bool(_LIST_CONTAINER_RE.search(body)),\n331:             '首页含记录列表容器',\n332:         )\n333:     finally:\n334:         client.close()\n335: \n336: \n337: _HANDLERS = {\n338:     'A01': _case_a01,\n339:     'A02': _case_a02,\n340:     'A03': _case_a03,\n341:     'A11': _case_a11,\n342: }\n343: \n344: \n345: def main(argv=None):\n346:     args = common.parse_case_args(argv)\n347:     recorder = common.Recorder(args.case)\n348:     handler = _HANDLERS.get(args.case)\n349:     if handler is None:\n350:         recorder.check(\n351:             'dispatch',\n352:             False,\n353:             f'acceptance/p0_library.py 不实现用例 {args.case}（应由其他程序派发）',\n354:         )\n355:     else:\n356:         try:\n357:             handler(args, recorder)\n358:         except common.AcceptanceError as exc:\n359:             recorder.check('infrastructure', False, f'验收基础设施错误：{exc}')\n360:         except Exception as exc:\n361:             recorder.check('unexpected-error', False, f'未预期错误：{type(exc).__name__}: {exc}')\n362:     return recorder.finish(args.case)\n363: \n364: \n365: if __name__ == '__main__':\n366:     sys.exit(main())","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/milin/2026/软件开发/application-atlas/application-atlas-production-pack/atlas/template-factory/jobs/job_7742b1c124be4c9ab3a0096da5cdd772/attempt-4/blueprint-code-0-1/source/previous/acceptance/p0_library.py, lines 1-366\n1: #!/usr/bin/env python3\n2: '''P0 行为验收组：保存、校验、默认收件箱、启动外壳。\n3: \n4: 覆盖 A01、A02、A03、A11。仅使用 Python 3.12 标准库并复用\n5: acceptance/common.py：以 --case 派发，未知用例显式失败；每个用例对真实\n6: 目标执行正向与硬负向行为断言，向 stdout 输出单个\n7: atlas.acceptance-result.v1 JSON，失败时以非零码退出。\n