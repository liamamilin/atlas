 {\n856:      \"acceptance_ids\": [\n857:       \"A01\",\n858:       \"A02\",\n859:       \"A03\"\n860:      ],\n861:      \"action\": \"填写原始 URL，可选标题/描述，选择已有归类、留为默认「未整理」或输入新归类名并提交。\",\n862:      \"design_basis\": \"场景 workflow 1–2 与验收 1/2：用户主动保存外部网页链接，记录以 URL 锚定并持久保留。\",\n863:      \"entry\": \"首页 GET / 的保存表单 form[action=/bookmarks/new]，字段 url、title、description、category。\",\n864:      \"failure\": \"非法 URL 返回 400 invalid_url，非法归类返回 400 invalid_category；HTML 同页显示 [data-testid=form-error]，不写入。\",\n865:      \"feature_id\": \"F01\",\n866:      \"navigation\": \"成功后 303 到 /?category=<归类> 或 /，浏览器显示新记录行。\",\n867:      \"recovery\": \"失败页保留已填 url/title/description/category，用户修正后重新提交；也可返回列表。\",\n868:      \"success_state\": \"303 返回首页，新记录出现在所选归类，GET /api/bookmarks/{id} 返回同一原始 URL；SQLite 行已持久化。\"\n869:     },\n870:     {\n871:      \"acceptance_ids\": [\n872:       \"A03\"\n873:      ],\n874:      \"action\": \"不另选归类直接保存；首启查看预置归类。\",\n875:      \"design_basis\": \"场景 workflow 3：未经整理的链接先进入默认归类，之后再移动；成熟产品普遍提供未被整理收件区。\",\n876:      \"entry\": \"首页保存表单的 category 字段（默认「未整理」）与侧栏/归类页的预置归类列表。\",\n877:      \"failure\": \"默认归类缺失或写入失败时返回明确错误页或 JSON 错误，不伪装成功。\",\n878:      \"feature_id\": \"F02\",\n879:      \"navigation\": \"303 到首页或未整理归类视图。\",\n880:      \"recovery\": \"重试保存；应用启动时在事务中补齐预置归类。\",\n881:      \"success_state\": \"记录的 category_id 为默认「未整理」，可在 /?category=未整理 看到；“未整理”“待购”“家居改造”“以后看看”均可见。\"\n882:     },\n883:     {\n884:      \"acceptance_ids\": [\n885:       \"A04\"\n886:      ],\n887:      \"action\": \"在真实表单提交 name 新建/重命名，提交 category_id 删除；删除默认归类被拒绝。\",\n888:      \"design_basis\": \"场景验收 3 与 workflow 2：用户可新建归类并把记录放入合适位置；源包没有 collections，属目标新设计。\",\n889:      \"entry\": \"首页 a[data-testid=category-manager] 进入 /categories；该页含 category-create-form、category-rename-form、category-delete-form。\",\n890:      \"error_branch_ids\": [\n891:       \"html.category_create.name.omitted\",\n892:       \"html.category_create.name.empty\",\n893:       \"html.category_create.name.whitespace\",\n894:       \"html.category_create.name.overlong_121\",\n895:       \"html.category_rename.name.omitted\",\n896:       \"html.category_rename.name.empty\",\n897:       \"html.category_rename.name.whitespace\",\n898:       \"html.category_rename.name.overlong_121\",\n899:       \"json.category_create.name.omitted\",\n900:       \"json.category_create.name.empty\",\n901:       \"json.category_create.name.whitespace\",\n902:       \"json.category_create.name.overlong_121\",\n903:       \"json.category_create.name.null\",\n904:       \"json.category_rename.name.omitted\",\n905:       \"json.category_rename.name.empty\",\n906:       \"json.category_rename.name.whitespace\",\n907:       \"json.category_rename.name.overlong_121\",\n908:       \"json.category_rename.name.null\"\n909:      ],\n910:      \"failure\": \"重名 409 duplicate_category、空名/超长 400 invalid_name、默认归类 400 protected_category；页面显示 form-error 且数据不变。\",\n911:      \"feature_id\": \"F03\",\n912:      \"navigation\": \"创建/重命名/删除成功后 303 到 /categories。\",\n913:      \"recovery\": \"保留已填 name/category_id 并允许改正或选择其他归类；可返回 /categories 重试。\",\n914:      \"success_state\": \"303 到 /categories；新建/重命名可见且计数正确；删除归类后其活动与软删除记录都迁回「未整理」，软删记录仍可恢复。\"\n915:     },\n916:     {\n917:      \"acceptance_ids\": [\n918:       \"A05\",\n919:       \"A12\"\n920:      ],\n921:      \"action\": \"选择目标归类（API 归类 ID）并提交；HTML 适配器把 ID 翻译为归类名后调用现有 move 服务。\",\n922:      \"design_basis\": \"场景验收 3 与 workflow 3：记录可在归类之间移动，重新打开后仍保持新归属。\",\n923:      \"entry\": \"每条 tr[data-testid=record-row] 内的 form[data-testid=record-move-form]，含 input record_id 与 select name=category_id。\",\n924:      \"error_branch_ids\": [\n925:       \"html.bookmark_save.category.empty\",\n926:       \"html.bookmark_save.category.whitespace\",\n927:       \"html.bookmark_save.category.overlong_121\",\n928:       \"html.bookmark_move.category_id.omitted\",\n929:       \"html.bookmark_move.category_id.empty\",\n930:       \"html.bookmark_move.category_id.unknown_id\",\n931:       \"json.bookmark_save.category.empty\",\n932:       \"json.bookmark_save.category.whitespace\",\n933:       \"json.bookmark_save.category.overlong_121\",\n934:       \"json.bookmark_move.category.empty\",\n935:       \"json.bookmark_move.category.whitespace\",\n936:       \"json.bookmark_move.category.overlong_121\",\n937:       \"json.bookmark_move.category.omitted\",\n938:       \"json.bookmark_move.category.null\"\n939:      ],\n940:      \"failure\": \"空/超长/非法归类 400 invalid_category，未知 record_id 404 not_found；不移动、不写入。\",\n941:      \"feature_id\": \"F04\",\n942:      \"navigation\": \"成功后 303 到 /?category=<目标归类> 或来源视图。\",\n943:      \"recovery\": \"保留选择并显示 form-error；用户改选有效归类或返回列表重试。\",\n944:      \"success_state\": \"303 回列表；记录离开原归类并出现在目标归类，JSON 的 category 与持久化结果一致。\"\n945:     },\n946:     {\n947:      \"acceptance_ids\": [\n948:       \"A06\"\n949:      ],\n950:      \"action\": \"点击归类链接或从搜索表单选择归类并查看列表。\",\n951:      \"design_basis\": \"场景验收 4：用户通过归类浏览找回记录；来源标签计数被调整为按归类聚合。\",\n952:      \"entry\": \"首页侧栏 [data-testid=category-count][data-category-id] 与归类链接；/categories 同显计数；GET /?category=<name>。\",\n953:      \"failure\": \"未知归类返回空结果而非 5xx；计数查询失败显示错误页。\",\n954:      \"feature_id\": \"F05\",\n955:      \"navigation\": \"GET /?category=... 或 GET /categories；无记录时显示明确空状态。\",\n956:      \"recovery\": \"选择其他归类或清空筛选。\",\n957:      \"success_state\": \"页面只列该归类活动记录；HTML count 与 JSON count 都等于活动（未软删）记录数；移动、删除、恢复后仍一致。\"\n958:     },\n959:     {\n960:      \"acceptance_ids\": [\n961:       \"A07\"\n962:      ],\n963:      \"action\": \"选择归类、输入关键字并提交。\",\n964:      \"design_basis\": \"场景验收 4：用户凭记得的关键字找回已存链接；来源仅搜标题，目标扩展到可识别来源的字段。\",\n965:      \"entry\": \"首页 form[data-testid=category-search-form]，字段 category（归类名）与 q；action 为 GET /。\",\n966:      \"failure\": \"无匹配不是错误（200 + 空结果）；非法请求返回可读错误且不写入。\",\n967:      \"feature_id\": \"F06\",\n968:      \"navigation\": \"GET /?category=...&q=...，同一页面更新结果。\",\n969:      \"recovery\": \"修改 q 或切换归类重新提交；清空 q 恢复归类浏览。\",\n970:      \"success_state\": \"URL 与表单保留 category 与 q；页面显示所选归类、保留查询和匹配行；同一关键字在两个归类分别命中各自记录；无匹配显示明确空结果；JSON 返回匹配集。\"\n971:     },\n972:     {\n973:      \"acceptance_ids\": [\n974:       \"A08\"\n975:      ],\n976:      \"action\": \"用户点击打开链接。\",\n977:      \"design_basis\": \"场景验收 2 与 workflow 5：打开记录即回到保存时的外部网页，库只保证引用而非内容。\",\n978:      \"entry\": \"记录行 a[data-testid=record-open-link] 与 GET /go/{id}。\",\n979:      \"failure\": \"未知 id 404 not_found；目标不可达不影响库中记录可读。\",\n980:      \"feature_id\": \"F07\",\n981:      \"navigation\": \"浏览器导航到原始 URL（新标签）；服务端只发 302。\",\n982:      \"recovery\": \"返回收藏列表选择其他记录；如 URL 有误，可由现有 PATCH API 更新并重算 hostname。\",\n983:      \"success_state\": \"链接 href 恰为保存时原始 URL，target=_blank、rel 含 noopener；GET /go/{id} 302 Location 为同一字符串；P0 不请求目标页。\"\n984:     },\n985:     {\n986:      \"acceptance_ids\": [\n987:       \"A01\",\n988:       \"A05\",\n989:       \"A09\"\n990:      ],\n991:      \"action\": \"执行真实写操作，停止应用进程，再以同一实例目录重启并读取。\",\n992:      \"design_basis\": \"场景验收 1：主动保存的链接在多次会话之间持久保留；目标以 SQLite 实现本地单用户持久化。\",\n993:      \"entry\": \"保存、移动、删除/恢复等写操作后重新请求页面；重启适配器从同一 app_root 与实例数据目录启动。\",\n994:      \"failure\": \"数据库不可写或损坏时返回明确 5xx 错误页而非成功假象；事务回滚保持旧状态。\",\n995:      \"feature_id\": \"F08\",\n996:      \"navigation\": \"无自动导航；下次 GET / 读取持久状态。\",\n997:      \"recovery\": \"恢复可写数据目录后重试；重启应用重新初始化 schema。\",\n998:      \"success_state\": \"重启后 id、原始 URL、标题、描述、归类与 trashed 状态与写入后一致；HTML 与 JSON 都来自 SQLite。\"\n999:     },\n1000:     {\n1001:      \"acceptance_ids\": [\n1002:       \"A09\"\n1003:      ],\n1004:      \"action\": \"提交 record_id 软删除；在回收站提交 record_id 恢复。\",\n1005:      \"design_basis\": \"场景要求可恢复的失败；来源仅有归档记录的瞬时 Undo，目标改为显式软删除与恢复。\",\n1006:      \"entry\": \"记录行 form[data-testid=record-delete-form]；GET /?trash=1 的软删记录行 form[data-testid=record-restore-form]。\",\n1007:      \"failure\": \"未知 record_id 404 not_found；失败不改变 trashed_at，不产生 5xx。\",\n1008:      \"feature_id\": \"F09\",\n1009:      \"navigation\": \"删除成功 303 到 /?trash=1；恢复成功 303 到恢复后归类。\",\n1010:      \"recovery\": \"回收站提供可提交的恢复表单；失败可重试或返回列表。\",\n1011:      \"success_state\": \"默认视图与计数排除软删记录，回收站仍显示；恢复后原始字段与归类回归并重新可见；归类删除后软删记录仍在「未整理」可恢复。\"\n1012:     },\n1013:     {\n1014:      \"acceptance_ids\": [\n1015:       \"A02\",\n1016:       \"A10\",\n1017:       \"A12\"\n1018:      ],\n1019:      \"action\": \"提交非法 URL、空/超长/非法归类、畸形 JSON 或未知 ID。\",\n1020:      \"design_basis\": \"场景要求非法输入可恢复；源表单校验被调整为服务端 HTML 表单与 JSON API 共用的显式错误合同。\",\n1021:      \"entry\": \"所有 HTML 表单（保存、归类、移动、删除、恢复、搜索）与 JSON API 端点。\",\n1022:      \"error_branch_ids\": [\n1023:       \"html.bookmark_save.category.empty\",\n1024:       \"html.bookmark_save.category.whitespace\",\n1025:       \"html.bookmark_save.category.overlong_121\",\n1026:       \"html.bookmark_move.category_id.omitted\",\n1027:       \"html.bookmark_move.category_id.empty\",\n1028:       \"html.bookmark_move.category_id.unknown_id\",\n1029:       \"json.bookmark_save.category.empty\",\n1030:       \"json.bookmark_save.category.whitespace\",\n1031:       \"json.bookmark_save.category.overlong_121\",\n1032:       \"json.bookmark_move.category.empty\",\n1033:       \"json.bookmark_move.category.whitespace\",\n1034:       \"json.bookmark_move.category.overlong_121\",\n1035:       \"json.bookmark_move.category.omitted\",\n1036:       \"json.bookmark_move.category.null\"\n1037:      ],\n1038:      \"failure\": \"出现 5xx、静默写入或不可恢复的错误页即视为失败。\",\n1039:      \"feature_id\": \"F10\",\n1040:      \"navigation\": \"HTML 错误留在当前表单页并保留输入；JSON 无导航。\",\n1041:      \"recovery\": \"修正字段后重新提交；失败页保留可运行的表单或返回链接。\",\n1042:      \"success_state\": \"错误路径本身成功执行：JSON 返回 400/404/409 与结构化错误码，HTML 返回 400/409 与 form-error；畸形 JSON 为 bad_request；均无 5xx、无写入。\"\n1043:     },\n1044:     {\n1045:      \"acceptance_ids\": [\n1046:       \"A11\"\n1047:      ],\n1048:      \"action\": \"首启或空库时打开首页。\",\n1049:      \"design_basis\": \"场景是单用户本地工具，需要可打开的应用入口；目标采用 Python 服务端渲染外壳而非来源 SPA。\",\n1050:      \"entry\": \"GET / 与 GET /api/health。\",\n1051:      \"failure\": \"健康检查非 200/非 JSON、首页 5xx 或缺少表单时显式失败。\",\n1052:      \"feature_id\": \"F11\",\n1053:      \"navigation\": \"无自动导航（首页即入口）；可进入 /categories 或归类筛选。\",\n1054:      \"recovery\": \"启动或重启应用；修复后刷新首页。\",\n1055:      \"success_state\": \"200 text/html；含保存表单 name=url、归类管理链接、记录列表/空状态容器；预置归类与空库不报错；health 200 JSON。\"\n1056:     }\n1057:    ],\n1058:    \"review_rules_version\": \"atlas.current-required-contract.v1\",\n1059:    \"schema\": \"atlas.contract-coverage.v1\"\n1060:   },\n1061:   \"decisions\": [\n1062:    {\n1063:     \"default\": \"单选归类（bookmark.category_id 标量外键）。场景流程明确“选择一个简单归类”，单归属让移动、计数与浏览语义无歧义；未来若需多值可迁移到关联表而不丢数据。\",\n1064:     \"id\": \"D01\",\n1065:     \"impact\": \"决定数据模型（标量外键 vs 关联表）以及浏览、计数与检索的实现路径。\",\n1066:     \"question\": \"记录应归属于单一“归类”，还是允许像标签一样同时属于多个？\",\n1067:     \"status\": \"decided\",\n1068:     \"when_to_ask\": \"当真实用户反馈同一条记录必须同时属于多个主题，或需要跨主题交叉检索时再评估多标签。\"\n1069:    },\n1070:    {\n1071:     \"default\": \"落入默认“未整理”，保存始终成功。场景流程第3步要求未经整理的链接可先进入默认归类，快速保存不应打断浏览。\",\n1072:     \"id\": \"D02\",\n1073:     \"impact\": \"决定保存接口是否允许缺省 category，以及首启预置数据内容。\",\n1074:     \"question\": \"保存时不选归类，应阻止保存还是落入默认“未整理”？\",\n1075:     \"status\": \"decided\",\n1076:     \"when_to_ask\": \"当目标用户群要求强制归类（例如团队共享库）时再改为必选。\"\n1077:    },\n1078:    {\n1079:     \"default\": \"自动创建（名称大小写不敏感去重），重名则复用现有归类；保持保存流程不中断。\",\n1080:     \"id\": \"D03\",\n1081:     \"impact\": \"决定 categories 的唯一约束、写入事务边界与 409/400 的语义；HTML 归类表单与 JSON API 共用服务层，重名、非法名与默认归类保护都不得产生部分写入。\",\n1082:     \"question\": \"在保存或移动界面输入一个尚不存在的归类名，应自动创建还是报错？\",\n1083:     \"status\": \"decided\",\n1084:     \"when_to_ask\": \"当出现拼写错误导致归类碎片化的证据时，改为只允许从既有归类中选择。\"\n1085:    },\n1086:    {\n1087:     \"default\": \"软删除：记录标记 trashed_at，默认视图排除，提供撤销恢复；场景要求可恢复的失败。\",\n1088:     \"id\": \"D04\",\n1089:     \"impact\": \"决定数据模型的 trashed_at 列、默认列表过滤条件、/restore 恢复路径，以及删除归类时活动与软删记录同迁默认归类；不引入 purge 或永久删除接口。\",\n1090:     \"question\": \"删除是立即物理删除，还是软删除到可恢复区并支持短时撤销？\",\n1091:     \"status\": \"decided\",\n[Output truncated. Continue reading with offset: 1092]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\": \"/Users/milin/2026/软件开发/application-atlas/application-atlas-production-pack/atlas/template-factory/jobs/job_7742b1c124be4c9ab3a0096da5cdd772/attempt-4/blueprint-code-0-1/source/SPECIFICATION.json\"}"},"time":{"start":1792433714521,"end":1792433715234}}}}
