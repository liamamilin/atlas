d-programs/acceptance/runner.json\",\n158:    \"source_attempt\": 1,\n159:    \"source_job_id\": \"job_f3e32b56036b4ec7bea0c00d6a2a8dc4\"\n160:   }\n161:  ],\n162:  \"schema\": \"atlas.prepared-program-revision.v1\",\n163:  \"source_aggregate_checkpoint_digest\": \"78150ff8071af6e1e4a35365d965b8644140d2157ad27356e91ccad644981672\",\n164:  \"source_aggregate_checkpoint_name\": \"aggregate-semantic-review-f153e3550ceaeeb5\",\n165:  \"source_attempt\": 1,\n166:  \"source_candidate_sha256\": \"3259239fd8a87fc3f4bf6c6ccd442f507a572db54e8e70b9dc9889c68f3855d3\",\n167:  \"source_job_id\": \"job_f3e32b56036b4ec7bea0c00d6a2a8dc4\",\n168:  \"source_plan_checkpoint_digest\": \"6f806d9416cd1c5a724e980dece7330dac651c8a838d469db409d940a493f158\",\n169:  \"source_plan_checkpoint_name\": \"blueprint-plan-0\",\n170:  \"source_proposal_digest\": \"6f806d9416cd1c5a724e980dece7330dac651c8a838d469db409d940a493f158\"\n171: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file source/authorization/PROGRAM_REVISION_MANIFEST.json, lines 1-171\n1: {\n2:  \"entries\": [\n3:   {\n4:    \"after_sha256\": \"7f0d7d28d8336bdde3da267795e24d13e430f05e53063ee01ed5611236325d37\",\n5:    \"authorization_clause\": \"R7 §3.0 exact byte-for-byte reuse\",\n6:    \"before_sha256\": \"7f0d7d28d8336bdde3da267795e24d13e430f05e53063ee01ed5611236325d37\",\n7:    \"checkpoint_digest\": \"1ed409f518e113f0baa72ea56677557acb2b51440cf052cc009da15698efeabb\",\n8:    \"checkpoint_name\": \"blueprint-code-0-0\",\n9:    \"mode\": \"reuse\",\n10:    \"patch\": [],\n11:    \"patch_digest\": \"4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945\",\n12:    \"path\": \"acceptance/common.py\",\n13:    \"prepared_ref\": \"docs/template-factory/g1-r7-acceptance-alignment-2026-10-20/prepared-programs/acceptance/common.py\",\n14:    \"source_attempt\": 1,\n15:    \"source_job_id\": \"job_f3e32b56036b4ec7bea0c00d6a2a8dc4\"\n16:   },\n17:   {\n18:    \"after_sha256\": \"5923bdd1d15e7d98bcf2c3b91123b36d986c0c69cbc6a1a7fdab80ce4c437d6e\",\n19:    \"authorization_clause\": \"R7 §3.1 A02 and §3.3 A11 only\",\n20:    \"before_sha256\": \"8a5ce953288f2b09b9cc0256d869fc7dca2a3dcd3ff255dc5dd5dfa2fa51fb67\",\n21:    \"checkpoint_digest\": \"190c7d3c6167075f88af3e0610d50d98c1bed3e429951079345f6f5428f4d037\",\n22:    \"checkpoint_name\": \"blueprint-code-0-1\",\n23:    \"mode\": \"replace\",\n24:    \"patch\": [\n25:     {\n26:      \"new\": \"        # Independent JSON positive: not an HTML-created record read through JSON.\\n        before_json_ids = _record_ids(_fetch_bookmarks(client, recorder, 'a02-json-before-create'))\\n        json_boundary = f'https://atlas-a02-json-{token}/original?keep=1'\\n        positive = client.post_json('/api/bookmarks', {\\n            'url': json_boundary, 'title': f'A02 JSON {token}',\\n            'description': f'A02 JSON positive {token}',\\n        })\\n        recorder.expect_status(positive, 201, aid='a02-json-boundary-create-status')\\n        json_id = _record_id(_extract_record(_safe_json(positive)))\\n        recorder.check('a02-json-boundary-new-id', bool(json_id) and json_id not in before_json_ids,\\n                       f'独立 JSON POST 返回新的非空 id={json_id!r}')\\n        if json_id:\\n            saved = _get_record(client, recorder, json_id, 'a02-json-boundary')\\n            recorder.check('a02-json-boundary-readback',\\n                           _record_id(saved) == json_id and _record_url(saved) == json_boundary,\\n                           '独立 GET 读回同一 id 与精确原始 URL')\\n            listed_positive = _fetch_bookmarks(client, recorder, 'a02-json-positive')\\n            recorder.check('a02-json-boundary-listed', any(\\n                _record_id(item) == json_id and _record_url(item) == json_boundary\\n                for item in listed_positive), '列表包含同一 JSON 创建记录与原始 URL')\\n        before = _fetch_bookmarks(client, recorder, 'a02-before')\",\n27:      \"old\": \"        before = _fetch_bookmarks(client, recorder, 'a02-before')\"\n28:     },\n29:     {\n30:      \"new\": \"def _case_a11_base(args, recorder):\\n    client = common.HttpClient(args.base_url)\\n    unknown = f'不存在归类-{uuid.uuid4().hex[:10]}'\\n    try:\\n        health = client.get('/api/health')\\n        recorder.expect_status(health, 200, aid='a11-base-health-status')\\n        health_payload = _safe_json(health)\\n        recorder.check(\\n            'a11-base-health-json',\\n            isinstance(health_payload, dict) and bool(health_payload),\\n            f'/api/health 返回非空 JSON 对象，实际 {type(health_payload).__name__}',\\n        )\\n        page = client.get('/', accept='text/html')\\n        recorder.expect_status(page, 200, aid='a11-base-home-status')\\n        recorder.check(\\n            'a11-base-home-content-type',\\n            'text/html' in page.content_type.lower(),\\n            f'首页 Content-Type={page.content_type!r}',\\n        )\\n        doc = _parse_html(page.text)\\n        form = doc.save_form()\\n        recorder.check(\\n            'a11-base-entry-form',\\n            form is not None,\\n            '首页含 action=/bookmarks/new 且 method=post 的录入表单',\\n        )\\n        if form is not None:\\n            recorder.check(\\n                'a11-base-entry-action',\\n                _action_path(form.action) == '/bookmarks/new',\\n                f'录入表单 action={form.action!r}',\\n            )\\n            recorder.check(\\n                'a11-base-url-field',\\n                form.has_name('url'),\\n                '录入表单含 name=url 输入字段',\\n            )\\n        manager = next(\\n            (anchor for anchor in doc.anchors if anchor.testid == 'category-manager'),\\n            None,\\n        )\\n        manager_href = manager.href if manager is not None else None\\n        manager_path = ''\\n        if manager_href:\\n            try:\\n                manager_path = urllib.parse.urlsplit(manager_href).path.rstrip('/')\\n            except ValueError:\\n                manager_path = ''\\n        recorder.check(\\n            'a11-base-category-manager',\\n            manage... (line truncated to 2000 chars)\n31:      \"old\": \"def _case_a11(args, recorder):\\n    client = common.HttpClient(args.base_url)\\n    unknown = f'不存在归类-{uuid.uuid4().hex[:10]}'\\n    try:\\n        health = client.get('/api/health')\\n        recorder.expect_status(health, 200, aid='a11-health-status')\\n        health_payload = _safe_json(health)\\n        recorder.check(\\n            'a11-health-json',\\n            isinstance(health_payload, dict) and bool(health_payload),\\n            f'/api/health 返回非空 JSON 对象，实际 {type(health_payload).__name__}',\\n        )\\n        page = client.get('/', accept='text/html')\\n        recorder.expect_status(page, 200, aid='a11-home-status')\\n        recorder.check(\\n            'a11-home-content-type',\\n            'text/html' in page.content_type.lower(),\\n            f'首页 Content-Type={page.content_type!r}',\\n        )\\n        doc = _parse_html(page.text)\\n        form = doc.save_form()\\n        recorder.check(\\n            'a11-entry-form',\\n            form is not None,\\n            '首页含 action=/bookmarks/new 且 method=post 的录入表单',\\n        )\\n        if form is not None:\\n            recorder.check(\\n                'a11-entry-action',\\n                _action_path(form.action) == '/bookmarks/new',\\n                f'录入表单 action={form.action!r}',\\n            )\\n            recorder.check(\\n                'a11-url-field',\\n                form.has_name('url'),\\n                '录入表单含 name=url 输入字段',\\n            )\\n        manager = next(\\n            (anchor for anchor in doc.anchors if anchor.testid == 'category-manager'),\\n            None,\\n        )\\n        manager_href = manager.href if manager is not None else None\\n        manager_path = ''\\n        if manager_href:\\n            try:\\n                manager_path = urllib.parse.urlsplit(manager_href