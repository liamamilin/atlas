{"type":"tool_use","timestamp":1792484132929,"sessionID":"ses_ea79fcfd3ffeGu4Pan86lE7BF8","part":{"partID":"prt_1586147b9001VR00GMLHkJRv3R","sessionID":"ses_ea79fcfd3ffeGu4Pan86lE7BF8","messageID":"msg_158613c290014ycVsU5eqqKk1K","type":"tool","id":"call_b55f04e740174534a461184c","tool":"read","state":{"status":"completed","input":{"path":"source/candidate/acceptance/p0_library.py","limit":2000},"output":"Read file source/candidate/acceptance/p0_library.py, lines 1-1287\n1: #!/usr/bin/env python3\n2: '''P0 行为验收组：A01、A02、A03、A11。\n3: \n4: 覆盖真实保存表单与会话/重启持久化、URL 正向边界与非法输入、\n5: 默认归类与自动创建归类、启动健康与首页外壳。仅使用 Python 3.12\n6: 标准库并复用 acceptance/common.py：以 --case 派发，未知用例显式失败；\n7: 每个用例对真实目标执行正向与硬负向行为断言，向 stdout 输出单个\n8: atlas.acceptance-result.v1 JSON，失败时以非零码退出。\n9: '''\n10: \n11: from __future__ import annotations\n12: \n13: import os\n14: import re\n15: import sys\n16: import urllib.parse\n17: import uuid\n18: from html.parser import HTMLParser\n19: \n20: _THIS_DIR = os.path.dirname(os.path.abspath(__file__))\n21: if _THIS_DIR not in sys.path:\n22:     sys.path.insert(0, _THIS_DIR)\n23: \n24: import common\n25: \n26: _WHITESPACE_RE = re.compile(r'\\s+')\n27: _EMPTY_MARKERS = (\n28:     '暂无',\n29:     '没有记录',\n30:     '还没有',\n31:     '空状态',\n32:     '无匹配',\n33:     'no bookmarks',\n34:     'nothing here',\n35:     'empty',\n36: )\n37: _LIST_TAGS = frozenset({'ul', 'ol', 'table'})\n38: _LIST_ATTR_TAGS = frozenset({'div', 'main', 'section', 'article', 'aside'})\n39: \n40: \n41: class _Field:\n42:     def __init__(self, attrs):\n43:         self.attrs = attrs\n44:         self.name = attrs.get('name')\n45:         self.value = attrs.get('value', '')\n46:         self.type = (attrs.get('type') or 'text').lower()\n47:         self.checked = 'checked' in attrs\n48: \n49: \n50: class _Option:\n51:     def __init__(self, attrs):\n52:         self.attrs = attrs\n53:         self.value = attrs.get('value')\n54:         self.text = ''\n55:         self.selected = 'selected' in attrs\n56: \n57:     def resolved_value(self):\n58:         if self.value is not None:\n59:             return self.value\n60:         return self.text.strip()\n61: \n62: \n63: class _Select:\n64:     def __init__(self, attrs):\n65:         self.attrs = attrs\n66:         self.name = attrs.get('name')\n67:         self.options = []\n68: \n69:     def selected_value(self):\n70:         for option in self.options:\n71:             if option.selected:\n72:                 return option.resolved_value()\n73:         if self.options:\n74:             return self.options[0].resolved_value()\n75:         return ''\n76: \n77: \n78: class _Textarea:\n79:     def __init__(self, attrs):\n80:         self.attrs = attrs\n81:         self.name = attrs.get('name')\n82:         self.text = ''\n83: \n84: \n85: class _Form:\n86:     def __init__(self, attrs):\n87:         self.attrs = attrs\n88:         self.action = (attrs.get('action') or '').strip()\n89:         self.method = (attrs.get('method') or 'get').strip().lower()\n90:         self.testid = attrs.get('data-testid') or ''\n91:         self.fields = []\n92:         self.selects = []\n93:         self.textareas = []\n94: \n95:     def has_name(self, name):\n96:         if any(field.name == name for field in self.fields):\n97:             return True\n98:         if any(select.name == name for select in self.selects):\n99:             return True\n100:         return any(textarea.name == name for textarea in self.textareas)\n101: \n102:     def value(self, name):\n103:         for field in reversed(self.fields):\n104:             if field.name == name:\n105:                 return field.value\n106:         for select in reversed(self.selects):\n107:             if select.name == name:\n108:                 return select.selected_value()\n109:         for textarea in reversed(self.textareas):\n110:             if textarea.name == name:\n111:                 return textarea.text\n112:         return None\n113: \n114: \n115: class _Anchor:\n116:     def __init__(self, attrs):\n117:         self.attrs = attrs\n118:         self.href = attrs.get('href') or ''\n119:         self.testid = attrs.get('data-testid') or ''\n120:         self.text = ''\n121: \n122: \n123: class _Row:\n124:     def __init__(self, attrs):\n125:         self.attrs = attrs\n126:         self.record_id = attrs.get('data-record-id') or ''\n127:         self.anchors = []\n128:         self.text = ''\n129: \n130: \n131: def _action_path(action):\n132:     text = (action or '').strip()\n133:     if not text:\n134:         return ''\n135:     try:\n136:         path = urllib.parse.urlsplit(text).path\n137:     except ValueError:\n138:         return text\n139:     if not path:\n140:         return ''\n141:     if not path.startswith('/'):\n142:         path = '/' + path\n143:     return path.rstrip('/') or '/'\n144: \n145: \n146: class _Document:\n147:     def __init__(self):\n148:         self.forms = []\n149:         self.anchors = []\n150:         self.rows = []\n151:         self.testids = []\n152:         self.start_tags = []\n153:         self.text = ''\n154: \n155:     def save_form(self):\n156:         for form in self.forms:\n157:             if form.method == 'post' and _action_path(form.action) == '/bookmarks/new':\n158:                 return form\n159:         for form in self.forms:\n160:             if form.method == 'post' and form.has_name('url'):\n161:                 return form\n162:         return None\n163: \n164: \n165: class _HtmlReader(HTMLParser):\n166:     def __init__(self):\n167:         super().__init__(convert_charrefs=True)\n168:         self.doc = _Document()\n169:         self._form = None\n170:         self._select = None\n171:         self._option = None\n172:         self._textarea = None\n173:         self._anchor = None\n174:         self._row = None\n175:         self._testid_stack = []\n176: \n177:     def handle_starttag(self, tag, attrs):\n178:         tag = tag.lower()\n179:         attributes = {\n180:             str(key).lower(): ('' if value is None else value)\n181:             for key, value in attrs\n182:         }\n183:         self.doc.start_tags.append((tag, attributes))\n184:         testid = attributes.get('data-testid') or ''\n185:         if testid:\n186:             entry = {'tag': tag, 'attrs': attributes, 'text': ''}\n187:             self.doc.testids.append(entry)\n188:             self._testid_stack.append((tag, entry))\n189:         if tag == 'form':\n190:             self._finish_form()\n191:             self._form = _Form(attributes)\n192:         elif tag == 'input':\n193:             if self._form is not None:\n194:                 self._form.fields.append(_Field(attributes))\n195:         elif tag == 'select':\n196:             self._finish_select()\n197:             if self._form is not None:\n198:                 self._select = _Select(attributes)\n199:         elif tag == 'option':\n200:             self._finish_option()\n201:             if self._select is not None:\n202:                 self._option = _Option(attributes)\n203:         elif tag == 'textarea':\n204:             self._finish_textarea()\n205:             if self._form is not None:\n206:                 self._textarea = _Textarea(attributes)\n207:         elif tag == 'a':\n208:             self._finish_anchor()\n209:             self._anchor = _Anchor(attributes)\n210:         elif tag == 'tr' and testid == 'record-row':\n211:             self._finish_row()\n212:             self._row = _Row(attributes)\n213: \n214:     def handle_data(self, data):\n215:         if not data:\n216:             return\n217:         self.doc.text += data\n218:         if self._row is not None:\n219:             self._row.text += data\n220:         if self._anchor is not None:\n221:             self._anchor.text += data\n222:         if self._option is not None:\n223:             self._option.text += data\n224:         if self._textarea is not None:\n225:             self._textarea.text += data\n226:         for _, entry in self._testid_stack:\n227:             entry['text'] += data\n228: \n229:     def handle_endtag(self, tag):\n230:         tag = tag.lower()\n231:         if tag == 'a':\n232:             self._finish_anchor()\n233:         elif tag == 'option':\n234:             self._finish_option()\n235:         elif tag == 'select':\n236:             self._finish_select()\n237:         elif tag == 'textarea':\n238:             self._finish_textarea()\n239:         elif tag == 'form':\n240:             self._finish_form()\n241:         elif tag == 'tr':\n242:             self._finish_row()\n243:         if self._testid_stack and self._testid_stack[-1][0] == tag:\n244:             self._testid_stack.pop()\n245: \n246:     def _finish_option(self):\n247:         if self._option is None:\n248:             return\n249:         option = self._option\n250:         self._option = None\n251:         if self._select is not None:\n252:             self._select.options.append(option)\n253: \n254:     def _finish_select(self):\n255:         self._finish_option()\n256:         if self._select is None:\n257:             return\n258:         select = self._select\n259:         self._select = None\n260:         if self._form is not None:\n261:             self._form.selects.append(select)\n262: \n263:     def _finish_textarea(self):\n264:         if self._textarea is None:\n265:             return\n266:         textarea = self._textarea\n267:         self._textarea = None\n268:         if self._form is not None:\n269:             self._form.textareas.append(textarea)\n270: \n271:     def _finish_anchor(self):\n272:         if self._anchor is None:\n273:             return\n274:         anchor = self._anchor\n275:         self._anchor = None\n276:         self.doc.anchors.append(anchor)\n277:         if self._row is not None:\n278:             self._row.anchors.append(anchor)\n279: \n280:     def _finish_row(self):\n281:         if self._row is None:\n282:             return\n283:         row = self._row\n284:         self._row = None\n285:         self.doc.rows.append(row)\n286: \n287:     def _finish_form(self):\n288:         self._finish_select()\n289:         self._finish_textarea()\n290:         if self._form is None:\n291:             return\n292:         form = self._form\n293:         self._form = None\n294:         self.doc.forms.append(form)\n295: \n296:     def finalize(self):\n297:         self._finish_anchor()\n298:         self._finish_row()\n299:         self._finish_form()\n300: \n301: \n302: def _parse_html(text):\n303:     reader = _HtmlReader()\n304:     reader.feed(text or '')\n305:     reader.close()\n306:     reader.finalize()\n307:     return reader.doc\n308: \n309: \n310: def _unique_url(tag):\n311:     token = f'{tag}-{uuid.uuid4().hex[:12]}'\n312:     return f'https://{token}.atlas-acceptance.example/{token}'\n313: \n314: \n315: def _safe_json(response):\n316:     try:\n317:         return response.json()\n318:     except Exception:\n319:         return None\n320: \n321: \n322: def _extract_record(payload):\n323:     if isinstance(payload, dict):\n324:         for key in ('bookmark', 'record', 'data', 'item'):\n325:             value = payload.get(key)\n326:             if isinstance(value, dict):\n327:                 return value\n328:         return payload\n329:     return None\n330: \n331: \n332: def _extract_list(payload, keys):\n333:     if isinstance(payload, list):\n334:         return payload\n335:     if isinstance(payload, dict):\n336:         for key in keys:\n337:             value = payload.get(key)\n338:             if isinstance(value, list):\n339:                 return value\n340:     return None\n341: \n342: \n343: def _record_id(record):\n344:     if isinstance(record, dict) and record.get('id') is not None:\n345:         return str(record['id'])\n346:     return None\n347: \n348: \n349: def _record_url(record):\n350:     if isinstance(record, dict) and record.get('url') is not None:\n351:         return str(record['url'])\n352:     return None\n353: \n354: \n355: def _record_title(record):\n356:     if isinstance(record, dict) and record.get('title') is not None:\n357:         return str(record['title'])\n358:     return None\n359: \n360: \n361: def _record_description(record):\n362:     if isinstance(record, dict) and record.get('description') is not None:\n363:         return str(record['description'])\n364:     return None\n365: \n366: \n367: def _bookmark_path(bookmark_id):\n368:     return '/api/bookmarks/' + urllib.parse.quote(str(bookmark_id), safe='')\n369: \n370: \n371: def _error_code(response):\n372:     payload = _safe_json(response)\n373:     if isinstance(payload, dict):\n374:         error = payload.get('error')\n375:         if isinstance(error, dict) and error.get('code') is not None:\n376:             return str(error['code'])\n377:         for key in ('code', 'error_code'):\n378:             if payload.get(key) is not None:\n379:                 return str(payload[key])\n380:     return None\n381: \n382: \n383: def _fetch_bookmarks(client, recorder, aid, params=None):\n384:     response = client.get('/api/bookmarks', params=params)\n385:     recorder.expect_status(response, 200, aid=f'{aid}-list-status')\n386:     payload = _safe_json(response)\n387:     records = _extract_list(payload, ('bookmarks', 'items', 'data', 'records'))\n388:     recorder.check(\n389:         f'{aid}-list-shape',\n390:         isinstance(records, list),\n391:         f'GET /api/bookmarks 必须返回 JSON 数组，实际 {type(payload).__name__}',\n392:     )\n393:     return records if isinstance(records, list) else []\n394: \n395: \n396: def _fetch_categories(client, recorder, aid):\n397:     response = client.get('/api/categories')\n398:     recorder.expect_status(response, 200, aid=f'{aid}-categories-status')\n399:     payload = _safe_json(response)\n400:     categories = _extract_list(payload, ('categories', 'items', 'data'))\n401:     recorder.check(\n402:         f'{aid}-categories-shape',\n403:         isinstance(categories, list),\n404:         f'GET /api/categories 必须返回 JSON 数组，实际 {type(payload).__name__}',\n405:     )\n406:     return categories if isinstance(categories, list) else []\n407: \n408: \n409: def _category_names(categories):\n410:     names = set()\n411:     for item in categories:\n412:         if isinstance(item, dict) and item.get('name') is not None:\n413:             names.add(str(item['name']))\n414:     return names\n415: \n416: \n417: def _category_name(record, categories):\n418:     if not isinstance(record, dict):\n419:         return None\n420:     names = _category_names(categories)\n421:     by_id = {}\n422:     for item in categories:\n423:         if isinstance(item, dict) and item.get('id') is not None and item.get('name') is not None:\n424:             by_id[str(item['id'])] = str(item['name'])\n425:     for key in ('category', 'category_name', 'categoryName'):\n426:         value = record.get(key)\n427:         if isinstance(value, str):\n428:             if value in names:\n429:                 return value\n430:             if value in by_id:\n431:                 return by_id[value]\n432:             return value\n433:         if isinstance(value, dict) and value.get('name') is not None:\n434:             return str(value['name'])\n435:     for key in ('category_id', 'categoryId'):\n436:         value = record.get(key)\n437:         if value is not None and str(value) in by_id:\n438:             return by_id[str(value)]\n439:     return None\n440: \n441: \n442: def _record_ids(records):\n443:     return {_record_id(record) for record in records}\n444: \n445: \n446: def _action_of(form):\n447:     return form.action or '/'\n448: \n449: \n450: def _form_fields(form, overrides=None, omit=()):\n451:     fields = {}\n452:     for field in form.fields:\n453:         name = field.name\n454:         if not name:\n455:             continue\n456:         if field.type in ('submit', 'button', 'reset', 'file', 'image'):\n457:             continue\n458:         if field.type in ('checkbox', 'radio') and not field.checked:\n459:             continue\n460:         fields[name] = field.value\n461:     for select in form.selects:\n462:         if select.name:\n463:             fields[select.name] = select.selected_value()\n464:     for textarea in form.textareas:\n465:         if textarea.name:\n466:             fields[textarea.name] = textarea.text\n467:     if overrides:\n468:         for key, value in overrides.items():\n469:             fields[str(key)] = str(value)\n470:     for name in omit:\n471:         fields.pop(name, None)\n472:     return fields\n473: \n474: \n475: def _form_error_text(doc):\n476:     parts = []\n477:     for entry in doc.testids:\n478:         testid = (entry['attrs'].get('data-testid') or '').lower()\n479:         if testid == 'form-error' or 'form-error' in testid:\n480:             text = _WHITESPACE_RE.sub(' ', entry['text']).strip()\n481:             if text:\n482:                 parts.append(text)\n483:     return ' '.join(parts)\n484: \n485: \n486: def _row_for_url(doc, url):\n487:     for row in doc.rows:\n488:         for anchor in row.anchors:\n489:             if anchor.testid == 'record-open-link' and anchor.href == url:\n490:                 return row\n491:     for row in doc.rows:\n492:         for anchor in row.anchors:\n493:             if anchor.href == url:\n494:                 return row\n495:     return None\n496: \n497: \n498: def _row_by_id(doc, record_id):\n499:     for row in doc.rows:\n500:         if row.record_id == record_id:\n501:             return row\n502:     return None\n503: \n504: \n505: def _row_open_link(row):\n506:     for anchor in row.anchors:\n507:         if anchor.testid == 'record-open-link':\n508:             return anchor\n509:     for anchor in row.anchors:\n510:         if anchor.href.startswith('http://') or anchor.href.startswith('https://'):\n511:             return anchor\n512:     return None\n513: \n514: \n515: def _category_values_in_html(doc):\n516:     values = set()\n517:     for form in doc.forms:\n518:         for select in form.selects:\n519:             if select.name != 'category':\n520:                 continue\n521:             for option in select.options:\n522:                 value = option.resolved_value()\n523:                 if value:\n524:                     values.add(value)\n525:                 text = option.text.strip()\n526:                 if text:\n527:                     values.add(text)\n528:     for anchor in doc.anchors:\n529:         try:\n530:             parts = urllib.parse.urlsplit(anchor.href)\n531:         except ValueError:\n532:             continue\n533:         for key, value in urllib.parse.parse_qsl(parts.query, keep_blank_values=True):\n534:             if key == 'category' and value:\n535:                 values.add(value)\n536:     return values\n537: \n538: \n539: def _has_list_container(doc):\n540:     for tag, attrs in doc.start_tags:\n541:         if tag in _LIST_TAGS:\n542:             return True\n543:         if tag not in _LIST_ATTR_TAGS:\n544:             continue\n545:         haystack = ' '.join((\n546:             attrs.get('data-testid') or '',\n547:             attrs.get('id') or '',\n548:             attrs.get('class') or '',\n549:         )).lower()\n550:         if any(token in haystack for token in ('bookmark', 'record', 'list', 'item')):\n551:             return True\n552:     return False\n553: \n554: \n555: def _empty_state_marker(doc):\n556:     for entry in doc.testids:\n557:         testid = (entry['attrs'].get('data-testid') or '').lower()\n558:         if 'empty' in testid:\n559:             text = _WHITESPACE_RE.sub(' ', entry['text']).strip()\n560:             return text or testid\n561:     text = _WHITESPACE_RE.sub(' ', doc.text).lower()\n562:     for marker in _EMPTY_MARKERS:\n563:         if marker in text:\n564:             return marker\n565:     return ''\n566: \n567: \n568: def _save_form_from_home(client, recorder, aid):\n569:     home = client.get('/', accept='text/html')\n570:     recorder.expect_status(home, 200, aid=f'{aid}-home-status')\n571:     doc = _parse_html(home.text)\n572:     form = doc.save_form()\n573:     if not recorder.check(\n574:         f'{aid}-save-form',\n575:         form is not None,\n576:         '首页含 action=/bookmarks/new 且 method=post 的保存表单',\n577:     ):\n578:         return doc, None\n579:     return doc, form\n580: \n581: \n582: def _follow_303(client, recorder, response, aid):\n583:     recorder.expect_status(response, 303, aid=f'{aid}-status')\n584:     location = response.location\n585:     if not recorder.check(\n586:         f'{aid}-location',\n587:         bool(location),\n588:         f'303 响应必须带 Location，实际 {location!r}',\n589:     ):\n590:         return None\n591:     page = client.get(location, accept='text/html')\n592:     recorder.expect_status(page, 200, aid=f'{aid}-follow-status')\n593:     return page\n594: \n595: \n596: def _get_record(client, recorder, record_id, aid):\n597:     if not record_id:\n598:         recorder.check(f'{aid}-record-id', False, '缺少记录 id，无法读回 JSON')\n599:         return None\n600:     response = client.get(_bookmark_path(record_id))\n601:     recorder.expect_status(response, 200, aid=f'{aid}-record-status')\n602:     payload = _safe_json(response)\n603:     record = _extract_record(payload)\n604:     recorder.check(\n605:         f'{aid}-record-shape',\n606:         isinstance(record, dict),\n607:         'GET /api/bookmarks/{id} 必须返回 JSON 对象，实际 ' + type(payload).__name__,\n608:     )\n609:     return record if isinstance(record, dict) else None\n610: \n611: \n612: def _case_a01(args, recorder):\n613:     client = common.HttpClient(args.base_url)\n614:     live_url = _unique_url('a01-live')\n615:     live_title = f'A01 保存标题 {uuid.uuid4().hex[:8]}'\n616:     live_description = f'A01 保存描述 {uuid.uuid4().hex[:8]}'\n617:     try:\n618:         health = client.get('/api/health')\n619:         recorder.expect_status(health, 200, aid='a01-health-status')\n620:         recorder.check(\n621:             'a01-health-json',\n622:             isinstance(_safe_json(health), dict),\n623:             '/api/health 返回 JSON 对象',\n624:         )\n625:         _, form = _save_form_from_home(client, recorder, 'a01')\n626:         if form is None:\n627:             return\n628:         fields = _form_fields(form, {\n629:             'url': live_url,\n630:             'title': live_title,\n631:             'description': live_description,\n632:         })\n633:         response = client.post_form(\n634:             _action_of(form), fields, follow_redirects=False, accept='text/html'\n635:         )\n636:         page = _follow_303(client, recorder, response, 'a01-save')\n637:         if page is None:\n638:             return\n639:         doc = _parse_html(page.text)\n640:         row = _row_for_url(doc, live_url)\n641:         if not recorder.check(\n642:             'a01-row-present',\n643:             row is not None,\n644:             f'保存后 HTML 列表出现原始 URL={live_url!r} 的记录行',\n645:         ):\n646:             return\n647:         record_id = row.record_id\n648:         recorder.check('a01-row-id', bool(record_id), f'记录行 data-record-id={record_id!r}')\n649:         recorder.check(\n650:             'a01-row-title',\n651:             live_title in row.text,\n652:             f'记录行文本包含标题 {live_title!r}',\n653:         )\n654:         recorder.check(\n655:             'a01-row-description',\n656:             live_description in row.text,\n657:             f'记录行文本包含描述 {live_description!r}',\n658:         )\n659:         link = _row_open_link(row)\n660:         href = link.href if link is not None else None\n661:         recorder.check(\n662:             'a01-row-href',\n663:             href == live_url,\n664:             f'行内打开链接 href={href!r}（期望 {live_url!r}）',\n665:         )\n666:         record = _get_record(client, recorder, record_id, 'a01')\n667:         if record is not None:\n668:             recorder.check(\n669:                 'a01-json-id',\n670:                 _record_id(record) == record_id,\n671:                 f'JSON id={_record_id(record)!r}（期望 {record_id!r}）',\n672:             )\n673:             recorder.check(\n674:                 'a01-json-url',\n675:                 _record_url(record) == live_url,\n676:                 f'JSON url={_record_url(record)!r}（期望 {live_url!r}）',\n677:             )\n678:             recorder.check(\n679:                 'a01-json-title',\n680:                 _record_title(record) == live_title,\n681:                 f'JSON title={_record_title(record)!r}（期望 {live_title!r}）',\n682:             )\n683:             recorder.check(\n684:                 'a01-json-description',\n685:                 _record_description(record) == live_description,\n686:                 f'JSON description={_record_description(record)!r}（期望 {live_description!r}）',\n687:             )\n688:     finally:\n689:         client.close()\n690: \n691:     first = None\n692:     second = None\n693:     instance_dir = None\n694:     restart_id = None\n695:     restart_url = _unique_url('a01-restart')\n696:     restart_title = f'A01 重启标题 {uuid.uuid4().hex[:8]}'\n697:     restart_description = f'A01 重启描述 {uuid.uuid4().hex[:8]}'\n698:     try:\n699:         try:\n700:             first = common.launch_app(args.app_root, args.data_dir, 0)\n701:             instance_dir = first.instance_dir\n702:             first_client = None\n703:             try:\n704:                 first_client = common.HttpClient(first.base_url)\n705:                 _, form = _save_form_from_home(first_client, recorder, 'a01-instance')\n706:                 if form is not None:\n707:                     fields = _form_fields(form, {\n708:                         'url': restart_url,\n709:                         'title': restart_title,\n710:                         'description': restart_description,\n711:                     })\n712:                     response = first_client.post_form(\n713:                         _action_of(form), fields, follow_redirects=False, accept='text/html'\n714:                     )\n715:                     page = _follow_303(first_client, recorder, response, 'a01-instance')\n716:                     if page is not None:\n717:                         doc = _parse_html(page.text)\n718:                         row = _row_for_url(doc, restart_url)\n719:                         if recorder.check(\n720:                             'a01-instance-row',\n721:                             row is not None,\n722:                             f'隔离实例保存后 HTML 列表出现 URL={restart_url!r} 的记录行',\n723:                         ):\n724:                             restart_id = row.record_id\n725:                             recorder.check(\n726:                                 'a01-instance-row-id',\n727:                                 bool(restart_id),\n728:                                 f'隔离实例记录 data-record-id={restart_id!r}',\n729:                             )\n730:                             recorder.check(\n731:                                 'a01-instance-row-title',\n732:                                 restart_title in row.text,\n733:                                 f'隔离实例记录行包含标题 {restart_title!r}',\n734:                             )\n735:                             recorder.check(\n736:                                 'a01-instance-row-description',\n737:                                 restart_description in row.text,\n738:                                 f'隔离实例记录行包含描述 {restart_description!r}',\n739:                             )\n740:                             link = _row_open_link(row)\n741:                             href = link.href if link is not None else None\n742:                             recorder.check(\n743:                                 'a01-instance-row-href',\n744:                                 href == restart_url,\n745:                                 f'隔离实例行内 href={href!r}（期望 {restart_url!r}）',\n746:                             )\n747:                             record = _get_record(\n748:                                 first_client, recorder, restart_id, 'a01-instance'\n749:                             )\n750:                             if record is not None:\n751:                                 recorder.check(\n752:                                     'a01-instance-json-url',\n753:                                     _record_url(record) == restart_url,\n754:                                     f'隔离实例 JSON url={_record_url(record)!r}（期望 {restart_url!r}）',\n755:                                 )\n756:             finally:\n757:                 if first_client is not None:\n758:                     first_client.close()\n759:         finally:\n760:             if first is not None:\n761:                 common.stop_app(first)\n762:         if not restart_id or not instance_dir:\n763:             recorder.check(\n764:                 'a01-restart-prerequisite',\n765:                 False,\n766:                 '隔离实例未提供可重启的记录 id 或实例目录',\n767:             )\n768:             return\n769:         second = common.launch_app(\n770:             args.app_root, args.data_dir, 0, instance_dir=instance_dir\n771:         )\n772:         second_client = None\n773:         try:\n774:             second_client = common.HttpClient(second.base_url)\n775:             page = second_client.get('/', accept='text/html')\n776:             recorder.expect_status(page, 200, aid='a01-restart-home-status')\n777:             doc = _parse_html(page.text)\n778:             row = _row_by_id(doc, restart_id)\n779:             recorder.check(\n780:                 'a01-restart-row',\n781:                 row is not None,\n782:                 f'重启后 HTML 列表包含 id={restart_id!r} 的记录行',\n783:             )\n784:             if row is not None:\n785:                 link = _row_open_link(row)\n786:                 href = link.href if link is not None else None\n787:                 recorder.check(\n788:                     'a01-restart-href',\n789:                     href == restart_url,\n790:                     f'重启后行内 href={href!r}（期望 {restart_url!r}）',\n791:                 )\n792:                 recorder.check(\n793:                     'a01-restart-title',\n794:                     restart_title in row.text,\n795:                     f'重启后记录行包含标题 {restart_title!r}',\n796:                 )\n797:                 recorder.check(\n798:                     'a01-restart-description',\n799:                     restart_description in row.text,\n800:                     f'重启后记录行包含描述 {restart_description!r}',\n801:                 )\n802:             record = _get_record(second_client, recorder, restart_id, 'a01-restart')\n803:             if record is not None:\n804:                 recorder.check(\n805:                     'a01-restart-id',\n806:                     _record_id(record) == restart_id,\n807:                     f'重启后 JSON id={_record_id(record)!r}（期望 {restart_id!r}）',\n808:                 )\n809:                 recorder.check(\n810:                     'a01-restart-url',\n811:                     _record_url(record) == restart_url,\n812:                     f'重启后 JSON url={_record_url(record)!r}（期望 {restart_url!r}）',\n813:                 )\n814:                 recorder.check(\n815:                     'a01-restart-title-json',\n816:                     _record_title(record) == restart_title,\n817:                     f'重启后 JSON title={_record_title(record)!r}（期望 {restart_title!r}）',\n818:                 )\n819:                 recorder.check(\n820:                     'a01-restart-description-json',\n821:                     _record_description(record) == restart_description,\n822:                     f'重启后 JSON description={_record_description(record)!r}（期望 {restart_description!r}）',\n823:                 )\n824:         finally:\n825:             if second_client is not None:\n826:                 second_client.close()\n827:     finally:\n828:         if second is not None:\n829:             common.stop_app(second)\n830: \n831: \n832: def _case_a02(args, recorder):\n833:     client = common.HttpClient(args.base_url)\n834:     token = uuid.uuid4().hex[:12]\n835:     boundary = f'http://atlas-a02-{token}'\n836:     boundary_title = f'A02 单标签主机 {token}'\n837:     boundary_description = f'A02 原始字符串 {token}'\n838:     invalid_values = [\n839:         ('missing-scheme', f'{token}.example.com/no-scheme'),\n840:         ('javascript-scheme', f'javascript:void({token})'),\n841:         ('ftp-scheme', f'ftp://{token}.example.com/manual'),\n842:         ('empty-host', 'http://'),\n843:         ('space-in-hostname', f'http://{token}.exa mple.com/path'),\n844:         ('illegal-hostname', f'http://{token}.example.com|invalid/'),\n845:     ]\n846:     try:\n847:         _, form = _save_form_from_home(client, recorder, 'a02')\n848:         if form is None:\n849:             return\n850:         fields = _form_fields(form, {\n851:             'url': boundary,\n852:             'title': boundary_title,\n853:             'description': boundary_description,\n854:         })\n855:         response = client.post_form(\n856:             _action_of(form), fields, follow_redirects=False, accept='text/html'\n857:         )\n858:         page = _follow_303(client, recorder, response, 'a02-boundary')\n859:         if page is None:\n860:             return\n861:         doc = _parse_html(page.text)\n862:         row = _row_for_url(doc, boundary)\n863:         recorder.check(\n864:             'a02-boundary-row',\n865:             row is not None,\n866:             f'单标签主机 URL={boundary!r} 出现在 HTML 列表',\n867:         )\n868:         record_id = row.record_id if row is not None else ''\n869:         recorder.check(\n870:             'a02-boundary-id',\n871:             bool(record_id),\n872:             f'单标签主机记录 data-record-id={record_id!r}',\n873:         )\n874:         if row is not None:\n875:             link = _row_open_link(row)\n876:             href = link.href if link is not None else None\n877:             recorder.check(\n878:                 'a02-boundary-href',\n879:                 href == boundary,\n880:                 f'行内 href={href!r}（期望精确等于 {boundary!r}）',\n881:             )\n882:         if record_id:\n883:             record = _get_record(client, recorder, record_id, 'a02-boundary')\n884:             if record is not None:\n885:                 recorder.check(\n886:                     'a02-boundary-json-url',\n887:                     _record_url(record) == boundary,\n888:                     f'JSON url={_record_url(record)!r}（期望原始字符串 {boundary!r}）',\n889:                 )\n890:         # Independent JSON positive: not an HTML-created record read through JSON.\n891:         before_json_ids = _record_ids(_fetch_bookmarks(client, recorder, 'a02-json-before-create'))\n892:         json_boundary = f'https://atlas-a02-json-{token}/original?keep=1'\n893:         positive = client.post_json('/api/bookmarks', {\n894:             'url': json_boundary, 'title': f'A02 JSON {token}',\n895:             'description': f'A02 JSON positive {token}',\n896:         })\n897:         recorder.expect_status(positive, 201, aid='a02-json-boundary-create-status')\n898:         json_id = _record_id(_extract_record(_safe_json(positive)))\n899:         recorder.check('a02-json-boundary-new-id', bool(json_id) and json_id not in before_json_ids,\n900:                        f'独立 JSON POST 返回新的非空 id={json_id!r}')\n901:         if json_id:\n902:             saved = _get_record(client, recorder, json_id, 'a02-json-boundary')\n903:             recorder.check('a02-json-boundary-readback',\n904:                            _record_id(saved) == json_id and _record_url(saved) == json_boundary,\n905:                            '独立 GET 读回同一 id 与精确原始 URL')\n906:             listed_positive = _fetch_bookmarks(client, recorder, 'a02-json-positive')\n907:             recorder.check('a02-json-boundary-listed', any(\n908:                 _record_id(item) == json_id and _record_url(item) == json_boundary\n909:                 for item in listed_positive), '列表包含同一 JSON 创建记录与原始 URL')\n910:         before = _fetch_bookmarks(client, recorder, 'a02-before')\n911:         before_total = len(before)\n912:         before_token = sum(1 for item in before if token in (_record_url(item) or ''))\n913:         for label, bad_url in invalid_values:\n914:             bad_fields = _form_fields(form, {\n915:                 'url': bad_url,\n916:                 'title': f'A02 拒绝 {label}',\n917:                 'description': f'A02 保留输入 {label}',\n918:             })\n919:             html_response = client.post_form(\n920:                 _action_of(form), bad_fields, follow_redirects=False, accept='text/html'\n921:             )\n922:             recorder.expect_status(html_response, 400, aid=f'a02-html-{label}-status')\n923:             error_doc = _parse_html(html_response.text)\n924:             error_text = _form_error_text(error_doc)\n925:             recorder.check(\n926:                 f'a02-html-{label}-form-error',\n927:                 bool(error_text),\n928:                 f'HTML 非法 URL 显示可读 form-error，实际 {error_text!r}',\n929:             )\n930:             error_form = error_doc.save_form()\n931:             recorder.check(\n932:                 f'a02-html-{label}-form-present',\n933:                 error_form is not None,\n934:                 'HTML 错误页保留可重新提交的保存表单',\n935:             )\n936:             if error_form is not None:\n937:                 retained = error_form.value('url')\n938:                 recorder.check(\n939:                     f'a02-html-{label}-retained',\n940:                     retained == bad_url,\n941:                     f'HTML 错误页保留 url={retained!r}（期望 {bad_url!r}）',\n942:                 )\n943:             json_response = client.post_json('/api/bookmarks', {'url': bad_url})\n944:             recorder.expect_status(json_response, 400, aid=f'a02-json-{label}-status')\n945:             code = _error_code(json_response)\n946:             recorder.check(\n947:                 f'a02-json-{label}-code',\n948:                 code == 'invalid_url',\n949:                 f'JSON 非法 URL 错误码={code!r}（期望 invalid_url）',\n950:             )\n951:         after = _fetch_bookmarks(client, recorder, 'a02-after')\n952:         after_total = len(after)\n953:         after_token = sum(1 for item in after if token in (_record_url(item) or ''))\n954:         recorder.check(\n955:             'a02-relative-count',\n956:             after_total == before_total and after_token == before_token,\n957:             f'非法提交前后记录数 {before_total}->{after_total}，标记记录数 {before_token}->{after_token}（不得新增）',\n958:         )\n959:         listed = {_record_url(item) for item in after}\n960:         for label, bad_url in invalid_values:\n961:             recorder.check(\n962:                 f'a02-{label}-absent',\n963:                 bad_url not in listed,\n964:                 f'被拒绝的 url={bad_url!r} 不出现在列表',\n965:             )\n966:     finally:\n967:         client.close()\n968: \n969: \n970: def _case_a03(args, recorder):\n971:     client = common.HttpClient(args.base_url)\n972:     default_url = _unique_url('a03-default')\n973:     default_title = f'A03 默认归类 {uuid.uuid4().hex[:8]}'\n974:     new_name = f'自动归类-{uuid.uuid4().hex[:8]}'\n975:     new_url = _unique_url('a03-newcat')\n976:     new_title = f'A03 新归类 {uuid.uuid4().hex[:8]}'\n977:     try:\n978:         categories = _fetch_categories(client, recorder, 'a03')\n979:         api_names = _category_names(categories)\n980:         for index, preset in enumerate(common.PRESET_CATEGORIES, 1):\n981:             recorder.check(\n982:                 f'a03-api-preset-{index}',\n983:                 preset in api_names,\n984:                 f'/api/categories 包含预置归类 {preset!r}；实际 {sorted(api_names)}',\n985:             )\n986:         doc, form = _save_form_from_home(client, recorder, 'a03')\n987:         html_categories = _category_values_in_html(doc)\n988:         for index, preset in enumerate(common.PRESET_CATEGORIES, 1):\n989:             recorder.check(\n990:                 f'a03-html-preset-{index}',\n991:                 preset in html_categories,\n992:                 f'首页 HTML 归类链接/选项包含 {preset!r}；实际 {sorted(html_categories)}',\n993:             )\n994:         if form is None:\n995:             return\n996:         omitted_fields = _form_fields(form, {\n997:             'url': default_url,\n998:             'title': default_title,\n999:         }, omit=('category',))\n1000:         recorder.check(\n1001:             'a03-category-omitted',\n1002:             'category' not in omitted_fields,\n1003:             '真实保存表单省略 category 字段后提交',\n1004:         )\n1005:         response = client.post_form(\n1006:             _action_of(form), omitted_fields, follow_redirects=False, accept='text/html'\n1007:         )\n1008:         page = _follow_303(client, recorder, response, 'a03-default')\n1009:         if page is None:\n1010:             return\n1011:         default_doc = _parse_html(page.text)\n1012:         default_row = _row_for_url(default_doc, default_url)\n1013:         if not recorder.check(\n1014:             'a03-default-row',\n1015:             default_row is not None,\n1016:             f'省略归类保存后 HTML 列表出现 URL={default_url!r} 的记录行',\n1017:         ):\n1018:             return\n1019:         default_id = default_row.record_id\n1020:         recorder.check(\n1021:             'a03-default-id',\n1022:             bool(default_id),\n1023:             f'默认归类记录 id={default_id!r}',\n1024:         )\n1025:         record = _get_record(client, recorder, default_id, 'a03-default')\n1026:         if record is not None:\n1027:             actual_category = _category_name(record, categories)\n1028:             recorder.check(\n1029:                 'a03-default-category',\n1030:                 actual_category == common.DEFAULT_CATEGORY,\n1031:                 f'省略 category 后 JSON 归类={actual_category!r}（期望 {common.DEFAULT_CATEGORY!r}）',\n1032:             )\n1033:         inbox = client.get(\n1034:             '/', params={'category': common.DEFAULT_CATEGORY}, accept='text/html'\n1035:         )\n1036:         recorder.expect_status(inbox, 200, aid='a03-inbox-status')\n1037:         inbox_doc = _parse_html(inbox.text)\n1038:         recorder.check(\n1039:             'a03-inbox-row',\n1040:             default_id is not None and default_id in {row.record_id for row in inbox_doc.rows},\n1041:             f'「{common.DEFAULT_CATEGORY}」过滤列表包含 id={default_id!r}',\n1042:         )\n1043:         new_fields = _form_fields(form, {\n1044:             'url': new_url,\n1045:             'title': new_title,\n1046:             'category': new_name,\n1047:         })\n1048:         response = client.post_form(\n1049:             _action_of(form), new_fields, follow_redirects=False, accept='text/html'\n1050:         )\n1051:         page = _follow_303(client, recorder, response, 'a03-newcat')\n1052:         if page is None:\n1053:             return\n1054:         new_doc = _parse_html(page.text)\n1055:         new_row = _row_for_url(new_doc, new_url)\n1056:         if not recorder.check(\n1057:             'a03-newcat-row',\n1058:             new_row is not None,\n1059:             f'新归类保存后 HTML 列表出现 URL={new_url!r} 的记录行',\n1060:         ):\n1061:             return\n1062:         new_id = new_row.record_id\n1063:         recorder.check('a03-newcat-id', bool(new_id), f'新归类记录 id={new_id!r}')\n1064:         refreshed = _fetch_categories(client, recorder, 'a03-refreshed')\n1065:         refreshed_names = _category_names(refreshed)\n1066:         recorder.check(\n1067:             'a03-newcat-created',\n1068:             new_name in refreshed_names,\n1069:             f'保存新归类名 {new_name!r} 后 /api/categories 自动创建；实际 {sorted(refreshed_names)}',\n1070:         )\n1071:         record = _get_record(client, recorder, new_id, 'a03-newcat')\n1072:         if record is not None:\n1073:             actual_category = _category_name(record, refreshed)\n1074:             recorder.check(\n1075:                 'a03-newcat-json-category',\n1076:                 actual_category == new_name,\n1077:                 f'新归类记录 JSON 归类={actual_category!r}（期望 {new_name!r}）',\n1078:             )\n1079:         filtered = client.get('/', params={'category': new_name}, accept='text/html')\n1080:         recorder.expect_status(filtered, 200, aid='a03-newcat-filter-status')\n1081:         filtered_doc = _parse_html(filtered.text)\n1082:         recorder.check(\n1083:             'a03-newcat-filter',\n1084:             new_id is not None and new_id in {row.record_id for row in filtered_doc.rows},\n1085:             f'HTML 归类过滤 {new_name!r} 包含 id={new_id!r}',\n1086:         )\n1087:         api_filtered = _fetch_bookmarks(\n1088:             client, recorder, 'a03-newcat-api', params={'category': new_name}\n1089:         )\n1090:         recorder.check(\n1091:             'a03-newcat-api-filter',\n1092:             new_id is not None and new_id in _record_ids(api_filtered),\n1093:             f'API 归类过滤 {new_name!r} 包含 id={new_id!r}',\n1094:         )\n1095:     finally:\n1096:         client.close()\n1097: \n1098: \n1099: def _case_a11_base(args, recorder):\n1100:     client = common.HttpClient(args.base_url)\n1101:     unknown = f'不存在归类-{uuid.uuid4().hex[:10]}'\n1102:     try:\n1103:         health = client.get('/api/health')\n1104:         recorder.expect_status(health, 200, aid='a11-base-health-status')\n1105:         health_payload = _safe_json(health)\n1106:         recorder.check(\n1107:             'a11-base-health-json',\n1108:             isinstance(health_payload, dict) and bool(health_payload),\n1109:             f'/api/health 返回非空 JSON 对象，实际 {type(health_payload).__name__}',\n1110:         )\n1111:         page = client.get('/', accept='text/html')\n1112:         recorder.expect_status(page, 200, aid='a11-base-home-status')\n1113:         recorder.check(\n1114:             'a11-base-home-content-type',\n1115:             'text/html' in page.content_type.lower(),\n1116:             f'首页 Content-Type={page.content_type!r}',\n1117:         )\n1118:         doc = _parse_html(page.text)\n1119:         form = doc.save_form()\n1120:         recorder.check(\n1121:             'a11-base-entry-form',\n1122:             form is not None,\n1123:             '首页含 action=/bookmarks/new 且 method=post 的录入表单',\n1124:         )\n1125:         if form is not None:\n1126:             recorder.check(\n1127:                 'a11-base-entry-action',\n1128:                 _action_path(form.action) == '/bookmarks/new',\n1129:                 f'录入表单 action={form.action!r}',\n1130:             )\n1131:             recorder.check(\n1132:                 'a11-base-url-field',\n1133:                 form.has_name('url'),\n1134:                 '录入表单含 name=url 输入字段',\n1135:             )\n1136:         manager = next(\n1137:             (anchor for anchor in doc.anchors if anchor.testid == 'category-manager'),\n1138:             None,\n1139:         )\n1140:         manager_href = manager.href if manager is not None else None\n1141:         manager_path = ''\n1142:         if manager_href:\n1143:             try:\n1144:                 manager_path = urllib.parse.urlsplit(manager_href).path.rstrip('/')\n1145:             except ValueError:\n1146:                 manager_path = ''\n1147:         recorder.check(\n1148:             'a11-base-category-manager',\n1149:             manager is not None and manager_path == '/categories',\n1150:             f'首页 category-manager 链接 href={manager_href!r}（期望指向 /categories）',\n1151:         )\n1152:         recorder.check(\n1153:             'a11-base-list-container',\n1154:             _has_list_container(doc),\n1155:             '首页含记录列表容器',\n1156:         )\n1157:         empty_page = client.get('/', params={'category': unknown}, accept='text/html')\n1158:         recorder.expect_status(empty_page, 200, aid='a11-base-unknown-status')\n1159:         empty_doc = _parse_html(empty_page.text)\n1160:         recorder.check(\n1161:             'a11-base-unknown-filter-empty',\n1162:             len(empty_doc.rows) == 0,\n1163:             f'不存在归类 {unknown!r} 过滤后记录行数={len(empty_doc.rows)}（期望 0）',\n1164:         )\n1165:         marker = _empty_state_marker(empty_doc)\n1166:         recorder.check(\n1167:             'a11-base-unknown-empty-state',\n1168:             bool(marker),\n1169:             f'不存在归类过滤显示明确空状态，标记={marker!r}',\n1170:         )\n1171:     finally:\n1172:         client.close()\n1173: \n1174: \n1175: def _case_a11(args, recorder):\n1176:     # The base deployment may already contain records. Only fresh proves first init.\n1177:     if not recorder.check('a11-fresh-required-flags', bool(args.app_root and args.data_dir),\n1178:                           'A11 必须绑定实际冻结 app_root 与测试者 data_dir'):\n1179:         return\n1180:     _case_a11_base(args, recorder)\n1181:     proc = None\n1182:     client = None\n1183:     try:\n1184:         proc = common.launch_app(args.app_root, args.data_dir, 0, fresh=True)\n1185:         recorder.check('a11-fresh-owned-source',\n1186:                        os.path.realpath(proc.app_root) == os.path.realpath(args.app_root),\n1187:                        'fresh 实例来自同一冻结交付源码')\n1188:         client = common.HttpClient(proc.base_url)\n1189:         health = client.get('/api/health')\n1190:         recorder.expect_status(health, 200, aid='a11-fresh-health-status')\n1191:         recorder.check('a11-fresh-health-json', isinstance(_safe_json(health), dict),\n1192:                        'fresh 健康检查返回 JSON 对象')\n1193:         # No business write precedes these unfiltered observations.\n1194:         for name, params in (('active', None), ('including-trash', {'include_trashed': '1'})):\n1195:             records = _fetch_bookmarks(client, recorder, f'a11-fresh-{name}', params)\n1196:             recorder.check(f'a11-fresh-{name}-empty', records == [],\n1197:                            f'未过滤全库 {name} 记录数={len(records)}，首次初始化必须为0')\n1198:         categories = _fetch_categories(client, recorder, 'a11-fresh')\n1199:         ids = []\n1200:         for index, preset in enumerate(common.PRESET_CATEGORIES, 1):\n1201:             matches = [item for item in categories if isinstance(item, dict) and item.get('name') == preset]\n1202:             recorder.check(f'a11-fresh-preset-{index}', len(matches) == 1,\n1203:                            f'首次初始化准确存在预置分类 {preset!r}')\n1204:             if len(matches) == 1:\n1205:                 item = matches[0]\n1206:                 cid = item.get('id')\n1207:                 legal = isinstance(cid, (str, int)) and not isinstance(cid, bool) and bool(str(cid).strip())\n1208:                 recorder.check(f'a11-fresh-preset-{index}-id', legal, f'分类 ID={cid!r}')\n1209:                 recorder.check(f'a11-fresh-preset-{index}-count', item.get('count') == 0,\n1210:                                f'预置分类活动记录 count={item.get(\"count\")!r}')\n1211:                 ids.append(str(cid))\n1212:         recorder.check('a11-fresh-preset-unique-ids', len(ids) == 4 and len(set(ids)) == 4,\n1213:                        '四个预置分类 ID 各自唯一')\n1214:         page = client.get('/', accept='text/html')\n1215:         recorder.expect_status(page, 200, aid='a11-fresh-home-status')\n1216:         recorder.check('a11-fresh-home-content-type', 'text/html' in page.content_type.lower(),\n1217:                        '未过滤首页是 HTML')\n1218:         doc = _parse_html(page.text)\n1219:         form = doc.save_form()\n1220:         recorder.check('a11-fresh-save-form', form is not None and\n1221:                        _action_path(form.action) == '/bookmarks/new' and form.has_name('url'),\n1222:                        '未过滤首页具备保存表单与 URL 字段')\n1223:         recorder.check('a11-fresh-category-entry', any(\n1224:             a.testid == 'category-manager' and _action_path(a.href) == '/categories'\n1225:             for a in doc.anchors), '未过滤首页有分类管理入口')\n1226:         recorder.check('a11-fresh-list-container', _has_list_container(doc), '未过滤首页有列表容器')\n1227:         recorder.check('a11-fresh-no-record-rows', not doc.rows, '首次初始化未过滤首页没有记录行')\n1228:         recorder.check('a11-fresh-explicit-empty-state', bool(_empty_state_marker(doc)),\n1229:                        '首次初始化未过滤首页有明确空状态')\n1230:     finally:\n1231:         try:\n1232:             if client is not None:\n1233:                 client.close()\n1234:         finally:\n1235:             if proc is not None:\n1236:                 try:\n1237:                     common.stop_app(proc)\n1238:                 except Exception as exc:\n1239:                     recorder.check('a11-fresh-cleanup', False, f'清理异常：{exc}')\n1240:                 recorder.check('a11-fresh-process-stopped', proc.poll() is not None,\n1241:                                '本用例拥有的 fresh 子进程已结束')\n1242: \n1243: _HANDLERS = {\n1244:     'A01': _case_a01,\n1245:     'A02': _case_a02,\n1246:     'A03': _case_a03,\n1247:     'A11': _case_a11,\n1248: }\n1249: \n1250: \n1251: def main(argv=None):\n1252:     try:\n1253:         args = common.parse_case_args(argv)\n1254:     except SystemExit as exc:\n1255:         raw_args = list(sys.argv[1:] if argv is None else argv)\n1256:         requested_a11 = '--case=A11' in raw_args or any(\n1257:             value == '--case' and index + 1 < len(raw_args) and raw_args[index + 1] == 'A11'\n1258:             for index, value in enumerate(raw_args))\n1259:         if not exc.code or not requested_a11:\n1260:             raise\n1261:         failed = common.Recorder('A11')\n1262:         failed.check('a11-fresh-arguments', False, 'A11 参数无效；详见 stderr，不降级或跳过')\n1263:         return failed.finish('A11')\n1264:     recorder = common.Recorder(args.case)\n1265:     handler = _HANDLERS.get(args.case)\n1266:     if handler is None:\n1267:         recorder.check(\n1268:             'dispatch',\n1269:             False,\n1270:             f'acceptance/p0_library.py 不实现用例 {args.case}（应由其他程序派发）',\n1271:         )\n1272:     else:\n1273:         try:\n1274:             handler(args, recorder)\n1275:         except common.AcceptanceError as exc:\n1276:             recorder.check('infrastructure', False, f'验收基础设施错误：{exc}')\n1277:         except Exception as exc:\n1278:             recorder.check(\n1279:                 'unexpected-error',\n1280:                 False,\n1281:                 f'未预期错误：{type(exc).__name__}: {exc}',\n1282:             )\n1283:     return recorder.finish(args.case)\n1284: \n1285: \n1286: if __name__ == '__main__':\n1287:     sys.exit(main())","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file source/candidate/acceptance/p0_library.py, lines 1-1287\n1: #!/usr/bin/env python3\n2: '''P0 行为验收组：A01、A02、A03、A11。\n3: \n4: 覆盖真实保存表单与会话/重启持久化、URL 正向边界与非法输入、\n5: 默认归类与自动创建归类、启动健康与首页外壳。仅使用 Python 3.12\n6: 标准库并复用 acceptance/common.py：以 --case 派发，未知用例显式失败；\n7: 每个用例对真实目标执行正向与硬负向行为断言，向 stdout 输出单个\n8: atlas.acceptance-result.v1 JSON，失败时以非零码退出。\n9: '''\n10: \n11: from __future__ import annotations\n12: \n13: import os\n14: import re\n15: import sys\n16: import urllib.parse\n17: import uuid\n18: from html.parser import HTMLParser\n19: \n20: _THIS_DIR = os.path.dirname(os.path.abspath(__file__))\n21: if _THIS_DIR not in sys.path:\n22:     sys.path.insert(0, _THIS_DIR)\n23: \n24: import common\n25: \n26: _WHITESPACE_RE = re.compile(r'\\s+')\n27: _EMPTY_MARKERS = (\n28:     '暂无',\n29:     '没有记录',\n30:     '还没有',\n31:     '空状态',\n32:     '无匹配',\n33:     'no bookmarks',\n34:     'nothing here',\n35:     'empty',\n36: )\n37: _LIST_TAGS = frozenset({'ul', 'ol', 'table'})\n38: _LIST_ATTR_TAGS = frozenset({'div', 'main', 'section', 'article', 'aside'})\n39: \n40: \n41: class _Field:\n42:     def __init__(self, attrs):\n43:         self.attrs = attrs\n44:         self.name = attrs.get('name')\n45:         self.value = attrs.get('value', '')\n46:         self.type = (attrs.get('type') or 'text').lower()\n47:         self.checked = 'checked' in attrs\n48: \n49: \n50: class _Option:\n51:     def __init__(self, attrs):\n52:         self.attrs = attrs\n53:         self.value = attrs.get('value')\n54:         self.text = ''\n55:         self.selected = 'selected' in attrs\n56: \n57:     def resolved_value(self):\n58:         if self.value is not None:\n59:             return self.value\n60:         return self.text.strip()\n61: \n62: \n63: class _Select:\n64:     def __init__(self, attrs):\n65:         self.attrs = attrs\n66:         self.name = attrs.get('name')\n67:         self.options = []\n68: \n69:     def selected_value(self):\n70:         for option in self.options:\n71:             if option.selected:\n72:                 return option.resolved_value()\n73:         if self.options:\n74:             return self.options[0].resolved_value()\n75:         return ''\n76: \n77: \n78: class _Textarea:\n79:     def __init__(self, attrs):\n80:         self.attrs = attrs\n81:         self.name = attrs.get('name')\n82:         self.text = ''\n83: \n84: \n85: class _Form:\n86:     def __init__(self, attrs):\n87:         self.attrs = attrs\n88:         self.action = (attrs.get('action') or '').strip()\n89:         self.method = (attrs.get('method') or 'get').strip().lower()\n90:         self.testid = attrs.get('data-testid') or ''\n91:         self.fields = []\n92:         self.selects = []\n93:         self.textareas = []\n94: \n95:     def has_name(self, name):\n96:         if any(field.name == name for field in self.fields):\n97:             return True\n98:         if any(select.name == name for select in self.selects):\n99:             return True\n100:         return any(textarea.name == name for textarea in self.textareas)\n101: \n102:     def value(self, name):\n103:         for field in reversed(self.fields):\n104:             if field.name == name:\n105:                 return field.value\n106:         for select in reversed(self.selects):\n107:             if select.name == name:\n108:                 return select.selected_value()\n109:         for textarea in reversed(self.textareas):\n110:             if textarea.name == name:\n111:                 return textarea.text\n112:         return None\n113: \n114: \n115: class _Anchor:\n116:     def __init__(self, attrs):\n117:         self.attrs = attrs\n118:         self.href = attrs.get('href') or ''\n119:         self.testid = attrs.get('data-testid') or ''\n120:         self.text = ''\n121: \n122: \n123: class _Row:\n124:     def __init__(self, attrs):\n125:         self.attrs = attrs\n126:         self.record_id = attrs.get('data-record-id') or ''\n127:         self.anchors = []\n128:         self.text = ''\n129: \n130: \n131: def _action_path(action):\n132:     text = (action or '').strip()\n133:     if not text:\n134:         return ''\n135:     try:\n136:         path = urllib.parse.urlsplit(text).path\n137:     except ValueError:\n138:         return text\n139:     if not path:\n140:         return ''\n141:     if not path.startswith('/'):\n142:         path = '/' + path\n143:     return path.rstrip('/') or '/'\n144: \n145: \n146: class _Document:\n147:     def __init__(self):\n148:         self.forms = []\n149:         self.anchors = []\n150:         self.rows = []\n151:         self.testids = []\n152:         self.start_tags = []\n153:         self.text = ''\n154: \n155:     def save_form(self):\n156:         for form in self.forms:\n157:             if form.method == 'post' and _action_path(form.action) == '/bookmarks/new':\n158:                 return form\n159:         for form in self.forms:\n160:             if form.method == 'post' and form.has_name('url'):\n161:                 return form\n162:         return None\n163: \n164: \n165: class _HtmlReader(HTMLParser):\n166:     def __init__(self):\n167:         super().__init__(convert_charrefs=True)\n168:         self.doc = _Document()\n169:         self._form = None\n170:         self._select = None\n171:         self._option = None\n172:         self._textarea = None\n173:         self._anchor = None\n174:         self._row = None\n175:         self._testid_stack = []\n176: \n177:     def handle_starttag(self, tag, attrs):\n178:         tag = tag.lower()\n179:         attributes = {\n180:             str(key).lower(): ('' if value is None else value)\n181:             for key, value in attrs\n182:         }\n183:         self.doc.start_tags.append((tag, attributes))\n184:         testid = attributes.get('data-testid') or ''\n185:         if testid:\n186:             entry = {'tag': tag, 'attrs': attributes, 'text': ''}\n187:             self.doc.testids.append(entry)\n188:             self._testid_stack.append((tag, entry))\n189:         if tag == 'form':\n190:             self._finish_form()\n191:             self._form = _Form(attributes)\n192:         elif tag == 'input':\n193:             if self._form is not None:\n194:                 self._form.fields.append(_Field(attributes))\n195:         elif tag == 'select':\n196:             self._finish_select()\n197:             if self._form is not None:\n198:                 self._select = _Select(attributes)\n199:         elif tag == 'option':\n200:             self._finish_option()\n201:             if self._select is not None:\n202:                 self._option = _Option(attributes)\n203:         elif tag == 'textarea':\n204:             self._finish_textarea()\n205:             if self._form is not None:\n206:                 self._textarea = _Textarea(attributes)\n207:         elif tag == 'a':\n208:             self._finish_anchor()\n209:             self._anchor = _Anchor(attributes)\n210:         elif tag == 'tr' and testid == 'record-row':\n211:             self._finish_row()\n212:             self._row = _Row(attributes)\n213: \n214:     def handle_data(self, data):\n215:         if not data:\n216:             return\n217:         self.doc.text += data\n218:         if self._row is not None:\n219:             self._row.text += data\n220:         if self._anchor is not None:\n221:             self._anchor.text += data\n222:         if self._option is not None:\n223:             self._option.text += data\n224:         if self._textarea is not None:\n225:             self._textarea.text += data\n226:         for _, entry in self._testid_stack:\n227:             entry['text'] += data\n228: \n229:     def handle_endtag(self, tag):\n230:         tag = tag.lower()\n231:         if tag == 'a':\n232:             self._finish_anchor()\n233:         elif tag == 'option':\n234:             self._finish_option()\n235:         elif tag == 'select':\n236:             self._finish_select()\n237:         elif tag == 'textarea':\n238:             self._finish_textarea()\n239:         elif tag == 'form':\n240:             self._finish_form()\n241:         elif tag == 'tr':\n242:             self._finish_row()\n243:         if self._testid_stack and self._testid_stack[-1][0] == tag:\n244:             self._testid_stack.pop()\n245: \n246:     def _finish_option(self):\n247:         if self._option is None:\n248:             return\n249:         option = self._option\n250:         self._option = None\n251:         if self._select is not None:\n252:             self._select.options.append(option)\n253: \n254:     def _finish_select(self):\n255:         self._finish_option()\n256:         if self._select is None:\n257:             return\n258:         select = self._select\n259:         self._select = None\n260:         if self._form is not None:\n261:             self._form.selects.append(select)\n262: \n263:     def _finish_textarea(self):\n264:         if self._textarea is None:\n265:             return\n266:         textarea = self._textarea\n267:         self._textarea = None\n268:         if self._form is not None:\n269:             self._form.textareas.append(textarea)\n270: \n271:     def _finish_anchor(self):\n272:         if self._anchor is None:\n273:             return\n274:         anchor = self._anchor\n275:         self._anchor = None\n276:         self.doc.anchors.append(anchor)\n277:         if self._row is not None:\n278:             self._row.anchors.append(anchor)\n279: \n280:     def _finish_row(self):\n281:         if self._row is None:\n282:             return\n283:         row = self._row\n284:         self._row = None\n285:         self.doc.rows.append(row)\n286: \n287:     def _finish_form(self):\n288:         self._finish_select()\n289:         self._finish_textarea()\n290:         if self._form is None:\n291:             return\n292:         form = self._form\n293:         self._form = None\n294:         self.doc.forms.append(form)\n295: \n296:     def finalize(self):\n297:         self._finish_anchor()\n298:         self._finish_row()\n299:         self._finish_form()\n300: \n301: \n302: def _parse_html(text):\n303:     reader = _HtmlReader()\n304:     reader.feed(text or '')\n305:     reader.close()\n306:     reader.finalize()\n307:     return reader.doc\n308: \n309: \n310: def _unique_url(tag):\n311:     token = f'{tag}-{uuid.uuid4().hex[:12]}'\n312:     return f'https://{token}.atlas-acceptance.example/{token}'\n313: \n314: \n315: def _safe_json(response):\n316:     try:\n317:         return response.json()\n318:     except Exception:\n319:         return None\n320: \n321: \n322: def _extract_record(payload):\n323:     if isinstance(payload, dict):\n324:         for key in ('bookmark', 'record', 'data', 'item'):\n325:             value = payload.get(key)\n326:             if isinstance(value, dict):\n327:                 return value\n328:         return payload\n329:     return None\n330: \n331: \n332: def _extract_list(payload, keys):\n333:     if isinstance(payload, list):\n334:         return payload\n335:     if isinstance(payload, dict):\n336:         for key in keys:\n337:             value = payload.get(key)\n338:             if isinstance(value, list):\n339:                 return value\n340:     return None\n341: \n342: \n343: def _record_id(record):\n344:     if isinstance(record, dict) and record.get('id') is not None:\n345:         return str(record['id'])\n346:     return None\n347: \n348: \n349: def _record_url(record):\n350:     if isinstance(record, dict) and record.get('url') is not None:\n351:         return str(record['url'])\n352:     return None\n353: \n354: \n355: def _record_title(record):\n356:     if isinstance(record, dict) and record.get('title') is not None:\n357:         return str(record['title'])\n358:     return None\n359: \n360: \n361: def _record_description(record):\n362:     if isinstance(record, dict) and record.get('description') is not None:\n363:         return str(record['description'])\n364:     return None\n365: \n366: \n367: def _bookmark_path(bookmark_id):\n368:     return '/api/bookmarks/' + urllib.parse.quote(str(bookmark_id), safe='')\n369: \n370: \n371: def _error_code(response):\n372:     payload = _safe_json(response)\n373:     if isinstance(payload, dict):\n374:         error = payload.get('error')\n375:         if isinstance(error, dict) and error.get('code') is not None:\n376:             return str(error['code'])\n377:         for key in ('code', 'error_code'):\n378:             if payload.get(key) is not None:\n379:                 return str(payload[key])\n380:     return None\n381: \n382: \n383: def _fetch_bookmarks(client, recorder, aid, params=None):\n384:     response = client.get('/api/bookmarks', params=params)\n385:     recorder.expect_status(response, 200, aid=f'{aid}-list-status')\n386:     payload = _safe_json(response)\n387:     records = _extract_list(payload, ('bookmarks', 'items', 'data', 'records'))\n388:     recorder.check(\n389:         f'{aid}-list-shape',\n390:         isinstance(records, list),\n391:         f'GET /api/bookmarks 必须返回 JSON 数组，实际 {type(payload).__name__}',\n392:     )\n393:     return records if isinstance(records, list) else []\n394: \n395: \n396: def _fetch_categories(client, recorder, aid):\n397:     response = client.get('/api/categories')\n398:     recorder.expect_status(response, 200, aid=f'{aid}-categories-status')\n399:     payload = _safe_json(response)\n400:     categories = _extract_list(payload, ('categories', 'items', 'data'))\n401:     recorder.check(\n402:         f'{aid}-categories-shape',\n403:         isinstance(categories, list),\n404:         f'GET /api/categories 必须返回 JSON 数组，实际 {type(payload).__name__}',\n405:     )\n406:     return categories if isinstance(categories, list) else []\n407: \n408: \n409: def _category_names(categories):\n410:     names = set()\n411:     for item in categories:\n412:         if isinstance(item, dict) and item.get('name') is not None:\n413:             names.add(str(item['name']))\n414:     return names\n415: \n416: \n417: def _category_name(record, categories):\n418:     if not isinstance(record, dict):\n419:         return None\n420:     names = _category_names(categories)\n421:     by_id = {}\n422:     for item in categories:\n423:         if isinstance(item, dict) and item.get('id') is not None and item.get('name') is not None:\n424:             by_id[str(item['id'])] = str(item['name'])\n425:     for key in ('category', 'category_name', 'categoryName'):\n426:         value = record.get(key)\n427:         if isinstance(value, str):\n428:             if value in names:\n429:                 return value\n430:             if value in by_id:\n431:                 return by_id[value]\n432:             return value\n433:         if isinstance(value, dict) and value.get('name') is not None:\n434:             return str(value['name'])\n435:     for key in ('category_id', 'categoryId'):\n436:         value = record.get(key)\n437:         if value is not None and str(value) in by_id:\n438:             return by_id[str(value)]\n439:     return None\n440: \n441: \n442: def _record_ids(records):\n443:     return {_record_id(record) for record in records}\n444: \n445: \n446: def _action_of(form):\n447:     return form.action or '/'\n448: \n449: \n450: def _form_fields(form, overrides=None, omit=()):\n451:     fields = {}\n452:     for field in form.fields:\n453:         name = field.name\n454:         if not name:\n455:             continue\n456:         if field.type in ('submit', 'button', 'reset', 'file', 'image'):\n457:             continue\n458:         if field.type in ('checkbox', 'radio') and not field.checked:\n459:             continue\n460:         fields[name] = field.value\n461:     for select in form.selects:\n462:         if select.name:\n463:             fields[select.name] = select.selected_value()\n464:     for textarea in form.textareas:\n465:         if textarea.name:\n466:             fields[textarea.name] = textarea.text\n467:     if overrides:\n468:         for key, value in overrides.items():\n469:             fields[str(key)] = str(value)\n470:     for name in omit:\n471:         fields.pop(name, None)\n472:     return fields\n473: \n474: \n475: def _form_error_text(doc):\n476:     parts = []\n477:     for entry in doc.testids:\n478:         testid = (entry['attrs'].get('data-testid') or '').lower()\n479:         if testid == 'form-error' or 'form-error' in testid:\n480:             text = _WHITESPACE_RE.sub(' ', entry['text']).strip()\n481:             if text:\n482:                 parts.append(text)\n483:     return ' '.join(parts)\n484: \n485: \n486: def _row_for_url(doc, url):\n487:     for row in doc.rows:\n488:         for anchor in row.anchors:\n489:             if anchor.testid == 'record-open-link' and anchor.href == url:\n490:                 return row\n491:     for row in doc.rows:\n492:         for anchor in row.anchors:\n493:             if anchor.href == url:\n494:                 return row\n495:     return None\n496: \n497: \n498: def _row_by_id(doc, record_id):\n499:     for row in doc.rows:\n500:         if row.record_id == record_id:\n501:             return row\n502:     return None\n503: \n504: \n505: def _row_open_link(row):\n506:     for anchor in row.anchors:\n507:         if anchor.testid == 'record-open-link':\n508:             return anchor\n509:     for anchor in row.anchors:\n510:         if anchor.href.startswith('http://') or anchor.href.startswith('https://'):\n511:             return anchor\n512:     return None\n513: \n514: \n515: def _category_values_in_html(doc):\n516:     values = set()\n517:     for form in doc.forms:\n518:         for select in form.selects:\n519:             if select.name != 'category':\n520:                 continue\n521:             for option in select.options:\n522:                 value = option.resolved_value()\n523:                 if value:\n524:                     values.add(value)\n525:                 text = option.text.strip()\n526:                 if text:\n527:                     values.add(text)\n528:     for anchor in doc.anchors:\n529:         try:\n530:             parts = urllib.parse.urlsplit(anchor.href)\n531:         except ValueError:\n532:             continue\n533:         for key, value in urllib.parse.parse_qsl(parts.query, keep_blank_values=True):\n534:             if key == 'category' and value:\n535:                 values.add(value)\n536:     return values\n537: \n538: \n539: def _has_list_container(doc):\n540:     for tag, attrs in doc.start_tags:\n541:         if tag in _LIST_TAGS:\n542:             return True\n543:         if tag not in _LIST_ATTR_TAGS:\n544:             continue\n545:         haystack = ' '.join((\n546:             attrs.get('data-testid') or '',\n547:             attrs.get('id') or '',\n548:             attrs.get('class') or '',\n549:         )).lower()\n550:         if any(token in haystack for token in ('bookmark', 'record', 'list', 'item')):\n551:             return True\n552:     return False\n553: \n554: \n555: def _empty_state_marker(doc):\n556:     for entry in doc.testids:\n557:         testid = (entry['attrs'].get('data-testid') or '').lower()\n558:         if 'empty' in testid:\n559:             text = _WHITESPACE_RE.sub(' ', entry['text']).strip()\n560:             return text or testid\n561:     text = _WHITESPACE_RE.sub(' ', doc.text).lower()\n562:     for marker in _EMPTY_MARKERS:\n563:         if marker in text:\n564:             return marker\n565:     return ''\n566: \n567: \n568: def _save_form_from_home(client, recorder, aid):\n569:     home = client.get('/', accept='text/html')\n570:     recorder.expect_status(home, 200, aid=f'{aid}-home-status')\n571:     doc = _parse_html(home.text)\n572:     form = doc.save_form()\n573:     if not recorder.check(\n574:         f'{aid}-save-form',\n575:         form is not None,\n576:         '首页含 action=/bookmarks/new 且 method=post 的保存表单',\n577:     ):\n578:         return doc, None\n579:     return doc, form\n580: \n581: \n582: def _follow_303(client, recorder, response, aid):\n583:     recorder.expect_status(response, 303, aid=f'{aid}-status')\n584:     location = response.location\n585:     if not recorder.check(\n586:         f'{aid}-location',\n587:         bool(location),\n588:         f'303 响应必须带 Location，实际 {location!r}',\n589:     ):\n590:         return None\n591:     page = client.get(location, accept='text/html')\n592:     recorder.expect_status(page, 200, aid=f'{aid}-follow-status')\n593:     return page\n594: \n595: \n596: def _get_record(client, recorder, record_id, aid):\n597:     if not record_id:\n598:         recorder.check(f'{aid}-record-id', False, '缺少记录 id，无法读回 JSON')\n599:         return None\n600:     response = client.get(_bookmark_path(record_id))\n601:     recorder.expect_status(response, 200, aid=f'{aid}-record-status')\n602:     payload = _safe_json(response)\n603:     record = _extract_record(payload)\n604:     recorder.check(\n605:         f'{aid}-record-shape',\n606:         isinstance(record, dict),\n607:         'GET /api/bookmarks/{id} 必须返回 JSON 对象，实际 ' + type(payload).__name__,\n608:     )\n609:     return record if isinstance(record, dict) else None\n610: \n611: \n612: def _case_a01(args, recorder):\n613:     client = common.HttpClient(args.base_url)\n614:     live_url = _unique_url('a01-live')\n615:     live_title = f'A01 保存标题 {uuid.uuid4().hex[:8]}'\n616:     live_description = f'A01 保存描述 {uuid.uuid4().hex[:8]}'\n617:     try:\n618:         health = client.get('/api/health')\n619:         recorder.expect_status(health, 200, aid='a01-health-status')\n620:         recorder.check(\n621:             'a01-health-json',\n622:             isinstance(_safe_json(health), dict),\n623:             '/api/health 返回 JSON 对象',\n624:         )\n625:         _, form = _save_form_from_home(client, recorder, 'a01')\n626:         if form is None:\n627:             return\n628:         fields = _form_fields(form, {\n629:             'url': live_url,\n630:             'title': live_title,\n631:             'description': live_description,\n632:         })\n633:         response = client.post_form(\n634:             _action_of(form), fields, follow_redirects=False, accept='text/html'\n635:         )\n636:         page = _follow_303(client, recorder, response, 'a01-save')\n637:         if page is None:\n638:             return\n639:         doc = _parse_html(page.text)\n640:         row = _row_for_url(doc, live_url)\n641:         if not recorder.check(\n642:             'a01-row-present',\n643:             row is not None,\n644:             f'保存后 HTML 列表出现原始 URL={live_url!r} 的记录行',\n645:         ):\n646:             return\n647:         record_id = row.record_id\n648:         recorder.check('a01-row-id', bool(record_id), f'记录行 data-record-id={record_id!r}')\n649:         recorder.check(\n650:             'a01-row-title',\n651:             live_title in row.text,\n652:             f'记录行文本包含标题 {live_title!r}',\n653:         )\n654:         recorder.check(\n655:             'a01-row-description',\n656:             live_description in row.text,\n657:             f'记录行文本包含描述 {live_description!r}',\n658:         )\n659:         link = _row_open_link(row)\n660:         href = link.href if link is not None else None\n661:         recorder.check(\n662:             'a01-row-href',\n663:             href == live_url,\n664:             f'行内打开链接 href={href!r}（期望 {live_url!r}）',\n665:         )\n666:         record = _get_record(client, recorder, record_id, 'a01')\n667:         if record is not None:\n668:             recorder.check(\n669:                 'a01-json-id',\n670:                 _record_id(record) == record_id,\n671:                 f'JSON id={_record_id(record)!r}（期望 {record_id!r}）',\n672:             )\n673:             recorder.check(\n674:                 'a01-json-url',\n675:                 _record_url(record) == live_url,\n676:                 f'JSON url={_record_url(record)!r}（期望 {live_url!r}）',\n677:             )\n678:             recorder.check(\n679:                 'a01-json-title',\n680:                 _record_title(record) == live_title,\n681:                 f'JSON title={_record_title(record)!r}（期望 {live_title!r}）',\n682:             )\n683:             recorder.check(\n684:                 'a01-json-description',\n685:                 _record_description(record) == live_description,\n686:                 f'JSON description={_record_description(record)!r}（期望 {live_description!r}）',\n687:             )\n688:     finally:\n689:         client.close()\n690: \n691:     first = None\n692:     second = None\n693:     instance_dir = None\n694:     restart_id = None\n695:     restart_url = _unique_url('a01-restart')\n696:     restart_title = f'A01 重启标题 {uuid.uuid4().hex[:8]}'\n697:     restart_description = f'A01 重启描述 {uuid.uuid4().hex[:8]}'\n698:     try:\n699:         try:\n700:             first = common.launch_app(args.app_root, args.data_dir, 0)\n701:             instance_dir = first.instance_dir\n702:             first_client = None\n703:             try:\n704:                 first_client = common.HttpClient(first.base_url)\n705:                 _, form = _save_form_from_home(first_client, recorder, 'a01-instance')\n706:                 if form is not None:\n707:                     fields = _form_fields(form, {\n708:                         'url': restart_url,\n709:                         'title': restart_title,\n710:                         'description': restart_description,\n711:                     })\n712:                     response = first_client.post_form(\n713:                         _action_of(form), fields, follow_redirects=False, accept='text/html'\n714:                     )\n715:                     page = _follow_303(first_client, recorder, response, 'a01-instance')\n716:                     if page is not None:\n717:                         doc = _parse_html(page.text)\n718:                         row = _row_for_url(doc, restart_url)\n719:                         if recorder.check(\n720:                             'a01-instance-row',\n721:                             row is not None,\n722:                             f'隔离实例保存后 HTML 列表出现 URL={restart_url!r} 的记录行',\n723:                         ):\n724:                             restart_id = row.record_id\n725:                             recorder.check(\n726:                                 'a01-instance-row-id',\n727:                                 bool(restart_id),\n728:                                 f'隔离实例记录 data-record-id={restart_id!r}',\n729:                             )\n730:                             recorder.check(\n731:                                 'a01-instance-row-title',\n732:                                 restart_title in row.text,\n733:                                 f'隔离实例记录行包含标题 {restart_title!r}',\n734:                             )\n735:                             recorder.check(\n736:                                 'a01-instance-row-description',\n737:                                 restart_description in row.text,\n738:                                 f'隔离实例记录行包含描述 {restart_description!r}',\n739:                             )\n740:                             link = _row_open_link(row)\n741:                             href = link.href if link is not None else None\n742:                             recorder.check(\n743:                                 'a01-instance-row-href',\n744:                                 href == restart_url,\n745:                                 f'隔离实例行内 href={href!r}（期望 {restart_url!r}）',\n746:                             )\n747:                             record = _get_record(\n748:                                 first_client, recorder, restart_id, 'a01-instance'\n749:                             )\n750:                             if record is not None:\n751:                                 recorder.check(\n752:                                     'a01-instance-json-url',\n753:                                     _record_url(record) == restart_url,\n754:                                     f'隔离实例 JSON url={_record_url(record)!r}（期望 {restart_url!r}）',\n755:                                 )\n756:             finally:\n757:                 if first_client is not None:\n758:                     first_client.close()\n759:         finally:\n760:             if first is not None:\n761:                 common.stop_app(first)\n762:         if not restart_id or not instance_dir:\n763:             recorder.check(\n764:                 'a01-restart-prerequisite',\n765:                 False,\n766:                 '隔离实例未提供可重启的记录 id 或实例目录',\n767:             )\n768:             return\n769:         second = common.launch_app(\n770:             args.app_root, args.data_dir, 0, instance_dir=instance_dir\n771:         )\n772:         second_client = None\n773:         try:\n774:             second_client = common.HttpClient(second.base_url)\n775:             page = second_client.get('/', accept='text/html')\n776:             recorder.expect_status(page, 200, aid='a01-restart-home-status')\n777:             doc = _parse_html(page.text)\n778:             row = _row_by_id(doc, restart_id)\n779:             recorder.check(\n780:                 'a01-restart-row',\n781:                 row is not None,\n782:                 f'重启后 HTML 列表包含 id={restart_id!r} 的记录行',\n783:             )\n784:             if row is not None:\n785:                 link = _row_open_link(row)\n786:                 href = link.href if link is not None else None\n787:                 recorder.check(\n788:                     'a01-restart-href',\n789:                     href == restart_url,\n790:                     f'重启后行内 href={href!r}（期望 {restart_url!r}）',\n791:                 )\n792:                 recorder.check(\n793:                     'a01-restart-title',\n794:                     restart_title in row.text,\n795:                     f'重启后记录行包含标题 {restart_title!r}',\n796:                 )\n797:                 recorder.check(\n798:                     'a01-restart-description',\n799:                     restart_description in row.text,\n800:                     f'重启后记录行包含描述 {restart_description!r}',\n801:                 )\n802:             record = _get_record(second_client, recorder, restart_id, 'a01-restart')\n803:             if record is not None:\n804:                 recorder.check(\n805:                     'a01-restart-id',\n806:                     _record_id(record) == restart_id,\n807:                     f'重启后 JSON id={_record_id(record)!r}（期望 {restart_id!r}）',\n808:                 )\n809:                 recorder.check(\n810:                     'a01-restart-url',\n811:                     _record_url(record) == restart_url,\n812:                     f'重启后 JSON url={_record_url(record)!r}（期望 {restart_url!r}）',\n813:                 )\n814:                 recorder.check(\n815:                     'a01-restart-title-json',\n816:                     _record_title(record) == restart_title,\n817:                     f'重启后 JSON title={_record_title(record)!r}（期望 {restart_title!r}）',\n818:                 )\n819:                 recorder.check(\n820:                     'a01-restart-description-json',\n821:                     _record_description(record) == restart_description,\n822:                     f'重启后 JSON description={_record_description(record)!r}（期望 {restart_description!r}）',\n823:                 )\n824:         finally:\n825:             if second_client is not None:\n826:                 second_client.close()\n827:     finally:\n828:         if second is not None:\n829:             common.stop_app(second)\n830: \n831: \n832: def _case_a02(args, recorder):\n833:     client = common.HttpClient(args.base_url)\n834:     token = uuid.uuid4().hex[:12]\n835:     boundary = f'http://atlas-a02-{token}'\n836:     boundary_title = f'A02 单标签主机 {token}'\n837:     boundary_description = f'A02 原始字符串 {token}'\n838:     invalid_values = [\n839:         ('missing-scheme', f'{token}.example.com/no-scheme'),\n840:         ('javascript-scheme', f'javascript:void({token})'),\n841:         ('ftp-scheme', f'ftp://{token}.example.com/manual'),\n842:         ('empty-host', 'http://'),\n843:         ('space-in-hostname', f'http://{token}.exa mple.com/path'),\n844:         ('illegal-hostname', f'http://{token}.example.com|invalid/'),\n845:     ]\n846:     try:\n847:         _, form = _save_form_from_home(client, recorder, 'a02')\n848:         if form is None:\n849:             return\n850:         fields = _form_fields(form, {\n851:             'url': boundary,\n852:             'title': boundary_title,\n853:             'description': boundary_description,\n854:         })\n855:         response = client.post_form(\n856:             _action_of(form), fields, follow_redirects=False, accept='text/html'\n857:         )\n858:         page = _follow_303(client, recorder, response, 'a02-boundary')\n859:         if page is None:\n860:             return\n861:         doc = _parse_html(page.text)\n862:         row = _row_for_url(doc, boundary)\n863:         recorder.check(\n864:             'a02-boundary-row',\n865:             row is not None,\n866:             f'单标签主机 URL={boundary!r} 出现在 HTML 列表',\n867:         )\n868:         record_id = row.record_id if row is not None else ''\n869:         recorder.check(\n870:             'a02-boundary-id',\n871:             bool(record_id),\n872:             f'单标签主机记录 data-record-id={record_id!r}',\n873:         )\n874:         if row is not None:\n875:             link = _row_open_link(row)\n876:             href = link.href if link is not None else None\n877:             recorder.check(\n878:                 'a02-boundary-href',\n879:                 href == boundary,\n880:                 f'行内 href={href!r}（期望精确等于 {boundary!r}）',\n881:             )\n882:         if record_id:\n883:             record = _get_record(client, recorder, record_id, 'a02-boundary')\n884:             if record is not None:\n885:                 recorder.check(\n886:                     'a02-boundary-json-url',\n887:                     _record_url(record) == boundary,\n888:                     f'JSON url={_record_url(record)!r}（期望原始字符串 {boundary!r}）',\n889:                 )\n890:         # Independent JSON positive: not an HTML-created record read through JSON.\n891:         before_json_ids = _record_ids(_fetch_bookmarks(client, recorder, 'a02-json-before-create'))\n892:         json_boundary = f'https://atlas-a02-json-{token}/original?keep=1'\n893:         positive = client.post_json('/api/bookmarks', {\n894:             'url': json_boundary, 'title': f'A02 JSON {token}',\n895:             'description': f'A02 JSON positive {token}',\n896:         })\n897:         recorder.expect_status(positive, 201, aid='a02-json-boundary-create-status')\n898:         json_id = _record_id(_extract_record(_safe_json(positive)))\n899:         recorder.check('a02-json-boundary-new-id', bool(json_id) and json_id not in before_json_ids,\n900:                        f'独立 JSON POST 返回新的非空 id={json_id!r}')\n901:         if json_id:\n902:             saved = _get_record(client, recorder, json_id, 'a02-json-boundary')\n903:             recorder.check('a02-json-boundary-readback',\n904:                            _record_id(saved) == json_id and _record_url(saved) == json_boundary,\n905:                            '独立 GET 读回同一 id 与精确原始 URL')\n906:             listed_positive = _fetch_bookmarks(client, recorder, 'a02-json-positive')\n907:             recorder.check('a02-json-boundary-listed', any(\n908:                 _record_id(item) == json_id and _record_url(item) == json_boundary\n909:                 for item in listed_positive), '列表包含同一 JSON 创建记录与原始 URL')\n910:         before = _fetch_bookmarks(client, recorder, 'a02-before')\n911:         before_total = len(before)\n912:         before_token = sum(1 for item in before if token in (_record_url(item) or ''))\n913:         for label, bad_url in invalid_values:\n914:             bad_fields = _form_fields(form, {\n915:                 'url': bad_url,\n916:                 'title': f'A02 拒绝 {label}',\n917:                 'description': f'A02 保留输入 {label}',\n918:             })\n919:             html_response = client.post_form(\n920:                 _action_of(form), bad_fields, follow_redirects=False, accept='text/html'\n921:             )\n922:             recorder.expect_status(html_response, 400, aid=f'a02-html-{label}-status')\n923:             error_doc = _parse_html(html_response.text)\n924:             error_text = _form_error_text(error_doc)\n925:             recorder.check(\n926:                 f'a02-html-{label}-form-error',\n927:                 bool(error_text),\n928:                 f'HTML 非法 URL 显示可读 form-error，实际 {error_text!r}',\n929:             )\n930:             error_form = error_doc.save_form()\n931:             recorder.check(\n932:                 f'a02-html-{label}-form-present',\n933:                 error_form is not None,\n934:                 'HTML 错误页保留可重新提交的保存表单',\n935:             )\n936:             if error_form is not None:\n937:                 retained = error_form.value('url')\n938:                 recorder.check(\n939:                     f'a02-html-{label}-retained',\n940:                     retained == bad_url,\n941:                     f'HTML 错误页保留 url={retained!r}（期望 {bad_url!r}）',\n942:                 )\n943:             json_response = client.post_json('/api/bookmarks', {'url': bad_url})\n944:             recorder.expect_status(json_response, 400, aid=f'a02-json-{label}-status')\n945:             code = _error_code(json_response)\n946:             recorder.check(\n947:                 f'a02-json-{label}-code',\n948:                 code == 'invalid_url',\n949:                 f'JSON 非法 URL 错误码={code!r}（期望 invalid_url）',\n950:             )\n951:         after = _fetch_bookmarks(client, recorder, 'a02-after')\n952:         after_total = len(after)\n953:         after_token = sum(1 for item in after if token in (_record_url(item) or ''))\n954:         recorder.check(\n955:             'a02-relative-count',\n956:             after_total == before_total and after_token == before_token,\n957:             f'非法提交前后记录数 {before_total}->{after_total}，标记记录数 {before_token}->{after_token}（不得新增）',\n958:         )\n959:         listed = {_record_url(item) for item in after}\n960:         for label, bad_url in invalid_values:\n961:             recorder.check(\n962:                 f'a02-{label}-absent',\n963:                 bad_url not in listed,\n964:                 f'被拒绝的 url={bad_url!r} 不出现在列表',\n965:             )\n966:     finally:\n967:         client.close()\n968: \n969: \n970: def _case_a03(args, recorder):\n971:     client = common.HttpClient(args.base_url)\n972:     default_url = _unique_url('a03-default')\n973:     default_title = f'A03 默认归类 {uuid.uuid4().hex[:8]}'\n974:     new_name = f'自动归类-{uuid.uuid4().hex[:8]}'\n975:     new_url = _unique_url('a03-newcat')\n976:     new_title = f'A03 新归类 {uuid.uuid4().hex[:8]}'\n977:     try:\n978:         categories = _fetch_categories(client, recorder, 'a03')\n979:         api_names = _category_names(categories)\n980:         for index, preset in enumerate(common.PRESET_CATEGORIES, 1):\n981:             recorder.check(\n982:                 f'a03-api-preset-{index}',\n983:                 preset in api_names,\n984:                 f'/api/categories 包含预置归类 {preset!r}；实际 {sorted(api_names)}',\n985:             )\n986:         doc, form = _save_form_from_home(client, recorder, 'a03')\n987:         html_categories = _category_values_in_html(doc)\n988:         for index, preset in enumerate(common.PRESET_CATEGORIES, 1):\n989:             recorder.check(\n990:                 f'a03-html-preset-{index}',\n991:                 preset in html_categories,\n992:                 f'首页 HTML 归类链接/选项包含 {preset!r}；实际 {sorted(html_categories)}',\n993:             )\n994:         if form is None:\n995:             return\n996:         omitted_fields = _form_fields(form, {\n997:             'url': default_url,\n998:             'title': default_title,\n999:         }, omit=('category',))\n1000:         recorder.check(\n1001:             'a03-category-omitted',\n1002:             'category' not in omitted_fields,\n1003:             '真实保存表单省略 category 字段后提交',\n1004:         )\n1005:         response = client.post_form(\n1006:             _action_of(form), omitted_fields, follow_redirects=False, accept='text/html'\n1007:         )\n1008:         page = _follow_303(client, recorder, response, 'a03-default')\n1009:         if page is None:\n1010:             return\n1011:         default_doc = _parse_html(page.text)\n1012:         default_row = _row_for_url(default_doc, default_url)\n1013:         if not recorder.check(\n1014:             'a03-default-row',\n1015:             default_row is not None,\n1016:             f'省略归类保存后 HTML 列表出现 URL