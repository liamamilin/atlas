{"type":"tool_use","timestamp":1792484140554,"sessionID":"ses_ea79fcfd3ffeGu4Pan86lE7BF8","part":{"partID":"prt_158616551002D46xVi7Bc3foiW","sessionID":"ses_ea79fcfd3ffeGu4Pan86lE7BF8","messageID":"msg_158615988001f45jH3k14Xum9z","type":"tool","id":"call_66f3700b6e8b4ba0aa76f14a","tool":"read","state":{"status":"completed","input":{"path":"source/candidate/acceptance/p0_find_open.py","limit":2000},"output":"Read file source/candidate/acceptance/p0_find_open.py, lines 1-847\n1: #!/usr/bin/env python3\n2: '''P0 行为验收组：关键字检索与打开原页。\n3: \n4: 覆盖 A07、A08。A07 先保留 JSON 检索断言，再通过真实 category-search-form\n5: 在归类间提交同一关键字并验证空结果；A08 通过真实保存表单创建带查询串的\n6: 记录，检查打开链接属性、urljoin 解析目标与 /go 302。仅使用 Python 3.12\n7: 标准库并复用 acceptance/common.py：以 --case 派发，未知用例显式失败；\n8: 每个用例对真实目标执行正向与硬负向行为断言，向 stdout 输出单个\n9: atlas.acceptance-result.v1 JSON，失败时以非零码退出。\n10: '''\n11: \n12: from __future__ import annotations\n13: \n14: import os\n15: import sys\n16: import uuid\n17: from html.parser import HTMLParser\n18: from urllib.parse import quote, urljoin, urlsplit\n19: \n20: _THIS_DIR = os.path.dirname(os.path.abspath(__file__))\n21: if _THIS_DIR not in sys.path:\n22:     sys.path.insert(0, _THIS_DIR)\n23: \n24: import common\n25: \n26: \n27: _VOID_TAGS = frozenset({\n28:     'area', 'base', 'br', 'col', 'embed', 'hr', 'img', 'input',\n29:     'link', 'meta', 'param', 'source', 'track', 'wbr',\n30: })\n31: _EMPTY_MARKERS = (\n32:     '无匹配', '没有匹配', '没有找到', '未找到', '暂无', '没有记录',\n33:     '空结果', 'no results', 'no matching', 'no bookmarks', 'nothing here', 'empty',\n34: )\n35: \n36: \n37: def _normalize_space(value):\n38:     return ' '.join(str(value or '').split())\n39: \n40: \n41: class _Field:\n42:     def __init__(self, attrs):\n43:         self.name = attrs.get('name')\n44:         self.value = attrs.get('value', '')\n45:         self.type = (attrs.get('type') or 'text').lower()\n46:         self.checked = 'checked' in attrs\n47: \n48: \n49: class _Option:\n50:     def __init__(self, attrs):\n51:         self.value = attrs.get('value')\n52:         self.text = ''\n53:         self.selected = 'selected' in attrs\n54: \n55:     def resolved_value(self):\n56:         if self.value is not None:\n57:             return self.value\n58:         return self.text.strip()\n59: \n60: \n61: class _Select:\n62:     def __init__(self, attrs):\n63:         self.name = attrs.get('name')\n64:         self.options = []\n65: \n66:     def selected_value(self):\n67:         for option in self.options:\n68:             if option.selected:\n69:                 return option.resolved_value()\n70:         if self.options:\n71:             return self.options[0].resolved_value()\n72:         return ''\n73: \n74: \n75: class _Textarea:\n76:     def __init__(self, attrs):\n77:         self.name = attrs.get('name')\n78:         self.text = ''\n79: \n80: \n81: class _Form:\n82:     def __init__(self, attrs):\n83:         self.action = (attrs.get('action') or '').strip()\n84:         self.method = (attrs.get('method') or 'get').strip().lower()\n85:         self.testid = attrs.get('data-testid') or ''\n86:         self.fields = []\n87:         self.selects = []\n88:         self.textareas = []\n89: \n90:     def has_name(self, name):\n91:         if any(field.name == name for field in self.fields):\n92:             return True\n93:         if any(select.name == name for select in self.selects):\n94:             return True\n95:         return any(textarea.name == name for textarea in self.textareas)\n96: \n97:     def value(self, name):\n98:         for field in reversed(self.fields):\n99:             if field.name == name:\n100:                 return field.value\n101:         for select in reversed(self.selects):\n102:             if select.name == name:\n103:                 return select.selected_value()\n104:         for textarea in reversed(self.textareas):\n105:             if textarea.name == name:\n106:                 return textarea.text\n107:         return None\n108: \n109: \n110: class _Anchor:\n111:     def __init__(self, attrs):\n112:         self.href = attrs.get('href') or ''\n113:         self.testid = attrs.get('data-testid') or ''\n114:         self.target = attrs.get('target') or ''\n115:         self.rel = attrs.get('rel') or ''\n116:         self.text = ''\n117: \n118: \n119: class _Row:\n120:     def __init__(self, attrs):\n121:         self.record_id = attrs.get('data-record-id') or ''\n122:         self.anchors = []\n123:         self.text = ''\n124: \n125: \n126: class _Document:\n127:     def __init__(self):\n128:         self.forms = []\n129:         self.anchors = []\n130:         self.rows = []\n131:         self.testids = []\n132:         self.text = ''\n133: \n134:     def save_form(self):\n135:         for form in self.forms:\n136:             if form.method == 'post' and _action_path(form.action) == '/bookmarks/new':\n137:                 return form\n138:         for form in self.forms:\n139:             if form.method == 'post' and form.has_name('url'):\n140:                 return form\n141:         return None\n142: \n143:     def search_form(self):\n144:         for form in self.forms:\n145:             if form.testid == 'category-search-form':\n146:                 return form\n147:         for form in self.forms:\n148:             if form.method == 'get' and form.has_name('category') and form.has_name('q'):\n149:                 return form\n150:         return None\n151: \n152: \n153: class _HtmlReader(HTMLParser):\n154:     def __init__(self):\n155:         super().__init__(convert_charrefs=True)\n156:         self.doc = _Document()\n157:         self._form = None\n158:         self._select = None\n159:         self._option = None\n160:         self._textarea = None\n161:         self._anchor = None\n162:         self._row = None\n163:         self._testid_stack = []\n164: \n165:     def handle_starttag(self, tag, attrs):\n166:         tag = tag.lower()\n167:         attributes = {\n168:             str(key).lower(): ('' if value is None else value)\n169:             for key, value in attrs\n170:         }\n171:         testid = attributes.get('data-testid') or ''\n172:         if testid:\n173:             entry = {'attrs': attributes, 'text': ''}\n174:             self.doc.testids.append(entry)\n175:             if tag not in _VOID_TAGS:\n176:                 self._testid_stack.append((tag, entry))\n177:         if tag == 'form':\n178:             self._finish_form()\n179:             self._form = _Form(attributes)\n180:         elif tag == 'input':\n181:             if self._form is not None:\n182:                 self._form.fields.append(_Field(attributes))\n183:         elif tag == 'select':\n184:             self._finish_select()\n185:             if self._form is not None:\n186:                 self._select = _Select(attributes)\n187:         elif tag == 'option':\n188:             self._finish_option()\n189:             if self._select is not None:\n190:                 self._option = _Option(attributes)\n191:         elif tag == 'textarea':\n192:             self._finish_textarea()\n193:             if self._form is not None:\n194:                 self._textarea = _Textarea(attributes)\n195:         elif tag == 'a':\n196:             self._finish_anchor()\n197:             self._anchor = _Anchor(attributes)\n198:         elif tag == 'tr' and (attributes.get('data-record-id') or testid == 'record-row'):\n199:             self._finish_row()\n200:             self._row = _Row(attributes)\n201: \n202:     def handle_data(self, data):\n203:         if not data:\n204:             return\n205:         self.doc.text += data\n206:         if self._row is not None:\n207:             self._row.text += data\n208:         if self._anchor is not None:\n209:             self._anchor.text += data\n210:         if self._option is not None:\n211:             self._option.text += data\n212:         if self._textarea is not None:\n213:             self._textarea.text += data\n214:         for _, entry in self._testid_stack:\n215:             entry['text'] += data\n216: \n217:     def handle_endtag(self, tag):\n218:         tag = tag.lower()\n219:         if tag == 'a':\n220:             self._finish_anchor()\n221:         elif tag == 'option':\n222:             self._finish_option()\n223:         elif tag == 'select':\n224:             self._finish_select()\n225:         elif tag == 'textarea':\n226:             self._finish_textarea()\n227:         elif tag == 'form':\n228:             self._finish_form()\n229:         elif tag == 'tr':\n230:             self._finish_row()\n231:         if tag in _VOID_TAGS:\n232:             return\n233:         if self._testid_stack and self._testid_stack[-1][0] == tag:\n234:             self._testid_stack.pop()\n235: \n236:     def _finish_option(self):\n237:         if self._option is None:\n238:             return\n239:         option = self._option\n240:         self._option = None\n241:         if self._select is not None:\n242:             self._select.options.append(option)\n243: \n244:     def _finish_select(self):\n245:         self._finish_option()\n246:         if self._select is None:\n247:             return\n248:         select = self._select\n249:         self._select = None\n250:         if self._form is not None:\n251:             self._form.selects.append(select)\n252: \n253:     def _finish_textarea(self):\n254:         if self._textarea is None:\n255:             return\n256:         textarea = self._textarea\n257:         self._textarea = None\n258:         if self._form is not None:\n259:             self._form.textareas.append(textarea)\n260: \n261:     def _finish_anchor(self):\n262:         if self._anchor is None:\n263:             return\n264:         anchor = self._anchor\n265:         self._anchor = None\n266:         self.doc.anchors.append(anchor)\n267:         if self._row is not None:\n268:             self._row.anchors.append(anchor)\n269: \n270:     def _finish_row(self):\n271:         if self._row is None:\n272:             return\n273:         row = self._row\n274:         self._row = None\n275:         self.doc.rows.append(row)\n276: \n277:     def _finish_form(self):\n278:         self._finish_select()\n279:         self._finish_textarea()\n280:         if self._form is None:\n281:             return\n282:         form = self._form\n283:         self._form = None\n284:         self.doc.forms.append(form)\n285: \n286:     def finalize(self):\n287:         self._finish_anchor()\n288:         self._finish_row()\n289:         self._finish_form()\n290: \n291: \n292: def _parse_html(text):\n293:     reader = _HtmlReader()\n294:     reader.feed(text or '')\n295:     reader.close()\n296:     reader.finalize()\n297:     return reader.doc\n298: \n299: \n300: def _action_path(action):\n301:     text = (action or '').strip()\n302:     if not text:\n303:         return ''\n304:     try:\n305:         path = urlsplit(text).path\n306:     except ValueError:\n307:         return text\n308:     if not path:\n309:         return ''\n310:     if not path.startswith('/'):\n311:         path = '/' + path\n312:     return path.rstrip('/') or '/'\n313: \n314: \n315: def _form_path(form, default):\n316:     return (form.action or '').strip() or default\n317: \n318: \n319: def _form_fields(form, overrides=None, omit=()):\n320:     fields = {}\n321:     for field in form.fields:\n322:         name = field.name\n323:         if not name:\n324:             continue\n325:         if field.type in ('submit', 'button', 'reset', 'file', 'image'):\n326:             continue\n327:         if field.type in ('checkbox', 'radio') and not field.checked:\n328:             continue\n329:         fields[name] = field.value\n330:     for select in form.selects:\n331:         if select.name:\n332:             fields[select.name] = select.selected_value()\n333:     for textarea in form.textareas:\n334:         if textarea.name:\n335:             fields[textarea.name] = textarea.text\n336:     for key, value in (overrides or {}).items():\n337:         fields[str(key)] = str(value)\n338:     for name in omit:\n339:         fields.pop(name, None)\n340:     return fields\n341: \n342: \n343: def _row_for_url(doc, url):\n344:     for row in doc.rows:\n345:         if any(anchor.testid == 'record-open-link' and anchor.href == url for anchor in row.anchors):\n346:             return row\n347:     for row in doc.rows:\n348:         if any(anchor.href == url for anchor in row.anchors):\n349:             return row\n350:     return None\n351: \n352: \n353: def _row_ids(doc):\n354:     return {row.record_id for row in doc.rows if row.record_id}\n355: \n356: \n357: def _empty_state_text(doc):\n358:     for entry in doc.testids:\n359:         testid = (entry['attrs'].get('data-testid') or '').lower()\n360:         if 'empty' in testid:\n361:             text = _normalize_space(entry['text'])\n362:             if text:\n363:                 return text\n364:     text = _normalize_space(doc.text)\n365:     folded = text.casefold()\n366:     for marker in _EMPTY_MARKERS:\n367:         if marker.casefold() in folded:\n368:             return marker\n369:     return ''\n370: \n371: \n372: def _html_search(client, recorder, aid, form, category, query):\n373:     fields = _form_fields(form, {'category': category, 'q': query})\n374:     response = client.get(_form_path(form, '/'), params=fields, accept='text/html')\n375:     recorder.expect_status(response, 200, aid=f'{aid}-status')\n376:     recorder.check(\n377:         f'{aid}-content-type',\n378:         'text/html' in response.content_type.lower(),\n379:         f'GET 搜索页 Content-Type={response.content_type!r}',\n380:     )\n381:     doc = _parse_html(response.text)\n382:     result_form = doc.search_form()\n383:     recorder.check(f'{aid}-form', result_form is not None, '搜索页保留 category-search-form')\n384:     retained_category = None\n385:     retained_query = None\n386:     if result_form is not None:\n387:         retained_category = result_form.value('category')\n388:         retained_query = result_form.value('q')\n389:         recorder.check(\n390:             f'{aid}-category-retained',\n391:             retained_category == category,\n392:             f'搜索表单 category={retained_category!r}（期望 {category!r}）',\n393:         )\n394:         recorder.check(\n395:             f'{aid}-query-retained',\n396:             retained_query == query,\n397:             f'搜索表单 q={retained_query!r}（期望 {query!r}）',\n398:         )\n399:     text = _normalize_space(doc.text)\n400:     recorder.check(\n401:         f'{aid}-category-visible',\n402:         category in text or retained_category == category,\n403:         f'结果页显示所选归类 {category!r}（表单保留值 {retained_category!r}）',\n404:     )\n405:     recorder.check(\n406:         f'{aid}-query-visible',\n407:         query in text or retained_query == query,\n408:         f'结果页显示查询 {query!r}（表单保留值 {retained_query!r}）',\n409:     )\n410:     return doc\n411: \n412: \n413: def _unique_url(tag):\n414:     token = f'{tag}-{uuid.uuid4().hex[:12]}'\n415:     return f'https://{token}.atlas-acceptance.example/{token}'\n416: \n417: \n418: def _unique_category(tag):\n419:     return f'atlas-{tag}-{uuid.uuid4().hex[:10]}'\n420: \n421: \n422: def _safe_json(response):\n423:     try:\n424:         return response.json()\n425:     except Exception:\n426:         return None\n427: \n428: \n429: def _extract_record(payload):\n430:     if isinstance(payload, dict):\n431:         for key in ('bookmark', 'record', 'data', 'item'):\n432:             value = payload.get(key)\n433:             if isinstance(value, dict):\n434:                 return value\n435:         return payload\n436:     return None\n437: \n438: \n439: def _record_id(record):\n440:     if isinstance(record, dict) and record.get('id') is not None:\n441:         return str(record['id'])\n442:     return None\n443: \n444: \n445: def _record_url(record):\n446:     if isinstance(record, dict) and record.get('url') is not None:\n447:         return str(record['url'])\n448:     return None\n449: \n450: \n451: def _record_ids(records):\n452:     return {item_id for item_id in (_record_id(record) for record in records) if item_id}\n453: \n454: \n455: def _error_code(response):\n456:     payload = _safe_json(response)\n457:     if isinstance(payload, dict):\n458:         error = payload.get('error')\n459:         if isinstance(error, dict) and error.get('code') is not None:\n460:             return str(error['code'])\n461:         for key in ('code', 'error_code'):\n462:             if payload.get(key) is not None:\n463:                 return str(payload[key])\n464:     return None\n465: \n466: \n467: def _extract_list(payload, keys):\n468:     if isinstance(payload, list):\n469:         return payload\n470:     if isinstance(payload, dict):\n471:         for key in keys:\n472:             value = payload.get(key)\n473:             if isinstance(value, list):\n474:                 return value\n475:     return None\n476: \n477: \n478: def _bookmark_path(bookmark_id):\n479:     return '/api/bookmarks/' + quote(str(bookmark_id), safe='')\n480: \n481: \n482: def _go_path(bookmark_id):\n483:     return '/go/' + quote(str(bookmark_id), safe='')\n484: \n485: \n486: def _search(client, recorder, aid, params):\n487:     response = client.get('/api/bookmarks', params=params)\n488:     recorder.expect_status(response, 200, aid=f'{aid}-status')\n489:     payload = _safe_json(response)\n490:     records = _extract_list(payload, ('bookmarks', 'items', 'data', 'records'))\n491:     recorder.check(\n492:         f'{aid}-shape',\n493:         isinstance(records, list),\n494:         f'GET /api/bookmarks 必须返回 JSON 数组，实际 {type(payload).__name__}',\n495:     )\n496:     return records if isinstance(records, list) else []\n497: \n498: \n499: def _case_a07(args, recorder):\n500:     client = common.HttpClient(args.base_url)\n501:     try:\n502:         health = client.get('/api/health')\n503:         recorder.expect_status(health, 200, aid='a07-health-status')\n504: \n505:         cat_a = _unique_category('a07a')\n506:         cat_b = _unique_category('a07b')\n507:         shared = f'shared{uuid.uuid4().hex[:12]}'\n508:         host_token = f'host{uuid.uuid4().hex[:12]}'\n509:         desc_token = f'descr{uuid.uuid4().hex[:12]}'\n510:         unmatched = f'absent{uuid.uuid4().hex[:12]}'\n511: \n512:         path_only = f'pathonly{uuid.uuid4().hex[:12]}'\n513:         query_only = f'queryonly{uuid.uuid4().hex[:12]}'\n514:         url_a = f'https://{host_token}.atlas-acceptance.example/{path_only}?q={query_only}'\n515:         title_a = f'{shared} 收藏甲'\n516:         desc_a = f'备注 {desc_token}'\n517:         created_a = client.post_json(\n518:             '/api/bookmarks',\n519:             {'url': url_a, 'title': title_a, 'description': desc_a, 'category': cat_a},\n520:         )\n521:         recorder.expect_status(created_a, 201, aid='a07-create-a-status')\n522:         id_a = _record_id(_extract_record(_safe_json(created_a)))\n523:         recorder.check('a07-create-a-id', bool(id_a), f'创建记录甲返回 id={id_a!r}')\n524: \n525:         url_b = _unique_url('a07b')\n526:         title_b = f'{shared} 收藏乙'\n527:         created_b = client.post_json('/api/bookmarks', {'url': url_b, 'title': title_b, 'category': cat_b})\n528:         recorder.expect_status(created_b, 201, aid='a07-create-b-status')\n529:         id_b = _record_id(_extract_record(_safe_json(created_b)))\n530:         recorder.check('a07-create-b-id', bool(id_b), f'创建记录乙返回 id={id_b!r}')\n531: \n532:         if not (id_a and id_b):\n533:             return\n534: \n535:         by_title = _search(client, recorder, 'a07-title', {'q': shared})\n536:         title_ids = _record_ids(by_title)\n537:         recorder.check('a07-title-hit-a', id_a in title_ids, f'标题片段 {shared!r} 命中记录甲：{sorted(title_ids)}')\n538:         recorder.check('a07-title-hit-b', id_b in title_ids, f'标题片段 {shared!r} 命中记录乙：{sorted(title_ids)}')\n539: \n540:         upper_title = shared.upper()\n541:         by_title_upper = _search(client, recorder, 'a07-title-case', {'q': upper_title})\n542:         recorder.check(\n543:             'a07-title-case-insensitive',\n544:             id_a in _record_ids(by_title_upper),\n545:             f'大写标题片段 {upper_title!r} 命中记录甲（大小写不敏感）',\n546:         )\n547: \n548:         by_host = _search(client, recorder, 'a07-domain', {'q': host_token})\n549:         host_ids = _record_ids(by_host)\n550:         recorder.check('a07-domain-hit', id_a in host_ids, f'域名片段 {host_token!r} 命中记录甲：{sorted(host_ids)}')\n551:         recorder.check('a07-domain-excludes-b', id_b not in host_ids, '域名检索不命中域名不同的记录乙')\n552: \n553:         by_host_upper = _search(client, recorder, 'a07-domain-case', {'q': host_token.upper()})\n554:         recorder.check(\n555:             'a07-domain-case-insensitive',\n556:             id_a in _record_ids(by_host_upper),\n557:             f'大写域名片段 {host_token.upper()!r} 命中记录甲（大小写不敏感）',\n558:         )\n559: \n560:         by_desc = _search(client, recorder, 'a07-description', {'q': desc_token})\n561:         desc_ids = _record_ids(by_desc)\n562:         recorder.check('a07-description-hit', id_a in desc_ids, f'描述片段 {desc_token!r} 命中记录甲：{sorted(desc_ids)}')\n563:         recorder.check('a07-description-excludes-b', id_b not in desc_ids, '描述检索不命中无该描述的记录乙')\n564: \n565:         by_desc_upper = _search(client, recorder, 'a07-description-case', {'q': desc_token.upper()})\n566:         recorder.check(\n567:             'a07-description-case-insensitive',\n568:             id_a in _record_ids(by_desc_upper),\n569:             f'大写描述片段 {desc_token.upper()!r} 命中记录甲（大小写不敏感）',\n570:         )\n571: \n572:         combined_a = _search(client, recorder, 'a07-combined-a', {'category': cat_a, 'q': shared})\n573:         combined_a_ids = _record_ids(combined_a)\n574:         recorder.check('a07-combined-a-includes', id_a in combined_a_ids, f'category={cat_a!r} 与 q={shared!r} 叠加命中记录甲')\n575:         recorder.check('a07-combined-a-excludes-b', id_b not in combined_a_ids, f'category={cat_a!r} 叠加过滤排除属于 {cat_b!r} 的记录乙')\n576: \n577:         combined_b = _search(client, recorder, 'a07-combined-b', {'category': cat_b, 'q': shared})\n578:         combined_b_ids = _record_ids(combined_b)\n579:         recorder.check('a07-combined-b-includes', id_b in combined_b_ids, f'category={cat_b!r} 与 q={shared!r} 叠加命中记录乙')\n580:         recorder.check('a07-combined-b-excludes-a', id_a not in combined_b_ids, f'category={cat_b!r} 叠加过滤排除属于 {cat_a!r} 的记录甲')\n581: \n582:         empty = _search(client, recorder, 'a07-no-match', {'q': unmatched})\n583:         recorder.check('a07-no-match-empty', empty == [], f'无匹配关键字 {unmatched!r} 返回 200 空数组，实际 {len(empty)} 条')\n584: \n585:         home = client.get('/', accept='text/html')\n586:         recorder.expect_status(home, 200, aid='a07-home-status')\n587:         recorder.check(\n588:             'a07-home-content-type',\n589:             'text/html' in home.content_type.lower(),\n590:             f'GET / Content-Type={home.content_type!r}',\n591:         )\n592:         home_doc = _parse_html(home.text)\n593:         search_form = home_doc.search_form()\n594:         if not recorder.check(\n595:             'a07-search-form',\n596:             search_form is not None,\n597:             '首页含 form[data-testid=category-search-form]（category 与 q）',\n598:         ):\n599:             return\n600:         if not recorder.check(\n601:             'a07-search-fields',\n602:             search_form.has_name('category') and search_form.has_name('q'),\n603:             'category-search-form 同时含 category 与 q 字段',\n604:         ):\n605:             return\n606:         recorder.check(\n607:             'a07-search-method',\n608:             search_form.method == 'get',\n609:             f'category-search-form method={search_form.method!r}（期望 get）',\n610:         )\n611:         action = _form_path(search_form, '/')\n612:         recorder.check(\n613:             'a07-search-action',\n614:             _action_path(action) == '/',\n615:             f'category-search-form action={action!r}（期望 GET /）',\n616:         )\n617: \n618:         doc_a = _html_search(client, recorder, 'a07-html-a', search_form, cat_a, shared)\n619:         ids_a = _row_ids(doc_a)\n620:         recorder.check(\n621:             'a07-html-a-hit',\n622:             id_a in ids_a,\n623:             f'归类 {cat_a!r} 中 q={shared!r} 命中记录甲：{sorted(ids_a)}',\n624:         )\n625:         recorder.check(\n626:             'a07-html-a-excludes-b',\n627:             id_b not in ids_a,\n628:             f'归类 {cat_a!r} 的搜索结果排除记录乙：{sorted(ids_a)}',\n629:         )\n630: \n631:         doc_b = _html_search(client, recorder, 'a07-html-b', search_form, cat_b, shared)\n632:         ids_b = _row_ids(doc_b)\n633:         recorder.check(\n634:             'a07-html-b-hit',\n635:             id_b in ids_b,\n636:             f'归类 {cat_b!r} 中 q={shared!r} 命中记录乙：{sorted(ids_b)}',\n637:         )\n638:         recorder.check(\n639:             'a07-html-b-excludes-a',\n640:             id_a not in ids_b,\n641:             f'归类 {cat_b!r} 的搜索结果排除记录甲：{sorted(ids_b)}',\n642:         )\n643: \n644:         # Tokens occur only in excluded fields of this target, never in allowed ones.\n645:         for label, token_value in (('url-path', path_only), ('url-query', query_only), ('category-name', cat_a)):\n646:             allowed_text = ' '.join((title_a, host_token + '.atlas-acceptance.example', desc_a)).lower()\n647:             recorder.check(f'a07-{label}-isolated-token', token_value.lower() not in allowed_text,\n648:                            '负例 token 不在目标记录 title/hostname/description')\n649:             for scoped in (False, True):\n650:                 aid = f'a07-excludes-{label}-' + ('category' if scoped else 'all')\n651:                 params = {'q': token_value}\n652:                 if scoped:\n653:                     params['category'] = cat_a\n654:                 results = _search(client, recorder, aid + '-json', params)\n655:                 recorder.check(aid + '-json-target-absent', id_a not in _record_ids(results),\n656:                                'JSON 不因 URL path/query 或分类名而命中目标记录')\n657:                 html = _html_search(client, recorder, aid + '-html', search_form,\n658:                                     cat_a if scoped else '', token_value)\n659:                 recorder.check(aid + '-html-target-absent', id_a not in _row_ids(html),\n660:                                '实际搜索表单的记录行不因排除字段命中；不检查页面回显')\n661:         # These positive controls also prove both entry points do not return always-empty.\n662:         for label, positive_token in (('title', shared), ('hostname', host_token), ('description', desc_token)):\n663:             positive_doc = _html_search(client, recorder, f'a07-html-positive-{label}',\n664:                                         search_form, cat_a, positive_token.upper())\n665:             recorder.check(f'a07-html-positive-{label}-hit', id_a in _row_ids(positive_doc),\n666:                            '允许字段经真实 HTML 搜索表单仍命中同一记录')\n667:         doc_empty = _html_search(client, recorder, 'a07-html-empty', search_form, cat_a, unmatched)\n668:         empty_ids = _row_ids(doc_empty)\n669:         recorder.check(\n670:             'a07-html-empty-no-rows',\n671:             not empty_ids,\n672:             f'归类 {cat_a!r} 中 q={unmatched!r} 无记录行，实际 {sorted(empty_ids)}',\n673:         )\n674:         empty_text = _empty_state_text(doc_empty)\n675:         recorder.check(\n676:             'a07-html-empty-marker',\n677:             bool(empty_text),\n678:             f'无匹配时显示明确空结果，实际 {empty_text!r}',\n679:         )\n680:     finally:\n681:         client.close()\n682: \n683: \n684: def _case_a08(args, recorder):\n685:     client = common.HttpClient(args.base_url)\n686:     try:\n687:         health = client.get('/api/health')\n688:         recorder.expect_status(health, 200, aid='a08-health-status')\n689: \n690:         host_token = f'open{uuid.uuid4().hex[:12]}'\n691:         path_token = uuid.uuid4().hex[:12]\n692:         target_url = f'https://{host_token}.atlas-acceptance.example/page/{path_token}?src=atlas&n=7'\n693:         home = client.get('/', accept='text/html')\n694:         recorder.expect_status(home, 200, aid='a08-home-status')\n695:         recorder.check(\n696:             'a08-home-content-type',\n697:             'text/html' in home.content_type.lower(),\n698:             f'GET / Content-Type={home.content_type!r}',\n699:         )\n700:         home_doc = _parse_html(home.text)\n701:         save_form = home_doc.save_form()\n702:         if not recorder.check(\n703:             'a08-save-form',\n704:             save_form is not None,\n705:             '首页含真实保存表单 form[action=/bookmarks/new]',\n706:         ):\n707:             return\n708:         if not recorder.check(\n709:             'a08-save-url-field',\n710:             save_form.has_name('url'),\n711:             '保存表单含 name=url',\n712:         ):\n713:             return\n714:         save_action = _form_path(save_form, '/bookmarks/new')\n715:         recorder.check(\n716:             'a08-save-method',\n717:             save_form.method == 'post',\n718:             f'保存表单 method={save_form.method!r}（期望 post）',\n719:         )\n720:         recorder.check(\n721:             'a08-save-action',\n722:             _action_path(save_action) == '/bookmarks/new',\n723:             f'保存表单 action={save_action!r}（期望 POST /bookmarks/new）',\n724:         )\n725:         saved = client.post_form(\n726:             save_action,\n727:             _form_fields(save_form, {'url': target_url, 'title': 'A08 打开原页'}),\n728:             follow_redirects=False,\n729:             accept='text/html',\n730:         )\n731:         recorder.expect_status(saved, 303, aid='a08-create-status')\n732:         saved_location = saved.location\n733:         if not recorder.check(\n734:             'a08-create-location',\n735:             bool(saved_location),\n736:             f'保存成功 303 必须带 Location，实际 {saved_location!r}',\n737:         ):\n738:             return\n739:         page = client.get(saved_location, accept='text/html')\n740:         recorder.expect_status(page, 200, aid='a08-create-follow-status')\n741:         page_doc = _parse_html(page.text)\n742:         row = _row_for_url(page_doc, target_url)\n743:         if not recorder.check(\n744:             'a08-record-row',\n745:             row is not None,\n746:             f'保存后列表含 tr[data-record-id] 且打开链接 href={target_url!r}',\n747:         ):\n748:             return\n749:         record_id = row.record_id\n750:         if not recorder.check(\n751:             'a08-create-id',\n752:             bool(record_id),\n753:             f'tr[data-record-id] 的 data-record-id={record_id!r}',\n754:         ):\n755:             return\n756:         open_link = None\n757:         for anchor in row.anchors:\n758:             if anchor.testid == 'record-open-link':\n759:                 open_link = anchor\n760:                 break\n761:         if not recorder.check(\n762:             'a08-open-link',\n763:             open_link is not None,\n764:             '记录行内含 a[data-testid=record-open-link]',\n765:         ):\n766:             return\n767:         recorder.check(\n768:             'a08-link-href',\n769:             open_link.href == target_url,\n770:             f'打开链接 href={open_link.href!r}（期望原始 URL {target_url!r}）',\n771:         )\n772:         recorder.check(\n773:             'a08-link-target',\n774:             open_link.target == '_blank',\n775:             f'打开链接 target={open_link.target!r}（期望 _blank）',\n776:         )\n777:         rel_tokens = {token.strip().lower() for token in open_link.rel.split() if token.strip()}\n778:         recorder.check(\n779:             'a08-link-rel',\n780:             'noopener' in rel_tokens,\n781:             f'打开链接 rel={open_link.rel!r} 含 noopener',\n782:         )\n783:         resolved_target = urljoin(client.base_url + '/', open_link.href)\n784:         recorder.check(\n785:             'a08-link-resolved-target',\n786:             resolved_target == target_url,\n787:             f'urljoin 解析 href 得到 {resolved_target!r}（期望 {target_url!r}）',\n788:         )\n789: \n790:         if record_id:\n791:             opened = client.get(_go_path(record_id), follow_redirects=False)\n792:             recorder.expect_status(opened, 302, aid='a08-open-status')\n793:             location = opened.location\n794:             recorder.check('a08-open-location-present', bool(location), f'302 响应携带 Location 头：{location!r}')\n795:             recorder.check(\n796:                 'a08-open-location',\n797:                 location == target_url,\n798:                 f'GET /go/{{id}} Location={location!r}（期望保存时 URL {target_url!r}）',\n799:             )\n800: \n801:         unknown = f'no-such-{uuid.uuid4().hex[:12]}'\n802:         missing = client.get(_go_path(unknown), follow_redirects=False)\n803:         recorder.expect_status(missing, 404, aid='a08-unknown-status')\n804:         code = _error_code(missing)\n805:         recorder.check('a08-unknown-code', code == 'not_found', f'未知 id 打开错误码={code!r}（期望 not_found）')\n806: \n807:         if record_id:\n808:             fetched = client.get(_bookmark_path(record_id))\n809:             recorder.expect_status(fetched, 200, aid='a08-readback-status')\n810:             stored = _extract_record(_safe_json(fetched))\n811:             recorder.check(\n812:                 'a08-url-unchanged',\n813:                 _record_url(stored) == target_url,\n814:                 f'打开动作后记录 url={_record_url(stored)!r}（未被改写，期望 {target_url!r}）',\n815:             )\n816:     finally:\n817:         client.close()\n818: \n819: \n820: _HANDLERS = {\n821:     'A07': _case_a07,\n822:     'A08': _case_a08,\n823: }\n824: \n825: \n826: def main(argv=None):\n827:     args = common.parse_case_args(argv)\n828:     recorder = common.Recorder(args.case)\n829:     handler = _HANDLERS.get(args.case)\n830:     if handler is None:\n831:         recorder.check(\n832:             'dispatch',\n833:             False,\n834:             f'acceptance/p0_find_open.py 不实现用例 {args.case}（应由其他程序派发）',\n835:         )\n836:     else:\n837:         try:\n838:             handler(args, recorder)\n839:         except common.AcceptanceError as exc:\n840:             recorder.check('infrastructure', False, f'验收基础设施错误：{exc}')\n841:         except Exception as exc:\n842:             recorder.check('unexpected-error', False, f'未预期错误：{type(exc).__name__}: {exc}')\n843:     return recorder.finish(args.case)\n844: \n845: \n846: if __name__ == '__main__':\n847:     sys.exit(main())","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file source/candidate/acceptance/p0_find_open.py, lines 1-847\n1: #!/usr/bin/env python3\n2: '''P0 行为验收组：关键字检索与打开原页。\n3: \n4: 覆盖 A07、A08。A07 先保留 JSON 检索断言，再通过真实 category-search-form\n5: 在归类间提交同一关键字并验证空结果；A08 通过真实保存表单创建带查询串的\n6: 记录，检查打开链接属性、urljoin 解析目标与 /go 302。仅使用 Python 3.12\n7: 标准库并复用 acceptance/common.py：以 --case 派发，未知用例显式失败；\n8: 每个用例对真实目标执行正向与硬负向行为断言，向 stdout 输出单个\n9: atlas.acceptance-result.v1 JSON，失败时以非零码退出。\n10: '''\n11: \n12: from __future__ import annotations\n13: \n14: import os\n15: import sys\n16: import uuid\n17: from html.parser import HTMLParser\n18: from urllib.parse import quote, urljoin, urlsplit\n19: \n20: _THIS_DIR = os.path.dirname(os.path.abspath(__file__))\n21: if _THIS_DIR not in sys.path:\n22:     sys.path.insert(0, _THIS_DIR)\n23: \n24: import common\n25: \n26: \n27: _VOID_TAGS = frozenset({\n28:     'area', 'base', 'br', 'col', 'embed', 'hr', 'img', 'input',\n29:     'link', 'meta', 'param', 'source', 'track', 'wbr',\n30: })\n31: _EMPTY_MARKERS = (\n32:     '无匹配', '没有匹配', '没有找到', '未找到', '暂无', '没有记录',\n33:     '空结果', 'no results', 'no matching', 'no bookmarks', 'nothing here', 'empty',\n34: )\n35: \n36: \n37: def _normalize_space(value):\n38:     return ' '.join(str(value or '').split())\n39: \n40: \n41: class _Field:\n42:     def __init__(self, attrs):\n43:         self.name = attrs.get('name')\n44:         self.value = attrs.get('value', '')\n45:         self.type = (attrs.get('type') or 'text').lower()\n46:         self.checked = 'checked' in attrs\n47: \n48: \n49: class _Option:\n50:     def __init__(self, attrs):\n51:         self.value = attrs.get('value')\n52:         self.text = ''\n53:         self.selected = 'selected' in attrs\n54: \n55:     def resolved_value(self):\n56:         if self.value is not None:\n57:             return self.value\n58:         return self.text.strip()\n59: \n60: \n61: class _Select:\n62:     def __init__(self, attrs):\n63:         self.name = attrs.get('name')\n64:         self.options = []\n65: \n66:     def selected_value(self):\n67:         for option in self.options:\n68:             if option.selected:\n69:                 return option.resolved_value()\n70:         if self.options:\n71:             return self.options[0].resolved_value()\n72:         return ''\n73: \n74: \n75: class _Textarea:\n76:     def __init__(self, attrs):\n77:         self.name = attrs.get('name')\n78:         self.text = ''\n79: \n80: \n81: class _Form:\n82:     def __init__(self, attrs):\n83:         self.action = (attrs.get('action') or '').strip()\n84:         self.method = (attrs.get('method') or 'get').strip().lower()\n85:         self.testid = attrs.get('data-testid') or ''\n86:         self.fields = []\n87:         self.selects = []\n88:         self.textareas = []\n89: \n90:     def has_name(self, name):\n91:         if any(field.name == name for field in self.fields):\n92:             return True\n93:         if any(select.name == name for select in self.selects):\n94:             return True\n95:         return any(textarea.name == name for textarea in self.textareas)\n96: \n97:     def value(self, name):\n98:         for field in reversed(self.fields):\n99:             if field.name == name:\n100:                 return field.value\n101:         for select in reversed(self.selects):\n102:             if select.name == name:\n103:                 return select.selected_value()\n104:         for textarea in reversed(self.textareas):\n105:             if textarea.name == name:\n106:                 return textarea.text\n107:         return None\n108: \n109: \n110: class _Anchor:\n111:     def __init__(self, attrs):\n112:         self.href = attrs.get('href') or ''\n113:         self.testid = attrs.get('data-testid') or ''\n114:         self.target = attrs.get('target') or ''\n115:         self.rel = attrs.get('rel') or ''\n116:         self.text = ''\n117: \n118: \n119: class _Row:\n120:     def __init__(self, attrs):\n121:         self.record_id = attrs.get('data-record-id') or ''\n122:         self.anchors = []\n123:         self.text = ''\n124: \n125: \n126: class _Document:\n127:     def __init__(self):\n128:         self.forms = []\n129:         self.anchors = []\n130:         self.rows = []\n131:         self.testids = []\n132:         self.text = ''\n133: \n134:     def save_form(self):\n135:         for form in self.forms:\n136:             if form.method == 'post' and _action_path(form.action) == '/bookmarks/new':\n137:                 return form\n138:         for form in self.forms:\n139:             if form.method == 'post' and form.has_name('url'):\n140:                 return form\n141:         return None\n142: \n143:     def search_form(self):\n144:         for form in self.forms:\n145:             if form.testid == 'category-search-form':\n146:                 return form\n147:         for form in self.forms:\n148:             if form.method == 'get' and form.has_name('category') and form.has_name('q'):\n149:                 return form\n150:         return None\n151: \n152: \n153: class _HtmlReader(HTMLParser):\n154:     def __init__(self):\n155:         super().__init__(convert_charrefs=True)\n156:         self.doc = _Document()\n157:         self._form = None\n158:         self._select = None\n159:         self._option = None\n160:         self._textarea = None\n161:         self._anchor = None\n162:         self._row = None\n163:         self._testid_stack = []\n164: \n165:     def handle_starttag(self, tag, attrs):\n166:         tag = tag.lower()\n167:         attributes = {\n168:             str(key).lower(): ('' if value is None else value)\n169:             for key, value in attrs\n170:         }\n171:         testid = attributes.get('data-testid') or ''\n172:         if testid:\n173:             entry = {'attrs': attributes, 'text': ''}\n174:             self.doc.testids.append(entry)\n175:             if tag not in _VOID_TAGS:\n176:                 self._testid_stack.append((tag, entry))\n177:         if tag == 'form':\n178:             self._finish_form()\n179:             self._form = _Form(attributes)\n180:         elif tag == 'input':\n181:             if self._form is not None:\n182:                 self._form.fields.append(_Field(attributes))\n183:         elif tag == 'select':\n184:             self._finish_select()\n185:             if self._form is not None:\n186:                 self._select = _Select(attributes)\n187:         elif tag == 'option':\n188:             self._finish_option()\n189:             if self._select is not None:\n190:                 self._option = _Option(attributes)\n191:         elif tag == 'textarea':\n192:             self._finish_textarea()\n193:             if self._form is not None:\n194:                 self._textarea = _Textarea(attributes)\n195:         elif tag == 'a':\n196:             self._finish_anchor()\n197:             self._anchor = _Anchor(attributes)\n198:         elif tag == 'tr' and (attributes.get('data-record-id') or testid == 'record-row'):\n199:             self._finish_row()\n200:             self._row = _Row(attributes)\n201: \n202:     def handle_data(self, data):\n203:         if not data:\n204:             return\n205:         self.doc.text += data\n206:         if self._row is not None:\n207:             self._row.text += data\n208:         if self._anchor is not None:\n209:             self._anchor.text += data\n210:         if self._option is not None:\n211:             self._option.text += data\n212:         if self._textarea is not None:\n213:             self._textarea.text += data\n214:         for _, entry in self._testid_stack:\n215:             entry['text'] += data\n216: \n217:     def handle_endtag(self, tag):\n218:         tag = tag.lower()\n219:         if tag == 'a':\n220:             self._finish_anchor()\n221:         elif tag == 'option':\n222:             self._finish_option()\n223:         elif tag == 'select':\n224:             self._finish_select()\n225:         elif tag == 'textarea':\n226:             self._finish_textarea()\n227:         elif tag == 'form':\n228:             self._finish_form()\n229:         elif tag == 'tr':\n230:             self._finish_row()\n231:         if tag in _VOID_TAGS:\n232:             return\n233:         if self._testid_stack and self._testid_stack[-1][0] == tag:\n234:             self._testid_stack.pop()\n235: \n236:     def _finish_option(self):\n237:         if self._option is None:\n238:             return\n239:         option = self._option\n240:         self._option = None\n241:         if self._select is not None:\n242:             self._select.options.append(option)\n243: \n244:     def _finish_select(self):\n245:         self._finish_option()\n246:         if self._select is None:\n247:             return\n248:         select = self._select\n249:         self._select = None\n250:         if self._form is not None:\n251:             self._form.selects.append(select)\n252: \n253:     def _finish_textarea(self):\n254:         if self._textarea is None:\n255:             return\n256:         textarea = self._textarea\n257:         self._textarea = None\n258:         if self._form is not None:\n259:             self._form.textareas.append(textarea)\n260: \n261:     def _finish_anchor(self):\n262:         if self._anchor is None:\n263:             return\n264:         anchor = self._anchor\n265:         self._anchor = None\n266:         self.doc.anchors.append(anchor)\n267:         if self._row is not None:\n268:             self._row.anchors.append(anchor)\n269: \n270:     def _finish_row(self):\n271:         if self._row is None:\n272:             return\n273:         row = self._row\n274:         self._row = None\n275:         self.doc.rows.append(row)\n276: \n277:     def _finish_form(self):\n278:         self._finish_select()\n279:         self._finish_textarea()\n280:         if self._form is None:\n281:             return\n282:         form = self._form\n283:         self._form = None\n284:         self.doc.forms.append(form)\n285: \n286:     def finalize(self):\n287:         self._finish_anchor()\n288:         self._finish_row()\n289:         self._finish_form()\n290: \n291: \n292: def _parse_html(text):\n293:     reader = _HtmlReader()\n294:     reader.feed(text or '')\n295:     reader.close()\n296:     reader.finalize()\n297:     return reader.doc\n298: \n299: \n300: def _action_path(action):\n301:     text = (action or '').strip()\n302:     if not text:\n303:         return ''\n304:     try:\n305:         path = urlsplit(text).path\n306:     except ValueError:\n307:         return text\n308:     if not path:\n309:         return ''\n310:     if not path.startswith('/'):\n311:         path = '/' + path\n312:     return path.rstrip('/') or '/'\n313: \n314: \n315: def _form_path(form, default):\n316:     return (form.action or '').strip() or default\n317: \n318: \n319: def _form_fields(form, overrides=None, omit=()):\n320:     fields = {}\n321:     for field in form.fields:\n322:         name = field.name\n323:         if not name:\n324:             continue\n325:         if field.type in ('submit', 'button', 'reset', 'file', 'image'):\n326:             continue\n327:         if field.type in ('checkbox', 'radio') and not field.checked:\n328:             continue\n329:         fields[name] = field.value\n330:     for select in form.selects:\n331:         if select.name:\n332:             fields[select.name] = select.selected_value()\n333:     for textarea in form.textareas:\n334:         if textarea.name:\n335:             fields[textarea.name] = textarea.text\n336:     for key, value in (overrides or {}).items():\n337:         fields[str(key)] = str(value)\n338:     for name in omit:\n339:         fields.pop(name, None)\n340:     return fields\n341: \n342: \n343: def _row_for_url(doc, url):\n344:     for row in doc.rows:\n345:         if any(anchor.testid == 'record-open-link' and anchor.href == url for anchor in row.anchors):\n346:             return row\n347:     for row in doc.rows:\n348:         if any(anchor.href == url for anchor in row.anchors):\n349:             return row\n350:     return None\n351: \n352: \n353: def _row_ids(doc):\n354:     return {row.record_id for row in doc.rows if row.record_id}\n355: \n356: \n357: def _empty_state_text(doc):\n358:     for entry in doc.testids:\n359:         testid = (entry['attrs'].get('data-testid') or '').lower()\n360:         if 'empty' in testid:\n361:             text = _normalize_space(entry['text'])\n362:             if text:\n363:                 return text\n364:     text = _normalize_space(doc.text)\n365:     folded = text.casefold()\n366:     for marker in _EMPTY_MARKERS:\n367:         if marker.casefold() in folded:\n368:             return marker\n369:     return ''\n370: \n371: \n372: def _html_search(client, recorder, aid, form, category, query):\n373:     fields = _form_fields(form, {'category': category, 'q': query})\n374:     response = client.get(_form_path(form, '/'), params=fields, accept='text/html')\n375:     recorder.expect_status(response, 200, aid=f'{aid}-status')\n376:     recorder.check(\n377:         f'{aid}-content-type',\n378:         'text/html' in response.content_type.lower(),\n379:         f'GET 搜索页 Content-Type={response.content_type!r}',\n380:     )\n381:     doc = _parse_html(response.text)\n382:     result_form = doc.search_form()\n383:     recorder.check(f'{aid}-form', result_form is not None, '搜索页保留 category-search-form')\n384:     retained_category = None\n385:     retained_query = None\n386:     if result_form is not None:\n387:         retained_category = result_form.value('category')\n388:         retained_query = result_form.value('q')\n389:         recorder.check(\n390:             f'{aid}-category-retained',\n391:             retained_category == category,\n392:             f'搜索表单 category={retained_category!r}（期望 {category!r}）',\n393:         )\n394:         recorder.check(\n395:             f'{aid}-query-retained',\n396:             retained_query == query,\n397:             f'搜索表单 q={retained_query!r}（期望 {query!r}）',\n398:         )\n399:     text = _normalize_space(doc.text)\n400:     recorder.check(\n401:         f'{aid}-category-visible',\n402:         category in text or retained_category == category,\n403:         f'结果页显示所选归类 {category!r}（表单保留值 {retained_category!r}）',\n404:     )\n405:     recorder.check(\n406:         f'{aid}-query-visible',\n407:         query in text or retained_query == query,\n408:         f'结果页显示查询 {query!r}（表单保留值 {retained_query!r}）',\n409:     )\n410:     return doc\n411: \n412: \n413: def _unique_url(tag):\n414:     token = f'{tag}-{uuid.uuid4().hex[:12]}'\n415:     return f'https://{token}.atlas-acceptance.example/{token}'\n416: \n417: \n418: def _unique_category(tag):\n419:     return f'atlas-{tag}-{uuid.uuid4().hex[:10]}'\n420: \n421: \n422: def _safe_json(response):\n423:     try:\n424:         return response.json()\n425:     except Exception:\n426:         return None\n427: \n428: \n429: def _extract_record(payload):\n430:     if isinstance(payload, dict):\n431:         for key in ('bookmark', 'record', 'data', 'item'):\n432:             value = payload.get(key)\n433:             if isinstance(value, dict):\n434:                 return value\n435:         return payload\n436:     return None\n437: \n438: \n439: def _record_id(record):\n440:     if isinstance(record, dict) and record.get('id') is not None:\n441:         return str(record['id'])\n442:     return None\n443: \n444: \n445: def _record_url(record):\n446:     if isinstance(record, dict) and record.get('url') is not None:\n447:         return str(record['url'])\n448:     return None\n449: \n450: \n451: def _record_ids(records):\n452:     return {item_id for item_id in (_record_id(record) for record in records) if item_id}\n453: \n454: \n455: def _error_code(response):\n456:     payload = _safe_json(response)\n457:     if isinstance(payload, dict):\n458:         error = payload.get('error')\n459:         if isinstance(error, dict) and error.get('code') is not None:\n460:             return str(error['code'])\n461:         for key in ('code', 'error_code'):\n462:             if payload.get(key) is not None:\n463:                 return str(payload[key])\n464:     return None\n465: \n466: \n467: def _extract_list(payload, keys):\n468:     if isinstance(payload, list):\n469:         return payload\n470:     if isinstance(payload, dict):\n471:         for key in keys:\n472:             value = payload.get(key)\n473:             if isinstance(value, list):\n474:                 return value\n475:     return None\n476: \n477: \n478: def _bookmark_path(bookmark_id):\n479:     return '/api/bookmarks/' + quote(str(bookmark_id), safe='')\n480: \n481: \n482: def _go_path(bookmark_id):\n483:     return '/go/' + quote(str(bookmark_id), safe='')\n484: \n485: \n486: def _search(client, recorder, aid, params):\n487:     response = client.get('/api/bookmarks', params=params)\n488:     recorder.expect_status(response, 200, aid=f'{aid}-status')\n489:     payload = _safe_json(response)\n490:     records = _extract_list(payload, ('bookmarks', 'items', 'data', 'records'))\n491:     recorder.check(\n492:         f'{aid}-shape',\n493:         isinstance(records, list),\n494:         f'GET /api/bookmarks 必须返回 JSON 数组，实际 {type(payload).__name__}',\n495:     )\n496:     return records if isinstance(records, list) else []\n497: \n498: \n499: def _case_a07(args, recorder):\n500:     client = common.HttpClient(args.base_url)\n501:     try:\n502:         health = client.get('/api/health')\n503:         recorder.expect_status(health, 200, aid='a07-health-status')\n504: \n505:         cat_a = _unique_category('a07a')\n506:         cat_b = _unique_category('a07b')\n507:         shared = f'shared{uuid.uuid4().hex[:12]}'\n508:         host_token = f'host{uuid.uuid4().hex[:12]}'\n509:         desc_token = f'descr{uuid.uuid4().hex[:12]}'\n510:         unmatched = f'absent{uuid.uuid4().hex[:12]}'\n511: \n512:         path_only = f'pathonly{uuid.uuid4().hex[:12]}'\n513:         query_only = f'queryonly{uuid.uuid4().hex[:12]}'\n514:         url_a = f'https://{host_token}.atlas-acceptance.example/{path_only}?q={query_only}'\n515:         title_a = f'{shared} 收藏甲'\n516:         desc_a = f'备注 {desc_token}'\n517:         created_a = client.post_json(\n518:             '/api/bookmarks',\n519:             {'url': url_a, 'title': title_a, 'description': desc_a, 'category': cat_a},\n520:         )\n521:         recorder.expect_status(created_a, 201, aid='a07-create-a-status')\n522:         id_a = _record_id(_extract_record(_safe_json(created_a)))\n523:         recorder.check('a07-create-a-id', bool(id_a), f'创建记录甲返回 id={id_a!r}')\n524: \n525:         url_b = _unique_url('a07b')\n526:         title_b = f'{shared} 收藏乙'\n527:         created_b = client.post_json('/api/bookmarks', {'url': url_b, 'title': title_b, 'category': cat_b})\n528:         recorder.expect_status(created_b, 201, aid='a07-create-b-status')\n529:         id_b = _record_id(_extract_record(_safe_json(created_b)))\n530:         recorder.check('a07-create-b-id', bool(id_b), f'创建记录乙返回 id={id_b!r}')\n531: \n532:         if not (id_a and id_b):\n533:             return\n534: \n535:         by_title = _search(client, recorder, 'a07-title', {'q': shared})\n536:         title_ids = _record_ids(by_title)\n537:         recorder.check('a07-title-hit-a', id_a in title_ids, f'标题片段 {shared!r} 命中记录甲：{sorted(title_ids)}')\n538:         recorder.check('a07-title-hit-b', id_b in title_ids, f'标题片段 {shared!r} 命中记录乙：{sorted(title_ids)}')\n539: \n540:         upper_title = shared.upper()\n541:         by_title_upper = _search(client, recorder, 'a07-title-case', {'q': upper_title})\n542:         recorder.check(\n543:             'a07-title-case-insensitive',\n544:             id_a in _record_ids(by_title_upper),\n545:             f'大写标题片段 {upper_title!r} 命中记录甲（大小写不敏感）',\n546:         )\n547: \n548:         by_host = _search(client, recorder, 'a07-domain', {'q': host_token})\n549:         host_ids = _record_ids(by_host)\n550:         recorder.check('a07-domain-hit', id_a in host_ids, f'域名片段 {host_token!r} 命中记录甲：{sorted(host_ids)}')\n551:         recorder.check('a07-domain-excludes-b', id_b not in host_ids, '域名检索不命中域名不同的记录乙')\n552: \n553:         by_host_upper = _search(client, recorder, 'a07-domain-case', {'q': host_token.upper()})\n554:         recorder.check(\n555:             'a07-domain-case-insensitive',\n556:             id_a in _record_ids(by_host_upper),\n557:             f'大写域名片段 {host_token.upper()!r} 命中记录甲（大小写不敏感）',\n558:         )\n559: \n560:         by_desc = _search(client, recorder, 'a07-description', {'q': desc_token})\n561:         desc_ids = _record_ids(by_desc)\n562:         recorder.check('a07-description-hit', id_a in desc_ids, f'描述片段 {desc_token!r} 命中记录甲：{sorted(desc_ids)}')\n563:         recorder.check('a07-description-excludes-b', id_b not in desc_ids, '描述检索不命中无该描述的记录乙')\n564: \n565:         by_desc_upper = _search(client, recorder, 'a07-description-case', {'q': desc_token.upper()})\n566:         recorder.check(\n567:             'a07-description-case-insensitive',\n568:             id_a in _record_ids(by_desc_upper),\n569:             f'大写描述片段 {desc_token.upper()!r} 命中记录甲（大小写不敏感）',\n570:         )\n571: \n572:         combined_a = _search(client, recorder, 'a07-combined-a', {'category': cat_a, 'q': shared})\n573:         combined_a_ids = _record_ids(combined_a)\n574:         recorder.check('a07-combined-a-includes', id_a in combined_a_ids, f'category={cat_a!r} 与 q={shared!r} 叠加命中记录甲')\n575:         recorder.check('a07-combined-a-excludes-b', id_b not in combined_a_ids, f'category={cat_a!r} 叠加过滤排除属于 {cat_b!r} 的记录乙')\n576: \n577:         combined_b = _search(client, recorder, 'a07-combined-b', {'category': cat_b, 'q': shared})\n578:         combined_b_ids = _record_ids(combined_b)\n579:         recorder.check('a07-combined-b-includes', id_b in combined_b_ids, f'category={cat_b!r} 与 q={shared!r} 叠加命中记录乙')\n580:         recorder.check('a07-combined-b-excludes-a', id_a not in combined_b_ids, f'category={cat_b!r} 叠加过滤排除属于 {cat_a!r} 的记录甲')\n581: \n582:         empty = _search(client, recorder, 'a07-no-match', {'q': unmatched})\n583:         recorder.check('a07-no-match-empty', empty == [], f'无匹配关键字 {unmatched!r} 返回 200 空数组，实际 {len(empty)} 条')\n584: \n585:         home = client.get('/', accept='text/html')\n586:         recorder.expect_status(home, 200, aid='a07-home-status')\n587:         recorder.check(\n588:             'a07-home-content-type',\n589:             'text/html' in home.content_type.lower(),\n590:             f'GET / Content-Type={home.content_type!r}',\n591:         )\n592:         home_doc = _parse_html(home.text)\n593:         search_form = home_doc.search_form()\n594:         if not recorder.check(\n595:             'a07-search-form',\n596:             search_form is not None,\n597:             '首页含 form[data-testid=category-search-form]（category 与 q）',\n598:         ):\n599:             return\n600:         if not recorder.check(\n601:             'a07-search-fields',\n602:             search_form.has_name('category') and search_form.has_name('q'),\n603:             'category-search-form 同时含 category 与 q 字段',\n604:         ):\n605:             return\n606:         recorder.check(\n607:             'a07-search-method',\n608:             search_form.method == 'get',\n609:             f'category-search-form method={search_form.method!r}（期望 get）',\n610:         )\n611:         action = _form_path(search_form, '/')\n612:         recorder.check(\n613:             'a07-search-action',\n614:             _action_path(action) == '/',\n615:             f'category-search-form action={action!r}（期望 GET /）',\n616:         )\n617: \n618:         doc_a = _html_search(client, recorder, 'a07-html-a', search_form, cat_a, shared)\n619:         ids_a = _row_ids(doc_a)\n620:         recorder.check(\n621:             'a07-html-a-hit',\n622:             id_a in ids_a,\n623:             f'归类 {cat_a!r} 中 q={shared!r} 命中记录甲：{sorted(ids_a)}',\n624:         )\n625:         recorder.check(\n626:             'a07-html-a-excludes-b',\n627:             id_b not in ids_a,\n628:             f'归类 {cat_a!r} 的搜索结果排除记录乙：{sorted(ids_a)}',\n629:         )\n630: \n631:         doc_b = _html_search(client, recorder, 'a07-html-b', search_form, cat_b, shared)\n632:         ids_b = _row_ids(doc_b)\n633:         recorder.check(\n634:             'a07-html-b-hit',\n635:             id_b in ids_b,\n636:             f'归类 {cat_b!r} 中 q={shared!r} 命中记录乙：{sorted(ids_b)}',\n637:         )\n638:         recorder.check(\n639:             'a07-html-b-excludes-a',\n640:             id_a not in ids_b,\n641:             f'归类 {cat_b!r} 的搜索结果排除记录甲：{sorted(ids_b)}',\n642:         )\n643: \n644:         # Tokens occur only in excluded fields of this target, never in allowed ones.\n645:         for label, token_value in (('url-path', path_only), ('url-query', query_only), ('category-name', cat_a)):\n646:             allowed_text = ' '.join((title_a, host_token + '.atlas-acceptance.example', desc_a)).lower()\n647:             recorder.check(f'a07-{label}-isolated-token', token_value.lower() not in allowed_text,\n648:                            '负例 token 不在目标记录 title/hostname/description')\n649:             for scoped in (False, True):\n650:                 aid = f'a07-excludes-{label}-' + ('category' if scoped else 'all')\n651:                 params = {'q': token_value}\n652:                 if scoped:\n653:                     params['category'] = cat_a\n654:                 results = _search(client, recorder, aid + '-json', params)\n655:                 recorder.check(aid + '-json-target-absent', id_a not in _record_ids(results),\n656:                                'JSON 不因 URL path/query 或分类名而命中目标记录')\n657:                 html = _html_search(client, recorder, aid + '-html', search_form,\n658:                                     cat_a if scoped else '', token_value)\n659:                 recorder.check(aid + '-html-target-absent', id_a not in _row_ids(html),\n660:                                '实际搜索表单的记录行不因排除字段命中；不检查页面回显')\n661:         # These positive controls also prove both entry points do not return always-empty.\n662:         for label, positive_token in (('title', shared), ('hostname', host_token), ('description', desc_token)):\n663:             positive_doc = _html_search(client, recorder, f'a07-html-positive-{label}',\n664:                                         search_form, cat_a, positive_token.upper())\n665:             recorder.check(f'a07-html-positive-{label}-hit', id_a in _row_ids(positive_doc),\n666:                            '允许字段经真实 HTML 搜索表单仍命中同一记录')\n667:         doc_empty = _html_search(client, recorder, 'a07-html-empty', search_form, cat_a, unmatched)\n668:         empty_ids = _row_ids(doc_empty)\n669:         recorder.check(\n670:             'a07-html-empty-no-rows',\n671:             not empty_ids,\n672:             f'归类 {cat_a!r} 中 q={unmatched!r} 无记录行，实际 {sorted(empty_ids)}',\n673:         )\n674:         empty_text = _empty_state_text(doc_empty)\n675:         recorder.check(\n676:             'a07-html-empty-marker',\n677:             bool(empty_text),\n678:             f'无匹配时显示明确空结果，实际 {empty_text!r}',\n679:         )\n680:     finally:\n681:         client.close()\n682: \n683: \n684: def _case_a08(args, recorder):\n685:     client = common.HttpClient(args.base_url)\n686:     try:\n687:         health = client.get('/api/health')\n688:         recorder.expect_status(health, 200, aid='a08-health-status')\n689: \n690:         host_token = f'open{uuid.uuid4().hex[:12]}'\n691:         path_token = uuid.uuid4().hex[:12]\n692:         target_url = f'https://{host_token}.atlas-acceptance.example/page/{path_token}?src=atlas&n=7'\n693:         home = client.get('/', accept='text/html')\n694:         recorder.expect_status(home, 200, aid='a08-home-status')\n695:         recorder.check(\n696:             'a08-home-content-type',\n697:             'text/html' in home.content_type.lower(),\n698:             f'GET / Content-Type={home.content_type!r}',\n699:         )\n700:         home_doc = _parse_html(home.text)\n701:         save_form = home_doc.save_form()\n702:         if not recorder.check(\n703:             'a08-save-form',\n704:             save_form is not None,\n705:             '首页含真实保存表单 form[action=/bookmarks/new]',\n706:         ):\n707:             return\n708:         if not recorder.check(\n709:             'a08-save-url-field',\n710:             save_form.has_name('url'),\n711:             '保存表单含 name=url',\n712:         ):\n713:             return\n714:         save_action = _form_path(save_form, '/bookmarks/new')\n715:         recorder.check(\n716:             'a08-save-method',\n717:             save_form.method == 'post',\n718:             f'保存表单 method={save_form.method!r}（期望 post）',\n719:         )\n720:         recorder.check(\n721:             'a08-save-action',\n722:             _action_path(save_action) == '/bookmarks/new',\n723:             f'保存表单 action={save_action!r}（期望 POST /bookmarks/new）',\n724:         )\n725:         saved = client.post_form(\n726:             save_action,\n727:             _form_fields(save_form, {'url': target_url, 'title': 'A08 打开原页'}),\n728:             follow_redirects=False,\n729:             accept='text/html',\n730:         )\n731:         recorder.expect_status(saved, 303, aid='a08-create-status')\n732:         saved_location = saved.location\n733:         if not recorder.check(\n734:             'a08-create-location',\n735:             bool(saved_location),\n736:             f'保存成功 303 必须带 Location，实际 {saved_location!r}',\n737:         ):\n738:             return\n739:         page = client.get(saved_location, accept='text/html')\n740:         recorder.expect_status(page, 200, aid='a08-create-follow-status')\n741:         page_doc = _parse_html(page.text)\n742:         row = _row_for_url(page_doc, target_url)\n743:         if not recorder.check(\n744:             'a08-record-row',\n745:             row is not None,\n746:             f'保存后列表含 tr[data-record-id] 且打开链接 href={target_url!r}',\n747:         ):\n748:             return\n749:         record_id = row.record_id\n750:         if not recorder.check(\n751:             'a08-create-id',\n752:             bool(record_id),\n753:             f'tr[data-record-id] 的 data-record-id={record_id!r}',\n754:         ):\n755:             return\n756:         open_link = None\n757:         for anchor in row.anchors:\n758:             if anchor.testid == 'record-open-link':\n759:                 open_link = anchor\n760:                 break\n761:         if not recorder.check(\n762:             'a08-open-link',\n763:             open_link is not None,\n764:             '记录行内含 a[data-testid=record-open-link]',\n765:         ):\n766:             return\n767:         recorder.check(\n768:             'a08-link-href',\n769:             open_link.href == target_url,\n770:             f'打开链接 href={open_link.href!r}（期望原始 URL {target_url!r}）',\n771:         )\n772:         recorder.check(\n773:             'a08-link-target',\n774:             open_link.target == '_blank',\n775:             f'打开链接 target={open_link.target!r}（期望 _blank）',\n776:         )\n777:         rel_tokens = {token.strip().lower() for token in open_link.rel.split() if token.strip()}\n778:         recorder.check(\n779:             'a08-link-rel',\n780:             'noopener' in rel_tokens,\n781:             f'打开链接 rel={open_link.rel!r} 含 noopener',\n782:         )\n783:         resolved_target = urljoin(client.base_url + '/', open_link.href)\n784:         recorder.check(\n785:             'a08-link-resolved-target',\n786:             resolved_target == target_url,\n787:             f'urljoin 解析 href 得到 {resolved_target!r}（期望 {target_url!r}）',\n788:         )\n789: \n790:         if record_id:\n791:             opened = client.get(_go_path(record_id), follow_redirects=False)\n792:             recorder.expect_status(opened, 302, aid='a08-open-status')\n793:             location = opened.location\n794:             recorder.check('a08-open-location-present', bool(location), f'302 响应携带 Location 头：{location!r}')\n795:             recorder.check(\n796:                 'a08-open-location',\n797:                 location == target_url,\n798:                 f'GET /go/{{id}} Location={location!r}（期望保存时 URL {target_url!r}）',\n799:             )\n800: \n801:         unknown = f'no-such-{uuid.uuid4().hex[:12]}'\n802:         missing = client.get(_go_path(unknown), follow_redirects=False)\n803:         recorder.expect_status(missing, 404, aid='a08-unknown-status')\n804:         code = _error_code(missing)\n805:         recorder.check('a08-unknown-code', code == 'not_found', f'未知 id 打开错误码={code!r}（期望 not_found）')\n806: \n807:         if record_id:\n808:             fetched = client.get(_bookmark_path(record_id))\n809:             recorder.expect_status(fetched, 200, aid='a08-readback-status')\n810:             stored = _extract