on\": \"acceptance/p0_organize.py\",\n667:      \"operation\": \"bookmark_move\",\n668:      \"response\": \"error.code/message/field\",\n669:      \"status\": 400,\n670:      \"transport\": \"json\",\n671:      \"value_kind\": \"null\",\n672:      \"write_effect\": \"none\"\n673:     }\n674:    ],\n675:    \"schema\": \"atlas.bookmark-error-contract.v1\"\n676:   },\n677:   \"features\": [\n678:    {\n679:     \"acceptance_ids\": [\n680:      \"A01\",\n681:      \"A02\",\n682:      \"A03\"\n683:     ],\n684:     \"action\": \"填写原始 URL，可选标题/描述，选择已有归类、留为默认「未整理」或输入新归类名并提交。\",\n685:     \"design_basis\": \"场景 workflow 1–2 与验收 1/2：用户主动保存外部网页链接，记录以 URL 锚定并持久保留。\",\n686:     \"entry\": \"首页 GET / 的保存表单 form[action=/bookmarks/new]，字段 url、title、description、category。\",\n687:     \"failure\": \"非法 URL 返回 400 invalid_url，非法归类返回 400 invalid_category；HTML 同页显示 [data-testid=form-error]，不写入。\",\n688:     \"feature_id\": \"F01\",\n689:     \"navigation\": \"成功后 303 到 /?category=<归类> 或 /，浏览器显示新记录行。\",\n690:     \"recovery\": \"失败页保留已填 url/title/description/category，用户修正后重新提交；也可返回列表。\",\n691:     \"success_state\": \"303 返回首页，新记录出现在所选归类，GET /api/bookmarks/{id} 返回同一原始 URL；SQLite 行已持久化。\"\n692:    },\n693:    {\n694:     \"acceptance_ids\": [\n695:      \"A03\"\n696:     ],\n697:     \"action\": \"不另选归类直接保存；首启查看预置归类。\",\n698:     \"design_basis\": \"场景 workflow 3：未经整理的链接先进入默认归类，之后再移动；成熟产品普遍提供未被整理收件区。\",\n699:     \"entry\": \"首页保存表单的 category 字段（默认「未整理」）与侧栏/归类页的预置归类列表。\",\n700:     \"failure\": \"默认归类缺失或写入失败时返回明确错误页或 JSON 错误，不伪装成功。\",\n701:     \"feature_id\": \"F02\",\n702:     \"navigation\": \"303 到首页或未整理归类视图。\",\n703:     \"recovery\": \"重试保存；应用启动时在事务中补齐预置归类。\",\n704:     \"success_state\": \"记录的 category_id 为默认「未整理」，可在 /?category=未整理 看到；“未整理”“待购”“家居改造”“以后看看”均可见。\"\n705:    },\n706:    {\n707:     \"acceptance_ids\": [\n708:      \"A04\"\n709:     ],\n710:     \"action\": \"在真实表单提交 name 新建/重命名，提交 category_id 删除；删除默认归类被拒绝。\",\n711:     \"design_basis\": \"场景验收 3 与 workflow 2：用户可新建归类并把记录放入合适位置；源包没有 collections，属目标新设计。\",\n712:     \"entry\": \"首页 a[data-testid=category-manager] 进入 /categories；该页含 category-create-form、category-rename-form、category-delete-form。\",\n713:     \"error_branch_ids\": [\n714:      \"html.category_create.name.omitted\",\n715:      \"html.category_create.name.empty\",\n716:      \"html.category_create.name.whitespace\",\n717:      \"html.category_create.name.overlong_121\",\n718:      \"html.category_rename.name.omitted\",\n719:      \"html.category_rename.name.empty\",\n720:      \"html.category_rename.name.whitespace\",\n721:      \"html.category_rename.name.overlong_121\",\n722:      \"json.category_create.name.omitted\",\n723:      \"json.category_create.name.empty\",\n724:      \"json.category_create.name.whitespace\",\n725:      \"json.category_create.name.overlong_121\",\n726:      \"json.category_create.name.null\",\n727:      \"json.category_rename.name.omitted\",\n728:      \"json.category_rename.name.empty\",\n729:      \"json.category_rename.name.whitespace\",\n730:      \"json.category_rename.name.overlong_121\",\n731:      \"json.category_rename.name.null\"\n732:     ],\n733:     \"failure\": \"重名 409 duplicate_category、空名/超长 400 invalid_name、默认归类 400 protected_category；页面显示 form-error 且数据不变。\",\n734:     \"feature_id\": \"F03\",\n735:     \"navigation\": \"创建/重命名/删除成功后 303 到 /categories。\",\n736:     \"recovery\": \"保留已填 name/category_id 并允许改正或选择其他归类；可返回 /categories 重试。\",\n737:     \"success_state\": \"303 到 /categories；新建/重命名可见且计数正确；删除归类后其活动与软删除记录都迁回「未整理」，软删记录仍可恢复。\"\n738:    },\n739:    {\n740:     \"acceptance_ids\": [\n741:      \"A05\",\n742:      \"A12\"\n743:     ],\n744:     \"action\": \"选择目标归类（API 归类 ID）并提交；HTML 适配器把 ID 翻译为归类名后调用现有 move 服务。\",\n745:     \"design_basis\": \"场景验收 3 与 workflow 3：记录可在归类之间移动，重新打开后仍保持新归属。\",\n746:     \"entry\": \"每条 tr[data-testid=record-row] 内的 form[data-testid=record-move-form]，含 input record_id 与 select name=category_id。\",\n747:     \"error_branch_ids\": [\n748:      \"html.bookmark_save.category.empty\",\n749:      \"html.bookmark_save.category.whitespace\",\n750:      \"html.bookmark_save.category.overlong_121\",\n751:      \"html.bookmark_move.category_id.omitted\",\n752:      \"html.bookmark_move.category_id.empty\",\n753:      \"html.bookmark_move.category_id.unknown_id\",\n754:      \"json.bookmark_save.category.empty\",\n755:      \"json.bookmark_save.category.whitespace\",\n756:      \"json.bookmark_save.category.overlong_121\",\n757:      \"json.bookmark_move.category.empty\",\n758:      \"json.bookmark_move.category.whitespace\",\n759:      \"json.bookmark_move.category.overlong_121\",\n760:      \"json.bookmark_move.category.omitted\",\n761:      \"json.bookmark_move.category.null\"\n762:     ],\n763:     \"failure\": \"空/超长/非法归类 400 invalid_category，未知 record_id 404 not_found；不移动、不写入。\",\n764:     \"feature_id\": \"F04\",\n765:     \"navigation\": \"成功后 303 到 /?category=<目标归类> 或来源视图。\",\n766:     \"recovery\": \"保留选择并显示 form-error；用户改选有效归类或返回列表重试。\",\n767:     \"success_state\": \"303 回列表；记录离开原归类并出现在目标归类，JSON 的 category 与持久化结果一致。\"\n768:    },\n769:    {\n770:     \"acceptance_ids\": [\n771:      \"A06\"\n772:     ],\n773:     \"action\": \"点击归类链接或从搜索表单选择归类并查看列表。\",\n774:     \"design_basis\": \"场景验收 4：用户通过归类浏览找回记录；来源标签计数被调整为按归类聚合。\",\n775:     \"entry\": \"首页侧栏 [data-testid=category-count][data-category-id] 与归类链接；/categories 同显计数；GET /?category=<name>。\",\n776:     \"failure\": \"未知归类返回空结果而非 5xx；计数查询失败显示错误页。\",\n777:     \"feature_id\": \"F05\",\n778:     \"navigation\": \"GET /?category=... 或 GET /categories；无记录时显示明确空状态。\",\n779:     \"recovery\": \"选择其他归类或清空筛选。\",\n780:     \"success_state\": \"页面只列该归类活动记录；HTML count 与 JSON count 都等于活动（未软删）记录数；移动、删除、恢复后仍一致。\"\n781:    },\n782:    {\n783:     \"acceptance_ids\": [\n784:      \"A07\"\n785:     ],\n786:     \"action\": \"选择归类、输入关键字并提交。\",\n787:     \"design_basis\": \"场景验收 4：用户凭记得的关键字找回已存链接；来源仅搜标题，目标扩展到可识别来源的字段。\",\n788:     \"entry\": \"首页 form[data-testid=category-search-form]，字段 category（归类名）与 q；action 为 GET /。\",\n789:     \"failure\": \"无匹配不是错误（200 + 空结果）；非法请求返回可读错误且不写入。\",\n790:     \"feature_id\": \"F06\",\n791:     \"navigation\": \"GET /?category=...&q=...，同一页面更新结果。\",\n792:     \"recovery\": \"修改 q 或切换归类重新提交；清空 q 恢复归类浏览。\",\n793:     \"success_state\": \"URL 与表单保留 category 与 q；页面显示所选归类、保留查询和匹配行；同一关键字在两个归类分别命中各自记录；无匹配显示明确空结果；JSON 返回匹配集。\"\n794:    },\n795:    {\n796:     \"acceptance_ids\": [\n797:      \"A08\"\n798:     ],\n799:     \"action\": \"用户点击打开链接。\",\n800:     \"design_basis\": \"场景验收 2 与 workflow 5：打开记录即回到保存时的外部网页，库只保证引用而非内容。\",\n801:     \"entry\": \"记录行 a[data-testid=record-open-link] 与 GET /go/{id}。\",\n802:     \"failure\": \"未知 id 404 not_found；目标不可达不影响库中记录可读。\",\n803:     \"feature_id\": \"F07\",\n804:     \"navigation\": \"浏览器导航到原始 URL（新标签）；服务端只发 302。\",\n805:     \"recovery\": \"返回收藏列表选择其他记录；如 URL 有误，可由现有 PATCH API 更新并重算 hostname。\",\n806:     \"success_state\": \"链接 href 恰为保存时原始 URL，target=_blank、rel 含 noopener；GET /go/{id} 302 Location 为同一字符串；P0 不请求目标页。\"\n807:    },\n808:    {\n809:     \"acceptance_ids\": [\n810:      \"A01\",\n811:      \"A05\",\n812:      \"A09\"\n813:     ],\n814:     \"action\": \"执行真实写操作，停止应用进程，再以同一实例目录重启并读取。\",\n815:     \"design_basis\": \"场景验收 1：主动保存的链接在多次会话之间持久保留；目标以 SQLite 实现本地单用户持久化。\",\n816:     \"entry\": \"保存、移动、删除/恢复等写操作后重新请求页面；重启适配器从同一 app_root 与实例数据目录启动。\",\n817:     \"failure\": \"数据库不可写或损坏时返回明确 5xx 错误页而非成功假象；事务回滚保持旧状态。\",\n818:     \"feature_id\": \"F08\",\n819:     \"navigation\": \"无自动导航；下次 GET / 读取持久状态。\",\n820:     \"recovery\": \"恢复可写数据目录后重试；重启应用重新初始化 schema。\",\n821:     \"success_state\": \"重启后 id、原始 URL、标题、描述、归类与 trashed 状态与写入后一致；HTML 与 JSON 都来自 SQLite。\"\n822:    },\n823:    {\n824:     \"acceptance_ids\": [\n825:      \"A09\"\n826:     ],\n827:     \"action\": \"提交 record_id 软删除；在回收站提交 record_id 恢复。\",\n828:     \"design_basis\": \"场景要求可恢复的失败；来源仅有归档记录的瞬时 Undo，目标改为显式软删除与恢复。\",\n829:     \"entry\": \"记录行 form[data-testid=record-delete-form]；GET /?trash=1 的软删记录行 form[data-testid=record-restore-form]。\",\n830:     \"failure\": \"未知 record_id 404 not_found；失败不改变 trashed_at，不产生 5xx。\",\n831:     \"feature_id\": \"F09\",\n832:     \"navigation\": \"删除成功 303 到 /?trash=1；恢复成功 303 到恢复后归类。\",\n833:     \"recovery\": \"回收站提供可提交的恢复表单；失败可重试或返回列表。\",\n834:     \"success_state\": \"默认视图与计数排除软删记录，回收站仍显示；恢复后原始字段与归类回归并重新可见；归类删除后软删记录仍在「未整理」可恢复。\"\n835:    },\n836:    {\n837:     \"acceptance_ids\": [\n838:      \"A02\",\n839:      \"A10\",\n840:      \"A12\"\n841:     ],\n842:     \"action\": \"提交非法 URL、空/超长/非法归类、畸形 JSON 或未知 ID。\",\n843:     \"design_basis\": \"场景要求非法输入可恢复；源表单校验被调整为服务端 HTML 表单与 JSON API 共用的显式错误合同。\",\n844:     \"entry\": \"所有 HTML 表单（保存、归类、移动、删除、恢复、搜索）与 JSON API 端点。\",\n845:     \"error_branch_ids\": [\n846:      \"html.bookmark_save.category.empty\",\n847:      \"html.bookmark_save.category.whitespace\",\n848:      \"html.bookmark_save.category.overlong_121\",\n849:      \"html.bookmark_move.category_id.omitted\",\n850:      \"html.bookmark_move.category_id.empty\",\n851:      \"html.bookmark_move.category_id.unknown_id\",\n852:      \"json.bookmark_save.category.empty\",\n853:      \"json.bookmark_save.category.whitespace\",\n854:      \"json.bookmark_save.category.overlong_121\",\n855:      \"json.bookmark_move.category.empty\",\n856:      \"json.bookmark_move.category.whitespace\",\n857:      \"json.bookmark_move.category.overlong_121\",\n858:      \"json.bookmark_move.category.omitted\",\n859:      \"json.bookmark_move.category.null\"\n860:     ],\n861:     \"failure\": \"出现 5xx、静默写入或不可恢复的错误页即视为失败。\",\n862:     \"feature_id\": \"F10\",\n863:     \"navigation\": \"HTML 错误留在当前表单页并保留输入；JSON 无导航。\",\n864:     \"recovery\": \"修正字段后重新提交；失败页保留可运行的表单或返回链接。\",\n865:     \"success_state\": \"错误路径本身成功执行：JSON 返回 400/404/409 与结构化错误码，HTML 返回 400/409 与 form-error；畸形 JSON 为 bad_request；均无 5xx、无写入。\"\n866:    },\n867:    {\n868:     \"acceptance_ids\": [\n869:      \"A11\"\n870:     ],\n871:     \"action\": \"首启或空库时打开首页。\",\n872:     \"design_basis\": \"场景是单用户本地工具，需要可打开的应用入口；目标采用 Python 服务端渲染外壳而非来源 SPA。\",\n873:     \"entry\": \"GET / 与 GET /api/health。\",\n874:     \"failure\": \"健康检查非 200/非 JSON、首页 5xx 或缺少表单时显式失败。\",\n875:     \"feature_id\": \"F11\",\n876:     \"navigation\": \"无自动导航（首页即入口）；可进入 /categories 或归类筛选。\",\n877:     \"recovery\": \"启动或重启应用；修复后刷新首页。\",\n878:     \"success_state\": \"200 text/html；含保存表单 name=url、归类管理链接、记录列表/空状态容器；预置归类与空库不报错；health 200 JSON。\"\n879:    }\n880:   ],\n881:   \"review_rules_version\": \"atlas.current-required-contract.v1\",\n882:   \"schema\": \"atlas.contract-coverage.v1\"\n883:  },\n884:  \"features\": [\n885:   {\n886:    \"acceptance\": [\n887:     \"A01\",\n888:     \"A02\",\n889:     \"A03\"\n890:    ],\n891:    \"applicability\": \"current required\",\n892:    \"id\": \"F01\",\n893:    \"name\": \"保存收藏（URL 必填，标题/描述可选）\",\n894:    \"phase\": \"P0\",\n895:    \"reason\": \"场景流程第1-2步要求看到想记住的页面即主动保存；S02 记录新记录字段、hostname 派生及编辑时保留的身份字段，S04 记录上游表单 URL 与其他字段校验，S06 记录保存写入。标题/描述可选及本模板保存合同是目标设计，不把 S04 当作编辑回填观察。\",\n896:    \"sources\": [\n897:     \"S02\",\n898:     \"S04\",\n899:     \"S06\"\n900:    ]\n901:   },\n902:   {\n903:    \"acceptance\": [\n904:     \"A03\"\n905:    ],\n906:    \"applicability\": \"current required\",\n907:    \"id\": \"F02\",\n908:    \"name\": \"默认“未整理”与预置归类集合\",\n909:    \"phase\": \"P0\",\n910:    \"reason\": \"场景流程第3步要求未整理的链接先进入默认归类；S16/S20 提供标签筛选与聚合计数的借鉴。默认“未整理”收件区与独立归类实体是目标新设计，依据当前场景事实中的标签必填/归类限制推断及既有 case-design；不把单条列表筛选观察当作整个项目没有默认归类的证明。\",\n911:    \"sources\": [\n912:     \"S16\",\n913:     \"S20\"\n914:    ]\n915:   },\n916:   {\n917:    \"acceptance\": [\n918:     \"A04\"\n919:    ],\n920:    \"applicability\": \"current required\",\n921:    \"id\": \"F03\",\n922:    \"name\": \"归类管理（新建/重命名/删除）\",\n923:    \"phase\": \"P0\",\n924:    \"reason\": \"场景验收第3条要求可新建归类；独立归类实体及其新建、重命名、删除和持久化是目标新设计。S16/S20 记录标签筛选和聚合行为，当前场景事实与既有 case-design 的归类限制推断说明标签模型与目标归类实体的差异；不以单条筛选观察证明整个项目的能力缺失。\",\n925:    \"sources\": [\n926:     \"S16\",\n927:     \"S20\"\n928:    ]\n929:   },\n930:   {\n931:    \"acceptance\": [\n932:     \"A05\",\n933:     \"A12\"\n934:    ],\n935:    \"applicability\": \"current required\",\n936:    \"id\": \"F04\",\n937:    \"name\": \"记录在归类间移动\",\n938:    \"phase\": \"P0\",\n939:    \"reason\": \"场景验收第3条要求记录可在归类之间移动且重开后仍有效；上游检索按标签交集筛选（S16），这里把多值交集改造为单一归属迁移。\",\n940:    \"sources\": [\n941:     \"S16\"\n942:    ]\n943:   },\n944:   {\n945:    \"acceptance\": [\n946:     \"A06\"\n947:    ],\n948:    \"applicability\": \"current required\",\n949:    \"id\": \"F05\",\n950:    \"name\": \"归类浏览与条目计数\",\n951:    \"phase\": \"P0\",\n952:    \"reason\": \"场景验收第4条要求通过归类浏览找回；上游侧栏按标签聚合计数（S20、S16），改为按归类聚合与筛选。\",\n953:    \"sources\": [\n954:     \"S16\",\n955:     \"S20\"\n956:    ]\n957:   },\n958:   {\n959:    \"acceptance\": [\n960:     \"A07\"\n961:    ],\n962:    \"applicability\": \"current required\",\n963:    \"id\": \"F06\",\n964:    \"name\": \"关键字检索（标题/域名/描述）\",\n965:    \"phase\": \"P0\",\n966:    \"reason\": \"场景验收第4条要求关键字检索；上游仅匹配标题小写（S16），需扩展到域名与描述以覆盖只记得来源的场景。\",\n967:    \"sources\": [\n968:     \"S16\"\n969:    ]\n970:   },\n971:   {\n972:    \"acceptance\": [\n973:     \"A08\"\n974:    ],\n975:    \"applicability\": \"current required\",\n976:    \"id\": \"F07\",\n977:    \"name\": \"打开原始网页（URL 锚定与回跳）\",\n978:    \"phase\": \"P0\",\n979:    \"reason\": \"场景验收第2条与流程第5步要求打开记录即回到原页；S15 直接记录 Visit 更新访问计数/时间后以 window.open(item.url, _blank, noopener,noreferrer) 打开原 URL。目标保留原 URL 导航与打开的安全意图，去掉访问统计，不依赖额外工具或字段类型来源来证明打开行为。\",\n980:    \"sources\": [\n981:     \"S15\"\n982:    ]\n983:   },\n984:   {\n985:    \"acceptance\": [\n986:     \"A01\",\n987:     \"A05\",\n988:     \"A09\"\n989:    ],\n990:    \"applicability\": \"current required\",\n991:    \"id\": \"F08\",\n992:    \"name\": \"多会话持久化（跨重启保留）\",\n993:    \"phase\": \"P0\",\n994:    \"reason\": \"场景验收第1条（S01）要求跨会话持久保留；S06 记录保存/删除写入，S13 记录组件创建时从数据库载入记录到内存映射。Python 服务端 SQLite、跨服务端重启保留、事务处理与逐请求数据库查询是目标设计，不冒充上游实现；不宣称浏览器 profile 持久化、多设备同步或客户端内存映射是目标存储合同。\",\n995:    \"sources\": [\n996:     \"S01\",\n997:     \"S06\",\n998:     \"S13\"\n999:    ]\n1000:   },\n1001:   {\n1002:    \"acceptance\": [\n1003:     \"A09\"\n1004:    ],\n1005:    \"applicability\": \"current required\",\n1006:    \"id\": \"F09\",\n1007:    \"name\": \"删除与撤销恢复\",\n1008:    \"phase\": \"P0\",\n1009:    \"reason\": \"场景要求可恢复的失败；S07 记录仅归档条目可删除及 Undo 调用保存恢复，但未给出精确恢复时长。目标删除/恢复合同保持不变：去掉“仅归档可删”前置限制，以可恢复回收状态提供兜底，不从源观察推导固定秒数。\",\n1010:    \"sources\": [\n1011:     \"S07\"\n1012:    ]\n1013:   },\n1014:   {\n1015:    \"acceptance\": [\n1016:     \"A02\",\n1017:     \"A10\",\n1018:     \"A12\"\n1019:    ],\n1020:    \"applicability\": \"current required\",\n1021:    \"id\": \"F10\",\n1022:    \"name\": \"输入校验与错误合同\",\n1023:    \"phase\": \"P0\",\n1024:    \"reason\": \"S04 记录上游 Valibot 表单对 URL、标题、描述和标签的约束，S02 记录新记录保存派生 hostname。目标按既定合同使用绝对 HTTP(S) URL 解析、允许单标签 hostname、保留原始 URL 文本，并为保存与移动提供明确错误和无写入失败；这些是 adjusted 设计，不把上游点域名正则或标签必填作为目标规则。\",\n1025:    \"sources\": [\n1026:     \"S04\",\n1027:     \"S02\"\n1028:    ]\n1029:   },\n1030:   {\n1031:    \"acceptance\": [\n1032:     \"A11\"\n1033:    ],\n1034:    \"applicability\": \"current required\",\n1035:    \"id\": \"F11\",\n1036:    \"name\": \"本地应用外壳与首启（空库）\",\n1037:    \"phase\": \"P0\",\n1038:    \"reason\": \"本模板面向单用户本地工具；Python 服务端渲染的 HTML 页面与表单（POST/redirect/GET）、首启空库视图及保存—浏览—检索—打开闭环是目标交付设计，不宣称源包已经提供这些服务端行为，也不以未纳入当前来源索引的挂载入口作依据。\",\n1039:    \"sources\": []\n1040:   },\n1041:   {\n1042:    \"acceptance\": [\n1043:     \"A13\"\n1044:    ],\n1045:    \"applicability\": \"later\",\n1046:    \"id\": \"F12\",\n1047:    \"name\": \"元数据与图标增强（离线降级）\",\n1048:    \"phase\": \"P1\",\n1049:    \"reason\": \"S14 记录 Google favicon 经 images.weserv.nl 获取及失败日志，S21 记录 api.microlink.io 元数据和 images.weserv.nl logo 请求及失败处理。目标保留既定 P1 可选增强与离线降级定位，不使这些外部端点成为 P0 可用性依赖；本地 hostname 展示与增强降级属于目标设计，不把端点可用性写成已验证事实。\",\n1050:    \"sources\": [\n1051:     \"S14\",\n1052:     \"S21\"\n1053:    ]\n1054:   },\n1055:   {\n1056:    \"acceptance\": [\n1057:     \"A14\"\n1058:    ],\n1059:    \"applicability\": \"later\",\n1060:    \"id\": \"F13\",\n1061:    \"name\": \"导入/导出（浏览器书签 HTML）\",\n1062:    \"phase\": \"P1\",\n1063:    \"reason\": \"浏览器书签 HTML 导入/导出是本模板后期互操作设计选择，保留 F13/P1/A14；它是目标路线图，不构成对上游导入/导出能力存在或缺失的断言。\",\n1064:    \"sources\": []\n1065:   },\n1066:   {\n1067:    \"acceptance\": [\n1068:     \"A15\"\n1069:    ],\n1070:    \"applicability\": \"later\",\n1071:    \"id\": \"F14\",\n1072:    \"name\": \"重复链接检测\",\n1073:    \"phase\": \"P1\",\n1074:    \"reason\": \"重复链接检测是本模板后期设计选择，保留 F14/P1/A15、原 D06 以及保存/导入路径的既定目标；P0 核心用例不依赖该能力。不以列表筛选或记录类型观察证明上游完全没有去重，也不宣称已经验证其能力缺失。\",\n1075:    \"sources\": []\n1076:   },\n1077:   {\n1078:    \"acceptance\": [],\n1079:    \"applicability\": \"not applicable\",\n1080:    \"id\": \"F15\",\n1081:    \"name\": \"浏览器扩展/分享目标抓取\",\n1082:    \"phase\": null,\n1083:    \"reason\": \"场景交付为本地 Web 工具，扩展与移动分享目标不在本期范围，手工录入与打开回跳已覆盖核心旅程。\",\n1084:    \"sources\": []\n1085:   },\n1086:   {\n1087:    \"acceptance\": [],\n1088:    \"applicability\": \"not applicable\",\n1089:    \"id\": \"F16\",\n1090:    \"name\": \"多设备与云同步\",\n1091:    \"phase\": null,\n1092:    \"reason\": \"本期是单机单实例的本地库，数据在单一 SQLite 文件；跨设备同步属后期形态，不阻塞核心旅程。\",\n1093:    \"sources\": []\n1094:   },\n1095:   {\n1096:    \"acceptance\": [],\n1097:    \"applicability\": \"decision needed\",\n1098:    \"id\": \"F17\",\n1099:    \"name\": \"网页留存副本/快照\",\n1100:    \"phase\": null,\n1101:    \"reason\": \"本模板 P0 只保存 URL 引用而不保存网页副本；网页留存仍为 decision needed，须用户明确需求后再决定外部抓取与存储方案。此处说明目标范围，不据当前不可用类型来源断言上游完整能力边界。\",\n1102:    \"sources\": []\n1103:   },\n1104:   {\n1105:    \"acceptance\": [],\n1106:    \"applicability\": \"decision needed\",\n1107:    \"id\": \"F18\",\n1108:    \"name\": \"失效链接检测与修复\",\n1109:    \"phase\": null,\n1110:    \"reason\": \"链接腐坏是本类型的结构性风险，但检测需要主动外呼，外部网络在验收中禁用；先保证引用与打开回跳，是否检测待用户决定。\",\n1111:    \"sources\": []\n1112:   },\n1113:   {\n1114:    \"acceptance\": [],\n1115:    \"applicability\": \"decision needed\",\n1116:    \"id\": \"F19\",\n1117:    \"name\": \"嵌套归类与多标签并存\",\n1118:    \"phase\": null,\n1119:    \"reason\": \"场景明说“选择一个简单归类”，扁平单选加收件区已足够；嵌套/标签是成熟能力，待归类数量或交叉主题增长时再评估。\",\n1120:    \"sources\": []\n1121:   },\n1122:   {\n1123:    \"acceptance\": [],\n1124:    \"applicability\": \"not applicable\",\n1125:    \"id\": \"F20\",\n1126:    \"name\": \"置顶/归档与多排序模式\",\n1127:    \"phase\": null,\n1128:    \"reason\": \"上游置顶与归档、三种排序属书签阅读器语境（S19、S16、S03），会给编辑与删除增加前置条件，与快速保存、快速清理相冲突，故不采用。\",\n1129:    \"sources\": [\n1130:     \"S19\",\n1131:     \"S16\",\n1132:     \"S03\"\n1133:    ]\n1134:   },\n1135:   {\n1136:    \"acceptance\": [],\n1137:    \"applicability\": \"not applicable\",\n1138:    \"id\": \"F21\",\n1139:    \"name\": \"公开分享与协作库\",\n1140:    \"phase\": null,\n1141:    \"reason\": \"场景是私有个人收藏箱，分享不在核心旅程内；公开或协作需要多用户身份与权限，属不同类型定位。\",\n1142:    \"sources\": []\n1143:   },\n1144:   {\n1145:    \"acceptance\": [],\n1146:    \"applicability\": \"not applicable\",\n1147:    \"id\": \"F22\",\n1148:    \"name\": \"阅读稍后与未读标记\",\n1149:    \"phase\": null,\n1150:    \"reason\": \"场景重心是留存引用并可回跳，而非消费队列；未读标记会使产品向 Read-it-later 漂移。\",\n1151:    \"sources\": []\n1152:   },\n1153:   {\n1154:    \"acceptance\": [],\n1155:    \"applicability\": \"not applicable\",\n1156:    \"id\": \"F23\",\n1157:    \"name\": \"复制 URL 动作\",\n1158:    \"phase\": null,\n1159:    \"reason\": \"上游提供 Copy URL（S12），但本场景终点是打开原页而非分发链接，去掉可减少每条记录的操作噪音。\",\n1160:    \"sources\": [\n1161:     \"S12\"\n1162:    ]\n1163:   },\n1164:   {\n1165:    \"acceptance\": [],\n1166:    \"applicability\": \"not applicable\",\n1167:    \"id\": \"F24\",\n1168:    \"name\": \"访问计数与最近访问时间\",\n1169:    \"phase\": null,\n1170:    \"reason\": \"S15 直接记录 Visit 更新 visitCount 与 visitedAt 后打开原 URL；场景只需打开动作，目标不保留这两个访问统计字段，不再额外引用未纳入当前场景来源索引的类型定义。\",\n1171:    \"sources\": [\n1172:     \"S15\"\n1173:    ]\n1174:   }\n1175:  ],\n1176:  \"decisions\": [\n1177:   {\n1178:    \"default\": \"单选归类（bookmark.category_id 标量外键）。场景流程明确“选择一个简单归类”，单归属让移动、计数与浏览语义无歧义；未来若需多值可迁移到关联表而不丢数据。\",\n1179:    \"id\": \"D01\",\n1180:    \"impact\": \"决定数据模型（标量外键 vs 关联表）以及浏览、计数与检索的实现路径。\",\n1181:    \"question\": \"记录应归属于单一“归类”，还是允许像标签一样同时属于多个？\",\n1182:    \"status\": \"decided\",\n1183:    \"when_to_ask\": \"当真实用户反馈同一条记录必须同时属于多个主题，或需要跨主题交叉检索时再评估多标签。\"\n1184:   },\n1185:   {\n1186:    \"default\": \"落入默认“未整理”，保存始终成功。场景流程第3步要求未经整理的链接可先进入默认归类，快速保存不应打断浏览。\",\n1187:    \"id\": \"D02\",\n1188:    \"impact\": \"决定保存接口是否允许缺省 category，以及首启预置数据内容。\",\n1189:    \"question\": \"保存时不选归类，应阻止保存还是落入默认“未整理”？\",\n1190:    \"status\": \"decided\",\n1191:    \"when_to_ask\": \"当目标用户群要求强制归类（例如团队共享库）时再改为必选。\"\n1192:   },\n1193:   {\n1194:    \"default\": \"自动创建（名称大小写不敏感去重），重名则复用现有归类；保持保存流程不中断。\",\n1195:    \"id\": \"D03\",\n1196:    \"impact\": \"决定 categories 的唯一约束、写入事务边界与 409/400 的语义；HTML 归类表单与 JSON API 共用服务层，重名、非法名与默认归类保护都不得产生部分写入。\",\n1197:    \"question\": \"在保存或移动界面输入一个尚不存在的归类名，应自动创建还是报错？\",\n1198:    \"status\": \"decided\",\n1199:    \"when_to_ask\": \"当出现拼写错误导致归类碎片化的证据时，改为只允许从既有归类中选择。\"\n1200:   },\n1201:   {\n1202:    \"default\": \"软删除：记录标记 trashed_at，默认视图排除，提供撤销恢复；场景要求可恢复的失败。\",\n1203:    \"id\": \"D04\",\n1204:    \"impact\": \"决定数据模型的 trashed_at 列、默认列表过滤条件、/restore 恢复路径，以及删除归类时活动与软删记录同迁默认归类；不引入 purge 或永久删除接口。\",\n1205:    \"question\": \"删除是立即物理删除，还是软删除到可恢复区并支持短时撤销？\",\n1206:    \"status\": \"decided\",\n1207:    \"when_to_ask\": \"当用户要求彻底清除隐私数据或回收站增长需要释放空间时，再提供永久删除与清空。\"\n1208:   },\n1209:   {\n1210:    \"default\": \"本地优先：图标由域名派生本地路由，第三方元数据抓取为可选增强且失败静默降级，保证离线可保存。\",\n1211:    \"id\": \"D05\",\n1212:    \"impact\": \"决定保存流程的时延与可用性依赖，以及收藏响应中的 favicon/title 字段形态。\",\n1213:    \"question\": \"标题、描述与图标是否依赖第三方抓取服务？\",\n1214:    \"status\": \"decided\",\n1215:    \"when_to_ask\": \"当部署环境确认可访问外部服务且用户需要富预览时再启用增强。\"\n1216:   },\n1217:   {\n1218:    \"default\": \"自 P1/F14 起默认检测并返回 409 duplicate_url（附已有 id 供跳转查看），保存方显式 allow_duplicate 时可强制新增；P0 核心用例不依赖去重，软删除记录不参与判定；场景与成熟产品都倾向一址一记录。\",\n1219:    \"id\": \"D06\",\n1220:    \"impact\": \"决定服务层去重查询、allow_duplicate 语义与导入时的合并或跳过策略（不使用 url 唯一索引）。\",\n1221:    \"question\": \"同一 URL 再次保存时，阻止还是允许？\",\n1222:    \"status\": \"decided\",\n1223:    \"when_to_ask\": \"当用户明确需要对同一地址保留多个不同上下文的记录时再放宽。\"\n1224:   },\n1225:   {\n1226:    \"default\": \"标题加域名(hostname)加描述，大小写不敏感，可与归类过滤叠加；不检索正文（无抓取）。\",\n1227:    \"id\": \"D07\",\n1228:    \"impact\": \"决定查询实现与检索参数语义：category 与 q 可叠加，HTML 归类检索表单必须同时保留两者；计数与列表只统计未软删记录，移动、删除、恢复后保持一致。\",\n1229:    \"question\": \"关键字应匹配哪些字段？\",\n1230:    \"status\": \"decided\",\n1231:    \"when_to_ask\": \"当需要按网页正文全文检索时再引入抓取与索引（属后期能力）。\"\n1232:   },\n1233:   {\n1234:    \"default\": \"python-web 加 Python 3.12 标准库 http.server 加单文件 SQLite；满足离线、单用户与可独立验收，无需外部依赖。\",\n1235:    \"id\": \"D08\",\n1236:    \"impact\": \"决定交付 profile 为 python-web（Python 3.12 标准库 + SQLite + 服务端渲染 HTML），验收通过独立 HTTP 实例与真实表单提交进行。\",\n1237:    \"question\": \"采用何种运行时与持久化方式？\",\n1238:    \"status\": \"decided\",\n1239:    \"when_to_ask\": \"当需要多用户、并发写入或托管部署时再引入 Web 框架与服务端数据库。\"\n1240:   },\n1241:   {\n1242:    \"default\": \"默认无认证；交付进程在独立验收网络中监听测试者可路由的接口（`--host 0.0.0.0`），日常本机使用可绑定 127.0.0.1；不引入凭据文件，符合个人本地库的定位。\",\n1243:    \"id\": \"D09\",\n1244:    \"impact\": \"决定部署方式与验收的认证契约（验收默认不携带凭据）。\",\n1245:    \"question\": \"是否需要登录或口令？\",\n1246:    \"status\": \"decided\",\n1247:    \"when_to_ask\": \"当应用需要暴露到局域网或公网时，必须加入认证，否则只允许本机绑定。\"\n1248:   },\n1249:   {\n1250:    \"default\": \"Netscape 浏览器书签 HTML（本类型的交换约定），归类映射为文件夹或标签字段。\",\n1251:    \"id\": \"D10\",\n1252:    \"impact\": \"决定 P1 导入/导出的解析与生成实现。\",\n1253:    \"question\": \"导入/导出采用什么格式？\",\n1254:    \"status\": \"decided\",\n1255:    \"when_to_ask\": \"当需要与某个具体产品双向同步时再适配其专有格式。\"\n1256:   },\n1257:   {\n1258:    \"default\": \"P0 不做：本地单实例，数据在单一 SQLite 文件；跨设备属后期能力。\",\n1259:    \"id\": \"D11\",\n1260:    \"impact\": \"影响运行形态与数据归属，不阻塞 P0 核心旅程。\",\n1261:    \"question\": \"是否提供云同步或多用户共享？\",\n1262:    \"status\": \"deferred\",\n1263:    \"when_to_ask\": \"当用户明确需要在多设备访问同一库时再设计同步或托管。\"\n1264:   },\n1265:   {\n1266:    \"default\": \"P0 使用扁平单选归类加“未整理”收件区；嵌套与标签属成熟能力，按需在后期启用。\",\n1267:    \"id\": \"D12\",\n1268:    \"impact\": \"影响侧栏结构与检索实现，可后续迁移而不破坏现有数据。\",\n1269:    \"question\": \"归类是否需要嵌套层级，或与标签并存？\",\n1270:    \"status\": \"deferred\",\n1271:    \"when_to_ask\": \"当扁平归类数量增长到难以浏览，或需要交叉主题时。\"\n1272:   },\n1273:   {\n1274:    \"default\": \"本期不做：抓取与归档在离线验收下不可验证；先保证引用记录与打开回跳。\",\n1275:    \"id\": \"D13\",\n1276:    \"impact\": \"涉及外部抓取与存储扩展，属后期可选能力，不纳入 P0/P1 验收。\",\n1277:    \"question\": \"是否需要保存网页副本并检测失效链接？\",\n1278:    \"status\": \"open\",\n1279:    \"when_to_ask\": \"当用户明确要求内容留存，或需要清理死链时再评估。\"\n1280:   }\n1281:  ],\n1282:  \"acceptance\": [\n1283:   {\n1284:    \"features\": [\n1285:     \"F01\",\n1286:     \"F08\"\n1287:    ],\n1288:    \"goal\": \"保存一条链接后，同进程与重启后的新进程都能读到该记录，且 id 与内容稳定。\",\n1289:    \"id\": \"A01\",\n1290:    \"implementation\": \"acceptance/p0_library.py\",\n1291:    \"phase\": \"P0\",\n1292:    \"status\": \"not_run\",\n1293:    \"type\": \"positive\"\n1294:   },\n1295:   {\n1296:    \"features\": [\n1297:     \"F01\",\n1298:     \"F10\"\n1299:    ],\n[Output truncated. Continue reading with offset: 1300]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file source/r6-baseline/AUTHORED_FIELDS.json, lines 1-1299\n1: {\n2:  \"phases\": [\n3:   {\n4:    \"acceptance\": [\n5:     \"A01\",\n6:     \"A02\",\n7:     \"A03\",\n8:     \"A04\",\n9:     \"A05\",\n10:     \"A06\",\n11:     \"A07\",\n12:     \"A08\",\n13:     \"A09\",\n14:     \"A10\",\n15:     \"A11\",\n16:     \"A12\"\n17:    ],\n18:    \"features\": [\n19:     \"F01\",\n20:     \"F02\",\n21:     \"F03\",\n22:     \"F04\",\n23:     \"F05\",\n24:     \"F06\",\n25:     \"F07\",\n26:     \"F08\",\n27:     \"F09\",\n28:     \"F10\",\n29:     \"F11\"\n30:    ],\n31:    \"goal\": \"用户可保存链接（可选归类或落入未整理）、按归类或关键字找回、打开原页、清理并撤销，且全部数据跨会话与重启保留，非法输入得到可恢复的明确错误。\",\n32:    \"id\": \"P0\",\n33:    \"status\": \"not implemented\",\n34:    \"title\": \"个人收藏箱核心旅程\"\n35:   },\n36:   {\n37:    \"acceptance\": [\n38:     \"A13\",\n39:     \"A14\",\n40:     \"A15\"\n41:    ],\n42:    \"features\": [\n43:     \"F12\",\n44:     \"F13\",\n45:     \"F14\"\n46:    ],\n47:    \"goal\": \"在离线可用的前提下增强记录可辨识度（本地派生图标、外部抓取仅作增强），并支持浏览器书签格式的导入导出与重复链接检测，用于长期库维护。\",\n48:    \"id\": \"P1\",\n49:    \"status\": \"not implemented\",\n50:    \"title\": \"成熟增强：元数据、互操作与库清理\"\n51:   }\n52:  ],\n53:  \"architecture_markdown\": \"# 架构与契约\\n\\n## 默认技术栈与理由\\n\\n- 交付 profile：python-web。Python 3.12 标准库（http.server、sqlite3、urllib、json、html.parser），零第三方依赖；服务端渲染 HTML 表单，JSON API 与 HTML 适配器共用同一服务层。\\n- 备选 Flask/FastAPI 需安装依赖；Node + IndexedDB/SPA 需 npm/浏览器工具且把数据放在浏览器 profile。二者与离线、可独立验收、单用户本地库的约束冲突，故不采用。\\n- 数据文件位于应用 `--data-dir/bookmarks.sqlite3`；验收的每实例隔离目录由测试适配器创建，测试者 `--data-dir` 根目录不是应用数据库。\\n- 单用户、本地优先；无认证、无云同步。日常绑定 127.0.0.1；仅隔离验收网络使用 0.0.0.0。\\n\\n## 数据模型（SQLite）\\n\\n- `schema_meta(version INTEGER)`：迁移版本单行。启动时在一个事务内创建/升级 schema，v1 建表并写入预置归类；版本演进只通过事务化迁移，不回退、不依赖客户端存储。\\n- `categories(id TEXT PRIMARY KEY, name TEXT NOT NULL UNIQUE COLLATE NOCASE, is_default INTEGER NOT NULL DEFAULT 0, position INTEGER NOT NULL, created_at INTEGER NOT NULL)`：首启预置「未整理」(is_default=1)、「待购」、「家居改造」、「以后看看」。\\n- `bookmarks(id TEXT PRIMARY KEY, url TEXT NOT NULL, hostname TEXT NOT NULL, title TEXT NULL, description TEXT NULL, category_id TEXT NOT NULL REFERENCES categories(id), favicon_url TEXT NULL, created_at INTEGER NOT NULL, updated_at INTEGER NOT NULL, trashed_at INTEGER NULL)`。\\n- 索引：category_id、created_at、hostname；url 不设唯一索引。P1/F14 的重复检测由服务层查询活动记录完成；P0 不启用重复拒绝。\\n- trashed_at 为 NULL 表示活动记录；非 NULL 为软删除。默认列表与计数只统计 trashed_at IS NULL；恢复清空 trashed_at。删除归类在单一事务内把该归类下的活动记录与软删除记录都改到默认归类，因此恢复不会产生无归类记录。\\n- 排序固定为 created_at DESC、id ASC；category 与 q 只作请求参数，不落库。\\n\\n## URL 策略\\n\\n- 记录 URL 必须是绝对、可解析的 HTTP(S) URL，且 hostname 有效且非空。单标签主机（如 http://localhost）与 IP 字面量均有效；不做 DNS 查询、可达性检查或目标页抓取。\\n- 保存与打开都保留用户提交的原始字符串（不补斜杠、不改大小写、不重写路径）；hostname 由解析结果派生。若 PATCH 更新 URL，必须用新 URL 重新派生 hostname。\\n- 拒绝：缺少 scheme、非 http/https、缺少/非法 hostname、无法解析的字符串；返回 400 invalid_url 且不写入。\\n- 上游 S04 记录点域名正则限制，S02 记录新记录包含派生 hostname；这些是固定来源观察。target 的绝对 HTTP(S) URL 解析、允许单标签 hostname 与保留原始 URL 文本，是本模板的 adjusted 设计，采用上述解析策略。\\n- 保存、打开、抓取三者分离：P0 保存与列表均不请求目标页；打开只产生浏览器导航或 /go 302。\\n\\n## API、错误与状态合同\\n\\n- `GET /api/health` → 200 JSON，含就绪与 schema 版本。\\n- `GET /api/categories` → 200 数组，每项 id、name、count、is_default；count 只计活动记录。\\n- `POST /api/categories` name ... (line truncated to 2000 chars)\n54:  \"roles\": [\n55:   {\n56:    \"id\": \"R01\",\n57:    \"name\": \"收藏者（个人用户）\",\n58:    \"responsibility\": \"在浏览时主动保存外部网页链接，选择或新建简单归类、把未整理的链接移动到合适归类、按归类或关键字找回、打开记录回到原页，并清理误存条目。\"\n59:   },\n60:   {\n61:    \"id\": \"R02\",\n62:    \"name\": \"本地收藏应用（服务端与页面外壳）\",\n63:    \"responsibility\": \"校验录入、派生域名、持久化收藏与归类、提供保存/浏览/检索/打开/恢复接口，并在离线条件下保持可用。\"\n64:   },\n65:   {\n66:    \"id\": \"R03\",\n67:    \"name\": \"独立验收执行者\",\n68:    \"responsibility\": \"以 URL 与 CLI 参数驱动真实目标，执行正负向行为断言、重启持久化验证与错误恢复验证，不修改应用、不自报运行结果。\"\n69:   }\n70:  ],\n71:  \"title\": \"生活待购与灵感收藏夹\",\n72:  \"limits\": [\n73:   \"不实现云同步、多用户共享或托管部署（D11、F16、F21）。\",\n74:   \"不保存网页快照、不做正文全文检索、不做失效链接检测（F17、F18、D13）。\",\n75:   \"不引入置顶/归档、多排序模式、复制 URL 与访问计数（F20、F23、F24）。\",\n76:   \"归类为扁平单选，不支持嵌套层级或多标签并存（F19、D01）。\",\n77:   \"第三方元数据与图标抓取未验证可达性，仅作可选增强且失败静默降级（F12、D05）。\",\n78:   \"验收不携带认证凭据；若目标要求认证，验收必须显式报告基础设施未就绪而非跳过或通过（D09）。\",\n79:   \"不设置未经验证的性能或成本目标。\"\n80:  ],\n81:  \"contract_coverage\": {\n82:   \"error_contract\": {\n83:    \"branches\": [\n84:     {\n85:      \"acceptance_ids\": [\n86:       \"A04\"\n87:      ],\n88:      \"code\": \"invalid_name\",\n89:      \"feature_ids\": [\n90:       \"F03\"\n91:      ],\n92:      \"field\": \"name\",\n93:      \"id\": \"html.category_create.name.omitted\",\n94:      \"implementation\": \"acceptance/p0_organize.py\",\n95:      \"operation\": \"category_create\",\n96:      \"response\": \"form-error and submitted values retained\",\n97:      \"sta