:        \"operation\": \"bookmark_move\",\n1967:        \"response\": \"error.code/message/field\",\n1968:        \"status\": 400,\n1969:        \"transport\": \"json\",\n1970:        \"value_kind\": \"null\",\n1971:        \"write_effect\": \"none\"\n1972:       }\n1973:      ],\n1974:      \"schema\": \"atlas.bookmark-error-contract.v2\"\n1975:     },\n1976:     \"features\": [\n1977:      {\n1978:       \"acceptance_ids\": [\n1979:        \"A01\",\n1980:        \"A02\",\n1981:        \"A03\",\n1982:        \"A12\"\n1983:       ],\n1984:       \"action\": \"填写原始 URL，可选标题/描述，选择已有归类、留为默认「未整理」或输入新归类名并提交。\",\n1985:       \"design_basis\": \"场景 workflow 1–2 与验收 1/2：用户主动保存外部网页链接，记录以 URL 锚定并持久保留。\",\n1986:       \"entry\": \"首页 GET / 的保存表单 form[action=/bookmarks/new]，字段 url、title、description、category。\",\n1987:       \"error_branch_ids\": [\n1988:        \"html.bookmark_save.category.empty\",\n1989:        \"html.bookmark_save.category.whitespace\",\n1990:        \"html.bookmark_save.category.overlong_121\",\n1991:        \"json.bookmark_save.category.empty\",\n1992:        \"json.bookmark_save.category.whitespace\",\n1993:        \"json.bookmark_save.category.overlong_121\"\n1994:       ],\n1995:       \"failure\": \"非法 URL 返回 400 invalid_url，非法归类返回 400 invalid_category；HTML 同页显示 [data-testid=form-error]，不写入。\",\n1996:       \"feature_id\": \"F01\",\n1997:       \"navigation\": \"成功后 303 到 /?category=<归类> 或 /，浏览器显示新记录行。\",\n1998:       \"recovery\": \"失败页保留已填 url/title/description/category，用户修正后重新提交；也可返回列表。\",\n1999:       \"success_state\": \"303 返回首页，新记录出现在所选归类，GET /api/bookmarks/{id} 返回同一原始 URL；SQLite 行已持久化。\"\n2000:      },\n2001:      {\n2002:       \"acceptance_ids\": [\n2003:        \"A03\"\n2004:       ],\n2005:       \"action\": \"不另选归类直接保存；首启查看预置归类。\",\n2006:       \"design_basis\": \"场景 workflow 3：未经整理的链接先进入默认归类，之后再移动；成熟产品普遍提供未被整理收件区。\",\n2007:       \"entry\": \"首页保存表单的 category 字段（默认「未整理」）与侧栏/归类页的预置归类列表。\",\n2008:       \"failure\": \"默认归类缺失或写入失败时返回明确错误页或 JSON 错误，不伪装成功。\",\n2009:       \"feature_id\": \"F02\",\n2010:       \"navigation\": \"303 到首页或未整理归类视图。\",\n2011:       \"recovery\": \"重试保存；仅首次初始化数据库时事务创建四个预置归类。后续启动保留已持久化的分类变更，不复活用户已删除或重命名的非默认分类；默认「未整理」仍遵守既有保护与初始化合同。\",\n2012:       \"success_state\": \"记录的 category_id 为默认「未整理」，可在 /?category=未整理 看到；首次初始化时“未整理”“待购”“家居改造”“以后看看”均可见，之后显示真实持久化的用户分类状态。\"\n2013:      },\n2014:      {\n2015:       \"acceptance_ids\": [\n2016:        \"A04\"\n2017:       ],\n2018:       \"action\": \"在真实表单提交 name 新建/重命名，提交 category_id 删除；删除默认归类被拒绝。\",\n2019:       \"design_basis\": \"场景验收 3 与 workflow 2：用户可新建归类并把记录放入合适位置；源包没有 collections，属目标新设计。\",\n2020:       \"entry\": \"首页 a[data-testid=category-manager] 进入 /categories；该页含 category-create-form、category-rename-form、category-delete-form。\",\n2021:       \"error_branch_ids\": [\n2022:        \"html.category_create.name.omitted\",\n2023:        \"html.category_create.name.empty\",\n2024:        \"html.category_create.name.whitespace\",\n2025:        \"html.category_create.name.overlong_121\",\n2026:        \"html.category_rename.name.omitted\",\n2027:        \"html.category_rename.name.empty\",\n2028:        \"html.category_rename.name.whitespace\",\n2029:        \"html.category_rename.name.overlong_121\",\n2030:        \"json.category_create.name.omitted\",\n2031:        \"json.category_create.name.empty\",\n2032:        \"json.category_create.name.whitespace\",\n2033:        \"json.category_create.name.overlong_121\",\n2034:        \"json.category_create.name.null\",\n2035:        \"json.category_rename.name.omitted\",\n2036:        \"json.category_rename.name.empty\",\n2037:        \"json.category_rename.name.whitespace\",\n2038:        \"json.category_rename.name.overlong_121\",\n2039:        \"json.category_rename.name.null\"\n2040:       ],\n2041:       \"failure\": \"重名 409 duplicate_category、空名/超长 400 invalid_name、默认归类 400 protected_category；页面显示 form-error 且数据不变。\",\n2042:       \"feature_id\": \"F03\",\n2043:       \"navigation\": \"创建/重命名/删除成功后 303 到 /categories。\",\n2044:       \"recovery\": \"保留已填 name/category_id 并允许改正或选择其他归类；可返回 /categories 重试。\",\n2045:       \"success_state\": \"303 到 /categories；新建/重命名可见且计数正确；删除归类后其活动与软删除记录都迁回「未整理」，软删记录仍可恢复。\"\n2046:      },\n2047:      {\n2048:       \"acceptance_ids\": [\n2049:        \"A05\",\n2050:        \"A12\"\n2051:       ],\n2052:       \"action\": \"选择目标归类（API 归类 ID）并提交；HTML 适配器把 ID 翻译为归类名后调用现有 move 服务。\",\n2053:       \"design_basis\": \"场景验收 3 与 workflow 3：记录可在归类之间移动，重新打开后仍保持新归属。\",\n2054:       \"entry\": \"每条 tr[data-testid=record-row] 内的 form[data-testid=record-move-form]，含 input record_id 与 select name=category_id。\",\n2055:       \"error_branch_ids\": [\n2056:        \"html.bookmark_move.category_id.omitted\",\n2057:        \"html.bookmark_move.category_id.empty\",\n2058:        \"html.bookmark_move.category_id.unknown_id\",\n2059:        \"json.bookmark_move.category.empty\",\n2060:        \"json.bookmark_move.category.whitespace\",\n2061:        \"json.bookmark_move.category.overlong_121\",\n2062:        \"json.bookmark_move.category.omitted\",\n2063:        \"json.bookmark_move.category.null\"\n2064:       ],\n2065:       \"failure\": \"空/超长/非法归类 400 invalid_category，未知 record_id 404 not_found；不移动、不写入。\",\n2066:       \"feature_id\": \"F04\",\n2067:       \"navigation\": \"成功后 303 到 /?category=<目标归类> 或来源视图。\",\n2068:       \"recovery\": \"保留选择并显示 form-error；用户改选有效归类或返回列表重试。\",\n2069:       \"success_state\": \"303 回列表；记录离开原归类并出现在目标归类，JSON 的 category 与持久化结果一致。\"\n2070:      },\n2071:      {\n2072:       \"acceptance_ids\": [\n2073:        \"A06\"\n2074:       ],\n2075:       \"action\": \"点击归类链接或从搜索表单选择归类并查看列表。\",\n2076:       \"design_basis\": \"场景验收 4：用户通过归类浏览找回记录；来源标签计数被调整为按归类聚合。\",\n2077:       \"entry\": \"首页侧栏 [data-testid=category-count][data-category-id] 与归类链接；/categories 同显计数；GET /?category=<name>。\",\n2078:       \"failure\": \"未知归类返回空结果而非 5xx；计数查询失败显示错误页。\",\n2079:       \"feature_id\": \"F05\",\n2080:       \"navigation\": \"GET /?category=... 或 GET /categories；无记录时显示明确空状态。\",\n2081:       \"recovery\": \"选择其他归类或清空筛选。\",\n2082:       \"success_state\": \"页面只列该归类活动记录；HTML count 与 JSON count 都等于活动（未软删）记录数；移动、删除、恢复后仍一致。\"\n2083:      },\n2084:      {\n2085:       \"acceptance_ids\": [\n2086:        \"A07\"\n2087:       ],\n2088:       \"action\": \"选择归类、输入关键字并提交。\",\n2089:       \"design_basis\": \"场景验收 4：用户凭记得的关键字找回已存链接；来源仅搜标题，目标扩展到可识别来源的字段。\",\n2090:       \"entry\": \"首页 form[data-testid=category-search-form]，字段 category（归类名）与 q；action 为 GET /。\",\n2091:       \"failure\": \"无匹配不是错误（200 + 空结果）；非法请求返回可读错误且不写入。\",\n2092:       \"feature_id\": \"F06\",\n2093:       \"navigation\": \"GET /?category=...&q=...，同一页面更新结果。\",\n2094:       \"recovery\": \"修改 q 或切换归类重新提交；清空 q 恢复归类浏览。\",\n2095:       \"success_state\": \"URL 与表单保留 category 与 q；页面显示所选归类、保留查询和匹配行；同一关键字在两个归类分别命中各自记录；无匹配显示明确空结果；JSON 返回匹配集。\"\n2096:      },\n2097:      {\n2098:       \"acceptance_ids\": [\n2099:        \"A08\"\n2100:       ],\n2101:       \"action\": \"用户点击打开链接。\",\n2102:       \"design_basis\": \"场景验收 2 与 workflow 5：打开记录即回到保存时的外部网页，库只保证引用而非内容。\",\n2103:       \"entry\": \"记录行 a[data-testid=record-open-link] 与 GET /go/{id}。\",\n2104:       \"failure\": \"未知 id 404 not_found；目标不可达不影响库中记录可读。\",\n2105:       \"feature_id\": \"F07\",\n2106:       \"navigation\": \"浏览器导航到原始 URL（新标签）；服务端只发 302。\",\n2107:       \"recovery\": \"返回收藏列表选择其他记录；如 URL 有误，可由现有 PATCH API 更新并重算 hostname。\",\n2108:       \"success_state\": \"链接 href 恰为保存时原始 URL，target=_blank、rel 含 noopener；GET /go/{id} 302 Location 为同一字符串；P0 不请求目标页。\"\n2109:      },\n2110:      {\n2111:       \"acceptance_ids\": [\n2112:        \"A01\",\n2113:        \"A05\",\n2114:        \"A09\"\n2115:       ],\n2116:       \"action\": \"执行真实写操作，停止应用进程，再以同一实例目录重启并读取。\",\n2117:       \"design_basis\": \"场景验收 1：主动保存的链接在多次会话之间持久保留；目标以 SQLite 实现本地单用户持久化。\",\n2118:       \"entry\": \"保存、移动、删除/恢复等写操作后重新请求页面；重启适配器从同一 app_root 与实例数据目录启动。\",\n2119:       \"failure\": \"数据库不可写或损坏时返回明确 5xx 错误页而非成功假象；事务回滚保持旧状态。\",\n2120:       \"feature_id\": \"F08\",\n2121:       \"navigation\": \"无自动导航；下次 GET / 读取持久状态。\",\n2122:       \"recovery\": \"恢复可写数据目录后重试；重启应用重新初始化 schema。\",\n2123:       \"success_state\": \"重启后 id、原始 URL、标题、描述、归类与 trashed 状态与写入后一致；HTML 与 JSON 都来自 SQLite。\"\n2124:      },\n2125:      {\n2126:       \"acceptance_ids\": [\n2127:        \"A09\"\n2128:       ],\n2129:       \"action\": \"提交 record_id 软删除；在回收站提交 record_id 恢复。\",\n2130:       \"design_basis\": \"场景要求可恢复的失败；来源仅有归档记录的瞬时 Undo，目标改为显式软删除与恢复。\",\n2131:       \"entry\": \"记录行 form[data-testid=record-delete-form]；GET /?trash=1 的软删记录行 form[data-testid=record-restore-form]。\",\n2132:       \"failure\": \"未知 record_id 404 not_found；失败不改变 trashed_at，不产生 5xx。\",\n2133:       \"feature_id\": \"F09\",\n2134:       \"navigation\": \"删除成功 303 到 /?trash=1；恢复成功 303 到恢复后归类。\",\n2135:       \"recovery\": \"回收站提供可提交的恢复表单；失败可重试或返回列表。\",\n2136:       \"success_state\": \"默认视图与计数排除软删记录，回收站仍显示；恢复后原始字段与归类回归并重新可见；归类删除后软删记录仍在「未整理」可恢复。\"\n2137:      },\n2138:      {\n2139:       \"acceptance_ids\": [\n2140:        \"A02\",\n2141:        \"A10\",\n2142:        \"A12\"\n2143:       ],\n2144:       \"action\": \"提交非法 URL、空/超长/非法归类、畸形 JSON 或未知 ID。\",\n2145:       \"design_basis\": \"场景要求非法输入可恢复；源表单校验被调整为服务端 HTML 表单与 JSON API 共用的显式错误合同。\",\n2146:       \"entry\": \"所有 HTML 表单（保存、归类、移动、删除、恢复、搜索）与 JSON API 端点。\",\n2147:       \"error_branch_ids\": [\n2148:        \"html.bookmark_save.category.empty\",\n2149:        \"html.bookmark_save.category.whitespace\",\n2150:        \"html.bookmark_save.category.overlong_121\",\n2151:        \"html.bookmark_move.category_id.omitted\",\n2152:        \"html.bookmark_move.category_id.empty\",\n2153:        \"html.bookmark_move.category_id.unknown_id\",\n2154:        \"json.bookmark_save.category.empty\",\n2155:        \"json.bookmark_save.category.whitespace\",\n2156:        \"json.bookmark_save.category.overlong_121\",\n2157:        \"json.bookmark_move.category.empty\",\n2158:        \"json.bookmark_move.category.whitespace\",\n2159:        \"json.bookmark_move.category.overlong_121\",\n2160:        \"json.bookmark_move.category.omitted\",\n2161:        \"json.bookmark_move.category.null\"\n2162:       ],\n2163:       \"failure\": \"出现 5xx、静默写入或不可恢复的错误页即视为失败。\",\n2164:       \"feature_id\": \"F10\",\n2165:       \"navigation\": \"HTML 错误留在当前表单页并保留输入；JSON 无导航。\",\n2166:       \"recovery\": \"修正字段后重新提交；失败页保留可运行的表单或返回链接。\",\n2167:       \"success_state\": \"错误路径本身成功执行：JSON 返回 400/404/409 与结构化错误码，HTML 返回 400/409 与 form-error；畸形 JSON 为 bad_request；均无 5xx、无写入。\"\n2168:      },\n2169:      {\n2170:       \"acceptance_ids\": [\n2171:        \"A11\"\n2172:       ],\n2173:       \"action\": \"首启或空库时打开首页。\",\n2174:       \"design_basis\": \"场景是单用户本地工具，需要可打开的应用入口；目标采用 Python 服务端渲染外壳而非来源 SPA。\",\n2175:       \"entry\": \"GET / 与 GET /api/health。\",\n2176:       \"failure\": \"健康检查非 200/非 JSON、首页 5xx 或缺少表单时显式失败。\",\n2177:       \"feature_id\": \"F11\",\n2178:       \"navigation\": \"无自动导航（首页即入口）；可进入 /categories 或归类筛选。\",\n2179:       \"recovery\": \"启动或重启应用；修复后刷新首页。\",\n2180:       \"success_state\": \"200 text/html；含保存表单 name=url、归类管理链接、记录列表/空状态容器；预置归类与空库不报错；health 200 JSON。 A11 自身区分 base_url 当前部署入口与绑定同一冻结 app_root 的 fresh 新实例，后者独立证明首启预置及未过滤真空库；不宣称 base_url 被清空或同容器重启。\"\n2181:      }\n2182:     ],\n2183:     \"review_rules_version\": \"atlas.current-required-contract.v1\",\n2184:     \"schema\": \"atlas.contract-coverage.v1\"\n2185:    },\n2186:    \"features\": [\n2187:     {\n2188:      \"acceptance\": [\n2189:       \"A01\",\n2190:       \"A02\",\n2191:       \"A03\",\n2192:       \"A12\"\n2193:      ],\n2194:      \"applicability\": \"current required\",\n2195:      \"id\": \"F01\",\n2196:      \"name\": \"保存收藏（URL 必填，标题/描述可选）\",\n2197:      \"phase\": \"P0\",\n2198:      \"reason\": \"场景流程第1-2步要求看到想记住的页面即主动保存；S02 记录新记录字段、hostname 派生及编辑时保留的身份字段，S04 记录上游表单 URL 与其他字段校验，S06 记录保存写入。标题/描述可选及本模板保存合同是目标设计，不把 S04 当作编辑回填观察。\",\n2199:      \"sources\": [\n2200:       \"S02\",\n2201:       \"S04\",\n2202:       \"S06\"\n2203:      ]\n2204:     },\n2205:     {\n2206:      \"acceptance\": [\n2207:       \"A03\"\n2208:      ],\n2209:      \"applicability\": \"current required\",\n2210:      \"id\": \"F02\",\n2211:      \"name\": \"默认“未整理”与预置归类集合\",\n2212:      \"phase\": \"P0\",\n2213:      \"reason\": \"场景流程第3步要求未整理的链接先进入默认归类；S16/S20 提供标签筛选与聚合计数的借鉴。默认“未整理”收件区与独立归类实体是目标新设计，依据当前场景事实中的标签必填/归类限制推断及既有 case-design；不把单条列表筛选观察当作整个项目没有默认归类的证明。\",\n2214:      \"sources\": [\n2215:       \"S16\",\n2216:       \"S20\"\n2217:      ]\n2218:     },\n2219:     {\n2220:      \"acceptance\": [\n2221:       \"A04\"\n2222:      ],\n2223:      \"applicability\": \"current required\",\n2224:      \"id\": \"F03\",\n2225:      \"name\": \"归类管理（新建/重命名/删除）\",\n2226:      \"phase\": \"P0\",\n2227:      \"reason\": \"场景验收第3条要求可新建归类；独立归类实体及其新建、重命名、删除和持久化是目标新设计。S16/S20 记录标签筛选和聚合行为，当前场景事实与既有 case-design 的归类限制推断说明标签模型与目标归类实体的差异；不以单条筛选观察证明整个项目的能力缺失。\",\n2228:      \"sources\": [\n2229:       \"S16\",\n2230:       \"S20\"\n2231:      ]\n2232:     },\n2233:     {\n2234:      \"acceptance\": [\n2235:       \"A05\",\n2236:       \"A12\"\n2237:      ],\n2238:      \"applicability\": \"current required\",\n2239:      \"id\": \"F04\",\n2240:      \"name\": \"记录在归类间移动\",\n2241:      \"phase\": \"P0\",\n2242:      \"reason\": \"场景验收第3条要求记录可在归类之间移动且重开后仍有效；上游检索按标签交集筛选（S16），这里把多值交集改造为单一归属迁移。\",\n2243:      \"sources\": [\n2244:       \"S16\"\n2245:      ]\n2246:     },\n2247:     {\n2248:      \"acceptance\": [\n2249:       \"A06\"\n2250:      ],\n2251:      \"applicability\": \"current required\",\n2252:      \"id\": \"F05\",\n2253:      \"name\": \"归类浏览与条目计数\",\n2254:      \"phase\": \"P0\",\n2255:      \"reason\": \"场景验收第4条要求通过归类浏览找回；上游侧栏按标签聚合计数（S20、S16），改为按归类聚合与筛选。\",\n2256:      \"sources\": [\n2257:       \"S16\",\n2258:       \"S20\"\n2259:      ]\n2260:     },\n2261:     {\n2262:      \"acceptance\": [\n2263:       \"A07\"\n2264:      ],\n2265:      \"applicability\": \"current required\",\n2266:      \"id\": \"F06\",\n2267:      \"name\": \"关键字检索（标题/域名/描述）\",\n2268:      \"phase\": \"P0\",\n2269:      \"reason\": \"场景验收第4条要求关键字检索；上游仅匹配标题小写（S16），需扩展到域名与描述以覆盖只记得来源的场景。\",\n2270:      \"sources\": [\n2271:       \"S16\"\n2272:      ]\n2273:     },\n2274:     {\n2275:      \"acceptance\": [\n2276:       \"A08\"\n2277:      ],\n2278:      \"applicability\": \"current required\",\n2279:      \"id\": \"F07\",\n2280:      \"name\": \"打开原始网页（URL 锚定与回跳）\",\n2281:      \"phase\": \"P0\",\n2282:      \"reason\": \"场景验收第2条与流程第5步要求打开记录即回到原页；S15 直接记录 Visit 更新访问计数/时间后以 window.open(item.url, _blank, noopener,noreferrer) 打开原 URL。目标保留原 URL 导航与打开的安全意图，去掉访问统计，不依赖额外工具或字段类型来源来证明打开行为。\",\n2283:      \"sources\": [\n2284:       \"S15\"\n2285:      ]\n2286:     },\n2287:     {\n2288:      \"acceptance\": [\n2289:       \"A01\",\n2290:       \"A05\",\n2291:       \"A09\"\n2292:      ],\n2293:      \"applicability\": \"current required\",\n2294:      \"id\": \"F08\",\n2295:      \"name\": \"多会话持久化（跨重启保留）\",\n2296:      \"phase\": \"P0\",\n2297:      \"reason\": \"场景验收第1条（S01）要求跨会话持久保留；S06 记录保存/删除写入，S13 记录组件创建时从数据库载入记录到内存映射。Python 服务端 SQLite、跨服务端重启保留、事务处理与逐请求数据库查询是目标设计，不冒充上游实现；不宣称浏览器 profile 持久化、多设备同步或客户端内存映射是目标存储合同。\",\n2298:      \"sources\": [\n2299:       \"S01\",\n2300:       \"S06\",\n2301:       \"S13\"\n2302:      ]\n2303:     },\n2304:     {\n2305:      \"acceptance\": [\n2306:       \"A09\"\n2307:      ],\n2308:      \"applicability\": \"current required\",\n2309:      \"id\": \"F09\",\n2310:      \"name\": \"删除与撤销恢复\",\n2311:      \"phase\": \"P0\",\n2312:      \"reason\": \"场景要求可恢复的失败；S07 记录仅归档条目可删除及 Undo 调用保存恢复，但未给出精确恢复时长。目标删除/恢复合同保持不变：去掉“仅归档可删”前置限制，以可恢复回收状态提供兜底，不从源观察推导固定秒数。\",\n2313:      \"sources\": [\n2314:       \"S07\"\n2315:      ]\n2316:     },\n2317:     {\n2318:      \"acceptance\": [\n2319:       \"A02\",\n2320:       \"A10\",\n2321:       \"A12\"\n2322:      ],\n2323:      \"applicability\": \"current required\",\n2324:      \"id\": \"F10\",\n2325:      \"name\": \"输入校验与错误合同\",\n2326:      \"phase\": \"P0\",\n2327:      \"reason\": \"S04 记录上游 Valibot 表单对 URL、标题、描述和标签的约束，S02 记录新记录保存派生 hostname。目标按既定合同使用绝对 HTTP(S) URL 解析、允许单标签 hostname、保留原始 URL 文本，并为保存与移动提供明确错误和无写入失败；这些是 adjusted 设计，不把上游点域名正则或标签必填作为目标规则。\",\n2328:      \"sources\": [\n2329:       \"S04\",\n2330:       \"S02\"\n2331:      ]\n2332:     },\n2333:     {\n2334:      \"acceptance\": [\n2335:       \"A11\"\n2336:      ],\n2337:      \"applicability\": \"current required\",\n2338:      \"id\": \"F11\",\n2339:      \"name\": \"本地应用外壳与首启（空库）\",\n2340:      \"phase\": \"P0\",\n2341:      \"reason\": \"本模板面向单用户本地工具；Python 服务端渲染的 HTML 页面与表单（POST/redirect/GET）、首启空库视图及保存—浏览—检索—打开闭环是目标交付设计，不宣称源包已经提供这些服务端行为，也不以未纳入当前来源索引的挂载入口作依据。\",\n2342:      \"sources\": []\n2343:     },\n2344:     {\n2345:      \"acceptance\": [\n2346:       \"A13\"\n2347:      ],\n2348:      \"applicability\": \"later\",\n2349:      \"id\": \"F12\",\n2350:      \"name\": \"元数据与图标增强（离线降级）\",\n2351:      \"phase\": \"P1\",\n2352:      \"reason\": \"S14 记录 Google favicon 经 images.weserv.nl 获取及失败日志，S21 记录 api.microlink.io 元数据和 images.weserv.nl logo 请求及失败处理。目标保留既定 P1 可选增强与离线降级定位，不使这些外部端点成为 P0 可用性依赖；本地 hostname 展示与增强降级属于目标设计，不把端点可用性写成已验证事实。\",\n2353:      \"sources\": [\n2354:       \"S14\",\n2355:       \"S21\"\n2356:      ]\n2357:     },\n2358:     {\n2359:      \"acceptance\": [\n2360:       \"A14\"\n2361:      ],\n2362:      \"applicability\": \"later\",\n2363:      \"id\": \"F13\",\n2364:      \"name\": \"导入/导出（浏览器书签 HTML）\",\n2365:      \"phase\": \"P1\",\n2366:      \"reason\": \"浏览器书签 HTML 导入/导出是本模板后期互操作设计选择，保留 F13/P1/A14；它是目标路线图，不构成对上游导入/导出能力存在或缺失的断言。\",\n2367:      \"sources\": []\n2368:     },\n2369:     {\n2370:      \"acceptance\": [\n2371:       \"A15\"\n2372:      ],\n2373:      \"applicability\": \"later\",\n2374:      \"id\": \"F14\",\n2375:      \"name\": \"重复链接检测\",\n2376:      \"phase\": \"P1\",\n2377:      \"reason\": \"重复链接检测是本模板后期设计选择，保留 F14/P1/A15、原 D06 以及保存/导入路径的既定目标；P0 核心用例不依赖该能力。不以列表筛选或记录类型观察证明上游完全没有去重，也不宣称已经验证其能力缺失。\",\n2378:      \"sources\": []\n2379:     },\n2380:     {\n2381:      \"acceptance\": [],\n2382:      \"applicability\": \"not applicable\",\n2383:      \"id\": \"F15\",\n2384:      \"name\": \"浏览器扩展/分享目标抓取\",\n2385:      \"phase\": null,\n2386:      \"reason\": \"场景交付为本地 Web 工具，扩展与移动分享目标不在本期范围，手工录入与打开回跳已覆盖核心旅程。\",\n2387:      \"sources\": []\n2388:     },\n2389:     {\n2390:      \"acceptance\": [],\n2391:      \"applicability\": \"not applicable\",\n2392:      \"id\": \"F16\",\n2393:      \"name\": \"多设备与云同步\",\n2394:      \"phase\": null,\n2395:      \"reason\": \"本期是单机单实例的本地库，数据在单一 SQLite 文件；跨设备同步属后期形态，不阻塞核心旅程。\",\n2396:      \"sources\": []\n2397:     },\n2398:     {\n2399:      \"acceptance\": [],\n2400:      \"applicability\": \"decision needed\",\n2401:      \"id\": \"F17\",\n2402:      \"name\": \"网页留存副本/快照\",\n2403:      \"phase\": null,\n2404:      \"reason\": \"本模板 P0 只保存 URL 引用而不保存网页副本；网页留存仍为 decision needed，须用户明确需求后再决定外部抓取与存储方案。此处说明目标范围，不据当前不可用类型来源断言上游完整能力边界。\",\n2405:      \"sources\": []\n2406:     },\n2407:     {\n2408:      \"acceptance\": [],\n2409:      \"applicability\": \"decision needed\",\n2410:      \"id\": \"F18\",\n2411:      \"name\": \"失效链接检测与修复\",\n2412:      \"phase\": null,\n2413:      \"reason\": \"链接腐坏是本类型的结构性风险，但检测需要主动外呼，外部网络在验收中禁用；先保证引用与打开回跳，是否检测待用户决定。\",\n2414:      \"sources\": []\n2415:     },\n2416:     {\n2417:      \"acceptance\": [],\n2418:      \"applicability\": \"decision needed\",\n2419:      \"id\": \"F19\",\n2420:      \"name\": \"嵌套归类与多标签并存\",\n2421:      \"phase\": null,\n2422:      \"reason\": \"场景明说“选择一个简单归类”，扁平单选加收件区已足够；嵌套/标签是成熟能力，待归类数量或交叉主题增长时再评估。\",\n2423:      \"sources\": []\n2424:     },\n2425:     {\n2426:      \"acceptance\": [],\n2427:      \"applicability\": \"not applicable\",\n2428:      \"id\": \"F20\",\n2429:      \"name\": \"置顶/归档与多排序模式\",\n2430:      \"phase\": null,\n2431:      \"reason\": \"上游置顶与归档、三种排序属书签阅读器语境（S19、S16、S03），会给编辑与删除增加前置条件，与快速保存、快速清理相冲突，故不采用。\",\n2432:      \"sources\": [\n2433:       \"S19\",\n2434:       \"S16\",\n2435:       \"S03\"\n2436:      ]\n2437:     },\n2438:     {\n2439:      \"acceptance\": [],\n2440:      \"applicability\": \"not applicable\",\n2441:      \"id\": \"F21\",\n2442:      \"name\": \"公开分享与协作库\",\n2443:      \"phase\": null,\n2444:      \"reason\": \"场景是私有个人收藏箱，分享不在核心旅程内；公开或协作需要多用户身份与权限，属不同类型定位。\",\n2445:      \"sources\": []\n2446:     },\n2447:     {\n2448:      \"acceptance\": [],\n2449:      \"applicability\": \"not applicable\",\n2450:      \"id\": \"F22\",\n2451:      \"name\": \"阅读稍后与未读标记\",\n2452:      \"phase\": null,\n2453:      \"reason\": \"场景重心是留存引用并可回跳，而非消费队列；未读标记会使产品向 Read-it-later 漂移。\",\n[Output truncated. Continue reading with offset: 2454]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file input.json, lines 1118-2453\n1118:      \"default\": \"本期不做：抓取与归档在离线验收下不可验证；先保证引用记录与打开回跳。\",\n1119:      \"id\": \"D13\",\n1120:      \"impact\": \"涉及外部抓取与存储扩展，属后期可选能力，不纳入 P0/P1 验收。\",\n1121:      \"question\": \"是否需要保存网页副本并检测失效链接？\",\n1122:      \"status\": \"open\",\n1123:      \"when_to_ask\": \"当用户明确要求内容留存，或需要清理死链时再评估。\"\n1124:     }\n1125:    ],\n1126:    \"acceptance\": [\n1127:     {\n1128:      \"features\": [\n1129:       \"F01\",\n1130:       \"F08\"\n1131:      ],\n1132:      \"goal\": \"保存一条链接后，同进程与重启后的新进程都能读到该记录，且 id 与内容稳定。\",\n1133:      \"id\": \"A01\",\n1134:      \"implementation\": \"acceptance/p0_library.py\",\n1135:      \"phase\": \"P0\",\n1136:      \"status\": \"not_run\",\n1137:      \"type\": \"positive\"\n1138:     },\n1139:     {\n1140:      \"features\": [\n1141:       \"F01\",\n1142:       \"F10\"\n1143:      ],\n1144:      \"goal\": \"缺协议、非 http/https、无点域名的 URL 被拒绝并返回结构化错误，且库中不新增记录。\",\n1145:      \"id\": \"A02\",\n1146:      \"implementation\": \"acceptance/p0_library.py\",\n1147:      \"phase\": \"P0\",\n1148:      \"status\": \"not_run\",\n1149:      \"type\": \"negative\"\n1150:     },\n1151:     {\n1152:      \"features\": [\n1153:       \"F01\",\n1154:       \"F02\"\n1155:      ],\n1156:      \"goal\": \"不选归类保存时记录落入“未整理”，保存时给出的新归类名被自动创建，首启可见预置归类。\",\n1157:      \"id\": \"A03\",\n1158:      \"implementation\": \"acceptance/p0_library.py\",\n1159:      \"phase\": \"P0\",\n1160:      \"status\": \"not_run\",\n1161:      \"type\": \"positive\"\n1162:     },\n1163:     {\n1164:      \"features\": [\n1165:       \"F03\"\n1166:      ],\n1167:      \"goal\": \"可新建、重命名、删除归类；重名被拒；删除归类后其记录回到“未整理”。\",\n1168:      \"id\": \"A04\",\n1169:      \"implementation\": \"acceptance/p0_organize.py\",\n1170:      \"phase\": \"P0\",\n1171:      \"status\": \"not_run\",\n1172:      \"type\": \"positive\"\n1173:     },\n1174:     {\n1175:      \"features\": [\n1176:       \"F04\",\n1177:       \"F08\"\n1178:      ],\n1179:      \"goal\": \"在给定的 base_url 目标把记录从“未整理”移动到另一归类，并用独立实例证明该归属跨重启仍然有效。\",\n1180:      \"id\": \"A05\",\n1181:      \"implementation\": \"acceptance/p0_organize.py\",\n1182:      \"phase\": \"P0\",\n1183:      \"status\": \"not_run\",\n1184:      \"type\": \"positive\"\n1185:     },\n1186:     {\n1187:      \"features\": [\n1188:       \"F05\"\n1189:      ],\n1190:      \"goal\": \"按归类浏览只返回该归类记录，侧栏/接口给出的条目计数与实际一致。\",\n1191:      \"id\": \"A06\",\n1192:      \"implementation\": \"acceptance/p0_organize.py\",\n1193:      \"phase\": \"P0\",\n1194:      \"status\": \"not_run\",\n1195:      \"type\": \"positive\"\n1196:     },\n1197:     {\n1198:      \"features\": [\n1199:       \"F06\"\n1200:      ],\n1201:      \"goal\": \"关键字检索匹配标题、域名与描述，可与归类叠加，无匹配时返回空集而非错误。\",\n1202:      \"id\": \"A07\",\n1203:      \"implementation\": \"acceptance/p0_find_open.py\",\n1204:      \"phase\": \"P0\",\n1205:      \"status\": \"not_run\",\n1206:      \"type\": \"positive\"\n1207:     },\n1208:     {\n1209:      \"features\": [\n1210:       \"F07\"\n1211:      ],\n1212:      \"goal\": \"打开记录跳转到保存时的原始 URL（302 Location 等于保存值），未知 id 返回 404。\",\n1213:      \"id\": \"A08\",\n1214:      \"implementation\": \"acceptance/p0_find_open.py\",\n1215:      \"phase\": \"P0\",\n1216:      \"status\": \"not_run\",\n1217:      \"type\": \"positive\"\n1218:     },\n1219:     {\n1220:      \"features\": [\n1221:       \"F08\",\n1222:       \"F09\"\n1223:      ],\n1224:      \"goal\": \"在给定的 base_url 目标删除记录后默认视图排除它、撤销恢复后记录内容重新可见，并用独立实例证明删除跨重启保持。\",\n1225:      \"id\": \"A09\",\n1226:      \"implementation\": \"acceptance/p0_recovery.py\",\n1227:      \"phase\": \"P0\",\n1228:      \"status\": \"not_run\",\n1229:      \"type\": \"positive\"\n1230:     },\n1231:     {\n1232:      \"features\": [\n1233:       \"F10\"\n1234:      ],\n1235:      \"goal\": \"未知 id 与畸形请求返回结构化错误码，且不产生 5xx、不改变现有数据。\",\n1236:      \"id\": \"A10\",\n1237:      \"implementation\": \"acceptance/p0_recovery.py\",\n1238:      \"phase\": \"P0\",\n1239:      \"status\": \"not_run\",\n1240:      \"type\": \"negative\"\n1241:     },\n1242:     {\n1243:      \"features\": [\n1244:       \"F11\"\n1245:      ],\n1246:      \"goal\": \"健康检查返回就绪，首页外壳在空库下渲染录入表单与列表容器，入口不报错。\",\n1247:      \"id\": \"A11\",\n1248:      \"implementation\": \"acceptance/p0_library.py\",\n1249:      \"phase\": \"P0\",\n1250:      \"status\": \"not_run\",\n1251:      \"type\": \"positive\"\n1252:     },\n1253:     {\n1254:      \"features\": [\n1255:       \"F04\",\n1256:       \"F10\"\n1257:      ],\n1258:      \"goal\": \"保存或移动到空名/超长名的非法归类时返回 400 invalid_category，且现有归类与记录不变。\",\n1259:      \"id\": \"A12\",\n1260:      \"implementation\": \"acceptance/p0_organize.py\",\n1261:      \"phase\": \"P0\",\n1262:      \"status\": \"not_run\",\n1263:      \"type\": \"negative\"\n1264:     },\n1265:     {\n1266:      \"features\": [\n1267:       \"F12\"\n1268:      ],\n1269:      \"goal\": \"外部网络不可用时保存仍然成功，图标与标题降级为本地派生结果，缺失增强不阻塞或报错。\",\n1270:      \"id\": \"A13\",\n1271:      \"implementation\": \"acceptance/p1_maturity.py\",\n1272:      \"phase\": \"P1\",\n1273:      \"status\": \"not_run\",\n1274:      \"type\": \"positive\"\n1275:     },\n1276:     {\n1277:      \"features\": [\n1278:       \"F13\"\n1279:      ],\n1280:      \"goal\": \"导出为浏览器书签 HTML 可包含已存记录，且导入该 HTML 后相应记录可再次检索到。\",\n1281:      \"id\": \"A14\",\n1282:      \"implementation\": \"acceptance/p1_maturity.py\",\n1283:      \"phase\": \"P1\",\n1284:      \"status\": \"not_run\",\n1285:      \"type\": \"positive\"\n1286:     },\n1287:     {\n1288:      \"features\": [\n1289:       \"F14\"\n1290:      ],\n1291:      \"goal\": \"重复 URL 默认被拒绝（409 duplicate_url）且库不变；显式允许重复时可新增第二条。\",\n1292:      \"id\": \"A15\",\n1293:      \"implementation\": \"acceptance/p1_maturity.py\",\n1294:      \"phase\": \"P1\",\n1295:      \"status\": \"not_run\",\n1296:      \"type\": \"negative\"\n1297:     }\n1298:    ]\n1299:   },\n1300:   \"authored_fields_after\": {\n1301:    \"phases\": [\n1302:     {\n1303:      \"acceptance\": [\n1304:       \"A01\",\n1305:       \"A02\",\n1306:       \"A03\",\n1307:       \"A04\",\n1308:       \"A05\",\n1309:       \"A06\",\n1310:       \"A07\",\n1311:       \"A08\",\n1312:       \"A09\",\n1313:       \"A10\",\n1314:       \"A11\",\n1315:       \"A12\"\n1316:      ],\n1317:      \"features\": [\n1318:       \"F01\",\n1319:       \"F02\",\n1320:       \"F03\",\n1321:       \"F04\",\n1322:       \"F05\",\n1323:       \"F06\",\n1324:       \"F07\",\n1325:       \"F08\",\n1326:       \"F09\",\n1327:       \"F10\",\n1328:       \"F11\"\n1329:      ],\n1330:      \"goal\": \"用户可保存链接（可选归类或落入未整理）、按归类或关键字找回、打开原页、清理并撤销，且全部数据跨会话与重启保留，非法输入得到可恢复的明确错误。\",\n1331:      \"id\": \"P0\",\n1332:      \"status\": \"not implemented\",\n1333:      \"title\": \"个人收藏箱核心旅程\"\n1334:     },\n1335:     {\n1336:      \"acceptance\": [\n1337:       \"A13\",\n1338:       \"A14\",\n1339:       \"A15\"\n1340:      ],\n1341:      \"features\": [\n1342:       \"F12\",\n1343:       \"F13\",\n1344:       \"F14\"\n1345:      ],\n1346:      \"goal\": \"在离线可用的前提下增强记录可辨识度（本地派生图标、外部抓取仅作增强），并支持浏览器书签格式的导入导出与重复链接检测，用于长期库维护。\",\n1347:      \"id\": \"P1\",\n1348:      \"status\": \"not implemented\",\n1349:      \"title\": \"成熟增强：元数据、互操作与库清理\"\n1350:     }\n1351:    ],\n1352:    \"architecture_markdown\": \"# 架构与契约\\n\\n## 默认技术栈与理由\\n\\n- 交付 profile：python-web。Python 3.12 标准库（http.server、sqlite3、urllib、json、html.parser），零第三方依赖；服务端渲染 HTML 表单，JSON API 与 HTML 适配器共用同一服务层。\\n- 备选 Flask/FastAPI 需安装依赖；Node + IndexedDB/SPA 需 npm/浏览器工具且把数据放在浏览器 profile。二者与离线、可独立验收、单用户本地库的约束冲突，故不采用。\\n- 数据文件位于应用 `--data-dir/bookmarks.sqlite3`；验收的每实例隔离目录由测试适配器创建，测试者 `--data-dir` 根目录不是应用数据库。\\n- 单用户、本地优先；无认证、无云同步。日常绑定 127.0.0.1；仅隔离验收网络使用 0.0.0.0。\\n\\n## 数据模型（SQLite）\\n\\n- `schema_meta(version INTEGER)`：迁移版本单行。启动时在一个事务内创建/升级 schema，v1 建表并写入预置归类；版本演进只通过事务化迁移，不回退、不依赖客户端存储。\\n- `categories(id TEXT PRIMARY KEY, name TEXT NOT NULL UNIQUE COLLATE NOCASE, is_default INTEGER NOT NULL DEFAULT 0, position INTEGER NOT NULL, created_at INTEGER NOT NULL)`：首启预置「未整理」(is_default=1)、「待购」、「家居改造」、「以后看看」。\\n- `bookmarks(id TEXT PRIMARY KEY, url TEXT NOT NULL, hostname TEXT NOT NULL, title TEXT NULL, description TEXT NULL, category_id TEXT NOT NULL REFERENCES categories(id), favicon_url TEXT NULL, created_at INTEGER NOT NULL, updated_at INTEGER NOT NULL, trashed_at INTEGER NULL)`。\\n- 索引：category_id、created_at、hostname；url 不设唯一索引。P1/F14 的重复检测由服务层查询活动记录完成；P0 不启用重复拒绝。\\n- trashed_at 为 NULL 表示活动记录；非 NULL 为软删除。默认列表与计数只统计 trashed_at IS NULL；恢复清空 trashed_at。删除归类在单一事务内把该归类下的活动记录与软删除记录都改到默认归类，因此恢复不会产生无归类记录。\\n- 排序固定为 created_at DESC、id ASC；category 与 q 只作请求参数，不落库。\\n\\n## URL 策略\\n\\n- 记录 URL 必须是绝对、可解析的 HTTP(S) URL，且 hostname 有效且非空。单标签主机（如 http://localhost）与 IP 字面量均有效；不做 DNS 查询、可达性检查或目标页抓取。\\n- 保存与打开都保留用户提交的原始字符串（不补斜杠、不改大小写、不重写路径）；hostname 由解析结果派生。若 PATCH 更新 URL，必须用新 URL 重新派生 hostname。\\n- 拒绝：缺少 scheme、非 http/https、缺少/非法 hostname、无法解析的字符串；返回 400 invalid_url 且不写入。\\n- 上游 S04 记录点域名正则限制，S02 记录新记录包含派生 hostname；这些是固定来源观察。target 的绝对 HTTP(S) URL 解析、允许单标签 hostname 与保留原始 URL 文本，是本模板的 adjusted 设计，采用上述解析策略。\\n- 保存、打开、抓取三者分离：P0 保存与列表均不请求目标页；打开只产生浏览器导航或 /go 302。\\n\\n## API、错误与状态合同\\n\\n- `GET /api/health` → 200 JSON，含就绪与 schema 版本。\\n- `GET /api/categories` → 200 数组，每项 id、name、count、is_default；count 只计活动记录。\\n- `POST /api/categories` nam... (line truncated to 2000 chars)\n1353:    \"roles\": [\n1354:     {\n1355:      \"id\": \"R01\",\n1356:      \"name\": \"收藏者（个人用户）\",\n1357:      \"responsibility\": \"在浏览时主动保存外部网页链接，选择或新建简单归类、把未整理的链接移动到合适归类、按归类或关键字找回、打开记录回到原页，并清理误存条目。\"\n1358:     },\n1359:     {\n1360:      \"id\": \"R02\",\n1361:      \"name\": \"本地收藏应用（服务端与页面外壳）\",\n1362:      \"responsibility\": \"校验录入、派生域名、持久化收藏与归类、提供保存/浏览/检索/打开/恢复接口，并在离线条件下保持可用。\"\n1363:     },\n1364:     {\n1365:      \"id\": \"R03\",\n1366:      \"name\": \"独立验收执行者\",\n1367:      \"responsibility\": \"以 URL 与 CLI 参数驱动真实目标，执行正负向行为断言、重启持久化验证与错误恢复验证，不修改应用、不自报运行结果。\"\n1368:     }\n1369:    ],\n1370:    \"title\": \"生活待购与灵感收藏夹\",\n1371:    \"limits\": [\n1372:     \"不实现云同步、多用户共享或托管部署（D11、F16、F21）。\",\n1373:     \"不保存网页快照、不做正文全文检索、不做失效链接检测（F17、F18、D13）。\",\n1374:     \"不引入置顶/归档、多排序模式、复制 URL 与访问计数（F20、F23、F24）。\",\n1375:     \"归类为扁平单选，不支持嵌套层级或多标签并存（F19、D01）。\",\n1376:     \"第三方元数据与图标抓取未验证可达性，仅作可选增强且失败静默降级（F12、D05）。\",\n1377:     \"验收不携带认证凭据；若目标要求认证，验收必须显式报告基础设施未就绪而非跳过或通过（D09）。\",\n1378:     \"不设置未经验证的性能或成本目标。\"\n1379:    ],\n1380:    \"contract_coverage\": {\n1381:     \"error_contract\": {\n1382:      \"branches\": [\n1383:       {\n1384:        \"acceptance_ids\": [\n1385:         \"A04\"\n1386:        ],\n1387:        \"code\": \"invalid_name\",\n1388:        \"feature_ids\": [\n1389:         \"F03\"\n1390:        ],\n1391:        \"field\": \"name\",\n1392:        \"id\": \"html.category_create.name.omitted\",\n1393:        \"implementation\": \"acceptance/p0_organize.py\",\n1394:        \"operation\": \"category_create\",\n1395:        \"response\": \"form-error and submitted values retained\",\n1396:        \"status\": 400,\n1397:        \"transport\": \"html\",\n1398:        \"value_kind\": \"omitted\",\n1399:        \"write_effect\": \"