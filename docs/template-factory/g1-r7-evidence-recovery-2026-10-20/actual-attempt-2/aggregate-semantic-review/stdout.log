valid_result\": {\n48:     \"status\": 400,\n49:     \"code\": \"invalid_category\"\n50:    },\n51:    \"html_failure\": \"Show form-error, retain submitted values, and make no writes.\",\n52:    \"valid_new_name\": \"Automatically create and use the named category.\"\n53:   },\n54:   \"bookmark_move\": {\n55:    \"acceptance_id\": \"A12\",\n56:    \"json_field\": \"category\",\n57:    \"json_semantics\": \"Category NAME, never category ID.\",\n58:    \"invalid_json_values\": [\n59:     \"omitted\",\n60:     \"JSON null\",\n61:     \"empty\",\n62:     \"whitespace_only\",\n63:     \"121_characters\"\n64:    ],\n65:    \"html_field\": \"category_id\",\n66:    \"html_semantics\": \"Resolve the submitted ID to an existing category name.\",\n67:    \"invalid_html_values\": [\n68:     \"omitted\",\n69:     \"empty\",\n70:     \"unknown_id\"\n71:    ],\n72:    \"invalid_result\": {\n73:     \"status\": 400,\n74:     \"code\": \"invalid_category\"\n75:    },\n76:    \"html_failure\": \"Show form-error, retain submitted values, and make no writes.\",\n77:    \"valid_new_json_name\": \"Automatically create and use the named category.\",\n78:    \"never_create_from_html_id\": true\n79:   },\n80:   \"unknown_get_filter\": \"Return an empty result; do not treat an unknown category filter as an error.\"\n81:  },\n82:  \"search_contract\": \"Search is a case-insensitive substring over title, hostname, and description, with optional category filtering applied together. Search does not match tags or raw URL substrings.\",\n83:  \"url_policy\": {\n84:   \"schemes\": [\n85:    \"http\",\n86:    \"https\"\n87:   ],\n88:   \"absolute\": true,\n89:   \"nonempty_valid_hostname\": true,\n90:   \"single_label_hosts\": true,\n91:   \"dns_required\": false,\n92:   \"preserve_original_text\": true,\n93:   \"p0_fetch\": false\n94:  },\n95:  \"authorized_assertion_adaptation\": \"A02 may replace only its single-label-hostname rejection example with a positive example; missing scheme, unsupporte