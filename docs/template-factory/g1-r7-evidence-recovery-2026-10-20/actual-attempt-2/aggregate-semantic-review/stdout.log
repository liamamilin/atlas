{"type":"tool_use","timestamp":1792484158918,"sessionID":"ses_ea79fcfd3ffeGu4Pan86lE7BF8","part":{"partID":"prt_15861ad42001oW7qeLDXp5lI4W","sessionID":"ses_ea79fcfd3ffeGu4Pan86lE7BF8","messageID":"msg_15861842c001mrZXYMfbl2OMbt","type":"tool","id":"call_4bf1994d51c542e39b2c0e06","tool":"read","state":{"status":"completed","input":{"path":"source/baseline/acceptance/p0_organize.py","limit":2000},"output":"Read file source/baseline/acceptance/p0_organize.py, lines 1-557\n1: #!/usr/bin/env python3\n2: '''P0 行为验收组：归类管理、记录移动、归类浏览与非法归类。\n3: \n4: 覆盖 A04、A05、A06、A12。仅使用 Python 3.12 标准库并复用\n5: acceptance/common.py：以 --case 派发，未知用例显式失败；每个用例对真实\n6: 目标执行正向与硬负向行为断言，向 stdout 输出单个\n7: atlas.acceptance-result.v1 JSON，失败时以非零码退出。\n8: '''\n9: \n10: from __future__ import annotations\n11: \n12: import os\n13: import sys\n14: import uuid\n15: from urllib.parse import quote\n16: \n17: _THIS_DIR = os.path.dirname(os.path.abspath(__file__))\n18: if _THIS_DIR not in sys.path:\n19:     sys.path.insert(0, _THIS_DIR)\n20: \n21: import common\n22: \n23: _SUCCESS_STATUSES = (200, 204)\n24: \n25: \n26: def _unique_url(tag):\n27:     token = f'{tag}-{uuid.uuid4().hex[:12]}'\n28:     return f'https://{token}.atlas-acceptance.example/{token}'\n29: \n30: \n31: def _unique_category(tag):\n32:     return f'atlas-{tag}-{uuid.uuid4().hex[:10]}'\n33: \n34: \n35: def _safe_json(response):\n36:     try:\n37:         return response.json()\n38:     except Exception:\n39:         return None\n40: \n41: \n42: def _extract_record(payload):\n43:     if isinstance(payload, dict):\n44:         for key in ('category', 'bookmark', 'record', 'data', 'item'):\n45:             value = payload.get(key)\n46:             if isinstance(value, dict):\n47:                 return value\n48:         return payload\n49:     return None\n50: \n51: \n52: def _record_id(record):\n53:     if isinstance(record, dict) and record.get('id') is not None:\n54:         return str(record['id'])\n55:     return None\n56: \n57: \n58: def _record_category_name(record):\n59:     if isinstance(record, dict):\n60:         for key in ('category', 'category_name'):\n61:             value = record.get(key)\n62:             if isinstance(value, str) and value:\n63:                 return value\n64:             if isinstance(value, dict) and value.get('name'):\n65:                 return str(value['name'])\n66:     return None\n67: \n68: \n69: def _error_code(response):\n70:     payload = _safe_json(response)\n71:     if isinstance(payload, dict):\n72:         error = payload.get('error')\n73:         if isinstance(error, dict) and error.get('code') is not None:\n74:             return str(error['code'])\n75:         for key in ('code', 'error_code'):\n76:             if payload.get(key) is not None:\n77:                 return str(payload[key])\n78:     return None\n79: \n80: \n81: def _extract_list(payload, keys):\n82:     if isinstance(payload, list):\n83:         return payload\n84:     if isinstance(payload, dict):\n85:         for key in keys:\n86:             value = payload.get(key)\n87:             if isinstance(value, list):\n88:                 return value\n89:     return None\n90: \n91: \n92: def _bookmark_path(bookmark_id):\n93:     return '/api/bookmarks/' + quote(str(bookmark_id), safe='')\n94: \n95: \n96: def _move_path(bookmark_id):\n97:     return _bookmark_path(bookmark_id) + '/move'\n98: \n99: \n100: def _category_path(category_id):\n101:     return '/api/categories/' + quote(str(category_id), safe='')\n102: \n103: \n104: def _fetch_bookmarks(client, recorder, aid, params=None):\n105:     response = client.get('/api/bookmarks', params=params)\n106:     recorder.expect_status(response, 200, aid=f'{aid}-list-status')\n107:     payload = _safe_json(response)\n108:     records = _extract_list(payload, ('bookmarks', 'items', 'data', 'records'))\n109:     recorder.check(\n110:         f'{aid}-list-shape',\n111:         isinstance(records, list),\n112:         f'GET /api/bookmarks 必须返回 JSON 数组，实际 {type(payload).__name__}',\n113:     )\n114:     return records if isinstance(records, list) else []\n115: \n116: \n117: def _fetch_categories(client, recorder, aid):\n118:     response = client.get('/api/categories')\n119:     recorder.expect_status(response, 200, aid=f'{aid}-categories-status')\n120:     payload = _safe_json(response)\n121:     categories = _extract_list(payload, ('categories', 'items', 'data'))\n122:     recorder.check(\n123:         f'{aid}-categories-shape',\n124:         isinstance(categories, list),\n125:         f'GET /api/categories 必须返回 JSON 数组，实际 {type(payload).__name__}',\n126:     )\n127:     return categories if isinstance(categories, list) else []\n128: \n129: \n130: def _category_names(categories):\n131:     names = set()\n132:     for item in categories:\n133:         if isinstance(item, dict) and item.get('name') is not None:\n134:             names.add(str(item['name']))\n135:     return names\n136: \n137: \n138: def _category_ids(categories):\n139:     ids = set()\n140:     for item in categories:\n141:         item_id = _record_id(item)\n142:         if item_id:\n143:             ids.add(item_id)\n144:     return ids\n145: \n146: \n147: def _find_category(categories, name):\n148:     target = str(name).casefold()\n149:     for item in categories:\n150:         if isinstance(item, dict) and item.get('name') is not None:\n151:             if str(item['name']).casefold() == target:\n152:                 return item\n153:     return None\n154: \n155: \n156: def _default_category(categories):\n157:     for item in categories:\n158:         if isinstance(item, dict) and item.get('is_default'):\n159:             return item\n160:     return _find_category(categories, common.DEFAULT_CATEGORY)\n161: \n162: \n163: def _record_ids(records):\n164:     return {item_id for item_id in (_record_id(record) for record in records) if item_id}\n165: \n166: \n167: def _create_record(client, recorder, aid, category=None, title=None):\n168:     url = _unique_url(aid)\n169:     payload = {'url': url}\n170:     if category is not None:\n171:         payload['category'] = category\n172:     if title is not None:\n173:         payload['title'] = title\n174:     response = client.post_json('/api/bookmarks', payload)\n175:     recorder.expect_status(response, 201, aid=f'{aid}-save-status')\n176:     record_id = _record_id(_extract_record(_safe_json(response)))\n177:     recorder.check(f'{aid}-save-id', bool(record_id), f'保存 {url} 返回 id={record_id!r}')\n178:     return record_id\n179: \n180: \n181: def _case_a04(args, recorder):\n182:     client = common.HttpClient(args.base_url)\n183:     try:\n184:         health = client.get('/api/health')\n185:         recorder.expect_status(health, 200, aid='a04-health-status')\n186: \n187:         name = _unique_category('a04')\n188:         created = client.post_json('/api/categories', {'name': name})\n189:         recorder.expect_status(created, 201, aid='a04-create-status')\n190:         category_id = _record_id(_extract_record(_safe_json(created)))\n191:         recorder.check('a04-create-id', bool(category_id), f'POST /api/categories 返回 id={category_id!r}')\n192: \n193:         listed = _fetch_categories(client, recorder, 'a04-listed')\n194:         recorder.check(\n195:             'a04-created-visible',\n196:             name in _category_names(listed),\n197:             f'GET /api/categories 含新建归类 {name!r}',\n198:         )\n199: \n200:         duplicate = client.post_json('/api/categories', {'name': name})\n201:         recorder.expect_status(duplicate, 409, aid='a04-duplicate-status')\n202:         recorder.check(\n203:             'a04-duplicate-code',\n204:             _error_code(duplicate) == 'duplicate_category',\n205:             f'同名再建错误码={_error_code(duplicate)!r}（期望 duplicate_category）',\n206:         )\n207: \n208:         variant = client.post_json('/api/categories', {'name': str(name).upper()})\n209:         recorder.expect_status(variant, 409, aid='a04-duplicate-case-status')\n210:         recorder.check(\n211:             'a04-duplicate-case-code',\n212:             _error_code(variant) == 'duplicate_category',\n213:             f'大小写变体再建错误码={_error_code(variant)!r}（期望 duplicate_category）',\n214:         )\n215: \n216:         if not category_id:\n217:             return\n218: \n219:         record_id = _create_record(client, recorder, 'a04', category=name)\n220:         if record_id:\n221:             in_new = _fetch_bookmarks(client, recorder, 'a04-in-new', params={'category': name})\n222:             recorder.check(\n223:                 'a04-record-in-new-category',\n224:                 record_id in _record_ids(in_new),\n225:                 f'记录 {record_id!r} 可在归类 {name!r} 中查到',\n226:             )\n227: \n228:         renamed_name = _unique_category('a04renamed')\n229:         renamed = client.patch_json(_category_path(category_id), {'name': renamed_name})\n230:         recorder.expect_status(renamed, _SUCCESS_STATUSES, aid='a04-rename-status')\n231:         after_rename = _fetch_categories(client, recorder, 'a04-after-rename')\n232:         names_after = _category_names(after_rename)\n233:         recorder.check(\n234:             'a04-rename-applied',\n235:             renamed_name in names_after,\n236:             f'重命名后新名 {renamed_name!r} 可见：{sorted(names_after)}',\n237:         )\n238:         recorder.check('a04-rename-old-absent', name not in names_after, f'重命名后旧名 {name!r} 不再出现')\n239:         if record_id:\n240:             by_renamed = _fetch_bookmarks(client, recorder, 'a04-by-renamed', params={'category': renamed_name})\n241:             recorder.check(\n242:                 'a04-record-follows-rename',\n243:                 record_id in _record_ids(by_renamed),\n244:                 f'重命名后记录 {record_id!r} 仍属于该归类',\n245:             )\n246:             stale = _fetch_bookmarks(client, recorder, 'a04-stale-name', params={'category': name})\n247:             recorder.check(\n248:                 'a04-unknown-category-empty',\n249:                 record_id not in _record_ids(stale),\n250:                 f'旧归类名 {name!r} 过滤不再返回该记录',\n251:             )\n252: \n253:         deleted = client.request('DELETE', _category_path(category_id))\n254:         recorder.expect_status(deleted, _SUCCESS_STATUSES, aid='a04-delete-status')\n255:         after_delete = _fetch_categories(client, recorder, 'a04-after-delete')\n256:         remaining = _category_names(after_delete)\n257:         recorder.check(\n258:             'a04-delete-applied',\n259:             renamed_name not in remaining,\n260:             f'删除后 {renamed_name!r} 不再出现：{sorted(remaining)}',\n261:         )\n262:         if record_id:\n263:             inbox = _fetch_bookmarks(client, recorder, 'a04-inbox', params={'category': common.DEFAULT_CATEGORY})\n264:             recorder.check(\n265:                 'a04-record-back-to-default',\n266:                 record_id in _record_ids(inbox),\n267:                 f'删除归类后记录 {record_id!r} 回到「{common.DEFAULT_CATEGORY}」',\n268:             )\n269:             fetched = client.get(_bookmark_path(record_id))\n270:             recorder.expect_status(fetched, 200, aid='a04-record-fetch-status')\n271:             category_name = _record_category_name(_extract_record(_safe_json(fetched)))\n272:             if category_name is not None:\n273:                 recorder.check(\n274:                     'a04-record-category-default',\n275:                     category_name == common.DEFAULT_CATEGORY,\n276:                     f'记录 category={category_name!r}（期望 {common.DEFAULT_CATEGORY!r}）',\n277:                 )\n278: \n279:         default_item = _default_category(after_delete)\n280:         default_id = _record_id(default_item)\n281:         if default_id:\n282:             delete_default = client.request('DELETE', _category_path(default_id))\n283:             recorder.expect_status(delete_default, 400, aid='a04-default-delete-status')\n284:             recorder.check(\n285:                 'a04-default-delete-code',\n286:                 _error_code(delete_default) == 'protected_category',\n287:                 f'删除默认归类错误码={_error_code(delete_default)!r}（期望 protected_category）',\n288:             )\n289:             rename_default = client.patch_json(_category_path(default_id), {'name': _unique_category('a04default')})\n290:             recorder.expect_status(rename_default, 400, aid='a04-default-rename-status')\n291:             recorder.check(\n292:                 'a04-default-rename-code',\n293:                 _error_code(rename_default) == 'protected_category',\n294:                 f'重命名默认归类错误码={_error_code(rename_default)!r}（期望 protected_category）',\n295:             )\n296:     finally:\n297:         client.close()\n298: \n299: \n300: def _a05_on_base_url(args, recorder):\n301:     client = common.HttpClient(args.base_url)\n302:     try:\n303:         health = client.get('/api/health')\n304:         recorder.expect_status(health, 200, aid='a05-health-status')\n305: \n306:         category_name = _unique_category('a05live')\n307:         record_id = _create_record(client, recorder, 'a05live')\n308:         if not record_id:\n309:             return\n310: \n311:         moved = client.post_json(_move_path(record_id), {'category': category_name})\n312:         recorder.expect_status(moved, _SUCCESS_STATUSES, aid='a05-live-move-status')\n313:         in_category = _fetch_bookmarks(client, recorder, 'a05-live-in', params={'category': category_name})\n314:         recorder.check(\n315:             'a05-live-move-visible',\n316:             record_id in _record_ids(in_category),\n317:             f'移动后 {record_id!r} 可在 {category_name!r} 中查到',\n318:         )\n319:         inbox = _fetch_bookmarks(client, recorder, 'a05-live-inbox', params={'category': common.DEFAULT_CATEGORY})\n320:         recorder.check(\n321:             'a05-live-left-default',\n322:             record_id not in _record_ids(inbox),\n323:             f'移动后 {record_id!r} 不再属于「{common.DEFAULT_CATEGORY}」',\n324:         )\n325:         fetched = client.get(_bookmark_path(record_id))\n326:         recorder.expect_status(fetched, 200, aid='a05-live-fetch-status')\n327:         stored_category = _record_category_name(_extract_record(_safe_json(fetched)))\n328:         if stored_category is not None:\n329:             recorder.check(\n330:                 'a05-live-record-category',\n331:                 stored_category == category_name,\n332:                 f'记录 category={stored_category!r}（期望 {category_name!r}）',\n333:             )\n334:     finally:\n335:         client.close()\n336: \n337: \n338: def _a05_across_restart(args, recorder):\n339:     first = common.launch_app(args.app_root, args.data_dir, 0)\n340:     instance_dir = first.instance_dir\n341:     category_name = _unique_category('a05restart')\n342:     record_id = None\n343:     try:\n344:         client = common.HttpClient(first.base_url)\n345:         try:\n346:             health = client.get('/api/health')\n347:             recorder.expect_status(health, 200, aid='a05-restart-health-status')\n348:             record_id = _create_record(client, recorder, 'a05restart')\n349:             if record_id:\n350:                 moved = client.post_json(_move_path(record_id), {'category': category_name})\n351:                 recorder.expect_status(moved, _SUCCESS_STATUSES, aid='a05-restart-move-status')\n352:                 in_category = _fetch_bookmarks(\n353:                     client, recorder, 'a05-restart-in', params={'category': category_name}\n354:                 )\n355:                 recorder.check(\n356:                     'a05-restart-move-visible',\n357:                     record_id in _record_ids(in_category),\n358:                     f'隔离实例移动后 {record_id!r} 可在 {category_name!r} 中查到',\n359:                 )\n360:         finally:\n361:             client.close()\n362:     finally:\n363:         common.stop_app(first)\n364: \n365:     if not record_id:\n366:         recorder.check('a05-restart-persist', False, '隔离实例未返回可用 id，无法验证归属跨重启')\n367:         return\n368: \n369:     second = common.launch_app(args.app_root, args.data_dir, 0, instance_dir=instance_dir)\n370:     try:\n371:         client = common.HttpClient(second.base_url)\n372:         try:\n373:             after = _fetch_bookmarks(client, recorder, 'a05-restart-after', params={'category': category_name})\n374:             recorder.check(\n375:                 'a05-restart-persist-visible',\n376:                 record_id in _record_ids(after),\n377:                 f'重启后 {record_id!r} 仍可在 {category_name!r} 中查到',\n378:             )\n379:             inbox = _fetch_bookmarks(\n380:                 client, recorder, 'a05-restart-inbox', params={'category': common.DEFAULT_CATEGORY}\n381:             )\n382:             recorder.check(\n383:                 'a05-restart-persist-not-default',\n384:                 record_id not in _record_ids(inbox),\n385:                 f'重启后 {record_id!r} 不回到「{common.DEFAULT_CATEGORY}」',\n386:             )\n387:             fetched = client.get(_bookmark_path(record_id))\n388:             recorder.expect_status(fetched, 200, aid='a05-restart-fetch-status')\n389:             stored_category = _record_category_name(_extract_record(_safe_json(fetched)))\n390:             if stored_category is not None:\n391:                 recorder.check(\n392:                     'a05-restart-record-category',\n393:                     stored_category == category_name,\n394:                     f'重启后 category={stored_category!r}（期望 {category_name!r}）',\n395:                 )\n396:         finally:\n397:             client.close()\n398:     finally:\n399:         common.stop_app(second)\n400: \n401: \n402: def _case_a05(args, recorder):\n403:     _a05_on_base_url(args, recorder)\n404:     _a05_across_restart(args, recorder)\n405: \n406: \n407: def _case_a06(args, recorder):\n408:     client = common.HttpClient(args.base_url)\n409:     try:\n410:         health = client.get('/api/health')\n411:         recorder.expect_status(health, 200, aid='a06-health-status')\n412: \n413:         category_a = _unique_category('a06a')\n414:         category_b = _unique_category('a06b')\n415:         for label, category_name in (('a', category_a), ('b', category_b)):\n416:             created = client.post_json('/api/categories', {'name': category_name})\n417:             recorder.expect_status(created, 201, aid=f'a06-create-{label}-status')\n418: \n419:         ids_a = [\n420:             record_id\n421:             for record_id in (\n422:                 _create_record(client, recorder, f'a06a-{index}', category=category_a) for index in range(1, 3)\n423:             )\n424:             if record_id\n425:         ]\n426:         ids_b = [\n427:             record_id\n428:             for record_id in (\n429:                 _create_record(client, recorder, f'a06b-{index}', category=category_b) for index in range(1, 3)\n430:             )\n431:             if record_id\n432:         ]\n433: \n434:         list_a = _fetch_bookmarks(client, recorder, 'a06-list-a', params={'category': category_a})\n435:         set_a = _record_ids(list_a)\n436:         list_b = _fetch_bookmarks(client, recorder, 'a06-list-b', params={'category': category_b})\n437:         set_b = _record_ids(list_b)\n438: \n439:         recorder.check(\n440:             'a06-a-exact',\n441:             bool(ids_a) and set_a == set(ids_a),\n442:             f'按 {category_a!r} 过滤返回 {sorted(set_a)}（期望 {sorted(set(ids_a))}）',\n443:         )\n444:         recorder.check(\n445:             'a06-b-exact',\n446:             bool(ids_b) and set_b == set(ids_b),\n447:             f'按 {category_b!r} 过滤返回 {sorted(set_b)}（期望 {sorted(set(ids_b))}）',\n448:         )\n449:         recorder.check('a06-disjoint', not (set_a & set_b), f'两类过滤结果不相交，交集={sorted(set_a & set_b)}')\n450: \n451:         categories = _fetch_categories(client, recorder, 'a06-categories')\n452:         item_a = _find_category(categories, category_a)\n453:         item_b = _find_category(categories, category_b)\n454:         count_a = item_a.get('count') if isinstance(item_a, dict) else None\n455:         count_b = item_b.get('count') if isinstance(item_b, dict) else None\n456:         recorder.check('a06-count-a', count_a == len(ids_a), f'归类 {category_a!r} 计数={count_a!r}（期望 {len(ids_a)}）')\n457:         recorder.check('a06-count-b', count_b == len(ids_b), f'归类 {category_b!r} 计数={count_b!r}（期望 {len(ids_b)}）')\n458:     finally:\n459:         client.close()\n460: \n461: \n462: def _case_a12(args, recorder):\n463:     client = common.HttpClient(args.base_url)\n464:     try:\n465:         health = client.get('/api/health')\n466:         recorder.expect_status(health, 200, aid='a12-health-status')\n467: \n468:         anchor_id = _create_record(client, recorder, 'a12-anchor')\n469:         if not anchor_id:\n470:             return\n471: \n472:         before_categories = _fetch_categories(client, recorder, 'a12-before-categories')\n473:         before_books = _fetch_bookmarks(client, recorder, 'a12-before-bookmarks')\n474:         before_category_ids = _category_ids(before_categories)\n475:         before_record_ids = _record_ids(before_books)\n476: \n477:         too_long = 'x' * 121\n478:         attempts = [\n479:             ('save-empty', 'bookmark', ''),\n480:             ('save-long', 'bookmark', too_long),\n481:             ('move-empty', 'move', ''),\n482:             ('move-long', 'move', too_long),\n483:         ]\n484:         for label, kind, category_value in attempts:\n485:             if kind == 'bookmark':\n486:                 response = client.post_json(\n487:                     '/api/bookmarks', {'url': _unique_url(f'a12-{label}'), 'category': category_value}\n488:                 )\n489:             else:\n490:                 response = client.post_json(_move_path(anchor_id), {'category': category_value})\n491:             recorder.expect_status(response, 400, aid=f'a12-{label}-status')\n492:             code = _error_code(response)\n493:             recorder.check(\n494:                 f'a12-{label}-code',\n495:                 code == 'invalid_category',\n496:                 f'{label} category={category_value[:24]!r} 错误码={code!r}（期望 invalid_category）',\n497:             )\n498: \n499:         after_categories = _fetch_categories(client, recorder, 'a12-after-categories')\n500:         after_books = _fetch_bookmarks(client, recorder, 'a12-after-bookmarks')\n501:         recorder.check(\n502:             'a12-categories-unchanged',\n503:             _category_ids(after_categories) == before_category_ids,\n504:             f'归类集合不变：{sorted(_category_ids(after_categories))}（原 {sorted(before_category_ids)}）',\n505:         )\n506:         recorder.check(\n507:             'a12-records-unchanged',\n508:             _record_ids(after_books) == before_record_ids,\n509:             f'记录集合不变：{len(before_record_ids)} -> {len(_record_ids(after_books))}',\n510:         )\n511:         names_after = _category_names(after_categories)\n512:         recorder.check('a12-no-empty-category', '' not in names_after, '非法请求未创建空名归类')\n513:         recorder.check('a12-no-long-category', too_long not in names_after, '非法请求未创建超长名归类')\n514: \n515:         fetched = client.get(_bookmark_path(anchor_id))\n516:         recorder.expect_status(fetched, 200, aid='a12-anchor-fetch-status')\n517:         stored_category = _record_category_name(_extract_record(_safe_json(fetched)))\n518:         if stored_category is not None:\n519:             recorder.check(\n520:                 'a12-anchor-unchanged-category',\n521:                 stored_category == common.DEFAULT_CATEGORY,\n522:                 f'被移动尝试的目标记录 category={stored_category!r}（期望 {common.DEFAULT_CATEGORY!r}）',\n523:             )\n524:     finally:\n525:         client.close()\n526: \n527: \n528: _HANDLERS = {\n529:     'A04': _case_a04,\n530:     'A05': _case_a05,\n531:     'A06': _case_a06,\n532:     'A12': _case_a12,\n533: }\n534: \n535: \n536: def main(argv=None):\n537:     args = common.parse_case_args(argv)\n538:     recorder = common.Recorder(args.case)\n539:     handler = _HANDLERS.get(args.case)\n540:     if handler is None:\n541:         recorder.check(\n542:             'dispatch',\n543:             False,\n544:             f'acceptance/p0_organize.py 不实现用例 {args.case}（应由其他程序派发）',\n545:         )\n546:     else:\n547:         try:\n548:             handler(args, recorder)\n549:         except common.AcceptanceError as exc:\n550:             recorder.check('infrastructure', False, f'验收基础设施错误：{exc}')\n551:         except Exception as exc:\n552:             recorder.check('unexpected-error', False, f'未预期错误：{type(exc).__name__}: {exc}')\n553:     return recorder.finish(args.case)\n554: \n555: \n556: if __name__ == '__main__':\n557:     sys.exit(main())","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file source/baseline/acceptance/p0_organize.py, lines 1-557\n1: #!/usr/bin/env python3\n2: '''P0 行为验收组：归类管理、记录移动、归类浏览与非法归类。\n3: \n4: 覆盖 A04、A05、A06、A12。仅使用 Python 3.12 标准库并复用\n5: acceptance/common.py：以 --case 派发，未知用例显式失败；每个用例对真实\n6: 目标执行正向与硬负向行为断言，向 stdout 输出单个\n7: atlas.acceptance-result.v1 JSON，失败时以非零码退出。\n8: '''\n9: \n10: from __future__ import annotations\n11: \n12: import os\n13: import sys\n14: import uuid\n15: from urllib.parse import quote\n16: \n17: _THIS_DIR = os.path.dirname(os.path.abspath(__file__))\n18: if _THIS_DIR not in sys.path:\n19:     sys.path.insert(0, _THIS_DIR)\n20: \n21: import common\n22: \n23: _SUCCESS_STATUSES = (200, 204)\n24: \n25: \n26: def _unique_url(tag):\n27:     token = f'{tag}-{uuid.uuid4().hex[:12]}'\n28:     return f'https://{token}.atlas-acceptance.example/{token}'\n29: \n30: \n31: def _unique_category(tag):\n32:     return f'atlas-{tag}-{uuid.uuid4().hex[:10]}'\n33: \n34: \n35: def _safe_json(response):\n36:     try:\n37:         return response.json()\n38:     except Exception:\n39:         return None\n40: \n41: \n42: def _extract_record(payload):\n43:     if isinstance(payload, dict):\n44:         for key in ('category', 'bookmark', 'record', 'data', 'item'):\n45:             value = payload.get(key)\n46:             if isinstance(value, dict):\n47:                 return value\n48:         return payload\n49:     return None\n50: \n51: \n52: def _record_id(record):\n53:     if isinstance(record, dict) and record.get('id') is not None:\n54:         return str(record['id'])\n55:     return None\n56: \n57: \n58: def _record_category_name(record):\n59:     if isinstance(record, dict):\n60:         for key in ('category', 'category_name'):\n61:             value = record.get(key)\n62:             if isinstance(value, str) and value:\n63:                 return value\n64:             if isinstance(value, dict) and value.get('name'):\n65:                 return str(value['name'])\n66:     return None\n67: \n68: \n69: def _error_code(response):\n70:     payload = _safe_json(response)\n71:     if isinstance(payload, dict):\n72:         error = payload.get('error')\n73:         if isinstance(error, dict) and error.get('code') is not None:\n74:             return str(error['code'])\n75:         for key in ('code', 'error_code'):\n76:             if payload.get(key) is not None:\n77:                 return str(payload[key])\n78:     return None\n79: \n80: \n81: def _extract_list(payload, keys):\n82:     if isinstance(payload, list):\n83:         return payload\n84:     if isinstance(payload, dict):\n85:         for key in keys:\n86:             value = payload.get(key)\n87:             if isinstance(value, list):\n88:                 return value\n89:     return None\n90: \n91: \n92: def _bookmark_path(bookmark_id):\n93:     return '/api/bookmarks/' + quote(str(bookmark_id), safe='')\n94: \n95: \n96: def _move_path(bookmark_id):\n97:     return _bookmark_path(bookmark_id) + '/move'\n98: \n99: \n100: def _category_path(category_id):\n101:     return '/api/categories/' + quote(str(category_id), safe='')\n102: \n103: \n104: def _fetch_bookmarks(client, recorder, aid, params=None):\n105:     response = client.get('/api/bookmarks', params=params)\n106:     recorder.expect_status(response, 200, aid=f'{aid}-list-status')\n107:     payload = _safe_json(response)\n108:     records = _extract_list(payload, ('bookmarks', 'items', 'data', 'records'))\n109:     recorder.check(\n110:         f'{aid}-list-shape',\n111:         isinstance(records, list),\n112:         f'GET /api/bookmarks 必须返回 JSON 数组，实际 {type(payload).__name__}',\n113:     )\n114:     return records if isinstance(records, list) else []\n115: \n116: \n117: def _fetch_categories(client, recorder, aid):\n118:     response = client.get('/api/categories')\n119:     recorder.expect_status(response, 200, aid=f'{aid}-categories-status')\n120:     payload = _safe_json(response)\n121:     categories = _extract_list(payload, ('categories', 'items', 'data'))\n122:     recorder.check(\n123:         f'{aid}-categories-shape',\n124:         isinstance(categories, list),\n125:         f'GET /api/categories 必须返回 JSON 数组，实际 {type(payload).__name__}',\n126:     )\n127:     return categories if isinstance(categories, list) else []\n128: \n129: \n130: def _category_names(categories):\n131:     names = set()\n132:     for item in categories:\n133:         if isinstance(item, dict) and item.get('name') is not None:\n134:             names.add(str(item['name']))\n135:     return names\n136: \n137: \n138: def _category_ids(categories):\n139:     ids = set()\n140:     for item in categories:\n141:         item_id = _record_id(item)\n142:         if item_id:\n143:             ids.add(item_id)\n144:     return ids\n145: \n146: \n147: def _find_category(categories, name):\n148:     target = str(name).casefold()\n149:     for item in categories:\n150:         if isinstance(item, dict) and item.get('name') is not None:\n151:             if str(item['name']).casefold() == target:\n152:                 return item\n153:     return None\n154: \n155: \n156: def _default_category(categories):\n157:     for item in categories:\n158:         if isinstance(item, dict) and item.get('is_default'):\n159:             return item\n160:     return _find_category(categories, common.DEFAULT_CATEGORY)\n161: \n162: \n163: def _record_ids(records):\n164:     return {item_id for item_id in (_record_id(record) for record in records) if item_id}\n165: \n166: \n167: def _create_record(client, recorder, aid, category=None, title=None):\n168:     url = _unique_url(aid)\n169:     payload = {'url': url}\n170:     if category is not None:\n171:         payload['category'] = category\n172:     if title is not None:\n173:         payload['title'] = title\n174:     response = client.post_json('/api/bookmarks', payload)\n175:     recorder.expect_status(response, 201, aid=f'{aid}-save-status')\n176:     record_id = _record_id(_extract_record(_safe_json(response)))\n177:     recorder.check(f'{aid}-save-id', bool(record_id), f'保存 {url} 返回 id={record_id!r}')\n178:     return record_id\n179: \n180: \n181: def _case_a04(args, recorder):\n182:     client = common.HttpClient(args.base_url)\n183:     try:\n184:         health = client.get('/api/health')\n185:         recorder.expect_status(health, 200, aid='a04-health-status')\n186: \n187:         name = _unique_category('a04')\n188:         created = client.post_json('/api/categories', {'name': name})\n189:         recorder.expect_status(created, 201, aid='a04-create-status')\n190:         category_id = _record_id(_extract_record(_safe_json(created)))\n191:         recorder.check('a04-create-id', bool(category_id), f'POST /api/categories 返回 id={category_id!r}')\n192: \n193:         listed = _fetch_categories(client, recorder, 'a04-listed')\n194:         recorder.check(\n195:             'a04-created-visible',\n196:             name in _category_names(listed),\n197:             f'GET /api/categories 含新建归类 {name!r}',\n198:         )\n199: \n200:         duplicate = client.post_json('/api/categories', {'name': name})\n201:         recorder.expect_status(duplicate, 409, aid='a04-duplicate-status')\n202:         recorder.check(\n203:             'a04-duplicate-code',\n204:             _error_code(duplicate) == 'duplicate_category',\n205:             f'同名再建错误码={_error_code(duplicate)!r}（期望 duplicate_category）',\n206:         )\n207: \n208:         variant = client.post_json('/api/categories', {'name': str(name).upper()})\n209:         recorder.expect_status(variant, 409, aid='a04-duplicate-case-status')\n210:         recorder.check(\n211:             'a04-duplicate-case-code',\n212:             _error_code(variant) == 'duplicate_category',\n213:             f'大小写变体再建错误码={_error_code(variant)!r}（期望 duplicate_category）',\n214:         )\n215: \n216:         if not category_id:\n217:             return\n218: \n219:         record_id = _create_record(client, recorder, 'a04', category=name)\n220:         if record_id:\n221:             in_new = _fetch_bookmarks(client, recorder, 'a04-in-new', params={'category': name})\n222:             recorder.check(\n223:                 'a04-record-in-new-category',\n224:                 record_id in _record_ids(in_new),\n225:                 f'记录 {record_id!r} 可在归类 {name!r} 中查到',\n226:             )\n227: \n228:         renamed_name = _unique_category('a04renamed')\n229:         renamed = client.patch_json(_category_path(category_id), {'name': renamed_name})\n230:         recorder.expect_status(renamed, _SUCCESS_STATUSES, aid='a04-rename-status')\n231:         after_rename = _fetch_categories(client, recorder, 'a04-after-rename')\n232:         names_after = _category_names(after_rename)\n233:         recorder.check(\n234:             'a04-rename-applied',\n235:             renamed_name in names_after,\n236:             f'重命名后新名 {renamed_name!r} 可见：{sorted(names_after)}',\n237:         )\n238:         recorder.check('a04-rename-old-absent', name not in names_after, f'重命名后旧名 {name!r} 不再出现')\n239:         if record_id:\n240:             by_renamed = _fetch_bookmarks(client, recorder, 'a04-by-renamed', params={'category': renamed_name})\n241:             recorder.check(\n242:                 'a04-record-follows-rename',\n243:                 record_id in _record_ids(by_renamed),\n244:                 f'重命名后记录 {record_id!r} 仍属于该归类',\n245:             )\n246:             stale = _fetch_bookmarks(client, recorder, 'a04-stale-name', params={'category': name})\n247:             recorder.check(\n248:                 'a04-unknown-category-empty',\n249:                 record_id not in _record_ids(stale),\n250:                 f'旧归类名 {name!r} 过滤不再返回该记录',\n251:             )\n252: \n253:         deleted = client.request('DELETE', _category_path(category_id))\n254:         recorder.expect_status(deleted, _SUCCESS_STATUSES, aid='a04-delete-status')\n255:         after_delete = _fetch_categories(client, recorder, 'a04-after-delete')\n256:         remaining = _category_names(after_delete)\n257:         recorder.check(\n258:             'a04-delete-applied',\n259:             renamed_name not in remaining,\n260:             f'删除后 {renamed_name!r} 不再出现：{sorted(remaining)}',\n261:         )\n262:         if record_id:\n263:             inbox = _fetch_bookmarks(client, recorder, 'a04-inbox', params={'category': common.DEFAULT_CATEGORY})\n264:             recorder.check(\n265:                 'a04-record-back-to-default',\n266:                 record_id in _record_ids(inbox),\n267:                 f'删除归类后记录 {record_id!r} 回到「{common.DEFAULT_CATEGORY}」',\n268:             )\n269:             fetched = client.get(_bookmark_path(record_id))\n270:             recorder.expect_status(fetched, 200, aid='a04-record-fetch-status')\n271:             category_name = _record_category_name(_extract_record(_safe_json(fetched)))\n272:             if category_name is not None:\n273:                 recorder.check(\n274:                     'a04-record-category-default',\n275:                     category_name == common.DEFAULT_CATEGORY,\n276:                     f'记录 category={category_name!r}（期望 {common.DEFAULT_CATEGORY!r}）',\n277:                 )\n278: \n279:         default_item = _default_category(after_delete)\n280:         default_id = _record_id(default_item)\n281:         if default_id:\n282:             delete_default = client.request('DELETE', _category_path(default_id))\n283:             recorder.expect_status(delete_default, 400, aid='a04-default-delete-status')\n284:             recorder.check(\n285:                 'a04-default-delete-code',\n286:                 _error_code(delete_default) == 'protected_category',\n287:                 f'删除默认归类错误码={_error_code(delete_default)!r}（期望 protected_category）',\n288:             )\n289:             rename_default = client.patch_json(_category_path(default_id), {'name': _unique_category('a04default')})\n290:             recorder.expect_status(rename_default, 400, aid='a04-default-rename-status')\n291:             recorder.check(\n292:                 'a04-default-rename-code',\n293:                 _error_code(rename_default) == 'protected_category',\n294:                 f'重命名默认归类错误码={_error_code(rename_default)!r}（期望 protected_category）',\n295:             )\n296:     finally:\n297:         client.close()\n298: \n299: \n300: def _a05_on_base_url(args, recorder):\n301:     client = common.HttpClient(args.base_url)\n302:     try:\n303:         health = client.get('/api/health')\n304:         recorder.expect_status(health, 200, aid='a05-health-status')\n305: \n306:         category_name = _unique_category('a05live')\n307:         record_id = _create_record(client, recorder, 'a05live')\n308:         if not record_id:\n309:             return\n310: \n311:         moved = client.post_json(_move_path(record_id), {'category': category_name})\n312:         recorder.expect_status(moved, _SUCCESS_STATUSES, aid='a05-live-move-status')\n313:         in_category = _fetch_bookmarks(client, recorder, 'a05-live-in', params={'category': category_name})\n314:         recorder.check(\n315:             'a05-live-move-visible',\n316:             record_id in _record_ids(in_category),\n317:             f'移动后 {record_id!r} 可在 {category_name!r} 中查到',\n318:         )\n319:         inbox = _fetch_bookmarks(client, recorder, 'a05-live-inbox', params={'category': common.DEFAULT_CATEGORY})\n320:         recorder.check(\n321:             'a05-live-left-default',\n322:             record_id not in _record_ids(inbox),\n323:             f'移动后 {record_id!r} 不再属于「{common.DEFAULT_CATEGORY}」',\n324:         )\n325:         fetched = client.get(_bookmark_path(record_id))\n326:         recorder.expect_status(fetched, 200, aid='a05-live-fetch-status')\n327:         stored_category = _record_category_name(_extract_record(_safe_json(fetched)))\n328:         if stored_category is not None:\n329:             recorder.check(\n330:                 'a05-live-record-category',\n331:                 stored_category == category_name,\n332:                 f'记录 category={stored_category!r}（期望 {category_name!r}）',\n333:             )\n334:     finally:\n335:         client.close()\n336: \n337: \n338: def _a05_across_restart(args, recorder):\n339:     first = common.launch_app(args.app_root, args.data_dir, 0)\n340:     instance_dir = first.instance_dir\n341:     category_name = _unique_category('a05restart')\n342:     record_id = None\n343:     try:\n344:         client = common.HttpClient(first.base_url)\n345:         try:\n346:             health = client.get('/api/health')\n347:             recorder.expect_status(health, 200, aid='a05-restart-health-status')\n348:             record_id = _create_record(client, recorder, 'a05restart')\n349:             if record_id:\n350:                 moved = client.post_json(_move_path(record_id), {'category': category_name})\n351:                 recorder.expect_status(moved, _SUCCESS_STATUSES, aid='a05-restart-move-status')\n352:                 in_category = _fetch_bookmarks(\n353:                     client, recorder, 'a05-restart-in', params={'category': category_name}\n354:                 )\n355:                 recorder.check(\n356:                     'a05-restart-move-visible',\n357:                     record_id in _record_ids(in_category),\n358:                     f'隔离实例移动后 {record_id!r} 可在 {category_name!r} 中查到',\n359:                 )\n360:         finally:\n361:             client.close()\n362:     finally:\n363:         common.stop_app(first)\n364: \n365:     if not record_id:\n366:         recorder.check('a05-restart-persist', False, '隔离实例未返回可用 id，无法验证归属跨重启')\n367:         return\n368: \n369:     second = common.launch_app(args.app_root, args.data_dir, 0, instance_dir=instance_dir)\n370:     try:\n371:         client = common.HttpClient(second.base_url)\n372:         try:\n373:             after = _fetch_bookmarks(client, recorder, 'a05-restart-after', params={'category': category_name})\n374:             recorder.check(\n375:                 'a05-restart-persist-visible',\n376:                 record_id in _record_ids(after),\n377:                 f'重启后 {record_id!r} 仍可在 {category_name!r} 中查到',\n378:             )\n379:             inbox = _fetch_bookmarks(\n380:                 client, recorder, 'a05-restart-inbox', params={'category': common.DEFAULT_CATEGORY}\n381:             )\n382:             recorder.check(\n383:                 'a05-restart-persist-not-default',\n384:                 record_id not in _record_ids(inbox),\n385:                 f'重启后 {record_id!r} 不回到「{common.DEFAULT_CATEGORY}」',\n386:             )\n387:             fetched = client.get(_bookmark_path(record_id))\n388:             recorder.expect_status(fetched, 200, aid='a05-restart-fetch-status')\n389:             stored_category = _record_category_name(_extract_record(_safe_json(fetched)))\n390:             if stored_category is not None:\n391:                 recorder.check(\n392:                     'a05-restart-record-category',\n393:                     stored_category == category_name,\n394:                     f'重启后 category={stored_category!r}（期望 {category_name!r}）',\n395:                 )\n396:         finally:\n397:             client.close()\n398:     finally:\n399:         common.stop_app(second)\n400: \n401: \n402: def _case_a05(args, recorder):\n403:     _a05_on_base_url(args, recorder)\n404:     _a05_across_restart(args, recorder)\n405: \n406: \n407: def _case_a06(args, recorder):\n408:     client = common.HttpClient(args.base_url)\n409:     try:\n410:         health = client.get('/api/health')\n411:         recorder.expect_status(health, 200, aid='a06-health-status')\n412: \n413:         category_a = _unique_category('a06a')\n414:         category_b = _unique_category('a06b')\n415:         for label, category_name in (('a', category_a), ('b', category_b)):\n416:             created = client.post_json('/api/categories', {'name': category_name})\n417:             recorder.expect_status(created, 201, aid=f'a06-create-{label}-status')\n418: \n419:         ids_a = [\n420:             record_id\n421:             for record_id in (\n422:                 _create_record(client, recorder, f'a06a-{index}', category=category_a) for index in range(1, 3)\n423:             )\n424:             if record_id\n425:         ]\n426:         ids_b = [\n427:             record_id\n428:             for record_id in (\n429:                 _create_record(client, recorder, f'a06b-{index}', category=category_b) for index in range(1, 3)\n430:             )\n431:             if record_id\n432:         ]\n433: \n434:         list_a = _fetch_bookmarks(client, recorder, 'a06-list-a', params={'category': category_a})\n435:         set_a = _record_ids(list_a)\n436:         list_b = _fetch_bookmarks(client, recorder, 'a06-list-b', params={'category': category_b})\n437:         set_b = _record_ids(list_b)\n438: \n439:         recorder.check(\n440:             'a06-a-exact',\n441:             bool(ids_a) and set_a == set(ids_a),\n442:             f'按 {category_a!r} 过滤返回 {sorted(set_a)}（期望 {sorted(set(ids_a))}）',\n443:         )\n444:         recorder.check(\n445:             'a06-b-exact',\n446:             bool(ids_b) and set_b == set(ids_b),\n447:             f'按 {category_b!r} 过滤返回 {sorted(set_b)}（期望 {sorted(set(ids_b))}）',\n448:         )\n449:         recorder.check('a06-disjoint', not (set_a & set_b), f'两类过滤结果不相交，交集={sorted(set_a & set_b)}')\n450: \n451:         categories = _fetch_categories(client, recorder, 'a06-categories')\n452:         item_a = _find_category(categories, category_a)\n453:         item_b = _find_category(categories, category_b)\n454:         count_a = item_a.get('count') if isinstance(item_a, dict) else None\n455:         count_b = item_b.get('count') if isinstance(item_b, dict) else None\n456:         recorder.check('a06-count-a', count_a == len(ids_a), f'归类 {category_a!r} 计数={count_a!r}（期望 {len(ids_a)}）')\n457:         recorder.check('a06-count-b', count_b == len(ids_b), f'归类 {category_b!r} 计数={count_b!r}（期望 {len(ids_b)}）')\n458:     finally:\n459:         client.close()\n460: \n461: \n462: def _case_a12(args, recorder):\n463:     client = common.HttpClient(args.base_url)\n464:     try:\n465:         health = client.get('/api/health')\n466:         recorder.expect_status(health, 200, aid='a12-health-status')\n467: \n468:         anchor_id = _create_record(client, recorder, 'a12-anchor')\n469:         if not anchor_id:\n470:             return\n471: \n472:         before_categories = _fetch_categories(client, recorder, 'a12-before-categories')\n473:         before_books = _fetch_bookmarks(client, recorder, 'a12-before-bookmarks')\n474:         before_category_ids = _category_ids(before_categories)\n475:         before_record_ids = _record_ids(before_books)\n476: \n477:         too_long = 'x' * 121\n478:         attempts = [\n479:             ('save-empty', 'bookmark', ''),\n480:             ('save-long', 'bookmark', too_long),\n481:             ('move-empty', 'move', ''),\n482:             ('move-long', 'move', too_long),\n483:         ]\n484:         for label, kind, category_value in attempts:\n485:             if kind == 'bookmark':\n486:                 response = client.post_json(\n487:                     '/api/bookmarks', {'url': _unique_url(f'a12-{label}'), 'category': category_value}\n488:                 )\n489:             else:\n490:                 response = client.post_json(_move_path(anchor_id), {'category': category_value})\n491:             recorder.expect_status(response, 400, aid=f'a12-{label}-status')\n492:             code = _error_code(response)\n493:             recorder.check(\n494:                 f'a12-{label}-code',\n495:                 code == 'invalid_category',\n496:                 f'{label} category={category_value[:24]!r} 错误码={code!r}（期望 invalid_category）',\n497:             )\n498: \n499:         after_categories = _fetch_categories(client, recorder, 'a12-after-categories')\n500:         after_books = _fetch_bookmarks(client, recorder, 'a12-after-bookmarks')\n501:         recorder.check(\n502:             'a12-categories-unchanged',\n503:             _category_ids(after_categories) == before_category_ids,\n504:             f'归类集合不变：{sorted(_category_ids(after_categories))}（原 {sorted(before_category_ids)}）',\n505:         )\n506:         recorder.check(\n507:             'a12-records-unchanged',\n508:             _record_ids(after_books) == before_record_ids,\n509:             f'记录集合不变：{len(before_record_ids)} -> {len(_record_ids(after_books))}',\n510:         )\n511:         names_after = _category_names(after_categories)\n512:         recorder.check('a12-no-empty-category', '' not in names_after, '非法请求未创建空名归类')\n513:         recorder.check('a12-no-long-category', too_long not in names_after, '非法请求未创建超长名归类')\n514: \n515:         fetched = client.get(_bookmark_path(anchor_id))\n516:         recorder.expect_status(fetched, 200, aid='a12-anchor-fetch-status')\n517:         stored_category = _record_category_name(_extract_record(_safe_json(fetched)))\n518:         if stored_category is not None:\n519:             recorder.check(\n520:                 'a12-anchor-unchanged-category',\n521:                 stored_category == common.DEFAULT_CATEGORY,\n522:                 f'被移动尝试的目标记录 category={stored_category!r}（期望 {common.DEFAULT_CATEGORY!r}）',\n523:             )\n524:     finally:\n525:         client.close()\n526: \n527: \n528: _HANDLERS = {\n529:     'A04': _case_a04,\n530:     'A05': _case_a05,\n531:     'A06': _case_a06,\n532:     'A12': _case_a12,\n533: }\n534: \n535: \n536: def main(argv=None):\n537:     args = common.parse_case_args(argv)\n538:     recorder = common.Recorder(args.case)\n539:     handler = _HANDLERS.get(args.case)\n540:     if handler is None:\n541:         recorder.check(\n542:             'dispatch',\n543:             False,\n544:             f'acceptance/p0_organize.py 不实现用例 {args.case}（应由其他程序派发）',\n545:         )\n546:     else:\n547:         try:\n548:             handler(args, recorder)\n549:         except common.AcceptanceError as exc:\n550:             recorder.check('infrastructure', False, f'验收基础设施错误：{exc}')\n551:         except Exception as exc:\n552:             recorder.check('unexpected-error', False, f'未预期错误：{type(exc).__name__}: {exc}')\n553:     return recorder.finish(args.case)\n554: \n555: \n556: if __name__ == '__main__':\n557:     sys.exit(main())"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"source/baseline/acceptance/p0_organize.py\",\"limit\":2000}"},"time":{"start":1792484158786,"end":1792484158918}}}}
