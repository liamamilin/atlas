st\": \"293c6fab073062eb832695528589a6d3df22c5c9500c16421419f21978a5621e\",\n63:    \"checkpoint_name\": \"blueprint-code-0-3\",\n64:    \"mode\": \"replace\",\n65:    \"patch\": [\n66:     {\n67:      \"new\": \"        path_only = f'pathonly{uuid.uuid4().hex[:12]}'\\n        query_only = f'queryonly{uuid.uuid4().hex[:12]}'\\n        url_a = f'https://{host_token}.atlas-acceptance.example/{path_only}?q={query_only}'\",\n68:      \"old\": \"        url_a = f'https://{host_token}.atlas-acceptance.example/notes/{uuid.uuid4().hex[:10]}'\"\n69:     },\n70:     {\n71:      \"new\": \"        # Tokens occur only in excluded fields of this target, never in allowed ones.\\n        for label, token_value in (('url-path', path_only), ('url-query', query_only), ('category-name', cat_a)):\\n            allowed_text = ' '.join((title_a, host_token + '.atlas-acceptance.example', desc_a)).lower()\\n            recorder.check(f'a07-{label}-isolated-token', token_value.lower() not in allowed_text,\\n                           '负例 token 不在目标记录 title/hostname/description')\\n            for scoped in (False, True):\\n                aid = f'a07-excludes-{label}-' + ('category' if scoped else 'all')\\n                params = {'q': token_value}\\n                if scoped:\\n                    params['category'] = cat_a\\n                results = _search(client, recorder, aid + '-json', params)\\n                recorder.check(aid + '-json-target-absent', id_a not in _record_ids(results),\\n                               'JSON 不因 URL path/query 或分类名而命中目标记录')\\n                html = _html_search(client, recorder, aid + '-html', search_form,\\n                                    cat_a if scoped else '', token_value)\\n                recorder.check(aid + '-html-target-absent', id_a not in _row_ids(html),\\n                               '实际搜索表单的记录行不因排除字段命中；不检查页面回显')\\n        # These positive controls also prove both entry points do not return always-empty.\\n        for label, positive_token in (('title', shared), ('hostname', host_token), ('description', desc_token)):\\n            positive_doc = _html_search(client, recorder, f'a07-html-positive-{label}',\\n                                        search_form, cat_a, positive_token.upper())\\n            recorder.check(f'a07-html-positive-{label}-hit', id_a in _row_ids(positive_doc),\\n                           '允许字段经真实 HTML 搜索表单仍命中同一记录')\\n        doc_empty = _html_search(client, recorder, 'a07-html-empty', search_form, cat_a, unmatched)\",\n72:      \"old\": \"        doc_empty = _html_search(client, recorder, 'a07-html-empty', search_form, cat_a, unmatched)\"\n73:     }\n74:    ],\n75:    \"patch_digest\": \"ba5c0ac00060bbeb1558b13172afec12e1d5a06de6edf3c6a1ac135aece0037b\",\n76:    \"path\": \"acceptance/p0_find_open.py\",\n77:    \"prepared_ref\": \"docs/template-factory/g1-r7-acceptance-alignment-2026-10-20/prepared-programs/acceptance/p0_find_open.py\",\n78:    \"source_attempt\": 1,\n79:    \"source_job_id\": \"job_f3e32b56036b4ec7bea0c00d6a2a8dc4\"\n80:   },\n81:   {\n82:    \"after_sha256\": \"372c75aa2944a10cc5146859dc0bacd0e03111defe7c8aa75ece2d28ec45aff3\",\n83:    \"authorization_clause\": \"R7 §3.0 exact byte-for-byte reuse\",\n84:    \"before_sha256\": \"372c75aa2944a10cc5146859dc0bacd0e03111defe7c8aa75ece2d28ec45aff3\",\n85:    \"checkpoint_digest\": \"7f238639de648816407a16be5044c27fa706dec1d1480c6731a99e369eb99b16\",\n86:    \"checkpoint_name\": \"blueprint-code-0-4\",\n87:    \"mode\": \"reuse\",\n88:    \"patch\": [],\n89:    \"patch_digest\": \"4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945\",\n90:    \"path\": \"acceptance/p0_recovery.py\",\n91:    \"prepared_ref\": \"docs/template-factory/g1-r7-acceptance-alignment-2026-10-20/prepared-programs/acceptance/p0_recovery.py\",\n92:    \"source_attempt\": 1,\n93:    \"source_job_id\": \"job_f3e32b56036b4ec7bea0c00d6a2a8dc4\"\n94:   },\n95:   {\n96:    \"after_sha256\": \"d44e17c87314db18084b3b88bd2c700a75bfe583d108e9b518040fb8378601a3\",\n97:    \"authorization_clause\": \"R7 §3.0 exact byte-for-byte reuse\",\n98:    \"before_sha256\": \"d44e17c87314db18084b3b88bd2c700a75bfe583d108e9b518040fb8378601a3\",\n99:    \"checkpoint_digest\": \"0bc21e0d36d335238ffd5f97a5a2709fcceafc480be1186182083f4f6716e7ea\",\n100:    \"checkpoint_name\": \"blueprint-code-0-5\",\n101:    \"mode\": \"reuse\",\n102:    \"patch\": [],\n103:    \"patch_digest\": \"4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945\",\n104:    \"path\": \"acceptance/p1_maturity.py\",\n105:    \"prepared_ref\": \"docs/template-factory/g1-r7-acceptance-alignment-2026-10-20/prepared-programs/acceptance/p1_maturity.py\",\n106:    \"source_attempt\": 1,\n107:    \"source_job_id\": \"job_f3e32b56036b4ec7bea0c00d6a2a8dc4\"\n108:   },\n109:   {\n110:    \"after_sha256\": \"f1fc18b605a1eea93892d319d09122d91033a48dfd4b913f8f262a4dc8633deb\",\n111:    \"authorization_clause\": \"R7 §3.0 exact byte-for-byte reuse\",\n112:    \"before_sha256\": \"f1fc18b605a1eea93892d319d09122d91033a48dfd4b913f8f262a4dc8633deb\",\n113:    \"checkpoint_digest\": \"cb630836a7b32a2ae7df6b836e4ceb2bfed9cb3b3048e002ef91df979bec6ea2\",\n114:    \"checkpoint_name\": \"blueprint-code-0-6\",\n115:    \"mode\": \"reuse\",\n116:    \"patch\": [],\n117:    \"patch_digest\": \"4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945\",\n118:    \"path\": \"acceptance/requirements.txt\",\n119:    \"prepared_ref\": \"docs/template-factory/g1-r7-acceptance-alignment-2026-10-20/prepared-programs/acceptance/requirements.txt\",\n120:    \"source_attempt\": 1,\n121:    \"source_job_id\": \"job_f3e32b56036b4ec7bea0c00d6a2a8dc4\"\n122:   },\n123:   {\n124:    \"after_sha256\": \"9e73ee6233e5b991a9682bb0bcaa235783bd4c7a6d399d5be38c100face9db6e\",\n125:    \"authorization_clause\": \"R7 §5.4 README factual correction only\",\n126:    \"before_sha256\": \"01cf57941aeed3e0bfa431349b832429f4518addebd00528e8bc1a33ff189459\",\n127:    \"checkpoint_digest\": \"98ec076f0980147323606a89081e18bd32dc85b393fd4ba7e2cf69e4a6bb8f3a\",\n128:    \"checkpoint_name\": \"blueprint-code-0-7\",\n129:    \"mode\": \"replace\",\n130:    \"patch\": [\n131:     {\n132:      \"new\": \"# 生活待购与灵感收藏夹 — 验收运行说明\\n\\n本目录是一套独立、冻结的验收套件，用真实 HTTP 目标验证 python-web 应用。它不包含应用实现，不导入应用代码，也不读取应用自己的测试判定；本文档只是运行说明，不代表任何用例已经执行或通过。**本套件未执行，任何人不得据此声称测试通过。**\\n\\n## 1. 目标适配器\\n\\n| 参数 | 适用范围 | 用途 |\\n| --- | --- | --- |\\n| `--base-url` | A01–A15（全部） | 已部署 python-web 实例的 http/https 根 URL；所有 base_url 行为断言都发往该 origin。 |\\n| `--app-root` | A01、A05、A09、A11 | 只读应用源码根；必须包含 `app/serve.py`，用于启动同一冻结应用的隔离实例。 |\\n| `--data-dir` | A01、A05、A09、A11、A14 | 测试者可变草稿根；重启适配器在其 `instances/` 下创建每实例目录；A14 在此生成导入 HTML。 |\\n\\n### 1.1 `--base-url`\\n\\n- 示例：`http://127.0.0.1:8000`。必须是 http 或 https；不得包含用户名、口令、查询串或片段。\\n- 验收目标声明无认证；套件不会把凭据放入 URL、请求头、日志或 fixtures。`HttpClient` 拒绝 `Authorization`/`Proxy-Authorization`；若目标要求 Basic/Bearer/session 等认证，或健康检查返回 401/403，程序在业务请求前显式失败并报告基础设施未就绪，不支持认证适配器，也不跳过或伪造通过。\\n- 每个请求都绑定到该精确 origin（scheme、hostname、port）；重定向逐跳校验，跨源立即失败。不会放行任意 loopback 主机或端口，也不默认信任所有 localhost 端口。\\n\\n### 1.2 `--app-root`、`--data-dir` 与每实例隔离\\n\\n- `--app-root` 是只读源码，必须存在 `<app_root>/app/serve.py`。套件只读取和启动它，不修改它，也不读取应用的自测判定。\\n- `--data-dir` 只是测试者的草稿根目录，必须可写，且不得等于 `--app-root` 或 `/`。\\n- `launch_app` 在 `<data_dir>/instances/` 下创建 `<uuid>/`，并把该子目录作为应用 `--data-dir`。应用数据库（如 `bookmarks.sqlite3`）位于实例子目录内；宿主 `<data_dir>` 根目录绝不作为应用数据库。\\n- 需要重启的用例复用第一次的实例子目录；日志写到 `<data_dir>/instances/<uuid>/logs/app-*.log`。\\n- A14 在 `<data_dir>` 根写入 `import-<token>.html`，仅作为 `/api/import` 的输入；它不是数据库，也不代表目标响应。\\n\\n### 1.3 重启持久化适配器\\n\\nA01、A05、A09 使用以下真实进程适配器（cwd 为 `app_root`）：\\n\\n`[当前 Python 解释器 (sys.executable), \\\"<app_root>/app/serve.py\\\", \\\"--host\\\", \\\"127.0.0.1\\\", \\\"--port\\\", \\\"<free_port()>\\\", \\\"--data-dir\\\", \\\"<data_dir>/instances/<uuid>\\\"]`\\n\\n- 启动时移除代理环境变量，stdout/stderr 写入实例日志；轮询 `GET /api/health`，仅当返回 200 且 JSON 对象时视为就绪（默认 30 秒）。\\n- 对隔离实例执行真实创建/移动/删除等动作，然后 `stop_app`（SIGTERM，超时后 SIGKILL），再以相同实例子目录启动同一冻结应用，读回并断言行为。\\n- 该重启证据只证明从 `app_root` 启动的隔离实例可持久化，不证明 `--base-url` 指向的已部署实例可重启。若外部目标只读且不可重启，重启部分必须显式报告未验证或失败，不能以健康检查或新进程替代。\\n\\n## 2. 运行时要求与依赖\\n\\n- 交付 profile：`python-web`。\\n- Python 3.12；仅使用标准库（`http.server`、`sqlite... (line truncated to 2000 chars)\n133:      \"old\": \"# 生活待购与灵感收藏夹 — 验收运行说明\\n\\n本目录是一套独立、冻结的验收套件，用真实 HTTP 目标验证 python-web 应用。它不包含应用实现，不导入应用代码，也不读取应用自己的测试判定；本文档只是运行说明，不代表任何用例已经执行或通过。**本套件未执行，任何人不得据此声称测试通过。**\\n\\n## 1. 目标适配器\\n\\n| 参数 | 适用范围 | 用途 |\\n| --- | --- | --- |\\n| `--base-url` | A01–A15（全部） | 已部署 python-web 实例的 http/https 根 URL；所有 base_url 行为断言都发往该 origin。 |\\n| `--app-root` | A01、A05、A09 | 只读应用源码根；必须包含 `app/serve.py`，用于启动同一冻结应用的隔离实例。 |\\n| `--data-dir` | A01、A05、A09、A14 | 测试者可变草稿根；重启适配器在其 `instances/` 下创建每实例目录；A14 在此生成导入 HTML。 |\\n\\n### 1.1 `--base-url`\\n\\n- 示例：`http://127.0.0.1:8000`。必须是 http 或 https；不得包含用户名、口令、查询串或片段。\\n- 验收目标声明无认证；套件不会把凭据放入 URL、请求头、日志或 fixtures。`HttpClient` 拒绝 `Authorization`/`Proxy-Authorization`；若目标要求 Basic/Bearer/session 等认证，或健康检查返回 401/403，程序在业务请求前显式失败并报告基础设施未就绪，不支持认证适配器，也不跳过或伪造通过。\\n- 每个请求都绑定到该精确 origin（scheme、hostname、port）；重定向逐跳校验，跨源立即失败。不会放行任意 loopback 主机或端口，也不默认信任所有 localhost 端口。\\n\\n### 1.2 `--app-root`、`--data-dir` 与每实例隔离\\n\\n- `--app-root` 是只读源码，必须存在 `<app_root>/app/serve.py`。套件只读取和启动它，不修改它，也不读取应用的自测判定。\\n- `--data-dir` 只是测试者的草稿根目录，必须可写，且不得等于 `--app-root` 或 `/`。\\n- `launch_app` 在 `<data_dir>/instances/` 下创建 `<uuid>/`，并把该子目录作为应用 `--data-dir`。应用数据库（如 `bookmarks.sqlite3`）位于实例子目录内；宿主 `<data_dir>` 根目录绝不作为应用数据库。\\n- 需要重启的用例复用第一次的实例子目录；日志写到 `<data_dir>/instances/<uuid>/logs/app-*.log`。\\n- A14 在 `<data_dir>` 根写入 `import-<token>.html`，仅作为 `/api/import` 的输入；它不是数据库，也不代表目标响应。\\n\\n### 1.3 重启持久化适配器\\n\\nA01、A05、A09 使用以下真实进程适配器（cwd 为 `app_root`）：\\n\\n`[当前 Python 解释器 (sys.executable), \\\"<app_root>/app/serve.py\\\", \\\"--host\\\", \\\"127.0.0.1\\\", \\\"--port\\\", \\\"<free_port()>\\\", \\\"--data-dir\\\", \\\"<data_dir>/instances/<uuid>\\\"]`\\n\\n- 启动时