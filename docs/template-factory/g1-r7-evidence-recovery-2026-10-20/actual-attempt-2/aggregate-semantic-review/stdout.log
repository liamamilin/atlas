1788:                         _form_path(move_form, '/'),\n1789:                         _form_fields(move_form, {'category_id': target_id}),\n1790:                         follow_redirects=False,\n1791:                         accept='text/html',\n1792:                     )\n1793:                     page, location = _follow_303(\n1794:                         client, recorder, response,\n1795:                         'a05-restart-move', expected_path='/',\n1796:                     )\n1797:                     if page is not None:\n1798:                         before_stop = _fetch_bookmarks(\n1799:                             client, recorder, 'a05-restart-before-stop',\n1800:                             params={'category': target_name},\n1801:                         )\n1802:                         recorder.check(\n1803:                             'a05-restart-before-stop-visible',\n1804:                             record_id in _record_ids(before_stop),\n1805:                             f'停止前记录 {record_id!r} 已在归类 {target_name!r}',\n1806:                         )\n1807:         finally:\n1808:             client.close()\n1809:     finally:\n1810:         common.stop_app(first)\n1811: \n1812:     if not recorder.check(\n1813:         'a05-restart-prerequisite',\n1814:         bool(target_id) and bool(record_id),\n1815:         f'隔离实例未提供目标归类或记录（target_id={target_id!r}, record_id={record_id!r}）',\n1816:     ):\n1817:         return\n1818: \n1819:     second = common.launch_app(\n1820:         args.app_root, args.data_dir, 0, instance_dir=instance_dir\n1821:     )\n1822:     try:\n1823:         client = common.HttpClient(second.base_url)\n1824:         try:\n1825:             categories = _fetch_categories(\n1826:                 client, recorder, 'a05-restart-categories'\n1827:             )\n1828:             target = _find_category_by_id(categories, target_id)\n1829:             recorder.check(\n1830:                 'a05-restart-category-id',\n1831:                 target is not None and _record_id(target) == target_id,\n1832:                 f'重启后归类 {target_name!r} 的 id 保持 {target_id!r}',\n1833:             )\n1834:             fetched = _get_record_json(\n1835:                 client, recorder, 'a05-restart-record-json', record_id\n1836:             )\n1837:             if fetched is not None:\n1838:                 actual = _record_category_name(fetched, categories)\n1839:                 recorder.check(\n1840:                     'a05-restart-record-category',\n1841:                     actual == target_name,\n1842:                     f'重启后记录 category={actual!r}（期望 {target_name!r}）',\n1843:                 )\n1844:             new_doc = _home_page(\n1845:                 client, recorder, 'a05-restart-html-new',\n1846:                 params={'category': target_name},\n1847:             )\n1848:             recorder.check(\n1849:                 'a05-restart-html-visible',\n1850:                 record_id in _row_ids(new_doc),\n1851:                 f'重启后归类 {target_name!r} 的 HTML 列表包含记录 {record_id!r}',\n1852:             )\n1853:             old_doc = _home_page(\n1854:                 client, recorder, 'a05-restart-html-old',\n1855:                 params={'category': common.DEFAULT_CATEGORY},\n1856:             )\n1857:             recorder.check(\n1858:                 'a05-restart-html-old-absent',\n1859:                 record_id not in _row_ids(old_doc),\n1860:                 f'重启后「{common.DEFAULT_CATEGORY}」不再包含记录 {record_id!r}',\n1861:             )\n1862:         finally:\n1863:             client.close()\n1864:     finally:\n1865:         common.stop_app(second)\n1866: \n1867: \n1868: def _case_a05(args, recorder):\n1869:     _a05_on_base_url(args, recorder)\n1870:     _a05_across_restart(args, recorder)\n1871: \n1872: \n1873: def _check_category_state(client, recorder, prefix, expectations):\n1874:     categories = _fetch_categories(\n1875:         client, recorder, f'{prefix}-api-categories'\n1876:     )\n1877:     for label, name, category_id, expected_ids in expectations:\n1878:         item = _find_category_by_id(categories, category_id)\n1879:         if not isinstance(item, dict):\n1880:             item = _find_category_by_name(categories, name)\n1881:         count = item.get('count') if isinstance(item, dict) else None\n1882:         recorder.check(\n1883:             f'{prefix}-api-count-{label}',\n1884:             count == len(expected_ids),\n1885:             f'归类 {name!r} API count={count!r}（期望活动记录数 {len(expected_ids)}）',\n1886:         )\n1887:         listed = _fetch_bookmarks(\n1888:             client, recorder, f'{prefix}-api-list-{label}',\n1889:             params={'category': name},\n1890:         )\n1891:         actual_ids = _record_ids(listed)\n1892:         recorder.check(\n1893:             f'{prefix}-api-list-{label}',\n1894:             actual_ids == set(expected_ids),\n1895:             f'归类 {name!r} API 列表={sorted(actual_ids)}（期望 {sorted(set(expected_ids))}）',\n1896:         )\n1897: \n1898:     home_doc = _home_page(client, recorder, f'{prefix}-html-home')\n1899:     home_counts = _category_count_values(home_doc)\n1900:     for label, name, category_id, expected_ids in expectations:\n1901:         values = home_counts.get(category_id, [])\n1902:         recorder.check(\n1903:             f'{prefix}-html-home-count-{label}',\n1904:             bool(values) and all(value == len(expected_ids) for value in values),\n1905:             f'归类 {name!r} 首页 HTML 计数={values!r}（期望 {len(expected_ids)}）',\n1906:         )\n1907: \n1908:     categories_doc = _categories_page(\n1909:         client, recorder, f'{prefix}-html-categories'\n1910:     )\n1911:     categories_counts = _category_count_values(categories_doc)\n1912:     for label, name, category_id, expected_ids in expectations:\n1913:         values = categories_counts.get(category_id, [])\n1914:         recorder.check(\n1915:             f'{prefix}-html-categories-count-{label}',\n1916:             bool(values) and all(value == len(expected_ids) for value in values),\n1917:             f'归类 {name!r} /categories HTML 计数={values!r}（期望 {len(expected_ids)}）',\n1918:         )\n1919: \n1920:     for label, name, category_id, expected_ids in expectations:\n1921:         filtered_doc = _home_page(\n1922:             client, recorder, f'{prefix}-html-filtered-{label}',\n1923:             params={'category': name},\n1924:         )\n1925:         actual_ids = _row_ids(filtered_doc)\n1926:         recorder.check(\n1927:             f'{prefix}-html-rows-{label}',\n1928:             actual_ids == set(expected_ids),\n1929:             f'归类 {name!r} HTML 记录行={sorted(actual_ids)}（期望 {sorted(set(expected_ids))}）',\n1930:         )\n1931: \n1932: \n1933: def _case_a06(args, recorder):\n1934:     client = common.HttpClient(args.base_url)\n1935:     try:\n1936:         health = client.get('/api/health')\n1937:         recorder.expect_status(health, 200, aid='a06-health-status')\n1938:         name_a = _unique_category('a06a')\n1939:         name_b = _unique_category('a06b')\n1940:         id_a = _create_category_json(client, recorder, 'a06-category-a', name_a)\n1941:         id_b = _create_category_json(client, recorder, 'a06-category-b', name_b)\n1942:         if not recorder.check(\n1943:             'a06-prerequisites',\n1944:             bool(id_a) and bool(id_b),\n1945:             f'两个归类 id：a={id_a!r}, b={id_b!r}',\n1946:         ):\n1947:             return\n1948:         ids_a = []\n1949:         for index in (1, 2):\n1950:             record_id, _ = _create_record_json(\n1951:                 client, recorder, f'a06-a-{index}', category=name_a,\n1952:                 title=f'A06 A{index} {uuid.uuid4().hex[:8]}',\n1953:                 description=f'A06 A 描述 {index}',\n1954:             )\n1955:             if record_id:\n1956:                 ids_a.append(record_id)\n1957:         ids_b = []\n1958:         for index in (1, 2):\n1959:             record_id, _ = _create_record_json(\n1960:                 client, recorder, f'a06-b-{index}', category=name_b,\n1961:                 title=f'A06 B{index} {uuid.uuid4().hex[:8]}',\n1962:                 description=f'A06 B 描述 {index}',\n1963:             )\n1964:             if record_id:\n1965:                 ids_b.append(record_id)\n1966:         if not recorder.check(\n1967:             'a06-record-setup',\n1968:             len(ids_a) == 2 and len(ids_b) == 2,\n1969:             f'两个归类各两条记录：A={ids_a!r}, B={ids_b!r}',\n1970:         ):\n1971:             return\n1972: \n1973:         expectations = (\n1974:             ('a', name_a, id_a, ids_a),\n1975:             ('b', name_b, id_b, ids_b),\n1976:         )\n1977:         _check_category_state(client, recorder, 'a06-initial', expectations)\n1978: \n1979:         doc = _home_page(\n1980:             client, recorder, 'a06-move-source', params={'category': name_a}\n1981:         )\n1982:         move_form = _find_record_form(doc, 'record-move-form', ids_a[0])\n1983:         if not recorder.check(\n1984:             'a06-move-form',\n1985:             move_form is not None,\n1986:             f'归类 {name_a!r} 的记录行含 record-move-form',\n1987:         ):\n1988:             return\n1989:         options = _select_values(move_form, 'category_id')\n1990:         recorder.check(\n1991:             'a06-move-options',\n1992:             id_b in options,\n1993:             f'record-move-form 的 category_id 选项包含目标 {id_b!r}；实际 {options!r}',\n1994:         )\n1995:         response = client.post_form(\n1996:             _form_path(move_form, '/'),\n1997:             _form_fields(move_form, {'category_id': id_b}),\n1998:             follow_redirects=False,\n1999:             accept='text/html',\n2000:         )\n2001:         page, location = _follow_303(\n2002:             client, recorder, response, 'a06-move', expected_path='/'\n2003:         )\n2004:         if page is None:\n2005:             return\n2006:         actual_query = {}\n