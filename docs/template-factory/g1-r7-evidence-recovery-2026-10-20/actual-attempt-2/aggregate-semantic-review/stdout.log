, f'未知 id 打开错误码={code!r}（期望 not_found）')\n227: \n228:         if record_id:\n229:             fetched = client.get(_bookmark_path(record_id))\n230:             recorder.expect_status(fetched, 200, aid='a08-readback-status')\n231:             stored = _extract_record(_safe_json(fetched))\n232:             recorder.check(\n233:                 'a08-url-unchanged',\n234:                 _record_url(stored) == target_url,\n235:                 f'打开动作后记录 url={_record_url(stored)!r}（未被改写，期望 {target_url!r}）',\n236:             )\n237:     finally:\n238:         client.close()\n239: \n240: \n241: _HANDLERS = {\n242:     'A07': _case_a07,\n243:     'A08': _case_a08,\n244: }\n245: \n246: \n247: def main(argv=None):\n248:     args = common.parse_case_args(argv)\n249:     recorder = common.Recorder(args.case)\n250:     handler = _HANDLERS.get(args.case)\n251:     if handler is None:\n252:         recorder.check(\n253:             'dispatch',\n254:             False,\n255:             f'acceptance/p0_find_open.py 不实现用例 {args.case}（应由其他程序派发）',\n256:         )\n257:     else:\n258:         try:\n259:             handler(args, recorder)\n260:         except common.AcceptanceError as exc:\n261:             recorder.check('infrastructure', False, f'验收基础设施错误：{exc}')\n262:         except Exception as exc:\n263:             recorder.check('unexpected-error', False, f'未预期错误：{type(exc).__name__}: {exc}')\n264:     return recorder.finish(args.case)\n265: \n266: \n267: if __name__ == '__main__':\n268:     sys.exit(main())"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"source/baseline/acceptance/p0_find_open.py\",\"limit\":2000}"},"time":{"start":1792484137105,"end":1792484137346}}}}
