oint_name\": \"case-adaptation-prepared-aaf080ba52611126\",\n2821:     \"cli_total\": 71,\n2822:     \"facts_view_checkpoint_digest\": \"8598295bca5580dec40dc1fa56b9b421d775d668a498b3ea3115fbae29141d4f\",\n2823:     \"facts_view_checkpoint_name\": \"blueprint-accepted-facts-view\",\n2824:     \"facts_view_digest\": \"241bf3d99ff497c30be8349cbc70529e08df6146736cb749b55268271889aa4b\",\n2825:     \"job_error_digest\": \"875228a6789a5f44128a071fa9eeb31097d2adc4d9eed516f5b42ad2da925f41\",\n2826:     \"job_id\": \"job_f3e32b56036b4ec7bea0c00d6a2a8dc4\",\n2827:     \"old_grant_id\": \"pgrant_f3595368c14d4b23b6ab536f6d198007\",\n2828:     \"old_grant_used\": 1,\n2829:     \"plan_checkpoint_digest\": \"6f806d9416cd1c5a724e980dece7330dac651c8a838d469db409d940a493f158\",\n2830:     \"plan_checkpoint_name\": \"blueprint-plan-0\",\n2831:     \"plan_digest\": \"1f7701fbf5f52dde011dee76196b2cb01697e10190c6ad17c1273f4b5dcc3d30\",\n2832:     \"plan_id\": \"plan_87059846caf345d2b2fe690657cf324f\",\n2833:     \"previous_amendment_id\": \"bamd_100a302fe8424d9493dafe62d6e43db9\",\n2834:     \"product_id\": \"product-c42848f63251507bd9d911a5\",\n2835:     \"proposal_digest\": \"6f806d9416cd1c5a724e980dece7330dac651c8a838d469db409d940a493f158\",\n2836:     \"scenario_id\": \"scn_7756e0007f6a463a97316f3f49c15248\",\n2837:     \"scenario_revision\": 2,\n2838:     \"snapshot_digest\": \"23ecd1327b4dc8bcda041575d28a74fe118c38914e2117278fff31304e60cdae\",\n2839:     \"stage\": \"aggregate-semantic-review\"\n2840:    },\n2841:    \"prepared_effective_plan_digest\": \"e7b9e82beb121a4d73852e556eac0eeefd2406af2cd4a3f8fc6489eea4944f54\",\n2842:    \"case_design_digest\": \"0b627399d035068eab902f1fa28a01eb9f6b32d3513d70441b77894e7f0b77c6\",\n2843:    \"prepared_incremental_diff\": {\n2844:     \"base_proposal_digest\": \"6f806d9416cd1c5a724e980dece7330dac651c8a838d469db409d940a493f158\",\n2845:     \"case_design_changes\": [\n2846:      {\n2847:       \"choice_id\": \"F11: the library is delivered as server-rendered HTML pages and forms with POST/redirect/GET for add, edit and organize actions, including a ready empty-library view.\",\n2848:       \"new\": \"F11: the library is delivered as Python server-rendered HTML pages and forms using POST/redirect/GET for saving records, managing categories, moving records between categories, and soft-delete/restore, including a ready empty-library view. P0 has no standalone record-editing page; record URL updates retain only the existing PATCH /api/bookmarks/{id} contract.\",\n2849:       \"old\": \"F11: the library is delivered as server-rendered HTML pages and forms with POST/redirect/GET for add, edit and organize actions, including a ready empty-library view.\",\n2850:       \"path\": [\n2851:        \"capability\"\n2852:       ]\n2853:      },\n2854:      {\n2855:       \"choice_id\": \"F11: the library is delivered as server-rendered HTML pages and forms with POST/redirect/GET for add, edit and organize actions, including a ready empty-library view.\",\n2856:       \"new\": \"The evidence describes a client-mounted SPA: Edit is an in-page dialog populated from item fields, and component creation loads Dexie rows into a client RippleMap. The target implements the already-declared P0 save, category-management, move and soft-delete/restore journeys as Python 3.12 HTML responses. Source SPA mounting, client-side dialog state and Dexie hydration are not carried over. The source Edit dialog does not imply a target record-editing UI; the existing PATCH API retains URL updates and recomputes hostname when the URL changes. The save-now/find-later loop and ready empty state remain the target intent.\",\n2857:       \"old\": \"The evidence describes a client-mounted SPA: Edit is an in-page dialog populated from item fields, and component creation loads Dexie rows into a client RippleMap. The target renders lists, forms and empty state as Python 3.12 HTML responses, so the SPA mount, client-side dialog state and Dexie hydration are not carried over; only the save-now/find-later user loop is retained.\",\n2858:       \"path\": [\n2859:        \"reason\"\n2860:       ]\n2861:      },\n2862:      {\n2863:       \"choice_id\": \"A deliberate save creates a URL-anchored record with a stable id, derived hostname, createdAt and initial state, and later edits preserve the record identity and creation/visit fields.\",\n2864:       \"new\": \"A deliberate save creates a URL-anchored record with a stable id, a locally derived hostname, creation time and initial active state. Later changes preserve the record id and creation time; updating the URL recomputes hostname from the new URL. The adopted capability is this identity and creation lifecycle; visitCount and visitedAt are not target fields or P0 obligations.\",\n2865:       \"old\": \"A deliberate save creates a URL-anchored record with a stable id, derived hostname, createdAt and initial state, and later edits preserve the record identity and creation/visit fields.\",\n2866:       \"path\": [\n2867:        \"capability\"\n2868:       ]\n2869:      },\n2870:      {\n2871:       \"choice_id\": \"A deliberate save creates a URL-anchored record with a stable id, derived hostname, createdAt and initial state, and later edits preserve the record identity and creation/visit fields.\",\n2872:       \"new\": \"The accepted observation records the source's bm-prefixed UUID identity, hostname derivation, createdAt, initial flags and visit fields, and preservation of identity and creation/visit fields on edit. These remain source observations. The target adopts stable record identity and creation time, represented by its existing id/created_at model and made durable by SQLite; it does not import the source's visitCount/visitedAt fields, which F24 excludes. URL updates follow the existing PATCH contract and derive hostname again. The source's tag constraints and other state fields are not silently imported into the category or target data model.\",\n2873:       \"old\": \"Evidence defines bm-prefixed UUID identity, hostname derivation, createdAt and default state, and preserves id/createdAt/visit fields on edit. The target adopts this record lifecycle as a user-facing capability, with SQLite providing durability; the source's free-text tag constraints are treated separately in the category decision, not silently imported as target rules.\",\n2874:       \"path\": [\n2875:        \"reason\"\n2876:       ]\n2877:      }\n2878:     ],\n2879:     \"effective_plan_digest\": \"e7b9e82beb121a4d73852e556eac0eeefd2406af2cd4a3f8fc6489eea4944f54\",\n2880:     \"program_changes\": [\n2881:      {\n2882:       \"after_sha256\": \"5923bdd1d15e7d98bcf2c3b91123b36d986c0c69cbc6a1a7fdab80ce4c437d6e\",\n2883:       \"before_sha256\": \"8a5ce953288f2b09b9cc0256d869fc7dca2a3dcd3ff255dc5dd5dfa2fa51fb67\",\n2884:       \"patch_digest\": \"98753fcaafc6bb575e92d70cae8841919fe32f894bd0de48de4ed7e9ad8713fb\",\n2885:       \"path\": \"acceptance/p0_library.py\"\n2886:      },\n2887:      {\n2888:       \"after_sha256\": \"342e38d2298cf48e22fb97d76e080ce4a67c3c10a942502c5ef205954878d667\",\n2889:       \"before_sha256\": \"4ba2fa6d2a6d3b306d6be5f82ef63604b836cf3d84bd0fc5efddf4d64683a6da\",\n2890:       \"patch_digest\": \"ba5c0ac00060bbeb1558b13172afec12e1d5a06de6edf3c6a1ac135aece0037b\",\n2891:       \"path\": \"acceptance/p0_find_open.py\"\n2892:      },\n2893:      {\n2894:       \"after_sha256\": \"9e73ee6233e5b991a9682bb0bcaa235783bd4c7a6d399d5be38c100face9db6e\",\n2895:       \"before_sha256\": \"01cf57941aeed3e0bfa431349b832429f4518addebd00528e8bc1a33ff189459\",\n2896:       \"patch_digest\": \"6249f00b1e87bb790c446cfb85f31c89de16fd44817cb17e9d8c968bc8faa89c\",\n2897:       \"path\": \"acceptance/README.md\"\n2898:      },\n2899:      {\n2900:       \"after_sha256\": \"3e71774a5bb0fb2b29cbb334983127264d5f377cc9e3a680b12f11da9268e201\",\n2901:       \"before_sha256\": \"f9448d370749dcca44fb2024b1b4b6d761d127edaf98a523063a590db5c69375\",\n