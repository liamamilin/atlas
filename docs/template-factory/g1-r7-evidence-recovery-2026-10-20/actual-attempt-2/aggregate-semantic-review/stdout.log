ot None or parts.password is not None:\n112:         raise ValueError('不得包含凭据')\n113:     try:\n114:         port = parts.port\n115:     except ValueError as exc:\n116:         raise ValueError('端口无效') from exc\n117:     if port is None:\n118:         port = 443 if scheme == 'https' else 80\n119:     return (scheme, parts.hostname.lower(), port)\n120: \n121: \n122: def _normalize_base_url(url: str) -> str:\n123:     if not isinstance(url, str) or not url.strip():\n124:         raise ValueError('不能为空')\n125:     value = url.strip()\n126:     parts = urlsplit(value)\n127:     if parts.query or parts.fragment:\n128:         raise ValueError('不得包含查询参数或片段')\n129:     _origin(value)\n130:     return urlunsplit((parts.scheme.lower(), parts.netloc, parts.path.rstrip('/'), '', ''))\n131: \n132: \n133: def _has_header(headers: Mapping[str, Any], name: str) -> bool:\n134:     target = name.lower()\n135:     return any(str(key).lower() == target for key in headers)\n136: \n137: \n138: def _short_repr(value: Any, limit: int = 300) -> str:\n139:     try:\n140:         text = _json.dumps(value, ensure_ascii=False, default=str)\n141:     except (TypeError, ValueError):\n142:         text = repr(value)\n143:     if len(text) > limit:\n144:         text = text[:limit] + '…'\n145:     return _redact_text(text, limit + 10)\n146: \n147: \n148: def _lookup_path(value: Any, field: Any) -> tuple[bool, Any]:\n149:     if field is None or field == '' or field == '$':\n150:         parts: list[str] = []\n151:     elif isinstance(field, (list, tuple)):\n152:         parts = [str(part) for part in field]\n153:     else:\n154:         text = str(field)\n155:         if text.startswith('/'):\n156:             parts = [part.replace('~1', '/').replace('~0', '~') for part in text.split('/')[1:]]\n157:         else:\n158:             parts = text.split('.')\n159:     current = value\n160:     for part in parts:\n161:         if isinstance(current, Mapping):\n162:             if part not in current:\n