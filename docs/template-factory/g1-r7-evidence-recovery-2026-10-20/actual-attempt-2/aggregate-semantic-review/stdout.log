30dac651c8a838d469db409d940a493f158\",\n2845:     \"case_design_changes\": [\n2846:      {\n2847:       \"choice_id\": \"F11: the library is delivered as server-rendered HTML pages and forms with POST/redirect/GET for add, edit and organize actions, including a ready empty-library view.\",\n2848:       \"new\": \"F11: the library is delivered as Python server-rendered HTML pages and forms using POST/redirect/GET for saving records, managing categories, moving records between categories, and soft-delete/restore, including a ready empty-library view. P0 has no standalone record-editing page; record URL updates retain only the existing PATCH /api/bookmarks/{id} contract.\",\n2849:       \"old\": \"F11: the library is delivered as server-rendered HTML pages and forms with POST/redirect/GET for add, edit and organize actions, including a ready empty-library view.\",\n2850:       \"path\": [\n2851:        \"capability\"\n2852:       ]\n2853:      },\n2854:      {\n2855:       \"choice_id\": \"F11: the library is delivered as server-rendered HTML pages and forms with POST/redirect/GET for add, edit and organize actions, including a ready empty-library view.\",\n2856:       \"new\": \"The evidence describes a client-mounted SPA: Edit is an in-page dialog populated from item fields, and component creation loads Dexie rows into a client RippleMap. The target implements the already-declared P0 save, category-management, move and soft-delete/restore journeys as Python 3.12 HTML responses. Source SPA mounting, client-side dialog state and Dexie hydration are not carried over. The source Edit dialog does not imply a target record-editing UI; the existing PATCH API retains URL updates and recomputes hostname when the URL changes. The save-now/find-later loop and ready empty state remain the target intent.\",\n2857:       \"old\": \"The evidence describes a client-mounted SPA: Edit is an in-page dialog populated from item fields, and component creation loads Dexie rows into a client RippleMap. The target renders lists, forms and empty state as Python 3.12 HTML responses, so the SPA mount, client-side dialog state and Dexie hydration are not carried over; only the save-now/find-later user loop is retained.\",\n2858:       \"path\": [\n2859:        \"reason\"\n2860:       ]\n2861:      },\n2862:      {\n2863:       \"choice_id\": \"A deliberate save creates a URL-anchored record with a stable id, derived hostname, createdAt and initial state, and later edits preserve the record identity and creation/visit fields.\",\n2864:       \"new\": \"A deliberate save creates a URL-anchored record with a stable id, a locally derived hostname, creation time and initial active state. Later changes preserve the record id and creation time; updating the URL recomputes hostname from the new URL. The adopted capability is this identity and creation lifecycle; visitCount and visitedAt are not target fields or P0 obligations.\",\n2865:       \"old\": \"A deliberate save creates a URL-anchored record with a stable id, derived hostname, createdAt and initial state, and later edits preserve the record identity and creation/visit fields.\",\n2866:       \"path\": [\n2867:        \"capability\"\n2868:       ]\n2869:      },\n2870:      {\n2871:       \"choice_id\": \"A deliberate save creates a URL-anchored record with a stable id, derived hostname, createdAt and initial state, and later edits preserve the record identity and creation/visit fields.\",\n2872:       \"new\": \"The accepted observation records the source's bm-prefixed UUID identity, hostname derivation, createdAt, initial flags and visit fields, and preservation of identity and creation/visit fields on edit. These remain source observations. The target adopts stable record identity and creation time, represented by its existing id/created_at model and made durable by SQLite; it does not import the source's visitCount/visitedAt fields, which F24 excludes. URL updates follow the existing PATCH contract and derive hostname again. The source's tag constraints and other state fields are not silently imported into the category or target data model.\",\n2873:       \"old\": \"Evidence defines bm-prefixed UUID identity, hostname derivation, createdAt and default state, and preserves id/createdAt/visit fields on edit. The target adopts this record lifecycle as a user-facing capability, with SQLite providing durability; the source's free-text tag constraints are treated separately in the category decision, not silently imported as target rules.\",\n2874:       \"path\": [\n2875:        \"reason\"\n2876:       ]\n2877:      }\n2878:     ],\n2879:     \"effective_plan_digest\": \"e7b9e82beb121a4d73852e556eac0eeefd2406af2cd4a3f8fc6489eea4944f54\",\n2880:     \"program_changes\": [\n2881:      {\n2882:       \"after_sha256\": \"5923bdd1d15e7d98bcf2c3b91123b36d986c0c69cbc6a1a7fdab80ce4c437d6e\",\n2883:       \"before_sha256\": \"8a5ce953288f2b09b9cc0256d869fc7dca2a3dcd3ff255dc5dd5dfa2fa51fb67\",\n2884:       \"patch_digest\": \"98753fcaafc6bb575e92d70cae8841919fe32f894bd0de48de4ed7e9ad8713fb\",\n2885:       \"path\": \"acceptance/p0_library.py\"\n2886:      },\n2887:      {\n2888:       \"after_sha256\": \"342e38d2298cf48e22fb97d76e080ce4a67c3c10a942502c5ef205954878d667\",\n2889:       \"before_sha256\": \"4ba2fa6d2a6d3b306d6be5f82ef63604b836cf3d84bd0fc5efddf4d64683a6da\",\n2890:       \"patch_digest\": \"ba5c0ac00060bbeb1558b13172afec12e1d5a06de6edf3c6a1ac135aece0037b\",\n2891:       \"path\": \"acceptance/p0_find_open.py\"\n2892:      },\n2893:      {\n2894:       \"after_sha256\": \"9e73ee6233e5b991a9682bb0bcaa235783bd4c7a6d399d5be38c100face9db6e\",\n2895:       \"before_sha256\": \"01cf57941aeed3e0bfa431349b832429f4518addebd00528e8bc1a33ff189459\",\n2896:       \"patch_digest\": \"6249f00b1e87bb790c446cfb85f31c89de16fd44817cb17e9d8c968bc8faa89c\",\n2897:       \"path\": \"acceptance/README.md\"\n2898:      },\n2899:      {\n2900:       \"after_sha256\": \"3e71774a5bb0fb2b29cbb334983127264d5f377cc9e3a680b12f11da9268e201\",\n2901:       \"before_sha256\": \"f9448d370749dcca44fb2024b1b4b6d761d127edaf98a523063a590db5c69375\",\n2902:       \"patch_digest\": \"fbd74c98b88c86d974b7fe9749dc17ae5f2ac97e73fb6bbbe9ede18a1a01d3b6\",\n2903:       \"path\": \"acceptance/runner.json\"\n2904:      }\n2905:     ],\n2906:     \"program_revision_digest\": \"c340078dc08e58f1170d23d5fcde4ebba3f9a4ef9a863142c95507e97b8ef969\",\n2907:     \"reuse_paths\": [\n2908:      \"acceptance/common.py\",\n2909:      \"acceptance/p0_organize.py\",\n2910:      \"acceptance/p0_recovery.py\",\n2911:      \"acceptance/p1_maturity.py\",\n2912:      \"acceptance/requirements.txt\"\n2913:     ],\n2914:     \"spec_changes\": [\n2915:      {\n2916:       \"new\": [\n2917:        \"A01\",\n2918:        \"A02\",\n2919:        \"A03\",\n2920:        \"A12\"\n2921:       ],\n2922:       \"old\": [\n2923:        \"A01\",\n2924:        \"A02\",\n2925:        \"A03\"\n2926:       ],\n2927:       \"path\": [\n2928:        \"features\",\n2929:        \"F01\",\n2930:        \"acceptance\"\n2931:       ]\n2932:      },\n2933:      {\n2934:       \"new\": [\n2935:        \"F01\",\n2936:        \"F04\",\n2937:        \"F10\"\n2938:       ],\n2939:       \"old\": [\n2940:        \"F04\",\n2941:        \"F10\"\n2942:       ],\n2943:       \"path\": [\n2944:        \"acceptance\",\n2945:        \"A12\",\n2946:        \"features\"\n2947:       ]\n2948:      },\n2949:      {\n2950:       \"new\": [\n2951:        \"F01\",\n2952:        \"F10\"\n2953:       ],\n2954:       \"old\": [\n2955:        \"F04\",\n2956:        \"F10\"\n2957:       ],\n2958:       \"path\": [\n2959:        \"contract_coverage\",\n2960:        \"error_contract\",\n2961:        \"branches\",\n2962:        \"html.bookmark_save.category.empty\",\n2963:        \"feature_ids\"\n2964:       ]\n2965:      },\n2966:      {\n2967:       \"new\": [\n2968:        \"F01\",\n2969:        \"F10\"\n2970:       ],\n2971:       \"old\": [\n2972:        \"F04\",\n2973:        \"F10\"\n2974:       ],\n2975:       \"path\": [\n2976:        \"contract_coverage\",\n2977:        \"error_contract\",\n2978:        \"branches\",\n2979:        \"html.bookmark_save.category.whitespace\",\n2980:        \"feature_ids\"\n2981:       ]\n2982:      },\n2983:      {\n2984:       \"new\": [\n2985:        \"F01\",\n2986:        \"F10\"\n2987:       ],\n2988:       \"old\": [\n2989:        \"F04\",\n2990:        \"F10\"\n2991:       ],\n2992:       \"path\": [\n2993:        \"contract_coverage\",\n2994:        \"error_contract\",\n2995:        \"branches\",\n2996:        \"html.bookmark_save.category.overlong_121\",\n2997:        \"feature_ids\"\n2998:       ]\n2999:      },\n3000:      {\n3001:       \"new\": [\n3002:        \"F01\",\n3003:        \"F10\"\n3004:       ],\n3005:       \"old\": [\n3006:        \"F04\",\n3007:        \"F10\"\n3008:       ],\n3009:       \"path\": [\n3010:        \"contract_coverage\",\n3011:        \"error_contract\",\n3012:        \"branches\",\n3013:        \"json.bookmark_save.category.empty\",\n3014:        \"feature_ids\"\n3015:       ]\n3016:      },\n3017:      {\n3018:       \"new\": [\n3019:        \"F01\",\n3020:        \"F10\"\n3021:       ],\n3022:       \"old\": [\n3023:        \"F04\",\n3024:        \"F10\"\n3025:       ],\n3026:       \"path\": [\n3027:        \"contract_coverage\",\n3028:        \"error_contract\",\n3029:        \"branches\",\n3030:        \"json.bookmark_save.category.whitespace\",\n3031:        \"feature_ids\"\n3032:       ]\n3033:      },\n3034:      {\n3035:       \"new\": [\n3036:        \"F01\",\n3037:        \"F10\"\n3038:       ],\n3039:       \"old\": [\n3040:        \"F04\",\n3041:        \"F10\"\n3042:       ],\n3043:       \"path\": [\n3044:        \"contract_coverage\",\n3045:        \"error_contract\",\n3046:        \"branches\",\n3047:        \"json.bookmark_save.category.overlong_121\",\n3048:        \"feature_ids\"\n3049:       ]\n3050:      },\n3051:      {\n3052:       \"new\": \"atlas.bookmark-error-contract.v2\",\n3053:       \"old\": \"atlas.bookmark-error-contract.v1\",\n3054:       \"path\": [\n3055:        \"contract_coverage\",\n3056:        \"error_contract\",\n3057:        \"schema\"\n3058:       ]\n3059:      },\n3060:      {\n3061:       \"new\": [\n3062:        \"A01\",\n3063:        \"A02\",\n3064:        \"A03\",\n3065:        \"A12\"\n3066:       ],\n3067:       \"old\": [\n3068:        \"A01\",\n3069:        \"A02\",\n3070:        \"A03\"\n3071:       ],\n3072:       \"path\": [\n3073:        \"contract_coverage\",\n3074:        \"features\",\n3075:        \"F01\",\n3076:        \"acceptance_ids\"\n3077:       ]\n3078:      },\n3079:      {\n3080:       \"new\": [\n3081:        \"html.bookmark_save.category.empty\",\n3082:        \"html.bookmark_save.category.whitespace\",\n3083:        \"html.bookmark_save.category.overlong_121\",\n3084:        \"json.bookmark_save.category.empty\",\n3085:        \"json.bookmark_save.category.whitespace\",\n3086:        \"json.bookmark_save.category.overlong_121\"\n3087:       ],\n3088:       \"old\": null,\n3089:       \"path\": [\n3090:        \"contract_coverage\",\n3091:        \"features\",\n3092:        \"F01\",\n3093:        \"error_branch_ids\"\n3094:       ]\n3095:      },\n3096:      {\n3097:       \"new\": \"重试保存；仅首次初始化数据库时事务创建四个预置归类。后续启动保留已持久化的分类变更，不复活用户已删除或重命名的非默认分类；默认「未整理」仍遵守既有保护与初始化合同。\",\n3098:       \"old\": \"重试保存；应用启动时在事务中补齐预置归类。\",\n3099:       \"path\": [\n3100:        \"contract_coverage\",\n3101:        \"features\",\n3102:        \"F02\",\n3103:        \"recovery\"\n3104:       ]\n3105:      },\n3106:      {\n3107:       \"new\": \"记录的 category_id 为默认「未整理」，可在 /?category=未整理 看到；首次初始化时“未整理”“待购”“家居改造”“以后看看”均可见，之后显示真实持久化的用户分类状态。\",\n3108:       \"old\": \"记录的 category_id 为默认「未整理」，可在 /?category=未整理 看到；“未整理”“待购”“家居改造”“以后看看”均可见。\",\n3109:       \"path\": [\n3110:        \"contract_coverage\",\n3111:        \"features\",\n3112:        \"F02\",\n3113:        \"success_state\"\n3114:       ]\n3115:      },\n3116:      {\n3117:       \"new\": [\n3118:        \"html.bookmark_move.category_id.omitted\",\n3119:        \"html.bookmark_move.category_id.empty\",\n3120:        \"html.bookmark_move.category_id.unknown_id\",\n3121:        \"json.bookmark_move.category.empty\",\n3122:        \"json.bookmark_move.category.whitespace\",\n3123:        \"json.bookmark_move.category.overlong_121\",\n3124:        \"json.bookmark_move.category.omitted\",\n3125:        \"json.bookmark_move.category.null\"\n3126:       ],\n3127:       \"old\": [\n3128:        \"html.bookmark_save.category.empty\",\n3129:        \"html.bookmark_save.category.whitespace\",\n3130:        \"html.bookmark_save.category.overlong_121\",\n3131:        \"html.bookmark_move.category_id.omitted\",\n3132:        \"html.bookmark_move.category_id.empty\",\n3133:        \"html.bookmark_move.category_id.unknown_id\",\n3134:        \"json.bookmark_save.category.empty\",\n3135:        \"json.bookmark_save.category.whitespace\",\n3136:        \"json.bookmark_save.category.overlong_121\",\n3137:        \"json.bookmark_move.category.empty\",\n3138:        \"json.bookmark_move.category.whitespace\",\n3139:        \"json.bookmark_move.category.overlong_121\",\n3140:        \"json.bookmark_move.category.omitted\",\n3141:        \"json.bookmark_move.category.null\"\n3142:       ],\n3143:       \"path\": [\n3144:        \"contract_coverage\",\n3145:        \"features\",\n3146:        \"F04\",\n3147:        \"error_branch_ids\"\n3148:       ]\n3149:      },\n3150:      {\n3151:       \"new\": \"200 text/html；含保存表单 name=url、归类管理链接、记录列表/空状态容器；预置归类与空库不报错；health 200 JSON。 A11 自身区分 base_url 当前部署入口与绑定同一冻结 app_root 的 fresh 新实例，后者独立证明首启预置及未过滤真空库；不宣称 base_url 被清空或同容器重启。\",\n3152:       \"old\": \"200 text/html；含保存表单 name=url、归类管理链接、记录列表/空状态容器；预置归类与空库不报错；health 200 JSON。\",\n3153:       \"path\": [\n3154:        \"contract_coverage\",\n3155:        \"features\",\n3156:        \"F11\",\n3157:        \"success_state\"\n3158:       ]\n3159:      },\n3160:      {\n[Output truncated. Continue reading with offset: 3161]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file input.json, lines 2454-3160\n2454:      \"sources\": []\n2455:     },\n2456:     {\n2457:      \"acceptance\": [],\n2458:      \"applicability\": \"not applicable\",\n2459:      \"id\": \"F23\",\n2460:      \"name\": \"复制 URL 动作\",\n2461:      \"phase\": null,\n2462:      \"reason\": \"上游提供 Copy URL（S12），但本场景终点是打开原页而非分发链接，去掉可减少每条记录的操作噪音。\",\n2463:      \"sources\": [\n2464:       \"S12\"\n2465:      ]\n2466:     },\n2467:     {\n2468:      \"acceptance\": [],\n2469:      \"applicability\": \"not applicable\",\n2470:      \"id\": \"F24\",\n2471:      \"name\": \"访问计数与最近访问时间\",\n2472:      \"phase\": null,\n2473:      \"reason\": \"S15 直接记录 Visit 更新 visitCount 与 visitedAt 后打开原 URL；场景只需打开动作，目标不保留这两个访问统计字段，不再额外引用未纳入当前场景来源索引的类型定义。\",\n2474:      \"sources\": [\n2475:       \"S15\"\n2476:      ]\n2477:     }\n2478:    ],\n2479:    \"decisions\": [\n2480:     {\n2481:      \"default\": \"单选归类（bookmark.category_id 标量外键）。场景流程明确“选择一个简单归类”，单归属让移动、计数与浏览语义无歧义；未来若需多值可迁移到关联表而不丢数据。\",\n2482:      \"id\": \"D01\",\n2483:      \"impact\": \"决定数据模型（标量外键 vs 关联表）以及浏览、计数与检索的实现路径。\",\n2484:      \"question\": \"记录应归属于单一“归类”，还是允许像标签一样同时属于多个？\",\n2485:      \"status\": \"decided\",\n2486:      \"when_to_ask\": \"当真实用户反馈同一条记录必须同时属于多个主题，或需要跨主题交叉检索时再评估多标签。\"\n2487:     },\n2488:     {\n2489:      \"default\": \"落入默认“未整理”，保存始终成功。场景流程第3步要求未经整理的链接可先进入默认归类，快速保存不应打断浏览。\",\n2490:      \"id\": \"D02\",\n2491:      \"impact\": \"决定保存接口是否允许缺省 category，以及首启预置数据内容。\",\n2492:      \"question\": \"保存时不选归类，应阻止保存还是落入默认“未整理”？\",\n2493:      \"status\": \"decided\",\n2494:      \"when_to_ask\": \"当目标用户群要求强制归类（例如团队共享库）时再改为必选。\"\n2495:     },\n2496:     {\n2497:      \"default\": \"自动创建（名称大小写不敏感去重），重名则复用现有归类；保持保存流程不中断。\",\n2498:      \"id\": \"D03\",\n2499:      \"impact\": \"决定 categories 的唯一约束、写入事务边界与 409/400 的语义；HTML 归类表单与 JSON API 共用服务层，重名、非法名与默认归类保护都不得产生部分写入。\",\n2500:      \"question\": \"在保存或移动界面输入一个尚不存在的归类名，应自动创建还是报错？\",\n2501:      \"status\": \"decided\",\n2502:      \"when_to_ask\": \"当出现拼写错误导致归类碎片化的证据时，改为只允许从既有归类中选择。\"\n2503:     },\n2504:     {\n2505:      \"default\": \"软删除：记录标记 trashed_at，默认视图排除，提供撤销恢复；场景要求可恢复的失败。\",\n2506:      \"id\": \"D04\",\n2507:      \"impact\": \"决定数据模型的 trashed_at 列、默认列表过滤条件、/restore 恢复路径，以及删除归类时活动与软删记录同迁默认归类；不引入 purge 或永久删除接口。\",\n2508:      \"question\": \"删除是立即物理删除，还是软删除到可恢复区并支持短时撤销？\",\n2509:      \"status\": \"decided\",\n2510:      \"when_to_ask\": \"当用户要求彻底清除隐私数据或回收站增长需要释放空间时，再提供永久删除与清空。\"\n2511:     },\n2512:     {\n2513:      \"default\": \"本地优先：图标由域名派生本地路由，第三方元数据抓取为可选增强且失败静默降级，保证离线可保存。\",\n2514:      \"id\": \"D05\",\n2515:      \"impact\": \"决定保存流程的时延与可用性依赖，以及收藏响应中的 favicon/title 字段形态。\",\n2516:      \"question\": \"标题、描述与图标是否依赖第三方抓取服务？\",\n2517:      \"status\": \"decided\",\n2518:      \"when_to_ask\": \"当部署环境确认可访问外部服务且用户需要富预览时再启用增强。\"\n2519:     },\n2520:     {\n2521:      \"default\": \"自 P1/F14 起默认检测并返回 409 duplicate_url（附已有 id 供跳转查看），保存方显式 allow_duplicate 时可强制新增；P0 核心用例不依赖去重，软删除记录不参与判定；场景与成熟产品都倾向一址一记录。\",\n2522:      \"id\": \"D06\",\n2523:      \"impact\": \"决定服务层去重查询、allow_duplicate 语义与导入时的合并或跳过策略（不使用 url 唯一索引）。\",\n2524:      \"question\": \"同一 URL 再次保存时，阻止还是允许？\",\n2525:      \"status\": \"decided\",\n2526:      \"when_to_ask\": \"当用户明确需要对同一地址保留多个不同上下文的记录时再放宽。\"\n2527:     },\n2528:     {\n2529:      \"default\": \"标题加域名(hostname)加描述，大小写不敏感，可与归类过滤叠加；不检索正文（无抓取）。\",\n2530:      \"id\": \"D07\",\n2531:      \"impact\": \"决定查询实现与检索参数语义：category 与 q 可叠加，HTML 归类检索表单必须同时保留两者；计数与列表只统计未软删记录，移动、删除、恢复后保持一致。\",\n2532:      \"question\": \"关键字应匹配哪些字段？\",\n2533:      \"status\": \"decided\",\n2534:      \"when_to_ask\": \"当需要按网页正文全文检索时再引入抓取与索引（属后期能力）。\"\n2535:     },\n2536:     {\n2537:      \"default\": \"python-web 加 Python 3.12 标准库 http.server 加单文件 SQLite；满足离线、单用户与可独立验收，无需外部依赖。\",\n2538:      \"id\": \"D08\",\n2539:      \"impact\": \"决定交付 profile 为 python-web（Python 3.12 标准库 + SQLite + 服务端渲染 HTML），验收通过独立 HTTP 实例与真实表单提交进行。\",\n2540:      \"question\": \"采用何种运行时与持久化方式？\",\n2541:      \"status\": \"decided\",\n2542:      \"when_to_ask\": \"当需要多用户、并发写入或托管部署时再引入 Web 框架与服务端数据库。\"\n2543:     },\n2544:     {\n2545:      \"default\": \"默认无认证；交付进程在独立验收网络中监听测试者可路由的接口（`--host 0.0.0.0`），日常本机使用可绑定 127.0.0.1；不引入凭据文件，符合个人本地库的定位。\",\n2546:      \"id\": \"D09\",\n2547:      \"impact\": \"决定部署方式与验收的认证契约（验收默认不携带凭据）。\",\n2548:      \"question\": \"是否需要登录或口令？\",\n2549:      \"status\": \"decided\",\n2550:      \"when_to_ask\": \"当应用需要暴露到局域网或公网时，必须加入认证，否则只允许本机绑定。\"\n2551:     },\n2552:     {\n2553:      \"default\": \"Netscape 浏览器书签 HTML（本类型的交换约定），归类映射为文件夹或标签字段。\",\n2554:      \"id\": \"D10\",\n2555:      \"impact\": \"决定 P1 导入/导出的解析与生成实现。\",\n2556:      \"question\": \"导入/导出采用什么格式？\",\n2557:      \"status\": \"decided\",\n2558:      \"when_to_ask\": \"当需要与某个具体产品双向同步时再适配其专有格式。\"\n2559:     },\n2560:     {\n2561:      \"default\": \"P0 不做：本地单实例，数据在单一 SQLite 文件；跨设备属后期能力。\",\n2562:      \"id\": \"D11\",\n2563:      \"impact\": \"影响运行形态与数据归属，不阻塞 P0 核心旅程。\",\n2564:      \"question\": \"是否提供云同步或多用户共享？\",\n2565:      \"status\": \"deferred\",\n2566:      \"when_to_ask\": \"当用户明确需要在多设备访问同一库时再设计同步或托管。\"\n2567:     },\n2568:     {\n2569:      \"default\": \"P0 使用扁平单选归类加“未整理”收件区；嵌套与标签属成熟能力，按需在后期启用。\",\n2570:      \"id\": \"D12\",\n2571:      \"impact\": \"影响侧栏结构与检索实现，可后续迁移而不破坏现有数据。\",\n2572:      \"question\": \"归类是否需要嵌套层级，或与标签并存？\",\n2573:      \"status\": \"deferred\",\n2574:      \"when_to_ask\": \"当扁平归类数量增长到难以浏览，或需要交叉主题时。\"\n2575:     },\n2576:     {\n2577:      \"default\": \"本期不做：抓取与归档在离线验收下不可验证；先保证引用记录与打开回跳。\",\n2578:      \"id\": \"D13\",\n2579:      \"impact\": \"涉及外部抓取与存储扩展，属后期可选能力，不纳入 P0/P1 验收。\",\n2580:      \"question\": \"是否需要保存网页副本并检测失效链接？\",\n2581:      \"status\": \"open\",\n2582:      \"when_to_ask\": \"当用户明确要求内容留存，或需要清理死链时再评估。\"\n2583:     }\n2584:    ],\n2585:    \"acceptance\": [\n2586:     {\n2587:      \"features\": [\n2588:       \"F01\",\n2589:       \"F08\"\n2590:      ],\n2591:      \"goal\": \"保存一条链接后，同进程与重启后的新进程都能读到该记录，且 id 与内容稳定。\",\n2592:      \"id\": \"A01\",\n2593:      \"implementation\": \"acceptance/p0_library.py\",\n2594:      \"phase\": \"P0\",\n2595:      \"status\": \"not_run\",\n2596:      \"type\": \"positive\"\n2597:     },\n2598:     {\n2599:      \"features\": [\n2600:       \"F01\",\n2601:       \"F10\"\n2602:      ],\n2603:      \"goal\": \"保存表单与 JSON 均接受绝对可解析的 http/https URL（含单标签主机，如 http://localhost）并保留原始字符串；缺协议、非 http/https、空/非法 hostname 被拒绝为 400 invalid_url，且库中不新增记录。\",\n2604:      \"id\": \"A02\",\n2605:      \"implementation\": \"acceptance/p0_library.py\",\n2606:      \"phase\": \"P0\",\n2607:      \"status\": \"not_run\",\n2608:      \"type\": \"negative\"\n2609:     },\n2610:     {\n2611:      \"features\": [\n2612:       \"F01\",\n2613:       \"F02\"\n2614:      ],\n2615:      \"goal\": \"不选归类保存时记录落入“未整理”，保存时给出的新归类名被自动创建，首启可见预置归类。\",\n2616:      \"id\": \"A03\",\n2617:      \"implementation\": \"acceptance/p0_library.py\",\n2618:      \"phase\": \"P0\",\n2619:      \"status\": \"not_run\",\n2620:      \"type\": \"positive\"\n2621:     },\n2622:     {\n2623:      \"features\": [\n2624:       \"F03\"\n2625:      ],\n2626:      \"goal\": \"通过真实归类页表单完成新建、重命名、删除：重名、非法名与默认归类保护给出可读 form-error 且不改数据；删除归类后活动与软删除记录都迁回“未整理”，软删记录仍可恢复。 新建与重命名各自通过 HTML 和 JSON 验证 name 省略、空字符串、纯空白和 121 字符（JSON 另测 null）均为 400 invalid_name；保留全部重名、保护、迁移与恢复断言。\",\n2627:      \"id\": \"A04\",\n2628:      \"implementation\": \"acceptance/p0_organize.py\",\n2629:      \"phase\": \"P0\",\n2630:      \"status\": \"not_run\",\n2631:      \"type\": \"positive\"\n2632:     },\n2633:     {\n2634:      \"features\": [\n2635:       \"F04\",\n2636:       \"F08\"\n2637:      ],\n2638:      \"goal\": \"在给定的 base_url 目标把记录从“未整理”移动到另一归类，并用独立实例证明该归属跨重启仍然有效。\",\n2639:      \"id\": \"A05\",\n2640:      \"implementation\": \"acceptance/p0_organize.py\",\n2641:      \"phase\": \"P0\",\n2642:      \"status\": \"not_run\",\n2643:      \"type\": \"positive\"\n2644:     },\n2645:     {\n2646:      \"features\": [\n2647:       \"F05\"\n2648:      ],\n2649:      \"goal\": \"通过真实归类页/记录表单浏览与计数：侧栏与接口的 count 只计活动记录，并在移动、软删除、恢复后与实际列表和 JSON 保持一致。\",\n2650:      \"id\": \"A06\",\n2651:      \"implementation\": \"acceptance/p0_organize.py\",\n2652:      \"phase\": \"P0\",\n2653:      \"status\": \"not_run\",\n2654:      \"type\": \"positive\"\n2655:     },\n2656:     {\n2657:      \"features\": [\n2658:       \"F06\"\n2659:      ],\n2660:      \"goal\": \"从真实归类页提交 category 与 q：页面保留所选归类与查询并显示匹配/明确空结果；同一关键字在两个归类分别命中各自记录，且 JSON 检索仍覆盖标题、域名与描述、大小写不敏感。\",\n2661:      \"id\": \"A07\",\n2662:      \"implementation\": \"acceptance/p0_find_open.py\",\n2663:      \"phase\": \"P0\",\n2664:      \"status\": \"not_run\",\n2665:      \"type\": \"positive\"\n2666:     },\n2667:     {\n2668:      \"features\": [\n2669:       \"F07\"\n2670:      ],\n2671:      \"goal\": \"打开记录跳转到保存时的原始 URL（302 Location 等于保存值），未知 id 返回 404。\",\n2672:      \"id\": \"A08\",\n2673:      \"implementation\": \"acceptance/p0_find_open.py\",\n2674:      \"phase\": \"P0\",\n2675:      \"status\": \"not_run\",\n2676:      \"type\": \"positive\"\n2677:     },\n2678:     {\n2679:      \"features\": [\n2680:       \"F08\",\n2681:       \"F09\"\n2682:      ],\n2683:      \"goal\": \"通过真实记录表单软删除并恢复：默认视图排除、回收站可见、恢复后字段与归类回归；删除归类时软删记录迁回“未整理”仍可恢复，且删除状态跨重启保持。\",\n2684:      \"id\": \"A09\",\n2685:      \"implementation\": \"acceptance/p0_recovery.py\",\n2686:      \"phase\": \"P0\",\n2687:      \"status\": \"not_run\",\n2688:      \"type\": \"positive\"\n2689:     },\n2690:     {\n2691:      \"features\": [\n2692:       \"F10\"\n2693:      ],\n2694:      \"goal\": \"未知 id 与畸形 JSON 返回结构化错误（bad_request/not_found）且不产生 5xx、不改变数据；真实表单的非法 URL 显示可读 form-error、保留输入，并在修正后成功保存。\",\n2695:      \"id\": \"A10\",\n2696:      \"implementation\": \"acceptance/p0_recovery.py\",\n2697:      \"phase\": \"P0\",\n2698:      \"status\": \"not_run\",\n2699:      \"type\": \"negative\"\n2700:     },\n2701:     {\n2702:      \"features\": [\n2703:       \"F11\"\n2704:      ],\n2705:      \"goal\": \"健康检查返回就绪，首页外壳在空库下渲染录入表单与列表容器，入口不报错。\",\n2706:      \"id\": \"A11\",\n2707:      \"implementation\": \"acceptance/p0_library.py\",\n2708:      \"phase\": \"P0\",\n2709:      \"status\": \"not_run\",\n2710:      \"type\": \"positive\"\n2711:     },\n2712:     {\n2713:      \"features\": [\n2714:       \"F01\",\n2715:       \"F04\",\n2716:       \"F10\"\n2717:      ],\n2718:      \"goal\": \"仅验证书签保存与移动的非法归类：HTML 保存使用归类名 category，HTML 移动使用归类 ID category_id；JSON 保存/移动使用归类名 category。非法归类 400 invalid_category，HTML 显示可读 form-error 并保留提交值，JSON 返回结构化错误；归类集合、记录集合与被移动记录归属均不变。保存省略 category（JSON 另含 null）进入未整理，不作为非法值；移动省略值/JSON null、显式空值/纯空白/超长归类名，以及 HTML 移动空/未知 category_id 为非法。有效新归类名保存或 JSON 移动时自动创建，不把未知 ID 当作名称。分类创建/重命名 name 的 invalid_name 分支仅属 A04。\",\n2719:      \"id\": \"A12\",\n2720:      \"implementation\": \"acceptance/p0_organize.py\",\n2721:      \"phase\": \"P0\",\n2722:      \"status\": \"not_run\",\n2723:      \"type\": \"negative\"\n2724:     },\n2725:     {\n2726:      \"features\": [\n2727:       \"F12\"\n2728:      ],\n2729:      \"goal\": \"外部网络不可用时保存仍然成功，图标与标题降级为本地派生结果，缺失增强不阻塞或报错。\",\n2730:      \"id\": \"A13\",\n2731:      \"implementation\": \"acceptance/p1_maturity.py\",\n2732:      \"phase\": \"P1\",\n2733:      \"status\": \"not_run\",\n2734:      \"type\": \"positive\"\n2735:     },\n2736:     {\n2737:      \"features\": [\n2738:       \"F13\"\n2739:      ],\n2740:      \"goal\": \"导出为浏览器书签 HTML 可包含已存记录，且导入该 HTML 后相应记录可再次检索到。\",\n2741:      \"id\": \"A14\",\n2742:      \"implementation\": \"acceptance/p1_maturity.py\",\n2743:      \"phase\": \"P1\",\n2744:      \"status\": \"not_run\",\n2745:      \"type\": \"positive\"\n2746:     },\n2747:     {\n2748:      \"features\": [\n2749:       \"F14\"\n2750:      ],\n2751:      \"goal\": \"重复 URL 默认被拒绝（409 duplicate_url）且库不变；显式允许重复时可新增第二条。\",\n2752:      \"id\": \"A15\",\n2753:      \"implementation\": \"acceptance/p1_maturity.py\",\n2754:      \"phase\": \"P1\",\n2755:      \"status\": \"not_run\",\n2756:      \"type\": \"negative\"\n2757:     }\n2758:    ]\n2759:   },\n2760:   \"program_file_hashes_before\": {\n2761:    \"acceptance/README.md\": \"5963afe2168d60c09f03d57619d5f07a425e5a7525245615d2c0017d161e70ce\",\n2762:    \"acceptance/common.py\": \"7f0d7d28d8336bdde3da267795e24d13e430f05e53063ee01ed5611236325d37\",\n2763:    \"acceptance/p0_find_open.py\": \"5ccd5115753b40267036a64e330e2c81b9ffd42e6ad00cc96565642e3941444a\",\n2764:    \"acceptance/p0_library.py\": \"db7911754c6ed37f90f61146e3a352cb7a28028b280d5a24878918490b62b6ef\",\n2765:    \"acceptance/p0_organize.py\": \"7d74bde76a8fcd6a52cdfa8aa31034f43f8c4d1dc50255f8d82e1cd356d1760b\",\n2766:    \"acceptance/p0_recovery.py\": \"b6caae610999680fccc101293cb43eceef07c8b79c93bbe2666bfb765c2b4927\",\n2767:    \"acceptance/p1_maturity.py\": \"d44e17c87314db18084b3b88bd2c700a75bfe583d108e9b518040fb8378601a3\",\n2768:    \"acceptance/requirements.txt\": \"f1fc18b605a1eea93892d319d09122d91033a48dfd4b913f8f262a4dc8633deb\",\n2769:    \"acceptance/runner.json\": \"f9448d370749dcca44fb2024b1b4b6d761d127edaf98a523063a590db5c69375\"\n2770:   },\n2771:   \"program_file_hashes_after\": {\n2772:    \"acceptance/README.md\": \"9e73ee6233e5b991a9682bb0bcaa235783bd4c7a6d399d5be38c100face9db6e\",\n2773:    \"acceptance/common.py\": \"7f0d7d28d8336bdde3da267795e24d13e430f05e53063ee01ed5611236325d37\",\n2774:    \"acceptance/p0_find_open.py\": \"342e38d2298cf48e22fb97d76e080ce4a67c3c10a942502c5ef205954878d667\",\n2775:    \"acceptance/p0_library.py\": \"5923bdd1d15e7d98bcf2c3b91123b36d986c0c69cbc6a1a7fdab80ce4c437d6e\",\n2776:    \"acceptance/p0_organize.py\": \"93ae82c74946811fac3b1dd213cc077cf89acc6ecfb45e64ec2830e3482b7f60\",\n2777:    \"acceptance/p0_recovery.py\": \"372c75aa2944a10cc5146859dc0bacd0e03111defe7c8aa75