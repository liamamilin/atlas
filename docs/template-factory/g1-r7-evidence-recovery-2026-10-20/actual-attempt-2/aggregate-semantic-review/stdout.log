ry')\n1700:         recorder.check(\n1701:             'a05-move-location-category',\n1702:             location_category == target_name,\n1703:             f'移动 303 Location 的 category={location_category!r}（期望 {target_name!r}）',\n1704:         )\n1705:         old_list = _fetch_bookmarks(\n1706:             client, recorder, 'a05-old-list',\n1707:             params={'category': common.DEFAULT_CATEGORY},\n1708:         )\n1709:         recorder.check(\n1710:             'a05-left-default',\n1711:             record_id not in _record_ids(old_list),\n1712:             f'移动后记录 {record_id!r} 不再属于「{common.DEFAULT_CATEGORY}」',\n1713:         )\n1714:         new_list = _fetch_bookmarks(\n1715:             client, recorder, 'a05-new-list',\n1716:             params={'category': target_name},\n1717:         )\n1718:         recorder.check(\n1719:             'a05-in-target',\n1720:             record_id in _record_ids(new_list),\n1721:             f'移动后记录 {record_id!r} 出现在归类 {target_name!r}',\n1722:         )\n1723:         categories = _fetch_categories(client, recorder, 'a05-categories')\n1724:         fetched = _get_record_json(\n1725:             client, recorder, 'a05-record-json', record_id\n1726:         )\n1727:         if fetched is not None:\n1728:             actual = _record_category_name(fetched, categories)\n1729:             recorder.check(\n1730:                 'a05-record-category',\n1731:                 actual == target_name,\n1732:                 f'JSON 读回归类={actual!r}（期望 {target_name!r}）',\n1733:             )\n1734:         new_doc = _home_page(\n1735:             client, recorder, 'a05-html-new', params={'category': target_name}\n1736:         )\n1737:         recorder.check(\n1738:             'a05-html-new-row',\n1739:             record_id in _row_ids(new_doc),\n1740:             f'归类 {target_name!r} 的 HTML 列表包含记录 {record_id!r}',\n1741:         )\n1742:         old_doc = _home_page(\n1743:             client, recorder, 'a05-html-old',\n1744:    