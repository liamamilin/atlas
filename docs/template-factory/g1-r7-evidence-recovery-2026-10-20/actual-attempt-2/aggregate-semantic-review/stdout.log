  },\n32:     \"A10\": {\n33:       \"args\": [\"--case\", \"{case_id}\", \"--base-url\", \"{base_url}\"]\n34:     },\n35:     \"A11\": {\n36:       \"args\": [\"--case\", \"{case_id}\", \"--base-url\", \"{base_url}\"]\n37:     },\n38:     \"A12\": {\n39:       \"args\": [\"--case\", \"{case_id}\", \"--base-url\", \"{base_url}\"]\n40:     },\n41:     \"A13\": {\n42:       \"args\": [\"--case\", \"{case_id}\", \"--base-url\", \"{base_url}\"]\n43:     },\n44:     \"A14\": {\n45:       \"args\": [\"--case\", \"{case_id}\", \"--base-url\", \"{base_url}\", \"--data-dir\", \"{data_dir}\"]\n46:     },\n47:     \"A15\": {\n48:       \"args\": [\"--case\", \"{case_id}\", \"--base-url\", \"{base_url}\"]\n49:     }\n50:   }\n51: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"source/baseline/acceptance/runner.json\"}"},"time":{"start":1792484195267,"end":1792484195413}}}}
