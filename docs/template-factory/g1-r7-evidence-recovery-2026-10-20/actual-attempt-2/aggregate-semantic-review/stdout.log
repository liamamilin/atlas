t sys\n17: import uuid\n18: from html.parser import HTMLParser\n19: from urllib.parse import parse_qsl, quote, urlsplit\n20: \n21: _THIS_DIR = os.path.dirname(os.path.abspath(__file__))\n22: if _THIS_DIR not in sys.path:\n23:     sys.path.insert(0, _THIS_DIR)\n24: \n25: import common\n26: \n27: _NUMBER_RE = re.compile('[0-9]+')\n28: _VOID_TAGS = frozenset({\n29:     'area', 'base', 'br', 'col', 'embed', 'hr', 'img', 'input',\n30:     'link', 'meta', 'param', 'source', 'track', 'wbr',\n31: })\n32: \n33: \n34: def _normalize_space(value):\n35:     return ' '.join(str(value or '').split())\n36: \n37: \n38: class _Field:\n39:     def __init__(self, attrs):\n40:         self.attrs = attrs\n41:         self.name = attrs.get('name')\n42:         self.value = attrs.get('value', '')\n43:         self.type = (attrs.get('type') or 'text').lower()\n44:         self.checked = 'checked' in attrs\n45: \n46: \n47: class _Option:\n48:     def __init__(self, attrs):\n49:         self.attrs = attrs\n50:         self.value = attrs.get('value')\n51:         self.text = ''\n52:         self.selected = 'selected' in attrs\n53: \n54:     def resolved_value(self):\n55:         if self.value is not None:\n56:             return self.value\n57:         return self.text.strip()\n58: \n59: \n60: class _Select:\n61:     def __init__(self, attrs):\n62:         self.attrs = attrs\n63:         self.name = attrs.get('name')\n64:         self.options = []\n65: \n66:     def selected_value(self):\n67:         for option in self.options:\n68:             if option.selected:\n69:                 return option.resolved_value()\n70:         if self.options:\n71:             return self.options[0].resolved_value()\n72:         return ''\n73: \n74: \n75: class _Textarea:\n76:     def __init__(self, attrs):\n77:         self.attrs = attrs\n78:         self.name = attrs.get('name')\n79:         self.text = ''\n80: \n81: \n82: class _Form:\n83:     def __init__(self, attrs):\n84:         self.attrs = attrs\n85:         self.action = (attrs.get('action') or '').strip()\n86:         self.method = (attrs.get('method') or 'get').strip().lower()\n87:         self.testid = attrs.get('data-testid') or ''\n88:         self.fields = []\n89:         self.selects = []\n90:         self.textareas = []\n91: \n92:     def has_name(self, name):\n93:         if any(field.name == name for field in self.fields):\n94:             return True\n95:         if any(select.name == name for select in self.selects):\n96:             return True\n97:         return any(textarea.name == name for textarea in self.textareas)\n98: \n99:     def value(self, name):\n100:         for field in reversed(self.fields):\n101:             if field.name == name:\n102:                 return field.value\n103:         for select in reversed(self.selects):\n104:             if select.name == name:\n105:                 return select.selected_value()\n106:         for textarea in reversed(self.textareas):\n107:             if textarea.name == name:\n108:                 return textarea.text\n109:         return None\n110: \n111: \n112: class _Anchor:\n113:     def __init__(self, attrs):\n114:         self.attrs = attrs\n115:         self.href = attrs.get('href') or ''\n116:         self.testid = attrs.get('data-testid') or ''\n117:         self.text = ''\n118: \n119: \n120: class _Row:\n121:     def __init__(self, attrs):\n122:         self.attrs = attrs\n123:         self.record_id = attrs.get('data-record-id') or ''\n124:         self.anchors = []\n125:         self.text = ''\n126: \n127: \n128: def _action_path(action):\n129:     text = (action or '').strip()\n130:     if not text:\n131:         return ''\n132:     try:\n133:         path = urlsplit(text).path\n134:     except ValueError:\n135:         return text\n136:     if not path:\n137:         return ''\n138:     if not path.startswith('/'):\n139:         path = '/' + path\n140:     return path.rstrip('/') or '/'\n141: \n142: \n143: def _path_of(href):\n144:     try:\n145:         path = urlsplit(href).path\n146:     except ValueError:\n147:         return ''\n148:     if not path:\n149:         return ''\n150:     if not path.startswith('/'):\n151:         path = '/' + path\n152:     return path.rstrip('/') or '/'\n153: \n154: \n155: def _form_path(form, default):\n156:     action = (form.action or '').strip()\n157:     return action if action else default\n158: \n159: \n160: class _Document:\n161:     def __init__(self):\n162:         self.forms = []\n163:         self.anchors = []\n164:         self.rows = []\n165:         self.testids = []\n166:         self.start_tags = []\n167:         self.text = ''\n168: \n169:     def save_form(self):\n170:         for form in self.forms:\n171:             if form.method == 'post' and _action_path(form.action) == '/bookmarks/new':\n172:                 return form\n173:         for form in self.forms:\n174:             if form.method == 'post' and form.has_name('url'):\n175:                 return form\n176:         return None\n177: \n178: \n179: class _HtmlReader(HTMLParser):\n180:     def __init__(self):\n181:         super().__init__(convert_charrefs=True)\n182:         self.doc = _Document()\n183:         self._form = None\n184:         self._select = None\n185:         self._option = None\n186:         self._textarea = None\n187:         self._anchor = None\n188:         self._row = None\n189:         self._testid_stack = []\n190: \n191:     def handle_starttag(self, tag, attrs):\n192:         tag = tag.lower()\n193:         attributes = {\n194:             str(key).lower(): ('' if value is None else value)\n195:             for key, value in attrs\n196:         }\n197:         self.doc.start_tags.append((tag, attributes))\n198:         testid = attributes.get('data-testid') or ''\n199:         if testid:\n200:             entry = {'tag': tag, 'attrs': attributes, 'text': ''}\n201:             self.doc.testids.append(entry)\n202:             if tag not in _VOID_TAGS:\n203:                 self._testid_stack.append((tag, entry))\n204:         if tag == 'form':\n205:             self._finish_form()\n206:             self._form = _Form(attributes)\n207:         elif tag == 'input':\n208:             if self._form is not None:\n209:                 self._form.fields.append(_Field(attributes))\n210:         elif tag == 'select':\n211:             self._finish_select()\n212:             if self._form is not None:\n213:                 self._select = _Select(attributes)\n214:         elif tag == 'option':\n215:             self._finish_option()\n216:             if self._select is not None:\n217:                 self._option = _Option(attributes)\n218:         elif tag == 'textarea':\n219:             self._finish_textarea()\n220:             if self._form is not None:\n221:                 self._textarea = _Textarea(attributes)\n222:         elif tag == 'a':\n223:             self._finish_anchor()\n224:             self._anchor = _Anchor(attributes)\n225:         elif tag == 'tr' and testid == 'record-row':\n226:             self._finish_row()\n227:             self._row = _Row(attributes)\n228: \n229:     def handle_data(self, data):\n230:         if not data:\n231:             return\n232:         self.doc.text += data\n233:         if self._row is not None:\n234:             self._row.text += data\n235:         if self._anchor is not None:\n236:             self._anchor.text += data\n237:         if self._option is not None:\n238:             self._option.text += data\n239:         if self._textarea is not None:\n240:             self._textarea.text += data\n241:         for _, entry in self._testid_stack:\n242:             entry['text'] += data\n243: \n244:     def handle_endtag(self, tag):\n245:         tag = tag.lower()\n246:         if tag == 'a':\n247:             self._finish_anchor()\n248:         elif tag == 'option':\n249:             self._finish_option()\n250:         elif tag == 'select':\n251:             self._finish_select()\n252:         elif tag == 'textarea':\n253:             self._finish_textarea()\n254:         elif tag == 'form':\n255:             self._finish_form()\n256:         elif tag == 'tr':\n257:             self._finish_row()\n258:         if tag in _VOID_TAGS:\n259:             return\n260:         if self._testid_stack and self._testid_stack[-1][0] == tag:\n261:             self._testid_stack.pop()\n262: \n263:     def _finish_option(self):\n264:         if self._option is None:\n265:             return\n266:         option = self._option\n267:         self._option = None\n268:         if self._select is not None:\n269:             self._select.options.append(option)\n270: \n271:     def _finish_select(self):\n272:         self._finish_option()\n273:         if self._select is None:\n274:             return\n275:         select = self._select\n276:         self._select = None\n277:         if self._form is not None:\n278:             self._form.selects.append(select)\n279: \n280:     def _finish_textarea(self):\n281:         if self._textarea is None:\n282:             return\n283:         textarea = self._textarea\n284:         self._textarea = None\n285:         if self._form is not None:\n286:             self._form.textareas.append(textarea)\n287: \n288:     def _finish_anchor(self):\n289:         if self._anchor is None:\n290:             return\n291:         anchor = self._anchor\n292:         self._anchor = None\n293:         self.doc.anchors.append(anchor)\n294:         if self._row is not None:\n295:             self._row.anchors.append(anchor)\n296: \n297:     def _finish_row(self):\n298:         if self._row is None:\n299:             return\n300:         row = self._row\n301:         self._row = None\n302:         self.doc.rows.append(row)\n303: \n304:     def _finish_form(self):\n305:         self._finish_select()\n306:         self._finish_textarea()\n307:         if self._form is None:\n308:             return\n309:         form = self._form\n310:         self._form = None\n311:         self.doc.forms.append(form)\n312: \n313:     def finalize(self):\n314:         self._finish_anchor()\n315:         self._finish_row()\n316:         self._finish_form()\n317: \n318: \n319: def _parse_html(text):\n320:     reader = _HtmlReader()\n321:     reader.feed(text or '')\n322:     reader.close()\n323:     reader.finalize()\n324:     return reader.doc\n325: \n326: \n327: def _form_fields(form, overrides=None, omit=()):\n328:     fields = {}\n329:     for field in form.fields:\n330:         name = field.name\n331:         if not name:\n332:             continue\n333:         if field.type in ('submit', 'button', 'reset', 'file', 'image'):\n334:             continue\n335:         if field.type in ('checkbox', 'radio') and not field.checked:\n336:             continue\n337:         fields[name] = field.value\n338:     for select in form.selects:\n339:         if select.name:\n340:             fields[select.name] = select.selected_value()\n341:     for textarea in form.textareas:\n342:         if textarea.name:\n343:             fields[textarea.name] = textarea.text\n344:     if overrides:\n345:         for key, value in overrides.items():\n346:             name = str(key)\n347:             if value is None:\n348:                 fields.pop(name, None)\n349:             else:\n350:                 fields[name] = str(value)\n351:     for name in omit:\n352:         fields.pop(name, None)\n353:     return fields\n354: \n355: \n356: def _first_form(doc, testid):\n357:     for form in doc.forms:\n358:         if form.testid == testid:\n359:             return form\n360:     return None\n361: \n362: \n363: def _form_for_category(doc, testid, category_id):\n364:     forms = [\n365:         form for form in doc.forms\n366:         if form.testid == testid and form.has_name('category_id')\n367:     ]\n368:     for form in forms:\n369:         if form.value('category_id') == category_id:\n370:             return form\n371:     if len(forms) == 1:\n372:         return forms[0]\n373:     return None\n374: \n375: \n376: def _find_record_form(doc, testid, record_id):\n377:     for form in doc.forms:\n378:         if form.testid == testid and form.value('record_id') == record_id:\n379:             return form\n380:     return None\n381: \n382: \n383: def _form_error_text(doc):\n384:     parts = []\n385:     for entry in doc.testids:\n386:         testid = (entry['attrs'].get('data-testid') or '').lower()\n387:         if testid == 'form-error' or 'form-error' in testid:\n388:             text = _normalize_space(entry['text'])\n389:             if text:\n390:                 parts.append(text)\n391:     return ' '.join(parts)\n392: \n393: \n394: def _category_count_values(doc):\n395:     result = {}\n396:     for entry in doc.testids:\n397:         if entry['attrs'].get('data-testid') != 'category-count':\n398:             continue\n399:         category_id = entry['attrs'].get('data-category-id')\n400:         if not category_id:\n401:             continue\n402:         numbers = _NUMBER_RE.findall(entry['text'])\n403:         value = int(numbers[-1]) if numbers else None\n404:         result.setdefault(category_id, []).append(value)\n405:     return result\n406: \n407: \n408: def _row_ids(doc):\n409:     return {row.record_id for row in doc.rows if row.record_id}\n410: \n411: \n412: def _row_for_url(doc, url):\n413:     for row in doc.rows:\n414:         for anchor in row.anchors:\n415:             if anchor.testid == 'record-open-link' and anchor.href == url:\n416:                 return row\n417:     for row in doc.rows:\n418:         for anchor in row.anchors:\n419:             if anchor.href == url:\n420:                 return row\n421:     return None\n422: \n423: \n424: def _select_values(form, name):\n425:     for select in form.selects:\n426:         if select.name == name:\n427:             return [option.resolved_value() for option in select.options]\n428:     return []\n429: \n430: \n431: def _unique_url(tag):\n432:     token = f'{tag}-{uuid.uuid4().hex[:12]}'\n433:     return f'https://{token}.atlas-acceptance.example/{token}'\n434: \n435: \n436: def _unique_category(tag):\n437:     return f'atlas-{tag}-{uuid.uuid4().hex[:10]}'\n438: \n439: \n440: def _safe_json(response):\n441:     try:\n442:         return response.json()\n443:     except Exception:\n444:         return None\n445: \n446: \n447: def _extract_record(payload):\n448:     if isinstance(payload, dict):\n449:         for key in ('bookmark', 'record', 'data', 'item'):\n450:             value = payload.get(key)\n451:             if isinstance(value, dict):\n452:                 return value\n453:         return payload\n454:     return None\n455: \n456: \n457: def _extract_category(payload):\n458:     if isinstance(payload, dict):\n459:         value = payload.get('category')\n460:         if isinstance(value, dict):\n461:             return value\n462:         return payload\n463:     return None\n464: \n465: \n466: def _extract_list(payload, keys):\n467:     if isinstance(payload, list):\n468:         return payload\n469:     if isinstance(payload, dict):\n470:         for key in keys:\n471:             value = payload.get(key)\n472:             if isinstance(value, list):\n473:                 return value\n474:     return None\n475: \n476: \n477: def _record_id(record):\n478:     if isinstance(record, dict) and record.get('id') is not None:\n479:         return str(record['id'])\n480:     return None\n481: \n482: \n483: def _record_url(record):\n484:     if isinstance(record, dict) and record.get('url') is not None:\n485:         return str(record['url'])\n486:     return None\n487: \n488: \n489: def _record_title(record):\n490:     if isinstance(record, dict) and record.get('title') is not None:\n491:         return str(record['title'])\n492:     return None\n493: \n494: \n495: def _record_description(record):\n496:     if isinstance(record, dict):\n497:         for key in ('description', 'desc'):\n498:             if record.get(key) is not None:\n499:                 return str(record[key])\n500:     return None\n501: \n502: \n503: def _record_category_name(record, categories):\n504:     if not isinstance(record, dict):\n505:         return None\n506:     by_id = {}\n507:     names = set()\n508:     for item in categories or []:\n509:         if isinstance(item, dict) and item.get('id') is not None:\n510:             if item.get('name') is not None:\n511:                 by_id[str(item['id'])] = str(item['name'])\n512:                 names.add(str(item['name']))\n513:     for key in ('category', 'category_name', 'categoryName'):\n514:         value = record.get(key)\n515:         if isinstance(value, str):\n516:             if value in names:\n517:                 return value\n518:             if value in by_id:\n519:                 return by_id[value]\n520:             return value\n521:         if isinstance(value, dict) and value.get('name') is not None:\n522:             return str(value['name'])\n523:     for key in ('category_id', 'categoryId'):\n524:         value = record.get(key)\n525:         if value is not None and str(value) in by_id:\n526:             return by_id[str(value)]\n527:     return None\n528: \n529: \n530: def _record_category_id(record):\n531:     if not isinstance(record, dict):\n532:         return None\n533:     for key in ('category_id', 'categoryId'):\n534:         value = record.get(key)\n535:         if value is not None:\n536:             return str(value)\n537:     value = record.get('category')\n538:     if isinstance(value, dict) and value.get('id') is not None:\n539:         return str(value['id'])\n540:     return None\n541: \n542: \n543: def _category_names(categories):\n544:     return {\n545:         str(item['name']) for item in categories\n546:         if isinstance(item, dict) and item.get('name') is not None\n547:     }\n548: \n549: \n550: def _category_ids(categories):\n551:     return {\n552:         str(item['id']) for item in categories\n553:         if isinstance(item, dict) and item.get('id') is not None\n554:     }\n555: \n556: \n557: def _find_category_by_name(categories, name):\n558:     if name is None:\n559:         return None\n560:     target = str(name).casefold()\n561:     for item in categories:\n562:         if isinstance(item, dict) and item.get('name') is not None:\n563:             if str(item['name']).casefold() == target:\n564:                 return item\n565:     return None\n566: \n567: \n568: def _find_category_by_id(categories, category_id):\n569:     if category_id is None:\n570:         return None\n571:     target = str(category_id)\n572:     for item in categories:\n573:         if isinstance(item, dict) and item.get('id') is not None:\n574:             if str(item['id']) == target:\n575:                 return item\n576:     return None\n577: \n578: \n579: def _default_category(categories):\n580:     for item in categories:\n581:         if isinstance(item, dict) and item.get('is_default'):\n582:             return item\n583:     return _find_category_by_name(categories, common.DEFAULT_CATEGORY)\n584: \n585: \n586: def _error_code(response):\n587:     payload = _safe_json(response)\n588:     if isinstance(payload, dict):\n589:         error = payload.get('error')\n590:         if isinstance(error, dict) and error.get('code') is not None:\n591:             return str(error['code'])\n592:         for key in ('code', 'error_code'):\n593:             if payload.get(key) is not None:\n594:                 return str(payload[key])\n595:     return None\n596: \n597: \n598: def _bookmark_path(bookmark_id):\n599:     return '/api/bookmarks/' + quote(str(bookmark_id), safe='')\n600: \n601: \n602: def _move_path(bookmark_id):\n603:     return _bookmark_path(bookmark_id) + '/move'\n604: \n605: \n606: def _category_path(category_id):\n607:     return '/api/categories/' + quote(str(category_id), safe='')\n608: \n609: \n610: def _record_ids(records):\n611:     return {\n612:         record_id for record_id in (_record_id(record) for record in records)\n613:         if record_id\n614:     }\n615: \n616: \n617: def _record_urls(records):\n618:     return {\n619:         url for url in (_record_url(record) for record in records)\n620:         if url\n621:     }\n622: \n623: \n624: def _fetch_bookmarks(client, recorder, aid, params=None):\n625:     response = client.get('/api/bookmarks', params=params)\n626:     recorder.expect_status(response, 200, aid=f'{aid}-status')\n627:     payload = _safe_json(response)\n628:     records = _extract_list(payload, ('bookmarks', 'items', 'data', 'records'))\n629:     recorder.check(\n630:         f'{aid}-shape',\n631:         isinstance(records, list),\n632:         f'GET /api/bookmarks 必须返回 JSON 数组，实际 {type(payload).__name__}',\n633:     )\n634:     return records if isinstance(records, list) else []\n635: \n636: \n637: def _fetch_categories(client, recorder, aid):\n638:     response = client.get('/api/categories')\n639:     recorder.expect_status(response, 200, aid=f'{aid}-status')\n640:     payload = _safe_json(response)\n641:     categories = _extract_list(payload, ('categories', 'items', 'data'))\n642:     recorder.check(\n643:         f'{aid}-shape',\n644:         isinstance(categories, list),\n645:         f'GET /api/categories 必须返回 JSON 数组，实际 {type(payload).__name__}',\n646:     )\n647:     return categories if isinstance(categories, list) else []\n648: \n649: \n650: def _category_signature(categories):\n651:     items = []\n652:     for item in categories:\n653:         if not isinstance(item, dict):\n654:             continue\n655:         items.append((\n656:             str(item.get('id')),\n657:             str(item.get('name')),\n658:             bool(item.get('is_default')),\n659:             item.get('count'),\n660:         ))\n661:     return tuple(sorted(items, key=lambda entry: (entry[0], entry[1])))\n662: \n663: \n664: def _record_map(records, categories):\n665:     result = {}\n666:     for record in records:\n667:         record_id = _record_id(record)\n668:         if record_id:\n669:             result[record_id] = _record_category_name(record, categories)\n670:     return result\n671: \n672: \n673: def _snapshot(client, recorder, aid):\n674:     categories = _fetch_categories(client, recorder, f'{aid}-categories')\n675:     records = _fetch_bookmarks(\n676:         client, recorder, f'{aid}-records', params={'include_trashed': 1}\n677:     )\n678:     return (_category_signature(categories), _record_map(records, categories))\n679: \n680: \n681: def _check_unchanged(recorder, aid, before, after, label):\n682:     recorder.check(\n683:         f'{aid}-categories-unchanged',\n684:         before[0] == after[0],\n685:         f'{label} 后分类集合（含计数）不变：{len(before[0])} -> {len(after[0])}',\n686:     )\n687:     recorder.check(\n688:         f'{aid}-records-unchanged',\n689:         before[1] == after[1],\n690:         f'{label} 后记录集合与归类归属不变：{len(before[1])} -> {len(after[1])}',\n691:     )\n692: \n693: \n694: def _follow_303(client, recorder, response, aid, expected_path=None, expected_query=None):\n695:     recorder.expect_status(response, 303, aid=f'{aid}-status')\n696:     location = response.location\n697:     if not recorder.check(\n698:         f'{aid}-location',\n699:         bool(location),\n700:         f'303 响应必须带 Location，实际 {location!r}',\n701:     ):\n702:         return None, None\n703:     parts = urlsplit(location)\n704:     if expected_path is not None:\n705:         actual_path = parts.path.rstrip('/') or '/'\n706:         wanted_path = expected_path.rstrip('/') or '/'\n707:         recorder.check(\n708:             f'{aid}-path',\n709:             actual_path == wanted_path,\n710:             f'303 Location={location!r} 的路径={actual_path!r}（期望 {wanted_path!r}）',\n711:         )\n712:     if expected_query:\n713:         actual_query = dict(parse_qsl(parts.query, keep_blank_values=True))\n714:         for key, value in expected_query.items():\n715:             actual_value = actual_query.get(key)\n716:             recorder.check(\n717:                 f'{aid}-query-{key}',\n718:                 actual_value == value,\n719:                 f'303 Location={location!r} 的 {key}={actual_value!r}（期望 {value!r}）',\n720:             )\n721:     page = client.get(location, accept='text/html')\n722:     recorder.expect_status(page, 200, aid=f'{aid}-follow-status')\n723:     return page, location\n724: \n725: \n726: def _home_page(client, recorder, aid, params=None):\n727:     response = client.get('/', params=params, accept='text/html')\n728:     recorder.expect_status(response, 200, aid=f'{aid}-status')\n729:     recorder.check(\n730:         f'{aid}-content-type',\n731:         'text/html' in response.content_type.lower(),\n732:         f'GET / Content-Type={response.content_type!r}',\n733:     )\n734:     return _parse_html(response.text)\n735: \n736: \n737: def _categories_page(client, recorder, aid):\n738:     response = client.get('/categories', accept='text/html')\n739:     recorder.expect_status(response, 200, aid=f'{aid}-status')\n740:     recorder.check(\n741:         f'{aid}-content-type',\n742:         'text/html' in response.content_type.lower(),\n743:         f'GET /categories Content-Type={response.content_type!r}',\n744:     )\n745:     return _parse_html(response.text)\n746: \n747: \n748: def _expect_html_error(recorder, response, aid, label, expected_status):\n749:     recorder.check(\n750:         f'{aid}-no-5xx',\n751:         response.status < 500,\n752:         f'{label} -> HTTP {response.status}（校验类错误不得产生 5xx）',\n753:     )\n754:     recorder.expect_status(\n755:         response,\n756:         expected_status,\n757:         aid=f'{aid}-status',\n758:         detail=f'{label} -> HTTP {response.status}（期望 {expected_status}）',\n759:     )\n760:     doc = _parse_html(response.text)\n761:     error_text = _form_error_text(doc)\n762:     recorder.check(\n763:         f'{aid}-form-error',\n764:         bool(error_text),\n765:         f'{label} 显示可读 form-error，实际 {error_text!r}',\n766:     )\n767:     return doc\n768: \n769: \n770: def _get_record_json(client, recorder, aid, record_id):\n771:     response = client.get(_bookmark_path(record_id))\n772:     recorder.expect_status(response, 200, aid=f'{aid}-status')\n773:     payload = _safe_json(response)\n774:     record = _extract_record(payload)\n775:     recorder.check(\n776:         f'{aid}-shape',\n777:         isinstance(record, dict),\n778:         f'GET /api/bookmarks/{record_id} 返回 JSON 对象，实际 {type(payload).__name__}',\n779:     )\n780:     return record if isinstance(record, dict) else None\n781: \n782: \n783: def _save_form_from_home(client, recorder, aid, params=None):\n784:     page = client.get('/', params=params, accept='text/html')\n785:     recorder.expect_status(page, 200, aid=f'{aid}-status')\n786:     doc = _parse_html(page.text)\n787:     form = doc.save_form()\n788:     recorder.check(\n789:         f'{aid}-save-form',\n790:         form is not None,\n791:         '首页含 action=/bookmarks/new 且 method=post 的真实保存表单',\n792:     )\n793:     return doc, form\n794: \n795: \n796: def _check_json_error(recorder, response, prefix, expected_status, expected_code, label):\n797:     recorder.check(\n798:         f'{prefix}-no-5xx',\n799:         response.status < 500,\n800:         f'{label} -> HTTP {response.status}（校验类错误不得产生 5xx）',\n801:     )\n802:     recorder.expect_status(\n803:         response,\n804:         expected_status,\n805:         aid=f'{prefix}-status',\n806:         detail=f'{label} -> HTTP {response.status}（期望 {expected_status}）',\n807:     )\n808:     code = _error_code(response)\n809:     recorder.check(\n810:         f'{prefix}-code',\n811:         code == expected_code,\n812:         f'{label} 错误码={code!r}（期望 {expected_code}）',\n813:     )\n814: \n815: \n816: def _a09_live_flow(client, recorder):\n817:     health = client.get('/api/health')\n818:     recorder.expect_status(health, 200, aid='a09-live-health-status')\n819: \n820:     _, save_form = _save_form_from_home(client, recorder, 'a09-live')\n821:     if save_form is None:\n822:         return\n823: \n824:     name = _unique_category('a09-live')\n825:     url = _unique_url('a09-live')\n826:     title = f'A09 恢复标题 {uuid.uuid4().hex[:8]}'\n827:     description = f'A09 恢复描述 {uuid.uuid4().hex[:8]}'\n828:     response = client.post_form(\n829:         _form_path(save_form, '/bookmarks/new'),\n830:         _form_fields(save_form, {\n831:             'url': url,\n832:             'title': title,\n833:             'description': description,\n834:             'category': name,\n835:         }),\n836:         follow_redirects=False,\n837:         accept='text/html',\n838:     )\n839:     page, _ = _follow_303(\n840:         client, recorder, response, 'a09-live-save', expected_path='/'\n841:     )\n842:     if page is None:\n843:         return\n844:     doc = _parse_html(page.text)\n845:     row = _row_for_url(doc, url)\n846:     if row is None:\n847:         doc = _home_page(client, recorder, 'a09-live-save-fallback')\n848:         row = _row_for_url(doc, url)\n849:     if not recorder.check(\n850:         'a09-live-saved-row',\n851:         row is not None,\n852:         f'真实保存表单提交后 HTML 列表出现 url={url!r} 的记录行',\n853:     ):\n854:         return\n855:     record_id = row.record_id\n856:     if not recorder.check(\n857:         'a09-live-saved-id', bool(record_id), f'保存记录 data-record-id={record_id!r}'\n858:     ):\n859:         return\n860: \n861:     categories = _fetch_categories(client, recorder, 'a09-live-categories')\n862:     category = _find_category_by_name(categories, name)\n863:     category_id = _record_id(category)\n864:     if not recorder.check(\n865:         'a09-live-category-created',\n866:         bool(category_id),\n867:         f'保存新归类名 {name!r} 后 /api/categories 自动创建该归类 id={category_id!r}',\n868:     ):\n869:         return\n870:     count_before = category.get('count') if isinstance(category, dict) else None\n871:     recorder.check(\n872:         'a09-live-count-before-delete',\n873:         count_before == 1,\n874:         f'删除前归类 {name!r} API count={count_before!r}（期望 1）',\n875:     )\n876: \n877:     record = _get_record_json(client, recorder, 'a09-live-record', record_id)\n878:     if record is not None:\n879:         recorder.check(\n880:             'a09-live-record-url',\n881:             _record_url(record) == url,\n882:             f'保存后 url={_record_url(record)!r}（期望 {url!r}）',\n883:         )\n884:         recorder.check(\n885:             'a09-live-record-title',\n886:             _record_title(record) == title,\n887:             f'保存后 title={_record_title(record)!r}（期望 {title!r}）',\n888:         )\n889:         recorder.check(\n890:             'a09-live-record-description',\n891:             _record_description(record) == description,\n892:             f'保存后 description={_record_description(record)!r}（期望 {description!r}）',\n893:         )\n894:         recorder.check(\n895:             'a09-live-record-category',\n896:             _record_category_name(record, categories) == name,\n897:             f'保存后 category={_record_category_name(record, categories)!r}（期望 {name!r}）',\n898:         )\n899: \n900:     delete_form = _find_record_form(doc, 'record-delete-form', record_id)\n901:     if delete_form is None:\n902:         doc = _home_page(\n903:             client, recorder, 'a09-live-delete-home', params={'category': name}\n904:         )\n905:         delete_form = _find_record_form(doc, 'record-delete-form', record_id)\n906:     if not recorder.check(\n907:         'a09-live-delete-form',\n908:         delete_form is not None,\n909:         f'记录 {record_id!r} 行含 record-delete-form',\n910:     ):\n911:         return\n912:     response = client.post_form(\n913:         _form_path(delete_form, '/'),\n914:         _form_fields(delete_form),\n915:         follow_redirects=False,\n916:         accept='text/html',\n917:     )\n918:     page, _ = _follow_303(\n919:         client, recorder, response, 'a09-live-delete',\n920:         expected_path='/', expected_query={'trash': '1'},\n921:     )\n922:     if page is None:\n923:         return\n924:     trash_doc = _parse_html(page.text)\n925: \n926:     default_doc = _home_page(client, recorder, 'a09-live-default-after-delete')\n927:     recorder.check(\n928:         'a09-live-default-excluded',\n929:         record_id not in _row_ids(default_doc),\n930:         f'删除后默认列表排除记录 {record_id!r}',\n931:     )\n932:     category_doc = _home_page(\n933:         client, recorder, 'a09-live-category-list-after-delete',\n934:         params={'category': name},\n935:     )\n936:     recorder.check(\n937:         'a09-live-category-list-excluded',\n938:         record_id not in _row_ids(category_doc),\n939:         f'删除后归类 {name!r} 的活动列表排除记录 {record_id!r}',\n940:     )\n941: \n942:     categories_after = _fetch_categories(client, recorder, 'a09-live-categories-after')\n943:     category_after = _find_category_by_id(categories_after, category_id)\n944:     count_after = category_after.get('count') if isinstance(category_after, dict) else None\n945:     recorder.check(\n946:         'a09-live-api-count-excluded',\n947:         count_after == 0,\n948:         f'删除后归类 {name!r} API count={count_after!r}（期望 0，只计活动记录）',\n949:     )\n950:     categories_page = _categories_page(\n951:         client, recorder, 'a09-live-categories-page-after-delete'\n952:     )\n953:     for label, count_doc in (('home', default_doc), ('categories', categories_page)):\n954:         values = _category_count_values(count_doc).get(category_id, [])\n955:         recorder.check(\n956:             f'a09-live-html-count-{label}',\n957:             bool(values) and all(value == 0 for value in values),\n958:             f'删除后 {label} HTML 归类 {name!r} 计数={values!r}（期望 0）',\n959:         )\n960: \n961:     trashed = _fetch_bookmarks(\n962:         client, recorder, 'a09-live-trashed',\n963:         params={'category': name, 'include_trashed': 1},\n964:     )\n965:     recorder.check(\n966:         'a09-live-soft-deleted',\n967:         record_id in _record_ids(trashed),\n968:         f'include_trashed=1 时记录 {record_id!r} 仍存在，证明删除是软删除',\n969:     )\n970: \n971:     restore_form = _find_record_form(trash_doc, 'record-restore-form', record_id)\n972:     if restore_form is None:\n973:         trash_doc = _home_page(\n974:             client, recorder, 'a09-live-trash-refetch', params={'trash': 1}\n975:         )\n976:         restore_form = _find_record_form(trash_doc, 'record-restore-form', record_id)\n977:     if not recorder.check(\n978:         'a09-live-restore-form',\n979:         restore_form is not None,\n980:         f'/?trash=1 显示记录 {record_id!r} 的 record-restore-form',\n981:     ):\n982:         return\n983: \n984:     response = client.post_form(\n985:         _form_path(restore_form, '/'),\n986:         _form_fields(restore_form),\n987:         follow_redirects=False,\n988:         accept='text/html',\n989:     )\n990:     page, _ = _follow_303(\n991:         client, recorder, response, 'a09-live-restore',\n992:         expected_path='/', expected_query={'category': name},\n993:     )\n994:     if page is None:\n995:         return\n996:     restored_doc = _parse_html(page.text)\n997:     recorder.check(\n998:         'a09-live-restored-row',\n999:         record_id in _row_ids(restored_doc),\n1000:         f'恢复后归类页重新显示记录 {record_id!r}',\n1001:     )\n1002:     default_after = _home_page(client, recorder, 'a09-live-default-after-restore')\n1003:     recorder.check(\n1004:         'a09-live-restored-default-visible',\n1005:         record_id in _row_ids(default_after),\n1006:         f'恢复后默认列表重新显示记录 {record_id!r}',\n1007:     )\n1008:     categories_restored = _fetch_categories(\n1009:         client, recorder, 'a09-live-categories-after-restore'\n1010:     )\n1011:     category_restored = _find_category_by_id(categories_restored, category_id)\n1012:     count_restored = (\n1013:         category_restored.get('count') if isinstance(category_restored, dict) else None\n1014:     )\n1015:     recorder.check(\n1016:         'a09-live-count-after-restore',\n1017:         count_restored == 1,\n1018:         f'恢复后归类 {name!r} API count={count_restored!r}（期望 1）',\n1019:     )\n1020:     restored = _get_record_json(\n1021:         client, recorder, 'a09-live-restored-record', record_id\n1022:     )\n1023:     if restored is not None:\n1024:         recorder.check(\n1025:             'a09-live-restored-url',\n1026:             _record_url(restored) == url,\n1027:             f'恢复后 url={_record_url(restored)!r}（期望 {url!r}）',\n1028:         )\n1029:         recorder.check(\n1030:             'a09-live-restored-title',\n1031:             _record_title(restored) == title,\n1032:             f'恢复后 title={_record_title(restored)!r}（期望 {title!r}）',\n1033:         )\n1034:         recorder.check(\n1035:             'a09-live-restored-description',\n1036:             _record_description(restored) == description,\n1037:             f'恢复后 description={_record_description(restored)!r}（期望 {description!r}）',\n1038:         )\n1039:         recorder.check(\n1040:             'a09-live-restored-category',\n1041:             _record_category_name(restored, categories_restored) == name,\n1042:             f'恢复后 category={_record_category_name(restored, categories_restored)!r}（期望 {name!r}）',\n1043:         )\n1044: \n1045: \n1046: def _a09_category_migration(client, recorder):\n1047:     categories_page = _categories_page(client, recorder, 'a09-migrate-categories-page')\n1048:     create_form = _first_form(categories_page, 'category-create-form')\n1049:     if not recorder.check(\n1050:         'a09-migrate-create-form',\n1051:         create_form is not None and create_form.has_name('name'),\n1052:         'GET /categories 含 category-create-form 与 name 输入',\n1053:     ):\n1054:         return\n1055: \n1056:     name = _unique_category('a09-migrate')\n1057:     response = client.post_form(\n1058:         _form_path(create_form, '/categories'),\n1059:         _form_fields(create_form, {'name': name}),\n1060:         follow_redirects=False,\n1061:         accept='text/html',\n1062:     )\n1063:     page, _ = _follow_303(\n1064:         client, recorder, response, 'a09-migrate-create', expected_path='/categories'\n1065:     )\n1066:     if page is None:\n1067:         return\n1068:     categories = _fetch_categories(client, recorder, 'a09-migrate-created')\n1069:     category = _find_category_by_name(categories, name)\n1070:     category_id = _record_id(category)\n1071:     if not recorder.check(\n1072:         'a09-migrate-created-id',\n1073:         bool(category_id),\n1074:         f'真实归类表单创建归类 {name!r} 后 id={category_id!r}',\n1075:     ):\n1076:         return\n1077: \n1078:     _, save_form = _save_form_from_home(client, recorder, 'a09-migrate-save')\n1079:     if save_form is None:\n1080:         return\n1081:     url = _unique_url('a09-migrate')\n1082:     title = f'A09 迁移标题 {uuid.uuid4().hex[:8]}'\n1083:     description = f'A09 迁移描述 {uuid.uuid4().hex[:8]}'\n1084:     response = client.post_form(\n1085:         _form_path(save_form, '/bookmarks/new'),\n1086:         _form_fields(save_form, {\n1087:             'url': url,\n1088:             'title': title,\n1089:             'description': description,\n1090:             'category': name,\n1091:         }),\n1092:         follow_redirects=False,\n1093:         accept='text/html',\n1094:     )\n1095:     page, _ = _follow_303(\n1096:         client, recorder, response, 'a09-migrate-save', expected_path='/'\n1097:     )\n1098:     if page is None:\n1099:         return\n1100:     doc = _parse_html(page.text)\n1101:     row = _row_for_url(doc, url)\n1102:     if row is None:\n1103:         doc = _home_page(\n1104:             client, recorder, 'a09-migrate-save-fallback', params={'category': name}\n1105:         )\n1106:         row = _row_for_url(doc, url)\n1107:     if not recorder.check(\n1108:         'a09-migrate-saved-row',\n1109:         row is not None,\n1110:         f'在归类 {name!r} 中经真实保存表单创建记录 url={url!r}',\n1111:     ):\n1112:         return\n1113:     record_id = row.record_id\n1114:     if not recorder.check(\n1115:         'a09-migrate-saved-id', bool(record_id), f'迁移用例记录 id={record_id!r}'\n1116:     ):\n1117:         return\n1118:     saved = _get_record_json(client, recorder, 'a09-migrate-saved-record', record_id)\n1119:     if saved is not None:\n1120:         recorder.check(\n1121:             'a09-migrate-saved-category',\n1122:             _record_category_name(saved, categories) == name,\n1123:             f'保存后记录 category={_record_category_name(saved, categories)!r}（期望 {name!r}）',\n1124:         )\n1125: \n1126:     delete_form = _find_record_form(doc, 'record-delete-form', record_id)\n1127:     if delete_form is None:\n1128:         doc = _home_page(\n1129:             client, recorder, 'a09-migrate-delete-home', params={'category': name}\n1130:         )\n1131:         delete_form = _find_record_form(doc, 'record-delete-form', record_id)\n1132:     if not recorder.check(\n1133:         'a09-migrate-delete-form',\n1134:         delete_form is not None,\n1135:         f'记录 {record_id!r} 行含 record-delete-form',\n1136:     ):\n1137:         return\n1138:     response = client.post_form(\n1139:         _form_path(delete_form, '/'),\n1140:         _form_fields(delete_form),\n1141:         follow_redirects=False,\n1142:         accept='text/html',\n1143:     )\n1144:     page, _ = _follow_303(\n1145:         client, recorder, response, 'a09-migrate-delete',\n1146:         expected_path='/', expected_query={'trash': '1'},\n1147:     )\n1148:     if page is None:\n1149:         return\n1150:     trash_doc = _parse_html(page.text)\n1151:     recorder.check(\n1152:         'a09-migrate-trashed-before-category-delete',\n1153:         _find_record_form(trash_doc, 'record-restore-form', record_id) is not None,\n1154:         f'删除归类前 /?trash=1 显示记录 {record_id!r} 的恢复表单',\n1155:     )\n1156: \n1157:     categories_page = _categories_page(\n1158:         client, recorder, 'a09-migrate-delete-category-page'\n1159:     )\n1160:     category_delete_form = _form_for_category(\n1161:         categories_page, 'category-delete-form', category_id\n1162:     )\n1163:     if not recorder.check(\n1164:         'a09-migrate-category-delete-form',\n1165:         category_delete_form is not None,\n1166:         f'找到归类 {name!r} 的 category-delete-form',\n1167:     ):\n1168:         return\n1169:     response = client.post_form(\n1170:         _form_path(category_delete_form, '/categories'),\n1171:         _form_fields(category_delete_form, {'category_id': category_id}),\n1172:         follow_redirects=False,\n1173:         accept='text/html',\n1174:     )\n1175:     page, _ = _follow_303(\n1176:         client, recorder, response, 'a09-migrate-category-delete',\n1177:         expected_path='/categories',\n1178:     )\n1179:     if page is None:\n1180:         return\n1181: \n1182:     categories_after = _fetch_categories(\n1183:         client, recorder, 'a09-migrate-categories-after'\n1184:     )\n1185:     recorder.check(\n1186:         'a09-migrate-category-gone',\n1187:         _find_category_by_id(categories_after, category_id) is None\n1188:         and _find_category_by_name(categories_after, name) is None,\n1189:         f'删除后归类 {name!r} 不再存在',\n1190:     )\n1191:     default_item = _default_category(categories_after)\n1192:     default_id = _record_id(default_item)\n1193:     if not recorder.check(\n1194:         'a09-migrate-default-id',\n1195:         bool(default_id),\n1196:         f'默认归类「{common.DEFAULT_CATEGORY}」id={default_id!r}',\n1197:     ):\n1198:         return\n1199: \n1200:     migrated = _get_record_json(\n1201:         client, recorder, 'a09-migrate-record-after-category-delete', record_id\n1202:     )\n1203:     if migrated is not None:\n1204:         actual = _record_category_name(migrated, categories_after)\n1205:         recorder.check(\n1206:             'a09-migrate-record-default',\n1207:             actual == common.DEFAULT_CATEGORY,\n1208:             f'删除归类后软删记录 category={actual!r}（期望 {common.DEFAULT_CATEGORY!r}）',\n1209:         )\n1210:         actual_id = _record_category_id(migrated)\n1211:         if actual_id is not None:\n1212:             recorder.check(\n1213:                 'a09-migrate-record-default-id',\n1214:                 actual_id == default_id,\n1215:                 f'删除归类后软删记录 category_id={actual_id!r}（期望默认归类 {default_id!r}）',\n1216:             )\n1217: \n1218:     default_all = _fetch_bookmarks(\n1219:         client, recorder, 'a09-migrate-default-all',\n1220:         params={\n1221:             'category': common.DEFAULT_CATEGORY,\n1222:             'include_trashed': 1,\n1223:         },\n1224:     )\n1225:     recorder.check(\n1226:         'a09-migrate-soft-deleted-in-default',\n1227:         record_id in _record_ids(default_all),\n1228:         f'删除归类后软删记录 {record_id!r} 仍存在于「{common.DEFAULT_CATEGORY}」回收内容',\n1229:     )\n1230: \n1231:     trash_doc = _home_page(\n1232:         client, recorder, 'a09-migrate-trash-after-category-delete', params={'trash': 1}\n1233:     )\n1234:     restore_form = _find_record_form(trash_doc, 'record-restore-form', record_id)\n1235:     if not recorder.check(\n1236:         'a09-migrate-still-restorable',\n1237:         restore_form is not None,\n1238:         f'删除归类后软删记录 {record_id!r} 仍在 /?trash=1 可恢复',\n1239:     ):\n1240:         return\n1241:     response = client.post_form(\n1242:         _form_path(restore_form, '/'),\n1243:         _form_fields(restore_form),\n1244:         follow_redirects=False,\n1245:         accept='text/html',\n1246:     )\n1247:     page, _ = _follow_303(\n1248:         client, recorder, response, 'a09-migrate-restore',\n1249:         expected_path='/', expected_query={'category': common.DEFAULT_CATEGORY},\n1250:     )\n1251:     if page is None:\n1252:         return\n1253:     default_active = _fetch_bookmarks(\n1254:         client, recorder, 'a09-migrate-default-active',\n1255:         params={'category': common.DEFAULT_CATEGORY},\n1256:     )\n1257:     recorder.check(\n1258:         'a09-migrate-restored-visible',\n1259:         record_id in _record_ids(default_active),\n1260:         f'恢复后记录 {record_id!r} 回到「{common.DEFAULT_CATEGORY}」活动列表',\n1261:     )\n1262:     restored = _get_record_json(\n1263:         client, recorder, 'a09-migrate-restored-record', record_id\n1264:     )\n1265:     if restored is not None:\n1266:         actual = _record_category_name(restored, categories_after)\n1267:         recorder.check(\n1268:             'a09-migrate-restored-category',\n1269:             actual == common.DEFAULT_CATEGORY,\n1270:             f'恢复后记录 category={actual!r}（期望 {common.DEFAULT_CATEGORY!r}）',\n1271:         )\n1272:         restored_category_id = _record_category_id(restored)\n1273:         if restored_category_id is not None:\n1274:             recorder.check(\n1275:                 'a09-migrate-restored-category-id',\n1276:                 restored_category_id == default_id,\n1277:                 f'恢复后记录 category_id={restored_category_id!r}（期望 {default_id!r}）',\n1278:             )\n1279:     final_categories = _fetch_categories(\n1280:         client, recorder, 'a09-migrate-final-categories'\n1281:     )\n1282:     final_default = _find_category_by_id(final_categories, default_id)\n1283:     final_default_count = (\n1284:         final_default.get('count') if isinstance(final_default, dict) else None\n1285:     )\n1286:     recorder.check(\n1287:         'a09-migrate-no-orphan',\n1288:         final_default is not None\n1289:         and isinstance(final_default_count, int)\n1290:         and final_default_count >= 1,\n1291:         f'恢复后默认归类仍存在且 count={final_default_count!r}，记录无孤儿引用',\n1292:     )\n1293: \n1294: \n1295: def _a09_across_restart(args, recorder):\n1296:     first = common.launch_app(args.app_root, args.data_dir, 0)\n1297:     instance_dir = first.instance_dir\n1298:     record_id = None\n1299:     url = _unique_url('a09-restart')\n1300:     title = f'A09 重启标题 {uuid.uuid4().hex[:8]}'\n1301:     description = f'A09 重启描述 {uuid.uuid4().hex[:8]}'\n1302:     category_name = _unique_category('a09-restart')\n1303:     try:\n1304:         client = common.HttpClient(first.base_url)\n1305:         try:\n1306:             health = client.get('/api/health')\n1307:             recorder.expect_status(health, 200, aid='a09-restart-health-status')\n1308:             _, save_form = _save_form_from_home(\n1309:                 client, recorder, 'a09-restart-save'\n1310:             )\n1311:             doc = None\n1312:             if save_form is not None:\n1313:                 response = client.post_form(\n1314:                     _form_path(save_form, '/bookmarks/new'),\n1315:                     _form_fields(save_form, {\n1316:                         'url': url,\n1317:                         'title': title,\n1318:                         'description': description,\n1319:                         'category': category_name,\n1320:                     }),\n1321:                     follow_redirects=False,\n1322:                     accept='text/html',\n1323:                 )\n1324:                 page, _ = _follow_303(\n1325:                     client, recorder, response, 'a09-restart-save',\n1326:                     expected_path='/',\n1327:                 )\n1328:                 if page is not None:\n1329:                     doc = _parse_html(page.text)\n1330:                     row = _row_for_url(doc, url)\n1331:                     if row is None:\n1332:                         doc = _home_page(\n1333:                             client, recorder, 'a09-restart-save-fallback',\n1334:                             params={'category': category_name},\n1335:                         )\n1336:                         row = _row_for_url(doc, url)\n1337:                     if recorder.check(\n1338:                         'a09-restart-saved-row',\n1339:                         row is not None,\n1340:                         f'隔离实例经真实保存表单创建 url={url!r}',\n1341:                     ):\n1342:                         record_id = row.record_id\n1343:                         recorder.check(\n1344:                             'a09-restart-saved-id',\n1345:                             bool(record_id),\n1346:                             f'隔离实例记录 data-record-id={record_id!r}',\n1347:                         )\n1348:             if record_id:\n1349:                 delete_form = _find_record_form(\n1350:                     doc, 'record-delete-form', record_id\n1351:                 ) if doc is not None else None\n1352:                 if delete_form is None:\n1353:                     doc = _home_page(\n1354:                         client, recorder, 'a09-restart-delete-home',\n1355:                         params={'category': category_name},\n1356:                     )\n1357:                     delete_form = _find_record_form(\n1358:                         doc, 'record-delete-form', record_id\n1359:                     )\n1360:                 if recorder.check(\n1361:                     'a09-restart-delete-form',\n1362:                     delete_form is not None,\n1363:                     f'隔离实例记录 {record_id!r} 行含 record-delete-form',\n1364:                 ):\n1365:                     response = client.post_form(\n1366:                         _form_path(delete_form, '/'),\n1367:                         _form_fields(delete_form),\n1368:                         follow_redirects=False,\n1369:                         accept='text/html',\n1370:                     )\n1371:                     page, _ = _follow_303(\n1372:                         client, recorder, response, 'a09-restart-delete',\n1373:                   