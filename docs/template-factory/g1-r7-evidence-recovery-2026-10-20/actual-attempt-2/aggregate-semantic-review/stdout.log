ayload),\\n            f'/api/health 返回非空 JSON 对象，实际 {type(health_payload).__name__}',\\n        )\\n        page = client.get('/', accept='text/html')\\n        recorder.expect_status(page, 200, aid='a11-home-status')\\n        recorder.check(\\n            'a11-home-content-type',\\n            'text/html' in page.content_type.lower(),\\n            f'首页 Content-Type={page.content_type!r}',\\n        )\\n        doc = _parse_html(page.text)\\n        form = doc.save_form()\\n        recorder.check(\\n            'a11-entry-form',\\n            form is not None,\\n            '首页含 action=/bookmarks/new 且 method=post 的录入表单',\\n        )\\n        if form is not None:\\n            recorder.check(\\n                'a11-entry-action',\\n                _action_path(form.action) == '/bookmarks/new',\\n                f'录入表单 action={form.action!r}',\\n            )\\n            recorder.check(\\n                'a11-url-field',\\n                form.has_name('url'),\\n                '录入表单含 name=url 输入字段',\\n            )\\n        manager = next(\\n            (anchor for anchor in doc.anchors if anchor.testid == 'category-manager'),\\n            None,\\n        )\\n        manager_href = manager.href if manager is not None else None\\n        manager_path = ''\\n        if manager_href:\\n            try:\\n                manager_path = urllib.parse.urlsplit(manager_href).path.rstrip('/')\\n            except ValueError:\\n                manager_path = ''\\n        recorder.check(\\n            'a11-category-manager',\\n            manager is not None and manager_path == '/categorie... (line truncated to 2000 chars)\n32:     },\n33:     {\n34:      \"new\": \"    try:\\n        args = common.parse_case_args(argv)\\n    except SystemExit as exc:\\n        raw_args = list(sys.argv[1:] if argv is None else argv)\\n        requested_a11 = '--case=A11' in raw_args or any(\\n            value == '--case' and index + 1 < len(raw_args) and raw_args[index + 1] == 'A11'\\