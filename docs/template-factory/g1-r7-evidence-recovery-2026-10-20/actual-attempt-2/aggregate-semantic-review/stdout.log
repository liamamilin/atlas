{"type":"tool_use","timestamp":1792484178886,"sessionID":"ses_ea79fcfd3ffeGu4Pan86lE7BF8","part":{"partID":"prt_15861fbbc002PA8qAuTBX73QrG","sessionID":"ses_ea79fcfd3ffeGu4Pan86lE7BF8","messageID":"msg_15861db220014wVCJ5YBMUnW6m","type":"tool","id":"call_6ef3b7052c554b638e2f7b3d","tool":"read","state":{"status":"completed","input":{"path":"source/baseline/acceptance/p0_recovery.py","limit":2000},"output":"Read file source/baseline/acceptance/p0_recovery.py, lines 1-456\n1: #!/usr/bin/env python3\n2: '''P0 行为验收组：删除恢复与错误合同。\n3: \n4: 覆盖 A09、A10。仅使用 Python 3.12 标准库并复用 acceptance/common.py：\n5: 以 --case 派发，未知用例显式失败；每个用例对真实目标执行正向与硬负向\n6: 行为断言，向 stdout 输出单个 atlas.acceptance-result.v1 JSON，失败时以\n7: 非零码退出。\n8: '''\n9: \n10: from __future__ import annotations\n11: \n12: import os\n13: import sys\n14: import uuid\n15: from urllib.parse import quote\n16: \n17: _THIS_DIR = os.path.dirname(os.path.abspath(__file__))\n18: if _THIS_DIR not in sys.path:\n19:     sys.path.insert(0, _THIS_DIR)\n20: \n21: import common\n22: \n23: _SUCCESS_STATUSES = (200, 204)\n24: \n25: \n26: def _unique_url(tag):\n27:     token = f'{tag}-{uuid.uuid4().hex[:12]}'\n28:     return f'https://{token}.atlas-acceptance.example/{token}'\n29: \n30: \n31: def _unique_category(tag):\n32:     return f'atlas-{tag}-{uuid.uuid4().hex[:10]}'\n33: \n34: \n35: def _safe_json(response):\n36:     try:\n37:         return response.json()\n38:     except Exception:\n39:         return None\n40: \n41: \n42: def _extract_record(payload):\n43:     if isinstance(payload, dict):\n44:         for key in ('bookmark', 'record', 'data', 'item'):\n45:             value = payload.get(key)\n46:             if isinstance(value, dict):\n47:                 return value\n48:         return payload\n49:     return None\n50: \n51: \n52: def _record_id(record):\n53:     if isinstance(record, dict) and record.get('id') is not None:\n54:         return str(record['id'])\n55:     return None\n56: \n57: \n58: def _record_url(record):\n59:     if isinstance(record, dict) and record.get('url') is not None:\n60:         return str(record['url'])\n61:     return None\n62: \n63: \n64: def _record_title(record):\n65:     if isinstance(record, dict) and record.get('title') is not None:\n66:         return str(record['title'])\n67:     return None\n68: \n69: \n70: def _record_description(record):\n71:     if isinstance(record, dict):\n72:         for key in ('description', 'desc'):\n73:             if record.get(key) is not None:\n74:                 return str(record[key])\n75:     return None\n76: \n77: \n78: def _record_category_name(record):\n79:     if isinstance(record, dict):\n80:         for key in ('category', 'category_name'):\n81:             value = record.get(key)\n82:             if isinstance(value, str) and value:\n83:                 return value\n84:             if isinstance(value, dict) and value.get('name'):\n85:                 return str(value['name'])\n86:     return None\n87: \n88: \n89: def _error_code(response):\n90:     payload = _safe_json(response)\n91:     if isinstance(payload, dict):\n92:         error = payload.get('error')\n93:         if isinstance(error, dict) and error.get('code') is not None:\n94:             return str(error['code'])\n95:         for key in ('code', 'error_code'):\n96:             if payload.get(key) is not None:\n97:                 return str(payload[key])\n98:     return None\n99: \n100: \n101: def _extract_list(payload, keys):\n102:     if isinstance(payload, list):\n103:         return payload\n104:     if isinstance(payload, dict):\n105:         for key in keys:\n106:             value = payload.get(key)\n107:             if isinstance(value, list):\n108:                 return value\n109:     return None\n110: \n111: \n112: def _bookmark_path(bookmark_id):\n113:     return '/api/bookmarks/' + quote(str(bookmark_id), safe='')\n114: \n115: \n116: def _restore_path(bookmark_id):\n117:     return _bookmark_path(bookmark_id) + '/restore'\n118: \n119: \n120: def _move_path(bookmark_id):\n121:     return _bookmark_path(bookmark_id) + '/move'\n122: \n123: \n124: def _record_ids(records):\n125:     return {item_id for item_id in (_record_id(record) for record in records) if item_id}\n126: \n127: \n128: def _fetch_bookmarks(client, recorder, aid, params=None):\n129:     response = client.get('/api/bookmarks', params=params)\n130:     recorder.expect_status(response, 200, aid=f'{aid}-list-status')\n131:     payload = _safe_json(response)\n132:     records = _extract_list(payload, ('bookmarks', 'items', 'data', 'records'))\n133:     recorder.check(\n134:         f'{aid}-list-shape',\n135:         isinstance(records, list),\n136:         f'GET /api/bookmarks 必须返回 JSON 数组，实际 {type(payload).__name__}',\n137:     )\n138:     return records if isinstance(records, list) else []\n139: \n140: \n141: def _check_error(recorder, response, prefix, expected_status, expected_code, label):\n142:     recorder.check(\n143:         f'{prefix}-no-5xx',\n144:         response.status < 500,\n145:         f'{label} -> HTTP {response.status}（校验类错误不得产生 5xx）',\n146:     )\n147:     recorder.expect_status(\n148:         response,\n149:         expected_status,\n150:         aid=f'{prefix}-status',\n151:         detail=f'{label} -> HTTP {response.status}（期望 {expected_status}）',\n152:     )\n153:     code = _error_code(response)\n154:     recorder.check(\n155:         f'{prefix}-code',\n156:         code == expected_code,\n157:         f'{label} 错误码={code!r}（期望 {expected_code}）',\n158:     )\n159: \n160: \n161: def _create_record(client, recorder, aid, title=None, description=None):\n162:     url = _unique_url(aid)\n163:     payload = {'url': url}\n164:     if title is not None:\n165:         payload['title'] = title\n166:     if description is not None:\n167:         payload['description'] = description\n168:     response = client.post_json('/api/bookmarks', payload)\n169:     recorder.expect_status(response, 201, aid=f'{aid}-save-status')\n170:     record_id = _record_id(_extract_record(_safe_json(response)))\n171:     recorder.check(f'{aid}-save-id', bool(record_id), f'保存 {url} 返回 id={record_id!r}')\n172:     return record_id\n173: \n174: \n175: def _a09_on_base_url(args, recorder):\n176:     client = common.HttpClient(args.base_url)\n177:     try:\n178:         health = client.get('/api/health')\n179:         recorder.expect_status(health, 200, aid='a09-live-health-status')\n180: \n181:         category_name = _unique_category('a09live')\n182:         url = _unique_url('a09live')\n183:         title = f'A09 删除恢复 {uuid.uuid4().hex[:8]}'\n184:         description = f'A09 描述 {uuid.uuid4().hex[:8]}'\n185:         created = client.post_json(\n186:             '/api/bookmarks',\n187:             {'url': url, 'title': title, 'description': description, 'category': category_name},\n188:         )\n189:         recorder.expect_status(created, 201, aid='a09-live-create-status')\n190:         record_id = _record_id(_extract_record(_safe_json(created)))\n191:         recorder.check('a09-live-create-id', bool(record_id), f'创建记录返回 id={record_id!r}')\n192:         if not record_id:\n193:             return\n194: \n195:         before = _fetch_bookmarks(client, recorder, 'a09-live-before', params={'category': category_name})\n196:         recorder.check(\n197:             'a09-live-visible-before',\n198:             record_id in _record_ids(before),\n199:             f'删除前记录 {record_id!r} 出现在归类 {category_name!r} 中',\n200:         )\n201: \n202:         deleted = client.request('DELETE', _bookmark_path(record_id))\n203:         recorder.expect_status(deleted, _SUCCESS_STATUSES, aid='a09-live-delete-status')\n204: \n205:         after_delete = _fetch_bookmarks(\n206:             client, recorder, 'a09-live-after-delete', params={'category': category_name}\n207:         )\n208:         recorder.check(\n209:             'a09-live-excluded-after-delete',\n210:             record_id not in _record_ids(after_delete),\n211:             f'删除后默认列表排除记录 {record_id!r}：{sorted(_record_ids(after_delete))}',\n212:         )\n213: \n214:         trashed = _fetch_bookmarks(\n215:             client, recorder, 'a09-live-trashed',\n216:             params={'category': category_name, 'include_trashed': 1},\n217:         )\n218:         recorder.check(\n219:             'a09-live-soft-deleted',\n220:             record_id in _record_ids(trashed),\n221:             f'删除为软删除：include_trashed=1 仍可见记录 {record_id!r}',\n222:         )\n223: \n224:         restored = client.post_json(_restore_path(record_id), {})\n225:         recorder.expect_status(restored, _SUCCESS_STATUSES, aid='a09-live-restore-status')\n226: \n227:         after_restore = _fetch_bookmarks(\n228:             client, recorder, 'a09-live-after-restore', params={'category': category_name}\n229:         )\n230:         recorder.check(\n231:             'a09-live-visible-after-restore',\n232:             record_id in _record_ids(after_restore),\n233:             f'撤销恢复后默认列表重新可见记录 {record_id!r}',\n234:         )\n235: \n236:         fetched = client.get(_bookmark_path(record_id))\n237:         recorder.expect_status(fetched, 200, aid='a09-live-after-fetch-status')\n238:         restored_record = _extract_record(_safe_json(fetched))\n239:         recorder.check(\n240:             'a09-live-restored-url',\n241:             _record_url(restored_record) == url,\n242:             f'恢复后 url={_record_url(restored_record)!r}（期望 {url!r}）',\n243:         )\n244:         recorder.check(\n245:             'a09-live-restored-title',\n246:             _record_title(restored_record) == title,\n247:             f'恢复后 title={_record_title(restored_record)!r}（期望 {title!r}）',\n248:         )\n249:         recorder.check(\n250:             'a09-live-restored-description',\n251:             _record_description(restored_record) == description,\n252:             f'恢复后 description={_record_description(restored_record)!r}（期望 {description!r}）',\n253:         )\n254:         recorder.check(\n255:             'a09-live-restored-category',\n256:             _record_category_name(restored_record) == category_name,\n257:             f'恢复后 category={_record_category_name(restored_record)!r}（期望 {category_name!r}）',\n258:         )\n259:     finally:\n260:         client.close()\n261: \n262: \n263: def _a09_across_restart(args, recorder):\n264:     first = common.launch_app(args.app_root, args.data_dir, 0)\n265:     instance_dir = first.instance_dir\n266:     anchor_id = None\n267:     deleted_id = None\n268:     try:\n269:         client = common.HttpClient(first.base_url)\n270:         try:\n271:             health = client.get('/api/health')\n272:             recorder.expect_status(health, 200, aid='a09-restart-health-status')\n273: \n274:             anchor_id = _create_record(client, recorder, 'a09-restart-anchor', title='A09 重启锚点')\n275:             deleted_id = _create_record(client, recorder, 'a09-restart-deleted', title='A09 重启删除')\n276:             if deleted_id:\n277:                 deleted = client.request('DELETE', _bookmark_path(deleted_id))\n278:                 recorder.expect_status(deleted, _SUCCESS_STATUSES, aid='a09-restart-delete-status')\n279:                 after_delete = _fetch_bookmarks(client, recorder, 'a09-restart-after-delete')\n280:                 recorder.check(\n281:                     'a09-restart-excluded-before-restart',\n282:                     deleted_id not in _record_ids(after_delete),\n283:                     f'终止前已删除记录 {deleted_id!r} 被默认列表排除',\n284:                 )\n285:         finally:\n286:             client.close()\n287:     finally:\n288:         common.stop_app(first)\n289: \n290:     if not (anchor_id and deleted_id):\n291:         recorder.check('a09-restart-persist', False, '隔离实例未返回可用 id，无法验证删除跨重启')\n292:         return\n293: \n294:     second = common.launch_app(args.app_root, args.data_dir, 0, instance_dir=instance_dir)\n295:     try:\n296:         client = common.HttpClient(second.base_url)\n297:         try:\n298:             after = _fetch_bookmarks(client, recorder, 'a09-restart-after')\n299:             ids = _record_ids(after)\n300:             recorder.check(\n301:                 'a09-restart-anchor-persists',\n302:                 anchor_id in ids,\n303:                 f'重启后未删除记录 {anchor_id!r} 仍在默认列表（证明数据已持久化）',\n304:             )\n305:             recorder.check(\n306:                 'a09-restart-deletion-persists',\n307:                 deleted_id not in ids,\n308:                 f'重启后已删除记录 {deleted_id!r} 仍被默认列表排除',\n309:             )\n310:             trashed = _fetch_bookmarks(\n311:                 client, recorder, 'a09-restart-trashed', params={'include_trashed': 1}\n312:             )\n313:             recorder.check(\n314:                 'a09-restart-trash-retained',\n315:                 deleted_id in _record_ids(trashed),\n316:                 f'重启后已删除记录 {deleted_id!r} 仍以软删除状态存在，而非数据丢失',\n317:             )\n318:         finally:\n319:             client.close()\n320:     finally:\n321:         common.stop_app(second)\n322: \n323: \n324: def _case_a09(args, recorder):\n325:     _a09_on_base_url(args, recorder)\n326:     _a09_across_restart(args, recorder)\n327: \n328: \n329: def _case_a10(args, recorder):\n330:     client = common.HttpClient(args.base_url)\n331:     try:\n332:         health = client.get('/api/health')\n333:         recorder.expect_status(health, 200, aid='a10-health-status')\n334: \n335:         anchor_url = _unique_url('a10-anchor')\n336:         anchor_title = f'A10 锚点 {uuid.uuid4().hex[:8]}'\n337:         anchor_description = f'A10 描述 {uuid.uuid4().hex[:8]}'\n338:         created = client.post_json(\n339:             '/api/bookmarks',\n340:             {'url': anchor_url, 'title': anchor_title, 'description': anchor_description},\n341:         )\n342:         recorder.expect_status(created, 201, aid='a10-anchor-create-status')\n343:         anchor_id = _record_id(_extract_record(_safe_json(created)))\n344:         recorder.check('a10-anchor-create-id', bool(anchor_id), f'创建锚点记录返回 id={anchor_id!r}')\n345:         if not anchor_id:\n346:             return\n347: \n348:         before_list = _fetch_bookmarks(client, recorder, 'a10-before-list')\n349:         before_ids = _record_ids(before_list)\n350: \n351:         before_fetch = client.get(_bookmark_path(anchor_id))\n352:         recorder.expect_status(before_fetch, 200, aid='a10-anchor-before-status')\n353:         before_record = _extract_record(_safe_json(before_fetch))\n354: \n355:         unknown = f'unknown-{uuid.uuid4().hex[:12]}'\n356: \n357:         unknown_get = client.get(_bookmark_path(unknown))\n358:         _check_error(\n359:             recorder, unknown_get, 'a10-unknown-get', 404, 'not_found',\n360:             f'GET /api/bookmarks/{unknown}',\n361:         )\n362: \n363:         unknown_patch = client.patch_json(_bookmark_path(unknown), {'title': 'A10 未知 id'})\n364:         _check_error(\n365:             recorder, unknown_patch, 'a10-unknown-patch', 404, 'not_found',\n366:             f'PATCH /api/bookmarks/{unknown}',\n367:         )\n368: \n369:         unknown_delete = client.request('DELETE', _bookmark_path(unknown))\n370:         _check_error(\n371:             recorder, unknown_delete, 'a10-unknown-delete', 404, 'not_found',\n372:             f'DELETE /api/bookmarks/{unknown}',\n373:         )\n374: \n375:         unknown_move = client.post_json(_move_path(unknown), {'category': common.DEFAULT_CATEGORY})\n376:         _check_error(\n377:             recorder, unknown_move, 'a10-unknown-move', 404, 'not_found',\n378:             f'POST /api/bookmarks/{unknown}/move',\n379:         )\n380: \n381:         malformed = (\n382:             ('save', 'POST', '/api/bookmarks', '{\"url\": '),\n383:             ('patch', 'PATCH', _bookmark_path(anchor_id), '{\"title\": '),\n384:             ('move', 'POST', _move_path(anchor_id), '{\"category\": '),\n385:         )\n386:         for label, method, path, body in malformed:\n387:             response = client.request(\n388:                 method, path, data=body, headers={'Content-Type': 'application/json'}\n389:             )\n390:             _check_error(\n391:                 recorder, response, f'a10-malformed-{label}', 400, 'bad_request',\n392:                 f'{method} {path} 畸形 JSON',\n393:             )\n394: \n395:         after_list = _fetch_bookmarks(client, recorder, 'a10-after-list')\n396:         recorder.check(\n397:             'a10-records-unchanged',\n398:             _record_ids(after_list) == before_ids,\n399:             f'错误请求未改变记录集合：{len(before_ids)} -> {len(_record_ids(after_list))}',\n400:         )\n401: \n402:         after_fetch = client.get(_bookmark_path(anchor_id))\n403:         recorder.expect_status(after_fetch, 200, aid='a10-anchor-after-status')\n404:         after_record = _extract_record(_safe_json(after_fetch))\n405:         recorder.check(\n406:             'a10-anchor-url-unchanged',\n407:             _record_url(after_record) == _record_url(before_record),\n408:             f'锚点 url={_record_url(after_record)!r}（未被修改）',\n409:         )\n410:         recorder.check(\n411:             'a10-anchor-title-unchanged',\n412:             _record_title(after_record) == _record_title(before_record),\n413:             f'锚点 title={_record_title(after_record)!r}（未被修改）',\n414:         )\n415:         recorder.check(\n416:             'a10-anchor-description-unchanged',\n417:             _record_description(after_record) == _record_description(before_record),\n418:             f'锚点 description={_record_description(after_record)!r}（未被修改）',\n419:         )\n420:         recorder.check(\n421:             'a10-anchor-category-unchanged',\n422:             _record_category_name(after_record) == _record_category_name(before_record),\n423:             f'锚点 category={_record_category_name(after_record)!r}（未被修改）',\n424:         )\n425:     finally:\n426:         client.close()\n427: \n428: \n429: _HANDLERS = {\n430:     'A09': _case_a09,\n431:     'A10': _case_a10,\n432: }\n433: \n434: \n435: def main(argv=None):\n436:     args = common.parse_case_args(argv)\n437:     recorder = common.Recorder(args.case)\n438:     handler = _HANDLERS.get(args.case)\n439:     if handler is None:\n440:         recorder.check(\n441:             'dispatch',\n442:             False,\n443:             f'acceptance/p0_recovery.py 不实现用例 {args.case}（应由其他程序派发）',\n444:         )\n445:     else:\n446:         try:\n447:             handler(args, recorder)\n448:         except common.AcceptanceError as exc:\n449:             recorder.check('infrastructure', False, f'验收基础设施错误：{exc}')\n450:         except Exception as exc:\n451:             recorder.check('unexpected-error', False, f'未预期错误：{type(exc).__name__}: {exc}')\n452:     return recorder.finish(args.case)\n453: \n454: \n455: if __name__ == '__main__':\n456:     sys.exit(main())","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file source/baseline/acceptance/p0_recovery.py, lines 1-456\n1: #!/usr/bin/env python3\n2: '''P0 行为验收组：删除恢复与错误合同。\n3: \n4: 覆盖 A09、A10。仅使用 Python 3.12 标准库并复用 acceptance/common.py：\n5: 以 --case 派发，未知用例显式失败；每个用例对真实目标执行正向与硬负向\n6: 行为断言，向 stdout 输出单个 atlas.acceptance-result.v1 JSON，失败时以\n7: 非零码退出。\n8: '''\n9: \n10: from __future__ import annotations\n11: \n12: import os\n13: import sys\n14: import uuid\n15: from urllib.parse import quote\n16: \n17: _THIS_DIR = os.path.dirname(os.path.abspath(__file__))\n18: if _THIS_DIR not in sys.path:\n19:     sys.path.insert(0, _THIS_DIR)\n20: \n21: import common\n22: \n23: _SUCCESS_STATUSES = (200, 204)\n24: \n25: \n26: def _unique_url(tag):\n27:     token = f'{tag}-{uuid.uuid4().hex[:12]}'\n28:     return f'https://{token}.atlas-acceptance.example/{token}'\n29: \n30: \n31: def _unique_category(tag):\n32:     return f'atlas-{tag}-{uuid.uuid4().hex[:10]}'\n33: \n34: \n35: def _safe_json(response):\n36:     try:\n37:         return response.json()\n38:     except Exception:\n39:         return None\n40: \n41: \n42: def _extract_record(payload):\n43:     if isinstance(payload, dict):\n44:         for key in ('bookmark', 'record', 'data', 'item'):\n45:             value = payload.get(key)\n46:             if isinstance(value, dict):\n47:                 return value\n48:         return payload\n49:     return None\n50: \n51: \n52: def _record_id(record):\n53:     if isinstance(record, dict) and record.get('id') is not None:\n54:         return str(record['id'])\n55:     return None\n56: \n57: \n58: def _record_url(record):\n59:     if isinstance(record, dict) and record.get('url') is not None:\n60:         return str(record['url'])\n61:     return None\n62: \n63: \n64: def _record_title(record):\n65:     if isinstance(record, dict) and record.get('title') is not None:\n66:         return str(record['title'])\n67:     return None\n68: \n69: \n70: def _record_description(record):\n71:     if isinstance(record, dict):\n72:         for key in ('description', 'desc'):\n73:             if record.get(key) is not None:\n74:                 return str(record[key])\n75:     return None\n76: \n77: \n78: def _record_category_name(record):\n79:     if isinstance(record, dict):\n80:         for key in ('category', 'category_name'):\n81:             value = record.get(key)\n82:             if isinstance(value, str) and value:\n83:                 return value\n84:             if isinstance(value, dict) and value.get('name'):\n85:                 return str(value['name'])\n86:     return None\n87: \n88: \n89: def _error_code(response):\n90:     payload = _safe_json(response)\n91:     if isinstance(payload, dict):\n92:         error = payload.get('error')\n93:         if isinstance(error, dict) and error.get('code') is not None:\n94:             return str(error['code'])\n95:         for key in ('code', 'error_code'):\n96:             if payload.get(key) is not None:\n97:                 return str(payload[key])\n98:     return None\n99: \n100: \n101: def _extract_list(payload, keys):\n102:     if isinstance(payload, list):\n103:         return payload\n104:     if isinstance(payload, dict):\n105:         for key in keys:\n106:             value = payload.get(key)\n107:             if isinstance(value, list):\n108:                 return value\n109:     return None\n110: \n111: \n112: def _bookmark_path(bookmark_id):\n113:     return '/api/bookmarks/' + quote(str(bookmark_id), safe='')\n114: \n115: \n116: def _restore_path(bookmark_id):\n117:     return _bookmark_path(bookmark_id) + '/restore'\n118: \n119: \n120: def _move_path(bookmark_id):\n121:     return _bookmark_path(bookmark_id) + '/move'\n122: \n123: \n124: def _record_ids(records):\n125:     return {item_id for item_id in (_record_id(record) for record in records) if item_id}\n126: \n127: \n128: def _fetch_bookmarks(client, recorder, aid, params=None):\n129:     response = client.get('/api/bookmarks', params=params)\n130:     recorder.expect_status(response, 200, aid=f'{aid}-list-status')\n131:     payload = _safe_json(response)\n132:     records = _extract_list(payload, ('bookmarks', 'items', 'data', 'records'))\n133:     recorder.check(\n134:         f'{aid}-list-shape',\n135:         isinstance(records, list),\n136:         f'GET /api/bookmarks 必须返回 JSON 数组，实际 {type(payload).__name__}',\n137:     )\n138:     return records if isinstance(records, list) else []\n139: \n140: \n141: def _check_error(recorder, response, prefix, expected_status, expected_code, label):\n142:     recorder.check(\n143:         f'{prefix}-no-5xx',\n144:         response.status < 500,\n145:         f'{label} -> HTTP {response.status}（校验类错误不得产生 5xx）',\n146:     )\n147:     recorder.expect_status(\n148:         response,\n149:         expected_status,\n150:         aid=f'{prefix}-status',\n151:         detail=f'{label} -> HTTP {response.status}（期望 {expected_status}）',\n152:     )\n153:     code = _error_code(response)\n154:     recorder.check(\n155:         f'{prefix}-code',\n156:         code == expected_code,\n157:         f'{label} 错误码={code!r}（期望 {expected_code}）',\n158:     )\n159: \n160: \n161: def _create_record(client, recorder, aid, title=None, description=None):\n162:     url = _unique_url(aid)\n163:     payload = {'url': url}\n164:     if title is not None:\n165:         payload['title'] = title\n166:     if description is not None:\n167:         payload['description'] = description\n168:     response = client.post_json('/api/bookmarks', payload)\n169:     recorder.expect_status(response, 201, aid=f'{aid}-save-status')\n170:     record_id = _record_id(_extract_record(_safe_json(response)))\n171:     recorder.check(f'{aid}-save-id', bool(record_id), f'保存 {url} 返回 id={record_id!r}')\n172:     return record_id\n173: \n174: \n175: def _a09_on_base_url(args, recorder):\n176:     client = common.HttpClient(args.base_url)\n177:     try:\n178:         health = client.get('/api/health')\n179:         recorder.expect_status(health, 200, aid='a09-live-health-status')\n180: \n181:         category_name = _unique_category('a09live')\n182:         url = _unique_url('a09live')\n183:         title = f'A09 删除恢复 {uuid.uuid4().hex[:8]}'\n184:         description = f'A09 描述 {uuid.uuid4().hex[:8]}'\n185:         created = client.post_json(\n186:             '/api/bookmarks',\n187:             {'url': url, 'title': title, 'description': description, 'category': category_name},\n188:         )\n189:         recorder.expect_status(created, 201, aid='a09-live-create-status')\n190:         record_id = _record_id(_extract_record(_safe_json(created)))\n191:         recorder.check('a09-live-create-id', bool(record_id), f'创建记录返回 id={record_id!r}')\n192:         if not record_id:\n193:             return\n194: \n195:         before = _fetch_bookmarks(client, recorder, 'a09-live-before', params={'category': category_name})\n196:         recorder.check(\n197:             'a09-live-visible-before',\n198:             record_id in _record_ids(before),\n199:             f'删除前记录 {record_id!r} 出现在归类 {category_name!r} 中',\n200:         )\n201: \n202:         deleted = client.request('DELETE', _bookmark_path(record_id))\n203:         recorder.expect_status(deleted, _SUCCESS_STATUSES, aid='a09-live-delete-status')\n204: \n205:         after_delete = _fetch_bookmarks(\n206:             client, recorder, 'a09-live-after-delete', params={'category': category_name}\n207:         )\n208:         recorder.check(\n209:             'a09-live-excluded-after-delete',\n210:             record_id not in _record_ids(after_delete),\n211:             f'删除后默认列表排除记录 {record_id!r}：{sorted(_record_ids(after_delete))}',\n212:         )\n213: \n214:         trashed = _fetch_bookmarks(\n215:             client, recorder, 'a09-live-trashed',\n216:             params={'category': category_name, 'include_trashed': 1},\n217:         )\n218:         recorder.check(\n219:             'a09-live-soft-deleted',\n220:             record_id in _record_ids(trashed),\n221:             f'删除为软删除：include_trashed=1 仍可见记录 {record_id!r}',\n222:         )\n223: \n224:         restored = client.post_json(_restore_path(record_id), {})\n225:         recorder.expect_status(restored, _SUCCESS_STATUSES, aid='a09-live-restore-status')\n226: \n227:         after_restore = _fetch_bookmarks(\n228:             client, recorder, 'a09-live-after-restore', params={'category': category_name}\n229:         )\n230:         recorder.check(\n231:             'a09-live-visible-after-restore',\n232:             record_id in _record_ids(after_restore),\n233:             f'撤销恢复后默认列表重新可见记录 {record_id!r}',\n234:         )\n235: \n236:         fetched = client.get(_bookmark_path(record_id))\n237:         recorder.expect_status(fetched, 200, aid='a09-live-after-fetch-status')\n238:         restored_record = _extract_record(_safe_json(fetched))\n239:         recorder.check(\n240:             'a09-live-restored-url',\n241:             _record_url(restored_record) == url,\n242:             f'恢复后 url={_record_url(restored_record)!r}（期望 {url!r}）',\n243:         )\n244:         recorder.check(\n245:             'a09-live-restored-title',\n246:             _record_title(restored_record) == title,\n247:             f'恢复后 title={_record_title(restored_record)!r}（期望 {title!r}）',\n248:         )\n249:         recorder.check(\n250:             'a09-live-restored-description',\n251:             _record_description(restored_record) == description,\n252:             f'恢复后 description={_record_description(restored_record)!r}（期望 {description!r}）',\n253:         )\n254:         recorder.check(\n255:             'a09-live-restored-category',\n256:             _record_category_name(restored_record) == category_name,\n257:             f'恢复后 category={_record_category_name(restored_record)!r}（期望 {category_name!r}）',\n258:         )\n259:     finally:\n260:         client.close()\n261: \n262: \n263: def _a09_across_restart(args, recorder):\n264:     first = common.launch_app(args.app_root, args.data_dir, 0)\n265:     instance_dir = first.instance_dir\n266:     anchor_id = None\n267:     deleted_id = None\n268:     try:\n269:         client = common.HttpClient(first.base_url)\n270:         try:\n271:             health = client.get('/api/health')\n272:             recorder.expect_status(health, 200, aid='a09-restart-health-status')\n273: \n274:             anchor_id = _create_record(client, recorder, 'a09-restart-anchor', title='A09 重启锚点')\n275:             deleted_id = _create_record(client, recorder, 'a09-restart-deleted', title='A09 重启删除')\n276:             if deleted_id:\n277:                 deleted = client.request('DELETE', _bookmark_path(deleted_id))\n278:                 recorder.expect_status(deleted, _SUCCESS_STATUSES, aid='a09-restart-delete-status')\n279:                 after_delete = _fetch_bookmarks(client, recorder, 'a09-restart-after-delete')\n280:                 recorder.check(\n281:                     'a09-restart-excluded-before-restart',\n282:                     deleted_id not in _record_ids(after_delete),\n283:                     f'终止前已删除记录 {deleted_id!r} 被默认列表排除',\n284:                 )\n285:         finally:\n286:             client.close()\n287:     finally:\n288:         common.stop_app(first)\n289: \n290:     if not (anchor_id and deleted_id):\n291:         recorder.check('a09-restart-persist', False, '隔离实例未返回可用 id，无法验证删除跨重启')\n292:         return\n293: \n294:     second = common.launch_app(args.app_root, args.data_dir, 0, instance_dir=instance_dir)\n295:     try:\n296:         client = common.HttpClient(second.base_url)\n297:         try:\n298:             after = _fetch_bookmarks(client, recorder, 'a09-restart-after')\n299:             ids = _record_ids(after)\n300:             recorder.check(\n301:                 'a09-restart-anchor-persists',\n302:                 anchor_id in ids,\n303:                 f'重启后未删除记录 {anchor_id!r} 仍在默认列表（证明数据已持久化）',\n304:             )\n305:             recorder.check(\n306:                 'a09-restart-deletion-persists',\n307:                 deleted_id not in ids,\n308:                 f'重启后已删除记录 {deleted_id!r} 仍被默认列表排除',\n309:             )\n310:             trashed = _fetch_bookmarks(\n311:                 client, recorder, 'a09-restart-trashed', params={'include_trashed': 1}\n312:             )\n313:             recorder.check(\n314:                 'a09-restart-trash-retained',\n315:                 deleted_id in _record_ids(trashed),\n316:                 f'重启后已删除记录 {deleted_id!r} 仍以软删除状态存在，而非数据丢失',\n317:             )\n318:         finally:\n319:             client.close()\n320:     finally:\n321:         common.stop_app(second)\n322: \n323: \n324: def _case_a09(args, recorder):\n325:     _a09_on_base_url(args, recorder)\n326:     _a09_across_restart(args, recorder)\n327: \n328: \n329: def _case_a10(args, recorder):\n330:     client = common.HttpClient(args.base_url)\n331:     try:\n332:         health = client.get('/api/health')\n333:         recorder.expect_status(health, 200, aid='a10-health-status')\n334: \n335:         anchor_url = _unique_url('a10-anchor')\n336:         anchor_title = f'A10 锚点 {uuid.uuid4().hex[:8]}'\n337:         anchor_description = f'A10 描述 {uuid.uuid4().hex[:8]}'\n338:         created = client.post_json(\n339:             '/api/bookmarks',\n340:             {'url': anchor_url, 'title': anchor_title, 'description': anchor_description},\n341:         )\n342:         recorder.expect_status(created, 201, aid='a10-anchor-create-status')\n343:         anchor_id = _record_id(_extract_record(_safe_json(created)))\n344:         recorder.check('a10-anchor-create-id', bool(anchor_id), f'创建锚点记录返回 id={anchor_id!r}')\n345:         if not anchor_id:\n346:             return\n347: \n348:         before_list = _fetch_bookmarks(client, recorder, 'a10-before-list')\n349:         before_ids = _record_ids(before_list)\n350: \n351:         before_fetch = client.get(_bookmark_path(anchor_id))\n352:         recorder.expect_status(before_fetch, 200, aid='a10-anchor-before-status')\n353:         before_record = _extract_record(_safe_json(before_fetch))\n354: \n355:         unknown = f'unknown-{uuid.uuid4().hex[:12]}'\n356: \n357:         unknown_get = client.get(_bookmark_path(unknown))\n358:         _check_error(\n359:             recorder, unknown_get, 'a10-unknown-get', 404, 'not_found',\n360:             f'GET /api/bookmarks/{unknown}',\n361:         )\n362: \n363:         unknown_patch = client.patch_json(_bookmark_path(unknown), {'title': 'A10 未知 id'})\n364:         _check_error(\n365:             recorder, unknown_patch, 'a10-unknown-patch', 404, 'not_found',\n366:             f'PATCH /api/bookmarks/{unknown}',\n367:         )\n368: \n369:         unknown_delete = client.request('DELETE', _bookmark_path(unknown))\n370:         _check_error(\n371:             recorder, unknown_delete, 'a10-unknown-delete', 404, 'not_found',\n372:             f'DELETE /api/bookmarks/{unknown}',\n373:         )\n374: \n375:         unknown_move = client.post_json(_move_path(unknown), {'category': common.DEFAULT_CATEGORY})\n376:         _check_error(\n377:             recorder, unknown_move, 'a10-unknown-move', 404, 'not_found',\n378:             f'POST /api/bookmarks/{unknown}/move',\n379:         )\n380: \n381:         malformed = (\n382:             ('save', 'POST', '/api/bookmarks', '{\"url\": '),\n383:             ('patch', 'PATCH', _bookmark_path(anchor_id), '{\"title\": '),\n384:             ('move', 'POST', _move_path(anchor_id), '{\"category\": '),\n385:         )\n386:         for label, method, path, body in malformed:\n387:             response = client.request(\n388:                 method, path, data=body, headers={'Content-Type': 'application/json'}\n389:             )\n390:             _check_error(\n391:                 recorder, response, f'a10-malformed-{label}', 400, 'bad_request',\n392:                 f'{method} {path} 畸形 JSON',\n393:             )\n394: \n395:         after_list = _fetch_bookmarks(client, recorder, 'a10-after-list')\n396:         recorder.check(\n397:             'a10-records-unchanged',\n398:             _record_ids(after_list) == before_ids,\n399:             f'错误请求未改变记录集合：{len(before_ids)} -> {len(_record_ids(after_list))}',\n400:         )\n401: \n402:         after_fetch = client.get(_bookmark_path(anchor_id))\n403:         recorder.expect_status(after_fetch, 200, aid='a10-anchor-after-status')\n404:         after_record = _extract_record(_safe_json(after_fetch))\n405:         recorder.check(\n406:             'a10-anchor-url-unchanged',\n407:             _record_url(after_record) == _record_url(before_record),\n408:             f'锚点 url={_record_url(after_record)!r}（未被修改）',\n409:         )\n410:         recorder.check(\n411:             'a10-anchor-title-unchanged',\n412:             _record_title(after_record) == _record_title(before_record),\n413:             f'锚点 title={_record_title(after_record)!r}（未被修改）',\n414:         )\n415:         recorder.check(\n416:             'a10-anchor-description-unchanged',\n417:             _record_description(after_record) == _record_description(before_record),\n418:             f'锚点 description={_record_description(after_record)!r}（未被修改）',\n419:         )\n420:         recorder.check(\n421:             'a10-anchor-category-unchanged',\n422:             _record_category_name(after_record) == _record_category_name(before_record),\n423:             f'锚点 category={_record_category_name(after_record)!r}（未被修改）',\n424:         )\n425:     finally:\n426:         client.close()\n427: \n428: \n429: _HANDLERS = {\n430:     'A09': _case_a09,\n431:     'A10': _case_a10,\n432: }\n433: \n434: \n435: def main(argv=None):\n436:     args = common.parse_case_args(argv)\n437:     recorder = common.Recorder(args.case)\n438:     handler = _HANDLERS.get(args.case)\n439:     if handler is None:\n440:         recorder.check(\n441:             'dispatch',\n442:             False,\n443:             f'acceptance/p0_recovery.py 不实现用例 {args.case}（应由其他程序派发）',\n444:         )\n445:     else:\n446:         try:\n447:             handler(args, recorder)\n448:         except common.AcceptanceError as exc:\n449:             recorder.check('infrastructure', False, f'验收基础设施错误：{exc}')\n450:         except Exception as exc:\n451:             recorder.check('unexpected-error', False, f'未预期错误：{type(exc).__name__}: {exc}')\n452:     return recorder.finish(args.case)\n453: \n454: \n455: if __name__ == '__main__':\n456:     sys.exit(main())"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"source/baseline/acceptance/p0_recovery.py\",\"limit\":2000}"},"time":{"start":1792484178876,"end":1792484178886}}}}
