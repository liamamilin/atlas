features\",\n170:     \"F12\",\n171:     \"sources\"\n172:    ],\n173:    [\n174:     \"features\",\n175:     \"F13\",\n176:     \"reason\"\n177:    ],\n178:    [\n179:     \"features\",\n180:     \"F14\",\n181:     \"reason\"\n182:    ],\n183:    [\n184:     \"features\",\n185:     \"F17\",\n186:     \"reason\"\n187:    ],\n188:    [\n189:     \"features\",\n190:     \"F24\",\n191:     \"reason\"\n192:    ],\n193:    [\n194:     \"features\",\n195:     \"F24\",\n196:     \"sources\"\n197:    ]\n198:   ],\n199:   \"authorized_assertion_changes\": [\n200:    {\n201:     \"acceptance_id\": \"A02\",\n202:     \"change\": \"single_label_hostname_negative_to_positive\",\n203:     \"rationale\": \"The explicit target policy accepts any absolute parseable HTTP(S) URL with a valid nonempty hostname, without requiring DNS or a dot. This is the sole authorized semantic replacement of an existing assertion; malformed scheme, non-HTTP(S), empty/invalid hostname and no-write-on-failure negatives remain.\"\n204:    }\n205:   ],\n206:   \"baseline\": {\n207:    \"artifact_id\": \"tpl_7f4c17e834c342e7b462e6bb8b6379e4\",\n208:    \"case_basis_digest\": \"a22ff1c065d27aecb0cee21dc6b597f5607375bc8ebc297a3451e708f4da5589\",\n209:    \"expected_digest\": \"8d9229d3895be0cd1672ad28a2926549a2e5e6920b186ceeaef09c38c37803d9\",\n210:    \"immutable_case_facts\": 29\n211:   },\n212:   \"edit_paths\": [\n213:    \"acceptance/README.md\",\n214:    \"acceptance/p0_find_open.py\",\n215:    \"acceptance/p0_library.py\",\n216:    \"acceptance/p0_organize.py\",\n217:    \"acceptance/p0_recovery.py\",\n218:    \"acceptance/runner.json\"\n219:   ],\n220:   \"known_blockers\": [\n221:    {\n222:     \"acceptance_id\": \"A04\",\n223:     \"basis\": \"Category management needs actual HTML create/rename/delete journeys, protection, validation and reassignment of active and soft-deleted records.\",\n224:     \"decision_id\": \"D03\",\n225:     \"feature_id\": \"F03\"\n226:    },\n227:    {\n228:     \"acceptance_id\": \"A05\",\n229:     \"basis\": \"The existing move capability needs browser form coverage and visible result/feedback while preserving persistence checks.\",\n230:     \"decision_id\": \"D03\",\n231:     \"feature_id\": \"F04\"\n232:    },\n233:    {\n234:     \"acceptance_id\": \"A06\",\n235:     \"basis\": \"P0 category browsing requires visible counts that include active records only and agree with API/list results after state changes.\",\n236:     \"decision_id\": \"D07\",\n237:     \"feature_id\": \"F05\"\n238:    },\n239:    {\n240:     \"acceptance_id\": \"A07\",\n241:     \"basis\": \"Category-scoped search must submit category and q together and show selected category, retained query, and matching/empty results.\",\n242:     \"decision_id\": \"D07\",\n243:     \"feature_id\": \"F06\"\n244:    },\n245:    {\n246:     \"acceptance_id\": \"A01\",\n247:     \"basis\": \"The source IndexedDB/Dexie implementation is not the target Python/SQLite persistence implementation; correct target rationale while preserving restart assertion.\",\n248:     \"decision_id\": \"D08\",\n249:     \"feature_id\": \"F08\"\n250:    },\n251:    {\n252:     \"acceptance_id\": \"A09\",\n253:     \"basis\": \"HTML soft-delete/restore recovery must be exercised; category deletion also needs trashed records to remain recoverable.\",\n254:     \"decision_id\": \"D04\",\n255:     \"feature_id\": \"F09\"\n256:    },\n257:    {\n258:     \"acceptance_id\": \"A10\",\n259:     \"basis\": \"Malformed requests and form validation need explicit non-mutating feedback/recovery; retain JSON bad_request and existing API behavior.\",\n260:     \"decision_id\": null,\n261:     \"feature_id\": \"F10\"\n262:    },\n263:    {\n264:     \"acceptance_id\": \"A02\",\n265:     \"basis\": \"Correct the URL boundary from dotted-host rejection to absolute parseable HTTP(S) with a valid nonempty hostname.\",\n266:     \"decision_id\": null,\n267:     \"feature_id\": \"F10\"\n268:    },\n269:    {\n270:     \"acceptance_id\": \"A12\",\n271:     \"basis\": \"Invalid category input must retain failure/no-mutation semantics with usable HTML feedback.\",\n272:     \"decision_id\": \"D03\",\n273:     \"feature_id\": \"F10\"\n274:    },\n275:    {\n276:     \"acceptance_id\": \"A11\",\n277:     \"basis\": \"The target shell is Python server-rendered HTML, not the source SPA mount; preserve the empty-library readiness contract.\",\n278:     \"decision_id\": \"D08\",\n279:     \"feature_id\": \"F11\"\n280:    }\n281:   ],\n282:   \"version\": \"atlas.aggregate-repair-scope.v2\"\n283:  },\n284:  \"exact_diff\": {\n285:   \"schema\": \"atlas.aggregate-repair-diff.v1\",\n286:   \"scope_version\": \"atlas.aggregate-repair-scope.v2\",\n287:   \"baseline_artifact_digest\": \"8d9229d3895be0cd1672ad28a2926549a2e5e6920b186ceeaef09c38c37803d9\",\n288:   \"case_design_before\": [\n289:    {\n290:     \"capability\": \"个人收藏库本地持久化：整个收藏集合写入浏览器 IndexedDB 单表，应用每次打开时全量载入，保存或删除立即落盘，关闭再打开后仍在。\",\n291:     \"disposition\": \"adopted\",\n292:     \"evidence_ids\": [\n293:      \"ev_ba200adf6e2c_515aa5d072bd2ec4\",\n294:      \"ev_ba200adf6e2c_35e41aab676021eb\",\n295:      \"ev_ba200adf6e2c_86ed2327f33a3ca8\",\n296:      \"ev_ba200adf6e2c_6805376f7e2ee383\"\n297:     ],\n298:     \"reason\": \"场景验收第1条要求“主动保存的链接在多次会话之间持久保留，形成不断增长的个人收藏”，上游 Dexie 单表 + 内存映射 + put/delete 落盘已直接满足，README 也定位为 local-first。差异仅在于记录结构增加归类字段，持久化机制原样沿用。\"\n299:    },\n300:    {\n301:     \"capability\": \"记录以外部网页 URL 锚定：每条收藏持有 id、url、hostname（及可选标题/图标），点击记录在新标签打开原始网页。\",\n302:     \"disposition\": \"adopted\",\n303:     \"evidence_ids\": [\n304:      \"ev_ba200adf6e2c_9c7f6060878383fa\",\n305:      \"ev_ba200adf6e2c_93ff254508846f11\",\n306:      \"ev_ba200adf6e2c_5011700a24e503c7\"\n307:     ],\n308:     \"reason\": \"场景验收第2条与流程第5步要求“打开记录即跳转到该页面，回到原始网页继续购买、阅读或参考”。上游 Visit 正是保存后以 window.open(noopener,noreferrer) 打开，hostname 由 URL 派生。差异是场景不需要访问计数与 visitedAt，只保留打开动作与域名派生。\"\n309:    },\n310:    {\n311:     \"capability\": \"新增/编辑收藏的表单：填写 URL 与标题，URL 必须为合法 http/https 且含点域名，编辑时回填原字段并保留 id 与创建时间。\",\n312:     \"disposition\": \"adopted\",\n313:     \"evidence_ids\": [\n314:      \"ev_ba200adf6e2c_05babdea64ba9858\",\n315:      \"ev_ba200adf6e2c_06c81a165e03c96a\",\n316:      \"ev_ba200adf6e2c_1596da4a90687ca5\"\n317:     ],\n318:     \"reason\": \"场景流程第1-2步是“浏览中看到想记住的页面便主动保存”，需要可信录入与校验。上游 Valibot 表单校验、编辑回填并保留 id/createdAt 的行为可复用；差异是把“1-5 个标签必填”改为“选择或新建一个归类”，描述字段按场景需要保留为可选。\"\n319:    },\n320:    {\n321:     \"capability\": \"用单一“归类”字段取代多标签：每条记录只归属一个归类，侧栏按归类聚合条目数并支持按归类筛选浏览。\",\n322:     \"disposition\": \"adjusted\",\n323:     \"evidence_ids\": [\n324:      \"ev_ba200adf6e2c_9c7f6060878383fa\",\n325:      \"ev_ba200adf6e2c_9ab6b0e51811a16d\",\n326:      \"ev_ba200adf6e2c_c4ad7e52e5713628\"\n327:     ],\n328:     \"reason\": \"场景明确“保存时选择一个简单归类”，是单归属分类而非多标签。上游是扁平 tags[] + 标签侧栏 + 计数 + 多标签交集筛选，需要把多值匹配改造为单选归属；计数与侧栏交互逻辑沿用，语义由“标签出现次数”变为“每归类条目数”。\"\n329:    },\n330:    {\n331:     \"capability\": \"默认归类：未选择归类即保存的链接自动落入“未整理”默认归类，之后可被手动移动。\",\n332:     \"disposition\": \"new_design\",\n333:     \"evidence_ids\": [],\n334:     \"reason\": \"场景流程第3步“未经整理的链接可先进入默认归类，之后再手动移动到更合适的位置”是上游完全没有的概念——上游只有 Home/Archived 两个视图，没有默认桶。快速保存不打断浏览依赖这一设计，属场景新增。\"\n335:    },\n336:    {\n337:     \"capability\": \"归类管理：用户可新建归类（如“待购”“家居改造”“以后看看”），并把记录从一个归类移动到另一个归类，移动结果持久化。\",\n338:     \"disposition\": \"new_design\",\n339:     \"evidence_ids\": [],\n340:     \"reason\": \"场景验收第3条要求“在归类之间移动记录或新建归类，操作结果在重新打开后仍然有效”。上游明确没有 collections/folders，也不持久化任何视图状态，因此新建归类与移动归类必须新设计并落库。\"\n341:    },\n342:    {\n343:     \"capability\": \"归类浏览与关键字检索：先按归类列出，再在结果内用关键字匹配标题与域名（必要时含描述），默认按最近保存倒序。\",\n344:     \"disposition\": \"adjusted\",\n345:     \"evidence_ids\": [\n346:      \"ev_ba200adf6e2c_9ab6b0e51811a16d\",\n347:      \"ev_ba200adf6e2c_c4ad7e52e5713628\"\n348:     ],\n349:     \"reason\": \"场景验收第4条要求“通过归类浏览或关键字检索找到此前存入的特定链接”。上游检索只匹配 title.toLowerCase() 且带 pinned-first 排序，多值标签筛选也需并入归类。差异是扩大匹配字段到 hostname/描述，以覆盖“只记得是哪个网站”的找回场景。\"\n350:    },\n351:    {\n352:     \"capability\": \"首次使用的起始归类集合：预置“待购”“家居改造”“以后看看”与默认“未整理”，用户可在此基础上增删。\",\n353:     \"disposition\": \"adjusted\",\n354:     \"evidence_ids\": [\n355:      \"ev_ba200adf6e2c_05babdea64ba9858\"\n356:     ],\n357:     \"reason\": \"场景把这三类作为保存时的直接选项，属场景语境的默认数据。上游新建记录只写入 id/hostname/时间等默认字段，没有任何预置分类。这里借用其“新记录写入默认字段”的初始化思路，把预置归类作为应用初始数据而非记录字段。\"\n358:    },\n359:    {\n360:     \"capability\": \"删除收藏并支持短时撤销：删除任意记录并弹出带“撤销”的操作提示，点击撤销即恢复。\",\n361:     \"disposition\": \"adjusted\",\n362:     \"evidence_ids\": [\n363:      \"ev_ba200adf6e2c_4c56ef30a1785be1\"\n364:     ],\n365:     \"reason\": \"上游删除仅对归档项开放且配 5 秒 Undo 恢复。场景没有归档，用户会想直接清理误存链接。保留“删除 + 撤销恢复”的错误兜底机制，去掉“仅归档可删”的前置限制。\"\n366:    },\n367:    {\n368:     \"capability\": \"不做置顶/归档：不引入 isPinned/isArchived，也不让编辑、删除出现“仅归档项可用”的分支。\",\n369:     \"disposition\": \"not_adopted\",\n370:     \"evidence_ids\": [\n371:      \"ev_ba200adf6e2c_b1ca64cf2ad02998\",\n372:      \"ev_ba200adf6e2c_06c81a165e03c96a\"\n373:     ],\n374:     \"reason\": \"场景是“先留存、稍后再处理”的收藏箱，没有归档-清空的工作流，置顶也不解决“待购/灵感”的浏览诉求；保留归档反而给编辑与删除加额外前置条件，与快速保存、快速清理相冲突。\"\n375:    },\n376:    {\n377:     \"capability\": \"图标与元数据的轻量获取：保存时优先由域名派生 favicon 本地显示，第三方元数据（标题/描述/封面）仅作可选增强，失败静默降级。\",\n378:     \"disposition\": \"adjusted\",\n379:     \"evidence_ids\": [\n380:      \"ev_ba200adf6e2c_8e11efc61a4650ba\",\n381:      \"ev_ba200adf6e2c_ec303a2fd1afa287\",\n382:      \"ev_ba200adf6e2c_5011700a24e503c7\"\n383:     ],\n384:     \"reason\": \"场景希望能一眼辨认“商品页/教程/灵感图”，但上游依赖 api.microlink.io、images.weserv.nl、Google s2 三个未经运行验证的第三方端点，失败只 console.error。差异是把可用性依赖降为本地域名派生，把外部抓取降级为增强，避免保存流程被第三方可达性阻塞。\"\n385:    },\n386:    {\n387:     \"capability\": \"不做多排序模式与置顶优先：只保留“最近保存”倒序一种默认顺序。\",\n388:     \"disposition\": \"not_adopted\",\n389:     \"evidence_ids\": [\n390:      \"ev_ba200adf6e2c_9ab6b0e51811a16d\"\n391:     ],\n392:     \"reason\": \"场景关注“找到此前存下的东西”，不涉及按访问次数排序或置顶。上游三种排序（最近添加/最近访问/访问最多）+ pinned-first 属书签阅读器语境，对收藏箱是冗余操作面。\"\n393:    },\n394:    {\n395:     \"capability\": \"不做“复制 URL”动作：收藏箱的目标是回到原页而非分发链接。\",\n396:     \"disposition\": \"not_adopted\",\n397:     \"evidence_ids\": [\n398:      \"ev_ba200adf6e2c_7150b0ac7a5678db\"\n399:     ],\n400:     \"reason\": \"上游 Copy URL 面向分享或复用链接；本场景流程终点是“从记录打开链接，回到原始网页继续购买、阅读或参考”，复制并非必需，去掉可减少每条记录的操作噪音。\"\n401:    },\n402:    {\n403:     \"capability\": \"单页应用外壳：index.html 提供 #root，入口模块挂载应用并在根节点缺失时报错。\",\n404:     \"disposition\": \"adopted\",\n405:     \"evidence_ids\": [\n406:      \"ev_ba200adf6e2c_5d51c18a989c01f8\",\n407:      \"ev_ba200adf6e2c_a2ebc864c5b6b3e7\"\n408:     ],\n409:     \"reason\": \"场景是纯个人本地工具、无服务端需求，上游 SPA 挂载方式与本地优先定位一致，可直接沿用为运行外壳。差异仅在挂载的组件内部替换为收藏箱视图，属于结构性沿用。\"\n410:    },\n411:    {\n412:     \"capability\": \"浏览视图状态（当前选中归类、搜索词）仅保留在会话内存中，不写入本地库。\",\n413:     \"disposition\": \"adopted\",\n414:     \"evidence_ids\": [\n415:      \"ev_ba200adf6e2c_2288b28e90cd8450\"\n416:     ],\n417:     \"reason\": \"场景只要求“归类归属与移动结果在重开后仍然有效”，并未要求记住上次浏览位置。上游把 tab/标签筛选/排序/搜索放在组件本地状态而不落库，恰好划出“数据持久、视图不持久”的边界，避免浏览状态污染收藏数据。\"\n418:    }\n419:   ],\n420:   \"case_design_after\": [\n421:    {\n422:     \"capability\": \"F08: a single-user personal library persisted in SQLite that survives browser sessions and server restarts, with records queried from the database for every request rather than held in a browser store.\",\n423:     \"disposition\": \"adjusted\",\n424:     \"evidence_ids\": [\n425:      \"ev_ba200adf6e2c_35e41aab676021eb\",\n426:      \"ev_ba200adf6e2c_86ed2327f33a3ca8\",\n427:      \"ev_ba200adf6e2c_922f1dbc84912d99\",\n428:      \"ev_ba200adf6e2c_e7dd8d32c05c39f9\"\n429:     ],\n430:     \"reason\": \"The evidence shows Dexie writes on save/delete and a one-time db.bookmarks.toArray() hydration into an in-memory RippleMap, scoped to one browser profile with no sync. The target adopts local, single-user, cross-session retention but replaces IndexedDB/Dexie and in-memory hydration with SQLite on the Python server; it does not claim browser-profile persistence, multi-device sync, or the source map as target design.\"\n431:    },\n432:    {\n433:     \"capability\": \"F11: the library is delivered as Python server-rendered HTML pages and forms using POST/redirect/GET for saving records, managing categories, moving records between categories, and soft-delete/restore, including a ready empty-library view. P0 has no standalone record-editing page; record URL updates retain only the existing PATCH /api/bookmarks/{id} contract.\",\n434:     \"disposition\": \"adjusted\",\n435:     \"evidence_ids\": [\n436:      \"ev_ba200adf6e2c_06c81a165e03c96a\",\n437:      \"ev_ba200adf6e2c_86ed2327f33a3ca8\",\n438:      \"ev_ba200adf6e2c_e7dd8d32c05c39f9\"\n439:     ],\n440:     \"reason\": \"The evidence describes a client-mounted SPA: Edit is an in-page dialog populated from item fields, and component creation loads Dexie rows into a client RippleMap. The target implements the already-declared P0 save, category-management, move and soft-delete/restore journeys as Python 3.12 HTML responses. Source SPA mounting, client-side dialog state and Dexie hydration are not carried over. The source Edit dialog does not imply a target record-editing UI; the existing PATCH API retains URL updates and recomputes hostname when the URL changes. The save-now/find-later loop and ready empty state remain the target intent.\"\n441:    },\n442:    {\n443:     \"capability\": \"A deliberate save creates a URL-anchored record with a stable id, a locally derived hostname, creation time and initial active state. Later changes preserve the record id and creation time; updating the URL recomputes hostname from the new URL. The adopted capability is this identity and creation lifecycle; visitCount and visitedAt are not target fields or P0 obligations.\",\n444:     \"disposition\": \"adopted\",\n445:     \"evidence_ids\": [\n446:      \"ev_ba200adf6e2c_05babdea64ba9858\"\n447:     ],\n448:     \"reason\": \"The accepted observation records the source's bm-prefixed UUID identity, hostname derivation, createdAt, initial flags and visit fields, and preservation of identity and creation/visit fields on edit. These remain source observations. The target adopts stable record identity and creation time, represented by its existing id/created_at model and made durable by SQLite; it does not import the source's visitCount/visitedAt fields, which F24 excludes. URL updates follow the existing PATCH contract and derive hostname again. The source's tag constraints and other state fields are not silently imported into the category or target data model.\"\n449:    },\n450:    {\n451:     \"capability\": \"URL validation accepts only absolute, parseable HTTP(S) URLs with a nonempty valid hostname, allows single-label hosts such as http://localhost, preserves the original URL text, and rejects malformed, non-HTTP(S) or empty-host input without writing; no DNS or online-reachability check is performed.\",\n452:     \"disposition\": \"adjusted\",\n453:     \"evidence_ids\": [\n454:      \"ev_ba200adf6e2c_1596da4a90687ca5\"\n455:     ],\n456:     \"reason\": \"The upstream Valibot rule is a dotted-host regex that requires a dot-separated domain and an alphabetic top-level suffix, so it rejects localhost. That regex is retained as a source fact and mapped as adjusted, not reused as the target rule: the target parses the URL, checks the http/https scheme, absolute form and hostname presence, permits single-label hosts, and stores the entered string unchanged.\"\n457:    },\n458:    {\n459:     \"capability\": \"Create, rename and delete named categories with validation and with protection or reassignment when a category still contains records, assign one at save time, move records between categories, and default uncategorized saves into an Inbox category.\",\n460:     \"disposition\": \"new_design\",\n461:     \"evidence_ids\": [\n462:      \"ev_ba200adf6e2c_3168bcd465b6a043\",\n463:      \"ev_ba200adf6e2c_6bbd7a588896fe31\"\n464:     ],\n465:     \"reason\": \"Evidence shows the source has no category entity: classification is only up to five free-text tags, there is no collection CRUD or separate move, and the form rejects saves with zero tags. The target therefore designs first-class categories, an inbox default for unclassified capture and an explicit move action; these are new target concepts, not source-derived tag behavior.\"\n466:    },\n467:    {\n468:     \"capability\": \"Browse one category and see only its active records, with a category count that agrees with the listed records after adds, moves and restores.\",\n469:     \"disposition\": \"adjusted\",\n470:     \"evidence_ids\": [\n471:      \"ev_ba200adf6e2c_c4ad7e52e5713628\",\n472:      \"ev_ba200adf6e2c_9ab6b0e51811a16d\"\n473:     ],\n474:     \"reason\": \"Source facts derive tag counts by scanning all in-memory bookmarks and filter records by requiring every selected tag. The target computes category counts and category-scoped lists in SQL over active, non-deleted rows so the count and the list stay consistent; the source tag-sidebar algorithm is not the target implementation.\"\n475:    },\n476:    {\n477:     \"capability\": \"Search the selected category by keyword across title, hostname and description using case-insensitive substring matching, retaining category and query and rendering matching or explicit empty results.\",\n478:     \"disposition\": \"adjusted\",\n479:     \"evidence_ids\": [\n480:      \"ev_ba200adf6e2c_9ab6b0e51811a16d\",\n481:      \"ev_ba200adf6e2c_e62ae7e0a2c68ba1\"\n482:     ],\n483:     \"reason\": \"Source search lowercases and compares only bookmark.title; the fixed target F06/A07 contract adjusts it to title, derived hostname and description, combined with the selected category. Raw URL text, category names and tags are not additional keyword fields. This clarifies target design only; accepted observations, evidence IDs, source revision and disposition remain unchanged.\"\n484:    },\n485:    {\n486:     \"capability\": \"Open a saved record as a navigation to its stored original URL, preserving the URL text and never fetching, proxying or prefetching the destination during save, listing or open preparation.\",\n487:     \"disposition\": \"adjusted\",\n488:     \"evidence_ids\": [\n489:      \"ev_ba200adf6e2c_93ff254508846f11\"\n490:     ],\n491:     \"reason\": \"Source opens the URL with window.open(url, '_blank', 'noopener,noreferrer') after updating visit state. The target renders the record URL as an ordinary HTTP(S) link or server redirect with the same new-tab/no-referrer intent; opening is a user navigation distinct from saving, and the Python server does not request the target page.\"\n492:    },\n493:    {\n494:     \"capability\": \"Do not enrich saved records with third-party metadata or favicon services and do not prefetch saved target pages; stored title, description and URL come from the user or local derivation.\",\n495:     \"disposition\": \"not_adopted\",\n496:     \"evidence_ids\": [\n497:      \"ev_ba200adf6e2c_7d47d725a2e9b759\",\n498:      \"ev_ba200adf6e2c_8e11efc61a4650ba\",\n499:      \"ev_ba200adf6e2c_ec303a2fd1afa287\"\n500:     ],\n501:     \"reason\": \"The source calls api.microlink.io and images.weserv.nl/Google s2 favicons on save and treats failures as silent. The target P0 deliberately omits these outbound calls because saving and opening must remain distinct from fetching; no target-page response, metadata or icon is retrieved, and no source enrichment behavior is presented as target design.\"\n502:    },\n503:    {\n504:     \"capability\": \"Soft-delete an active record into a recoverable trash and restore it later, instead of allowing deletion only on archived items with a transient toast undo.\",\n505:     \"disposition\": \"adjusted\",\n506:     \"evidence_ids\": [\n507:      \"ev_ba200adf6e2c_4c56ef30a1785be1\",\n508:      \"ev_ba200adf6e2c_93ef917a193a45ab\"\n509:     ],\n510:     \"reason\": \"Source facts limit Delete to archived items and provide recovery only through an Undo action on the toast, with no trash view and no deletion path for active records. The target uses an explicit soft-delete/restore lifecycle exposed in HTML so records remain recoverable; this changes the source's archived-only and transient-recovery model.\"\n511:    }\n512:   ],\n513:   \"case_adaptation_revision\": \"case-adaptation-prepared-0b627399d035068e\",\n514:   \"case_adaptation_input\": {\n515:    \"case_basis_digest\": \"a22ff1c065d27aecb0cee21dc6b597f5607375bc8ebc297a3451e708f4da5589\",\n516:    \"mode\": \"host-exact-r7-target-adaptation\",\n517:    \"prior_checkpoint_digest\": \"b49f90a92a4830354af2946a83ab56dcc4f5539f5c085a3c862902f067d253c2\",\n518:    \"scenario\": {\n519:     \"acceptance\": [\n520:      \"用户主动保存的链接在多次会话之间持久保留，形成不断增长的个人收藏\",\n521:      \"每条记录都以 URL 锚定到外部网页，打开记录即跳转到该页面\",\n522:      \"用户可以在归类之间移动记录或新建归类，操作结果在重新打开后仍然有效\",\n523:      \"通过归类浏览或关键字检索，用户能找到此前存入的特定链接\"\n524:     ],\n525:     \"audience\": \"习惯先把感兴趣的网页存起来、之后再回头处理的普通网络用户\",\n526:     \"id\": \"scn_7756e0007f6a463a97316f3f49c15248\",\n527:     \"leaf\": \"bookmark-manager\",\n528:     \"leaf_name\": \"书签管理器\",\n529:     \"name\": \"生活待购与灵感收藏夹\",\n530:     \"objective\": \"把偶然看到但当下不处理的外部网页链接留存，日后需要时能重新找到并回到原页面\",\n531:     \"revision\": 2,\n532:     \"status\": \"ready\",\n533:     \"updated_at\": \"2026-10-16T14:18:20.407897+00:00\",\n534:     \"workflow\": [\n535:      \"用户在浏览时看到想记住的商品页、教程或灵感图片，主动保存该链接\",\n536:      \"保存时选择一个简单归类，如“待购”“家居改造”或“以后看看”\",\n537:      \"未经整理的链接可先进入默认归类，之后再手动移动到更合适的位置\",\n538:      \"用户在需要实际处理时打开个人库，浏览或检索相关归类\",\n539:      \"用户从记录打开链接，回到原始网页继续购买、阅读或参考\"\n540:     ]\n541:    },\n542:    \"scenario_policy\": {\n543:     \"schema\": \"atlas.scenario-policy.bookmarks.v1\",\n544:     \"revision\": \"CP-1\",\n545:     \"scenario_id\": \"scn_7756e0007f6a463a97316f3f49c15248\",\n546:     \"product_id\": \"product-c42848f63251507bd9d911a5\",\n547:     \"category_contract\": {\n548:      \"management\": {\n549:       \"acceptance_id\": \"A04\",\n550:       \"operations\": [\n551:        \"category_create\",\n552:        \"category_rename\"\n553:       ],\n554:       \"input_field\": \"name\",\n555:       \"existing_category_identity_field\": \"category_id\",\n556:       \"html_invalid_values\": [\n557:        \"omitted\",\n558:        \"empty\",\n559:        \"whitespace_only\",\n560:        \"121_characters\"\n561:       ],\n562:       \"json_invalid_values\": [\n563:        \"omitted\",\n564:        \"empty\",\n565:        \"whitespace_only\",\n566:        \"121_characters\",\n567:        \"null\"\n568:       ],\n569:       \"invalid_result\": {\n570:        \"status\": 400,\n571:        \"code\": \"invalid_name\"\n572:       },\n573:       \"html_failure\": \"Show form-error, retain submitted values, and make no writes.\",\n574:       \"json_failure\": \"Return invalid_name and make no writes.\"\n575:      },\n576:      \"bookmark_save\": {\n577:       \"acceptance_id\": \"A12\",\n578:       \"json_field\": \"category\",\n579:       \"html_field\": \"category\",\n580:       \"field_semantics\": \"Category NAME, never category ID.\",\n581:       \"omitted_or_null_json\": \"Use the default category.\",\n582:       \"html_null\": \"HTML forms have no native null value.\",\n583:       \"invalid_values\": [\n584:        \"empty\",\n585:        \"whitespace_only\",\n586:        \"121_characters\"\n587:       ],\n588:       \"invalid_result\": {\n589:        \"status\": 400,\n590:        \"code\": \"invalid_category\"\n591:       },\n592:       \"html_failure\": \"Show form-error, retain submitted values, and make no writes.\",\n593:       \"valid_new_name\": \"Automatically create and use the named category.\"\n594:      },\n595:      \"bookmark_move\": {\n596:       \"acceptance_id\": \"A12\",\n597:       \"json_field\": \"category\",\n598:       \"json_semantics\": \"Category NAME, never category ID.\",\n599:       \"invalid_json_values\": [\n600:        \"omitted\",\n601:        \"JSON null\",\n602:        \"empty\",\n603:        \"whitespace_only\",\n604:        \"121_characters\"\n605:       ],\n606:       \"html_field\": \"category_id\",\n607:       \"html_semantics\": \"Resolve the submitted ID to an existing category name.\",\n608:       \"invalid_html_values\": [\n609:        \"omitted\",\n610:        \"empty\",\n611:        \"unknown_id\"\n612:       ],\n613:       \"invalid_result\": {\n614:        \"status\": 400,\n615:        \"code\": \"invalid_category\"\n616:       },\n617:       \"html_failure\": \"Show form-error, retain submitted values, and make no writes.\",\n618:       \"valid_new_json_name\": \"Automatically create and use the named category.\",\n619:       \"never_create_from_html_id\": true\n620:      },\n621:      \"unknown_get_filter\": \"Return an empty result; do not treat an unknown category filter as an error.\"\n622:     },\n623:     \"search_contract\": \"Search is a case-insensitive substring over title, hostname, and description, with optional category filtering applied together. Search does not match tags or raw URL substrings.\",\n624:     \"url_policy\": {\n625:      \"schemes\": [\n626:       \"http\",\n627:       \"https\"\n628:      ],\n629:      \"absolute\": true,\n630:      \"nonempty_valid_hostname\": true,\n631:      \"single_label_hosts\": true,\n632:      \"dns_required\": false,\n633:      \"preserve_original_text\": true,\n634:      \"p0_fetch\": false\n635:     },\n636:     \"authorized_assertion_adaptation\": \"A02 may replace only its single-label-hostname rejection example with a positive example; missing scheme, unsupported scheme, empty hostname, and invalid hostname must remain rejected without writing.\",\n637:     \"adaptation\": \"The source IndexedDB/Dexie and SPA are source facts. Adapt persistence and rendering to the declared target profile; do not turn source facts into target requirements. Preserve the exact A04 category-management and A12 bookmark save/move contracts above, plus the title/hostname/description search contract.\"\n638:    }\n639:   },\n640:   \"authored_fields_before\": {\n641:    \"phases\": [\n642:     {\n643:      \"acceptance\": [\n644:       \"A01\",\n645:       \"A02\",\n646:       \"A03\",\n647:       \"A04\",\n648:       \"A05\",\n649:       \"A06\",\n650:       \"A07\",\n651:       \"A08\",\n652:       \"A09\",\n653:       \"A10\",\n654:       \"A11\",\n655:       \"A12\"\n656:      ],\n657:      \"features\": [\n658:       \"F01\",\n659:       \"F02\",\n660:       \"F03\",\n661:       \"F04\",\n662:       \"F05\",\n663:       \"F06\",\n664:       \"F07\",\n665:       \"F08\",\n666:       \"F09\",\n667:       \"F10\",\n668:       \"F11\"\n669:      ],\n670:      \"goal\": \"用户可保存链接（可选归类或落入未整理）、按归类或关键字找回、打开原页、清理并撤销，且全部数据跨会话与重启保留，非法输入得到可恢复的明确错误。\",\n671:      \"id\": \"P0\",\n672:      \"status\": \"not implemented\",\n673:      \"title\": \"个人收藏箱核心旅程\"\n674:     },\n675:     {\n676:      \"acceptance\": [\n677:       \"A13\",\n678:       \"A14\",\n679:       \"A15\"\n680:      ],\n681:      \"features\": [\n682:       \"F12\",\n683:       \"F13\",\n684:       \"F14\"\n685:      ],\n686:      \"goal\": \"在离线可用的前提下增强记录可辨识度（本地派生图标、外部抓取仅作增强），并支持浏览器书签格式的导入导出与重复链接检测，用于长期库维护。\",\n687:      \"id\": \"P1\",\n688:      \"status\": \"not implemented\",\n689:      \"title\": \"成熟增强：元数据、互操作与库清理\"\n690:     }\n691:    ],\n692:    \"architecture_markdown\": \"## 默认技术栈与理由\\n\\n- **交付 profile：python-web。** 运行时为 Python 3.12 标准库（`http.server`、`sqlite3`、`urllib`、`json`、`html.parser`），零第三方依赖，满足 V1 指定的离线标准库约束。\\n- 备选方案（Flask/FastAPI、Node + IndexedDB）生态更丰富，但需要安装依赖或 npm/Playwright，与离线、可独立验收的要求冲突，故不采用。\\n- 前端为服务端渲染的少量 HTML 加原生 JS 渐进增强，无构建步骤；数据存取集中在服务层，HTML 表单与 JSON API 都是同一服务层的薄适配器。\\n- 理由：场景是单用户本地收藏箱，数据量小、访问单机，标准库加 SQLite 单文件即可覆盖持久化、检索、打开回跳与离线验收。\\n\\n## 数据模型（SQLite，文件位于应用 `--data-dir/bookmarks.sqlite3`；验收时为每实例隔离子目录，绝不是测试者 data_dir 根目录）\\n\\n- `schema_meta(version INTEGER)`：迁移版本。\\n- `categories(id TEXT PK, name TEXT NOT NULL UNIQUE COLLATE NOCASE, is_default INTEGER NOT NULL DEFAULT 0, position INTEGER NOT NULL, created_at INTEGER NOT NULL)`：首启预置「未整理」(is_default=1)、「待购」、「家居改造」、「以后看看」。\\n- `bookmarks(id TEXT PK, url TEXT NOT NULL, hostname TEXT NOT NULL, title TEXT NULL, description TEXT NULL, category_id TEXT NOT NULL REFERENCES categories(id), favicon_url TEXT NULL, created_at INTEGER NOT NULL, updated_at INTEGER NOT NULL, trashed_at INTEGER NULL)`。\\n- 索引：`category_id`、`created_at`、`hostname`；不建立 `url` 唯一索引。重复 URL 的 409 判定（属 P1/F14）由服务层查询活动记录完成，`allow_duplicate=true` 时绕过；软删除记录不参与判定。\\n- 迁移：首次启动在单一事务内建表并写入预置归类；后续按技术决策 D12 演进版本。\\n\\n## API 与错误合同（JSON）\\n\\n- `GET /api/health` 返回 200 就绪信息与 schema 版本。\\n- `GET /api/categories` 返回归类数组，每项含 id、name、count、is_default。\\n- `POST /api/categories`（body: name）返回 201；重名 409 `duplicate_category`；空名或超过 120 字符 400 `invalid_name`。\\n- `PATCH /api/categories/{id}` 重命名，空名或超过 120 字符 400 `invalid_name`，与既有归类重名 409 `duplicate_category`，默认归类不可重命名（400 `protected_category`）；`DELETE /api/categories/{id}` 在事务内按 is_default 把其记录迁回默认归类，默认归类不可删（400 `protected_category`）。\\n- `GET /api/bookmarks?category=<name|id>&q=<str>&include_trashed=0` 返回记录数组（默认按 created_at 倒序，同值以 id 兜底）；`q` 对标题、hostname 与描述做大小写不敏感子串匹配，并与 category 叠加；未知归类过滤返回空集。\\n- `POST /api/bookmarks`（body: url 必填；title、description、category 可选；allow_duplicate 可选）返回 201；category 省略或为 null 时归入默认「未整理」，给出新名称时按 NOCASE 自动创建并复用既有归类，显式空字符串或超过 120 字符 4... (line truncated to 2000 chars)\n693:    \"roles\": [\n694:     {\n695:      \"id\": \"R01\",\n696:      \"name\": \"收藏者（个人用户）\",\n697:      \"responsibility\": \"在浏览时主动保存外部网页链接，选择或新建简单归类、把未整理的链接移动到合适归类、按归类或关键字找回、打开记录回到原页，并清理误存条目。\"\n698:     },\n699:     {\n700:      \"id\": \"R02\",\n701:      \"name\": \"本地收藏应用（服务端与页面外壳）\",\n702:      \"responsibility\": \"校验录入、派生域名、持久化收藏与归类、提供保存/浏览/检索/打开/恢复接口，并在离线条件下保持可用。\"\n703:     },\n704:     {\n705:      \"id\": \"R03\",\n706:      \"name\": \"独立验收执行者\",\n707:      \"responsibility\": \"以 URL 与 CLI 参数驱动真实目标，执行正负向行为断言、重启持久化验证与错误恢复验证，不修改应用、不自报运行结果。\"\n708:     }\n709:    ],\n710:    \"title\": \"生活待购与灵感收藏夹\",\n711:    \"limits\": [\n712:     \"不实现云同步、多用户共享或托管部署（D11、F16、F21）。\",\n713:     \"不保存网页快照、不做正文全文检索、不做失效链接检测（F17、F18、D13）。\",\n714:     \"不引入置顶/归档、多排序模式、复制 URL 与访问计数（F20、F23、F24）。\",\n715:     \"归类为扁平单选，不支持嵌套层级或多标签并存（F19、D01）。\",\n716:     \"第三方元数据与图标抓取未验证可达性，仅作可选增强且失败静默降级（F12、D05）。\",\n717:     \"验收不携带认证凭据；若目标要求认证，验收必须显式报告基础设施未就绪而非跳过或通过（D09）。\",\n718:     \"不设置未经验证的性能或成本目标。\"\n719:    ],\n720:    \"features\": [\n721:     {\n722:      \"acceptance\": [\n723:       \"A01\",\n724:       \"A02\",\n725:       \"A03\"\n726:      ],\n727:      \"applicability\": \"current required\",\n728:      \"id\": \"F01\",\n729:      \"name\": \"保存收藏（URL 必填，标题/描述可选）\",\n730:      \"phase\": \"P0\",\n731:      \"reason\": \"场景流程第1-2步要求看到想记住的页面即主动保存；上游记录了新记录默认字段与保存落盘（S02、S06），并把 URL 校验与编辑回填收敛在表单（S04）。\",\n732:      \"sources\": [\n733:       \"S02\",\n734:       \"S04\",\n735:       \"S06\",\n736:       \"S17\"\n737:      ]\n738:     },\n739:     {\n740:      \"acceptance\": [\n741:       \"A03\"\n742:      ],\n743:      \"applicability\": \"current required\",\n744:      \"id\": \"F02\",\n745:      \"name\": \"默认“未整理”与预置归类集合\",\n746:      \"phase\": \"P0\",\n747:      \"reason\": \"场景流程第3步要求未整理的链接先进入默认归类；上游只有 Home/Archived 视图、无默认桶（S16），故按场景新增默认收件区，并借鉴其标签聚合思路（S20）。\",\n748:      \"sources\": [\n749:       \"S16\",\n750:       \"S20\"\n751:      ]\n752:     },\n753:     {\n754:      \"acceptance\": [\n755:       \"A04\"\n756:      ],\n757:      \"applicability\": \"current required\",\n758:      \"id\": \"F03\",\n759:      \"name\": \"归类管理（新建/重命名/删除）\",\n760:      \"phase\": \"P0\",\n761:      \"reason\": \"场景验收第3条要求可新建归类；上游明确没有 collections/folders（S16），因此归类实体与增删改必须新设计并落库。\",\n762:      \"sources\": [\n763:       \"S16\",\n764:       \"S20\"\n765:      ]\n766:     },\n767:     {\n768:      \"acceptance\": [\n769:       \"A05\",\n770:       \"A12\"\n771:      ],\n772:      \"applicability\": \"current required\",\n773:      \"id\": \"F04\",\n774:      \"name\": \"记录在归类间移动\",\n775:      \"phase\": \"P0\",\n776:      \"reason\": \"场景验收第3条要求记录可在归类之间移动且重开后仍有效；上游检索按标签交集筛选（S16），这里把多值交集改造为单一归属迁移。\",\n777:      \"sources\": [\n778:       \"S16\"\n779:      ]\n780:     },\n781:     {\n782:      \"acceptance\": [\n783:       \"A06\"\n784:      ],\n785:      \"applicability\": \"current required\",\n786:      \"id\": \"F05\",\n787:      \"name\": \"归类浏览与条目计数\",\n788:      \"phase\": \"P0\",\n789:      \"reason\": \"场景验收第4条要求通过归类浏览找回；上游侧栏按标签聚合计数（S20、S16），改为按归类聚合与筛选。\",\n790:      \"sources\": [\n791:       \"S16\",\n792:       \"S20\"\n793:      ]\n794:     },\n795:     {\n796:      \"acceptance\": [\n797:       \"A07\"\n798:      ],\n799:      \"applicability\": \"current required\",\n800:      \"id\": \"F06\",\n801:      \"name\": \"关键字检索（标题/域名/描述）\",\n802:      \"phase\": \"P0\",\n803:      \"reason\": \"场景验收第4条要求关键字检索；上游仅匹配标题小写（S16），需扩展到域名与描述以覆盖只记得来源的场景。\",\n804:      \"sources\": [\n805:       \"S16\"\n806:      ]\n807:     },\n808:     {\n809:      \"acceptance\": [\n810:       \"A08\"\n811:      ],\n812:      \"applicability\": \"current required\",\n813:      \"id\": \"F07\",\n814:      \"name\": \"打开原始网页（URL 锚定与回跳）\",\n815:      \"phase\": \"P0\",\n816:      \"reason\": \"场景验收第2条与流程第5步要求打开记录即回到原页；上游 Visit 以 window.open(noopener,noreferrer) 打开并由 URL 派生域名（S15、S08），保留打开与派生、去掉访问计数。\",\n817:      \"sources\": [\n818:       \"S15\",\n819:       \"S08\"\n820:      ]\n821:     },\n822:     {\n823:      \"acceptance\": [\n824:       \"A01\",\n825:       \"A05\",\n826:       \"A09\"\n827:      ],\n828:      \"applicability\": \"current required\",\n829:      \"id\": \"F08\",\n830:      \"name\": \"多会话持久化（跨重启保留）\",\n831:      \"phase\": \"P0\",\n832:      \"reason\": \"场景验收第1条要求多次会话之间持久保留；上游单表落盘并在启动时全量载入（S09、S13、S06），README 定位 local-first（S11），持久化机制沿用但记录结构增加归类字段。\",\n833:      \"sources\": [\n834:       \"S09\",\n835:       \"S13\",\n836:       \"S06\",\n837:       \"S11\"\n838:      ]\n839:     },\n840:     {\n841:      \"acceptance\": [\n842:       \"A09\"\n843:      ],\n844:      \"applicability\": \"current required\",\n845:      \"id\": \"F09\",\n846:      \"name\": \"删除与撤销恢复\",\n847:      \"phase\": \"P0\",\n848:      \"reason\": \"场景要求可恢复的失败；上游删除配 5 秒 Undo 恢复（S07），去掉“仅归档可删”前置限制，保留删除加恢复的兜底。\",\n849:      \"sources\": [\n850:       \"S07\"\n851:      ]\n852:     },\n853:     {\n854:      \"acceptance\": [\n855:       \"A02\",\n856:       \"A10\",\n857:       \"A12\"\n858:      ],\n859:      \"applicability\": \"current required\",\n860:      \"id\": \"F10\",\n861:      \"name\": \"输入校验与错误合同\",\n862:      \"phase\": \"P0\",\n863:      \"reason\": \"上游以 Valibot 约束 http/https、标题长度与标签数量（S04），并由 getHostname 派生域名（S08）；场景把标签必填改为可选归类，需要显式错误的保存与移动契约。\",\n864:      \"sources\": [\n865:       \"S04\",\n866:       \"S08\"\n867:      ]\n868:     },\n869:     {\n870:      \"acceptance\": [\n871:       \"A11\"\n872:      ],\n873:      \"applicability\": \"current required\",\n874:      \"id\": \"F11\",\n875:      \"name\": \"本地应用外壳与首启（空库）\",\n876:      \"phase\": \"P0\",\n877:      \"reason\": \"场景是纯个人本地工具、无服务端需求；上游 index.html 提供 #root 且入口挂载并在根缺失时报错（S10、S18），沿用为运行外壳。\",\n878:      \"sources\": [\n879:       \"S10\",\n880:       \"S18\"\n881:      ]\n882:     },\n883:     {\n884:      \"acceptance\": [\n885:       \"A13\"\n886:      ],\n887:      \"applicability\": \"later\",\n888:      \"id\": \"F12\",\n889:      \"name\": \"元数据与图标增强（离线降级）\",\n890:      \"phase\": \"P1\",\n891:      \"reason\": \"场景希望一眼辨认商品页/教程/灵感图，但上游依赖 api.microlink.io、images.weserv.nl 与 Google favicon 三个未验证端点且失败仅 console.error（S14、S21、S08）；因此把可用性依赖降为本地域名派生，外部抓取降级为可选增强。\",\n892:      \"sources\": [\n893:       \"S14\",\n894:       \"S21\",\n895:       \"S08\"\n896:      ]\n897:     },\n898:     {\n899:      \"acceptance\": [\n900:       \"A14\"\n901:      ],\n902:      \"applicability\": \"later\",\n903:      \"id\": \"F13\",\n904:      \"name\": \"导入/导出（浏览器书签 HTML）\",\n905:      \"phase\": \"P1\",\n906:      \"reason\": \"互操作是成熟产品的标准配置，但上游 manifest 没有导入/导出（S22 无测试脚本、无导入导出能力），属场景后期新增。\",\n907:      \"sources\": []\n908:     },\n909:     {\n910:      \"acceptance\": [\n911:       \"A15\"\n912:      ],\n913:      \"applicability\": \"later\",\n914:      \"id\": \"F14\",\n915:      \"name\": \"重复链接检测\",\n916:      \"phase\": \"P1\",\n917:      \"reason\": \"成熟产品趋向一址一记录，上游未实现去重（S16、S17 无重复处理）；P1 在保存与导入路径新增服务层重复检测（D06），P0 核心用例不依赖该能力。\",\n918:      \"sources\": []\n919:     },\n920:     {\n921:      \"acceptance\": [],\n922:      \"applicability\": \"not applicable\",\n923:      \"id\": \"F15\",\n924:      \"name\": \"浏览器扩展/分享目标抓取\",\n925:      \"phase\": null,\n926:      \"reason\": \"场景交付为本地 Web 工具，扩展与移动分享目标不在本期范围，手工录入与打开回跳已覆盖核心旅程。\",\n927:      \"sources\": []\n928:     },\n929:     {\n930:      \"acceptance\": [],\n931:      \"applicability\": \"not applicable\",\n932:      \"id\": \"F16\",\n933:      \"name\": \"多设备与云同步\",\n934:      \"phase\": null,\n935:      \"reason\": \"本期是单机单实例的本地库，数据在单一 SQLite 文件；跨设备同步属后期形态，不阻塞核心旅程。\",\n936:      \"sources\": []\n937:     },\n938:     {\n939:      \"acceptance\": [],\n940:      \"applicability\": \"decision needed\",\n941:      \"id\": \"F17\",\n942:      \"name\": \"网页留存副本/快照\",\n943:      \"phase\": null,\n944:      \"reason\": \"记录只保证引用而非内容（场景与原类型定义如此）；是否保存副本依赖外部抓取与存储，离线验收不可验证，需用户明确要求后再定。\",\n945:      \"sources\": []\n946:     },\n947:     {\n948:      \"acceptance\": [],\n949:      \"applicability\": \"decision needed\",\n950:      \"id\": \"F18\",\n951:      \"name\": \"失效链接检测与修复\",\n952:      \"phase\": null,\n953:      \"reason\": \"链接腐坏是本类型的结构性风险，但检测需要主动外呼，外部网络在验收中禁用；先保证引用与打开回跳，是否检测待用户决定。\",\n954:      \"sources\": []\n955:     },\n956:     {\n957:      \"acceptance\": [],\n958:      \"applicability\": \"decision needed\",\n959:      \"id\": \"F19\",\n960:      \"name\": \"嵌套归类与多标签并存\",\n961:      \"phase\": null,\n962:      \"reason\": \"场景明说“选择一个简单归类”，扁平单选加收件区已足够；嵌套/标签是成熟能力，待归类数量或交叉主题增长时再评估。\",\n963:      \"sources\": []\n964:     },\n965:     {\n966:      \"acceptance\": [],\n967:      \"applicability\": \"not applicable\",\n968:      \"id\": \"F20\",\n969:      \"name\": \"置顶/归档与多排序模式\",\n970:      \"phase\": null,\n971:      \"reason\": \"上游置顶与归档、三种排序属书签阅读器语境（S19、S16、S03），会给编辑与删除增加前置条件，与快速保存、快速清理相冲突，故不采用。\",\n972:      \"sources\": [\n973:       \"S19\",\n974:       \"S16\",\n975:       \"S03\"\n976:      ]\n977:     },\n978:     {\n979:      \"acceptance\": [],\n980:      \"applicability\": \"not applicable\",\n981:      \"id\": \"F21\",\n982:      \"name\": \"公开分享与协作库\",\n983:      \"phase\": null,\n984:      \"reason\": \"场景是私有个人收藏箱，分享不在核心旅程内；公开或协作需要多用户身份与权限，属不同类型定位。\",\n985:      \"sources\": []\n986:     },\n987:     {\n988:      \"acceptance\": [],\n989:      \"applicability\": \"not applicable\",\n990:      \"id\": \"F22\",\n991:      \"name\": \"阅读稍后与未读标记\",\n992:      \"phase\": null,\n993:      \"reason\": \"场景重心是留存引用并可回跳，而非消费队列；未读标记会使产品向 Read-it-later 漂移。\",\n994:      \"sources\": []\n995:     },\n996:     {\n997:      \"acceptance\": [],\n998:      \"applicability\": \"not applicable\",\n999:      \"id\": \"F23\",\n1000:      \"name\": \"复制 URL 动作\",\n1001:      \"phase\": null,\n1002:      \"reason\": \"上游提供 Copy URL（S12），但本场景终点是打开原页而非分发链接，去掉可减少每条记录的操作噪音。\",\n1003:      \"sources\": [\n1004:       \"S12\"\n1005:      ]\n1006:     },\n1007:     {\n1008:      \"acceptance\": [],\n1009:      \"applicability\": \"not applicable\",\n1010:      \"id\": \"F24\",\n1011:      \"name\": \"访问计数与最近访问时间\",\n1012:      \"phase\": null,\n1013:      \"reason\": \"上游 Visit 会累加 visitCount 与 visitedAt（S15、S17）；场景只需打开动作，不需访问统计，故不保留这两个字段。\",\n1014:      \"sources\": [\n1015:       \"S15\",\n1016:       \"S17\"\n1017:      ]\n1018:     }\n1019:    ],\n1020:    \"decisions\": [\n1021:     {\n1022:      \"default\": \"单选归类（bookmark.category_id 标量外键）。场景流程明确“选择一个简单归类”，单归属让移动、计数与浏览语义无歧义；未来若需多值可迁移到关联表而不丢数据。\",\n1023:      \"id\": \"D01\",\n1024:      \"impact\": \"决定数据模型（标量外键 vs 关联表）以及浏览、计数与检索的实现路径。\",\n1025:      \"question\": \"记录应归属于单一“归类”，还是允许像标签一样同时属于多个？\",\n1026:      \"status\": \"decided\",\n1027:      \"when_to_ask\": \"当真实用户反馈同一条记录必须同时属于多个主题，或需要跨主题交叉检索时再评估多标签。\"\n1028:     },\n1029:     {\n1030:      \"default\": \"落入默认“未整理”，保存始终成功。场景流程第3步要求未经整理的链接可先进入默认归类，快速保存不应打断浏览。\",\n1031:      \"id\": \"D02\",\n1032:      \"impact\": \"决定保存接口是否允许缺省 category，以及首启预置数据内容。\",\n1033:      \"question\": \"保存时不选归类，应阻止保存还是落入默认“未整理”？\",\n1034:      \"status\": \"decided\",\n1035:      \"when_to_ask\": \"当目标用户群要求强制归类（例如团队共享库）时再改为必选。\"\n1036:     },\n1037:     {\n1038:      \"default\": \"自动创建（名称大小写不敏感去重），重名则复用现有归类；保持保存流程不中断。\",\n1039:      \"id\": \"D03\",\n1040:      \"impact\": \"决定 categories 的唯一约束、写入事务边界与 409 的语义。\",\n1041:      \"question\": \"在保存或移动界面输入一个尚不存在的归类名，应自动创建还是报错？\",\n1042:      \"status\": \"decided\",\n1043:      \"when_to_ask\": \"当出现拼写错误导致归类碎片化的证据时，改为只允许从既有归类中选择。\"\n1044:     },\n1045:     {\n1046:      \"default\": \"软删除：记录标记 trashed_at，默认视图排除，提供撤销恢复；场景要求可恢复的失败。\",\n1047:      \"id\": \"D04\",\n1048:      \"impact\": \"决定数据模型的 trashed_at 列、列表过滤条件，以及 /restore 与 purge 接口。\",\n1049:      \"question\": \"删除是立即物理删除，还是软删除到可恢复区并支持短时撤销？\",\n1050:      \"status\": \"decided\",\n1051:      \"when_to_ask\": \"当用户要求彻底清除隐私数据或回收站增长需要释放空间时，再提供永久删除与清空。\"\n1052:     },\n1053:     {\n1054:      \"default\": \"本地优先：图标由域名派生本地路由，第三方元数据抓取为可选增强且失败静默降级，保证离线可保存。\",\n1055:      \"id\": \"D05\",\n1056:      \"impact\": \"决定保存流程的时延与可用性依赖，以及收藏响应中的 favicon/title 字段形态。\",\n1057:      \"question\": \"标题、描述与图标是否依赖第三方抓取服务？\",\n1058:      \"status\": \"decided\",\n1059:      \"when_to_ask\": \"当部署环境确认可访问外部服务且用户需要富预览时再启用增强。\"\n1060:     },\n1061:     {\n1062:      \"default\": \"自 P1/F14 起默认检测并返回 409 duplicate_url（附已有 id 供跳转查看），保存方显式 allow_duplicate 时可强制新增；P0 核心用例不依赖去重，软删除记录不参与判定；场景与成熟产品都倾向一址一记录。\",\n1063:      \"id\": \"D06\",\n1064:      \"impact\": \"决定服务层去重查询、allow_duplicate 语义与导入时的合并或跳过策略（不使用 url 唯一索引）。\",\n1065:      \"question\": \"同一 URL 再次保存时，阻止还是允许？\",\n1066:      \"status\": \"decided\",\n1067:      \"when_to_ask\": \"当用户明确需要对同一地址保留多个不同上下文的记录时再放宽。\"\n1068:     },\n1069:     {\n1070:      \"default\": \"标题加域名(hostname)加描述，大小写不敏感，可与归类过滤叠加；不检索正文（无抓取）。\",\n1071:      \"id\": \"D07\",\n1072:      \"impact\": \"决定查询实现与检索参数语义。\",\n1073:      \"question\": \"关键字应匹配哪些字段？\",\n1074:      \"status\": \"decided\",\n1075:      \"when_to_ask\": \"当需要按网页正文全文检索时再引入抓取与索引（属后期能力）。\"\n1076:     },\n1077:     {\n1078:      \"default\": \"python-web 加 Python 3.12 标准库 http.server 加单文件 SQLite；满足离线、单用户与可独立验收，无需外部依赖。\",\n1079:      \"id\": \"D08\",\n1080:      \"impact\": \"决定交付 profile、验收方式与部署命令形态。\",\n1081:      \"question\": \"采用何种运行时与持久化方式？\",\n1082:      \"status\": \"decided\",\n1083:      \"when_to_ask\": \"当需要多用户、并发写入或托管部署时再引入 Web 框架与服务端数据库。\"\n1084:     },\n1085:     {\n1086:      \"default\": \"默认无认证；交付进程在独立验收网络中监听测试者可路由的接口（`--host 0.0.0.0`），日常本机使用可绑定 127.0.0.1；不引入凭据文件，符合个人本地库的定位。\",\n1087:      \"id\": \"D09\",\n1088:      \"impact\": \"决定部署方式与验收的认证契约（验收默认不携带凭据）。\",\n1089:      \"question\": \"是否需要登录或口令？\",\n1090:      \"status\": \"decided\",\n1091:      \"when_to_ask\": \"当应用需要暴露到局域网或公网时，必须加入认证，否则只允许本机绑定。\"\n1092:     },\n1093:     {\n1094:      \"default\": \"Netscape 浏览器书签 HTML（本类型的交换约定），归类映射为文件夹或标签字段。\",\n1095:      \"id\": \"D10\",\n1096:      \"impact\": \"决定 P1 导入/导出的解析与生成实现。\",\n1097:      \"question\": \"导入/导出采用什么格式？\",\n1098:      \"status\": \"decided\",\n1099:      \"when_to_ask\": \"当需要与某个具体产品双向同步时再适配其专有格式。\"\n1100:     },\n1101:     {\n1102:      \"default\": \"P0 不做：本地单实例，数据在单一 SQLite 文件；跨设备属后期能力。\",\n1103:      \"id\": \"D11\",\n1104:      \"impact\": \"影响运行形态与数据归属，不阻塞 P0 核心旅程。\",\n1105:      \"question\": \"是否提供云同步或多用户共享？\",\n1106:      \"status\": \"deferred\",\n1107:      \"when_to_ask\": \"当用户明确需要在多设备访问同一库时再设计同步或托管。\"\n1108:     },\n1109:     {\n1110:      \"default\": \"P0 使用扁平单选归类加“未整理”收件区；嵌套与标签属成熟能力，按需在后期启用。\",\n1111:      \"id\": \"D12\",\n1112:      \"impact\": \"影响侧栏结构与检索实现，可后续迁移而不破坏现有数据。\",\n1113:      \"question\": \"归类是否需要嵌套层级，或与标签并存？\",\n1114:      \"status\": \"deferred\",\n1115:      \"when_to_ask\": \"当扁平归类数量增长到难以浏览，或需要交叉主题时。\"\n1116:     },\n1117:     {\n[Output truncated. Continue reading with offset: 1118]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file input.json, lines 1-1117\n1: {\n2:  \"identity\": {\n3:   \"scope_digest\": \"a2ca780e54267acf42a8209de54eeadea5df1c8b1b9242fa026621a6009b3e31\",\n4:   \"case_policy_digest\": \"fdf6b892771ee2a6068f197564413afca67a0a4d6a82e057e6eaf7cde5aae643\",\n5:   \"diff_digest\": \"ec8d62722942d084a7887ab63e5a46597761efe7540549b7ef9b02a32e7e056c\",\n6:   \"baseline_digest\": \"8d9229d3895be0cd1672ad28a2926549a2e5e6920b186ceeaef09c38c37803d9\",\n7:   \"candidate_authored_digest\": \"fdd76f122aba9922419be44f94a6cf4d884985e71b2d36574b0dc72a0cd7cae4\",\n8:   \"baseline_program_digest\": \"8a3399bf52eb8185ac57fd19133beeefc93acaac4d2f707ff4346be6d8f87274\",\n9:   \"candidate_program_digest\": \"c90c68281d4ec027236f45465d6d7109af9db8bf58b67bb2e9a0a55a6d35f321\",\n10:   \"r7_authorization_material_digest\": \"6bab6cf15f0c238fa8a7b7bc5a192caf704ef84b33055ad95543db41edcf00ae\"\n11:  },\n12:  \"scope\": {\n13:   \"authored_field_paths\": [\n14:    [\n15:     \"acceptance\",\n16:     \"A02\",\n17:     \"goal\"\n18:    ],\n19:    [\n20:     \"acceptance\",\n21:     \"A04\",\n22:     \"goal\"\n23:    ],\n24:    [\n25:     \"acceptance\",\n26:     \"A06\",\n27:     \"goal\"\n28:    ],\n29:    [\n30:     \"acceptance\",\n31:     \"A07\",\n32:     \"goal\"\n33:    ],\n34:    [\n35:     \"acceptance\",\n36:     \"A09\",\n37:     \"goal\"\n38:    ],\n39:    [\n40:     \"acceptance\",\n41:     \"A10\",\n42:     \"goal\"\n43:    ],\n44:    [\n45:     \"acceptance\",\n46:     \"A12\",\n47:     \"features\"\n48:    ],\n49:    [\n50:     \"acceptance\",\n51:     \"A12\",\n52:     \"goal\"\n53:    ],\n54:    [\n55:     \"architecture_markdown\"\n56:    ],\n57:    [\n58:     \"contract_coverage\",\n59:     \"error_contract\"\n60:    ],\n61:    [\n62:     \"contract_coverage\",\n63:     \"features\"\n64:    ],\n65:    [\n66:     \"contract_coverage\",\n67:     \"review_rules_version\"\n68:    ],\n69:    [\n70:     \"contract_coverage\",\n71:     \"schema\"\n72:    ],\n73:    [\n74:     \"decisions\",\n75:     \"D03\",\n76:     \"impact\"\n77:    ],\n78:    [\n79:     \"decisions\",\n80:     \"D04\",\n81:     \"impact\"\n82:    ],\n83:    [\n84:     \"decisions\",\n85:     \"D07\",\n86:     \"impact\"\n87:    ],\n88:    [\n89:     \"decisions\",\n90:     \"D08\",\n91:     \"impact\"\n92:    ],\n93:    [\n94:     \"features\",\n95:     \"F01\",\n96:     \"acceptance\"\n97:    ],\n98:    [\n99:     \"features\",\n100:     \"F01\",\n101:     \"reason\"\n102:    ],\n103:    [\n104:     \"features\",\n105:     \"F01\",\n106:     \"sources\"\n107:    ],\n108:    [\n109:     \"features\",\n110:     \"F02\",\n111:     \"reason\"\n112:    ],\n113:    [\n114:     \"features\",\n115:     \"F03\",\n116:     \"reason\"\n117:    ],\n118:    [\n119:     \"features\",\n120:     \"F07\",\n121:     \"reason\"\n122:    ],\n123:    [\n124:     \"features\",\n125:     \"F07\",\n126:     \"sources\"\n127:    ],\n128:    [\n129:     \"features\",\n130:     \"F08\",\n131:     \"reason\"\n132:    ],\n133:    [\n134:     \"features\",\n135:     \"F08\",\n136:     \"sources\"\n137:    ],\n138:    [\n139:     \"features\",\n140:     \"F09\",\n141:     \"reason\"\n142:    ],\n143:    [\n144:     \"features\",\n145:     \"F10\",\n146:     \"reason\"\n147:    ],\n148:    [\n149:     \"features\",\n150:     \"F10\",\n151:     \"sources\"\n152:    ],\n153:    [\n154:     \"features\",\n155:     \"F11\",\n156:     \"reason\"\n157:    ],\n158:    [\n159:     \"features\",\n160:     \"F11\",\n161:     \"sources\"\n162:    ],\n163:    [\n164:     \"features\",\n165:     \"F12\",\n166:     \"reason\"\n167:    ],\n168:    [\n169:     \"features\",\n170:     \"F12\",\n171:     \"sources\"\n172:    ],\n173:    [\n174:     \"features\",\n175:     \"F13\",\n176:     \"reason\"\n177:    ],\n178:    [\n179:     \"features\",\n180:     \"F14\",\n181:     \"reason\"\n182:    ],\n183:    [\n184:     \"features\",\n185:     \"F17\",\n186:     \"reason\"\n187:    ],\n188:    [\n189:     \"features\",\n190:     \"F24\",\n191:     \"reason\"\n192:    ],\n193:    [\n194:     \"features\",\n195:     \"F24\",\n196:     \"sources\"\n197:    ]\n198:   ],\n199:   \"authorized_assertion_changes\": [\n200:    {\n201:     \"acceptance_id\": \"A02\",\n202:     \"change\": \"single_label_hostname_negative_to_positive\",\n203:     \"rationale\": \"The explicit target policy accepts any absolute parseable HTTP(S) URL with a valid nonempty hostname, without requiring DNS or a dot. This is the sole authorized semantic replacement of an existing assertion; malformed scheme, non-HTTP(S), empty/invalid hostname and no-write-on-failure negatives remain.\"\n204:    }\n205:   ],\n206:   \"baseline\": {\n207:    \"artifact_id\": \"tpl_7f4c17e834c342e7b462e6bb8b6379e4\",\n208:    \"case_basis_digest\": \"a22ff1c065d27aecb0cee21dc6b597f5607375bc8ebc297a3451e708f4da5589\",\n209:    \"expected_digest\": \"8d9229d3895be0cd1672ad28a2926549a2e5e6920b186ceeaef09c38c37803d9\",\n210:    \"immutable_case_facts\": 29\n211:   },\n212:   \"edit_paths\": [\n213:    \"acceptance/README.md\",\n214:    \"acceptance/p0_find_open.py\",\n215:    \"acceptance/p0_library.py\",\n216:    \"acceptance/p0_organize.py\",\n217:    \"acceptance/p0_recovery.py\",\n218:    \"acceptance/runner.json\"\n219:   ],\n220:   \"known_blockers\": [\n221:    {\n222:     \"acceptance_id\": \"A04\",\n223:     \"basis\": \"Category management needs actual HTML create/rename/delete journeys, protection, validation and reassignment of active and soft-deleted records.\",\n224:     \"decision_id\": \"D03\",\n225:     \"feature_id\": \"F03\"\n226:    },\n227:    {\n228:     \"acceptance_id\": \"A05\",\n229:     \"basis\": \"The existing move capability needs browser form coverage and visible result/feedback while preserving persistence checks.\",\n230:     \"decision_id\": \"D03\",\n231:     \"feature_id\": \"F04\"\n232:    },\n233:    {\n234:     \"acceptance_id\": \"A06\",\n235:     \"basis\": \"P0 category browsing requires visible counts that include active records only and agree with API/list results after state changes.\",\n236:     \"decision_id\": \"D07\",\n237:     \"feature_id\": \"F05\"\n238:    },\n239:    {\n240:     \"acceptance_id\": \"A07\",\n241:     \"basis\": \"Category-scoped search must submit category and q together and show selected category, retained query, and matching/empty results.\",\n242:     \"decision_id\": \"D07\",\n243:     \"feature_id\": \"F06\"\n244:    },\n245:    {\n246:     \"acceptance_id\": \"A01\",\n247:     \"basis\": \"The source IndexedDB/Dexie implementation is not the target Python/SQLite persistence implementation; correct target rationale while preserving restart assertion.\",\n248:     \"decision_id\": \"D08\",\n249:     \"feature_id\": \"F08\"\n250:    },\n251:    {\n252:     \"acceptance_id\": \"A09\",\n253:     \"basis\": \"HTML soft-delete/restore recovery must be exercised; category deletion also needs trashed records to remain recoverable.\",\n254:     \"decision_id\": \"D04\",\n255:     \"feature_id\": \"F09\"\n256:    },\n257:    {\n258:     \"acceptance_id\": \"A10\",\n259:     \"basis\": \"Malformed requests and form validation need explicit non-mutating feedback/recovery; retain JSON bad_request and existing API behavior.\",\n260:     \"decision_id\": null,\n261:     \"feature_id\": \"F10\"\n262:    },\n263:    {\n264:     \"acceptance_id\": \"A02\",\n265:     \"basis\": \"Correct the URL boundary from dotted-host rejection to absolute parseable HTTP(S) with a valid nonempty hostname.\",\n266:     \"decision_id\": null,\n267:     \"feature_id\": \"F10\"\n268:    },\n269:    {\n270:     \"acceptance_id\": \"A12\",\n271:     \"basis\": \"Invalid category input must retain failure/no-mutation semantics with usable HTML feedback.\",\n272:     \"decision_id\": \"D03\",\n273:     \"feature_id\": \"F10\"\n274:    },\n275:    {\n276:     \"acceptance_id\": \"A11\",\n277:     \"basis\": \"The target shell is Python server-rendered HTML, not the source SPA mount; preserve the empty-library readiness contract.\",\n278:     \"decision_id\": \"D08\",\n279:     \"feature_id\": \"F11\"\n280:    }\n281:   ],\n282:   \"version\": \"atlas.aggregate-repair-scope.v2\"\n283:  },\n284:  \"exact_diff\": {\n285:   \"schema\": \"atlas.aggregate-repair-diff.v1\",\n286:   \"scope_version\": \"atlas.aggregate-repair-scope.v2\",\n287:   \"baseline_artifact_digest\": \"8d9229d3895be0cd1672ad28a2926549a2e5e6920b186ceeaef09c38c37803d9\",\n288:   \"case_design_before\": [\n289:    {\n290:     \"capability\": \"个人收藏库本地持久化：整个收藏集合写入浏览器 IndexedDB 单表，应用每次打开时全量载入，保存或删除立即落盘，关闭再打开后仍在。\",\n291:     \"disposition\": \"adopted\",\n292:     \"evidence_ids\": [\n293:      \"ev_ba200adf6e2c_515aa5d072bd2ec4\",\n294:      \"ev_ba200adf6e2c_35e41aab676021eb\",\n295:      \"ev_ba200adf6e2c_86ed2327f33a3ca8\",\n296:      \"ev_ba200adf6e2c_6805376f7e2ee383\"\n297:     ],\n298:     \"reason\": \"场景验收第1条要求“主动保存的链接在多次会话之间持久保留，形成不断增长的个人收藏”，上游 Dexie 单表 + 内存映射 + put/delete 落盘已直接满足，README 也定位为 local-first。差异仅在于记录结构增加归类字段，持久化机制原样沿用。\"\n299:    },\n300:    {\n301:     \"capability\": \"记录以外部网页 URL 锚定：每条收藏持有 id、url、hostname（及可选标题/图标），点击记录在新标签打开原始网页。\",\n302:     \"disposition\": \"adopted\",\n303:     \"evidence_ids\": [\n304:      \"ev_ba200adf6e2c_9c7f6060878383fa\",\n305:      \"ev_ba200adf6e2c_93ff254508846f11\",\n306:      \"ev_ba200adf6e2c_5011700a24e503c7\"\n307:     ],\n308:     \"reason\": \"场景验收第2条与流程第5步要求“打开记录即跳转到该页面，回到原始网页继续购买、阅读或参考”。上游 Visit 正是保存后以 window.open(noopener,noreferrer) 打开，hostname 由 URL 派生。差异是场景不需要访问计数与 visitedAt，只保留打开动作与域名派生。\"\n309:    },\n310:    {\n311:     \"capability\": \"新增/编辑收藏的表单：填写 URL 与标题，URL 必须为合法 http/https 且含点域名，编辑时回填原字段并保留 id 与创建时间。\",\n312:     \"disposition\": \"adopted\",\n313:     \"evidence_ids\": [\n314:      \"ev_ba200adf6e2c_05babdea64ba9858\",\n315:      \"ev_ba200adf6e2c_06c81a165e03c96a\",\n316:      \"ev_ba200adf6e2c_1596da4a90687ca5\"\n317:     ],\n318:     \"reason\": \"场景流程第1-2步是“浏览中看到想记住的页面便主动保存”，需要可信录入与校验。上游 Valibot 表单校验、编辑回填并保留 id/createdAt 的行为可复用；差异是把“1-5 个标签必填”改为“选择或新建一个归类”，描述字段按场景需要保留为可选。\"\n319:    },\n320:    {\n321:     \"capability\": \"用单一“归类”字段取代多标签：每条记录只归属一个归类，侧栏按归类聚合条目数并支持按归类筛选浏览。\",\n322:     \"disposition\": \"adjusted\",\n323:     \"evidence_ids\": [\n324:      \"ev_ba200adf6e2c_9c7f6060878383fa\",\n325:      \"ev_ba200adf6e2c_9ab6b0e51811a16d\",\n326:      \"ev_ba200adf6e2c_c4ad7e52e5713628\"\n327:     ],\n328:     \"reason\": \"场景明确“保存时选择一个简单归类”，是单归属分类而非多标签。上游是扁平 tags[] + 标签侧栏 + 计数 + 多标签交集筛选，需要把多值匹配改造为单选归属；计数与侧栏交互逻辑沿用，语义由“标签出现次数”变为“每归类条目数”。\"\n329:    },\n330:    {\n331:     \"capability\": \"默认归类：未选择归类即保存的链接自动落入“未整理”默认归类，之后可被手动移动。\",\n332:     \"disposition\": \"new_design\",\n333:     \"evidence_ids\": [],\n334:     \"reason\": \"场景流程第3步“未经整理的链接可先进入默认归类，之后再手动移动到更合适的位置”是上游完全没有的概念——上游只有 Home/Archived 两个视图，没有默认桶。快速保存不打断浏览依赖这一设计，属场景新增。\"\n335:    },\n336:    {\n337:     \"capability\": \"归类管理：用户可新建归类（如“待购”“家居改造”“以后看看”），并把记录从一个归类移动到另一个归类，移动结果持久化。\",\n338:     \"disposition\": \"new_design\",\n339:     \"evidence_ids\": [],\n340:     \"reason\": \"场景验收第3条要求“在归类之间移动记录或新建归类，操作结果在重新打开后仍然有效”。上游明确没有 collections/folders，也不持久化任何视图状态，因此新建归类与移动归类必须新设计并落库。\"\n341:    },\n342:    {\n343:     \"capability\": \"归类浏览与关键字检索：先按归类列出，再在结果内用关键字匹配标题与域名（必要时含描述），默认按最近保存倒序。\",\n344:     \"disposition\": \"adjusted\",\n345:     \"evidence_ids\": [\n346:      \"ev_ba200adf6e2c_9ab6b0e51811a16d\",\n347:      \"ev_ba200adf6e2c_c4ad7e52e5713628\"\n348:     ],\n349:     \"reason\": \"场景验收第4条要求“通过归类浏览或关键字检索找到此前存入的特定链接”。上游检索只匹配 title.toLowerCase() 且带 pinned-first 排序，多值标签筛选也需并入归类。差异是扩大匹配字段到 hostname/描述，以覆盖“只记得是哪个网站”的找回场景。\"\n350:    },\n351:    {\n352:     \"capability\": \"首次使用的起始归类集合：预置“待购”“家居改造”“以后看看”与默认“未整理”，用户可在此基础上增删。\",\n353:     \"disposition\": \"adjusted\",\n354:     \"evidence_ids\": [\n355:      \"ev_ba200adf6e2c_05babdea64ba9858\"\n356:     ],\n357:     \"reason\": \"场景把这三类作为保存时的直接选项，属场景语境的默认数据。上游新建记录只写入 id/hostname/时间等默认字段，没有任何预置分类。这里借用其“新记录写入默认字段”的初始化思路，把预置归类作为应用初始数据而非记录字段。\"\n358:    },\n359:    {\n360:     \"capability\": \"删除收藏并支持短时撤销：删除任意记录并弹出带“撤销”的操作提示，点击撤销即恢复。\",\n361:     \"disposition\": \"adjusted\",\n362:     \"evidence_ids\": [\n363:      \"ev_ba200adf6e2c_4c56ef30a1785be1\"\n364:     ],\n365:     \"reason\": \"上游删除仅对归档项开放且配 5 秒 Undo 恢复。场景没有归档，用户会想直接清理误存链接。保留“删除 + 撤销恢复”的错误兜底机制，去掉“仅归档可删”的前置限制。\"\n366:    },\n367:    {\n368:     \"capability\": \"不做置顶/归档：不引入 isPinned/isArchived，也不让编辑、删除出现“仅归档项可用”的分支。\",\n369:     \"disposition\": \"not_adopted\",\n370:     \"evidence_ids\": [\n371:      \"ev_ba200adf6e2c_b1ca64cf2ad02998\",\n372:      \"ev_ba200adf6e2c_06c81a165e03c96a\"\n373:     ],\n374:     \"reason\": \"场景是“先留存、稍后再处理”的收藏箱，没有归档-清空的工作流，置顶也不解决“待购/灵感”的浏览诉求；保留归档反而给编辑与删除加额外前置条件，与快速保存、快速清理相冲突。\"\n375:    },\n376:    {\n377:     \"capability\": \"图标与元数据的轻量获取：保存时优先由域名派生 favicon 本地显示，第三方元数据（标题/描述/封面）仅作可选增强，失败静默降级。\",\n378:     \"disposition\": \"adjusted\",\n379:     \"evidence_ids\": [\n380:      \"ev_ba200adf6e2c_8e11efc61a4650ba\",\n381:      \"ev_ba200adf6e2c_ec303a2fd1afa287\",\n382:      \"ev_ba200adf6e2c_5011700a24e503c7\"\n383:     ],\n384:     \"reason\": \"场景希望能一眼辨认“商品页/教程/灵感图”，但上游依赖 api.microlink.io、images.weserv.nl、Google s2 三个未经运行验证的第三方端点，失败只 console.error。差异是把可用性依赖降为本地域名派生，把外部抓取降级为增强，避免保存流程被第三方可达性阻塞。\"\n385:    },\n386:    {\n387:     \"capability\": \"不做多排序模式与置顶优先：只保留“最近保存”倒序一种默认顺序。\",\n388:     \"disposition\": \"not_adopted\",\n389:     \"evidence_ids\": [\n390:      \"ev_ba200adf6e2c_9ab6b0e51811a16d\"\n391:     ],\n392:     \"reason\": \"场景关注“找到此前存下的东西”，不涉及按访问次数排序或置顶。上游三种排序（最近添加/最近访问/访问最多）+ pinned-first 属书签阅读器语境，对收藏箱是冗余操作面。\"\n393:    },\n394:    {\n395:     \"capability\": \"不做“复制 URL”动作：收藏箱的目标是回到原页而非分发链接。\",\n396:     \"disposition\": \"not_adopted\",\n397:     \"evidence_ids\": [\n398:      \"ev_ba200adf6e2c_7150b0ac7a5678db\"\n399:     ],\n400:     \"reason\": \"上游 Copy URL 面向分享或复用链接；本场景流程终点是“从记录打开链接，回到原始网页继续购买、阅读或参考”，复制并非必需，去掉可减少每条记录的操作噪音。\"\n401:    },\n402:    {\n403:     \"capability\": \"单页应用外壳：index.html 提供 #root，入口模块挂载应用并在根节点缺失时报错。\",\n404:     \"disposition\": \"adopted\",\n405:     \"evidence_ids\": [\n406:      \"ev_ba200adf6e2c_5d51c18a989c01f8\",\n407:      \"ev_ba200adf6e2c_a2ebc864c5b6b3e7\"\n408:     ],\n409:     \"reason\": \"场景是纯个人本地工具、无服务端需求，上游 SPA 挂载方式与本地优先定位一致，可直接沿用为运行外壳。差异仅在挂载的组件内部替换为收藏箱视图，属于结构性沿用。\"\n410:    },\n411:    {\n412:     \"capability\": \"浏览视图状态（当前选中归类、搜索词）仅保留在会话内存中，不写入本地库。\",\n413:     \"disposition\": \"adopted\",\n414:     \"evidence_ids\": [\n415:      \"ev_ba200adf6e2c_2288b28e90cd8450\"\n416:     ],\n417:     \"reason\": \"场景只要求“归类归属与移动结果在重开后仍然有效”，并未要求记住上次浏览位置。上游把 tab/标签筛选/排序/搜索放在组件本地状态而不落库，恰好划出“数据持久、视图不持久”的边界，避免浏览状态污染收藏数据。\"\n418:    }\n419:   ],\n420:   \"case_design_after\": [\n421:    {\n422:     \"capability\": \"F08: a single-user personal library persisted in SQLite that survives browser sessions and server restarts, with records queried from the database for every request rather than held in a browser store.\",\n423:     \"disposition\": \"adjusted\",\n424:     \"evidence_ids\": [\n425:      \"ev_ba200adf6e2c_35e41aab676021eb\",\n426:      \"ev_ba200adf6e2c_86ed2327f33a3ca8\",\n427:      \"ev_ba200adf6e2c_922f1dbc84912d99\",\n428:      \"ev_ba200adf6e2c_e7dd8d32c05c39f9\"\n429:     ],\n430:     \"reason\": \"The evidence shows Dexie writes on save/delete and a one-time db.bookmarks.toArray() hydration into an in-memory RippleMap, scoped to one browser profile with no sync. The target adopts local, single-user, cross-session retention but replaces IndexedDB/Dexie and in-memory hydration with SQLite on the Python server; it does not claim browser-profile persistence, multi-device sync, or the source map as target design.\"\n431:    },\n432:    {\n433:     \"capability\": \"F11: the library is delivered as Python server-rendered HTML pages and forms using POST/redirect/GET for saving records, managing categories, moving records between categories, and soft-delete/restore, including a ready empty-library view. P0 has no standalone record-editing page; record URL updates retain only the existing PATCH /api/bookmarks/{id} contract.\",\n434:     \"disposition\": \"adjusted\",\n435:     \"evidence_ids\": [\n436:      \"ev_ba200adf6e2c_06c81a165e03c96a\",\n437:      \"ev_ba200adf6e2c_86ed2327f33a3ca8\",\n438:      \"ev_ba200adf6e2c_e7dd8d32c05c39f9\"\n439:     ],\n440:     \"reason\": \"The evidence describes a client-mounted SPA: Edit is an in-page dialog populated from item fields, and component creation loads Dexie rows into a client RippleMap. The target implements the already-declared P0 save, category-management, move and soft-delete/restore journeys as Python 3.12 HTML responses. Source SPA mounting, client-side dialog state and Dexie hydration are not carried over. The source Edit dialog does not imply a target record-editing UI; the existing PATCH API retains URL updates and recomputes hostname when the URL changes. The save-now/find-later loop and ready empty state remain the target intent.\"\n441:    },\n442:    {\n443:     \"capability\": \"A deliberate save creates a URL-anchored record with a stable id, a locally derived hostname, creation time and initial active state. Later changes preserve the record id and creation time; updating the URL recomputes hostname from the new URL. The adopted capability is this identity and creation lifecycle; visitCount and visitedAt are not target fields or P0 obligations.\",\n444:     \"disposition\": \"adopted\",\n445:     \"evidence_ids\": [\n446:      \"ev_ba200adf6e2c_05babdea64ba9858\"\n447:     ],\n448:     \"reason\": \"The accepted observation records the source's bm-prefixed UUID identity, hostname derivation, createdAt, initial flags and visit fields, and preservation of identity and creation/visit fields on edit. These remain source observations. The target adopts stable record identity and creation time, represented by its existing id/created_at model and made durable by SQLite; it does not import the source's visitCount/visitedAt fields, which F24 excludes. URL updates follow the existing PATCH contract and derive hostname again. The source's tag constraints and other state fields are not silently imported into the category or target data model.\"\n449:    },\n450:    {\n451:     \"capability\": \"URL validation accepts only absolute, parseable HTTP(S) URLs with a nonempty valid hostname, allows single-label hosts such as http://localhost, preserves the original URL text, and rejects malformed, non-HTTP(S) or empty-host input without writing; no DNS or online-reachability check is performed.\",\n452:     \"disposition\": \"adjusted\",\n453:     \"evidence_ids\": [\n454:      \"ev_ba200adf6e2c_1596da4a90687ca5\"\n455:     ],\n456:     \"reason\": \"The upstream Valibot rule is a dotted-host regex that requires a dot-separated domain and an alphabetic top-level suffix, so it rejects localhost. That regex is retained as a source fact and mapped as adjusted, not reused as the target rule: the target parses the URL, checks the http/https scheme, absolute form and hostname presence, permits single-label hosts, and stores the entered string unchanged.\"\n457:    },\n458:    {\n459:     \"capability\": \"Create, rename and delete named categories with validation and with protection or reassignment when a category still contains records, assign one at save time, move records between categories, and default uncategorized saves into an Inbox category.\",\n460:     \"disposition\": \"new_design\",\n461:     \"evidence_ids\": [\n462:      \"ev_ba200adf6e2c_3168bcd465b6a043\",\n463:      \"ev_ba200adf6e2c_6bbd7a588896fe31\"\n464:     ],\n465:     \"reason\": \"Evidence shows the source has no category entity: classification is only up to five free-text tags, there is no collection CRUD or separate move, and the form rejects saves with zero tags. The target therefore designs first-class categories, an inbox default for unclassified capture and an explicit move action; these are new target concepts, not source-derived tag behavior.\"\n466:    },\n467:    {\n468:     \"capability\": \"Browse one category and see only its active records, with a category count that agrees with the listed records after adds, moves and restores.\",\n469:     \"disposition\": \"adjusted\",\n470:     \"evidence_ids\": [\n471:      \"ev_ba200adf6e2c_c4ad7e52e5713628\",\n472:      \"ev_ba200adf6e2c_9ab6b0e51811a16d\"\n473:     ],\n474:     \"reason\": \"Source facts derive tag counts by scanning all in-memory bookmarks and filter records by requiring every selected tag. The target computes category counts and category-scoped lists in SQL over active, non-deleted rows so the count and the list stay consistent; the source tag-sidebar algorithm is not the target implementation.\"\n475:    },\n476:    {\n477:     \"capability\": \"Search the selected category by keyword across title, hostname and description using case-insensitive substring matching, retaining category and query and rendering matching or explicit empty results.\",\n478:     \"disposition\": \"adjusted\",\n479:     \"evidence_ids\": [\n480:      \"ev_ba200adf6e2c_9ab6b0e51811a16d\",\n481:      \"ev_ba200adf6e2c_e62ae7e0a2c68ba1\"\n482:     ],\n483:     \"reason\": \"Source search lowercases and compares only bookmark.title; the fixed target F06/A07 contract adjusts it to title, derived hostname and description, combined with the selected category. Raw URL text, category names and tags are not additional keyword fields. This clarifies target design only; accepted observations, evidence IDs, source revision and disposition remain unchanged.\"\n484:    },\n485:    {\n486:     \"capability\": \"Open a saved record as a navigation to its stored original URL, preserving the URL text and never fetching, proxying or prefetching the destination during save, listing or open preparation.\",\n487:     \"disposition\": \"adjusted\",\n488:     \"evidence_ids\": [\n489:      \"ev_ba200adf6e2c_93ff254508846f11\"\n490:     ],\n491:     \"reason\": \"Source opens the URL with window.open(url, '_blank', 'noopener,noreferrer') after updating visit state. The target renders the record URL as an ordinary HTTP(S) link or server redirect with the same new-tab/no-referrer intent; opening is a user navigation distinct from saving, and the Python server does not request the target page.\"\n492:    },\n493:    {\n494:     \"capability\": \"Do not enrich saved records with third-party metadata or favicon services and do not prefetch saved target pages; stored title, description and URL come from the user or local derivation.\",\n495:     \"disposition\": \"not_adopted\",\n496:     \"evidence_ids\": [\n497:      \"ev_ba200adf6e2c_7d47d725a2e9b759\",\n498:      \"ev_ba200adf6e2c_8e11efc61a4650ba\",\n499:      \"ev_ba200adf6e2c_ec303a2fd1afa287\"\n500:     ],\n501:     \"reason\": \"The source calls api.microlink.io and images.weserv.nl/Google s2 favicons on save and treats failures as silent. The target P0 deliberately omits these outbound calls because saving and opening must remain distinct from fetching; no target-page response, metadata or icon is retrieved, and no source enrichment behavior is presented as target design.\"\n502:    },\n503:    {\n504:     \"capability\": \"Soft-delete an active record into a recoverable trash and restore it later, instead of allowing deletion only on archived items with a transient toast undo.\",\n505:     \"disposition\": \"adjusted\",\n506:     \"evidence_ids\": [\n507:      \"ev_ba200adf6e2c_4c56ef30a1785be1\",\n508:      \"ev_ba200adf6e2c_93ef917a193a45ab\"\n509:     ],\n510:     \"reason\": \"Source facts limit Delete to archived items and provide recovery only through an Undo action on the toast, with no trash view and no deletion path for active records. The target uses an explicit soft-delete/restore lifecycle exposed in HTML so records remain recoverable; this changes the source's archived-only and transient-recovery model.\"\n511:    }\n512:   ],\n513:   \"case_adaptation_revision\": \"case-adaptation-prepared-0b627399d035068e\",\n514:   \"case_adaptation_input\": {\n515:    \"case_basis_digest\": \"a22ff1c065d27aecb0cee21dc6b597f5607375bc8ebc297a3451e708f4da5589\",\n516:    \"mode\": \"host-exact-r7-target-adaptation\",\n517:    \"prior_checkpoint_digest\": \"b49f90a92a4830354af2946a83ab56dcc4f5539f5c085a3c862902f067d253c2\",\n518:    \"scenario\": {\n519:     \"acceptance\": [\n520:      \"用户主动保存的链接在多次会话之间持久保留，形成不断增长的个人收藏\",\n521:      \"每条记录都以 URL 锚定到外部网页，打开记录即跳转到该页面\",\n522:      \"用户可以在归类之间移动记录或新建归类，操作结果在重新打开后仍然有效\",\n523:      \"通过归类浏览或关键字检索，用户能找到此前存入的特定链接\"\n524:     ],\n525:     \"audience\": \"习惯先把感兴趣的网页存起来、之后再回头处理的普通网络用户\",\n526:     \"id\": \"scn_7756e0007f6a463a97316f3f49c15248\",\n527:     \"leaf\": \"bookmark-manager\",\n528:     \"leaf_name\": \"书签管理器\",\n529:     \"name\": \"生活待购与灵感收藏夹\",\n530:     \"objective\": \"把偶然看到但当下不处理的外部网页链接留存，日后需要时能重新找到并回到原页面\",\n531:     \"revision\": 2,\n532:     \"status\": \"ready\",\n533:     \"updated_at\": \"2026-10-16T14:18:20.407897+00:00\",\n534:     \"workflow\": [\n535:      \"用户在浏览时看到想记住的商品页、教程或灵感图片，主动保存该链接\",\n536:      \"保存时选择一个简单归类，如“待购”“家居改造”或“以后看看”\",\n537:      \"未经整理的链接可先进入默认归类，之后再手动移动到更合适的位置\",\n538:      \"用户在需要实际处理时打开个人库，浏览或检索相关归类\",\n539:      \"用户从记录打开链接，回到原始网页继续购买、阅读或参考\"\n540:     ]\n541:    },\n542:    \"scenario_policy\": {\n543:     \"schema\": \"atlas.scenario-policy.bookmarks.v1\",\n544:     \"revision\": \"CP-1\",\n545:     \"scenario_id\": \"scn_7756e0007f6a463a97316f3f49c15248\",\n546:     \"product_id\": \"product-c42848f63251507bd9d911a5\",\n547:     \"category_contract\": {\n548:      \"management\": {\n549:       \"acceptance_id\": \"A04\",\n550:       \"operations\": [\n551:        \"category_create\",\n552:        \"category_rename\"\n553:       ],\n554:       \"input_field\": \"name\",\n555:       \"existing_category_identity_field\": \"category_id\",\n556:       \"html_invalid_values\": [\n557:        \"omitted\",\n558:        \"empty\",\n559:        \"whitespace_only\",\n560:        \"121_characters\"\n561:       ],\n562:       \"json_invalid_values\": [\n563:        \"omitted\",\n564:        \"empty\",\n565:        \"whitespace_only\",\n566:        \"121_characters\",\n567:        \"null\"\n568:       ],\n569:       \"invalid_result\": {\n570:        \"status\": 400,\n571:        \"code\": \"invalid_name\"\n572:       },\n573:       \"html_failure\": \"Show form-error, retain submitted values, and make no writes.\",\n574:       \"json_failure\": \"Return invalid_name and make no writes.\"\n575:      },\n576:      \"bookmark_save\": {\n577:       \"acceptance_id\": \"A12\",\n578:       \"json_field\": \"category\",\n579:       \"html_field\": \"category\",\n580:       \"field_semantics\": \"Category NAME, never category ID.\",\n581:       \"omitted_or_null_json\": \"Use the default category.\",\n582:       \"html_null\": \"HTML forms have no native null value.\",\n583:       \"invalid_values\": [\n584:        \"empty\",\n585:        \"whitespace_only\",\n586:        \"121_characters\"\n587:       ],\n588:       \"invalid_result\": {\n589:        \"status\": 400,\n590:        \"code\": \"invalid_category\"\n591:       },\n592:       \"html_failure\": \"Show form-error, retain submitted values, and make no writes.\",\n593:       \"valid_new_name\": \"Automatically create and use the named category.\"\n594:      },\n595:      \"bookmark_move\": {\n596:       \"acceptance_id\": \"A12\",\n597:       \"json_field\": \"category\",\n598:       \"json_semantics\": \"Category NAME, never category ID.\",\n599:       \"invalid_json_values\": [\n600:        \"omitted\",\n601:        \"JSON null\",\n602:        \"empty\",\n603:        \"whitespace_only\",\n604:        \"121_characters\"\n605:       ],\n606:       \"html_field\": \"category_id\",\n607:       \"html_semantics\": \"Resolve the submitted ID to an existing category name.\",\n608:       \"invalid_html_values\": [\n609:        \"omitted\",\n610:        \"empty\",\n611:        \"unknown_id\"\n612:       ],\n613:       \"invalid_result\": {\n614:        \"status\": 400,\n615:        \"code\": \"invalid_category\"\n616:       },\n617:       \"html_failure\": \"Show form-error, retain submitted values, and make no writes.\",\n618:       \"valid_new_json_name\": \"Automatically create and use the named category.\",\n619:       \"never_create_from_html_id\": true\n620:      },\n621:      \"unknown_get_filter\": \"Return an empty result; do not treat an unknown category filter as an error.\"\n622:     },\n623:     \"search_contract\": \"Search is a case-insensitive substring over title, hostname, and description, with optional category filtering applied together. Search does not match tags or raw URL substrings.\",\n624:     \"url_policy\": {\n625:      \"schemes\": [\n626:       \"http\",\n627:       \"https\"\n628:      ],\n629:      \"absolute\": true,\n630:      \"nonempty_valid_hostname\": true,\n631:      \"single_label_hosts\": true,\n632:      \"dns_required\": false,\n633:      \"preserve_original_text\": true,\n634:      \"p0_fetch\": false\n635:     },\n636:     \"authorized_assertion_adaptation\": \"A02 may replace only its single-label-hostname rejection example with a positive example; missing scheme, unsupported scheme, empty hostname, and invalid hostname must remain rejected without writing.\",\n637:     \"adaptation\": \"The source IndexedDB/Dexie and SPA are source facts. Adapt persistence and rendering to the declared target profile; do not turn source facts into target requirements. Preserve the exact A04 category-management and A12 bookmark save/move contracts above, plus the title/hostname/description search contract.\"\n638:    }\n639:   },\n640:   \"authored_fields_before\": {\n641:    \"phases\": [\n642:     {\n643:      \"acceptance\": [\n644:       \"A01\",\n645:       \"A02\",\n646:       \"A03\",\n647:       \"A04\",\n648:       \"A05\",\n649:       \"A06\",\n650:       \"A07\",\n651:       \"A08\",\n652:       \"A09\",\n653:       \"A10\",\n654:       \"A11\",\n655:       \"A12\"\n656:      ],\n657:      \"features\": [\n658:       \"F01\",\n659:       \"F02\",\n660:       \"F03\",\n661:       \"F04\",\n662:       \"F05\",\n663:       \"F06\",\n664:       \"F07\",\n665:       \"F08\",\n666:       \"F09\",\n667:       \"F10\",\n668:       \"F11\"\n669:      ],\n670:      \"goal\": \"用户可保存链接（可选归类或落入未整理）、按归类或关键字找回、打开原页、清理并撤销，且全部数据跨会话与重启保留，非法输入得到可恢复的明确错误。\",\n671:      \"id\": \"P0\",\n672:      \"status\": \"not implemented\",\n673:      \"title\": \"个人收藏箱核心旅程\"\n674:     },\n675:     {\n676:      \"acceptance\": [\n677:       \"A13\",\n678:       \"A14\",\n679:       \"A15\"\n680:      ],\n681:      \"features\": [\n682:       \"F12\",\n683:       \"F13\",\n684:       \"F14\"\n685:      ],\n686:      \"goal\": \"在离线可用的前提下增强记录可辨识度（本地派生图标、外部抓取仅作增强），并支持浏览器书签格式的导入导出与重复链接检测，用于长期库维护。\",\n687:      \"id\": \"P1\",\n688:      \"status\": \"not implemented\",\n689:      \"title\": \"成熟增强：元数据、互操作与库清理\"\n690:     }\n691:    ],\n692:    \"architecture_markdown\": \"## 默认技术栈与理由\\n\\n- **交付 profile：python-web。** 运行时为 Python 3.12 标准库（`http.server`、`sqlite3`、`urllib`、`json`、`html.parser`），零第三方依赖，满足 V1 指定的离线标准库约束。\\n- 备选方案（Flask/FastAPI、Node + IndexedDB）生态更丰富，但需要安装依赖或 npm/Playwright，与离线、可独立验收的要求冲突，故不采用。\\n- 前端为服务端渲染的少量 HTML 加原生 JS 渐进增强，无构建步骤；数据存取集中在服务层，HTML 表单与 JSON API 都是同一服务层的薄适配器。\\n- 理由：场景是单用户本地收藏箱，数据量小、访问单机，标准库加 SQLite 单文件即可覆盖持久化、检索、打开回跳与离线验收。\\n\\n## 数据模型（SQLite，文件位于应用 `--data-dir/bookmarks.sqlite3`；验收时为每实例隔离子目录，绝不是测试者 data_dir 根目录）\\n\\n- `schema_meta(version INTEGER)`：迁移版本。\\n- `categories(id TEXT PK, name TEXT NOT NULL UNIQUE COLLATE NOCASE, is_default INTEGER NOT NULL DEFAULT 0, position INTEGER NOT NULL, created_at INTEGER NOT NULL)`：首启预置「未整理」(is_default=1)、「待购」、「家居改造」、「以后看看」。\\n- `bookmarks(id TEXT PK, url TEXT NOT NULL, hostname TEXT NOT NULL, title TEXT NULL, description TEXT NULL, category_id TEXT NOT NULL REFERENCES categories(id), favicon_url TEXT NULL, created_at INTEGER NOT NULL, updated_at INTEGER NOT NULL, trashed_at INTEGER NULL)`。\\n- 索引：`category_id`、`created_at`、`hostname`；不建立 `url` 唯一索引。重复 URL 的 409 判定（属 P1/F14）由服务层查询活动记录完成，`allow_duplicate=true` 时绕过；软删除记录不参与判定。\\n- 迁移：首次启动在单一事务内建表并写入预置归类；后续按技术决策 D12 演进版本。\\n\\n## API 与错误合同（JSON）\\n\\n- `GET /api/health` 返回 200 就绪信息与 schema 版本。\\n- `GET /api/categories` 返回归类数组，每项含 id、name、count、is_default。\\n- `POST /api/categories`（body: name）返回 201；重名 409 `duplicate_category`；空名或超过 120 字符 400 `invalid_name`。\\n- `PATCH /api/categories/{id}` 重命名，空名或超过 120 字符 400 `invalid_name`，与既有归类重名 409 `duplicate_category`，默认归类不可重命名（400 `protected_category`）；`DELETE /api/categories/{id}` 在事务内按 is_default 把其记录迁回默认归类，默认归类不可删（400 `protected_category`）。\\n- `GET /api/bookmarks?category=<name|id>&q=<str>&include_trashed=0` 返回记录数组（默认按 created_at 倒序，同值以 id 兜底）；`q` 对标题、hostname 与描述做大小写不敏感子串匹配，并与 category 叠加；未知归类过滤返回空集。\\n- `POST /api/bookmarks`（body: url 必填；title、description、category 可选；allow_duplicate 可选）返回 201；category 省略或为 null 时归入默认「未整理」，给出新名称时按 NOCASE 自动创建并复用既有归类，显式空字符串或超过 120 字符 4... (line truncated to 2000 chars)\n693:    \"roles\": [\n694:     {\n695:      \"id\": \"R01\",\n696:      \"name\": \"收藏者（个人用户）\",\n697:      \"responsibility\": \"在浏览时主动保存外部网页链接，选择或新建简单归类、把未整理的链接移动到合适归类、按归类或关键字找回、打开记录回到原页，并清理误存条目。\"\n698:     },\n699:     {\n700:      \"id\": \"R02\",\n701:      \"name\": \"本地收藏应用（服务端与页面外壳）\",\n702:      \"responsibility\": \"校验录入、派生域名、持久化收藏与归类、提供保存/浏览/检索/打开/恢复接口，并在离线条件下保持可用。\"\n703:     },\n704:     {\n705:      \"id\": \"R03\",\n706:      \"name\": \"独立验收执行者\",\n707:      \"responsibility\": \"以 URL 与 CLI 参数驱动真实目标，执行正负向行为断言、重启持久化验证与错误恢复验证，不修改应用、不自报运行结果。\"\n708:     }\n709:    ],\n710:    \"title\": \"生活待购与灵感收藏夹\",\n711:    \"limits\": [\n712:     \"不实现云同步、多用户共享或托管部署（D11、F16、F21）。\",\n713:     \"不保存网页快照、不做正文全文检索、不做失效链接检测（F17、F18、D13）。\",\n714:     \"不引入置顶/归档、多排序模式、复制 URL 与访问计数（F20、F23、F24）。\",\n715:     \"归类为扁平单选，不支持嵌套层级或多标签并存（F19、D01）。\",\n716:     \"第三方元数据与图标抓取未验证可达性，仅作可选增强且失败静默降级（F12、D05）。\",\n717:     \"验收不携带认证凭据；若目标要求认证，验收必须显式报告基础设施未就绪而非跳过或通过（D09）。\",\n718:     \"不设置未经验证的性能或成本目标。\"\n719:    ],\n720:    \"features\": [\n721:     {\n722:      \"acceptance\": [\n723:       \"A01\",\n724:       \"A02\",\n725:       \"A03\"\n726:      ],\n727:      \"applicability\": \"current required\",\n728:      \"id\": \"F01\",\n729:      \"name\": \"保存收藏（URL 必填，标题/描述可选）\",\n730:      \"phase\": \"P0\",\n731:      \"reason\": \"场景流程第1-2步要求看到想记住的页面即主动保存；上游记录了新记录默认字段与保存落盘（S02、S06），并把 URL 校验与编辑回填收敛在表单（S04）。\",\n732:      \"sources\": [\n733:       \"S02\",\n734:       \"S04\",\n735:       \"S06\",\n736:       \"S17\"\n737:      ]\n738:     },\n739:     {\n740:      \"acceptance\": [\n741:       \"A03\"\n742:      ],\n743:      \"applicability\": \"current required\",\n744:      \"id\": \"F02\",\n745:      \"name\": \"默认“未整理”与预置归类集合\",\n746:      \"phase\": \"P0\",\n747:      \"reason\": \"场景流程第3步要求未整理的链接先进入默认归类；上游只有 Home/Archived 视图、无默认桶（S16），故按场景新增默认收件区，并借鉴其标签聚合思路（S20）。\",\n748:      \"sources\": [\n749:       \"S16\",\n750:       \"S20\"\n751:      ]\n752:     },\n753:     {\n754:      \"acceptance\": [\n755:       \"A04\"\n756:      ],\n757:      \"applicability\": \"current required\",\n758:      \"id\": \"F03\",\n759:      \"name\": \"归类管理（新建/重命名/删除）\",\n760:      \"phase\": \"P0\",\n761:      \"reason\": \"场景验收第3条要求可新建归类；上游明确没有 collections/folders（S16），因此归类实体与增删改必须新设计并落库。\",\n762:      \"sources\": [\n763:       \"S16\",\n764:       \"S20\"\n765:      ]\n766:     },\n767:     {\n768:      \"acceptance\": [\n769:       \"A05\",\n770:       \"A12\"\n771:      ],\n772:      \"applicability\": \"current required\",\n773:      \"id\": \"F04\",\n774:      \"name\": \"记录在归类间移动\",\n775:      \"phase\": \"P0\",\n776:      \"reason\": \"场景验收第3条要求记录可在归类之间移动且重开后仍有效；上游检索按标签交集筛选（S16），这里把多值交集改造为单一归属迁移。\",\n777:      \"sources\": [\n778:       \"S16\"\n779:      ]\n780:     },\n781:     {\n782:      \"acceptance\": [\n783:       \"A06\"\n784:      ],\n785:      \"applicability\": \"current required\",\n786:      \"id\": \"F05\",\n787:      \"name\": \"归类浏览与条目计数\",\n788:      \"phase\": \"P0\",\n789:      \"reason\": \"场景验收第4条要求通过归类浏览找回；上游侧栏按标签聚合计数（S20、S16），改为按归类聚合与筛选。\",\n790:      \"sources\": [\n791:       \"S16\",\n792:       \"S20\"\n793:      ]\n794:     },\n795:     {\n796:      \"acceptance\": [\n797:       \"A07\"\n798:      ],\n799:      \"applicability\": \"current required\",\n800:      \"id\": \"F06\",\n801:      \"name\": \"关键字检索（标题/域名/描述）\",\n802:      \"phase\": \"P0\",\n803:      \"reason\": \"场景验收第4条要求关键字检索；上游仅匹配标题小写（S16），需扩展到域名与描述以覆盖只记得来源的场景。\",\n804:      \"sources\": [\n805:       \"S16\"\n806:      ]\n807:     },\n808:     {\n809:      \"acceptance\": [\n810:       \"A08\"\n811:      ],\n812:      \"applicability\": \"current required\",\n813:      \"id\": \"F07\",\n814:      \"name\": \"打开原始网页（URL 锚定与回跳）\",\n815:      \"phase\": \"P0\",\n816:      \"reason\": \"场景验收第2条与流程第5步要求打开记录即回到原页；上游 Visit 以 window.open(noopener,noreferrer) 打开并由 URL 派生域名（S15、S08），保留打开与派生、去掉访问计数。\",\n817:      \"sources\": [\n818:       \"S15\",\n819:       \"S08\"\n820:      ]\n821:     },\n822:     {\n823:      \"acceptance\": [\n824:       \"A01\",\n825:       \"A05\",\n826:       \"A09\"\n827:      ],\n828:      \"applicability\": \"current required\",\n829:      \"id\": \"F08\",\n830:      \"name\": \"多会话持久化（跨重启保留）\",\n831:      \"phase\": \"P0\",\n832:      \"reason\": \"场景验收第1条要求多次会话之间持久保留；上游单表落盘并在启动时全量载入（S09、S13、S06），README 定位 local-first（S11），持久化机制沿用但记录结构增加归类字段。\",\n833:      \"sources\": [\n834:       \"S09\",\n835:       \"S13\",\n836:       \"S06\",\n837:       \"S11\"\n838:      ]\n839:     },\n840:     {\n841:      \"acceptance\": [\n842:       \"A09\"\n843:      ],\n844:      \"applicability\": \"current required\",\n845:      \"id\": \"F09\",\n846:      \"name\": \"删除与撤销恢复\",\n847:      \"phase\": \"P0\",\n848:      \"reason\": \"场景要求可恢复的失败；上游删除配 5 秒 Undo 恢复（S07），去掉“仅归档可删”前置限制，保留删除加恢复的兜底。\",\n849:      \"sources\": [\n850:       \"S07\"\n851:      ]\n852:     },\n853:     {\n854:      \"acceptance\": [\n855:       \"A02\",\n856:       \"A10\",\n857:       \"A12\"\n858:      ],\n859:      \"applicability\": \"current required\",\n860:      \"id\": \"F10\",\n861:      \"name\": \"输入校验与错误合同\",\n862:      \"phase\": \"P0\",\n863:      \"reason\": \"上游以 Valibot 约束 http/https、标题长度与标签数量（S04），并由 getHostname 派生域名（S08）；场景把标签必填改为可选归类，需要显式错误的保存与移动契约。\",\n864:      \"sources\": [\n865:       \"S04\",\n866:       \"S08\"\n867:      ]\n868:     },\n869:     {\n870:      \"acceptance\": [\n871:       \"A11\"\n872:      ],\n873:      \"applicability\": \"current required\",\n874:      \"id\": \"F11\",\n875:      \"name\": \"本地应用外壳与首启（空库）\",\n876:      \"phase\": \"P0\",\n877:      \"reason\": \"场景是纯个人本地工具、无服务端需求；上游 index.html 提供 #root 且入口挂载并在根缺失时报错（S10、S18），沿用为运行外壳。\",\n878:      \"sources\": [\n879:       \"S10\",\n880:       \"S18\"\n881:      ]\n882:     },\n883:     {\n884:      \"acceptance\": [\n885:       \"A13\"\n886:      ],\n887:      \"applicability\": \"later\",\n888:      \"id\": \"F12\",\n889:      \"name\": \"元数据与图标增强（离线降级）\",\n890:      \"phase\": \"P1\",\n891:      \"reason\": \"场景希望一眼辨认商品页/教程/灵感图，但上游依赖 api.microlink.io、images.weserv.nl 与 Google favicon 三个未验证端点且失败仅 console.error（S14、S21、S08）；因此把可用性依赖降为本地域名派生，外部抓取降级为可选增强。\",\n892:      \"sources\": [\n893:       \"S14\",\n894:       \"S21\",\n895:       \"S08\"\n896:      ]\n897:     },\n898:     {\n899:      \"acceptance\": [\n900:       \"A14\"\n901:      ],\n902:      \"applicability\": \"later\",\n903:      \"id\": \"F13\",\n904:      \"name\": \"导入/导出（浏览器书签 HTML）\",\n905:      \"phase\": \"P1\",\n906:      \"reason\": \"互操作是成熟产品的标准配置，但上游 manifest 没有导入/导出（S22 无测试脚本、无导入导出能力），属场景后期新增。\",\n907:      \"sources\": []\n908:     },\n909:     {\n910:      \"acceptance\": [\n911:       \"A15\"\n912:      ],\n913:      \"applicability\": \"later\",\n914:      \"id\": \"F14\",\n915:      \"name\": \"重复链接检测\",\n916:      \"phase\": \"P1\",\n917:      \"reason\": \"成熟产品趋向一址一记录，上游未实现去重（S16、S17 无重复处理）；P1 在保存与导入路径新增服务层重复检测（D06），P0 核心用例不依赖该能力。\",\n918:      \"sources\": []\n919:     },\n920:     {\n921:      \"acceptance\": [],\n922:      \"applicability\": \"not applicable\",\n923:      \"id\": \"F15\",\n924:      \"name\": \"浏览器扩展/分享目标抓取\",\n925:      \"phase\": null,\n926:      \"reason\": \"场景交付为本地 Web 工具，扩展与移动分享目标不在本期范围，手工录入与打开回跳已覆盖核心旅程。\",\n927:      \"sources\": []\n928:     },\n929:     {\n930:      \"acceptance\": [],\n931:      \"applicability\": \"not applicable\",\n932:      \"id\": \"F16\",\n933:      \"name\": \"多设备与云同步\",\n934:      \"phase\": null,\n935:      \"reason\": \"本期是单机单实例的本地库，数据在单一 SQLite 文件；跨设备同步属后期形态，不阻塞核心旅程。\",\n936:      \"sources\": []\n937:     },\n938:     {\n939:      \"acceptance\": [],\n940:      \"applicability\": \"decision needed\",\n941:      \"id\": \"F17\",\n942:      \"name\": \"网页留存副本/快照\",\n943:      \"phase\": null,\n944:      \"reason\": \"记录只保证引用而非内容（场景与原类型定义如此）；是否保存副本依赖外部抓取与存储，离线验收不可验证，需用户明确要求后再定。\",\n945:      \"sources\": []\n946:     },\n947:     {\n948:      \"acceptance\": [],\n949:      \"applicability\": \"decision needed\",\n950:      \"id\": \"F18\",\n951:      \"name\": \"失效链接检测与修复\",\n952:      \"phase\": null,\n953:      \"reason\": \"链接腐坏是本类型的结构性风险，但检测需要主动外呼，外部网络在验收中禁用；先保证引用与打开回跳，是否检测待用户决定。\",\n954:      \"sources\": []\n955:     },\n956:     {\n957:      \"acceptance\": [],\n958:      \"applicability\": \"decision needed\",\n959:      \"id\": \"F19\",\n960:      \"name\": \"嵌套归类与多标签并存\",\n961:      \"phase\": null,\n962:      \"reason\": \"场景明说“选择一个简单归类”，扁平单选加收件区已足够；嵌套/标签是成熟能力，待归类数量或交叉主题增长时再评估。\",\n963:      \"sources\": []\n964:     },\n965:     {\n966:      \"acceptance\": [],\n967:      \"applicability\": \"not applicable\",\n968:      \"id\": \"F20\",\n969:      \"name\": \"置顶/归档与多排序模式\",\n970:      \"phase\": null,\n971:      \"reason\": \"上游置顶与归档、三种排序属书签阅读器语境（S19、S16、S03），会给编辑与删除增加前置条件，与快速保存、快速清理相冲突，故不采用。\",\n972:      \"sources\": [\n973:       \"S19\",\n974:       \"S16\",\n975:       \"S03\"\n976:      ]\n977:     },\n978:     {\n979:      \"acceptance\": [],\n980:      \"applicability\": \"not applicable\",\n981:      \"id\": \"F21\",\n982:      \"name\": \"公开分享与协作库\",\n983:      \"phase\": null,\n984:      \"reason\": \"场景是私有个人收藏箱，分享不在核心旅程内；公开或协作需要多用户身份与权限，属不同类型定位。\",\n985:      \"sources\": []\n986:     },\n987:     {\n988:      \"acceptance\": [],\n989:      \"applicability\": \"not applicable\",\n990:      \"id\": \"F22\",\n991:      \"name\": \"阅读稍后与未读标记\",\n992:      \"phase\": null,\n993:      \"reason\": \"场景重心是留存引用并可回跳，而非消费队列；未读标记会使产品向 Read-it-later 漂移。\",\n994:      \"sources\": []\n995:     },\n996:     {\n997:      \"acceptance\": [],\n998:      \"applicability\": \"not applicable\",\n999:      \"id\": \"F23\",\n1000:      \"name\": \"复制 URL 动作\",\n1001:      \"phase\": null,\n1002:      \"reason\": \"上游提供 Copy URL（S12），但本场景终点是打开原页而非分发链接，去掉可减少每条记录的操作噪音。\",\n1003:      \"sources\": [\n1004:       \"S12\"\n1005:      ]\n1006:     },\n1007:     {\n1008:      \"acceptance\": [],\n1009:      \"applicability\": \"not applicable\",\n1010:      \"id\": \"F24\",\n1011:      \"name\": \"访问计数与最近访问时间\",\n1012:      \"phase\": null,\n1013:      \"reason\": \"上游 Visit 会累加 visitCount 与 visitedAt（S15、S17）；场景只需打开动作，不需访问统计，故不保留这两个字段。\",\n1014:      \"sources\": [\n1015:       \"S15\",\n1016:       \"S17\"\n1017:      ]\n1018:     }\n1019:    ],\n1020:    \"decisions\": [\n1021:     {\n1022:      \"default\": \"单选归类（bookmark.category_id 标量外键）。场景流程明确“选择一个简单归类”，单归属让移动、计数与浏览语义无歧义；未来若需多值可迁移到关联表而不丢数据。\",\n1023:      \"id\": \"D01\",\n1024:      \"impact\": \"决定数据模型（标量外键 vs 关联表）以及浏览、计数与检索的实现路径。\",\n1025:      \"question\": \"记录应归属于单一“归类”，还是允许像标签一样同时属于多个？\",\n1026:      \"status\": \"decided\",\n1027:      \"when_to_ask\": \"当真实用户反馈同一条记录必须同时属于多个主题，或需要跨主题交叉检索时再评估多标签。\"\n1028:     },\n1029:     {\n1030:      \"default\": \"落入默认“未整理”，保存始终成功。场景流程第3步要求未经整理的链接可先进入默认归类，快速保存不应打断浏览。\",\n1031:      \"id\": \"D02\",\n1032:      \"impact\": \"决定保存接口是否允许缺省 category，以及首启预置数据内容。\",\n1033:      \"question\": \"保存时不选归类，应阻止保存还是落入默认“未整理”？\",\n1034:      \"status\": \"decided\",\n1035:      \"when_to_ask\": \"当目标用户群要求强制归类（例如团队共享库）时再改为必选。\"\n1036:     },\n1037:     {\n1038:      \"default\": \"自动创建（名称大小写不敏感去重），重名则复用现有归类；保持保存流程不中断。\",\n1039:      \"id\": \"D03\",\n1040:      \"impact\": \"决定 categories 的唯一约束、写入事务边界与 409 的语义。\",\n1041:      \"question\": \"在保存或移动界面输入一个尚不存在的归类名，应自动创建还是报错？\",\n1042:      \"status\": \"decided\",\n1043:      \"when_to_ask\": \"当出现拼写错误导致归类碎片化的证据时，改为只允许从既有归类中选择。\"\n1044:     },\n1045:     {\n1046:      \"default\": \"软删除：记录标记 trashed_at，默认视图排除，提供撤销恢复；场景要求可恢复的失败。\",\n1047:      \"id\": \"D04\",\n1048:      \"impact\": \"决定数据模型的 trashed_at 列、列表过滤条件，以及 /restore 与 purge 接口。\",\n1049:      \"question\": \"删除是立即物理删除，还是软删除到可恢复区并支持短时撤销？\",\n1050:      \"status\": \"decided\",\n1051:      \"when_to_ask\": \"当用户要求彻底清除隐私数据或回收站增长需要释放空间时，再提供永久删除与清空。\"\n1052:     },\n1053:     {\n1054:      \"default\": \"本地优先：图标由域名派生本地路由，第三方元数据抓取为可选增强且失败静默降级，保证离线可保存。\",\n1055:      \"id\": \"D05\",\n1056:      \"impact\": \"决定保存流程的时延与可用性依赖，以及收藏响应中的 favicon/title 字段形态。\",\n1057:      \"question\": \"标题、描述与图标是否依赖第三方抓取服务？\",\n1058:      \"status\": \"decided\",\n1059:      \"when_to_ask\": \"当部署环境确认可访问外部服务且用户需要富预览时再启用增强。\"\n1060:     },\n1061:     {\n1062:      \"default\": \"自 P1/F14 起默认检测并返回 409 duplicate_url（附已有 id 供跳转查看），保存方显式 allow_duplicate 时可强制新增；P0 核心用例不依赖去重，软删除记录不参与判定；场景与成熟产品都倾向一址一记录。\",\n1063:      \"id\": \"D06\",\n1064:      \"impact\": \"决定服务层去重查询、allow_duplicate 语义与导入时的合并或跳过策略（不使用 url 唯一索引）。\",\n1065:      \"question\": \"同一 URL 再次保存时，阻止还是允许？\",\n1066:      \"status\": \"decided\",\n1067:      \"when_to_ask\": \"当用户明确需要对同一地址保留多个不同上下文的记录时再放宽。\"\n1068:     },\n1069:     {\n1070:      \"default\": \"标题加域名(hostname)加描述，大小写不敏感，可与归类过滤叠加；不检索正文（无抓取）。\",\n1071:      \"id\": \"D07\",\n1072:      \"impact\": \"决定查询实现与检索参数语义。\",\n1073:      \"question\": \"关键字应匹配哪些字段？\",\n1074:      \"status\": \"decided\",\n1075:      \"when_to_ask\": \"当需要按网页正文全文检索时再引入抓取与索引（属后期能力）。\"\n1076:     },\n1077:     {\n1078:      \"default\": \"python-web 加 Python 3.12 标准库 http.server 加单文件 SQLite；满足离线、单用户与可独立验收，无需外部依赖。\",\n1079:      \"id\": \"D08\",\n1080:      \"impact\": \"决定交付 profile、验收方式与部署命令形态。\",\n1081:      \"question\": \"采用何种运行时与持久化方式？\",\n1082:      \"status\": \"decided\",\n1083:      \"when_to_ask\": \"当需要多用户、并发写入或托管部署时再引入 Web 框架与服务端数据库。\"\n1084:     },\n1085:     {\n1086:      \"default\": \"默认无认证；交付进程在独立验收网络中监听测试者可路由的接口（`--host 0.0.0.0`），日常本机使用可绑定 127.0.0.1；不引入凭据文件，符合个人本地库的定位。\",\n1087:      \"id\": \"D09\",\n1088:      \"impact\": \"决定部署方式与验收的认证契约（验收默认不携带凭据）。\",\n1089:      \"question\": \"是否需要登录或口令？\",\n1090:      \"status\": \"decided\",\n1091:      \"when_to_ask\": \"当应用需要暴露到局域网或公网时，必须加入认证，否则只允许本机绑定。\"\n1092:     },\n1093:     {\n1094:      \"default\": \"Netscape 浏览器书签 HTML（本类型的交换约定），归类映射为文件夹或标签字段。\",\n1095:      \"id\": \"D10\",\n1096:      \"impact\": \"决定 P1 导入/导出的解析与生成实现。\",\n1097:      \"question\": \"导入/导出采用什么格式？\",\n1098:      \"status\": \"decided\",\n1099:      \"when_to_ask\": \"当需要与某个具体产品双向同步时再适配其专有格式。\"\n1100:     },\n1101:     {\n1102:      \"default\": \"P0 不做：本地单实例，数据在单一 SQLite 文件；跨设备属后期能力。\",\n1103:      \"id\": \"D11\",\n1104:      \"impact\": \"影响运行形态与数据归属，不阻塞 P0 核心旅程。\",\n1105:      \"question\": \"是否提供云同步或多用户共享？\",\n1106:      \"status\": \"deferred\",\n1107:      \"when_to_ask\": \"当用户明确需要在多设备访问同一库时再设计同步或托管。\"\n1108:     },\n1109:     {\n1110:      \"default\": \"P0 使用扁平单选归类加“未整理”收件区；嵌套与标签属成熟能力，按需在后期启用。\",\n1111:      \"id\": \"D12\",\n1112:      \"impact\": \"影响侧栏结构与检索实现，可后续迁移而不破坏现有数据。\",\n1113:      \"question\": \"归类是否需要嵌套层级，或与标签并存？\",\n1114:      \"status\": \"deferred\",\n1115:      \"when_to_ask\": \"当扁平归类数量增长到难以浏览，或需要交叉主题时。\"\n1116:     },\n1117:     {\n[Output truncated. Continue reading with offset: 1118]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"input.json\"}"},"time":{"start":1792484067253,"end":1792484067337}}}}
