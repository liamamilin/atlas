{"type":"tool_use","timestamp":1792484137346,"sessionID":"ses_ea79fcfd3ffeGu4Pan86lE7BF8","part":{"partID":"prt_1586158910013hqOqbG32EAwHB","sessionID":"ses_ea79fcfd3ffeGu4Pan86lE7BF8","messageID":"msg_158614847001bWlLgwE3GYhl1u","type":"tool","id":"call_cc10711d78334abb99922a2d","tool":"read","state":{"status":"completed","input":{"path":"source/baseline/acceptance/p0_find_open.py","limit":2000},"output":"Read file source/baseline/acceptance/p0_find_open.py, lines 1-268\n1: #!/usr/bin/env python3\n2: '''P0 行为验收组：关键字检索与打开原页。\n3: \n4: 覆盖 A07、A08。仅使用 Python 3.12 标准库并复用 acceptance/common.py：\n5: 以 --case 派发，未知用例显式失败；每个用例对真实目标执行正向与硬负向\n6: 行为断言，向 stdout 输出单个 atlas.acceptance-result.v1 JSON，失败时以\n7: 非零码退出。\n8: '''\n9: \n10: from __future__ import annotations\n11: \n12: import os\n13: import sys\n14: import uuid\n15: from urllib.parse import quote\n16: \n17: _THIS_DIR = os.path.dirname(os.path.abspath(__file__))\n18: if _THIS_DIR not in sys.path:\n19:     sys.path.insert(0, _THIS_DIR)\n20: \n21: import common\n22: \n23: \n24: def _unique_url(tag):\n25:     token = f'{tag}-{uuid.uuid4().hex[:12]}'\n26:     return f'https://{token}.atlas-acceptance.example/{token}'\n27: \n28: \n29: def _unique_category(tag):\n30:     return f'atlas-{tag}-{uuid.uuid4().hex[:10]}'\n31: \n32: \n33: def _safe_json(response):\n34:     try:\n35:         return response.json()\n36:     except Exception:\n37:         return None\n38: \n39: \n40: def _extract_record(payload):\n41:     if isinstance(payload, dict):\n42:         for key in ('bookmark', 'record', 'data', 'item'):\n43:             value = payload.get(key)\n44:             if isinstance(value, dict):\n45:                 return value\n46:         return payload\n47:     return None\n48: \n49: \n50: def _record_id(record):\n51:     if isinstance(record, dict) and record.get('id') is not None:\n52:         return str(record['id'])\n53:     return None\n54: \n55: \n56: def _record_url(record):\n57:     if isinstance(record, dict) and record.get('url') is not None:\n58:         return str(record['url'])\n59:     return None\n60: \n61: \n62: def _record_ids(records):\n63:     return {item_id for item_id in (_record_id(record) for record in records) if item_id}\n64: \n65: \n66: def _error_code(response):\n67:     payload = _safe_json(response)\n68:     if isinstance(payload, dict):\n69:         error = payload.get('error')\n70:         if isinstance(error, dict) and error.get('code') is not None:\n71:             return str(error['code'])\n72:         for key in ('code', 'error_code'):\n73:             if payload.get(key) is not None:\n74:                 return str(payload[key])\n75:     return None\n76: \n77: \n78: def _extract_list(payload, keys):\n79:     if isinstance(payload, list):\n80:         return payload\n81:     if isinstance(payload, dict):\n82:         for key in keys:\n83:             value = payload.get(key)\n84:             if isinstance(value, list):\n85:                 return value\n86:     return None\n87: \n88: \n89: def _bookmark_path(bookmark_id):\n90:     return '/api/bookmarks/' + quote(str(bookmark_id), safe='')\n91: \n92: \n93: def _go_path(bookmark_id):\n94:     return '/go/' + quote(str(bookmark_id), safe='')\n95: \n96: \n97: def _search(client, recorder, aid, params):\n98:     response = client.get('/api/bookmarks', params=params)\n99:     recorder.expect_status(response, 200, aid=f'{aid}-status')\n100:     payload = _safe_json(response)\n101:     records = _extract_list(payload, ('bookmarks', 'items', 'data', 'records'))\n102:     recorder.check(\n103:         f'{aid}-shape',\n104:         isinstance(records, list),\n105:         f'GET /api/bookmarks 必须返回 JSON 数组，实际 {type(payload).__name__}',\n106:     )\n107:     return records if isinstance(records, list) else []\n108: \n109: \n110: def _case_a07(args, recorder):\n111:     client = common.HttpClient(args.base_url)\n112:     try:\n113:         health = client.get('/api/health')\n114:         recorder.expect_status(health, 200, aid='a07-health-status')\n115: \n116:         cat_a = _unique_category('a07a')\n117:         cat_b = _unique_category('a07b')\n118:         shared = f'shared{uuid.uuid4().hex[:12]}'\n119:         host_token = f'host{uuid.uuid4().hex[:12]}'\n120:         desc_token = f'descr{uuid.uuid4().hex[:12]}'\n121:         unmatched = f'absent{uuid.uuid4().hex[:12]}'\n122: \n123:         url_a = f'https://{host_token}.atlas-acceptance.example/notes/{uuid.uuid4().hex[:10]}'\n124:         title_a = f'{shared} 收藏甲'\n125:         desc_a = f'备注 {desc_token}'\n126:         created_a = client.post_json(\n127:             '/api/bookmarks',\n128:             {'url': url_a, 'title': title_a, 'description': desc_a, 'category': cat_a},\n129:         )\n130:         recorder.expect_status(created_a, 201, aid='a07-create-a-status')\n131:         id_a = _record_id(_extract_record(_safe_json(created_a)))\n132:         recorder.check('a07-create-a-id', bool(id_a), f'创建记录甲返回 id={id_a!r}')\n133: \n134:         url_b = _unique_url('a07b')\n135:         title_b = f'{shared} 收藏乙'\n136:         created_b = client.post_json('/api/bookmarks', {'url': url_b, 'title': title_b, 'category': cat_b})\n137:         recorder.expect_status(created_b, 201, aid='a07-create-b-status')\n138:         id_b = _record_id(_extract_record(_safe_json(created_b)))\n139:         recorder.check('a07-create-b-id', bool(id_b), f'创建记录乙返回 id={id_b!r}')\n140: \n141:         if not (id_a and id_b):\n142:             return\n143: \n144:         by_title = _search(client, recorder, 'a07-title', {'q': shared})\n145:         title_ids = _record_ids(by_title)\n146:         recorder.check('a07-title-hit-a', id_a in title_ids, f'标题片段 {shared!r} 命中记录甲：{sorted(title_ids)}')\n147:         recorder.check('a07-title-hit-b', id_b in title_ids, f'标题片段 {shared!r} 命中记录乙：{sorted(title_ids)}')\n148: \n149:         upper_title = shared.upper()\n150:         by_title_upper = _search(client, recorder, 'a07-title-case', {'q': upper_title})\n151:         recorder.check(\n152:             'a07-title-case-insensitive',\n153:             id_a in _record_ids(by_title_upper),\n154:             f'大写标题片段 {upper_title!r} 命中记录甲（大小写不敏感）',\n155:         )\n156: \n157:         by_host = _search(client, recorder, 'a07-domain', {'q': host_token})\n158:         host_ids = _record_ids(by_host)\n159:         recorder.check('a07-domain-hit', id_a in host_ids, f'域名片段 {host_token!r} 命中记录甲：{sorted(host_ids)}')\n160:         recorder.check('a07-domain-excludes-b', id_b not in host_ids, '域名检索不命中域名不同的记录乙')\n161: \n162:         by_host_upper = _search(client, recorder, 'a07-domain-case', {'q': host_token.upper()})\n163:         recorder.check(\n164:             'a07-domain-case-insensitive',\n165:             id_a in _record_ids(by_host_upper),\n166:             f'大写域名片段 {host_token.upper()!r} 命中记录甲（大小写不敏感）',\n167:         )\n168: \n169:         by_desc = _search(client, recorder, 'a07-description', {'q': desc_token})\n170:         desc_ids = _record_ids(by_desc)\n171:         recorder.check('a07-description-hit', id_a in desc_ids, f'描述片段 {desc_token!r} 命中记录甲：{sorted(desc_ids)}')\n172:         recorder.check('a07-description-excludes-b', id_b not in desc_ids, '描述检索不命中无该描述的记录乙')\n173: \n174:         by_desc_upper = _search(client, recorder, 'a07-description-case', {'q': desc_token.upper()})\n175:         recorder.check(\n176:             'a07-description-case-insensitive',\n177:             id_a in _record_ids(by_desc_upper),\n178:             f'大写描述片段 {desc_token.upper()!r} 命中记录甲（大小写不敏感）',\n179:         )\n180: \n181:         combined_a = _search(client, recorder, 'a07-combined-a', {'category': cat_a, 'q': shared})\n182:         combined_a_ids = _record_ids(combined_a)\n183:         recorder.check('a07-combined-a-includes', id_a in combined_a_ids, f'category={cat_a!r} 与 q={shared!r} 叠加命中记录甲')\n184:         recorder.check('a07-combined-a-excludes-b', id_b not in combined_a_ids, f'category={cat_a!r} 叠加过滤排除属于 {cat_b!r} 的记录乙')\n185: \n186:         combined_b = _search(client, recorder, 'a07-combined-b', {'category': cat_b, 'q': shared})\n187:         combined_b_ids = _record_ids(combined_b)\n188:         recorder.check('a07-combined-b-includes', id_b in combined_b_ids, f'category={cat_b!r} 与 q={shared!r} 叠加命中记录乙')\n189:         recorder.check('a07-combined-b-excludes-a', id_a not in combined_b_ids, f'category={cat_b!r} 叠加过滤排除属于 {cat_a!r} 的记录甲')\n190: \n191:         empty = _search(client, recorder, 'a07-no-match', {'q': unmatched})\n192:         recorder.check('a07-no-match-empty', empty == [], f'无匹配关键字 {unmatched!r} 返回 200 空数组，实际 {len(empty)} 条')\n193:     finally:\n194:         client.close()\n195: \n196: \n197: def _case_a08(args, recorder):\n198:     client = common.HttpClient(args.base_url)\n199:     try:\n200:         health = client.get('/api/health')\n201:         recorder.expect_status(health, 200, aid='a08-health-status')\n202: \n203:         host_token = f'open{uuid.uuid4().hex[:12]}'\n204:         path_token = uuid.uuid4().hex[:12]\n205:         target_url = f'https://{host_token}.atlas-acceptance.example/page/{path_token}?src=atlas&n=7'\n206:         created = client.post_json('/api/bookmarks', {'url': target_url, 'title': 'A08 打开原页'})\n207:         recorder.expect_status(created, 201, aid='a08-create-status')\n208:         record_id = _record_id(_extract_record(_safe_json(created)))\n209:         recorder.check('a08-create-id', bool(record_id), f'创建记录返回 id={record_id!r}')\n210: \n211:         if record_id:\n212:             opened = client.get(_go_path(record_id), follow_redirects=False)\n213:             recorder.expect_status(opened, 302, aid='a08-open-status')\n214:             location = opened.location\n215:             recorder.check('a08-open-location-present', bool(location), f'302 响应携带 Location 头：{location!r}')\n216:             recorder.check(\n217:                 'a08-open-location',\n218:                 location == target_url,\n219:                 f'GET /go/{{id}} Location={location!r}（期望保存时 URL {target_url!r}）',\n220:             )\n221: \n222:         unknown = f'no-such-{uuid.uuid4().hex[:12]}'\n223:         missing = client.get(_go_path(unknown), follow_redirects=False)\n224:         recorder.expect_status(missing, 404, aid='a08-unknown-status')\n225:         code = _error_code(missing)\n226:         recorder.check('a08-unknown-code', code == 'not_found', f'未知 id 打开错误码={code!r}（期望 not_found）')\n227: \n228:         if record_id:\n229:             fetched = client.get(_bookmark_path(record_id))\n230:             recorder.expect_status(fetched, 200, aid='a08-readback-status')\n231:             stored = _extract_record(_safe_json(fetched))\n232:             recorder.check(\n233:                 'a08-url-unchanged',\n234:                 _record_url(stored) == target_url,\n235:                 f'打开动作后记录 url={_record_url(stored)!r}（未被改写，期望 {target_url!r}）',\n236:             )\n237:     finally:\n238:         client.close()\n239: \n240: \n241: _HANDLERS = {\n242:     'A07': _case_a07,\n243:     'A08': _case_a08,\n244: }\n245: \n246: \n247: def main(argv=None):\n248:     args = common.parse_case_args(argv)\n249:     recorder = common.Recorder(args.case)\n250:     handler = _HANDLERS.get(args.case)\n251:     if handler is None:\n252:         recorder.check(\n253:             'dispatch',\n254:             False,\n255:             f'acceptance/p0_find_open.py 不实现用例 {args.case}（应由其他程序派发）',\n256:         )\n257:     else:\n258:         try:\n259:             handler(args, recorder)\n260:         except common.AcceptanceError as exc:\n261:             recorder.check('infrastructure', False, f'验收基础设施错误：{exc}')\n262:         except Exception as exc:\n263:             recorder.check('unexpected-error', False, f'未预期错误：{type(exc).__name__}: {exc}')\n264:     return recorder.finish(args.case)\n265: \n266: \n267: if __name__ == '__main__':\n268:     sys.exit(main())","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"t