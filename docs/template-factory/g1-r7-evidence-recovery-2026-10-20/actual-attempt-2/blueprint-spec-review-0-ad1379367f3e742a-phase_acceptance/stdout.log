r_category(error_doc, 'category-rename-form', id_b)\n1193:             recorder.check(\n1194:                 f'a04-dup-rename-{label}-form',\n1195:                 error_form is not None,\n1196:                 f'重复 rename 错误页保留目标 category_id={id_b!r} 的表单',\n1197:             )\n1198:             if error_form is not None:\n1199:                 retained_name = error_form.value('name')\n1200:                 recorder.check(\n1201:                     f'a04-dup-rename-{label}-retained',\n1202:                     retained_name == duplicate_name,\n1203:                     f'重复 rename 错误页 name={retained_name!r}（期望 {duplicate_name!r}）',\n1204:                 )\n1205:             after = _snapshot(client, recorder, f'a04-dup-rename-{label}-after')\n1206:             _check_unchanged(\n1207:                 recorder, f'a04-dup-rename-{label}', before, after,\n1208:                 f'重复 rename {label}',\n1209:             )\n1210: \n1211:             before = _snapshot(client, recorder, f'a04-json-dup-rename-{label}-before')\n1212:             response = client.patch_json(\n1213:                 _category_path(id_b), {'name': duplicate_name}\n1214:             )\n1215:             recorder.expect_status(\n1216:                 response, 409, aid=f'a04-json-dup-rename-{label}-status'\n1217:             )\n1218:             code = _error_code(response)\n1219:             recorder.check(\n1220:                 f'a04-json-dup-rename-{label}-code',\n1221:                 code == 'duplicate_category',\n1222:                 f'JSON rename 重复名称 {duplicate_name!r} 错误码={code!r}（期望 duplicate_category）',\n1223:             )\n1224:             after = _snapshot(client, recorder, f'a04-json-dup-rename-{label}-after')\n1225:             _check_unchanged(\n1226:                 recorder, f'a04-json-dup-rename-{label}', before, after,\n1227:                 'JSON 重复 rename',\n1228:             )\n1229: \n1230:         record_b, record_b_url = _create_record_json(\n1231:             cli