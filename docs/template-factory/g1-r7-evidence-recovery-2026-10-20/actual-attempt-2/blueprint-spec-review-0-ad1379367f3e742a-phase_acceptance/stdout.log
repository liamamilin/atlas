       )).lower()\n550:         if any(token in haystack for token in ('bookmark', 'record', 'list', 'item')):\n551:             return True\n552:     return False\n553: \n554: \n555: def _empty_state_marker(doc):\n556:     for entry in doc.testids:\n557:         testid = (entry['attrs'].get('data-testid') or '').lower()\n558:         if 'empty' in testid:\n559:             text = _WHITESPACE_RE.sub(' ', entry['text']).strip()\n560:             return text or testid\n561:     text = _WHITESPACE_RE.sub(' ', doc.text).lower()\n562:     for marker in _EMPTY_MARKERS:\n563:         if marker in text:\n564:             return marker\n565:     return ''\n566: \n567: \n568: def _save_form_from_home(client, recorder, aid):\n569:     home = client.get('/', accept='text/html')\n570:     recorder.expect_status(home, 200, aid=f'{aid}-home-status')\n571:     doc = _parse_html(home.text)\n572:     form = doc.save_form()\n573:     if not recorder.check(\n574:         f'{aid}-save-form',\n575:         form is not None,\n576:         '首页含 action=/bookmarks/new 且 method=post 的保存表单',\n577:     ):\n578:         return doc, None\n579:     return doc, form\n580: \n581: \n582: def _follow_303(client, recorder, response, aid):\n583:     recorder.expect_status(response, 303, aid=f'{aid}-status')\n584:     location = response.location\n585:     if not recorder.check(\n586:         f'{aid}-location',\n587:         bool(location),\n588:         f'303 响应必须带 Location，实际 {location!r}',\n589:     ):\n590:         return None\n591:     page = client.get(location, accept='text/html')\n592:     recorder.expect_status(page, 200, aid=f'{aid}-follow-status')\n593:     return page\n594: \n595: \n596: def _get_record(client, recorder, record_id, aid):\n597:     if not record_id:\n598:         recorder.check(f'{aid}-record-id', False, '缺少记录 id，无法读回 JSON')\n599:         return None\n600:     response = client.get(_bookmark_path(record_id))\n601:     recorder.expect_status(response, 200, aid=f'{aid}-record-status')\n602:     payload = _safe_json(response)\n603:     record = _extract_record(payload)\n604:     recorder.check(\n605:         f'{aid}-record-shape',\n606:         isinstance(record, dict),\n607:         'GET /api/bookmarks/{id} 必须返回 JSON 对象，实际 ' + type(payload).__name__,\n608:     )\n609:     return record if isinstance(record, dict) else None\n610: \n611: \n612: def _case_a01(args, recorder):\n613:     client = common.HttpClient(args.base_url)\n614:     live_url = _unique_url('a01-live')\n615:     live_title = f'A01 保存标题 {uuid.uuid4().hex[:8]}'\n616:     live_description = f'A01 保存描述 {uuid.uuid4().hex[:8]}'\n617:     try:\n618:         health = client.get('/api/health')\n619:         recorder.expect_status(health, 200, aid='a01-health-status')\n620:         recorder.check(\n621:             'a01-health-json',\n622:             isinstance(_safe_json(health), dict),\n623:             '/api/health 返回 JSON 对象',\n624:         )\n625:         _, form = _save_form_from_home(client, recorder, 'a01')\n626:         if form is None:\n627:             return\n628:         fields = _form_fields(form, {\n629:             'url': live_url,\n630:             'title': live_title,\n631:             'description': live_description,\n632:         })\n633:         response = client.post_form(\n634:             _action_of(form), fields, follow_redirects=False, accept='text/html'\n635:         )\n636:         page = _follow_303(client, recorder, response, 'a01-save')\n637:         if page is None:\n638:             return\n639:         doc = _parse_html(page.text)\n640:         row = _row_for_url(doc, live_url)\n641:         if not recorder.check(\n642:             'a01-row-present',\n643:             row is not None,\n644:             f'保存后 HTML 列表出现原始 URL={live_url!r} 的记录行',\n645:         ):\n646:             return\n647:         record_id = row.record_id\n648:         recorder.check('a01-row-id', bool(record_id), f'记录行 data-record-id={record_id!r}')\n649:         recorder.check(\n650:             'a01-row-title',\n651:             live_title in row.text,\n652:             f'记录行文本包含标题 {live_title!r}',\n653:         )\n654:         recorder.check(\n655:             'a01-row-description',\n656:             live_description in row.text,\n657:             f'记录行文本包含描述 {live_description!r}',\n658:         )\n659:         link = _row_open_link(row)\n660:         href = link.href if link is not None else None\n661:         recorder.check(\n662:             'a01-row-href',\n663:             href == live_url,\n664:             f'行内打开链接 href={href!r}（期望 {live_url!r}）',\n665:         )\n666:         record = _get_record(client, recorder, record_id, 'a01')\n667:         if record is not None:\n668:             recorder.check(\n669:                 'a01-json-id',\n670:                 _record_id(record) == record_id,\n671:                 f'JSON id={_record_id(record)!r}（期望 {record_id!r}）',\n672:             )\n673:             recorder.check(\n674:                 'a01-json-url',\n675:                 _record_url(record) == live_url,\n676:                 f'JSON url={_record_url(record)!r}（期望 {live_url!r}）',\n677:             )\n678:             recorder.check(\n679:                 'a01-json-title',\n680:                 _record_title(record) == live_title,\n681:                 f'JSON title={_record_title(record)!r}（期望 {live_title!r}）',\n682:             )\n683:             recorder.check(\n684:                 'a01-json-description',\n685:                 _record_description(record) == live_description,\n686:                 f'JSON description={_record_description(record)!r}（期望 {live_description!r}）',\n687:             )\n688:     finally:\n689:         client.close()\n690: \n691:     first = None\n692:     second = None\n693:     instance_dir = None\n694:     restart_id = None\n695:     restart_url = _unique_url('a01-restart')\n696:     restart_title = f'A01 重启标题 {uuid.uuid4().hex[:8]}'\n697:     restart_description = f'A01 重启描述 {uuid.uuid4().hex[:8]}'\n698:     try:\n699:         try:\n700:             first = common.launch_app(args.app_root, args.data_dir, 0)\n701:             instance_dir = first.instance_dir\n702:             first_client = None\n703:             try:\n704:                 first_client = common.HttpClient(first.base_url)\n705:                 _, form = _save_form_from_home(first_client, recorder, 'a01-instance')\n706:                 if form is not None:\n707:                     fields = _form_fields(form, {\n708:                         'url': restart_url,\n709:                         'title': restart_title,\n710:                         'description': restart_description,\n711:                     })\n712:                     response = first_client.post_form(\n713:                         _action_of(form), fields, follow_redirects=False, accept='text/html'\n714:                     )\n715:                     page = _follow_303(first_client, recorder, response, 'a01-instance')\n716:                     if page is not None:\n717:                         doc = _parse_html(page.text)\n718:                         row = _row_for_url(doc, restart_url)\n719:                         if recorder.check(\n720:                             'a01-instance-row',\n721:                             row is not None,\n722:                             f'隔离实例保存后 HTML 列表出现 URL={restart_url!r} 的记录行',\n723:                         ):\n724:                             restart_id = row.record_id\n725:                             recorder.check(\n726:                                 'a01-instance-row-id',\n727:                                 bool(restart_id),\n728:                                 f'隔离实例记录 data-record-id={restart_id!r}',\n729:                             )\n730:                             recorder.check(\n731:                                 'a01-instance-row-title',\n732:                                 restart_title in row.text,\n733:                                 f'隔离实例记录行包含标题 {restart_title!r}',\n734:                             )\n735:                             recorder.check(\n736:                                 'a01-instance-row-description',\n737:                                 restart_description in row.text,\n738:                                 f'隔离实例记录行包含描述 {restart_description!r}',\n739:                             )\n740:                             link = _row_open_link(row)\n741:                             href = link.href if link is not None else None\n742:                             recorder.check(\n743:                                 'a01-instance-row-href',\n744:                                 href == restart_url,\n745:                                 f'隔离实例行内 href={href!r}（期望 {restart_url!r}）',\n746:                             )\n747:                             record = _get_record(\n748:                                 first_client, recorder, restart_id, 'a01-instance'\n749:                             )\n750:                             if record is not None:\n751:                                 recorder.check(\n752:                                     'a01-instance-json-url',\n753:                                     _record_url(record) == restart_url,\n754:                                     f'隔离实例 JSON url={_record_url(record)!r}（期望 {restart_url!r}）',\n755:                                 )\n756:             finally:\n757:                 if first_client is not None:\n758:                     first_client.close()\n759:         finally:\n760:             if first is not None:\n761:                 common.stop_app(first)\n762:         if not restart_id or not instance_dir:\n763:             recorder.check(\n764:                 'a01-restart-prerequisite',\n765:                 False,\n766:                 '隔离实例未提供可重启的记录 id 或实例目录',\n767:             )\n768:             return\n769:         second = common.launch_app(\n770:             args.app_root, args.data_dir, 0, instance_dir=instance_dir\n771:         )\n772:      