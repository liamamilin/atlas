h_option()\n273:         if self._select is None:\n274:             return\n275:         select = self._select\n276:         self._select = None\n277:         if self._form is not None:\n278:             self._form.selects.append(select)\n279: \n280:     def _finish_textarea(self):\n281:         if self._textarea is None:\n282:             return\n283:         textarea = self._textarea\n284:         self._textarea = None\n285:         if self._form is not None:\n286:             self._form.textareas.append(textarea)\n287: \n288:     def _finish_anchor(self):\n289:         if self._anchor is None:\n290:             return\n291:         anchor = self._anchor\n292:         self._anchor = None\n293:         self.doc.anchors.append(anchor)\n294:         if self._row is not None:\n295:             self._row.anchors.append(anchor)\n296: \n297:     def _finish_row(self):\n298:         if self._row is None:\n299:             return\n300:         row = self._row\n301:         self._row = None\n302:         self.doc.rows.append(row)\n303: \n304:     def _finish_form(self):\n305:         self._finish_select()\n306:         self._finish_textarea()\n307:         if self._form is None:\n308:             return\n309:         form = self._form\n310:         self._form = None\n311:         self.doc.forms.append(form)\n312: \n313:     def finalize(self):\n314:         self._finish_anchor()\n315:         self._finish_row()\n316:         self._finish_form()\n317: \n318: \n319: def _parse_html(text):\n320:     reader = _HtmlReader()\n321:     reader.feed(text or '')\n322:     reader.close()\n323:     reader.finalize()\n324:     return reader.doc\n325: \n326: \n327: def _form_fields(form, overrides=None, omit=()):\n328:     fields = {}\n329:     for field in form.fields:\n330:         name = field.name\n331:         if not name:\n332:             continue\n333:         if field.type in ('submit', 'button', 'reset', 'file', 'image'):\n334:             continue\n335:         if field.type i