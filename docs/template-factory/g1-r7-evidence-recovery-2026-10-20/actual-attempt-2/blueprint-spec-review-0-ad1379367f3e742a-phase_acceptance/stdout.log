)\n508:     for item in categories or []:\n509:         if isinstance(item, dict) and item.get('id') is not None:\n510:             if item.get('name') is not None:\n511:                 by_id[str(item['id'])] = str(item['name'])\n512:                 names.add(str(item['name']))\n513:     for key in ('category', 'category_name', 'categoryName'):\n514:         value = record.get(key)\n515:         if isinstance(value, str):\n516:             if value in names:\n517:                 return value\n518:             if value in by_id:\n519:                 return by_id[value]\n520:             return value\n521:         if isinstance(value, dict) and value.get('name') is not None:\n522:             return str(value['name'])\n523:     for key in ('category_id', 'categoryId'):\n524:         value = record.get(key)\n525:         if value is not None and str(value) in by_id:\n526:             return by_id[str(value)]\n527:     return None\n528: \n529: \n530: def _record_category_id(record):\n531:     if not isinstance(record, dict):\n532:         return None\n533:     for key in ('category_id', 'categoryId'):\n534:         value = record.get(key)\n535:         if value is not None:\n536:             return str(value)\n537:     value = record.get('category')\n538:     if isinstance(value, dict) and value.get('id') is not None:\n539:         return str(value['id'])\n540:     return None\n541: \n542: \n543: def _category_names(categories):\n544:     return {\n545:         str(item['name']) for item in categories\n546:         if isinstance(item, dict) and item.get('name') is not None\n547:     }\n548: \n549: \n550: def _category_ids(categories):\n551:     return {\n552:         str(item['id']) for item in categories\n553:         if isinstance(item, dict) and item.get('id') is not None\n554:     }\n555: \n556: \n557: def _find_category_by_name(categories, name):\n558:     if name is None:\n559:         return None\n560:     target = str(name).casefold()\n561:     for item in categories:\n562:         if isinstance(item, dict) and item.get('name') is not None:\n563:             if str(item['name']).casefold() == target:\n564:                 return item\n565:     return None\n566: \n567: \n568: def _find_category_by_id(categories, category_id):\n569:     if category_id is None:\n570:         return None\n571:     target = str(category_id)\n572:     for item in categories:\n573:         if isinstance(item, dict) and item.get('id') is not None:\n574:             if str(item['id']) == target:\n575:                 return item\n576:     return None\n577: \n578: \n579: def _default_category(categories):\n580:     for item in categories:\n581:         if isinstance(item, dict) and item.get('is_default'):\n582:             return item\n583:     return _find_category_by_name(categories, common.DEFAULT_CATEGORY)\n584: \n585: \n586: def _error_code(response):\n587:     payload = _safe_json(response)\n588:     if isinstance(payload, dict):\n589:         error = payload.get('error')\n590:         if isinstance(error, dict) and error.get('code') is not None:\n591:             return str(error['code'])\n592:         for key in ('code', 'error_code'):\n593:             if payload.get(key) is not None:\n594:                 return str(payload[key])\n595:     return None\n596: \n597: \n598: def _bookmark_path(bookmark_id):\n599:     return '/api/bookmarks/' + quote(str(bookmark_id), safe='')\n600: \n601: \n602: def _move_path(bookmark_id):\n603:     return _bookmark_path(bookmark_id) + '/move'\n604: \n605: \n606: def _category_path(category_id):\n607:     return '/api/categories/' + quote(str(category_id), safe='')\n608: \n609: \n610: def _record_ids(records):\n611:     return {\n612:         record_id for record_id in (_record_id(record) for record in records)\n613:         if record_id\n614:     }\n615: \n616: \n617: def _record_urls(records):\n618:     return {\n619:         url for url in (_record_url(record) for record in records)\n620:         if url\n621:     }\n622: \n623: \n624: def _fetch_bookmarks(client, recorder, aid, params=None):\n625:     response = client.get('/api/bookmarks', params=params)\n626:     recorder.expect_status(response, 200, aid=f'{aid}-status')\n627:     payload = _safe_json(response)\n628:     records = _extract_list(payload, ('bookmarks', 'items', 'data', 'records'))\n629:     recorder.check(\n630:         f'{aid}-shape',\n631:         isinstance(records, list),\n632:         f'GET /api/bookmarks 必须返回 JSON 数组，实际 {type(payload).__name__}',\n633:     )\n634:     return records if isinstance(records, list) else []\n635: \n636: \n637: def _fetch_categories(client, recorder, aid):\n638:     response = client.get('/api/categories')\n639:     recorder.expect_status(response, 200, aid=f'{aid}-status')\n640:     payload = _safe_json(response)\n641:     categories = _extract_list(payload, ('categories', 'items', 'data'))\n642:     recorder.check(\n643:         f'{aid}-shape',\n644:         isinstance(categories, list),\n645:         f'GET /api/categories 必须返回 JSON 数组，实际 {type(payload).__name__}',\n646:     )\n647:     return categories if isinstance(categories, list) else []\n648: \n649: \n650: def _category_signature(categories):\n651:     items = []\n652:     for item in categories:\n653:         if not isinstance(item, dict):\n654:             continue\n655:         items.append((\n656:             str(item.get('id')),\n657:             str(item.get('name')),\n658:             bool(item.get('is_default')),\n659:             item.get('count'),\n660:         ))\n661:     return tuple(sorted(items, key=lambda entry: (entry[0], entry[1])))\n662: \n663: \n664: def _record_map(records, categories):\n665:     result = {}\n666:     for record in records:\n667:         record_id = _record_id(record)\n668:         if record_id:\n669:             result[record_id] = _record_category_name(record, categories)\n670:     return result\n671: \n672: \n673: def _snapshot(client, recorder, aid):\n674:     categories = _fetch_categories(client, recorder, f'{aid}-categories')\n675:     records = _fetch_bookmarks(\n676:         client, recorder, f'{aid}-records', params={'include_trashed': 1}\n677:     )\n678:     return (_category_signature(categories), _record_map(records, categories))\n679: \n680: \n681: def _check_unchanged(recorder, aid, before, after, label):\n682:     recorder.check(\n683:         f'{aid}-categories-unchanged',\n684:         before[0] == after[0],\n685:         f'{label} 后分类集合（含计数）不变：{len(before[0])} -> {len(after[0])}',\n686:     )\n687:     recorder.check(\n688:         f'{aid}-records-unchanged',\n689:         before[1] == after[1],\n690:         f'{label} 后记录集合与归类归属不变：{len(before[1])} -> {len(after[1])}',\n691:     )\n692: \n693: \n694: def _follow_303(client, recorder, response, aid, expected_path=None, expected_query=None):\n695:     recorder.expect_status(response, 303, aid=f'{aid}-status')\n696:     location = response.location\n697:     if not recorder.check(\n698:         f'{aid}-location',\n699:         bool(location),\n700:         f'303 响应必须带 Location，实际 {location!r}',\n701:     ):\n702:         return None, None\n703:     parts = urlsplit(location)\n704:     if expected_path is not None:\n705:         actual_path = parts.path.rstrip('/') or '/'\n706:         wanted_path = expected_path.rstrip('/') or '/'\n707:         recorder.check(\n708:             f'{aid}-path',\n709:             actual_path == wanted_path,\n710:             f'303 Location={location!r} 的路径={actual_path!r}（期望 {wanted_path!r}）',\n711:         )\n712:     if expected_query:\n713:         actual_query = dict(parse_qsl(parts.query, keep_blank_values=True))\n714:         for key, value in expected_query.items():\n715:             actual_value = actual_query.get(key)\n716:             recorder.check(\n717:                 f'{aid}-query-{key}',\n718:                 actual_value == value,\n719:                 f'303 Location={location!r} 的 {key}={actual_value!r}（期望 {value!r}）',\n720:             )\n721:     page = client.get(location, accept='text/html')\n722:     recorder.expect_status(page, 200, aid=f'{aid}-follow-status')\n723:     return page, location\n724: \n725: \n726: def _home_page(client, recorder, aid, params=None):\n727:     response = client.get('/', params=params, accept='text/html')\n728:     recorder.expect_status(response, 200, aid=f'{aid}-status')\n729:     recorder.check(\n730:         f'{aid}-content-type',\n731:         'text/html' in response.content_type.lower(),\n732:         f'GET / Content-Type={response.content_type!r}',\n733:     )\n734:     return _parse_html(response.text)\n735: \n736: \n737: def _categories_page(client, recorder, aid):\n738:     response = client.get('/categories', accept='text/html')\n739:     recorder.expect_status(response, 200, aid=f'{aid}-status')\n740:     recorder.check(\n741:         f'{aid}-content-type',\n742:         'text/html' in response.content_type.lower(),\n743:         f'GET /categories Content-Type={response.content_type!r}',\n744:     )\n745:     return _parse_html(response.text)\n746: \n747: \n748: def _expect_html_error(recorder, response, aid, label, expected_status):\n749:     recorder.check(\n750:         f'{aid}-no-5xx',\n751:         response.status < 500,\n752:         f'{label} -> HTTP {response.status}（校验类错误不得产生 5xx）',\n753:     )\n754:     recorder.expect_status(\n755:         response,\n756:         expected_status,\n757:         aid=f'{aid}-status',\n758:         detail=f'{label} -> HTTP {response.status}（期望 {expected_status}）',\n759:     )\n760:     doc = _parse_html(response.text)\n761:     error_text = _form_error_text(doc)\n762:     recorder.check(\n763:         f'{aid}-form-error',\n764:         bool(error_text),\n765:         f'{label} 显示可读 form-error，实际 {error_text!r}',\n766:     )\n767:     return doc\n768: \n769: \n770: def _get_record_json(client, recorder, aid, record_id):\n771:     response = client.get(_bookmark_path(record_id))\n772:     recorder.expect_status(response, 200, aid=f'{aid}-status')\n773:     payload = _safe_json(response)\n774:     record = _extract_record(payload)\n775:     recorder.check(\n776:         f'{aid}-shape',\n777:         isinstance(record, dict),\n778:         f'GET /api/bookmarks/{record_id} 返回 JSON 对象，实际 {type(payload).__name__}',\n779:     )\n780:     return record if isinstance(record, dict) else None\n781: \n782: \n783: def _save_form_from_home(client, recorder, aid, params=None):\n784:     page = client.get('/', params=params, accept='text/html')\n785:     recorder.expect_status(page, 200, aid=f'{aid}-status')\n786:     doc = _parse_html(page.text)\n787:     form = doc.save_form()\n788:     recorder.check(\n789:         f'{aid}-save-form',\n790:         form is not None,\n791:         '首页含 action=/bookmarks/new 且 method=post 的真实保存表单',\n792:     )\n793:     return doc, form\n794: \n795: \n796: def _check_json_error(recorder, response, prefix, expected_status, expected_code, label):\n797:     recorder.check(\n798:         f'{prefix}-no-5xx',\n799:         response.status < 500,\n800:         f'{label} -> HTTP {response.status}（校验类错误不得产生 5xx）',\n801:     )\n802:     recorder.expect_status(\n803:         response,\n804:         expected_status,\n805:         aid=f'{prefix}-status',\n806:         detail=f'{label} -> HTTP {response.status}（期望 {expected_status}）',\n807:     )\n808:     code = _error_code(response)\n809:     recorder.check(\n810:         f'{prefix}-code',\n811:         code == expected_code,\n812:         f'{label} 错误码={code!r}（期望 {expected_code}）',\n813:     )\n814: \n815: \n816: def _a09_live_flow(client, recorder):\n817:     health = client.get('/api/health')\n818:     recorder.expect_status(health, 200, aid='a09-live-health-status')\n819: \n820:     _, save_form = _save_form_from_home(client, recorder, 'a09-live')\n821:     if save_form is None:\n822:         return\n823: \n824:     name = _unique_category('a09-live')\n825:     url = _unique_url('a09-live')\n826:     title = f'A09 恢复标题 {uuid.uuid4().hex[:8]}'\n827:     description = f'A09 恢复描述 {uuid.uuid4().hex[:8]}'\n828:     response = client.post_form(\n829:         _form_path(save_form, '/bookmarks/new'),\n830:         _form_fields(save_form, {\n831:             'url': url,\n832:             'title': title,\n833:             'description': description,\n834:             'category': name,\n835:         }),\n836:         follow_redirects=False,\n837:         accept='text/html',\n838:     )\n839:     page, _ = _follow_303(\n840:         client, recorder, response, 'a09-live-save', expected_path='/'\n841:     )\n842:     if page is None:\n843:         return\n844:     doc = _parse_html(page.text)\n845:     row = _row_for_url(doc, url)\n846:     if row is None:\n847:         doc = _home_page(client, recorder, 'a09-live-save-fallback')\n848:         row = _row_for_url(doc, url)\n849:     if not recorder.check(\n850:         'a09-live-saved-row',\n851:         row is not None,\n852:         f'真实保存表单提交后 HTML 列表出现 url={url!r} 的记录行',\n853:     ):\n854:         return\n855:     record_id = row.record_id\n856:     if not recorder.check(\n857:         'a09-live-saved-id', bool(record_id), f'保存记录 data-record-id={record_id!r}'\n858:     ):\n859:         return\n860: \n861:     categories = _fetch_categories(client, recorder, 'a09-live-categories')\n862:     category = _find_category_by_name(categories, name)\n863:     category_id = _record_id(category)\n864:     if not recorder.check(\n865:         'a09-live-category-created',\n866:         bool(category_id),\n867:         f'保存新归类名 {name!r} 后 /api/categories 自动创建该归类 id={category_id!r}',\n868:     ):\n869:         return\n870:     count_before = category.get('count') if isinstance(category, dict) else None\n871:     recorder.check(\n872:         'a09-live-count-before-delete',\n873:         count_before == 1,\n874:         f'删除前归类 {name!r} API count={count_before!r}（期望 1）',\n875:     )\n876: \n877:     record = _get_record_json(client, recorder, 'a09-live-record', record_id)\n878:     if record is not None:\n879:         recorder.check(\n880:             'a09-live-record-url',\n881:             _record_url(record) == url,\n882:             f'保存后 url={_record_url(record)!r}（期望 {url!r}）',\n883:         )\n884:         recorder.check(\n885:             'a09-live-record-title',\n886:             _record_title(record) == title,\n887:             f'保存后 title={_record_title(record)!r}（期望 {title!r}）',\n888:         )\n889:         recorder.check(\n890:             'a09-live-record-description',\n891:             _record_description(record) == description,\n892:             f'保存后 description={_record_description(record)!r}（期望 {description!r}）',\n893:         )\n894:         recorder.check(\n895:             'a09-live-record-category',\n896:             _record_category_name(record, categories) == name,\n897:             f'保存后 category={_record_category_name(record, categories)!r}（期望 {name!r}）',\n898:         )\n899: \n900:     delete_form = _find_record_form(doc, 'record-delete-form', record_id)\n901:     if delete_form is None:\n902:         doc = _home_page(\n903:             client, recorder, 'a09-live-delete-home', params={'category': name}\n904:         )\n905:         delete_form = _find_record_form(doc, 'record-delete-form', record_id)\n906:     if not recorder.check(\n907:         'a09-live-delete-form',\n908:         delete_form is not None,\n909:         f'记录 {record_id!r} 行含 record-delete-form',\n910:     ):\n911:         return\n912:     response = client.post_form(\n913:         _form_path(delete_form, '/'),\n914:         _form_fields(delete_form),\n915:         follow_redirects=False,\n916:         accept='text/html',\n917:     )\n918:     page, _ = _follow_303(\n919:         client, recorder, response, 'a09-live-delete',\n920:         expected_path='/', expected_query={'trash': '1'},\n921:     )\n922:     if page is None:\n923:         return\n924:     trash_doc = _parse_html(page.text)\n925: \n926:     default_doc = _home_page(client, recorder, 'a09-live-default-after-delete')\n927:     recorder.check(\n928:         'a09-live-default-excluded',\n929:         record_id not in _row_ids(default_doc),\n930:         f'删除后默认列表排除记录 {record_id!r}',\n931:     )\n932:     category_doc = _home_page(\n933:         client, recorder, 'a09-live-category-list-after-delete',\n934:         params={'category': name},\n935:     )\n936:     recorder.check(\n937:         'a09-live-category-list-excluded',\n938:         record_id not in _row_ids(category_doc),\n939:         f'删除后归类 {name!r} 的活动列表排除记录 {record_id!r}',\n940:     )\n941: \n942:     categories_after = _fetch_categories(client, recorder, 'a09-live-categories-after')\n943:     category_after = _find_category_by_id(categories_after, category_id)\n944:     count_after = category_after.get('count') if isinstance(category_after, dict) else None\n945:     recorder.check(\n946:         'a09-live-api-count-excluded',\n947:         count_after == 0,\n948:         f'删除后归类 {name!r} API count={count_after!r}（期望 0，只计活动记录）',\n949:     )\n[Output truncated. Continue reading with offset: 950]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\": \"/Users/milin/2026/软件开发/application-atlas/application-atlas-production-pack/atlas/template-factory/jobs/job_3a658ba085e8417ea6faad5cb0cdd493/attempt-2/blueprint-spec-review-0-ad1379367f3e742a-phase_acceptance/source/program-evidence/prepared/acceptance/p0_recovery.py\", \"offset\": 450, \"limit\": 500}"},"time":{"start":1792483915580,"end":1792483915638}}}}
