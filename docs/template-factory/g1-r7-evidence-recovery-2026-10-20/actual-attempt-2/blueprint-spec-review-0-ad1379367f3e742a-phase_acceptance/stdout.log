e-for-byte reuse\",\n51:         \"before_sha256\": \"93ae82c74946811fac3b1dd213cc077cf89acc6ecfb45e64ec2830e3482b7f60\",\n52:         \"checkpoint_digest\": \"53179c085884454f4c5d1012bcfc80ced838fa0f3a336ff9434ef19d5a158814\",\n53:         \"checkpoint_name\": \"blueprint-code-0-2\",\n54:         \"mode\": \"reuse\",\n55:         \"patch\": [],\n56:         \"patch_digest\": \"4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945\",\n57:         \"path\": \"acceptance/p0_organize.py\",\n58:         \"prepared_ref\": \"docs/template-factory/g1-r7-acceptance-alignment-2026-10-20/prepared-programs/acceptance/p0_organize.py\",\n59:         \"source_attempt\": 1,\n60:         \"source_job_id\": \"job_f3e32b56036b4ec7bea0c00d6a2a8dc4\"\n61:       },\n62:       {\n63:         \"after_sha256\": \"342e38d2298cf48e22fb97d76e080ce4a67c3c10a942502c5ef205954878d667\",\n64:         \"authorization_clause\": \"R7 §3.2 A07 only\",\n65:         \"before_sha256\": \"4ba2fa6d2a6d3b306d6be5f82ef63604b836cf3d84bd0fc5efddf4d64683a6da\",\n66:         \"checkpoint_digest\": \"293c6fab073062eb832695528589a6d3df22c5c9500c16421419f21978a5621e\",\n67:         \"checkpoint_name\": \"blueprint-code-0-3\",\n68:         \"mode\": \"replace\",\n69:         \"patch\": [\n70:           {\n71:             \"new\": \"        path_only = f'pathonly{uuid.uuid4().hex[:12]}'\\n        query_only = f'queryonly{uuid.uuid4().hex[:12]}'\\n        url_a = f'https://{host_token}.atlas-acceptance.example/{path_only}?q={query_only}'\",\n72:             \"old\": \"        url_a = f'https://{host_token}.atlas-acceptance.example/notes/{uuid.uuid4().hex[:10]}'\"\n73:           },\n74:           {\n75:             \"new\": \"        # Tokens occur only in excluded fields of this target, never in allowed ones.\\n        for label, token_value in (('url-path', path_only), ('url-query', query_only), ('category-name', cat_a)):\\n            allowed_text = ' '.join((title_a, host_token + '.atlas-acceptance.example', desc_a)).lower()\\n            recorder.check(f'a07-{label}-isolated-token', token_value.lower() not in allowed_text,\\n                           '负例 token 不在目标记录 title/hostname/description')\\n            for scoped in (False, True):\\n                aid = f'a07-excludes-{label}-' + ('category' if scoped else 'all')\\n                params = {'q': token_value}\\n                if scoped:\\n                    params['category'] = cat_a\\n                results = _search(client, recorder, aid + '-json', params)\\n                recorder.check(aid + '-json-target-absent', id_a not in _record_ids(results),\\n                               'JSON 不因 URL path/query 或分类名而命中目标记录')\\n                html = _html_search(client, recorder, aid + '-html', search_form,\\n                                    cat_a if scoped else '', token_value)\\n                recorder.check(aid + '-html-target-absent', id_a not in _row_ids(html),\\n                               '实际搜索表单的记录行不因排除字段命中；不检查页面回显')\\n        # These positive controls also prove both entry points do not return always-empty.\\n        for label, positive_token in (('title', shared), ('hostname', host_token), ('description', desc_token)):\\n            positive_doc = _html_search(client, recorder, f'a07-html-positive-{label}',\\n                                        search_form, cat_a, positive_token.upper())\\n            recorder.check(f'a07-html-positive-{label}-hit', id_a in _row_ids(positive_doc),\\n                           '允许字段经真实 HTML 搜索表单仍命中同一记录')\\n        doc_empty = _html_search(client, recorder, 'a07-html-empty', search_form, cat_a, unmatched)\",\n76:             \"old\": \"        doc_empty = _html_search(client, recorder, 'a07-html-empty', search_form, cat_a, unmatched)\"\n77:           }\n78:         ],\n79:         \"patch_digest\": \"ba5c0ac00060bbeb1558b13172afec12e1d5a06de6edf3c6a1ac135aece0037b\",\n80:         \"path\": \"acceptance/p0_find_open.py\",\n81:         \"prepared_ref\": \"