e\n208:         try:\n209:             items = self.headers.items()\n210:         except AttributeError:\n211:             return default\n212:         target = name.lower()\n213:         for key, item in items:\n214:             if str(key).lower() == target:\n215:                 return item\n216:         return default\n217: \n218:     @property\n219:     def location(self) -> str | None:\n220:         value = self.header('Location')\n221:         return None if value is None else str(value)\n222: \n223:     @property\n224:     def content_type(self) -> str:\n225:         return str(self.header('Content-Type') or '')\n226: \n227:     @property\n228:     def text(self) -> str:\n229:         content_type = self.content_type\n230:         match = re.search(r'charset=([\\w.-]+)', content_type, re.IGNORECASE)\n231:         charset = match.group(1) if match else 'utf-8'\n232:         if charset.lower().replace('_', '-') in ('utf-8', 'utf8'):\n233:             charset = 'utf-8-sig'\n234:         try:\n235:             return self.body.decode(charset, 'replace')\n236:         except LookupError:\n237:             return self.body.decode('utf-8', 'replace')\n238: \n239:     def json(self) -> Any:\n240:         return _json.loads(self.text)\n241: \n242:     def get_json(self) -> Any:\n243:         return self.json()\n244: \n245:     def __repr__(self) -> str:\n246:         return f'<HttpResponse {self.status} {self.method} {self.url}>'\n247: \n248: \n249: class _NoRedirectHandler(HTTPRedirectHandler):\n250:     def redirect_request(self, req, fp, code, msg, headers, newurl):\n251:         return None\n252: \n253: \n254: class HttpClient:\n255:     def __init__(self, base_url: str, timeout: float = 20.0, follow_redirects: bool = True):\n256:         self.base_url = _normalize_base_url(base_url)\n257:         self.origin = _origin(self.base_url)\n258:         self.timeout = float(timeout)\n259:         self.follow_redirects = bool(follow_redirects)\n260:         self._opener = build_opener(_NoRedirectHandler(), ProxyHandler({}))\n261: \n262:     def close(self) -> None:\n263:         return None\n264: \n265:     def __enter__(self) -> 'HttpClient':\n266:         return self\n267: \n268:     def __exit__(self, exc_type, exc, traceback) -> bool:\n269:         self.close()\n270:         return False\n271: \n272:     def _build_url(self, path: Any, params: Any) -> str:\n273:         text = '' if path is None else str(path)\n274:         parts = urlsplit(text)\n275:         if parts.scheme:\n276:             if parts.scheme.lower() not in ('http', 'https'):\n277:                 raise ExternalNavigationBlocked(f'拒绝非 http/https URL：{_redact_url(text)}')\n278:             try:\n279:                 absolute_origin = _origin(text)\n280:             except ValueError as exc:\n281:                 raise ExternalNavigationBlocked(f'拒绝无效 URL：{_redact_url(text)}') from exc\n282:             if absolute_origin != self.origin:\n283:                 raise ExternalNavigationBlocked(f'拒绝访问目标以外的 URL：{_redact_url(text)}')\n284:             url = text\n285:         elif parts.netloc:\n286:             raise ExternalNavigationBlocked('拒绝协议相对 URL')\n287:         elif text.startswith('?'):\n288:             url = self.base_url + text\n289:         elif text.startswith('/'):\n290:             url = self.base_url + text\n291:         elif text:\n292:             url = self.base_url + '/' + text\n293:         else:\n294:             url = self.base_url\n295:         final = urlsplit(url)\n296:         query = final.query\n297:         if params:\n298:             pairs = parse_qsl(query, keep_blank_values=True)\n299:             if isinstance(params, Mapping):\n300:                 pairs.extend(params.items())\n301:             else:\n302:                 pairs.extend(params)\n303:             query = urlencode(pairs, doseq=True)\n304:         return urlunsplit((final.scheme, final.netloc, final.path, query, ''))\n305: \n306:     def request(self, method: str, p