ceptance/source/program-evidence/source/acceptance/p0_organize.py, lines 1635-1874\n1635:         )\n1636:     finally:\n1637:         client.close()\n1638: \n1639: \n1640: def _a05_on_base_url(args, recorder):\n1641:     client = common.HttpClient(args.base_url)\n1642:     try:\n1643:         health = client.get('/api/health')\n1644:         recorder.expect_status(health, 200, aid='a05-health-status')\n1645:         target_name = _unique_category('a05target')\n1646:         target_id = _create_category_json(\n1647:             client, recorder, 'a05-target-category', target_name\n1648:         )\n1649:         record_id, record_url = _create_record_json(\n1650:             client, recorder, 'a05-record',\n1651:             title=f'A05 记录 {uuid.uuid4().hex[:8]}',\n1652:             description=f'A05 描述 {uuid.uuid4().hex[:8]}',\n1653:         )\n1654:         if not recorder.check(\n1655:             'a05-prerequisites',\n1656:             bool(target_id) and bool(record_id),\n1657:             f'目标归类 id={target_id!r}，记录 id={record_id!r}',\n1658:         ):\n1659:             return\n1660:         doc = _home_page(\n1661:             client, recorder, 'a05-home',\n1662:             params={'category': common.DEFAULT_CATEGORY},\n1663:         )\n1664:         move_form = _find_record_form(doc, 'record-move-form', record_id)\n1665:         if not recorder.check(\n1666:             'a05-move-form',\n1667:             move_form is not None,\n1668:             f'记录行含 record-move-form（record_id={record_id!r}）',\n1669:         ):\n1670:             return\n1671:         options = _select_values(move_form, 'category_id')\n1672:         recorder.check(\n1673:             'a05-move-options',\n1674:             target_id in options,\n1675:             f'record-move-form 的 category_id 选项包含目标 id={target_id!r}；实际 {options!r}',\n1676:         )\n1677:         form_record_id = move_form.value('record_id')\n1678:         recorder.check(\n1679:             'a05-move-record-id',\n1680:             form_record_id == record_id,\n1681:             f'record_id 字段={form_record_id!r}（期望 {record_id!r}）',\n1682:         )\n1683:         response = client.post_form(\n1684:             _form_path(move_form, '/'),\n1685:             _form_fields(move_form, {'category_id': target_id}),\n1686:             follow_redirects=False,\n1687:             accept='text/html',\n1688:         )\n1689:         page, location = _follow_303(\n1690:             client, recorder, response, 'a05-move', expected_path='/'\n1691:         )\n1692:         if page is None:\n1693:             return\n1694:         actual_query = {}\n1695:         if location:\n1696:             actual_query = dict(\n1697:                 parse_qsl(urlsplit(location).query, keep_blank_values=True)\n1698:             )\n1699:         location_category = actual_query.get('category')\n1700:         recorder.check(\n1701:             'a05-move-location-category',\n1702:             location_category == target_name,\n1703:             f'移动 303 Location 的 category={location_category!r}（期望 {target_name!r}）',\n1704:         )\n1705:         old_list = _fetch_bookmarks(\n1706:             client, recorder, 'a05-old-list',\n1707:             params={'category': common.DEFAULT_CATEGORY},\n1708:         )\n1709:         recorder.check(\n1710:             'a05-left-default',\n1711:             record_id not in _record_ids(old_list),\n1712:             f'移动后记录 {record_id!r} 不再属于「{common.DEFAULT_CATEGORY}」',\n1713:         )\n1714:         new_list = _fetch_bookmarks(\n1715:             client, recorder, 'a05-new-list',\n1716:             params={'category': target_name},\n1717:         )\n1718:         recorder.check(\n1719:             'a05-in-target',\n1720:             record_id in _record_ids(new_list),\n1721:             f'移动后记录 {record_id!r} 出现在归类 {target_name!r}',\n1722:         )\n1723:         categories = _fetch_categories(client, recorder, 'a05-categories')\n1724:         fetched = _get_record_json(\n1725:             client, recorder, 'a05-record-json', record_id\n1726:         )\n1727:         if fetched is not None:\n1728:             actual = _record_category_name(fetched, categories)\n1729:             recorder.check(\n1730:                 'a05-record-category',\n1731:                 actual == target_name,\n1732:                 f'JSON 读回归类={actual!r}（期望 {target_name!r}）',\n1733:             )\n1734:         new_doc = _home_page(\n1735:             client, recorder, 'a05-html-new', params={'category': target_name}\n1736:         )\n1737:         recorder.check(\n1738:             'a05-html-new-row',\n1739:             record_id in _row_ids(new_doc),\n1740:             f'归类 {target_name!r} 的 HTML 列表包含记录 {record_id!r}',\n1741:         )\n1742:         old_doc = _home_page(\n1743:             client, recorder, 'a05-html-old',\n1744:             params={'category': common.DEFAULT_CATEGORY},\n1745:         )\n1746:         recorder.check(\n1747:             'a05-html-old-absent',\n1748:             record_id not in _row_ids(old_doc),\n1749:             f'「{common.DEFAULT_CATEGORY}」的 HTML 列表不再包含记录 {record_id!r}',\n1750:         )\n1751:     finally:\n1752:         client.close()\n1753: \n1754: \n1755: def _a05_across_restart(args, recorder):\n1756:     first = common.launch_app(args.app_root, args.data_dir, 0)\n1757:     instance_dir = first.instance_dir\n1758:     target_name = _unique_category('a05restart')\n1759:     target_id = None\n1760:     record_id = None\n1761:     try:\n1762:         client = common.HttpClient(first.base_url)\n1763:         try:\n1764:             health = client.get('/api/health')\n1765:             recorder.expect_status(health, 200, aid='a05-restart-health-status')\n1766:             target_id = _create_category_json(\n1767:                 client, recorder, 'a05-restart-target', target_name\n1768:             )\n1769:             record_id, _ = _create_record_json(\n1770:                 client, recorder, 'a05-restart-record',\n1771:                 title=f'A05 重启记录 {uuid.uuid4().hex[:8]}',\n1772:                 description=f'A05 重启描述 {uuid.uuid4().hex[:8]}',\n1773:             )\n1774:             if target_id and record_id:\n1775:                 doc = _home_page(\n1776:                     client, recorder, 'a05-restart-home',\n1777:                     params={'category': common.DEFAULT_CATEGORY},\n1778:                 )\n1779:                 move_form = _find_record_form(\n1780:                     doc, 'record-move-form', record_id\n1781:                 )\n1782:                 if recorder.check(\n1783:                     'a05-restart-move-form',\n1784:                     move_form is not None,\n1785:                     f'隔离实例记录行含 record-move-form（record_id={record_id!r}）',\n1786:                 ):\n1787:                     response = client.post_form(\n1788:                         _form_path(move_form, '/'),\n1789:                         _form_fields(move_form, {'category_id': target_id}),\n1790:                         follow_redirects=False,\n1791:                         accept='text/html',\n1792:                     )\n1793:                     page, location = _follow_303(\n1794:                         client, recorder, response,\n1795:                         'a05-restart-move', expected_path='/',\n1796:                     )\n1797:                     if page is not None:\n1798:                         before_stop = _fetch_bookmarks(\n1799:                             client, recorder, 'a05-restart-before-stop',\n1800:                             params={'category': target_name},\n1801:                         )\n1802:                         recorder.check(\n1803:                             'a05-restart-before-stop-visible',\n1804:                             record_id in _record_ids(before_stop),\n1805:                             f'停止前记录 {record_id!r} 已在归类 {target_name!r}',\n1806:                         )\n1807:         finally:\n1808:             client.close()\n1809:     finally:\n1810:         common.stop_app(first)\n1811: \n1812:     if not recorder.check(\n1813:         'a05-restart-prerequisite',\n1814:         bool(target_id) and bool(record_id),\n1815:         f'隔离实例未提供目标归类或记录（target_id={target_id!r}, record_id={record_id!r}）',\n1816:     ):\n1817:         return\n1818: \n1819:     second = common.launch_app(\n1820:         args.app_root, args.data_dir, 0, instance_dir=instance_dir\n1821:     )\n1822:     try:\n1823:         client = common.HttpClient(second.base_url)\n1824:         try:\n1825:             categories = _fetch_categories(\n1826:                 client, recorder, 'a05-restart-categories'\n1827:             )\n1828:             target = _find_category_by_id(categories, target_id)\n1829:             recorder.check(\n1830:                 'a05-restart-category-id',\n1831:                 target is not None and _record_id(target) == target_id,\n1832:                 f'重启后归类 {target_name!r} 的 id 保持 {target_id!r}',\n1833:             )\n1834:             fetched = _get_record_json(\n1835:                 client, recorder, 'a05-restart-record-json', record_id\n1836:             )\n1837:             if fetched is not None:\n1838:                 actual = _record_category_name(fetched, categories)\n1839:                 recorder.check(\n1840:                     'a05-restart-record-category',\n1841:                     actual == target_name,\n1842:                     f'重启后记录 category={actual!r}（期望 {target_name!r}）',\n1843:                 )\n1844:             new_doc = _home_page(\n1845:                 client, recorder, 'a05-restart-html-new',\n1846:                 params={'category': target_name},\n1847:             )\n1848:             recorder.check(\n1849:                 'a05-restart-html-visible',\n1850:                 record_id in _row_ids(new_doc),\n1851:                 f'重启后归类 {target_name!r} 的 HTML 列表包含记录 {record_id!r}',\n1852:             )\n1853:             old_doc = _home_page(\n1854:     