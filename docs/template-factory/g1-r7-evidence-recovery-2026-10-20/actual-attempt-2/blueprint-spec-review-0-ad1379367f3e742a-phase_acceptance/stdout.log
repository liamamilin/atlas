ame'):\n426:         value = record.get(key)\n427:         if isinstance(value, str):\n428:             if value in names:\n429:                 return value\n430:             if value in by_id:\n431:                 return by_id[value]\n432:             return value\n433:         if isinstance(value, dict) and value.get('name') is not None:\n434:             return str(value['name'])\n435:     for key in ('category_id', 'categoryId'):\n436:         value = record.get(key)\n437:         if value is not None and str(value) in by_id:\n438:             return by_id[str(value)]\n439:     return None\n440: \n441: \n442: def _record_ids(records):\n443:     return {_record_id(record) for record in records}\n444: \n445: \n446: def _action_of(form):\n447:     return form.action or '/'\n448: \n449: \n450: def _form_fields(form, overrides=None, omit=()):\n451:     fields = {}\n452:     for field in form.fields:\n453:         name = field.name\n454:         if not name:\n455:             continue\n456:         if field.type in ('submit', 'button', 'reset', 'file', 'image'):\n457:             continue\n458:         if field.type in ('checkbox', 'radio') and not field.checked:\n459:             continue\n460:         fields[name] = field.value\n461:     for select in form.selects:\n462:         if select.name:\n463:             fields[select.name] = select.selected_value()\n464:     for textarea in form.textareas:\n465:         if textarea.name:\n466:             fields[textarea.name] = textarea.text\n467:     if overrides:\n468:         for key, value in overrides.items():\n469:             fields[str(key)] = str(value)\n470:     for name in omit:\n471:         fields.pop(name, None)\n472:     return fields\n473: \n474: \n475: def _form_error_text(doc):\n476:     parts = []\n477:     for entry in doc.testids:\n478:         testid = (entry['attrs'].get('data-testid') or '').lower()\n479:         if testid == 'form-error' or 'form-error' in testid:\n480:             text = _WHITESPACE_RE.sub(' ', entry['text']).strip()\n481:             if text:\n482:                 parts.append(text)\n483:     return ' '.join(parts)\n484: \n485: \n486: def _row_for_url(doc, url):\n487:     for row in doc.rows:\n488:         for anchor in row.anchors:\n489:             if anchor.testid == 'record-open-link' and anchor.href == url:\n490:                 return row\n491:     for row in doc.rows:\n492:         for anchor in row.anchors:\n493:             if anchor.href == url:\n494:                 return row\n495:     return None\n496: \n497: \n498: def _row_by_id(doc, record_id):\n499:     for row in doc.rows:\n500:         if row.record_id == record_id:\n501:             return row\n502:     return None\n503: \n504: \n505: def _row_open_link(row):\n506:     for anchor in row.anchors:\n507:         if anchor.testid == 'record-open-link':\n508:             return anchor\n509:     for anchor in row.anchors:\n510:         if anchor.href.startswith('http://') or anchor.href.startswith('https://'):\n511:             return anchor\n512:     return None\n513: \n514: \n515: def _category_values_in_html(doc):\n516:     values = set()\n517:     for form in doc.forms:\n518:         for select in form.selects:\n519:             if select.name != 'category':\n520:                 continue\n521:             for option in select.options:\n522:                 value = option.resolved_value()\n523:                 if value:\n524:                     values.add(value)\n525:                 text = option.text.strip()\n526:                 if text:\n527:                     values.add(text)\n528:     for anchor in doc.anchors:\n529:         try:\n530:             parts = urllib.parse.urlsplit(anchor.href)\n531:         except ValueError:\n532:             continue\n533:         for key, value in urllib.parse.parse_qsl(parts.query, keep_blank_values=True):\n534:             if key == 'category' and value:\n535:                 values.add(value)\n536:     return values\n537: \n53