   response = client.get(HEALTH_PATH)\n496:             if response.status == 200:\n497:                 try:\n498:                     payload = response.json()\n499:                 except Exception as exc:\n500:                     last_error = f'健康检查返回非 JSON：{_redact_text(exc, 200)}'\n501:                 else:\n502:                     if isinstance(payload, dict):\n503:                         return True\n504:                     last_error = '健康检查 JSON 不是对象'\n505:             elif response.status in (401, 403):\n506:                 raise AppStartError('目标要求认证，当前验收适配器不支持认证')\n507:             else:\n508:                 last_error = f'健康检查返回 HTTP {response.status}'\n509:         except AppStartError:\n510:             raise\n511:         except Exception as exc:\n512:             last_error = _redact_text(exc, 300)\n513:         if time.monotonic() >= deadline:\n514:             break\n515:         time.sleep(min(0.2, max(0.02, deadline - time.monotonic())))\n516:     tail = _tail(getattr(proc, 'log_path', None)) if proc is not None else ''\n517:     message = f'等待 {_redact_url(base)}/api/health 就绪超时：{last_error}'\n518:     if tail:\n519:         message += f'；日志尾部：{tail}'\n520:     raise AppStartError(message)\n521: \n522: \n523: def _prepare_app_root(app_root: Any) -> tuple[str, str]:\n524:     if not app_root:\n525:         raise AppStartError('--app-root 不能为空')\n526:     root = os.path.realpath(os.path.abspath(os.path.expanduser(str(app_root))))\n527:     if not os.path.isdir(root):\n528:         raise AppStartError('--app-root 不存在或不是目录')\n529:     script = os.path.join(root, 'app', 'serve.py')\n530:     if not os.path.isfile(script):\n531:         raise AppStartError('--app-root 中缺少 app/serve.py')\n532:     return root, script\n533: \n534: \n535: def _ensure_directory(path: Any, label: str) -> str:\n536:     if not path:\n537:         raise AppStartError(f'{label} 不能为空')\n538:     target = os.path.realpath(os.path.abspath(os.path.expanduser(str(path))))\n539:     try:\n540:         os.makedirs(target, mode=0o700, exist_ok=True)\n541:     except OSError as exc:\n542:         raise AppStartError(f'{label} 无法创建') from exc\n543:     if not os.path.isdir(target):\n544:         raise AppStartError(f'{label} 不是目录')\n545:     return target\n546: \n547: \n548: def _new_instance(instances_root: str) -> str:\n549:     path = os.path.join(instances_root, uuid.uuid4().hex)\n550:     try:\n551:         os.makedirs(path, mode=0o700, exist_ok=False)\n552:     except OSError as exc:\n553:         raise AppStartError('无法创建每实例隔离 scratch') from exc\n554:     return os.path.realpath(path)\n555: \n556: \n557: def _validate_instance(instances_root: str, instance_dir: str) -> str:\n558:     candidate = os.path.realpath(os.path.abspath(os.path.expanduser(str(instance_dir))))\n559:     try:\n560:         common = os.path.commonpath([instances_root, candidate])\n561:     except ValueError as exc:\n562:         raise AppStartError('实例目录必须位于 data_dir/instances 下') from exc\n563:     if common != instances_root or candidate == instances_root:\n564:         raise AppStartError('实例目录必须位于 data_dir/instances 下')\n565:     try:\n566:         os.makedirs(candidate, mode=0o700, exist_ok=True)\n567:     except OSError as exc:\n568:         raise AppStartError('无法创建实例目录') from exc\n569:     return candidate\n570: \n571: \n572: def _close_log(proc: Any) -> None:\n573:     handle = getattr(proc, 'log_handle', None)\n574:     if handle is not None:\n575:         try:\n576:             handle.close()\n577:         except Exception:\n578:             pass\n579:         try:\n580:             proc.log_handle = None\n581:         except Exception:\n582:             pass\n583: \n584: \n585: def _forget_active(proc: Any) -> None:\n586:     with _REGISTRY_LOCK:\n587:         for key, active in list(_ACTIVE_BY_KEY.items()):\n588:             if active is proc:\n589:                 _ACTIVE_BY_KEY.pop(key, None)\n590: \n591: \n592: def _send_signal(proc: Any, sig: int) -> None:\n593:     if getattr(proc, '_atlas_group', False) and hasattr(os, 'killpg'):\n594:         try:\n595:             os.killpg(os.getpgid(proc.pid), sig)\n596:             return\n597:         except (ProcessLookupError, PermissionError, OSError):\n598:             pass\n599:     try:\n600:         proc.send_signal(sig)\n601:     except (ProcessLookupError, OSError):\n602:         pass\n603: \n604: \n605: def stop_app(proc: Any, timeout: float = 10.0) -> None:\n606:     if proc is None:\n607:         return\n608:     try:\n609:         if proc.poll() is None:\n610:             _send_signal(proc, signal.SIGTERM)\n611:             try:\n612:                 proc.wait(timeout=float(timeout))\n613:             except subprocess.TimeoutExpired:\n614:                 _send_signal(proc, getattr(signal, 'SIGKILL', signal.SIGTERM))\n615:                 try:\n616:                     proc.wait(timeout=5.0)\n617:                 except (subprocess.TimeoutExpired, OSError):\n618:                     pass\n619:         else:\n620:             try:\n621:                 proc.wait(timeout=1.0)\n622:             except (subprocess.TimeoutExpired, OSError):\n623:                 pass\n624:     finally:\n625:         _close_log(proc)\n626:         _forget_active(proc)\n627: \n628: \n629: def free_port() -> int:\n630:     with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:\n631:         sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)\n632:         sock.bind(('127.0.0.1', 0))\n633:         return int(sock.getsockname()[1])\n634: \n635: \n636: def launch_app(app_root: str, data_dir: str, port: int, *, instance_dir: str | None = None,\n637:                fresh: bool = False, timeout: float = 30.0,\n638:                env: Mapping[str, str] | None = None) -> AppProcess:\n639:     root, script = _prepare_app_root(app_root)\n640:     data_root = _ensure_directory(data_dir, '--data-dir')\n641:     try:\n642:         numeric_port = int(port)\n643:     except (TypeError, ValueError) as exc:\n644:         raise AppStartError('port 必须是整数') from exc\n645:     if numeric_port <= 0:\n646:         numeric_port = free_port()\n647:     if numeric_port < 1 or numeric_port > 65535:\n648:         raise AppStartError('port 超出范围')\n649:     instances_root = _ensure_directory(os.path.join(data_root, 'instances'), '实例根目录')\n650:     key = (root, data_root)\n651:     with _REGISTRY_LOCK:\n652:         previous = _ACTIVE_BY_KEY.get(key)\n653:         if previous is not None and previous.poll() is None:\n654:             raise AppStartError('该 data_dir 已有运行中的实例，请先调用 stop_app')\n655:         if previous is not None:\n656:             _close_log(previous)\n657:             _ACTIVE_BY_KEY.pop(key, None)\n658:         if instance_dir is not None and fresh:\n659:             raise AppStartError('instance_dir 与 fresh 不能同时使用')\n660:         if instance_dir is not None:\n661:             scratch = _validate_instance(instances_root, instance_dir)\n662:         elif fresh or key not in _SCRATCH_BY_KEY or not os.path.isdir(_SCRATCH_BY_KEY[key]):\n663:             scratch = _new_instance(instances_root)\n664:         else:\n665:             scratch = _SCRATCH_BY_KEY[key]\n666:         _SCRATCH_BY_KEY[key] = scratch\n667:         logs_dir = _ensure_directory(os.path.join(scratch, 'logs'), '实例日志目录')\n668:         log_path = os.path.join(logs_dir, f'app-{int(time.time() * 1000)}-{uuid.uuid4().hex[:8]}.log')\n669:         log_handle = open(log_path, 'ab', buffering=0)\n670:         command = [\n671:             sys.executable or 'python3', script,\n672:             '--host', '127.0.0.1',\n673:             '--port', str(numeric_port),\n674:             '--data-dir', scratch,\n675:         ]\n676:         child_env = os.environ.copy()\n677:         if env:\n678:             child_env.update({str(name): str(value) for name, value in env.items()})\n679:         child_env['PYTHONUNBUFFERED'] = '1'\n680:         child_env['PYTHONDONTWRITEBYTECODE'] = '1'\n681:         for proxy_name in (\n682:             'HTTP_PROXY', 'HTTPS_PROXY', 'ALL_PROXY', 'NO_PROXY',\n683:             'http_proxy', 'https_proxy', 'all_proxy', 'no_proxy',\n684:         ):\n685:             child_env.pop(proxy_name, None)\n686:         try:\n687:             proc = AppProcess(\n688:                 command,\n689:                 base_url=f'http://127.0.0.1:{numeric_port}',\n690:                 scratch_dir=scratch,\n691:                 app_root=root,\n692:                 port=numeric_port,\n693:                 log_path=log_path,\n694:                 log_handle=log_handle,\n695:                 cwd=root,\n696:                 env=child_env,\n697:                 stdin=subprocess.DEVNULL,\n698:                 stdout=log_handle,\n699:                 stderr=subprocess.STDOUT,\n700:                 close_fds=True,\n701:                 start_new_session=(os.name == 'posix'),\n702:             )\n703:         except OSError as exc:\n704:             log_handle.close()\n705:             _SCRATCH_BY_KEY.pop(key, None)\n706:             raise AppStartError('无法启动应用进程') from exc\n707:         except Exception:\n708:             log_handle.close()\n709:             _SCRATCH_BY_KEY.pop(key, None)\n710:             raise\n711:         _ACTIVE_BY_KEY[key] = proc\n712:     try:\n713:         wait_health(proc.base_url, timeout=timeout, proc=proc)\n714:     except AppStartError as exc:\n715:         stop_app(proc)\n716:         with _REGISTRY_LOCK:\n717:             _SCRATCH_BY_KEY.pop(key, None)\n718:         raise AppStartError(f'{exc}；启动日志：{log_path}') from exc\n719:     except BaseException:\n720:         stop_app(proc)\n721:         raise\n722:     return proc\n723: \n724: \n725: def build_parser() -> argparse.ArgumentParser:\n726:     parser = argparse.ArgumentParser(\n727:         prog='acceptance',\n728:         description='Atlas 真实目标验收参数（python-web）',\n729:         allow_abbrev=False,\n730:         formatter_class=argparse.ArgumentDefaultsHelpFormatter,\n731:     )\n732:     parser.add_argument('--case', required=True, choices=sorted(KNOWN_CASES), help='验收用例 ID，如 A01')\n733:     parser.add_argument('--base-url', required=True, help='已部署应用的根 URL')\n734:     parser.add_argument('--app-root', help='只读应用源码根目录，用于重启持久化适配器')\n735:     parser.add_argument('--data-dir', help='验收者可变草稿目录；实例数据库位于其 instances 子目录')\n736:     return parser\n737: \n738: \n739: def parse_case_args(argv: list[str] | None = None) -> argparse.Namespace:\n740:     parser = build_parser()\n741:     args = parser.parse_args(argv)\n742:     try:\n743:         args.base_url = _normalize_base_url(args.base_url)\n744:     except ValueError as exc:\n745:         parser.error(f'--base-url 无效：{exc}')\n746:     args.case_id = args.case\n747:     if args.app_root:\n748:         args.app_root = os.path.abspath(os.path.expanduser(args.app_root))\n749:         if not os.path.isdir(args.app_root):\n750:             parser.error('--app-root 不存在或不是目录')\n751:     if args.data_dir:\n752:         args.data_dir = os.path.abspath(os.path.expanduser(args.data_dir))\n753:         if os.path.realpath(args.data_dir) == os.path.realpath(os.sep):\n754:             parser.error('--data-dir 不能是文件系统根目录')\n755:         try:\n756:             os.makedirs(args.data_dir, mode=0o700, exist_ok=True)\n757:         except OSError:\n758:             parser.error('--data-dir 无法创建')\n759:         if not os.path.isdir(args.data_dir):\n760:             parser.error('--data-dir 不是目录')\n761:         if not os.access(args.data_dir, os.W_OK):\n762:             parser.error('--data-dir 不可写')\n763:     if args.app_root and args.data_dir:\n764:         if os.path.realpath(args.app_root) == os.path.realpath(args.data_dir):\n765:             parser.error('--data-dir 不得与 --app-root 相同')\n766:     if args.case in RESTART_CASES:\n767:         if not args.app_root:\n768:             parser.error(f'--case {args.case} 需要 --app-root')\n769:         serve_script = os.path.join(args.app_root, 'app', 'serve.py')\n770:         if not os.path.isfile(serve_script):\n771:             parser.error('--app-root 中缺少 app/serve.py')\n772:         if not args.data_dir:\n773:             parser.error(f'--case {args.case} 需要 --data-dir')\n774:     if args.case in DATA_DIR_CASES and not args.data_dir:\n775:         parser.error(f'--case {args.case} 需要 --data-dir')\n776:     return args\n777: \n778: \n779: def _normalize_assertions(assertions: Any) -> list[dict[str, Any]]:\n780:     if hasattr(assertions, 'assertions'):\n781:         assertions = assertions.assertions\n782:     if assertions is None:\n783:         assertions = []\n784:     if isinstance(assertions, Mapping):\n785:         assertions = [assertions]\n786:     items: list[dict[str, Any]] = []\n787:     for index, item in enumerate(assertions, start=1):\n788:         if isinstance(item, Mapping):\n789:             raw_id = item.get('id')\n790:             passed = item.get('passed', False)\n791:             detail = item.get('detail', '')\n792:         elif isinstance(item, (tuple, list)) and len(item) >= 3:\n793:             raw_id, passed, detail = item[0], item[1], item[2]\n794:         else:\n795:             raise TypeError('断言必须是包含 id/passed/detail 的映射')\n796:         clean_id = _redact_text(raw_id, 120).strip() if raw_id is not None else ''\n797:         if not clean_id:\n798:             clean_id = f'assertion-{index}'\n799:         items.append({\n800:             'id': clean_id,\n801:             'passed': bool(passed),\n802:             'detail': _redact_text(detail, 1200),\n803:         })\n804:     return items\n805: \n806: \n807: def _fit_result(result: dict[str, Any]) -> str:\n808:     text = _json.dumps(result, ensure_ascii=False, separators=(',', ':'))\n809:     while len(text.encode('utf-8')) > 60000:\n810:         changed = False\n811:         for item in result['assertions']:\n812:             detail = item['detail']\n813:             if len(detail) > 40:\n814:                 item['detail'] = detail[:max(40, len(detail) // 2)]\n815:                 changed = True\n816:         if not changed:\n817:             for item in result['assertions']:\n818:                 if len(item['id']) > 24:\n819:                     item['id'] = item['id'][:24]\n820:                     changed = True\n821:         if not changed:\n822:             break\n823:         text = _json.dumps(result, ensure_ascii=False, separators=(',', ':'))\n824:     while len(text.encode('utf-8')) > 60000 and len(result['assertions']) > 1:\n825:         result['assertions'].pop()\n826:         text = _json.dumps(result, ensure_ascii=False, separators=(',', ':'))\n827:     return text\n828: \n829: \n830: def emit_result(case_id: str, assertions: Any, status: str | None = None) -> int:\n831:     if case_id is None or not str(case_id).strip():\n832:         raise ValueError('case_id 不能为空')\n833:     case_text = _redact_text(case_id, 120).strip()\n834:     items = _normalize_assertions(assertions)\n835:     has_failure = any(not item['passed'] for item in items)\n836:     if status is None:\n837:         final_status = 'failed' if has_failure or not items else 'passed'\n838:     else:\n839:         if status not in ('passed', 'failed', 'unverified'):\n840:             raise ValueError('status 只能是 passed、failed 或 unverified')\n841:         final_status = status\n842:         if has_failure:\n843:             final_status = 'failed'\n844:         elif not items and final_status == 'passed':\n845:             final_status = 'failed'\n846:     result = {\n847:         'schema': RESULT_SCHEMA,\n848:         'case_id': case_text,\n849:         'status': final_status,\n850:         'assertions': items,\n851:     }\n852:     text = _fit_result(result)\n853:     payload = (text + chr(10)).encode('utf-8')\n854:     buffer = getattr(sys.stdout, 'buffer', None)\n855:     if buffer is not None:\n856:         buffer.write(payload)\n857:         buffer.flush()\n858:     else:\n859:         sys.stdout.write(text + chr(10))\n860:         sys.stdout.flush()\n861:     failures = [item['id'] for item in items if not item['passed']]\n862:     if failures:\n863:         failure_text = ', '.join(failures)\n864:         print(f'[atlas] {case_text}: {final_status}; 失败断言: {failure_text}', file=sys.stderr, flush=True)\n865:     else:\n866:         print(f'[atlas] {case_text}: {final_status}; 断言 {len(items)} 条', file=sys.stderr, flush=True)\n867:     return 0 if final_status == 'passed' else 1\n868: \n869: \n870: class Recorder:\n871:     def __init__(self, case_id: str | None = None):\n872:         self.case_id = case_id\n873:         self.assertions: list[dict[str, Any]] = []\n874:         self.failed = False\n875: \n876:     @property\n877:     def ok(self) -> bool:\n878:         return not self.failed\n879: \n880:     @property\n881:     def passed(self) -> bool:\n882:         return bool(self.assertions) and not self.failed\n883: \n884:     def check(self, aid: Any, passed: Any, detail: Any = '') -> bool:\n885:         index = len(self.assertions) + 1\n886:         if aid is None:\n887:             clean_id = f'assertion-{index}'\n888:         else:\n889:             clean_id = _redact_text(aid, 120).strip() or f'assertion-{index}'\n890:         value = bool(passed)\n891:         if not value:\n892:             self.failed = True\n893:         detail_text = _redact_text(detail, 1200)\n894:         entry = {\n895:             'id': clean_id,\n896:             'passed': value,\n897:             'detail': detail_text,\n898:         }\n899:         self.assertions.append(entry)\n900:         state = 'PASS' if value else 'FAIL'\n901:         print(f'[{clean_id}] {state} {detail_text}', file=sys.stderr, flush=True)\n902:         return value\n903: \n904:     def expect_status(self, response: Any, expected: Any, aid: Any = None, detail: Any = None) -> Any:\n905:         if isinstance(expected, int) and not isinstance(expected, bool):\n906:             wanted = [int(expected)]\n907:         else:\n908:             wanted = [int(item) for item in expected]\n909:         actual = getattr(response, 'status', None)\n910:         if actual is None:\n911:             actual = getattr(response, 'status_code', None)\n912:         value = actual in wanted\n913:         if detail is None:\n914:             method = getattr(response, 'method', '?')\n915:             url = getattr(response, 'url', '?')\n916:             wanted_text = '/'.join(str(item) for item in wanted)\n917:             detail = f'{method} {url} -> HTTP {actual}（期望 {wanted_text}）'\n918:         index = len(self.assertions) + 1\n919:         self.check(aid if aid is not None else f'status-{index}', value, detail)\n920:         return response\n921: \n922:     def expect_json_field(self, response: Any, field: Any, expected: Any, aid: Any = None,\n923:                           detail: Any = None) -> Any:\n924:         index = len(self.assertions) + 1\n925:         try:\n926:             payload = response.json()\n927:         except Exception as exc:\n928:             self.check(aid if aid is not None else f'json-{index}', False,\n929:                        f'响应不是合法 JSON：{_redact_text(exc, 200)}')\n930:             return response\n931:         found, value = _lookup_path(payload, field)\n932:         actual_text = _short_repr(value) if found else '字段不存在'\n933:         passed = False\n934:         error_text = ''\n935:         if found:\n936:             try:\n937:                 if callable(expected):\n938:                     passed = bool(expected(value))\n939:                 elif isinstance(expected, re.Pattern):\n940:                     passed = bool(expected.search(str(value)))\n941:                 elif isinstance(expected, type):\n942:                     passed = isinstance(value, expected)\n943:                 else:\n944:                     passed = value == expected\n945:             except Exception as exc:\n946:                 error_text = _redact_text(exc, 200)\n947:         if detail is None:\n948:             detail = f'字段 {field} = {actual_text}（期望 {_short_repr(expected)}）'\n949:             if error_text:\n950:                 detail += f'；比较异常：{error_text}'\n951:         self.check(aid if aid is not None else f'json-{index}', passed, detail)\n952:         return response\n953: \n954:     def finish(self, case_id: str | None = None, status: str | None = None) -> int:\n955:         return emit_result(case_id or self.case_id or '', self.assertions, status=status)\n956: \n957: \n958: __all__ = [\n959:     'DEFAULT_CATEGORY',\n960:     'PRESET_CATEGORIES',\n961:     'RESULT_SCHEMA',\n962:     'AcceptanceError',\n963:     'AppProcess',\n964:     'AppStartError',\n965:     'ExternalNavigationBlocked',\n966:     'HttpClient',\n967:     'HttpRequestError',\n968:     'HttpResponse',\n969:     'Recorder',\n970:     'build_parser',\n971:     'emit_result',\n972:     'free_port',\n973:     'launch_app',\n974:     'parse_case_args',\n975:     'stop_app',\n976:     'wait_health',\n977: ]","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/milin/2026/软件开发/application-atlas/application-atlas-production-pack/atlas/template-factory/jobs/job_3a658ba085e8417ea6faad5cb0cdd493/attempt-2/blueprint-spec-review-0-ad1379367f3e742a-phase_acceptance/source/program-evidence/prepared/acceptance/common.py, lines 1-977\n1: '''Atlas 验收共享工具（Python 3.12 标准库）。\n2: \n3: 所有验收程序通过本模块与真实目标交互：HTTP 请求、断言记录、\n4: 独立实例启动与重启持久化适配器。模块不导入应用实现，也不读取\n5: 应用自己的测试判定。\n6: '''\n7: \n8: from __future__ import annotations\n9: \n10: import argparse\n11: import json as _json\n12: import os\n13: import re\n14: import signal\n15: import socket\n16: import subprocess\n17: import sys\n18: import threading\n19: import time\n20: import uuid\n21: from collections.abc import Mapping\n22: from http.client import HTTPException\n23: from typing import Any\n24: from urllib.error import HTTPError, URLError\n25: from urllib.parse import parse_qsl, urlencode, urljoin, urlsplit, urlunsplit\n26: from urllib.request import HTTPRedirectHandler, ProxyHandler, Request, build_opener\n27: \n28: _THIS_DIR = os.path.dirname(os.path.abspath(__file__))\n29: if _THIS_DIR not in sys.path:\n30:     sys.path.insert(0, _THIS_DIR)\n31: \n32: RESULT_SCHEMA = 'atlas.acceptance-result.v1'\n33: DEFAULT_CATEGORY = '未整理'\n34: PRESET_CATEGORIES = ('未整理', '待购', '家居改造', '以后看看')\n35: HEALTH_PATH = '/api/health'\n36: KNOWN_CASES = frozenset(f'A{i:02d}' for i in range(1, 16))\n37: RESTART_CASES = frozenset({'A01', 'A05', 'A09'})\n38: DATA_DIR_CASES = frozenset({'A01', 'A05', 'A09', 'A14'})\n39: \n40: _SENSITIVE_QUERY_KEYS = frozenset({\n41:     'token', 'access_token', 'password', 'passwd', 'secret', 'key',\n42:     'apikey', 'api_key', 'auth', 'authorization', 'session', 'cookie',\n43: })\n44: _URL_RE = re.compile(r'https?://\\S+')\n45: \n46: \n47: class AcceptanceError(RuntimeError):\n48:     '''验收基础设施或目标行为错误。'''\n49: \n50: \n51: class AppStartError(AcceptanceError):\n52:     '''应用实例无法启动或未就绪。'''\n53: \n54: \n55: class HttpRequestError(AcceptanceError):\n56:     '''真实 HTTP 请求失败。'''\n57: \n58: \n59: class ExternalNavigationBlocked(HttpRequestError):\n60:     '''请求或重定向离开被验收目标。'''\n61: \n62: \n63: def _redact_url(url: Any) -> str:\n64:     try:\n65:         parts = urlsplit(str(url))\n66:     except (TypeError, ValueError):\n67:         return '<invalid-url>'\n68:     try:\n69:         port = parts.port\n70:     except ValueError:\n71:         port = None\n72:     if parts.username is not None or parts.password is not None:\n73:         host = parts.hostname or ''\n74:         if ':' in host and not host.startswith('['):\n75:             host = f'[{host}]'\n76:         netloc = host\n77:         if port is not None:\n78:             netloc = f'{netloc}:{port}'\n79:     else:\n80:         netloc = parts.netloc\n81:     query = []\n82:     for key, value in parse_qsl(parts.query, keep_blank_values=True):\n83:         if key.lower() in _SENSITIVE_QUERY_KEYS:\n84:             query.append((key, '***'))\n85:         else:\n86:             query.append((key, value))\n87:     return urlunsplit((\n88:         parts.scheme,\n89:         netloc,\n90:         parts.path,\n91:         urlencode(query, doseq=True) if query else '',\n92:         parts.fragment,\n93:     ))\n94: \n95: \n96: def _redact_text(value: Any, limit: int = 1200) -> str:\n97:     text = str(value)\n98:     text = _URL_RE.sub(lambda match: _redact_url(match.group(0)), text)\n99:     if len(text) > limit:\n100:         text = text[:limit] + '…'\n101:     return text\n102: \n103: \n104: def _origin(url: str) -> tuple[str, str, int]:\n105:     parts = urlsplit(url)\n106:     scheme = parts.scheme.lower()\n107:     if scheme not in ('http', 'https'):\n108:         raise ValueError('仅支持 http/https')\n109:     if not parts.hostname:\n110:         raise ValueError('缺少主机名')\n111:     if parts.username is not None or parts.password is not None:\n112:         raise ValueError('不得包含凭据')\n113:     try:\n114:         port = parts.port\n115:     except ValueError as exc:\n116:         raise ValueError('端口无效') from exc\n117:     if port is None:\n118:         port = 443 if scheme == 'https' else 80\n119:     return (scheme, parts.hostname.lower(), port)\n120: \n121: \n122: def _normalize_base_url(url: str) -> str:\n123:     if not isinstance(url, str) or not url.strip():\n124:         raise ValueError('不能为空')\n125:     value = url.strip()\n126:     parts = urlsplit(value)\n127:     if parts.query or parts.fragment:\n128:         raise ValueError('不得包含查询参数或片段')\n129:     _origin(value)\n130:     return urlunsplit((parts.scheme.lower(), parts.netloc, parts.path.rstrip('/'), '', ''))\n131: \n132: \n133: def _has_header(headers: Mapping[str, Any], name: str) -> bool:\n134:     target = name.lower()\n135:     return any(str(key).lower() == target for key in headers)\n136: \n137: \n138: def _short_repr(value: Any, limit: int = 300) -> str:\n139:     try:\n140:         text = _json.dumps(value, ensure_ascii=False, default=str)\n141:     except (TypeError, ValueError):\n142:         text = repr(value)\n143:     if len(text) > limit:\n144:         text = text[:limit] + '…'\n145:     return _redact_text(text, limit + 10)\n146: \n147: \n148: def _lookup_path(value: Any, field: Any) -> tuple[bool, Any]:\n149:     if field is None or field == '' or field == '$':\n150:         parts: list[str] = []\n151:     elif isinstance(field, (list, tuple)):\n152:         parts = [str(part) for part in field]\n153:     else:\n154:         text = str(field)\n155:         if text.startswith('/'):\n156:             parts = [part.replace('~1', '/').replace('~0', '~') for part in text.split('/')[1:]]\n157:         else:\n158:             parts = text.split('.')\n159:     current = value\n160:     for part in parts:\n161:         if isinstance(current, Mapping):\n162:             if part not in current:\n163:                 return False, None\n164:             current = current[part]\n165:         elif isinstance(current, list):\n166:             try:\n167:                 index = int(part)\n168:             except ValueError:\n169:                 return False, None\n170:             if index < 0:\n171:                 index += len(current)\n172:             if index < 0 or index >= len(current):\n173:                 return False, None\n174:             current = current[index]\n175:         else:\n176:             return False, None\n177:     return True, current\n178: \n179: \n180: class HttpResponse:\n181:     def __init__(self, status: int, headers: Any, body: bytes, method: str, url: str, elapsed: float = 0.0):\n182:         self.status = int(status)\n183:         self.headers = headers if headers is not None else {}\n184:         self.body = body or b''\n185:         self.method = method\n186:         self.url = _redact_url(url)\n187:         self.elapsed = elapsed\n188: \n189:     @property\n190:     def status_code(self) -> int:\n191:         return self.status\n192: \n193:     @property\n194:     def code(self) -> int:\n195:         return self.status\n196: \n197:     @property\n198:     def ok(self) -> bool:\n199:         return 200 <= self.status < 300\n200: \n201:     def header(self, name: str, default: Any = None) -> Any:\n202:         try:\n203:             value = self.headers.get(name)\n204:         except AttributeError:\n205:             value = None\n206:         if value is not None:\n207:             return value\n208:         try:\n209:             items = self.headers.items()\n210:         except AttributeError:\n211:             return default\n212:         target = name.lower()\n213:         for key, item in items:\n214:             if str(key).lower() == target:\n215:                 return item\n216:         return default\n217: \n218:     @property\n219:     def location(self) -> str | None:\n220:         value = self.header('Location')\n221:         return None if value is None else str(value)\n222: \n223:     @property\n224:     def content_type(self) -> str:\n225:         return str(self.header('Content-Type') or '')\n226: \n227:     @property\n228:     def text(self) -> str:\n229:         content_type = self.content_type\n230:         match = re.search(r'charset=([\\w.-]+)', content_type, re.IGNORECASE)\n231:         charset = match.group(1) if match else 'utf-8'\n232:         if charset.lower().replace('_', '-') in ('utf-8', 'utf8'):\n233:             charset = 'utf-8-sig'\n234:         try:\n235:             return self.body.decode(charset, 'replace')\n236:         except LookupError:\n237:             return self.body.decode('utf-8', 'replace')\n238: \n239:     def json(self) -> Any:\n240:         return _json.loads(self.text)\n241: \n242:     def get_json(self) -> Any:\n243:         return self.json()\n244: \n245:     def __repr__(self) -> str:\n246:         return f'<HttpResponse {self.status} {self.method} {self.url}>'\n247: \n248: \n249: class _NoRedirectHandler(HTTPRedirectHandler):\n250:     def redirect_request(self, req, fp, code, msg, headers, newurl):\n251:         return None\n252: \n253: \n254: class HttpClient:\n255:     def __init__(self, base_url: str, timeout: float = 20.0, follow_redirects: bool = True):\n256:         self.base_url = _normalize_base_url(base_url)\n257:         self.origin = _origin(self.base_url)\n258:         self.timeout = float(timeout)\n259:         self.follow_redirects = bool(follow_redirects)\n260:         self._opener = build_opener(_NoRedirectHandler(), ProxyHandler({}))\n261: \n262:     def close(self) -> None:\n263:         return None\n264: \n265:     def __enter__(self) -> 'HttpClient':\n266:         return self\n267: \n268:     def __exit__(self, exc_type, exc, traceback) -> bool:\n269:         self.close()\n270:         return False\n271: \n272:     def _build_url(self, path: Any, params: Any) -> str:\n273:         text = '' if path is None else str(path)\n274:         parts = urlsplit(text)\n275:         if parts.scheme:\n276:             if parts.scheme.lower() not in ('http', 'https'):\n277:                 raise ExternalNavigationBlocked(f'拒绝非 http/https URL：{_redact_url(text)}')\n278:             try:\n279:                 absolute_origin = _origin(text)\n280:             except ValueError as exc:\n281:                 raise ExternalNavigationBlocked(f'拒绝无效 URL：{_redact_url(text)}') from exc\n282:             if absolute_origin != self.origin:\n283:                 raise ExternalNavigationBlocked(f'拒绝访问目标以外的 URL：{_redact_url(text)}')\n284:             url = text\n285:         elif parts.netloc:\n286:             raise ExternalNavigationBlocked('拒绝协议相对 URL')\n287:         elif text.startswith('?'):\n288:             url = self.base_url + text\n289:         elif text.startswith('/'):\n290:             url = self.base_url + text\n291:         elif text:\n292:             url = self.base_url + '/' + text\n293:         else:\n294:             url = self.base_url\n295:         final = urlsplit(url)\n296:         query = final.query\n297:         if params:\n298:             pairs = parse_qsl(query, keep_blank_values=True)\n299:             if isinstance(params, Mapping):\n300:                 pairs.extend(params.items())\n301:             else:\n302:                 pairs.extend(params)\n303:             query = urlencode(pairs, doseq=True)\n304:         return urlunsplit((final.scheme, final.netloc, final.path, query, ''))\n305: \n306:     def request(self, method: str, path: str = '', *, params: Any = None, headers: Any = None,\n307:                 json: Any = None, data: Any = None, form: Any = None, accept: str | None = None,\n308:                 follow_redirects: bool | None = None, timeout: float | None = None,\n309:                 max_redirects: int = 5) -> HttpResponse:\n310:         current_method = str(method).upper()\n311:         if current_method not in ('GET', 'POST', 'PATCH', 'PUT', 'DELETE', 'HEAD', 'OPTIONS'):\n312:             raise ValueError('不支持的 HTTP 方法')\n313:         body_kinds = (json is not None, data is not None, form is not None)\n314:         if sum(1 for flag in body_kinds if flag) > 1:\n315:             raise ValueError('json、data 与 form 只能提供一个')\n316:         body: bytes | None = None\n317:         content_type: str | None = None\n318:         if json is not None:\n319:             body = _json.dumps(json, ensure_ascii=False, separators=(',', ':')).encode('utf-8')\n320:             content_type = 'application/json; charset=utf-8'\n321:         elif form is not None:\n322:             pairs = form.items() if isinstance(form, Mapping) else form\n323:             body = urlencode(list(pairs), doseq=True).encode('utf-8')\n324:             content_type = 'application/x-www-form-urlencoded; charset=utf-8'\n325:         elif data is not None:\n326:             if isinstance(data, str):\n327:                 body = data.encode('utf-8')\n328:             elif isinstance(data, (bytes, bytearray)):\n329:                 body = bytes(data)\n330:             else:\n331:                 raise TypeError('data 必须是 str 或 bytes')\n332:         prepared = {str(key): str(value) for key, value in (headers or {}).items()}\n333:         for key in prepared:\n334:             if key.lower() in ('authorization', 'proxy-authorization'):\n335:                 raise ValueError('目标不需要认证，不支持认证头')\n336:         if not _has_header(prepared, 'Accept'):\n337:             prepared['Accept'] = accept or 'application/json'\n338:         if not _has_header(prepared, 'User-Agent'):\n339:             prepared['User-Agent'] = 'atlas-acceptance/1.0'\n340:         if not _has_header(prepared, 'Accept-Encoding'):\n341:             prepared['Accept-Encoding'] = 'identity'\n342:         if body is not None and content_type and not _has_header(prepared, 'Content-Type'):\n343:             prepared['Content-Type'] = content_type\n344:         follow = self.follow_redirects if follow_redirects is None else bool(follow_redirects)\n345:         resolved_timeout = self.timeout if timeout is None else float(timeout)\n346:         current_url = self._build_url(path, params)\n347:         current_body = body\n348:         current_headers = prepared\n349:         redirects = 0\n350:         while True:\n351:             request = Request(\n352:                 current_url,\n353:                 data=current_body if current_method not in ('GET', 'HEAD') else None,\n354:                 headers=current_headers,\n355:                 method=current_method,\n356:             )\n357:             started = time.monotonic()\n358:             try:\n359:                 with self._opener.open(request, timeout=resolved_timeout) as raw:\n360:                     status = int(getattr(raw, 'status', raw.getcode()))\n361:                     response_headers = raw.headers\n362:                     response_body = raw.read()\n363:             except HTTPError as exc:\n364:                 status = int(exc.code)\n365:                 response_headers = exc.headers if exc.headers is not None else {}\n366:                 try:\n367:                     response_body = exc.read()\n368:                 except Exception:\n369:                     response_body = b''\n370:                 finally:\n371:                     try:\n372:                         exc.close()\n373:                     except Exception:\n374:                         pass\n375:             except (URLError, HTTPException, TimeoutError, OSError, ValueError) as exc:\n376:                 reason = getattr(exc, 'reason', exc)\n377:                 raise HttpRequestError(\n378:                     f'{current_method} {_redact_url(current_url)} 请求失败：{_redact_text(reason, 300)}'\n379:                 ) from exc\n380:             elapsed = time.monotonic() - started\n381:             response = HttpResponse(status, response_headers, response_body, current_method, current_url, elapsed)\n382:             if not follow or status not in (301, 302, 303, 307, 308):\n383:                 return response\n384:             location = response.location\n385:             if not location:\n386:                 return response\n387:             if redirects >= max_redirects:\n388:                 raise HttpRequestError(f'重定向次数超过 {max_redirects}：{_redact_url(current_url)}')\n389:             redirects += 1\n390:             next_url = urljoin(current_url, location.strip())\n391:             try:\n392:                 next_origin = _origin(next_url)\n393:             except ValueError as exc:\n394:                 raise ExternalNavigationBlocked(f'拒绝重定向到无效目标：{_redact_url(next_url)}') from exc\n395:             if next_origin != self.origin:\n396:                 raise ExternalNavigationBlocked(f'拒绝跨源重定向：{_redact_url(next_url)}')\n397:             if status == 303 or (status in (301, 302) and current_method == 'POST'):\n398:                 current_method = 'GET'\n399:                 current_body = None\n400:                 current_headers = {\n401:                     key: value for key, value in current_headers.items()\n402:                     if key.lower() not in ('content-type', 'content-length')\n403:                 }\n404:             current_url = next_url\n405: \n406:     def get(self, path: str = '', *, params: Any = None, headers: Any = None,\n407:             accept: str | None = None, follow_redirects: bool | None = None,\n408:             timeout: float | None = None) -> HttpResponse:\n409:         return self.request('GET', path, params=params, headers=headers, accept=accept,\n410:                             follow_redirects=follow_redirects, timeout=timeout)\n411: \n412:     def post_form(self, path: str, fields: Any, *, headers: Any = None, accept: str | None = None,\n413:                   follow_redirects: bool | None = None, timeout: float | None = None) -> HttpResponse:\n414:         return self.request('POST', path, form=fields, headers=headers, accept=accept,\n415:                             follow_redirects=follow_redirects, timeout=timeout)\n416: \n417:     def post_json(self, path: str, payload: Any, *, headers: Any = None, accept: str | None = None,\n418:                   follow_redirects: bool | None = None, timeout: float | None = None) -> HttpResponse:\n419:         return self.request('POST', path, json=payload, headers=headers, accept=accept,\n420:                             follow_redirects=follow_redirects, timeout=timeout)\n421: \n422:     def patch_json(self, path: str, payload: Any, *, headers: Any = None, accept: str | None = None,\n423:                    follow_redirects: bool | None = None, timeout: float | None = None) -> HttpResponse:\n424:         return self.request('PATCH', path, json=payload, headers=headers, accept=accept,\n425:                             follow_redirects=follow_redirects, timeout=timeout)\n426: \n427: \n428: class AppProcess(subprocess.Popen):\n429:     def __init__(self, args, *, base_url: str, scratch_dir: str, app_root: str, port: int,\n430:                  log_path: str, log_handle: Any, **kwargs):\n431:         super().__init__(args, **kwargs)\n432:         self.base_url = base_url\n433:         self.scratch_dir = scratch_dir\n434:         self.app_root = app_root\n435:         self.port = port\n436:         self.log_path = log_path\n437:         self.log_handle = log_handle\n438:         self._atlas_group = bool(kwargs.get('start_new_session')) and os.name == 'posix'\n439: \n440:     @property\n441:     def instance_dir(self) -> str:\n442:         return self.scratch_dir\n443: \n444:     @property\n445:     def process(self) -> 'AppProcess':\n446:         return self\n447: \n448:     def __iter__(self):\n449:         yield self\n450:         yield self.base_url\n451:         yield self.scratch_dir\n452: \n453:     def stop(self, timeout: float = 10.0) -> None:\n454:         stop_app(self, timeout=timeout)\n455: \n456:     def __enter__(self) -> 'AppProcess':\n457:         return self\n458: \n459:     def __exit__(self, exc_type, exc, traceback) -> bool:\n460:         stop_app(self)\n461:         return False\n462: \n463: \n464: _REGISTRY_LOCK = threading.RLock()\n465: _SCRATCH_BY_KEY: dict[tuple[str, str], str] = {}\n466: _ACTIVE_BY_KEY: dict[tuple[str, str], AppProcess] = {}\n467: \n468: \n469: def _tail(path: Any, limit: int = 4000) -> str:\n470:     if not path:\n471:         return ''\n472:     try:\n473:         with open(str(path), 'rb') as handle:\n474:             handle.seek(0, os.SEEK_END)\n475:             position = handle.tell()\n476:             handle.seek(max(0, position - limit))\n477:             data = handle.read()\n478:     except OSError:\n479:         return ''\n480:     return _redact_text(data.decode('utf-8', 'replace'), limit)\n481: \n482: \n483: def wait_health(base_url: str, timeout: float = 30.0, proc: AppProcess | None = None) -> bool:\n484:     base = _normalize_base_url(base_url)\n485:     deadline = time.monotonic() + max(0.0, float(timeout))\n486:     last_error = '尚未收到健康响应'\n487:     while True:\n488:         if proc is not None and proc.poll() is not None:\n489:             tail = _tail(getattr(proc, 'log_path', None))\n490:             suffix = f'；日志尾部：{tail}' if tail else ''\n491:             raise AppStartError(f'应用进程在就绪前退出（code={proc.returncode}）{suffix}')\n492:         remaining = deadline - time.monotonic()\n493:         try:\n494:             client = HttpClient(base, timeout=max(0.5, min(2.0, remaining if remaining > 0 else 0.5)))\n495:             response = client.get(HEALTH_PATH)\n496:             if response.status == 200:\n497:                 try:\n498:                     payload = response.json()\n499:                 except Exception as exc:\n500:                     last_error = f'健康检查返回非 JSON：{_redact_text(exc, 200)}'\n501:                 else:\n502:                     if isinstance(payload, dict):\n503:                         return True\n504:                     last_error = '健康检查 JSON 不是对象'\n505:             elif response.status in (401, 403):\n506:                 raise AppStartError('目标要求认证，当前验收适配器不支持认证')\n507:             else:\n508:                 last_error = f'健康检查返回 HTTP {response.status}'\n509:         except AppStartError:\n510:             raise\n511:         except Exception as exc:\n512:             last_error = _redact_text(exc, 300)\n513:         if time.monotonic() >= deadline:\n514:             break\n515:         time.sleep(min(0.2, max(0.02, deadline - time.monotonic())))\n516:     tail = _tail(getattr(proc, 'log_path', None)) if proc is not None else ''\n517:     message = f'等待 {_redact_url(base)}/api/health 就绪超时：{last_error}'\n518:     if tail:\n519:         message += f'；日志尾部：{tail}'\n520:     raise AppStartError(message)\n521: \n522: \n523: def _prepare_app_root(app_root: Any) -> tuple[str, str]:\n524:     if not app_root:\n525:         raise AppStartError('--app-root 不能为空')\n526:     root = os.path.realpath(os.path.abspath(os.path.expanduser(str(app_root))))\n527:     if not os.path.isdir(root):\n528:         raise AppStartError('--app-root 不存在或不是目录')\n529:     script = os.path.join(root, 'app', 'serve.py')\n530:     if not os.path.isfile(script):\n531:         raise AppStartError('--app-root 中缺少 app/serve.py')\n532:     return root, script\n533: \n534: \n535: def _ensure_directory(path: Any, label: str) -> str:\n536:     if not path:\n537:         raise AppStartError(f'{label} 不能为空')\n538:     target = os.path.realpath(os.path.abspath(os.path.expanduser(str(path))))\n539:     try:\n540:         os.makedirs(target, mode=0o700, exist_ok=True)\n541:     except OSError as exc:\n542:         raise AppStartError(f'{label} 无法创建') from exc\n543:     if not os.path.isdir(target):\n544:         raise AppStartError(f'{label} 不是目录')\n545:     return target\n546: \n547: \n548: def _new_instance(instances_root: str) -> str:\n549:     path = os.path.join(instances_root, uuid.uuid4().hex)\n550:     try:\n551:         os.makedirs(path, mode=0o700, exist_ok=False)\n552:     except OSError as exc:\n553:         raise AppStartError('无法创建每实例隔离 scratch') from exc\n554:     return os.path.realpath(path)\n555: \n556: \n557: def _validate_instance(instances_root: str, instance_dir: str) -> str:\n558:     candidate = os.path.realpath(os.path.abspath(os.path.expanduser(str(instance_dir))))\n559:     try:\n560:         common = os.path.commonpath([instances_root, candidate])\n561:     except ValueError as exc:\n562:         raise AppStartError('实例目录必须位于 data_dir/instances 下') from exc\n563:     if common != instances_root or candidate == instances_root:\n564:         raise AppStartError('实例目录必须位于 data_dir/instances 下')\n565:     try:\n566:         os.makedirs(candidate, mode=0o700, exist_ok=True)\n567:     except OSError as exc:\n568:         raise AppStartError('无法创建实例目录') from exc\n569:     return candidate\n570: \n571: \n572: def _close_log(proc: Any) -> None:\n573:     handle = getattr(proc, 'log_handle', None)\n574:     if handle is not None:\n575:         try:\n576:             handle.close()\n577:         except Exception:\n578:             pass\n579:         try:\n580:             proc.log_handle = None\n581:         except Exception:\n582:             pass\n583: \n584: \n585: def _forget_active(proc: Any) -> None:\n586:     with _REGISTRY_LOCK:\n587:         for key, active in list(_ACTIVE_BY_KEY.items()):\n588:             if active is proc:\n589:                 _ACTIVE_BY_KEY.pop(key, None)\n590: \n591: \n592: def _send_signal(proc: Any, sig: int) -> None:\n593:     if getattr(proc, '_atlas_group', False) and hasattr(os, 'killpg'):\n594:         try:\n595:             os.killpg(os.getpgid(proc.pid), sig)\n596:             return\n597:         except (ProcessLookupError, PermissionError, OSError):\n598:             pass\n599:     try:\n600:         proc.send_signal(sig)\n601:     except (ProcessLookupError, OSError):\n602:         pass\n603: \n604: \n605: def stop_app(proc: Any, timeout: float = 10.0) -> None:\n606:     if proc is None:\n607:         return\n608:     try:\n609:         if proc.poll() is None:\n610:             _send_signal(proc, signal.SIGTERM)\n611:             try:\n612:                 proc.wait(timeout=float(timeout))\n613:             except subprocess.TimeoutExpired:\n614:                 _send_signal(proc, getattr(signal, 'SIGKILL', signal.SIGTERM))\n615:                 try:\n616:                     proc.wait(timeout=5.0)\n617:                 except (subprocess.TimeoutExpired, OSError):\n618:                     pass\n619:         else:\n620:             try:\n621:                 proc.wait(timeout=1.0)\n622:             except (subprocess.TimeoutExpired, OSError):\n623:                 pass\n624:     finally:\n625:         _close_log(proc)\n626:         _forget_active(proc)\n627: \n628: \n629: def free_port() -> int:\n630:     with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:\n631:         sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)\n632:         sock.bind(('127.0.0.1', 0))\n633:         return int(sock.getsockname()[1])\n634: \n635: \n636: def launch_app(app_root: str, data_dir: str, port: int, *, instance_dir: str | None = None,\n637:                fresh: bool = False, timeout: float = 30.0,\n638:                env: Mapping[str, str] | None = None) -> AppProcess:\n639:     root, script = _prepare_app_root(app_root)\n640:     data_root = _ensure_directory(data_dir, '--data-dir')\n641:     try:\n642:         numeric_port = int(port)\n643:     except (TypeError, ValueError) as exc:\n644:         raise AppStartError('port 必须是整数') from exc\n645:     if numeric_port <= 0:\n646:         numeric_port = free_port()\n647:     if numeric_port < 1 or numeric_port > 65535:\n648:         raise AppStartError('port 超出范围')\n649:     instances_root = _ensure_directory(os.path.join(data_root, 'instances'), '实例根目录')\n650:     key = (root, data_root)\n651:     with _REGISTRY_LOCK:\n652:         previous = _ACTIVE_BY_KEY.get(key)\n653:         if previous is not None and previous.poll() is None:\n654:             raise AppStartError('该 data_dir 已有运行中的实例，请先调用 stop_app')\n655:         if previous is not None:\n656:             _close_log(previous)\n657:             _ACTIVE_BY_KEY.pop(key, None)\n658:         if instance_dir is not None and fresh:\n659:             raise AppStartError('instance_dir 与 fresh 不能同时使用')\n660:         if instance_dir is not None:\n661:             scratch = _validate_instance(instances_root, instance_dir)\n662:         elif fresh or key not in _SCRATCH_BY_KEY or not os.path.isdir(_SCRATCH_BY_KEY[key]):\n663:             scratch = _new_instance(instances_root)\n664:         else:\n665:             scratch = _SCRATCH_BY_KEY[key]\n666:         _SCRATCH_BY_KEY[key] = scratch\n667:         logs_dir = _ensure_directory(os.path.join(scratch, 'logs'), '实例日志目录')\n668:         log_path = os.path.join(logs_dir, f'app-{int(time.time() * 1000)}-{uuid.uuid4().hex[:8]}.log')\n669:         log_handle = open(log_path, 'ab', buffering=0)\n670:         command = [\n671:             sys.executable or 'python3', script,\n672:             '--host', '127.0.0.1',\n673:             '--port', str(numeric_port),\n674:             '--data-dir', scratch,\n675:         ]\n676:         child_env = os.environ.copy()\n677:         if env:\n678:             child_env.update({str(name): str(value) for name, value in env.items()})\n679:         child_env['PYTHONUNBUFFERED'] = '1'\n680:         child_env['PYTHONDONTWRITEBYTECODE'] = '1'\n681:         for proxy_name in (\n682:             'HTTP_PROXY', 'HTTPS_PROXY', 'ALL_PROXY', 'NO_PROXY',\n683:             'http_proxy', 'https_proxy', 'all_proxy', 'no_proxy',\n684:         ):\n685:             child_env.pop(proxy_name, None)\n686:         try:\n687:             proc = AppProcess(\n688:                 command,\n689:                 base_url=f'http://127.0.0.1:{numeric_port}',\n690:                 scratch_dir=scratch,\n691:                 app_root=root,\n692:                 port=numeric_port,\n693:                 log_path=log_path,\n694:                 log_handle=log_handle,\n695:                 cwd=root,\n696:                 env=child_env,\n697:                 stdin=subprocess.DEVNULL,\n698:                 stdout=log_handle,\n699:                 stderr=subprocess.STDOUT,\n700:                 close_fds=True,\n701:                 start_new_session=(os.name == 'posix'),\n702:             )\n703:         except OSError as exc:\n704:             log_handle.close()\n705:             _SCRATCH_BY_KEY.pop(key, None)\n706:             raise AppStartError('无法启动应用进程') from exc\n707:         except Exception:\n708:             log_handle.close()\n709:             _SCRATCH_BY_KEY.pop(key, None)\n710:             raise\n711:         _ACTIVE_BY_KEY[key] = proc\n712:     try:\n713:         wait_health(proc.base_url, timeout=timeout, proc=proc)\n714:     except AppStartError as exc:\n715:         stop_app(proc)\n716:         with _REGISTRY_LOCK:\n717:             _SCRATCH_BY_KEY.pop(key, None)\n718:         raise AppStartError(f'{exc}；启动日志：{log_path}') from exc\n719:     except BaseException:\n720:         stop_app(proc)\n721:         raise\n722:     return proc\n723: \n724: \n725: def build_parser() -> argparse.ArgumentParser:\n726:     parser = argparse.ArgumentParser(\n727:         prog='acceptance',\n728:         description='Atlas 真实目标验收参数（python-web）',\n729:         allow_abbrev=False,\n730:         formatter_class=argparse.ArgumentDefaultsHelpFormatter,\n731:     )\n732:     parser.add_argument('--case', required=True, choices=sorted(KNOWN_CASES), help='验收用例 ID，如 A01')\n733:     parser.add_argument('--base-url', required=True, help='已部署应用的根 URL')\n734:     parser.add_argument('--app-root', help='只读应用源码根目录，用于重启持久化适配器')\n735:     parser.add_argument('--data-dir', help='验收者可变草稿目录；实例数据库位于其 instances 子目录')\n736:     return parser\n737: \n738: \n739: def parse_case_args(argv: list[str] | None = None) -> argparse.Namespace:\n740:     parser = build_parser()\n741:     args = parser.parse_args(argv)\n742:     try:\n743:         args.base_url = _normalize_base_url(args.base_url)\n744:     except ValueError as exc:\n745:         parser.error(f'--base-url 无效：{exc}')\n746:     args.case_id = args.case\n747:     if args.app_root:\n748:         args.app_root = os.path.abspath(os.path.expanduser(args.app_root))\n749:         if not os.path.isdir(args.app_root):\n750:             parser.error('--app-root 不存在或不是目录')\n751:     if args.data_dir:\n752:         args.data_dir = os.path.abspath(os.path.expanduser(args.data_dir))\n753:         if os.path.realpath(args.data_dir) == os.path.realpath(os.sep):\n754:             parser.error('--data-dir 不能是文件系统根目录')\n755:         try:\n756:             os.makedirs(args.data_dir, mode=0o700, exist_ok=True)\n757:         except OSError:\n758:             parser.error('--data-dir 无法创建')\n759:         if not os.path.isdir(args.data_dir):\n760:             parser.error('--data-dir 不是目录')\n761:         if not os.access(args.data_dir, os.W_OK):\n762:             parser.error('--data-dir 不可写')\n763:     if args.app_root and args.data_dir:\n764:         if os.path.realpath(args.app_root) == os.path.realpath(args.data_dir):\n765:             parser.error('--data-dir 不得与 --app-root 相同')\n766:     if args.case in RESTART_CASES:\n767:         if not args.app_root:\n768:             parser.error(f'--case {args.case} 需要 --app-root')\n769:         serve_script = os.path.join(args.app_root, 'app', 'serve.py')\n770:         if not os.path.isfile(serve_script):\n771:             parser.error('--app-root 中缺少 app/serve.py')\n772:         if not args.data_dir:\n773:             parser.error(f'--case {args.case} 需要 --data-dir')\n774:     if args.case in DATA_DIR_CASES and not args.data_dir:\n775:         parser.error(f'--case {args.case} 需要 --data-dir')\n776:     return args\n777: \n778: \n779: def _normalize_assertions(assertions: Any) -> list[dict[str, Any]]:\n780:     if hasattr(assertions, 'assertions'):\n781:         assertions = assertions.assertions\n782:     if assertions is None:\n783:         assertions = []\n784:     if isinstance(assertions, Mapping):\n785:         assertions = [assertions]\n786:     items: list[dict[str, Any]] = []\n787:     for index, item in enumerate(assertions, start=1):\n788:         if isinstance(item, Mapping):\n789:             raw_id = item.get('id')\n790:             passed = item.get('passed', False)\n791:             detail = item.get('detail', '')\n792:         elif isinstance(item, (tuple, list)) and len(item) >= 3:\n793:             raw_id, passed, detail = item[0], item[1], item[2]\n794:         else:\n795:             raise TypeError('断言必须是包含 id/passed/detail 的映射')\n796:         clean_id = _redact_text(raw_id, 120).strip() if raw_id is not None else ''\n797:         if not clean_id:\n798:             clean_id = f'assertion-{index}'\n799:         items.append({\n800:             'id': clean_id,\n801:             'passed': bool(passed),\n802:             'detail': _redact_text(detail, 1200),\n803:         })\n804:     return items\n805: \n806: \n807: def _fit_result(result: dict[str, Any]) -> str:\n808:     text = _json.dumps(result, ensure_ascii=False, separators=(',', ':'))\n809:     while len(text.encode('utf-8')) > 60000:\n810:         changed = False\n811:         for item in result['assertions']:\n812:             detail = item['detail']\n813:             if len(detail) > 40:\n814:                 item['detail'] = detail[:max(40, len(detail) // 2)]\n815:                 changed = True\n816:         if not changed:\n817:             for item in result['assertions']:\n818:                 if len(item['id']) > 24:\n819:                     item['id'] = item['id'][:24]\n820:                     changed = True\n821:         if not changed:\n822:             break\n823:         text = _json.dumps(result, ensure_ascii=False, separators=(',', ':'))\n824:     while len(text.encode('utf-8')) > 60000 and len(result['assertions']) > 1:\n825:         result['assertions'].pop()\n826:         text = _json.dumps(result, ensure_ascii=False, separators=(',', ':'))\n827:     return text\n828: \n829: \n830: def emit_result(case_id: str, assertions: Any, status: str | None = None) -> int:\n831:     if case_id is None or not str(case_id).strip():\n832:         raise ValueError('case_id 不能为空')\n833:     case_text = _redact_text(case_id, 120).strip()\n834:     items = _normalize_assertions(assertions)\n835:     has_failure = any(not item['passed'] for item in items)\n836:     if status is None:\n837:         final_status = 'failed' if has_failure or not items else 'passed'\n838:     else:\n839:         if status not in ('passed', 'failed', 'unverified'):\n840:             raise ValueError('status 只能是 passed、failed 或 unverified')\n841:         final_status = status\n842:         if has_failure:\n843:             final_status = 'failed'\n844:         elif not items and final_status == 'passed':\n845:             final_status = 'failed'\n846:     result = {\n847:         'schema': RESULT_SCHEMA,\n848:         'case_id': case_text,\n849:         'status': final_status,\n850:         'assertions': items,\n851:     }\n852:     text = _fit_result(result)\n853:     payload = (text + chr(10)).encode('utf-8')\n854:     buffer = getattr(sys.stdout, 'buffer', None)\n855:     if buffer is not None:\n856:         buffer.write(payload)\n857:         buffer.flush()\n858:     else:\n859:         sys.stdout.write(text + chr(10))\n860:         sys.stdout.flush()\n861:     failures = [item['id'] for item in items if not item['passed']]\n862:     if failures:\n863:         failure_text = ', '.join(failures)\n864:         print(f'[atlas] {case_text}: {final_status}; 失败断言: {failure_text}', file=sys.stderr, flush=True)\n865:     else:\n866:         print(f'[atlas] {case_text}: {final_status}; 断言 {len(items)} 条', file=sys.stderr, flush=True)\n867:     return 0 if final_status == 'passed' else 1\n868: \n869: \n870: class Recorder:\n871:     def __init__(self, case_id: str | None = None):\n872:         self.case_id = case_id\n873:         self.assertions: list[dict[str, Any]] = []\n874:         self.failed = False\n875: \n876:     @property\n877:     def ok(self) -> bool:\n878:         return not self.failed\n879: \n880:     @property\n881:     def passed(self) -> bool:\n882:         return bool(self.assertions) and not self.failed\n883: \n884:     def check(self, aid: Any, passed: Any, detail: Any = '') -> bool:\n885:         index = len(self.assertions) + 1\n886:         if aid is None:\n887:             clean_id = f'assertion-{index}'\n888:         else:\n889:             clean_id = _redact_text(aid, 120).strip() or f'assertion-{index}'\n890:         value = bool(passed)\n891:         if not value:\n892:             self.failed = True\n893:         detail_text = _redact_text(detail, 1200)\n894:         entry = {\n895:             'id': clean_id,\n896:             'passed': value,\n897:             'detail': detail_text,\n898:         }\n899:         self.assertions.append(entry)\n900:         state = 'PASS' if value else 'FAIL'\n901:         print(f'[{clean_id}] {state} {detail_text}', file=sys.stderr, flush=True)\n902:         return value\n903: \n904:     def expect_status(self, response: Any, expected: Any, aid: Any = None, detail: Any = None) -> Any:\n905:         if isinstance(expected, int) and not isinstance(expected, bool):\n906:             wanted = [int(expected)]\n907:         else:\n908:             wanted = [int(item) for item in expected]\n909:         actual = getattr(response, 'status', None)\n910:         if actual is None:\n911:             actual = getattr(response, 'status_code', None)\n912:         value = actual in wanted\n913:         if detail is None:\n914:             method = getattr(response, 'method', '?')\n915:             url = getattr(response, 'url', '?')\n916:             wanted_text = '/'.join(str(item) for item in wanted)\n917:             detail = f'{method} {url} -> HTTP {actual}（期望 {wanted_text}）'\n918:         index = len(self.assertions) + 1\n919:         self.check(aid if aid is not None else f'status-{index}', value, detail)\n920:         return response\n921: \n922:     def expect_json_field(self, response: Any, field: Any, expected: Any, aid: Any = None,\n923:                           detail: Any = None) -> Any:\n924:         index = len(self.assertions) + 1\n925:         try:\n926:             payload = response.json()\n927:         except Exception as exc:\n928:             self.check(aid if aid is not None else f'json-{index}', False,\n929:                        f'响应不是合法 JSON：{_redact_text(exc, 200)}')\n930:             return response\n931:         found, value = _lookup_path(payload, field)\n932:         actual_text = _short_repr(value) if found else '字段不存在'\n933:         passed = False\n934:         error_text = ''\n935:         if found:\n936:             try:\n937:                 if callable(expected):\n938:                     passed = bool(expected(value))\n939:                 elif isinstance(expected, re.Pattern):\n940:                     passed = bool(expected.search(str(value)))\n941:                 elif isinstance(expected, type):\n942:                     passed = isinstance(value, expected)\n943:                 else:\n944:                     passed = value == expected\n945:             except Exception as exc:\n946:                 error_text = _redact_text(exc, 200)\n947:         if detail is None:\n948:             detail = f'字段 {field} = {actual_text}（期望 {_short_repr(expected)}）'\n949:             if error_text:\n950:                 detail += f'；比较异常：{error_text}'\n951:         self.check(aid if aid is not None else f'json-{index}', passed, detail)\n952:         return response\n953: \n954:     def finish(self, case_id: str | None = None, status: str | None = None) -> int:\n955:         return emit_result(case_id or self.case_id or '', self.assertions, status=status)\n956: \n957: \n958: __all__ = [\n959:     'DEFAULT_CATEGORY',\n960:     'PRESET_CATEGORIES',\n961:     'RESULT_SCHEMA',\n962:     'AcceptanceError',\n963:     'AppProcess',\n964:     'AppStartError',\n965:     'ExternalNavigationBlocked',\n966:     'HttpClient',\n967:     'HttpRequestError',\n968:     'HttpResponse',\n969:     'Recorder',\n970:     'build_parser',\n971:     'emit_result',\n972:     'free_port',\n973:     'launch_app',\n974:     'parse_case_args',\n975:     'stop_app',\n976:     'wait_health',\n977: ]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\": \"/Users/milin/2026/软件开发/application-atlas/application-atlas-production-pack/atlas/template-factory/jobs/job_3a658ba085e8417ea6faad5cb0cdd493/attempt-2/blueprint-spec-review-0-ad1379367f3e742a-phase_acceptance/source/program-evidence/prepared/acceptance/common.py\"}"},"time":{"start":1792483829904,"end":1792483830285}}}}
