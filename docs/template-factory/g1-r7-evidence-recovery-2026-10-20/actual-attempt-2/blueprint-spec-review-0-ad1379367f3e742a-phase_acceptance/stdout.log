args, recorder):\n1176:     # The base deployment may already contain records. Only fresh proves first init.\n1177:     if not recorder.check('a11-fresh-required-flags', bool(args.app_root and args.data_dir),\n1178:                           'A11 必须绑定实际冻结 app_root 与测试者 data_dir'):\n1179:         return\n1180:     _case_a11_base(args, recorder)\n1181:     proc = None\n1182:     client = None\n1183:     try:\n1184:         proc = common.launch_app(args.app_root, args.data_dir, 0, fresh=True)\n1185:         recorder.check('a11-fresh-owned-source',\n1186:                        os.path.realpath(proc.app_root) == os.path.realpath(args.app_root),\n1187:                        'fresh 实例来自同一冻结交付源码')\n1188:         client = common.HttpClient(proc.base_url)\n1189:         health = client.get('/api/health')\n1190:         recorder.expect_status(health, 200, aid='a11-fresh-health-status')\n1191:         recorder.check('a11-fresh-health-json', isinstance(_safe_json(health), dict),\n1192:                        'fresh 健康检查返回 JSON 对象')\n1193:         # No business write precedes these unfiltered observations.\n1194:         for name, params in (('active', None), ('including-trash', {'include_trashed': '1'})):\n1195:             records = _fetch_bookmarks(client, recorder, f'a11-fresh-{name}', params)\n1196:             recorder.check(f'a11-fresh-{name}-empty', records == [],\n1197:                            f'未过滤全库 {name} 记录数={len(records)}，首次初始化必须为0')\n1198:         categories = _fetch_categories(client, recorder, 'a11-fresh')\n1199:         ids = []\n1200:         for index, preset in enumerate(common.PRESET_CATEGORIES, 1):\n1201:             matches = [item for item in categories if isinstance(item, dict) and item.get('name') == preset]\n1202:             recorder.check(f'a11-fresh-preset-{index}', len(matches) == 1,\n1203:                            f'首次初始化准确存在预置分类 {preset!r}')\n1204:             if len(matches) == 1:\n1205:                 item = matches[0]\n1206:                 cid = item.get('id')\n1207:                 legal = isinstance(cid, (str, int)) and not isinstance(cid, bool) and bool(str(cid).strip())\n1208:                 recorder.check(f'a11-fresh-preset-{index}-id', legal, f'分类 ID={cid!r}')\n1209:                 recorder.check(f'a11-fresh-preset-{index}-count', item.get('count') == 0,\n1210:                                f'预置分类活动记录 count={item.get(\"count\")!r}')\n1211:                 ids.append(str(cid))\n1212:         recorder.check('a11-fresh-preset-unique-ids', len(ids) == 4 and len(set(ids)) == 4,\n1213:                        '四个预置分类 ID 各自唯一')\n1214:         page = client.get('/', accept='text/html')\n1215:         recorder.expect_status(page, 200, aid='a11-fresh-home-status')\n1216:         recorder.check('a11-fresh-home-content-type', 'text/html' in page.content_type.lower(),\n1217:                        '未过滤首页是 HTML')\n1218:         doc = _parse_html(page.text)\n1219:         form = doc.save_form()\n1220:         recorder.check('a11-fresh-save-form', form is not None and\n1221:                        _action_path(form.action) == '/bookmarks/new' and form.has_name('url'),\n1222:                        '未过滤首页具备保存表单与 URL 字段')\n1223:         recorder.check('a11-fresh-category-entry', any(\n1224:             a.testid == 'category-manager' and _action_path(a.href) == '/categories'\n1225:             for a in doc.anchors), '未过滤首页有分类管理入口')\n1226:         recorder.check('a11-fresh-list-container', _has_list_container(doc), '未过滤首页有列表容器')\n1227:         recorder.check('a11-fresh-no-record-rows', not doc.rows, '首次初始化未过滤首页没有记录行')\n1228:         recorder.check('a11-fresh-explicit-empty-state', bool(_empty_state_marker(doc)),\n1229:                        '首次初始化未过滤首页有明确空状态')\n1230:     finally:\n1231:         try:\n1232:             if client is not None:\n1233:                 client.close()\n1234:         finally:\n1235:             if proc is not None:\n1236:                 try:\n1237:                     common.stop_app(proc)\n1238:                 except Exception as exc:\n1239:                     recorder.check('a11-fresh-cleanup', False, f'清理异常：{exc}')\n1240:                 recorder.check('a11-fresh-process-stopped', proc.poll() is not None,\n1241:                                '本用例拥有的 fresh 子进程已结束')\n1242: \n1243: _HANDLERS = {\n1244:     'A01': _case_a01,\n1245:     'A02': _case_a02,\n1246:     'A03': _case_a03,\n1247:     'A11': _case_a11,\n1248: }\n1249: \n1250: \n1251: def main(argv=None):\n1252:     try:\n1253:         args = common.parse_case_args(argv)\n1254:     except SystemExit as exc:\n1255:         raw_args = list(sys.argv[1:] if argv is None else argv)\n1256:         requested_a11 = '--case=A11' in raw_args or any(\n1257:             value == '--case' and index + 1 < len(raw_args) and raw_args[index + 1] == 'A11'\n1258:             for index, value in enumerate(raw_args))\n1259:         if not exc.code or not requested_a11:\n1260:             raise\n1261:         failed = common.Recorder('A11')\n1262:         failed.check('a11-fresh-arguments', False, 'A11 参数无效；详见 stderr，不降级或跳过')\n1263:         return failed.finish('A11')\n1264:     recorder = common.Recorder(args.case)\n1265:     handler = _HANDLERS.get(args.case)\n1266:     if handler is None:\n1267:         recorder.check(\n1268:             'dispatch',\n1269:             False,\n1270:             f'acceptance/p0_library.py 不实现用例 {args.case}（应由其他程序派发）',\n1271:         )\n1272:     else:\n1273:         try:\n1274:             handler(args, recorder)\n1275:         except common.AcceptanceError as exc:\n1276:             recorder.check('infrastructure', False, f'验收基础设施错误：{exc}')\n1277:         except Exception as exc:\n1278:             recorder.check(\n1279:                 'unexpected-error',\n1280:                 False,\n1281:                 f'未预期错误：{type(exc).__name__}: {exc}',\n1282:             )\n1283:     return recorder.finish(args.case)\n1284: \n1285: \n1286: if __name__ == '__main__':\n1287:  