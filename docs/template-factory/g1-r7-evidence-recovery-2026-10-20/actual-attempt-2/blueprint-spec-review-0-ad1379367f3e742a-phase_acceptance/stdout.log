recorder)\n1511:     finally:\n1512:         client.close()\n1513:     _a09_across_restart(args, recorder)\n1514: \n1515: \n1516: def _case_a10(args, recorder):\n1517:     client = common.HttpClient(args.base_url)\n1518:     try:\n1519:         health = client.get('/api/health')\n1520:         recorder.expect_status(health, 200, aid='a10-health-status')\n1521: \n1522:         anchor_url = _unique_url('a10-anchor')\n1523:         anchor_title = f'A10 锚点 {uuid.uuid4().hex[:8]}'\n1524:         anchor_description = f'A10 锚点描述 {uuid.uuid4().hex[:8]}'\n1525:         created = client.post_json(\n1526:             '/api/bookmarks',\n1527:             {\n1528:                 'url': anchor_url,\n1529:                 'title': anchor_title,\n1530:                 'description': anchor_description,\n1531:             },\n1532:         )\n1533:         recorder.expect_status(created, 201, aid='a10-anchor-create-status')\n1534:         anchor_id = _record_id(_extract_record(_safe_json(created)))\n1535:         if not recorder.check(\n1536:             'a10-anchor-create-id',\n1537:             bool(anchor_id),\n1538:             f'创建锚点记录返回 id={anchor_id!r}',\n1539:         ):\n1540:             return\n1541: \n1542:         categories = _fetch_categories(client, recorder, 'a10-api-categories')\n1543:         before_state = _snapshot(client, recorder, 'a10-api-before')\n1544:         before_record = _get_record_json(\n1545:             client, recorder, 'a10-anchor-before', anchor_id\n1546:         )\n1547:         if before_record is None:\n1548:             return\n1549: \n1550:         unknown = f'unknown-{uuid.uuid4().hex[:12]}'\n1551:         unknown_get = client.get(_bookmark_path(unknown))\n1552:         _check_json_error(\n1553:             recorder, unknown_get, 'a10-unknown-get', 404, 'not_found',\n1554:             f'GET /api/bookmarks/{unknown}',\n1555:         )\n1556:         unknown_patch = client.patch_json(\n1557:             _bookmark_path(unknown), {'title': 'A10 未知 id'}\n1558:         )\n1559:         _check_json_error(\n1560:             recorder, unknown_patch, 'a10-unknown-patch', 404, 'not_found',\n1561:             f'PATCH /api/bookmarks/{unknown}',\n1562:         )\n1563:         unknown_delete = client.request('DELETE', _bookmark_path(unknown))\n1564:         _check_json_error(\n1565:             recorder, unknown_delete, 'a10-unknown-delete', 404, 'not_found',\n1566:             f'DELETE /api/bookmarks/{unknown}',\n1567:         )\n1568:         unknown_move = client.post_json(\n1569:             _move_path(unknown), {'category': common.DEFAULT_CATEGORY}\n1570:         )\n1571:         _check_json_error(\n1572:             recorder, unknown_move, 'a10-unknown-move', 404, 'not_found',\n1573:             f'POST /api/bookmarks/{unknown}/move',\n1574:         )\n1575: \n1576:         malformed = (\n1577:             ('save', 'POST', '/api/bookmarks', '{\"url\": '),\n1578:             ('patch', 'PATCH', _bookmark_path(anchor_id), '{\"title\": '),\n1579:             ('move', 'POST', _move_path(anchor_id), '{\"category\": '),\n1580:         )\n1581:         for label, method, path, body in malformed:\n1582:             response = client.request(\n1583:                 method,\n1584:                 path,\n1585:                 data=body,\n1586:                 headers={'Content-Type': 'application/json'},\n1587:             )\n1588:             _check_json_error(\n1589:                 recorder, response, f'a10-malformed-{label}', 400, 'bad_request',\n1590:                 f'{method} {path} 畸形 JSON',\n1591:             )\n1592: \n1593:         after_state = _snapshot(client, recorder, 'a10-api-after')\n1594:         _check_unchanged(\n1595:             recorder, 'a10-api', before_state, after_state, '未知 id 与畸形 JSON 请求'\n1596:         )\n1597:         after_record = _get_record_json(\n1598:             client, recorder, 'a10-anchor-after', anchor_id\n1599:         )\n1600:         if after_record is not None:\n1601:             recorder.check(\n1602:                 'a10-anchor-url-unchanged',\n1603:                 _record_url(after_record) == _record_url(before_record),\n1604:                 f'锚点 url={_record_url(after_record)!r}（未被修改）',\n1605:             )\n1606:             recorder.check(\n1607:                 'a10-anchor-title-unchanged',\n1608:                 _record_title(after_record) == _record_title(before_record),\n1609:                 f'锚点 title={_record_title(after_record)!r}（未被修改）',\n1610:             )\n1611:             recorder.check(\n1612:                 'a10-anchor-description-unchanged',\n1613:                 _record_description(after_record) == _record_description(before_record),\n1614:                 f'锚点 description={_record_description(after_record)!r}（未被修改）',\n1615:             )\n1616:             recorder.check(\n1617:                 'a10-anchor-category-unchanged',\n1618:                 _record_category_name(after_record, categories)\n1619:                 == _record_category_name(before_record, categories),\n1620:                 f'锚点 category={_record_category_name(after_record, categories)!r}（未被修改）',\n1621:             )\n1622: \n1623:         _, save_form = _save_form_from_home(client, recorder, 'a10-html')\n1624:         if save_form is None:\n1625:             return\n1626:         token = uuid.uuid4().hex[:10]\n1627:         bad_url = f'atlas-a10-missing-scheme-{token}'\n1628:         corrected_url = _unique_url('a10-corrected')\n1629:         html_title = f'A10 表单标题 {token}'\n1630:         html_description = f'A10 表单描述 {token}'\n1631:         before_html_state = _snapshot(client, recorder, 'a10-html-before')\n1632:         before_html_ids = set(before_html_state[1])\n1633:         before_html_records = _fetch_bookmarks(\n1634:             client, recorder, 'a10-html-before-records',\n1635:             params={'include_trashed': 1},\n1636:         )\n1637:         before_html_total = len(_record_ids(before_html_records))\n1638:         before_urls = _record_urls(before_html_records)\n1639: \n1640:         response = client.post_form(\n1641:             _form_path(save_form, '/bookmarks/new'),\n1642:             _form_fields(save_form, {\n1643:                 'url': bad_url,\n1644:                 'title': html_title,\n1645:                 'description': html_description,\n1646:             }),\n1647:             follow_redirects=False,\n1648:             accept='text/html',\n1649:         )\n[Output truncated. Continue reading with offset: 1650]"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\": \"/Users/milin/2026/软件开发/application-atlas/application-atlas-production-pack/atlas/template-factory/jobs/job_3a658ba085e8417ea6faad5cb0cdd493/attempt-2/blueprint-spec-review-0-ad1379367f3e742a-phase_acceptance/source/program-evidence/prepared/acceptance/p0_recovery.py\", \"offset\": 950, \"limit\": 700}"},"time":{"start":1792483924421,"end":1792483924486}}}}
