": \"    args = common.parse_case_args(argv)\\n    recorder = common.Recorder(args.case)\",\n453:           \"new\": \"    try:\\n        args = common.parse_case_args(argv)\\n    except SystemExit as exc:\\n        raw_args = list(sys.argv[1:] if argv is None else argv)\\n        requested_a11 = '--case=A11' in raw_args or any(\\n            value == '--case' and index + 1 < len(raw_args) and raw_args[index + 1] == 'A11'\\n            for index, value in enumerate(raw_args))\\n        if not exc.code or not requested_a11:\\n            raise\\n        failed = common.Recorder('A11')\\n        failed.check('a11-fresh-arguments', False, 'A11 参数无效；详见 stderr，不降级或跳过')\\n        return failed.finish('A11')\\n    recorder = common.Recorder(args.case)\"\n454:         }\n455:       ]\n456:     },\n457:     {\n458:       \"path\": \"acceptance/p0_find_open.py\",\n459:       \"mode\": \"replace\",\n460:       \"patch\": [\n461:         {\n462:           \"old\": \"        url_a = f'https://{host_token}.atlas-acceptance.example/notes/{uuid.uuid4().hex[:10]}'\",\n463:           \"new\": \"        path_only = f'pathonly{uuid.uuid4().hex[:12]}'\\n        query_only = f'queryonly{uuid.uuid4().hex[:12]}'\\n        url_a = f'https://{host_token}.atlas-acceptance.example/{path_only}?q={query_only}'\"\n464:         },\n465:         {\n466:           \"old\": \"        doc_empty = _html_search(client, recorder, 'a07-html-empty', search_form, cat_a, unmatched)\",\n467:           \"new\": \"        # Tokens occur only in excluded fields of this target, never in allowed ones.\\n        for label, token_value in (('url-path', path_only), ('url-query', query_only), ('category-name', cat_a)):\\n            allowed_text = ' '.join((title_a, host_token + '.atlas-acceptance.example', desc_a)).lower()\\n            recorder.check(f'a07-{label}-isolated-token', token_value.lower() not in allowed_text,\\n                           '负例 token 不在目标记录 title/hostname/description')\\n            for scoped in (False, True):\\n                aid = f'a07-excludes-{label}-' + ('category' if scoped else 'all')\\n                params = {'q': token_value}\\n                if scoped:\\n                    params['category'] = cat_a\\n                results = _search(client, recorder, aid + '-json', params)\\n                recorder.check(aid + '-json-target-absent', id_a not in _record_ids(results),\\n                               'JSON 不因 URL path/query 或分类名而命中目标记录')\\n                html = _html_search(client, recorder, aid + '-html', search_form,\\n                                    cat_a if scoped else '', token_value)\\n                recorder.check(aid + '-html-target-absent', id_a not in _row_ids(html),\\n                               '实际搜索表单的记录行不因排除字段命中；不检查页面回显')\\n        # These positive controls also prove both entry points do not return always-empty.\\n        for label, positive_token in (('title', shared), ('hostname', host_token), ('description', desc_token)):\\n            positive_doc = _html_search(client, recorder, f'a07-html-positive-{label}',\\n                                        search_form, cat_a, positive_token.upper())\\n            recorder.check(f'a07-html-positive-{label}-hit', id_a in _row_ids(positive_doc),\\n                           '允许字段经真实 HTML 搜索表单仍命中同一记录')\\n        doc_empty = _html_search(client, recorder, 'a07-html-empty', search_form, cat_a, unmatched)\"\n468:         }\n469:       ]\n470:     },\n471:     {\n472:       \"path\": \"acceptance/runner.json\",\n473:       \"mode\": \"replace\",\n474:       \"patch\": [\n475:         {\n476:           \"old\": \"\\\"A11\\\": {\\n      \\\"args\\\": [\\\"--case\\\", \\\"{case_id}\\\", \\\"--base-url\\\", \\\"{base_url}\\\"]\",\n477:           \"new\": \"\\\"A11\\\": {\\n      \\\"args\\\": [\\\"--case\\\", \\\"{case_id}\\\", \\\"--base-url\\\", \\\"{base_url}\\\",\\n        \\\"--app-root\\\",\\n        \\\"{app_root}\\\",\\n        \\\"--data-dir\\\",\\n        \\\"{data_dir}\\\"\\n      ]\"\n478:         }\n479:       ]\n480:     },\n481:     {\n482:       \"path\": \"acceptance/README.md\",\n483:       \"mode\": \"replace\",\n484:       \"patch\": [\n485:         {\n[Output truncated. Continue reading with offset: 486]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file /Users/milin/2026/软件开发/application-atlas/application-atlas-production-pack/atlas/template-factory/jobs/job_3a658ba085e8417ea6faad5cb0cdd493/attempt-2/blueprint-spec-review-0-ad1379367f3e742a-phase_acceptance/source/program-evidence/authorization/patch.json, lines 1-485\n1: {\n2:   \"spec_changes\": [\n3:     {\n4:       \"path\": [\n5:         \"features\",\n6:         \"F01\",\n7:         \"acceptance\"\n8:       ],\n9:       \"old\": [\n10:         \"A01\",\n11:         \"A02\",\n12:         \"A03\"\n13:       ],\n14:       \"new\": [\n15:         \"A01\",\n16:         \"A02\",\n17:         \"A03\",\n18:         \"A12\"\n19:       ]\n20:     },\n21:     {\n22:       \"path\": [\n23:         \"acceptance\",\n24:         \"A12\",\n25:         \"features\"\n26:       ],\n27:       \"old\": [\n28:         \"F04\",\n29:         \"F10\"\n30:       ],\n31:       \"new\": [\n32:         \"F01\",\n33:         \"F04\",\n34:         \"F10\"\n35:       ]\n36:     },\n37:     {\n38:       \"path\": [\n39:         \"contract_coverage\",\n40:         \"error_contract\",\n41:         \"branches\",\n42:         \"html.bookmark_save.category.empty\",\n43:         \"feature_ids\"\n44:       ],\n45:       \"old\": [\n46:         \"F04\",\n47:         \"F10\"\n48:       ],\n49:       \"new\": [\n50:         \"F01\",\n51:         \"F10\"\n52:       ]\n53:     },\n54:     {\n55:       \"path\": [\n56:         \"contract_coverage\",\n57:         \"error_contract\",\n58:         \"branches\",\n59:         \"html.bookmark_save.category.whitespace\",\n60:         \"feature_ids\"\n61:       ],\n62:       \"old\": [\n63:         \"F04\",\n6