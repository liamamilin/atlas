  if not _has_header(prepared, 'User-Agent'):\n339:             prepared['User-Agent'] = 'atlas-acceptance/1.0'\n340:         if not _has_header(prepared, 'Accept-Encoding'):\n341:             prepared['Accept-Encoding'] = 'identity'\n342:         if body is not None and content_type and not _has_header(prepared, 'Content-Type'):\n343:             prepared['Content-Type'] = content_type\n344:         follow = self.follow_redirects if follow_redirects is None else bool(follow_redirects)\n345:         resolved_timeout = self.timeout if timeout is None else float(timeout)\n346:         current_url = self._build_url(path, params)\n347:         current_body = body\n348:         current_headers = prepared\n349:         redirects = 0\n350:         while True:\n351:             request = Request(\n352:                 current_url,\n353:                 data=current_body if current_method not in ('GET', 'HEAD') else None,\n354:                 headers=current_headers,\n355:                 method=current_method,\n356:             )\n357:             started = time.monotonic()\n358:             try:\n359:                 with self._opener.open(request, timeout=resolved_timeout) as raw:\n360:                     status = int(getattr(raw, 'status', raw.getcode()))\n361:                     response_headers = raw.headers\n362:                     response_body = raw.read()\n363:             except HTTPError as exc:\n364:                 status = int(exc.code)\n365:                 response_headers = exc.headers if exc.headers is not None else {}\n366:                 try:\n367:                     response_body = exc.read()\n368:                 except Exception:\n369:                     response_body = b''\n370:                 finally:\n371:                     try:\n372:                         exc.close()\n373:                     except Exception:\n374:                         pass\n375:             except (URLError, HTTPException, TimeoutError, OSError, ValueError) as exc:\n376:                 reason = getattr(exc, 'reason', exc)\n377:                 raise HttpRequestError(\n378:                     f'{current_method} {_redact_url(current_url)} 请求失败：{_redact_text(reason, 300)}'\n379:                 ) from exc\n380:             elapsed = time.monotonic() - started\n381:             response = HttpResponse(status, response_headers, response_body, current_method, current_url, elapsed)\n382:             if not follow or status not in (301, 302, 303, 307, 308):\n383:                 return response\n384:             location = response.location\n385:             if not location:\n386:                 return response\n387:             if redirects >= max_redirects:\n388:                 raise HttpRequestError(f'重定向次数超过 {max_redirects}：{_redact_url(current_url)}')\n389:             redirects += 1\n390:             next_url = urljoin(current_url, location.strip())\n391:             try:\n392:                 next_origin = _origin(next_url)\n393:             except ValueError as exc:\n394:                 raise ExternalNavigationBlocked(f'拒绝重定向到无效目标：{_redact_url(next_url)}') from exc\n395:             if next_origin != self.origin:\n396:                 raise ExternalNavigationBlocked(f'拒绝跨源重定向：{_redact_url(next_url)}')\n397:             if status == 303 or (status in (301, 302) and current_method == 'POST'):\n398:                 current_method = 'GET'\n399:                 current_body = None\n400:                 current_headers = {\n401:                     key: value for key, value in current_headers.items()\n402:                     if key.lower() not in ('content-type', 'content-length')\n403:                 }\n404:             current_url = next_url\n405: \n406:     def get(self, path: str = '', *, params: Any = None, headers: Any = None,\n407:             accept: str | None = None, follow_redirects: bool | None = None,\n408:             timeout: float | None = None) -> HttpResponse:\n409:         return self.request('GET', path, params=params, headers=headers, accept=accept,\n410:                             follow_redirects=follow_redirects, timeout=timeout)\n411: \n412:     def post_form(self, path: str, fields: Any, *, headers: Any = None, accept: str | None = None,\n413:                   follow_redirects: bool | None = None, timeout: float | None = None) -> HttpResponse:\n414:         return self.request('POST', path, form=fields, headers=headers, accept=accept,\n415:                             follow_redirects=follow_redirects, timeout=timeout)\n416: \n417:     def post_json(self, path: str, payload: Any, *, headers: Any = None, accept: str | None = None,\n418:                   follow_redirects: bool | None = None, timeout: float | None = None) -> HttpResponse:\n419:         return self.request('POST', path, json=payload, headers=headers, accept=accept,\n420:                             follow_redirects=follow_redirects, timeout=timeout)\n421: \n422:     def patch_json(self, path: str, payload: Any, *, headers: Any = None, accept: str | None = None,\n423:                    follow_redirects: bool | None = None, timeout: float | None = None) -> HttpResponse:\n424:         return self.request('PATCH', path, json=payload, headers=headers, accept=accept,\n425:                             follow_redirects=follow_redirects, timeout=timeout)\n426: \n427: \n428: class AppProcess(subprocess.Popen):\n429:     def __init__(self, args, *, base_url: str, scratch_dir: str, app_root: str, port: int,\n430:                  log_path: str, log_handle: Any, **kwargs):\n431:         super().__init__(args, **kwargs)\n432:         self.base_url = base_url\n433:         self.scratch_dir = scratch_dir\n434:         self.app_root = app_root\n435:         self.port = port\n436:         self.log_path = log_path\n437:         self.log_handle = log_handle\n438:         self._atlas_group = bool(kwargs.get('start_new_session')) and os.name == 'posix'\n439: \n440:     @property\n441:     def instance_dir(self) ->