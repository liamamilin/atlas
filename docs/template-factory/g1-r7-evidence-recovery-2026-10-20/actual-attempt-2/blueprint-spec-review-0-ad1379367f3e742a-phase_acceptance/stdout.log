ne\n596: \n597: \n598: def _bookmark_path(bookmark_id):\n599:     return '/api/bookmarks/' + quote(str(bookmark_id), safe='')\n600: \n601: \n602: def _move_path(bookmark_id):\n603:     return _bookmark_path(bookmark_id) + '/move'\n604: \n605: \n606: def _category_path(category_id):\n607:     return '/api/categories/' + quote(str(category_id), safe='')\n608: \n609: \n610: def _record_ids(records):\n611:     return {\n612:         record_id for record_id in (_record_id(record) for record in records)\n613:         if record_id\n614:     }\n615: \n616: \n617: def _record_urls(records):\n618:     return {\n619:         url for url in (_record_url(record) for record in records)\n620:         if url\n621:     }\n622: \n623: \n624: def _fetch_bookmarks(client, recorder, aid, params=None):\n625:     response = client.get('/api/bookmarks', params=params)\n626:     recorder.expect_status(response, 200, aid=f'{aid}-status')\n627:     payload = _safe_json(response)\n628:     records = _extract_list(payload, ('bookmarks', 'items', 'data', 'records'))\n629:     recorder.check(\n630:         f'{aid}-shape',\n631:         isinstance(records, list),\n632:         f'GET /api/bookmarks 必须返回 JSON 数组，实际 {type(payload).__name__}',\n633:     )\n634:     return records if isinstance(records, list) else []\n635: \n636: \n637: def _fetch_categories(client, recorder, aid):\n638:     response = client.get('/api/categories')\n639:     recorder.expect_status(response, 200, aid=f'{aid}-status')\n640:     payload = _safe_json(response)\n641:     categories = _extract_list(payload, ('categories', 'items', 'data'))\n642:     recorder.check(\n643:         f'{aid}-shape',\n644:         isinstance(categories, list),\n645:         f'GET /api/categories 必须返回 JSON 数组，实际 {type(payload).__name__}',\n646:     )\n647:     return categories if isinstance(categories, list) else []\n648: \n649: \n650: def _category_signature(categories):\n651:     items = []\n652:     for item in categories:\n653:         if not 