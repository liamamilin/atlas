elf.value = attrs.get('value', '')\n43:         self.type = (attrs.get('type') or 'text').lower()\n44:         self.checked = 'checked' in attrs\n45: \n46: \n47: class _Option:\n48:     def __init__(self, attrs):\n49:         self.attrs = attrs\n50:         self.value = attrs.get('value')\n51:         self.text = ''\n52:         self.selected = 'selected' in attrs\n53: \n54:     def resolved_value(self):\n55:         if self.value is not None:\n56:             return self.value\n57:         return self.text.strip()\n58: \n59: \n60: class _Select:\n61:     def __init__(self, attrs):\n62:         self.attrs = attrs\n63:         self.name = attrs.get('name')\n64:         self.options = []\n65: \n66:     def selected_value(self):\n67:         for option in self.options:\n68:             if option.selected:\n69:                 return option.resolved_value()\n70:         if self.options:\n71:             return self.options[0].resolved_value()\n72:         return ''\n73: \n74: \n75: class _Textarea:\n76:     def __init__(self, attrs):\n77:         self.attrs = attrs\n78:         self.name = attrs.get('name')\n79:         self.text = ''\n80: \n81: \n82: class _Form:\n83:     def __init__(self, attrs):\n84:         self.attrs = attrs\n85:         self.action = (attrs.get('action') or '').strip()\n86:         self.method = (attrs.get('method') or 'get').strip().lower()\n87:         self.testid = attrs.get('data-testid') or ''\n88:         self.fields = []\n89:         self.selects = []\n90:         self.textareas = []\n91: \n92:     def has_name(self, name):\n93:         if any(field.name == name for field in self.fields):\n94:             return True\n95:         if any(select.name == name for select in self.selects):\n96:             return True\n97:         return any(textarea.name == name for textarea in self.textareas)\n98: \n99:     def value(self, name):\n100:         for field in reversed(self.fields):\n101:             if field.name == name:\n102:                 return field.value\n103:         for select in reversed(self.selects):\n104:             if select.name == name:\n105:                 return select.selected_value()\n106:         for textarea in reversed(self.textareas):\n107:             if textarea.name == name:\n108:                 return textarea.text\n109:         return None\n110: \n111: \n112: class _Anchor:\n113:     def __init__(self, attrs):\n114:         self.attrs = attrs\n115:         self.href = attrs.get('href') or ''\n116:         self.testid = attrs.get('data-testid') or ''\n117:         self.text = ''\n118: \n119: \n120: class _Row:\n121:     def __init__(self, attrs):\n122:         self.attrs = attrs\n123:         self.record_id = attrs.get('data-record-id') or ''\n124:         self.anchors = []\n125:         self.text = ''\n126: \n127: \n128: def _action_path(action):\n129:     text = (action or '').strip()\n130:     if not text:\n131:         return ''\n132:     try:\n133:         path = urlsplit(text).path\n134:     except ValueError:\n135:         return text\n136:     if not path:\n137:         return ''\n138:     if not path.startswith('/'):\n139:         path = '/' + path\n140:     return path.rstrip('/') or '/'\n141: \n142: \n143: def _path_of(href):\n144:     try:\n145:         path = urlsplit(href).path\n146:     except ValueError:\n147:         return ''\n148:     if not path:\n149:         return ''\n150:     if not path.startswith('/'):\n151:         path = '/' + path\n152:     return path.rstrip('/') or '/'\n153: \n154: \n155: def _form_path(form, default):\n156:     action = (form.action or '').strip()\n157:     return action if action else default\n158: \n159: \n160: class _Document:\n161:     def __init__(self):\n162:         self.forms = []\n163:         self.anchors = []\n164:         self.rows = []\n165:         self.testids = []\n166:         self.start_tags = []\n167:         self.text = ''\n168: \n169:     def save_form(self):\n170:         for form in self.forms:\n171:    