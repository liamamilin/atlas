r key in ('category_id', 'categoryId'):\n436:         value = record.get(key)\n437:         if value is not None and str(value) in by_id:\n438:             return by_id[str(value)]\n439:     return None\n440: \n441: \n442: def _record_ids(records):\n443:     return {_record_id(record) for record in records}\n444: \n445: \n446: def _action_of(form):\n447:     return form.action or '/'\n448: \n449: \n450: def _form_fields(form, overrides=None, omit=()):\n451:     fields = {}\n452:     for field in form.fields:\n453:         name = field.name\n454:         if not name:\n455:             continue\n456:         if field.type in ('submit', 'button', 'reset', 'file', 'image'):\n457:             continue\n458:         if field.type in ('checkbox', 'radio') and not field.checked:\n459:             continue\n460:         fields[name] = field.value\n461:     for select in form.selects:\n462:         if select.name:\n463:             fields[select.name] = select.selected_value()\n464:     for textarea in form.textareas:\n465:         if textarea.name:\n466:             fields[textarea.name] = textarea.text\n467:     if overrides:\n468:         for key, value in overrides.items():\n469:             fields[str(key)] = str(value)\n470:     for name in omit:\n471:         fields.pop(name, None)\n472:     return fields\n473: \n474: \n475: def _form_error_text(doc):\n476:     parts = []\n477:     for entry in doc.testids:\n478:         testid = (entry['attrs'].get('data-testid') or '').lower()\n479:         if testid == 'form-error' or 'form-error' in testid:\n480:             text = _WHITESPACE_RE.sub(' ', entry['text']).strip()\n481:             if text:\n482:                 parts.append(text)\n483:     return ' '.join(parts)\n484: \n485: \n486: def _row_for_url(doc, url):\n487:     for row in doc.rows:\n488:         for anchor in row.anchors:\n489:             if anchor.testid == 'record-open-link' and anchor.href == url:\n490:                 return row\n491:     for row in doc.