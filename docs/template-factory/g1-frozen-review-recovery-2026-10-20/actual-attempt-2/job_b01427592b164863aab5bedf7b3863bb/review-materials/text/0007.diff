+def _action_path(action):
+    text = (action or '').strip()
+    if not text:
+        return ''
+    try:
+        path = urlsplit(text).path
+    except ValueError:
+        return text
+    if not path:
+        return ''
+    if not path.startswith('/'):
+        path = '/' + path
+    return path.rstrip('/') or '/'
+
+
+def _path_of(href):
+    try:
+        path = urlsplit(href).path
+    except ValueError:
+        return ''
+    if not path:
+        return ''
+    if not path.startswith('/'):
+        path = '/' + path
+    return path.rstrip('/') or '/'
+
+
+def _form_path(form, default):
+    action = (form.action or '').strip()
+    return action if action else default
