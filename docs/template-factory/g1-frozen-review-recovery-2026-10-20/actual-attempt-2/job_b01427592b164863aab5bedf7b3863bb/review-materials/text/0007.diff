+class _HtmlReader(HTMLParser):
+    def __init__(self):
+        super().__init__(convert_charrefs=True)
+        self.doc = _Document()
+        self._form = None
+        self._select = None
+        self._option = None
+        self._textarea = None
+        self._anchor = None
+        self._row = None
+        self._testid_stack = []
+
+    def handle_starttag(self, tag, attrs):
+        tag = tag.lower()
+        attributes = {
+            str(key).lower(): ('' if value is None else value)
+            for key, value in attrs
+        }
+        self.doc.start_tags.append((tag, attributes))
+        testid = attributes.get('data-testid') or ''
+        if testid:
+            entry = {'tag': tag, 'attrs': attributes, 'text': ''}
+            self.doc.testids.append(entry)
+            if tag not in _VOID_TAGS:
+                self._testid_stack.append((tag, entry))
+        if tag == 'form':
+            self._finish_form()
+            self._form = _Form(attributes)
+        elif tag == 'input':
+            if self._form is not None:
+                self._form.fields.append(_Field(attributes))
+        elif tag == 'select':
+            self._finish_select()
+            if self._form is not None:
+                self._select = _Select(attributes)
+        elif tag == 'option':
+            self._finish_option()
+            if self._select is not None:
+                self._option = _Option(attributes)
+        elif tag == 'textarea':
+            self._finish_textarea()
+            if self._form is not None:
+                self._textarea = _Textarea(attributes)
+        elif tag == 'a':
+            self._finish_anchor()
+            self._anchor = _Anchor(attributes)
+        elif tag == 'tr' and testid == 'record-row':
+            self._finish_row()
+            self._row = _Row(attributes)
+
+    def handle_data(self, data):
+        if not data:
+            return
+        self.doc.text += data
+        if self._row is not None:
+            self._row.text += data
+        if self._anchor is not None:
+            self._anchor.text += data
+        if self._option is not None:
+            self._option.text += data
+        if self._textarea is not None:
+            self._textarea.text += data
+        for _, entry in self._testid_stack:
+            entry['text'] += data
+
+    def handle_endtag(self, tag):
+        tag = tag.lower()
+        if tag == 'a':
+            self._finish_anchor()
+        elif tag == 'option':
+            self._finish_option()
+        elif tag == 'select':
+            self._finish_select()
+        elif tag == 'textarea':
+            self._finish_textarea()
+        elif tag == 'form':
+            self._finish_form()
+        elif tag == 'tr':
+            self._finish_row()
+        if tag in _VOID_TAGS:
+            return
+        if self._testid_stack and self._testid_stack[-1][0] == tag:
+            self._testid_stack.pop()
+
+    def _finish_option(self):
+        if self._option is None:
+            return
+        option = self._option
+        self._option = None
+        if self._select is not None:
+            self._select.options.append(option)
+
+    def _finish_select(self):
+        self._finish_option()
+        if self._select is None:
+            return
+        select = self._select
+        self._select = None
+        if self._form is not None:
+            self._form.selects.append(select)
+
+    def _finish_textarea(self):
+        if self._textarea is None:
+            return
+        textarea = self._textarea
+        self._textarea = None
+        if self._form is not None:
+            self._form.textareas.append(textarea)
+
+    def _finish_anchor(self):
+        if self._anchor is None:
+            return
+        anchor = self._anchor
+        self._anchor = None
+        self.doc.anchors.append(anchor)
+        if self._row is not None:
+            self._row.anchors.append(anchor)
+
+    def _finish_row(self):
+        if self._row is None:
+            return
+        row = self._row
+        self._row = None
+        self.doc.rows.append(row)
+
+    def _finish_form(self):
+        self._finish_select()
+        self._finish_textarea()
+        if self._form is None:
+            return
+        form = self._form
+        self._form = None
+        self.doc.forms.append(form)
+
+    def finalize(self):
+        self._finish_anchor()
+        self._finish_row()
+        self._finish_form()
+
+
+def _parse_html(text):
+    reader = _HtmlReader()
+    reader.feed(text or '')
+    reader.close()
+    reader.finalize()
+    return reader.doc
