{"type":"tool_use","timestamp":1792580648522,"sessionID":"ses_ea1de83daffetTStmPb5FvGcdC","part":{"partID":"prt_15e21fd1d001Z8n5wQEGVAceTA","sessionID":"ses_ea1de83daffetTStmPb5FvGcdC","messageID":"msg_15e21f453001Ko6YEkRsm5w6yt","type":"tool","id":"call_21ddebb5260b40c8b601f87f","tool":"read","state":{"status":"completed","input":{"path":"/Users/milin/2026/软件开发/application-atlas/docs/template-factory/go-minimax-batch-2026-10-21/personal-kanban/calls/blueprint-spec-review-aux/source/upstream/app/Model/ColumnModel.php"},"output":"Read file /Users/milin/2026/软件开发/application-atlas/docs/template-factory/go-minimax-batch-2026-10-21/personal-kanban/calls/blueprint-spec-review-aux/source/upstream/app/Model/ColumnModel.php, lines 1-262\n1: <?php\n2: \n3: namespace Kanboard\\Model;\n4: \n5: use Kanboard\\Core\\Base;\n6: \n7: /**\n8:  * Column Model\n9:  *\n10:  * @package  Kanboard\\Model\n11:  * @author   Frederic Guillot\n12:  */\n13: class ColumnModel extends Base\n14: {\n15:     /**\n16:      * SQL table name\n17:      *\n18:      * @var string\n19:      */\n20:     const TABLE = 'columns';\n21: \n22:     /**\n23:      * Get a column by the id\n24:      *\n25:      * @access public\n26:      * @param  integer  $column_id    Column id\n27:      * @return array\n28:      */\n29:     public function getById($column_id)\n30:     {\n31:         return $this->db->table(self::TABLE)->eq('id', $column_id)->findOne();\n32:     }\n33: \n34:     /**\n35:      * Get projectId by the columnId\n36:      *\n37:      * @access public\n38:      * @param  integer  $column_id    Column id\n39:      * @return integer\n40:      */\n41:     public function getProjectId($column_id)\n42:     {\n43:         return $this->db->table(self::TABLE)->eq('id', $column_id)->findOneColumn('project_id');\n44:     }\n45: \n46:     /**\n47:      * Get the first column id for a given project\n48:      *\n49:      * @access public\n50:      * @param  integer  $project_id   Project id\n51:      * @return integer\n52:      */\n53:     public function getFirstColumnId($project_id)\n54:     {\n55:         return $this->db->table(self::TABLE)->eq('project_id', $project_id)->asc('position')->findOneColumn('id');\n56:     }\n57: \n58:     /**\n59:      * Get the last column id for a given project\n60:      *\n61:      * @access public\n62:      * @param  integer  $project_id   Project id\n63:      * @return integer\n64:      */\n65:     public function getLastColumnId($project_id)\n66:     {\n67:         return $this->db->table(self::TABLE)->eq('project_id', $project_id)->desc('position')->findOneColumn('id');\n68:     }\n69: \n70:     /**\n71:      * Get the position of the last column for a given project\n72:      *\n73:      * @access public\n74:      * @param  integer  $project_id   Project id\n75:      * @return integer\n76:      */\n77:     public function getLastColumnPosition($project_id)\n78:     {\n79:         return (int) $this->db\n80:                         ->table(self::TABLE)\n81:                         ->eq('project_id', $project_id)\n82:                         ->desc('position')\n83:                         ->findOneColumn('position');\n84:     }\n85: \n86:     /**\n87:      * Get a column id by the name\n88:      *\n89:      * @access public\n90:      * @param  integer  $project_id\n91:      * @param  string   $title\n92:      * @return integer\n93:      */\n94:     public function getColumnIdByTitle($project_id, $title)\n95:     {\n96:         return (int) $this->db->table(self::TABLE)->eq('project_id', $project_id)->eq('title', $title)->findOneColumn('id');\n97:     }\n98: \n99:     /**\n100:      * Get a column title by the id\n101:      *\n102:      * @access public\n103:      * @param  integer  $column_id\n104:      * @return integer\n105:      */\n106:     public function getColumnTitleById($column_id)\n107:     {\n108:         return $this->db->table(self::TABLE)->eq('id', $column_id)->findOneColumn('title');\n109:     }\n110: \n111:     /**\n112:      * Get all columns sorted by position for a given project\n113:      *\n114:      * @access public\n115:      * @param  integer  $project_id   Project id\n116:      * @return array\n117:      */\n118:     public function getAll($project_id)\n119:     {\n120:         return $this->db->table(self::TABLE)->eq('project_id', $project_id)->asc('position')->findAll();\n121:     }\n122: \n123:     /**\n124:      * Get all columns with opened task count only\n125:      *\n126:      * @access public\n127:      * @param  integer  $project_id   Project id\n128:      * @return array\n129:      */\n130:     public function getAllWithOpenedTaskCount($project_id)\n131:     {\n132:         return $this->db->table(self::TABLE)\n133:             ->columns('id', 'title', 'position', 'task_limit', 'description', 'hide_in_dashboard', 'project_id')\n134:             ->subquery(\"SELECT COUNT(*) FROM \".TaskModel::TABLE.\" WHERE column_id=\".self::TABLE.\".id AND is_active='1'\", 'nb_open_tasks')\n135:             ->eq('project_id', $project_id)\n136:             ->asc('position')\n137:             ->findAll();\n138:     }\n139: \n140:     /**\n141:      * Get all columns with task count\n142:      *\n143:      * @access public\n144:      * @param  integer  $project_id   Project id\n145:      * @return array\n146:      */\n147:     public function getAllWithTaskCount($project_id)\n148:     {\n149:         return $this->db->table(self::TABLE)\n150:             ->columns('id', 'title', 'position', 'task_limit', 'description', 'hide_in_dashboard', 'project_id')\n151:             ->subquery(\"SELECT COUNT(*) FROM \".TaskModel::TABLE.\" WHERE column_id=\".self::TABLE.\".id AND is_active='1'\", 'nb_open_tasks')\n152:             ->subquery(\"SELECT COUNT(*) FROM \".TaskModel::TABLE.\" WHERE column_id=\".self::TABLE.\".id AND is_active='0'\", 'nb_closed_tasks')\n153:             ->eq('project_id', $project_id)\n154:             ->asc('position')\n155:             ->findAll();\n156:     }\n157: \n158:     /**\n159:      * Get the list of columns sorted by position [ column_id => title ]\n160:      *\n161:      * @access public\n162:      * @param  integer  $project_id   Project id\n163:      * @param  boolean  $prepend      Prepend a default value\n164:      * @return array\n165:      */\n166:     public function getList($project_id, $prepend = false)\n167:     {\n168:         $listing = $this->db->hashtable(self::TABLE)->eq('project_id', $project_id)->asc('position')->getAll('id', 'title');\n169:         return $prepend ? array(-1 => t('All columns')) + $listing : $listing;\n170:     }\n171: \n172:     /**\n173:      * Add a new column to the board\n174:      *\n175:      * @access public\n176:      * @param  integer $project_id  Project id\n177:      * @param  string  $title       Column title\n178:      * @param  integer $task_limit  Task limit\n179:      * @param  string  $description Column description\n180:      * @param  integer $hide_in_dashboard\n181:      * @return bool|int\n182:      */\n183:     public function create($project_id, $title, $task_limit = 0, $description = '', $hide_in_dashboard = 0)\n184:     {\n185:         $values = array(\n186:             'project_id' => $project_id,\n187:             'title' => $title,\n188:             'task_limit' => intval($task_limit),\n189:             'position' => $this->getLastColumnPosition($project_id) + 1,\n190:             'hide_in_dashboard' => $hide_in_dashboard,\n191:             'description' => $description,\n192:         );\n193: \n194:         return $this->db->table(self::TABLE)->persist($values);\n195:     }\n196: \n197:     /**\n198:      * Update a column\n199:      *\n200:      * @access public\n201:      * @param  integer   $column_id     Column id\n202:      * @param  string    $title         Column title\n203:      * @param  integer   $task_limit    Task limit\n204:      * @param  string    $description   Optional description\n205:      * @param  integer   $hide_in_dashboard\n206