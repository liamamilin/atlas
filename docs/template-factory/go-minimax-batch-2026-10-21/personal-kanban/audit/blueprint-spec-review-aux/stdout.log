d\n47:      * @param  array $task\n48:      * @param  array $changes\n49:      */\n50:     protected function fireEvents(array $task, array $changes)\n51:     {\n52:         $events = array();\n53: \n54:         if ($this->isAssigneeChanged($task, $changes)) {\n55:             $events[] = TaskModel::EVENT_ASSIGNEE_CHANGE;\n56:         } elseif ($this->isModified($task, $changes)) {\n57:             $events[] = TaskModel::EVENT_CREATE_UPDATE;\n58:             $events[] = TaskModel::EVENT_UPDATE;\n59:         }\n60: \n61:         if (! empty($events)) {\n62:             $this->queueManager->push(\n63:                 $this->taskEventJob\n64:                 ->withParams($task['id'], $events, $changes, array(), $task)\n65:             );\n66:         }\n67:     }\n68: \n69:     /**\n70:      * Return true if the task have been modified\n71:      *\n72:      * @access protected\n73:      * @param  array $task\n74:      * @param  array $changes\n75:      * @return bool\n76:      */\n77:     protected function isModified(array $task, array $changes)\n78:     {\n79:         $diff = array_diff_assoc($changes, $task);\n80:         unset($diff['date_modification']);\n81:         return count($diff) > 0;\n82:     }\n83: \n84:     /**\n85:      * Return true if the field is the only modified value\n86:      *\n87:      * @access protected\n88:      * @param  array  $task\n89:      * @param  array  $changes\n90:      * @return bool\n91:      */\n92:     protected function isAssigneeChanged(array $task, array $changes)\n93:     {\n94:         $diff = array_diff_assoc($changes, $task);\n95:         unset($diff['date_modification']);\n96:         return isset($changes['owner_id']) && $task['owner_id'] != $changes['owner_id'] && count($diff) === 1;\n97:     }\n98: \n99:     /**\n100:      * Prepare data before task modification\n101:      *\n102:      * @access protected\n103:      * @param  array  $values\n104:      */\n105:     protected function prepare(array &$values)\n106:     {\n107:         $values = $this->dateParser->convert($values, array('date_due'), true);\n108:         $values = $this->dateParser->convert($values, array('date_started'), true);\n109: \n110:         $this->helper->model->removeFields($values, array('id'));\n111:         $this->helper->model->resetFields($values, array('date_due', 'date_started', 'score', 'category_id', 'time_estimated', 'time_spent'));\n112:         $this->helper->model->convertIntegerFields($values, array('priority', 'is_active', 'recurrence_status', 'recurrence_trigger', 'recurrence_factor', 'recurrence_timeframe', 'recurrence_basedate'));\n113: \n114:         $values['date_modification'] = time();\n115: \n116:         $this->hook->reference('model:task:modification:prepare', $values);\n117:     }\n118: \n119:     /**\n120:      * Update tags\n121:      *\n122:      * @access protected\n123:      * @param  array  $values\n124:      * @param  array  $original_task\n125:      */\n126:     protected function updateTags(array &$values, array $original_task, $remove_other_tags = true)\n127:     {\n128:         if (isset($values['tags'])) {\n129:             $this->taskTagModel->save($original_task['project_id'], $values['id'], $values['tags'], $remove_other_tags);\n130:             unset($values['tags']);\n131:             unset($values['tags_only_add_new']);\n132:         }\n133:     }\n134: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/milin/2026/软件开发/application-atlas/docs/template-factory/go-minimax-batch-2026-10-21/personal-kanban/calls/blueprint-spec-review-aux/source/upstream/app/Model/TaskModificationModel.php, lines 1-134\n1: <?php\n2: \n3: namespace Kanboard\\Model;\n4: \n5: use Kanboard\\Core\\Base;\n6: \n7: /**\n8:  * Task Modification\n9:  *\n10:  * @package  Kanboard\\Model\n11:  * @author   Frederic Guillot\n12:  */\n13: class TaskModificationModel extends Base\n14: {\n15:     /**\n16:      * Update a task\n17:      *\n18: