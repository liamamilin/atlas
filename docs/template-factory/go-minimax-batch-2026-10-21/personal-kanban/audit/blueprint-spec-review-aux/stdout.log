{"type":"tool_use","timestamp":1792580642357,"sessionID":"ses_ea1de83daffetTStmPb5FvGcdC","part":{"partID":"prt_15e21e62e002hNJMFysG9tufY7","sessionID":"ses_ea1de83daffetTStmPb5FvGcdC","messageID":"msg_15e21dda60017SluAE11Vz177B","type":"tool","id":"call_47f468469dac4c1b8cc87c4b","tool":"read","state":{"status":"completed","input":{"path":"/Users/milin/2026/软件开发/application-atlas/docs/template-factory/go-minimax-batch-2026-10-21/personal-kanban/calls/blueprint-spec-review-aux/source/candidate/acceptance/probe.py"},"output":"Read file /Users/milin/2026/软件开发/application-atlas/docs/template-factory/go-minimax-batch-2026-10-21/personal-kanban/calls/blueprint-spec-review-aux/source/candidate/acceptance/probe.py, lines 1-550\n1: #!/usr/bin/env python3\n2: '''Acceptance probe for the Personal Project Board target (localhost, single user).\n3: \n4: Usage:\n5:     python3 probe.py --base-url http://127.0.0.1:8765 --case A01\n6:     python3 probe.py --base-url http://127.0.0.1:8765 --case all\n7: \n8: Cases (one per feature): A01 boards, A02 columns, A03 cards,\n9: A04 movement and ordering, A05 board read model.\n10: \n11: The probe writes to a live local server. Each case creates its own disposable\n12: board and deletes only the records that this probe created; no pre-existing\n13: record is ever deleted. Every rejected request is followed by a re-read that\n14: proves the rejected write did not happen.\n15: '''\n16: \n17: import argparse\n18: import json\n19: import sys\n20: import time\n21: import urllib.error\n22: import urllib.request\n23: import uuid\n24: \n25: PROBE_START = int(time.time())\n26: FEATURE_COUNT = 5\n27: CASE_IDS = ('A01', 'A02', 'A03', 'A04', 'A05')\n28: \n29: \n30: class ProbeFailure(Exception):\n31:     '''Raised when an assertion about the documented API fails.'''\n32: \n33: \n34: def check(condition, message):\n35:     if not condition:\n36:         raise ProbeFailure(message)\n37: \n38: \n39: def parse_json(raw):\n40:     if raw is None:\n41:         return None\n42:     text = raw.strip()\n43:     if text == '':\n44:         return None\n45:     try:\n46:         return json.loads(text)\n47:     except ValueError:\n48:         return {'_raw': text}\n49: \n50: \n51: def http(base, method, path, payload=None, raw_body=None):\n52:     url = base.rstrip('/') + path\n53:     data = None\n54:     headers = {'Accept': 'application/json'}\n55:     if raw_body is not None:\n56:         data = raw_body.encode('utf-8')\n57:         headers['Content-Type'] = 'application/json'\n58:     elif payload is not None:\n59:         data = json.dumps(payload, ensure_ascii=False).encode('utf-8')\n60:         headers['Content-Type'] = 'application/json'\n61:     request = urllib.request.Request(url, data=data, headers=headers, method=method)\n62:     try:\n63:         with urllib.request.urlopen(request, timeout=20) as response:\n64:             return response.status, parse_json(response.read().decode('utf-8'))\n65:     except urllib.error.HTTPError as error:\n66:         return error.code, parse_json(error.read().decode('utf-8'))\n67: \n68: \n69: def expect_error(status, body, want_status, want_code):\n70:     check(status == want_status, 'expected HTTP %s, got %s (%s)' % (want_status, status, body))\n71:     error = {}\n72:     if isinstance(body, dict):\n73:         error = body.get('error') or {}\n74:     check(error.get('code') == want_code, 'expected error code %s, got %s' % (want_code, body))\n75: \n76: \n77: def snapshot(base, board_id):\n78:     status, body = http(base, 'GET', '/api/boards/%d' % board_id)\n79:     check(status == 200, 'GET /api/boards/%d failed: %s %s' % (board_id, status, body))\n80:     check(isinstance(body, dict) and 'columns' in body, 'board snapshot has no columns: %s' % body)\n81:     return body\n82: \n83: \n84: def board_state(snap):\n85:     '''Everything the target stores for one board, for exact zero-write comparison.'''\n86:     return {\n87:         'columns': [(c['id'], c['name'], c['position'], c['card_count']) for c in snap['columns']],\n88:         'cards': [[(card['id'], card['title'], card['description'], card['position'],\n89:                     card['column_id'], card['updated_at']) for card in c['cards']]\n90:                   for c in snap['columns']],\n91:     }\n92: \n93: \n94: def column_ids(snap):\n95:     return [column['id'] for column in snap['columns']]\n96: \n97: \n98: def column_names(snap):\n99:     return [column['name'] for column in snap['columns']]\n100: \n101: \n102: def column_positions(snap):\n103:     return [column['position'] for column in snap['columns']]\n104: \n105: \n106: def cards_in(snap, column_id):\n107:     for column in snap['columns']:\n108:         if column['id'] == column_id:\n109:             return [card['id'] for card in column['cards']]\n110:     raise ProbeFailure('column %s is not part of the board snapshot' % column_id)\n111: \n112: \n113: def card_positions(snap, column_id):\n114:     for column in snap['columns']:\n115:         if column['id'] == column_id:\n116:             return [card['position'] for card in column['cards']]\n117:     raise ProbeFailure('column %s is not part of the board snapshot' % column_id)\n118: \n119: \n120: def card_of(snap, card_id):\n121:     for column in snap['columns']:\n122:         for card in column['cards']:\n123:             if card['id'] == card_id:\n124:                 return card\n125:     raise ProbeFailure('card %s is not part of the board snapshot' % card_id)\n126: \n127: \n128: def make_board(base, name=None, columns=None):\n129:     payload = {'name': name or ('probe-%s' % uuid.uuid4().hex[:8])}\n130:     if columns is not None:\n131:         payload['columns'] = columns\n132:     status, body = http(base, 'POST', '/api/boards', payload)\n133:     check(status == 201, 'board creation failed: %s %s' % (status, body))\n134:     check(isinstance(body, dict) and 'board' in body, 'board response has no board: %s' % body)\n135:     return body['board'], body.get('columns', [])\n136: \n137: \n138: def make_card(base, board_id, title, column_id, description=None):\n139:     payload = {'title': title, 'column_id': column_id}\n140:     if description is not None:\n141:         payload['description'] = description\n142:     status, body = http(base, 'POST', '/api/boards/%d/cards' % board_id, payload)\n143:     check(status == 201, 'card creation failed: %s %s' % (status, body))\n144:     return body['card']\n145: \n146: \n147: def drop_board(base, board_id):\n148:     status, body = http(base, 'DELETE', '/api/boards/%d' % board_id)\n149:     check(status == 204, 'board cleanup failed: %s %s' % (status, body))\n150: \n151: \n152: def case_a01(base):\n153:     status, body = http(base, 'GET', '/api/health')\n154:     check(status == 200, 'GET /api/health failed: %s %s' % (status, body))\n155:     check(isinstance(body, dict) and body.get('status') == 'ok', 'health payload is not ok: %s' % body)\n156: \n157:     status, body = http(base, 'GET', '/api/boards')\n158:     check(status == 200, 'GET /api/boards failed: %s %s' % (status, body))\n159:     before = len(body['boards'])\n160: \n161:     board, columns = make_board(base, columns=[])\n162:     board_id = board['id']\n163:     check(isinstance(board_id, int) and board_id > 0, 'board id must be a positive integer')\n164:     check(columns == [], 'a board must be created without columns')\n165:     check(isinstance(board['created_at'], int), 'created_at must be an integer epoch second')\n166:     check(isinstance(board['updated_at'], int), 'updated_at must be an integer epoch second')\n167:     check(board['updated_at'] >= board['created_at'], 'updated_at must not be before created_at')\n168:     check(PROBE_START - 10 <= board['created_at'] <= int(time.time()) + 2, 'created_at outside the probe window')\n169:     check(board.get('column_count') == 0 and board.get('card_count') == 0, 'a new board must report empty counts')\n170: \n171:     status, body = http(base, 'GET', '/api/boards')\n172:     check(status == 200, 'GET /api/boards failed: %s %s' % (status, body))\n173:     check(len(body['boards']) == before + 1, 'the board list must grow by exactly one board')\n174:     listed = [entry for entry in body['boards'] if entry['id'] == board_id]\n175:     check(len(listed) == 1, 'the created board must appear exactly once in the list')\n176:     check(listed[0]['name'] == board['name'], 'the list must carry the same board name')\n177: \n178:     snap = snapshot(base, board_id)\n179:     check(snap['board']['name'] == board['name'], 'GET board must return the same name')\n180:     check(snap['columns'] == [], 'GET board must return no columns for a new board')\n181: \n182:     rejections = (\n183:         ({'name': ''}, 422, 'NAME_REQUIRED'),\n184:         ({'name': '   '}, 422, 'NAME_REQUIRED'),\n185:         ({'name': 'x' * 121}, 422, 'NAME_TOO_LONG'),\n186:         ({'name': 'ok', 'status': 'doing'}, 422, 'FORBIDDEN_FIELD'),\n187:         ({'name': 'ok', 'assignee': 'me'}, 422, 'FORBIDDEN_FIELD'),\n188:         ({'name': 'ok', 'colour': 'red'}, 422, 'UNKNOWN_FIELD'),\n189:     )\n190:     for payload, want_status, want_code in rejections:\n191:         status, body = http(base, 'POST', '/api/boards', payload)\n192:         expect_error(status, body, want_status, want_code)\n193:         status, body = http(base, 'GET', '/api/boards')\n194:         check(status == 200, 'GET /api/boards failed: %s %s' % (status, body))\n195:         check(len(body['boards']) == before + 1, 'a rejected board creation wrote a board (%s)' % want_code)\n196: \n197:     status, body = http(base, 'POST', '/api/boards', raw_body='{not json')\n198:     expect_error(status, body, 400, 'MALFORMED_JSON')\n199:     status, body = http(base, 'GET', '/api/boards')\n200:     check(len(body['boards']) == before + 1, 'a malformed request wrote a board')\n201: \n202:     status, body = http(base, 'GET', '/api/boards/999999999')\n203:     expect_error(status, body, 404, 'BOARD_NOT_FOUND')\n204: \n205:     renamed = 'probe-renamed-%s' % uuid.uuid4().hex[:8]\n206:     status, body = http(base, 'PATCH', '/api/boards/%d' % board_id, {'name': renamed})\n207:     check(status == 200, 'board rename failed: %s %s' % (status, body))\n208:     check(body['board']['name'] == renamed, 'the rename was not applied')\n209:     check(body['board']['id'] == board_id, 'the rename changed the board id')\n210:     check(body['board']['updated_at'] >= board['created_at'], 'updated_at went backwards')\n211: \n212:     drop_board(base, board_id)\n213:     status, body = http(base, 'GET', '/api/boards/%d' % board_id)\n214:     expect_error(status, body, 404, 'BOARD_NOT_FOUND')\n215:     status, body = http(base, 'GET', '/api/boards')\n216:     check(len(body['boards']) == before, 'the board list must return to its original size')\n217:     return 'boards: create/list/read/rename/delete plus 7 rejected writes with zero-write re-reads'\n218: \n219: \n220: def case_a02(base):\n221:     board, columns = make_board(base, columns=['待办', '进行中', '完成'])\n222:     board_id = board['id']\n223:     check(len(columns) == 3, 'expected three seeded columns, got %d' % len(columns))\n224:     check([c['name'] for c in columns] == ['待办', '进行中', '完成'], 'seeded column names or order differ')\n225:     check([c['position'] for c in columns] == [1, 2, 3], 'seeded column positions must be 1..3')\n226:     first, second, third = [c['id'] for c in columns]\n227: \n228:     snap = snapshot(base, board_id)\n229:     check(column_ids(snap) == [first, second, third], 'board columns are not in the seeded order')\n230:     check(column_positions(snap) == [1, 2, 3], 'board column positions must be 1..3')\n231:     check([c['card_count'] for c in snap['columns']] == [0, 0, 0], 'new columns must be empty')\n232: \n233:     status, body = http(base, 'POST', '/api/boards/%d/columns' % board_id, {'name': '阻塞'})\n234:     check(status == 201, 'column creation failed: %s %s' % (status, body))\n235:     fourth = body['column']['id']\n236:     check(body['column']['position'] == 4, 'a new column must be appended at the end')\n237:     snap = snapshot(base, board_id)\n238:     check(column_ids(snap) == [first, second, third, fourth], 'the new column is not at the end')\n239: \n240:     status, body = http(base, 'PATCH', '/api/columns/%d' % first, {'name': '待处理'})\n241:     check(status == 200, 'column rename failed: %s %s' % (status, body))\n242:     check(body['column']['name'] == '待处理', 'the column rename was not applied')\n243:     check(body['column']['position'] == 1, 'a rename must not change the column position')\n244: \n245:     status, body = http(base, 'PUT', '/api/columns/%d/position' % fourth, {'position': 1})\n246:     check(status == 200, 'column reorder failed: %s %s' % (status, body))\n247:     expected = [fourth, first, second, third]\n248:     check([c['id'] for c in body['columns']] == expected, 'the reorder response order is wrong')\n249:     check([c['position'] for c in body['columns']] == [1, 2, 3, 4], 'the reordered positions must be 1..4')\n250:     snap = snapshot(base, board_id)\n251:     check(column_ids(snap) == expected, 'the reorder was not persisted')\n252:     check(column_positions(snap) == [1, 2, 3, 4], 'the persisted positions must be 1..4')\n253:     check(column_names(snap) == ['阻塞', '待处理', '进行中', '完成'], 'the names did not follow their columns')\n254: \n255:     state = board_state(snapshot(base, board_id))\n256:     for payload, want_status, want_code in (\n257:         ({'position': 0}, 422, 'POSITION_OUT_OF_RANGE'),\n258:         ({'position': 99}, 422, 'POSITION_OUT_OF_RANGE'),\n259:     ):\n260:         status, body = http(base, 'PUT', '/api/columns/%d/position' % fourth, payload)\n261:         expect_error(status, body, want_status, want_code)\n262:         check(board_state(snapshot(base, board_id)) == state, 'a rejected column move changed the board')\n263:     status, body = http(base, 'PATCH', '/api/columns/%d' % fourth, {'name': ''})\n264:     expect_error(status, body, 422, 'NAME_REQUIRED')\n265:     check(board_state(snapshot(base, board_id)) == state, 'a rejected rename changed the board')\n266:     status, body = http(base, 'PATCH', '/api/columns/%d' % fourth, {'name': '进行中'})\n267:     expect_error(status, body, 409, 'DUPLICATE_COLUMN_NAME')\n268:     check(board_state(snapshot(base, board_id)) == state, 'a rejected duplicate name changed the board')\n269:     status, body = http(base, 'POST', '/api/boards/%d/columns' % board_id, {'name': '新列', 'task_limit': 3})\n270:     expect_error(status, body, 422, 'FORBIDDEN_FIELD')\n271:     status, body = http(base, 'POST', '/api/boards/%d/columns' % board_id, {'name': '新列', 'wip_limit': 3})\n272:     expect_error(status, body, 422, 'FORBIDDEN_FIELD')\n273:     status, body = http(base, 'POST', '/api/boards/%d/columns' % board_id, {'name': '新列', 'colour': 'red'})\n274:     expect_error(status, body, 422, 'UNKNOWN_FIELD')\n275:     check(board_state(snapshot(base, board_id)) == state, 'a rejected column creation changed the board')\n276: \n277:     card = make_card(base, board_id, '占位卡片', fourth)\n278:     status, body = http(base, 'DELETE', '/api/columns/%d' % fourth)\n279:     expect_error(status, body, 409, 'COLUMN_NOT_EMPTY')\n280:     snap = snapshot(base, board_id)\n281:     check(cards_in(snap, fourth) == [card['id']], 'a rejected column delete dropped the card')\n282: \n283:     status, body = http(base, 'DELETE', '/api/cards/%d' % card['id'])\n284:     check(status == 204, 'card cleanup failed: %s %s' % (status, body))\n285:     status, body = http(base, 'DELETE', '/api/columns/%d' % fourth)\n286:     check(status == 204, 'column delete failed: %s %s' % (status, body))\n287:     snap = snapshot(base, board_id)\n288:     check(column_ids(snap) == [first, second, third], 'the column was not deleted')\n289:     check(column_positions(snap) == [1, 2, 3], 'the remaining columns must be renumbered 1..3')\n290: \n291:     solo_board, solo_columns = make_board(base, columns=['唯一列'])\n292:     status, body = http(base, 'DELETE', '/api/columns/%d' % solo_columns[0]['id'])\n293:     expect_error(status, body, 409, 'LAST_COLUMN')\n294:     status, body = http(base, 'GET', '/api/boards/%d' % solo_board['id'])\n295:     check(status == 200 and len(body['columns']) == 1, 'the last column was removed')\n296:     drop_board(base, solo_board['id'])\n297:     drop_board(base, board_id)\n298:     return 'columns: seed/add/rename/reorder plus 7 rejected writes, delete guards, renumbering to 1..N'\n299: \n300: \n301: def case_a03(base):\n302:     board, columns = make_board(base, columns=['待办', '进行中'])\n303:     board_id = board['id']\n304:     first, second = [c['id'] for c in columns]\n305: \n306:     status, body = http(base, 'POST', '/api/boards/%d/cards' % board_id,\n307:                         {'title': '写 README', 'description': '补齐使用说明', 'column_id': first})\n308:     check(status == 201, 'card creation failed: %s %s' % (status, body))\n309:     card = body['card']\n310:     check(card['position'] == 1, 'the first card of a column must have position 1')\n311:     check(card['column_id'] == first, 'the card must be created in the requested column')\n312:     check(card['description'] == '补齐使用说明', 'the description must be stored verbatim')\n313:     check(card['moved_at'] == card['created_at'], 'moved_at must equal created_at on creation')\n314:     check(card['updated_at'] == card['created_at'], 'updated_at must equal created_at on creation')\n315:     check(card['board_id'] == board_id, 'the card must carry the board id')\n316:     first_card = card['id']\n317: \n318:     status, body = http(base, 'POST', '/api/boards/%d/cards' % board_id,\n319:                         {'title': '第二张卡', 'column_id': first})\n320:     check(status == 201, 'second card creation failed: %s %s' % (status, body))\n321:     second_card = body['card']['id']\n322:     check(body['card']['position'] == 2, 'the second card must be appended at position 2')\n323: \n324:     snap = snapshot(base, board_id)\n325:     check(cards_in(snap, first) == [first_card, second_card], 'the card order inside the column is wrong')\n326:     check(card_positions(snap, first) == [1, 2], 'the card positions must be contiguous')\n327:     check(snap['board']['card_count'] == 2, 'the board card_count must be 2')\n328:     check([c['card_count'] for c in snap['columns']] == [2, 0], 'the column card counts are wrong')\n329: \n330:     before = board_state(snapshot(base, board_id))\n331:     rejections = (\n332:         ({'title': '', 'column_id': first}, 422, 'TITLE_REQUIRED'),\n333:         ({'title': 'x' * 201, 'column_id': first}, 422, 'TITLE_TOO_LONG'),\n334:         ({'title': 'ok', 'description': 'y' * 501, 'column_id': first}, 422, 'DESCRIPTION_TOO_LONG'),\n335:         ({'title': 'ok'}, 422, 'COLUMN_REQUIRED'),\n336:         ({'title': 'ok', 'column_id': 999999999}, 404, 'COLUMN_NOT_FOUND'),\n337:         ({'title': 'ok', 'column_id': first, 'status': 'doing'}, 422, 'FORBIDDEN_FIELD'),\n338:         ({'title': 'ok', 'column_id': first, 'due_date': '2026-12-31'}, 422, 'FORBIDDEN_FIELD'),\n339:         ({'title': 'ok', 'column_id': first, 'recurrence_trigger': 'daily'}, 422, 'FORBIDDEN_FIELD'),\n340:         ({'title': 'ok', 'column_id': first, 'assignee': 'me'}, 422, 'FORBIDDEN_FIELD'),\n341:         ({'title': 'ok', 'column_id': first, 'priority': 3}, 422, 'FORBIDDEN_FIELD'),\n342:         ({'title': 'ok', 'column_id': first, 'swimlane_id': 2}, 422, 'FORBIDDEN_FIELD'),\n343:         ({'title': 'ok', 'column_id': first, 'colour': 'red'}, 422, 'UNKNOWN_FIELD'),\n344:     )\n345:     for payload, want_status, want_code in rejections:\n346:         status, body = http(base, 'POST', '/api/boards/%d/cards' % board_id, payload)\n347:         expect_error(status, body, want_status, want_code)\n348:     after = board_state(snapshot(base, board_id))\n349:     check(after == before, 'a rejected card creation changed the board state')\n350: \n351:     status, body = http(base, 'PATCH', '/api/cards/%d' % first_card, {'title': '写 README（修订）'})\n352:     check(status == 200, 'card edit failed: %s %s' % (status, body))\n353:     edited = body['card']\n354:     check(edited['title'] == '写 README（修订）', 'the edited title was not stored')\n355:     check(edited['description'] == '补齐使用说明', 'an edit must not drop the description')\n356:     check(edited['position'] == 1, 'an edit must not change the position')\n357:     check(edited['column_id'] == first, 'an edit must not change the column')\n358:     check(edited['moved_at'] == edited['created_at'], 'an edit must not change moved_at')\n359:     check(edited['updated_at'] >= edited['created_at'], 'updated_at went backwards')\n360: \n361:     status, body = http(base, 'PATCH', '/api/cards/%d' % first_card, {'column_id': second})\n362:     expect_error(status, body, 422, 'COLUMN_CHANGE_REQUIRES_MOVE')\n363:     status, body = http(base, 'PATCH', '/api/cards/%d' % first_card, {'position': 2})\n364:     expect_error(status, body, 422, 'POSITION_CHANGE_REQUIRES_MOVE')\n365:     snap = snapshot(base, board_id)\n366:     check(cards_in(snap, first) == [first_card, second_card], 'a rejected patch moved the card')\n367: \n368:     status, body = http(base, 'GET', '/api/cards/%d' % first_card)\n369:     check(status == 200, 'GET card failed: %s %s' % (status, body))\n370:     check(body['card']['id'] == first_card, 'GET card returned another card')\n371:     status, body = http(base, 'GET', '/api/cards/999999999')\n372:     expect_error(status, body, 404, 'CARD_NOT_FOUND')\n373: \n374:     drop_board(base, board_id)\n375:     return 'cards: create/read/edit plus 12 rejected writes, board state byte-identical before and after'\n376: \n377: \n378: def case_a04(base):\n379:     board, columns = make_board(base, columns=['待办', '进行中', '完成'])\n380:     board_id = board['id']\n381:     first, second, third = [c['id'] for c in columns]\n382:     card_a = make_card(base, board_id, 'A', first)['id']\n383:     card_b = make_card(base, board_id, 'B', first)['id']\n384:     card_c = make_card(base, board_id, 'C', first)['id']\n385:     card_d = make_card(base, board_id, 'D', second)['id']\n386: \n387:     snap = snapshot(base, board_id)\n388:     check(cards_in(snap, first) == [card_a, card_b, card_c], 'the setup order in the first column is wrong')\n389:     check(cards_in(snap, second) == [card_d], 'the setup order in the second column is wrong')\n390:     check(card_positions(snap, first) == [1, 2, 3], 'the setup positions are wrong')\n391: \n392:     status, body = http(base, 'POST', '/api/cards/%d/move' % card_a,\n393:                         {'column_id': second, 'position': 1})\n394:     check(status == 200, 'cross column move failed: %s %s' % (status, body))\n395:     moved = body['card']\n396:     check(moved['column_id'] == second, 'the moved card is not in the target column')\n397:     check(moved['position'] == 1, 'the moved card is not at the requested slot')\n398:     check(moved['moved_at'] >= moved['created_at'], 'moved_at is before created_at')\n399:     check([c['card_ids'] for c in body['columns']] == [[card_b, card_c], [card_a, card_d], []],\n400:           'the move response does not show the renumbered columns')\n401: \n402:     snap = snapshot(base, board_id)\n403:     check(cards_in(snap, first) == [card_b, card_c], 'the source column order is wrong after the move')\n404:     check(card_positions(snap, first) == [1, 2], 'the source column was not renumbered to 1..M-1')\n405:     check(cards_in(snap, second) == [card_a, card_d], 'the target column order is wrong after the move')\n406:     check(card_positions(snap, second) == [1, 2], 'the target column positions are not contiguous')\n407:     check(snap['board']['card_count'] == 4, 'a move must not change the board card count')\n408: \n409:     status, body = http(base, 'POST', '/api/cards/%d/move' % card_c,\n410:                         {'column_id': first, 'position': 1})\n411:     check(status == 200, 'in column reorder failed: %s %s' % (status, body))\n412:     snap = snapshot(base, board_id)\n413:     check(cards_in(snap, first) == [card_c, card_b], 'the in column reorder is wrong')\n414:     check(card_positions(snap, first) == [1, 2], 'the in column reorder positions are wrong')\n415: \n416:     status, body = http(base, 'POST', '/api/cards/%d/move' % card_b,\n417:                         {'column_id': third, 'position': 1})\n418:     check(status == 200, 'move to the third column failed: %s %s' % (status, body))\n419:     snap = snapshot(base, board_id)\n420:     check(cards_in(snap, third) == [card_b], 'the card did not land in the third column')\n421:     check(cards_in(snap, first) == [card_c], 'the source column was not emptied')\n422:     check(card_positions(snap, first) == [1], 'the emptied column must be renumbered to 1')\n423: \n424:     before = board_state(snapshot(base, board_id))\n425:     for payload, want_status, want_code in (\n426:         ({'column_id': second, 'position': 99}, 422, 'POSITION_OUT_OF_RANGE'),\n427:         ({'column_id': second, 'position': 0}, 422, 'POSITION_OUT_OF_RANGE'),\n428:         ({'column_id': 999999999, 'position': 1}, 404, 'COLUMN_NOT_FOUND'),\n429:     ):\n430:         status, body = http(base, 'POST', '/api/cards/%d/move' % card_a, payload)\n431:         expect_error(status, body, want_status, want_code)\n432:         check(board_state(snapshot(base, board_id)) == before, 'a rejected move changed the board')\n433: \n434:     other_board, other_columns = make_board(base, columns=['别的看板'])\n435:     status, body = http(base, 'POST', '/api/cards/%d/move' % card_a,\n436:                         {'column_id': other_columns[0]['id'], 'position': 1})\n437:     expect_error(status, body, 422, 'COLUMN_BOARD_MISMATCH')\n438:     check(board_state(snapshot(base, board_id)) == before, 'a rejected cross board move changed the board')\n439:     drop_board(base, other_board['id'])\n440: \n441:     status, body = http(base, 'POST', '/api/cards/999999999/move',\n442:                         {'column_id': first, 'position': 1})\n443:     expect_error(status, body, 404, 'CARD_NOT_FOUND')\n444: \n445:     status, body = http(base, 'POST', '/api/cards/%d/move' % card_a,\n446:                         {'column_id': second, 'position': 1})\n447:     check(status == 200, 'the idempotent move failed: %s %s' % (status, body))\n448:     snap = snapshot(base, board_id)\n449:     check(cards_in(snap, second) == [card_a, card_d], 'a no-op move changed the column order')\n450: \n451:     drop_board(base, board_id)\n452:     return 'movement: cross column move, in column reorder, renumbering, 4 rejected moves with zero-write re-reads'\n453: \n454: \n455: def case_a05(base):\n456:     board, columns = make_board(base, columns=['待办', '进行中', '完成'])\n457:     board_id = board['id']\n458:     first, second, third = [c['id'] for c in columns]\n459:     make_card(base, board_id, '写文档', first, '整理需求')\n460:     make_card(base, board_id, '复习', first)\n461:     make_card(base, board_id, '备课', second)\n462:     make_card(base, board_id, '收尾', third)\n463: \n464:     expected = {'待办': ['写文档', '复习'], '进行中': ['备课'], '完成': ['收尾']}\n465:     snap = snapshot(base, board_id)\n466:     check(column_names(snap) == ['待办', '进行中', '完成'], 'the column order is wrong')\n467:     check(column_positions(snap) == [1, 2, 3], 'the column positions must be 1..3')\n468:     check(snap['board']['column_count'] == 3, 'the board column_count must be 3')\n469:     check(snap['board']['card_count'] == 4, 'the board card_count must be 4')\n470:     titles = {}\n471:     for column in snap['columns']:\n472:         check(column['card_count'] == len(column['cards']),\n473:               'card_count must equal the card list length in column %d' % column['id'])\n474:         check([card['position'] for card in column['cards']] == list(range(1, len(column['cards']) + 1)),\n475:               'the card positions of column %d are not contiguous' % column['id'])\n476:         titles[column['name']] = [card['title'] for card in column['cards']]\n477:     check(titles == expected, 'the card distribution differs: %s' % titles)\n478:     check(sum(column['card_count'] for column in snap['columns']) == 4, 'the column counts must sum to 4')\n479: \n480:     snap2 = snapshot(base, board_id)\n481:     check(snap2 == snap, 'two consecutive board reads are not identical')\n482: \n483:     status, body = http(base, 'GET', '/api/boards')\n484:     check(status == 200, 'GET /api/boards failed: %s %s' % (status, body))\n485:     entry = [item for item in body['boards'] if item['id'] == board_id]\n486:     check(len(entry) == 1, 'the board must appear exactly once in the list')\n487:     check(entry[0]['card_count'] == 4 and entry[0]['column_count'] == 3, 'the list counts are wrong')\n488: \n489:     now = int(time.time())\n490:     for column in snap['columns']:\n491:         for card in column['cards']:\n492:             check(isinstance(card['created_at'], int), 'created_at must be an integer')\n493:             check(isinstance(card['updated_at'], int), 'updated_at must be an integer')\n494:             check(isinstance(card['moved_at'], int), 'moved_at must be an integer')\n495:             check(card['created_at'] <= card['updated_at'], 'updated_at is before created_at')\n496:             check(card['created_at'] <= card['moved_at'], 'moved_at is before created_at')\n497:             check(PROBE_START - 10 <= card['created_at'] <= now + 2, 'created_at is outside the probe window')\n498: \n499:     drop_board(base, board_id)\n500:     return 'read model: 3 columns, 4 cards, exact counts and sets, contiguous positions, stable second read'\n501: \n502: \n503: def main(argv=None):\n504:     parser = argparse.ArgumentParser(description='Acceptance probe for the Personal Project Board')\n505:     parser.add_argument('--base-url', default='http://127.0.0.1:8765',\n506:                         help='base URL of the running target')\n507:     parser.add_argument('--case', action='append', choices=['all'] + list(CASE_IDS),\n508:                         help='case id A01..A05 or all; repeatable')\n509:     args = parser.parse_args(argv)\n510:     check(len(CASE_IDS) == FEATURE_COUNT, 'the number of cases must match the number of features')\n511: \n512:     selected = args.case if args.case else ['all']\n513:     case_ids = []\n514:     for item in selected:\n515:         if item == 'all':\n516:             case_ids = list(CASE_IDS)\n517:             break\n518:         case_ids.append(item)\n519: \n520:     base = args.base_url.rstrip('/')\n521:     runners = {'A01': case_a01, 'A02': case_a02, 'A03': case_a03, 'A04': case_a04, 'A05': case_a05}\n522:     failures = []\n523:     for case_id in case_ids:\n524:         started = time.time()\n525:         try:\n526:             summary = runners[case_id](base)\n527:         except urllib.error.URLError as error:\n528:             failures.append(case_id)\n529:             print('ERROR %s: cannot reach the target at %s (%s)' % (case_id, base, error))\n530:         except ProbeFailure as error:\n531:             failures.append(case_id)\n532:             print('FAIL %s: %s' % (case_id, error))\n533:         except Exception as error:\n534:             failures.append(case_id)\n535:             print('ERROR %s: %s: %s' % (case_id, type(error).__name__, error))\n536:         else:\n537:             print('PASS %s (%.2fs) %s' % (case_id, time.time() - started, summary))\n538:             if case_id == 'A05':\n539:                 print('     note: cross process restart durability is an operator step documented in')\n540:                 print('           README.md; the probe does not stop or start the server and does')\n541:                 print('           not report on it.')\n542:     print('cases run: %d, failures: %d' % (len(case_ids), len(failures)))\n543:     if failures:\n544:         print('failed cases: %s' % ', '.join(failures))\n545:         return 1\n546:     return 0\n547: \n548: \n549: if __name__ == '__main__':\n550:     sys.exit(main())","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /Users/milin/2026/软件开发/application-atlas/docs/template-factory/go-minimax-batch-2026-10-21/personal-kanban/calls/blueprint-spec-review-aux/source/candidate/acceptance/probe.py, lines 1-550\n1: #!/usr/bin/env python3\n2: '''Acceptance probe for the Personal Project Board target (localhost, single user).\n3: \n4: Usage:\n5:     python3 probe.py --base-url http://127.0.0.1:8765 --case A01\n6:     python3 probe.py --base-url http://127.0.0.1:8765 --case all\n7: \n8: Cases (one per feature): A01 boards, A02 columns, A03 cards,\n9: A04 movement and ordering, A05 board read model.\n10: \n11: The probe writes to a live local server. Each case creates its own disposable\n12: board and deletes only the records that this probe created; no pre-existing\n13: record is ever deleted. Every rejected request is followed by a re-read that\n14: proves the rejected write did not happen.\n15: '''\n16: \n17: import argparse\n18: import json\n19: import sys\n20: import time\n21: import urllib.error\n22: import urllib.request\n23: import uuid\n24: \n25: PROBE_START = int(time.time())\n26: FEATURE_COUNT = 5\n27: CASE_IDS = ('A01', 'A02', 'A03', 'A04', 'A05')\n28: \n29: \n30: class ProbeFailure(Exception):\n31:     '''Raised when an assertion about the documented API fails.'''\n32: \n33: \n34: def check(condition, message):\n35:     if not condition:\n36:         raise ProbeFailure(message)\n37: \n38: \n39: def parse_json(raw):\n40:     if raw is None:\n41:         return None\n42:     text = raw.strip()\n43:     if text == '':\n44:         return None\n45:     try:\n46:         return json.loads(text)\n47:     except ValueError:\n48:         return {'_raw': text}\n49: \n50: \n51: def http(base, method, path, payload=None, raw_body=None):\n52:     url = base.rstrip('/') + path\n53:     data = None\n54:     headers = {'Accept': 'application/json'}\n55:     if raw_body is not None:\n56:         data = raw_body.encode('utf-8')\n57:         headers['Content-Type'] = 'application/json'\n58:     elif payload is not None:\n59:         data = json.dumps(payload, ensure_ascii=False).encode('utf-8')\n60:         headers['Content-Type'] = 'application/json'\n61:     request = urllib.request.Request(url, data=data, headers=headers, method=method)\n62:     try:\n63:         with urllib.request.urlopen(request, timeout=20) as response:\n64:             return response.status, parse_json(response.read().decode('utf-8'))\n65:     except urllib.error.HTTPError as error:\n66:         return error.code, parse_json(error.read().decode('utf-8'))\n67: \n68: \n69: def expect_error(status, body, want_status, want_code):\n70:     check(status == want_status, 'expected HTTP %s, got %s (%s)' % (want_status, status, body))\n71:     error = {}\n72:     if isinstance(body, dict):\n73:         error = body.get('error') or {}\n74:     check(error.get('code') == want_code, 'expected error code %s, got %s' % (want_code, body))\n75: \n76: \n77: def snapshot(base, board_id):\n78:     status, body = http(base, 'GET', '/api/boards/%d' % board_id)\n79:     check(status == 200, 'GET /api/boards/%d failed: %s %s' % (board_id, status, body))\n80:     check(isinstance(body, dict) and 'columns' in body, 'board snapshot has no columns: %s' % body)\n81:     return body\n82: \n83: \n84: def board_state(snap):\n85:     '''Everything the target stores for one board, for exact zero-write comparison.'''\n86:     return {\n87:         'columns': [(c['id'], c['name'], c['position'], c['card_count']) for c in snap['columns']],\n88:         'cards': [[(card['id'], card['title'], card['description'], card['position'],\n89:                     card['column_id'], card['updated_at']) for card in c['cards']]\n90:                   for c in snap['columns']],\n91:     }\n92: \n93: \n94: def column_ids(snap):\n95:     return [column['id'] for column in snap['columns']]\n96: \n97: \n98: def column_names(snap):\n99:     return [column['name'] for column in snap['columns']]\n100: \n101: \n102: def column_positions(snap):\n103:     return [column['position'] for column in snap['columns']]\n104: \n105: \n106: def cards_in(snap, column_id):\n107:     for column in snap['columns']:\n108:         if column['id'] == column_id:\n109:             return [card['id'] for card in column['cards']]\n110:     raise ProbeFailure('column %s is not part of the board snapshot' % column_id)\n111: \n112: \n113: def card_positions(snap, column_id):\n114:     for column in snap['columns']:\n115:         if column['id'] == column_id:\n116:             return [card['position'] for card in column['cards']]\n117:     raise ProbeFailure('column %s is not part of the board snapshot' % column_id)\n118: \n119: \n120: def card_of(snap, card_id):\n121:     for column in snap['columns']:\n122:         for card in column['cards']:\n123:             if card['id'] == card_id:\n124:                 return card\n125:     raise ProbeFailure('card %s is not part of the board snapshot' % card_id)\n126: \n127: \n128: def make_board(base, name=None, columns=None):\n129:     payload = {'name': name or ('probe-%s' % uuid.uuid4().hex[:8])}\n130:     if columns is not None:\n131:         payload['columns'] = columns\n132:     status, body = http(base, 'POST', '/api/boards', payload)\n133:     check(status == 201, 'board creation failed: %s %s' % (status, body))\n134:     check(isinstance(body, dict) and 'board' in body, 'board response has no board: %s' % body)\n135:     return body['board'], body.get('columns', [])\n136: \n137: \n138: def make_card(base, board_id, title, column_id, description=None):\n139:     payload = {'title': title, 'column_id': column_id}\n140:     if description is not None:\n141:         payload['description'] = description\n142:     status, body = http(base, 'POST', '/api/boards/%d/cards' % board_id, payload)\n143:     check(status == 201, 'card creation failed: %s %s' % (status, body))\n144:     return body['card']\n145: \n146: \n147: def drop_board(base, board_id):\n148:     status, body = http(base, 'DELETE', '/api/boards/%d' % board_id)\n149:     check(status == 204, 'board cleanup failed: %s %s' % (status, body))\n150: \n151: \n152: def case_a01(base):\n153:     status, body = http(base, 'GET', '/api/health')\n154:     check(status == 200, 'GET /api/health failed: %s %s' % (status, body))\n155:     check(isinstance(body, dict) and body.get('status') == 'ok', 'health payload is not ok: %s' % body)\n156: \n157:     status, body = http(base, 'GET', '/api/boards')\n158:     check(status == 200, 'GET /api/boards failed: %s %s' % (status, body))\n159:     before = len(body['boards'])\n160: \n161:     board, columns = make_board(base, columns=[])\n162:     board_id = board['id']\n163:     check(isinstance(board_id, int) and board_id > 0, 'board id must be a positive integer')\n164:     check(columns == [], 'a board must be created without columns')\n165:     check(isinstance(board['created_at'], int), 'created_at must be an integer epoch second')\n166:     check(isinstance(board['updated_at'], int), 'updated_at must be an integer epoch second')\n167:     check(board['updated_at'] >= board['created_at'], 'updated_at must not be before created_at')\n168:     check(PROBE_START - 10 <= board['created_at'] <= int(time.time()) + 2, 'created_at outside the probe window')\n169:     check(board.get('column_count') == 0 and board.get('card_count') == 0, 'a new board must report empty counts')\n170: \n171:     status, body = http(base, 'GET', '/api/boards')\n172:     check(status == 200, 'GET /api/boards failed: %s %s' % (status, body))\n173:     check(len(body['boards']) == before + 1, 'the board list must grow by exactly one board')\n174:     listed = [entry for entry in body['boards'] if entry['id'] == board_id]\n175:     check(len(listed) == 1, 'the created board must appear exactly once in the list')\n176:     check(listed[0]['name'] == board['name'], 'the list must carry the same board name')\n177: \n178:     snap = snapshot(base, board_id)\n179:     check(snap['board']['name'] == board['name'], 'GET board must return the same name')\n180:     check(snap['columns'] == [], 'GET board must return no columns for a new board')\n181: \n182:     rejections = (\n183:         ({'name': ''}, 422, 'NAME_REQUIRED'),\n184:         ({'name': '   '}, 422, 'NAME_REQUIRED'),\n185:         ({'name': 'x' * 121}, 422, 'NAME_TOO_LONG'),\n186:         ({'name': 'ok', 'status': 'doing'}, 422, 'FORBIDDEN_FIELD'),\n187:         ({'name': 'ok', 'assignee': 'me'}, 422, 'FORBIDDEN_FIELD'),\n188:         ({'name': 'ok', 'colour': 'red'}, 422, 'UNKNOWN_FIELD'),\n189:     )\n190:     for payload, want_status, want_code in rejections:\n191:         status, body = http(base, 'POST', '/api/boards', payload)\n192:         expect_error(status, body, want_status, want_code)\n193:         status, body = http(base, 'GET', '/api/boards')\n194:         check(status == 200, 'GET /api/boards failed: %s %s' % (status, body))\n195:         check(len(body['boards']) == before + 1, 'a rejected board creation wrote a board (%s)' % want_code)\n196: \n197:     status, body = http(base, 'POST', '/api/boards', raw_body='{not json')\n198:     expect_error(status, body, 400, 'MALFORMED_JSON')\n199:     status, body = http(base, 'GET', '/api/boards')\n200:     check(len(body['boards']) == before + 1, 'a malformed request wrote a board')\n201: \n202:     status, body = http(base, 'GET', '/api/boards/999999999')\n203:     expect_error(status, body, 404, 'BOARD_NOT_FOUND')\n204: \n205:     renamed = 'probe-renamed-%s' % uuid.uuid4().hex[:8]\n206:     status, body = http(base, 'PATCH', '/api/boards/%d' % board_id, {'name': renamed})\n207:     check(status == 200, 'board rename failed: %s %s' % (status, body))\n208:     check(body['board']['name'] == renamed, 'the rename was not applied')\n209:     check(body['board']['id'] == board_id, 'the rename changed the board id')\n210:     check(body['board']['updated_at'] >= board['created_at'], 'updated_at went backwards')\n211: \n212:     drop_board(base, board_id)\n213:     status, body = http(base, 'GET', '/api/boards/%d' % board_id)\n214:     expect_error(status, body, 404, 'BOARD_NOT_FOUND')\n215:     status, body = http(base, 'GET', '/api/boards')\n216:     check(len(body['boards']) == before, 'the board list must return to its original size')\n217:     return 'boards: create/list/read/rename/delete plus 7 rejected writes with zero-write re-reads'\n218: \n219: \n220: def case_a02(base):\n221:     board, columns = make_board(base, columns=['待办', '进行中', '完成'])\n222:     board_id = board['id']\n223:     check(len(columns) == 3, 'expected three seeded columns, got %d' % len(columns))\n224:     check([c['name'] for c in columns] == ['待办', '进行中', '完成'], 'seeded column names or order differ')\n225:     check([c['position'] for c in columns] == [1, 2, 3], 'seeded column positions must be 1..3')\n226:     first, second, third = [c['id'] for c in columns]\n227: \n228:     snap = snapshot(base, board_id)\n229:     check(column_ids(snap) == [first, second, third], 'board columns are not in the seeded order')\n230:     check(column_positions(snap) == [1, 2, 3], 'board column positions must be 1..3')\n231:     check([c['card_count'] for c in snap['columns']] == [0, 0, 0], 'new columns must be empty')\n232: \n233:     status, body = http(base, 'POST', '/api/boards/%d/columns' % board_id, {'name': '阻塞'})\n234:     check(status == 201, 'column creation failed: %s %s' % (status, body))\n235:     fourth = body['column']['id']\n236:     check(body['column']['position'] == 4, 'a new column must be appended at the end')\n237:     snap = snapshot(base, board_id)\n238:     check(column_ids(snap) == [first, second, third, fourth], 'the new column is not at the end')\n239: \n240:     status, body = http(base, 'PATCH', '/api/columns/%d' % first, {'name': '待处理'})\n241:     check(status == 200, 'column rename failed: %s %s' % (status, body))\n242:     check(body['column']['name'] == '待处理', 'the column rename was not applied')\n243:     check(body['column']['position'] == 1, 'a rename must not change the column position')\n244: \n245:     status, body = http(base, 'PUT', '/api/columns/%d/position' % fourth, {'position': 1})\n246:     check(status == 200, 'column reorder failed: %s %s' % (status, body))\n247:     expected = [fourth, first, second, third]\n248:     check([c['id'] for c in body['columns']] == expected, 'the reorder response order is wrong')\n249:     check([c['position'] for c in body['columns']] == [1, 2, 3, 4], 'the reordered positions must be 1..4')\n250:     snap = snapshot(base, board_id)\n251:     check(column_ids(snap) == expected, 'the reorder was not persisted')\n252:     check(column_positions(snap) == [1, 2, 3, 4], 'the persisted positions must be 1..4')\n253:     check(column_names(snap) == ['阻塞', '待处理', '进行中', '完成'], 'the names did not follow their columns')\n254: \n255:     state = board_state(snapshot(base, board_id))\n256:     for payload, want_status, want_code in (\n257:         ({'position': 0}, 422, 'POSITION_OUT_OF_RANGE'),\n258:         ({'position': 99}, 422, 'POSITION_OUT_OF_RANGE'),\n259:     ):\n260:         status, body = http(base, 'PUT', '/api/columns/%d/position' % fourth, payload)\n261:         expect_error(status, body, want_status, want_code)\n262:         check(board_state(snapshot(base, board_id)) == state, 'a rejected column move changed the board')\n263:     status, body = http(base, 'PATCH', '/api/columns/%d' % fourth, {'name': ''})\n264:     expect_error(status, body, 422, 'NAME_REQUIRED')\n265:     check(board_state(snapshot(base, board_id)) == state, 'a rejected rename changed the board')\n266:     status, body = http(base, 'PATCH', '/api/columns/%d' % fourth, {'name': '进行中'})\n267:     expect_error(status, body, 409, 'DUPLICATE_COLUMN_NAME')\n268:     check(board_state(snapshot(base, board_id)) == state, 'a rejected duplicate name changed the board')\n269:     status, body = http(base, 'POST', '/api/boards/%d/columns' % board_id, {'name': '新列', 'task_limit': 3})\n270:     expect_error(status, body, 422, 'FORBIDDEN_FIELD')\n271:     status, body = http(base, 'POST', '/api/boards/%d/columns' % board_id, {'name': '新列', 'wip_limit': 3})\n272:     expect_error(status, body, 422, 'FORBIDDEN_FIELD')\n273:     status, body = http(base, 'POST', '/api/boards/%d/columns' % board_id, {'name': '新列', 'colour': 'red'})\n274:     expect_error(status, body, 422, 'UNKNOWN_FIELD')\n275:     check(board_state(snapshot(base, board_id)) == state, 'a rejected column creation changed the board')\n276: \n277:     card = make_card(base, board_id, '占位卡片', fourth)\n278:     status, body = http(base, 'DELETE', '/api/columns/%d' % fourth)\n279:     expect_error(status, body, 409, 'COLUMN_NOT_EMPTY')\n280:     snap = snapshot(base, board_id)\n281:     check(cards_in(snap, fourth) == [card['id']], 'a rejected column delete dropped the card')\n282: \n283:     status, body = http(base, 'DELETE', '/api/cards/%d' % card['id'])\n284:     check(status == 204, 'card cleanup failed: %s %s' % (status, body))\n285:     status, body = http(base, 'DELETE', '/api/columns/%d' % fourth)\n286:     check(status == 204, 'column delete failed: %s %s' % (status, body))\n287:     snap = snapshot(base, board_id)\n288:     check(column_ids(snap) == [first, second, third], 'the column was not deleted')\n289:     check(column_positions(snap) == [1, 2, 3], 'the remaining columns must be renumbered 1..3')\n290: \n291:     solo_board, solo_columns = make_board(base, columns=['唯一列'])\n292:     status, body = http(base, 'DELETE', '/api/columns/%d' % solo_columns[0]['id'])\n293:     expect_error(status, body, 409, 'LAST_COLUMN')\n294:     status, body = http(base, 'GET', '/api/boards/%d' % solo_board['id'])\n295:     check(status == 200 and len(body['columns']) == 1, 'the last column was removed')\n296:     drop_board(base, solo_board['id'])\n297:     drop_board(base, board_id)\n298:     return 'columns: seed/add/rename/reorder plus 7 rejected writes, delete guards, renumbering to 1..N'\n299: \n300: \n301: def case_a03(base):\n302:     board, columns = make_board(base, columns=['待办', '进行中'])\n303:     board_id = board['id']\n304:     first, second = [c['id'] for c in columns]\n305: \n306:     status, body = http(base, 'POST', '/api/boards/%d/cards' % board_id,\n307:                         {'title': '写 README', 'description': '补齐使用说明', 'column_id': first})\n308:     check(status == 201, 'card creation failed: %s %s' % (status, body))\n309:     card = body['card']\n310:     check(card['position'] == 1, 'the first card of a column must have position 1')\n311:     check(card['column_id'] == first, 'the card must be created in the requested column')\n312:     check(card['description'] == '补齐使用说明', 'the description must be stored verbatim')\n313:     check(card['moved_at'] == card['created_at'], 'moved_at must equal created_at on creation')\n314:     check(card['updated_at'] == card['created_at'], 'updated_at must equal created_at on creation')\n315:     check(card['board_id'] == board_id, 'the card must carry the board id')\n316:     first_card = card['id']\n317: \n318:     status, body = http(base, 'POST', '/api/boards/%d/cards' % board_id,\n319:                         {'title': '第二张卡', 'column_id': first})\n320:     check(status == 201, 'second card creation failed: %s %s' % (status, body))\n321:     second_card = body['card']['id']\n322:     check(body['card']['position'] == 2, 'the second card must be appended at position 2')\n323: \n324:     snap = snapshot(base, board_id)\n325:     check(cards_in(snap, first) == [first_card, second_card], 'the card order inside the column is wrong')\n326:     check(card_positions(snap, first) == [1, 2], 'the card positions must be contiguous')\n327:     check(snap['board']['card_count'] == 2, 'the board card_count must be 2')\n328:     check([c['card_count'] for c in snap['columns']] == [2, 0], 'the column card counts are wrong')\n329: \n330:     before = board_state(snapshot(base, board_id))\n331:     rejections = (\n332:         ({'title': '', 'column_id': first}, 422, 'TITLE_REQUIRED'),\n333:         ({'title': 'x' * 201, 'column_id': first}, 422, 'TITLE_TOO_LONG'),\n334:         ({'title': 'ok', 'description': 'y' * 501, 'column_id': first}, 422, 'DESCRIPTION_TOO_LONG'),\n335:         ({'title': 'ok'}, 422, 'COLUMN_REQUIRED'),\n336:         ({'title': 'ok', 'column_id': 999999999}, 404, 'COLUMN_NOT_FOUND'),\n337:         ({'title': 'ok', 'column_id': first, 'status': 'doing'}, 422, 'FORBIDDEN_FIELD'),\n338:         ({'title': 'ok', 'column_id': first, 'due_date': '2026-12-31'}, 422, 'FORBIDDEN_FIELD'),\n339:         ({'title': 'ok', 'column_id': first, 'recurrence_trigger': 'daily'}, 422, 'FORBIDDEN_FIELD'),\n340:         ({'title': 'ok', 'column_id': first, 'assignee': 'me'}, 422, 'FORBIDDEN_FIELD'),\n341:         ({'title': 'ok', 'column_id': first, 'priority': 3}, 422, 'FORBIDDEN_FIELD'),\n342:         ({'title': 'ok', 'column_id': first, 'swimlane_id': 2}, 422, 'FORBIDDEN_FIELD'),\n343:         ({'title': 'ok', 'column_id': first, 'colour': 'red'}, 422, 'UNKNOWN_FIELD'),\n344:     )\n345:     for payload, want_status, want_code in rejections:\n346:         status, body = http(base, 'POST', '/api/boards/%d/cards' % board_id, payload)\n347:         expect_error(status, body, want_status, want_code)\n348:     after = board_state(snapshot(base, board_id))\n349:     check(after == before, 'a rejected card creation changed the board state')\n350: \n351:     status, body = http(base, 'PATCH', '/api/cards/%d' % first_card, {'title': '写 README（修订）'})\n352:     check(status == 200, 'card edit failed: %s %s' % (status, body))\n353:     edited = body['card']\n354:     check(edited['title'] == '写 README（修订）', 'the edited title was not stored')\n355:     check(edited['description'] == '补齐使用说明', 'an edit must not drop the description')\n356:     check(edited['position'] == 1, 'an edit must not change the position')\n357:     check(edited['column_id'] == first, 'an edit must not change the column')\n358:     check(edited['moved_at'] == edited['created_at'], 'an edit must not change moved_at')\n359:     check(edited['updated_at'] >= edited['created_at'], 'updated_at went backwards')\n360: \n361:     status, body = http(base, 'PATCH', '/api/cards/%d' % first_card, {'column_id': second})\n362:     expect_error(status, body, 422, 'COLUMN_CHANGE_REQUIRES_MOVE')\n363:     status, body = http(base, 'PATCH', '/api/cards/%d' % first_card, {'position': 2})\n364:     expect_error(status, body, 422, 'POSITION_CHANGE_REQUIRES_MOVE')\n365:     snap = snapshot(base, board_id)\n366:     check(cards_in(snap, first) == [first_card, second_card], 'a rejected patch moved the card')\n367: \n368:     status, body = http(base, 'GET', '/api/cards/%d' % first_card)\n369:     check(status == 200, 'GET card failed: %s %s' % (status, body))\n370:     check(body['card']['id'] == first_card, 'GET card returned another card')\n371:     status, body = http(base, 'GET', '/api/cards/999999999')\n372:     expect_error(status, body, 404, 'CARD_NOT_FOUND')\n373: \n374:     drop_board(base, board_id)\n375:     return 'cards: create/read/edit plus 12 rejected writes, board state byte-identical before and after'\n376: \n377: \n378: def case_a04(base):\n379:     board, columns = make_board(base, columns=['待办', '进行中', '完成'])\n380:     board_id = board['id']\n381:     first, second, third = [c['id'] for c in columns]\n382:     card_a = make_card(base, board_id, 'A', first)['id']\n383:     card_b = make_card(base, board_id, 'B', first)['id']\n384:     card_c = make_card(base, board_id, 'C', first)['id']\n385:     card_d = make_card(base, board_id, 'D', second)['id']\n386: \n387:     snap = snapshot(base, board_id)\n388:     check(cards_in(snap, first) == [card_a, card_b, card_c], 'the setup order in the first column is wrong')\n389:     check(cards_in(snap, second) == [card_d], 'the setup order in the second column is wrong')\n390:     check(card_positions(snap, first) == [1, 2, 3], 'the setup positions are wrong')\n391: \n392:     status, body = http(base, 'POST', '/api/cards/%d/move' % card_a,\n393:                         {'column_id': second, 'position': 1})\n394:     check(status == 200, 'cross column move failed: %s %s' % (status, body))\n395:     moved = body['card']\n396:     check(moved['column_id'] == second, 'the moved card is not in the target column')\n397:     check(moved['position'] == 1, 'the moved card is not at the requested slot')\n398:     check(moved['moved_at'] >= moved['created_at'], 'moved_at is before created_at')\n399:     check([c['card_ids'] for c in body['columns']] == [[card_b, card_c], [card_a, card_d], []],\n400:           'the move response does not show the renumbered columns')\n401: \n402:     snap = snapshot(base, board_id)\n403:     check(cards_in(snap, first) == [card_b, card_c], 'the source column order is wrong after the move')\n404:     check(card_positions(snap, first) == [1, 2], 'the source column was not renumbered to 1..M-1')\n405:     check(cards_in(snap, second) == [card_a, card_d], 'the target column order is wrong after the move')\n406:     check(card_positions(snap, second) == [1, 2], 'the target column positions are not contiguous')\n407:     check(snap['board']['card_count'] == 4, 'a move must not change the board card count')\n408: \n409:     status, body = http(base, 'POST', '/api/cards/%d/move' % card_c,\n410:                         {'column_id': first, 'position': 1})\n411:     check(status == 200, 'in column reorder failed: %s %s' % (status, body))\n412:     snap = snapshot(base, board_id)\n413:     check(cards_in(snap, first) == [card_c, card_b], 'the in column reorder is wrong')\n414:     check(card_positions(snap, first) == [1, 2], 'the in column reorder positions are wrong')\n415: \n416:     status, body = http(base, 'POST', '/api/cards/%d/move' % card_b,\n417:                         {'column_id': third, 'position': 1})\n418:     check(status == 200, 'move to the third column failed: %s %s' % (status, body))\n419:     snap = snapshot(base, board_id)\n420:     check(cards_in(snap, third) == [card_b], 'the card did not land in the third column')\n421:     check(cards_in(snap, first) == [card_c], 'the source column was not emptied')\n422:     check(card_positions(snap, first) == [1], 'the emptied column must be renumbered to 1')\n423: \n424:     before = board_state(snapshot(base, board_id))\n425:     for payload, want_status, want_code in (\n426:         ({'column_id': second, 'position': 99}, 422, 'POSITION_OUT_OF_RANGE'),\n427:         ({'column_id': second, 'position': 0}, 422, 'POSITION_OUT_OF_RANGE'),\n428:         ({'column_id': 999999999, 'position': 1}, 404, 'COLUMN_NOT_FOUND'),\n429:     ):\n430:         status, body = http(base, 'POST', '/api/cards/%d/move' % card_a, payload)\n431:         expect_error(status, body, want_status, want_code)\n432:         check(board_state(snapshot(base, board_id)) == before, 'a rejected move changed the board')\n433: \n434:     other_board, other_columns = make_board(base, columns=['别的看板'])\n435:     status, body = http(base, 'POST', '/api/cards/%d/move' % card_a,\n436:                         {'column_id': other_columns[0]['id'], 'position': 1})\n437:     expect_error(status, body, 422, 'COLUMN_BOARD_MISMATCH')\n438:     check(board_state(snapshot(base, board_id)) == before, 'a rejected cross board move changed the board')\n439:     drop_board(base, other_board['id'])\n440: \n441:     status, body = http(base, 'POST', '/api/cards/999999999/move',\n442:                         {'column_id': first, 'position': 1})\n443:     expect_error(status, body, 404, 'CARD_NOT_FOUND')\n444: \n445:     status, body = http(base, 'POST', '/api/cards/%d/move' % card_a,\n446:                         {'column_id': second, 'position': 1})\n447:     check(status == 200, 'the idempotent move failed: %s %s' % (status, body))\n448:     snap = snapshot(base, board_id)\n449:     check(cards_in(snap, second) == [card_a, card_d], 'a no-op move changed the column order')\n450: \n451:     drop_board(base, board_id)\n452:     return 'movement: cross column move, in column reorder, renumbering, 4 rejected moves with zero-write re-reads'\n453: \n454: \n455: def case_a05(base):\n456:     board, columns = make_board(base, columns=['待办', '进行中', '完成'])\n457:     board_id = board['id']\n458:     first, second, third = [c['id'] for c in columns]\n459:     make_card(base, board_id, '写文档', first, '整理需求')\n460:     make_card(base, board_id, '复习', first)\n461:     make_card(base, board_id, '备课', second)\n462:     make_card(base, board_id, '收尾', third)\n463: \n464:     expected = {'待办': ['写文档', '复习'], '进行中': ['备课'], '完成': ['收尾']}\n465:     snap = snapshot(base, board_id)\n466:     check(column_names(snap) == ['待办', '进行中', '完成'], 'the column order is wrong')\n467:     check(column_positions(snap) == [1, 2, 3], 'the column positions must be 1..3')\n468:     check(snap['board']['column_count'] == 3, 'the board column_count must be 3')\n469:     check(snap['board']['card_count'] == 4, 'the board card_count must be 4')\n470:     titles = {}\n471:     for column in snap['columns']:\n472:         check(column['card_count'] == len(column['cards']),\n473:               'card_count must equal the card list length in column %d' % column['id'])\n474:         check([card['position'] for card in column['cards']] == list(range(1, len(column['cards']) + 1)),\n475:               'the card positions of column %d are not contiguous' % column['id'])\n476:         titles[column['name']] = [card['title'] for card in column['cards']]\n477:     check(titles == expected, 'the card distribution differs: %s' % titles)\n478:     check(sum(column['card_count'] for column in snap['columns']) == 4, 'the column counts must sum to 4')\n479: \n480:     snap2 = snapshot(base, board_id)\n481:     check(snap2 == snap, 'two consecutive board reads are not identical')\n482: \n483:     status, body = http(base, 'GET', '/api/boards')\n484:     check(status == 200, 'GET /api/boards failed: %s %s' % (status, body))\n485:     entry = [item for item in body['boards'] if item['id'] == board_id]\n486:     check(len(entry) == 1, 'the board must appear exactly once in the list')\n487:     check(entry[0]['card_count'] == 4 and entry[0]['column_count'] == 3, 'the list counts are wrong')\n488: \n489:     now = int(time.time())\n490:     for column in snap['columns']:\n491:         for card in column['cards']:\n492:             check(isinstance(card['created_at'], int), 'created_at must be an integer')\n493:             check(isinstance(card['updated_at'], int), 'updated_at must be an integer')\n494:             check(isinstance(card['moved_at'], int), 'moved_at must be an integer')\n495:             check(card['created_at'] <= card['updated_at'], 'updated_at is before created_at')\n496:             check(card['created_at'] <= card['moved_at'], 'moved_at is before created_at')\n497:             check(PROBE_START - 10 <= card['created_at'] <= now + 2, 'created_at is outside the probe window')\n498: \n499:     drop_board(base, board_id)\n500:     return 'read model: 3 columns, 4 cards, exact counts and sets, contiguous positions, stable second read'\n501: \n502: \n503: def main(argv=None):\n504:     parser = argparse.ArgumentParser(description='Acceptance probe for the Personal Project Board')\n505:     parser.add_argument('--base-url', default='http://127.0.0.1:8765',\n506:                         help='base URL of the running target')\n507:     parser.add_argument('--case', action='append', choices=['all'] + list(CASE_IDS),\n508:                         help='case id A01..A05 or all; repeatable')\n509:     args = parser.parse_args(argv)\n510:     check(len(CASE_IDS) == FEATURE_COUNT, 'the number of cases must match the number of features')\n511: \n512:     selected = args.case if args.case else ['all']\n513:     case_ids = []\n514:     for item in selected:\n515:         if item == 'all':\n516:             case_ids = list(CASE_IDS)\n517:             break\n518:         case_ids.append(item)\n519: \n520:     base = args.base_url.rstrip('/')\n521:     runners = {'A01': case_a01, 'A02': case_a02, 'A03': case_a03, 'A04': case_a04, 'A05': case_a05}\n522:     failures = []\n523:     for case_id in case_ids:\n524:         started = time.time()\n525:         try:\n526:             summary = runners[case_id](base)\n527:         except urllib.error.URLError as error:\n528:             failures.append(case_id)\n529:             print('ERROR %s: cannot reach the target at %s (%s)' % (case_id, base, error))\n530:         except ProbeFailure as error:\n531:             failures.append(case_id)\n532:             print('FAIL %s: %s' % (case_id, error))\n533:         except Exception as error:\n534:             failures.append(case_id)\n535:             print('ERROR %s: %s: %s' % (case_id, type(error).__name__, error))\n536:         else:\n537:             print('PASS %s (%.2fs) %s' % (case_id, time.time() - started, summary))\n538:             if case_id == 'A05':\n539:                 print('     note: cross process restart durability is an operator step documented in')\n540:                 print('           README.md; the probe does not stop or start the server and does')\n541:                 print('           not report on it.')\n542:     print('cases run: %d, failures: %d' % (len(case_ids), len(failures)))\n543:     if failures:\n544:         print('failed cases: %s' % ', '.join(failures))\n545:         return 1\n546:     return 0\n547: \n548: \n549: if __name__ == '__main__':\n550:     sys.exit(main())"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/milin/2026/软件开发/application-atlas/docs/template-factory/go-minimax-batch-2026-10-21/personal-kanban/calls/blueprint-spec-review-aux/source/candidate/acceptance/probe.py\"}"},"time":{"start":1792580642351,"end":1792580642357}}}}
