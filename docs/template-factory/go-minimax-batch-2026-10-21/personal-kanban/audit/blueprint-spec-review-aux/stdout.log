->hook->render('template:board:column:dropdown', array('swimlane' => $swimlane, 'column' => $column)) ?>\n84:                     </span>\n85:                 <?php endif ?>\n86:             </span>\n87: \n88:             <span class=\"pull-right board-column-header-task-count\">\n89:                 <?php if (! empty($column['score'])): ?>\n90:                     <span title=\"<?= t('Score') ?>\">\n91:                         <span class=\"ui-helper-hidden-accessible\"><?= t('Score') ?> </span><?= $column['score'] ?>\n92:                     </span>\n93:                 <?php endif ?>\n94: \n95:                 <?php if ($swimlane['nb_swimlanes'] > 1 && ! empty($column['cumulative_score_across_swimlane'])): ?>\n96:                     <span title=\"<?= t('Total score in this column across all swimlanes') ?>\">\n97:                         (<span><span class=\"ui-helper-hidden-accessible\"><?= t('Total score in this column across all swimlanes') ?> </span><?= $column['cumulative_score_across_swimlane'] ?></span>)&nbsp;\n98:                     </span>\n99:                 <?php endif ?>\n100: \n101:                 <?php if (! $not_editable && ! empty($column['description'])): ?>\n102:                     <?= $this->app->tooltipMarkdown($column['description']) ?>&nbsp;\n103:                 <?php endif ?>\n104: \n105:                 <?php if (! empty($column['nb_tasks'])): ?>\n106:                 <span title=\"<?= t('Number of visible tasks in this column and swimlane') ?>\">\n107:                     <span><span class=\"ui-helper-hidden-accessible\"><?= t('Task count') ?> </span><?= $column['nb_tasks'] ?></span>&nbsp;\n108:                 </span>\n109:                 <?php endif ?>\n110: \n111:                 <?php if (! empty($column['nb_unfiltered_tasks_across_swimlane'])): ?>\n112:                 <span title=\"<?= t('Total number of tasks in this column across all swimlanes') ?>\">\n113:                     <?php if ($column['task_limit'] > 0): ?>\n114:                         (<span><span class=\"ui-helper-hidden-accessible\"><?= t('Total number of tasks in this column across all swimlanes') ?> </span><?= $column['nb_unfiltered_tasks_across_swimlane'] ?></span>/<span title=\"<?= t('Task limit') ?>\"><span class=\"ui-helper-hidden-accessible\"><?= t('Task limit') ?> </span><?= $this->text->e($column['task_limit']) ?></span>)\n115:                     <?php else: ?>\n116:                         (<span><span class=\"ui-helper-hidden-accessible\"><?= t('Total number of tasks in this column across all swimlanes') ?> </span><?= $column['nb_unfiltered_tasks_across_swimlane'] ?></span>)\n117:                     <?php endif ?>\n118:                 </span>\n119:                 <?php endif ?>\n120:             </span>\n121:             <?= $this->hook->render('template:board:column:header', array('swimlane' => $swimlane, 'column' => $column)) ?>\n122:         </div>\n123:     </th>\n124:     <?php endforeach ?>\n125: </tr>\n126: \n127: <?= $this->hook->render('template:board:table:column:after-header-row', array('swimlane' => $swimlane)) ?>"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/Users/milin/2026/软件开发/application-atlas/docs/template-factory/go-minimax-batch-2026-10-21/personal-kanban/calls/blueprint-spec-review-aux/source/upstream/app/Template/board/table_column.php\"}"},"time":{"start":1792580662076,"end":1792580662326}}}}
