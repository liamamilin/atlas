_id'], $task_id, $tags);\n42:             }\n43: \n44:             $this->queueManager->push($this->taskEventJob->withParams(\n45:                 $task_id,\n46:                 array(TaskModel::EVENT_CREATE_UPDATE, TaskModel::EVENT_CREATE)\n47:             ));\n48:         }\n49: \n50:         $this->hook->reference('model:task:creation:aftersave', $task_id);\n51: \n52:         return (int) $task_id;\n53:     }\n54: \n55:     /**\n56:      * Prepare data\n57:      *\n58:      * @access protected\n59:      * @param  array    $values    Form values\n60:      */\n61:     protected function prepare(array &$values)\n62:     {\n63:         $values = $this->dateParser->convert($values, array('date_due'), true);\n64:         $values = $this->dateParser->convert($values, array('date_started'), true);\n65: \n66:         $this->helper->model->removeFields($values, array('another_task', 'duplicate_multiple_projects'));\n67:         $this->helper->model->resetFields($values, array('creator_id', 'owner_id', 'date_due', 'date_started', 'score', 'category_id', 'time_estimated', 'time_spent'));\n68: \n69:         if (empty($values['column_id'])) {\n70:             $values['column_id'] = $this->columnModel->getFirstColumnId($values['project_id']);\n71:         }\n72: \n73:         if (empty($values['color_id'])) {\n74:             $values['color_id'] = $this->colorModel->getDefaultColor();\n75:         }\n76: \n77:         if (empty($values['title'])) {\n78:             $values['title'] = t('Untitled');\n79:         }\n80: \n81:         // Note: Do not override the creator_id if the task is imported\n82:         if (empty($values['creator_id']) && $this->userSession->isLogged()) {\n83:             $values['creator_id'] = $this->userSession->getId();\n84:         }\n85: \n86:         $values['swimlane_id'] = empty($values['swimlane_id']) ? $this->swimlaneModel->getFirstActiveSwimlaneId($values['project_id']) : $values['swimlane_id'];\n87:         $values['date_creation'] = time();\n8