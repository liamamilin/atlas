# Atlas OpenAI / Luna 备用模型。只在本机填写 API key，不要发到聊天中。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-6-luna
ATLAS_API_URL=http://127.0.0.1:5199

# 填好后从仓库根目录运行：
# python3 application-atlas-production-pack/configure_openai_backup.py
# 上述命令只检查配置；加 --apply 才会验证模型并保存备用路由。
# .env 不会由运行中的服务自动读取，须通过此脚本导入。
